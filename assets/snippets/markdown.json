{
  "Mermaid Flowchart": {
    "prefix": "mermaid-flowchart",
    "description": "Inserts a Mermaid flowchart.",
    "body": [
      "```mermaid",
      "flowchart ${1:TD}",
      "    %% [] is a step and {} a decision. |label| annotates a branch",
      "    start[${2:Start}] --> condition{${3:Condition}}",
      "    condition -->|Yes| work[${4:Process}]",
      "    condition -->|No| finish[${5:End}]",
      "    work --> finish",
      "```",
      "$0"
    ]
  },
  "Mermaid Sequence Diagram": {
    "prefix": "mermaid-sequence",
    "description": "Inserts a Mermaid sequence diagram.",
    "body": [
      "```mermaid",
      "sequenceDiagram",
      "    %% ->> is a call and -->> a reply",
      "    participant User as ${1:User}",
      "    participant App as ${2:App}",
      "    User->>App: ${3:Request}",
      "    App-->>User: ${4:Response}",
      "    Note over App: ${5:Note}",
      "```",
      "$0"
    ]
  },
  "Mermaid Class Diagram": {
    "prefix": "mermaid-class",
    "description": "Inserts a Mermaid class diagram.",
    "body": [
      "```mermaid",
      "classDiagram",
      "    %% <|-- is inheritance, *-- composition and o-- aggregation",
      "    class ${1:Base} {",
      "        +${2:field}: ${3:Type}",
      "        +${4:method}()",
      "    }",
      "    class ${5:Derived} {",
      "        +${6:extra}()",
      "    }",
      "    ${1:Base} <|-- ${5:Derived}",
      "```",
      "$0"
    ]
  },
  "Mermaid State Diagram": {
    "prefix": "mermaid-state",
    "description": "Inserts a Mermaid state diagram.",
    "body": [
      "```mermaid",
      "stateDiagram-v2",
      "    %% [*] is the start and the end. The text after : on an arrow is the event name",
      "    [*] --> ${1:Idle}",
      "    ${1:Idle} --> ${2:Running}: ${3:Start}",
      "    ${2:Running} --> ${1:Idle}: ${4:Finish}",
      "    ${2:Running} --> [*]: ${5:Abort}",
      "```",
      "$0"
    ]
  },
  "Mermaid ER Diagram": {
    "prefix": "mermaid-er",
    "description": "Inserts a Mermaid ER (entity relationship) diagram.",
    "body": [
      "```mermaid",
      "erDiagram",
      "    %% ||--o{ is one-to-many and }o--o{ many-to-many",
      "    ${1:CUSTOMER} ||--o{ ${2:ORDER} : \"${3:places}\"",
      "    ${2:ORDER} ||--|{ ${4:ORDER_ITEM} : \"${5:contains}\"",
      "    ${1:CUSTOMER} {",
      "        int id",
      "        string name",
      "    }",
      "```",
      "$0"
    ]
  },
  "Mermaid Gantt Chart": {
    "prefix": "mermaid-gantt",
    "description": "Inserts a Mermaid Gantt chart.",
    "body": [
      "```mermaid",
      "gantt",
      "    title ${1:Development Schedule}",
      "    dateFormat YYYY-MM-DD",
      "    axisFormat %m/%d",
      "    section ${2:Design}",
      "    ${3:Requirements} :done, req, ${4:2026-01-06}, 5d",
      "    ${5:Basic design} :active, design, after req, 7d",
      "    section ${6:Implementation}",
      "    ${7:Implementation} :impl, after design, 10d",
      "```",
      "$0"
    ]
  },
  "Mermaid Pie Chart": {
    "prefix": "mermaid-pie",
    "description": "Inserts a Mermaid pie chart.",
    "body": [
      "```mermaid",
      "pie title ${1:Breakdown}",
      "    \"${2:Design}\" : ${3:30}",
      "    \"${4:Implementation}\" : ${5:50}",
      "    \"${6:Testing}\" : ${7:20}",
      "```",
      "$0"
    ]
  },
  "Mermaid Git Graph": {
    "prefix": "mermaid-gitgraph",
    "description": "Inserts a Mermaid Git graph (a diagram of branches).",
    "body": [
      "```mermaid",
      "gitGraph",
      "    commit id: \"${1:Initial commit}\"",
      "    branch ${2:feature}",
      "    checkout ${2:feature}",
      "    commit id: \"${3:Add a feature}\"",
      "    checkout main",
      "    merge ${2:feature}",
      "```",
      "$0"
    ]
  },
  "Mermaid Mindmap": {
    "prefix": "mermaid-mindmap",
    "description": "Inserts a Mermaid mindmap.",
    "body": [
      "```mermaid",
      "mindmap",
      "  root((${1:Central Topic}))",
      "    ${2:Category A}",
      "      ${3:Item 1}",
      "      ${4:Item 2}",
      "    ${5:Category B}",
      "      ${6:Item 3}",
      "```",
      "$0"
    ]
  },
  "Mermaid Timeline": {
    "prefix": "mermaid-timeline",
    "description": "Inserts a Mermaid timeline.",
    "body": [
      "```mermaid",
      "timeline",
      "    title ${1:History}",
      "    ${2:2024} : ${3:Planning}",
      "    ${4:2025} : ${5:Development} : ${6:Release}",
      "    ${7:2026} : ${8:Operation}",
      "```",
      "$0"
    ]
  },
  "Mermaid User Journey": {
    "prefix": "mermaid-journey",
    "description": "Inserts a Mermaid user journey (the steps of an experience and how satisfying each one is).",
    "body": [
      "```mermaid",
      "journey",
      "    %% Task : Satisfaction (1 to 5) : People involved",
      "    title ${1:Path to Purchase}",
      "    section ${2:Find}",
      "      ${3:Search for a product}: ${4:4}: ${5:Customer}",
      "      Compare: 3: Customer",
      "    section ${6:Buy}",
      "      Add to cart: 5: Customer",
      "      ${7:Pay}: ${8:2}: ${9:Customer, Store}",
      "```",
      "$0"
    ]
  },
  "Mermaid Quadrant Chart": {
    "prefix": "mermaid-quadrant",
    "description": "Inserts a Mermaid quadrant chart (a scatter plot on two axes).",
    "body": [
      "```mermaid",
      "quadrantChart",
      "    %% A point is Name: [x, y], both from 0 to 1",
      "    title ${1:Initiative Priorities}",
      "    x-axis ${2:Low Effort} --> ${3:High Effort}",
      "    y-axis ${4:Low Impact} --> ${5:High Impact}",
      "    quadrant-1 ${6:Plan and Do}",
      "    quadrant-2 ${7:Do Now}",
      "    quadrant-3 ${8:Do Later}",
      "    quadrant-4 ${9:Reconsider}",
      "    ${10:Initiative A}: [${11:0.3}, ${12:0.8}]",
      "    Initiative B: [0.7, 0.6]",
      "    Initiative C: [0.2, 0.3]",
      "```",
      "$0"
    ]
  },
  "Mermaid XY Chart": {
    "prefix": "mermaid-xychart",
    "description": "Inserts a Mermaid XY chart (a bar or line chart).",
    "body": [
      "```mermaid",
      "xychart-beta",
      "    %% bar draws bars and line a line. Give as many values as the x-axis has items",
      "    title \"${1:Monthly Sales}\"",
      "    x-axis [${2:\"Jan\", \"Feb\", \"Mar\", \"Apr\"}]",
      "    y-axis \"${3:Sales (USD thousands)}\" ${4:0} --> ${5:100}",
      "    bar [${6:30, 45, 60, 80}]",
      "    line [${7:30, 45, 60, 80}]",
      "```",
      "$0"
    ]
  },
  "Mermaid Radar Chart": {
    "prefix": "mermaid-radar",
    "description": "Inserts a Mermaid radar chart (series compared by their value on each axis).",
    "body": [
      "```mermaid",
      "radar-beta",
      "    %% axis defines the axes and curve a series. List the values in the order of the axes",
      "    title ${1:Skill Comparison}",
      "    axis design[\"Design\"], build[\"Implementation\"], test[\"Testing\"], ops[\"Operations\"]",
      "    curve a[\"Person A\"]{4, 3, 5, 2}",
      "    curve b[\"Person B\"]{2, 5, 3, 4}",
      "    max 5",
      "```",
      "$0"
    ]
  },
  "Mermaid Requirement Diagram": {
    "prefix": "mermaid-requirement",
    "description": "Inserts a Mermaid requirement diagram (requirements and the elements that satisfy them).",
    "body": [
      "```mermaid",
      "requirementDiagram",
      "    %% requirement declares a requirement; element declares what satisfies it. Connect them with - satisfies ->",
      "    requirement ${1:login} {",
      "        id: 1",
      "        text: \"Users can log in\"",
      "        risk: high",
      "        verifymethod: test",
      "    }",
      "    element ${2:login_page} {",
      "        type: \"Screen\"",
      "    }",
      "    ${2:login_page} - satisfies -> ${1:login}",
      "```",
      "$0"
    ]
  },
  "Mermaid C4 Diagram": {
    "prefix": "mermaid-c4",
    "description": "Inserts a Mermaid C4 diagram (a system, its users and the external systems it relates to).",
    "body": [
      "```mermaid",
      "C4Context",
      "    %% Person is a user, System your system, System_Ext an external one and Rel a relationship",
      "    title ${1:Order System Overview}",
      "    Person(customer, \"Customer\", \"Orders products\")",
      "    System(shop, \"Order System\", \"Accepts orders\")",
      "    System_Ext(mail, \"Mail Delivery\", \"Sends notifications\")",
      "    Rel(customer, shop, \"Places orders\")",
      "    Rel(shop, mail, \"Requests notifications\")",
      "```",
      "$0"
    ]
  },
  "Mermaid Block Diagram": {
    "prefix": "mermaid-block",
    "description": "Inserts a Mermaid block diagram (boxes on a grid, joined by arrows).",
    "body": [
      "```mermaid",
      "block-beta",
      "    %% columns sets the number of columns, space is an empty cell and --> an arrow",
      "    columns 3",
      "    input[\"${1:Input}\"] process[\"${2:Process}\"] output[\"${3:Output}\"]",
      "    space log[\"Log\"] space",
      "    input --> process",
      "    process --> output",
      "    process --> log",
      "```",
      "$0"
    ]
  },
  "Mermaid Sankey Diagram": {
    "prefix": "mermaid-sankey",
    "description": "Inserts a Mermaid Sankey diagram (flows of an amount).",
    "body": [
      "```mermaid",
      "sankey-beta",
      "    %% Each line is source,target,amount. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)",
      "    ${1:Power},Home,30",
      "    ${1:Power},Factory,50",
      "    ${2:Gas},Home,20",
      "    ${2:Gas},Factory,10",
      "```",
      "$0"
    ]
  },
  "Mermaid Packet Diagram": {
    "prefix": "mermaid-packet",
    "description": "Inserts a Mermaid packet diagram (fields laid out bit by bit).",
    "body": [
      "```mermaid",
      "packet-beta",
      "    %% start bit-end bit: \"Field name\"",
      "    title ${1:UDP Header}",
      "    0-15: \"Source Port\"",
      "    16-31: \"Destination Port\"",
      "    32-47: \"Length\"",
      "    48-63: \"Checksum\"",
      "    64-95: \"Data (variable length)\"",
      "```",
      "$0"
    ]
  },
  "Mermaid Venn Diagram": {
    "prefix": "mermaid-venn",
    "description": "Inserts a Mermaid Venn diagram (overlapping sets).",
    "body": [
      "```mermaid",
      "venn-beta",
      "    %% set defines a set and union names an overlap",
      "    title ${1:Overlapping Responsibilities}",
      "    set Front[\"Frontend\"]",
      "    set Back[\"Backend\"]",
      "    union Front,Back[\"API\"]",
      "```",
      "$0"
    ]
  },
  "Mermaid Kanban": {
    "prefix": "mermaid-kanban",
    "description": "Inserts a Mermaid kanban board (cards in columns).",
    "body": [
      "```mermaid",
      "kanban",
      "    %% Less indented lines are columns and more indented lines cards",
      "    todo[${1:To Do}]",
      "        spec[Write the spec]",
      "        screen[Build the screen]",
      "    doing[${2:In Progress}]",
      "        api[Build the API]",
      "    done[${3:Done}]",
      "        setup[Set up the environment]",
      "```",
      "$0"
    ]
  },
  "Mermaid Treemap": {
    "prefix": "mermaid-treemap",
    "description": "Inserts a Mermaid treemap (amounts shown as nested areas).",
    "body": [
      "```mermaid",
      "treemap-beta",
      "    %% Indentation nests items. Give each leaf a value after :",
      "    \"${1:Development}\"",
      "        \"Design\": 30",
      "        \"Implementation\": 50",
      "    \"${2:Operations}\"",
      "        \"Maintenance\": 15",
      "        \"Monitoring\": 5",
      "```",
      "$0"
    ]
  },
  "Mermaid Architecture Diagram": {
    "prefix": "mermaid-architecture",
    "description": "Inserts a Mermaid architecture diagram (components and how they connect).",
    "body": [
      "```mermaid",
      "architecture-beta",
      "    %% group is a grouping and service a component. :L :R :T :B choose the side a line connects to",
      "    group app(cloud)[${1:App}]",
      "    service web(server)[Web Server] in app",
      "    service db(database)[Database] in app",
      "    service disk(disk)[Storage] in app",
      "    web:R -- L:db",
      "    web:B -- T:disk",
      "```",
      "$0"
    ]
  },
  "Mermaid Tree View": {
    "prefix": "mermaid-treeview",
    "description": "Inserts a Mermaid tree view (a hierarchy like a folder tree).",
    "body": [
      "```mermaid",
      "treeView-beta",
      "    %% Indentation shows the hierarchy",
      "    \"${1:Project}\"",
      "        \"src\"",
      "            \"main.rs\"",
      "            \"lib.rs\"",
      "        \"docs\"",
      "            \"README.md\"",
      "```",
      "$0"
    ]
  },
  "Mermaid Ishikawa Diagram": {
    "prefix": "mermaid-ishikawa",
    "description": "Inserts a Mermaid Ishikawa diagram (a fishbone of an effect and its causes).",
    "body": [
      "```mermaid",
      "ishikawa-beta",
      "    %% The first line is the effect and indented lines its causes",
      "    ${1:Too many defects}",
      "        People",
      "            Little experience",
      "        Method",
      "            Outdated procedures",
      "        Material",
      "            Inconsistent suppliers",
      "```",
      "$0"
    ]
  },
  "Mermaid Event Modeling": {
    "prefix": "mermaid-eventmodeling",
    "description": "Inserts a Mermaid event model (the flow of screens, commands and events).",
    "body": [
      "```mermaid",
      "eventmodeling",
      "    %% tf number type name. ui is a screen, cmd a command, evt an event and rmo a read model. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)",
      "    tf 01 ui ${1:CartScreen}",
      "    tf 02 cmd AddItem",
      "    tf 03 evt ItemAdded",
      "    tf 04 rmo CartItems ->> 03",
      "```",
      "$0"
    ]
  }
}
