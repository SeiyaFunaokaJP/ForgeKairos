{
  "Mermaid フローチャート": {
    "prefix": "mermaid-flowchart",
    "description": "Mermaid のフローチャートを挿入します。",
    "body": [
      "```mermaid",
      "flowchart ${1:TD}",
      "    %% [] は処理、{} は分岐。|ラベル| で分岐に注釈を付ける",
      "    start[${2:開始}] --> condition{${3:条件}}",
      "    condition -->|はい| work[${4:処理}]",
      "    condition -->|いいえ| finish[${5:終了}]",
      "    work --> finish",
      "```",
      "$0"
    ]
  },
  "Mermaid シーケンス図": {
    "prefix": "mermaid-sequence",
    "description": "Mermaid のシーケンス図を挿入します。",
    "body": [
      "```mermaid",
      "sequenceDiagram",
      "    %% ->> は呼び出し、-->> は応答",
      "    participant User as ${1:利用者}",
      "    participant App as ${2:アプリ}",
      "    User->>App: ${3:要求}",
      "    App-->>User: ${4:応答}",
      "    Note over App: ${5:補足}",
      "```",
      "$0"
    ]
  },
  "Mermaid クラス図": {
    "prefix": "mermaid-class",
    "description": "Mermaid のクラス図を挿入します。",
    "body": [
      "```mermaid",
      "classDiagram",
      "    %% <|-- は継承、*-- は合成、o-- は集約",
      "    class ${1:Base} {",
      "        +${2:field}: ${3:Type}",
      "        +${4:method}()",
      "    }",
      "    class ${5:Derived} {",
      "        +${6:extra}()",
      "    }",
      "    ${1:Base} <|-- ${5:Derived}",
      "```",
      "$0"
    ]
  },
  "Mermaid 状態図": {
    "prefix": "mermaid-state",
    "description": "Mermaid の状態図を挿入します。",
    "body": [
      "```mermaid",
      "stateDiagram-v2",
      "    %% [*] は開始と終了。矢印のあとの : がイベント名",
      "    [*] --> ${1:Idle}",
      "    ${1:Idle} --> ${2:Running}: ${3:開始}",
      "    ${2:Running} --> ${1:Idle}: ${4:完了}",
      "    ${2:Running} --> [*]: ${5:中止}",
      "```",
      "$0"
    ]
  },
  "Mermaid ER 図": {
    "prefix": "mermaid-er",
    "description": "Mermaid の ER 図 (実体関連図) を挿入します。",
    "body": [
      "```mermaid",
      "erDiagram",
      "    %% ||--o{ は 1 対多、}o--o{ は多対多",
      "    ${1:CUSTOMER} ||--o{ ${2:ORDER} : \"${3:発注する}\"",
      "    ${2:ORDER} ||--|{ ${4:ORDER_ITEM} : \"${5:含む}\"",
      "    ${1:CUSTOMER} {",
      "        int id",
      "        string name",
      "    }",
      "```",
      "$0"
    ]
  },
  "Mermaid ガントチャート": {
    "prefix": "mermaid-gantt",
    "description": "Mermaid のガントチャートを挿入します。",
    "body": [
      "```mermaid",
      "gantt",
      "    title ${1:開発スケジュール}",
      "    dateFormat YYYY-MM-DD",
      "    axisFormat %m/%d",
      "    section ${2:設計}",
      "    ${3:要件定義} :done, req, ${4:2026-01-06}, 5d",
      "    ${5:基本設計} :active, design, after req, 7d",
      "    section ${6:実装}",
      "    ${7:実装} :impl, after design, 10d",
      "```",
      "$0"
    ]
  },
  "Mermaid 円グラフ": {
    "prefix": "mermaid-pie",
    "description": "Mermaid の円グラフを挿入します。",
    "body": [
      "```mermaid",
      "pie title ${1:内訳}",
      "    \"${2:設計}\" : ${3:30}",
      "    \"${4:実装}\" : ${5:50}",
      "    \"${6:テスト}\" : ${7:20}",
      "```",
      "$0"
    ]
  },
  "Mermaid Git グラフ": {
    "prefix": "mermaid-gitgraph",
    "description": "Mermaid の Git グラフ (ブランチ図) を挿入します。",
    "body": [
      "```mermaid",
      "gitGraph",
      "    commit id: \"${1:初期化}\"",
      "    branch ${2:feature}",
      "    checkout ${2:feature}",
      "    commit id: \"${3:機能を追加}\"",
      "    checkout main",
      "    merge ${2:feature}",
      "```",
      "$0"
    ]
  },
  "Mermaid マインドマップ": {
    "prefix": "mermaid-mindmap",
    "description": "Mermaid のマインドマップを挿入します。",
    "body": [
      "```mermaid",
      "mindmap",
      "  root((${1:中心テーマ}))",
      "    ${2:分類A}",
      "      ${3:項目1}",
      "      ${4:項目2}",
      "    ${5:分類B}",
      "      ${6:項目3}",
      "```",
      "$0"
    ]
  },
  "Mermaid タイムライン": {
    "prefix": "mermaid-timeline",
    "description": "Mermaid のタイムラインを挿入します。",
    "body": [
      "```mermaid",
      "timeline",
      "    title ${1:沿革}",
      "    ${2:2024} : ${3:企画}",
      "    ${4:2025} : ${5:開発} : ${6:公開}",
      "    ${7:2026} : ${8:運用}",
      "```",
      "$0"
    ]
  },
  "Mermaid ユーザージャーニー": {
    "prefix": "mermaid-journey",
    "description": "Mermaid のユーザージャーニー (体験の流れと満足度) を挿入します。",
    "body": [
      "```mermaid",
      "journey",
      "    title ${1:購入までの流れ}",
      "    section ${2:探す}",
      "      ${3:商品を検索する}: ${4:4}: ${5:利用者}",
      "    section ${6:買う}",
      "      ${7:支払う}: ${8:2}: ${5:利用者}",
      "```",
      "$0"
    ]
  },
  "Mermaid 4 象限チャート": {
    "prefix": "mermaid-quadrant",
    "description": "Mermaid の 4 象限チャート (2 軸の散布図) を挿入します。",
    "body": [
      "```mermaid",
      "quadrantChart",
      "    title ${1:施策の優先度}",
      "    x-axis ${2:労力が小さい} --> ${3:労力が大きい}",
      "    y-axis ${4:効果が小さい} --> ${5:効果が大きい}",
      "    quadrant-1 ${6:計画して進める}",
      "    quadrant-2 ${7:すぐやる}",
      "    quadrant-3 ${8:後回し}",
      "    quadrant-4 ${9:見直す}",
      "    ${10:施策A}: [${11:0.3}, ${12:0.8}]",
      "```",
      "$0"
    ]
  },
  "Mermaid XY チャート": {
    "prefix": "mermaid-xychart",
    "description": "Mermaid の XY チャート (棒グラフ・折れ線グラフ) を挿入します。",
    "body": [
      "```mermaid",
      "xychart-beta",
      "    title ${1:月別の売上}",
      "    x-axis [${2:\"1月\", \"2月\", \"3月\"}]",
      "    y-axis \"${3:売上 (万円)}\" ${4:0} --> ${5:100}",
      "    bar [${6:30, 45, 60}]",
      "    line [${7:30, 45, 60}]",
      "```",
      "$0"
    ]
  }
}
