name: forgekairos
title: ForgeKairos
base: core24
version: "$RELEASE_VERSION"
summary: Code editor forked from Zed
description: |
  ForgeKairos is a fork of the Zed code editor. It is not made or endorsed by
  Zed Industries.
grade: stable
confinement: classic
compression: lzo
website: https://github.com/SeiyaFunaokaJP/ForgeKairos
source-code: https://github.com/SeiyaFunaokaJP/ForgeKairos
issues: https://github.com/SeiyaFunaokaJP/ForgeKairos/issues

parts:
  forgekairos:
    plugin: dump
    source: "https://github.com/SeiyaFunaokaJP/ForgeKairos/releases/download/v$RELEASE_VERSION/forgekairos-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  forgekairos:
    command: usr/bin/forgekairos
    common-id: io.github.SeiyaFunaokaJP.ForgeKairos
    environment:
      ZED_BUNDLE_TYPE: snap
