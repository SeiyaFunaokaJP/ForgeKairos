msgid "Adds the hosts to network_allowlist.json. Unless they are added, downloading or connecting to this server stays refused"
msgstr "network_allowlist.json에 호스트를 추가합니다. 추가하지 않으면 이 서버의 다운로드나 연결은 계속 거부됩니다"

msgid "Adds them to network_allowlist.json. If you don't add them, traffic to this provider stays denied"
msgstr "network_allowlist.json에 추가합니다. 추가하지 않으면 이 프로바이더로의 통신은 계속 거부됩니다"

msgid "Agent name is required."
msgstr "에이전트 이름은 필수입니다."

msgid "Agents connected through the Agent Client Protocol."
msgstr "Agent Client Protocol을 통해 연결된 에이전트입니다."

