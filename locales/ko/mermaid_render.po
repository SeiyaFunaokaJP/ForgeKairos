msgstr "섹션 `{name}`"

msgid "task `{}`"
msgstr "작업 `{}`"

msgid "the branch name `{name}` cannot be written back"
msgstr "브랜치 이름 `{name}`은(는) 다시 쓸 수 없습니다"

msgid "the branch name is missing"
msgstr "브랜치 이름이 없습니다"

msgid "the first section"
msgstr "첫 번째 섹션"

msgid "the order `{value}` is not a whole number"
msgstr "순서 `{value}`은(는) 정수가 아닙니다"

msgid "the quotes are not closed"
msgstr "따옴표가 닫혀 있지 않습니다"

msgid "the space"
msgstr "빈 공간"

msgid "the type `{value}` is not one of NORMAL / REVERSE / HIGHLIGHT"
msgstr "타입 `{value}`은(는) NORMAL / REVERSE / HIGHLIGHT 중 하나가 아닙니다"

msgid "there is no `:` after `{key}`"
msgstr "`{key}` 뒤에 `:`이 없습니다"

msgid "{error} Edit it as text."
msgstr "{error} 텍스트로 편집하세요."

msgid "{name}: `{value}` cannot be written. {number_rule}"
msgstr "{name}: `{value}`은(는) 작성할 수 없습니다. {number_rule}"

msgid "{problem} Edit it as text."
msgstr "{problem} 텍스트로 편집하세요."

