msgid "Start (This Time Only)"
msgstr "시작 (이번만)"

msgid "Start Claude Code outside the sandbox?"
msgstr "샌드박스 외부에서 Claude Code를 시작하시겠습니까?"

msgid "Start New Agent Thread"
msgstr "새 에이전트 스레드 시작"

msgid "Start New Thread"
msgstr "새 스레드 시작"

msgid "Start Outside the Sandbox (This Thread Only)"
msgstr "샌드박스 외부에서 시작 (이 스레드만)"

msgid "Start Outside the Sandbox…"
msgstr "샌드박스 외부에서 시작…"

msgid "Start `{program}` outside the sandbox?"
msgstr "샌드박스 외부에서 `{program}`을(를) 시작하시겠습니까?"

msgid "Started outside the sandbox, this agent runs with Zed's own permissions and can also run the project's hooks and MCP servers. You'll be asked for each thread before it starts."
msgstr "샌드박스 외부에서 시작하면 이 에이전트는 ForgeKairos 자체 권한으로 실행되며 프로젝트의 훅과 MCP 서버도 실행할 수 있습니다. 시작하기 전에 스레드마다 확인합니다."

msgid "Starts a thread of {agent} on {provider}'s models. The key or sign-in is the one in Settings > AI > LLM Providers."
msgstr "{provider}의 모델로 {agent} 스레드를 시작합니다. 키 또는 로그인은 설정 > AI > LLM 프로바이더의 것을 사용합니다."

msgid "Starts a thread with {name} through the Agent Client Protocol. You sign in with the agent's own sign-in."
msgstr "Agent Client Protocol을 통해 {name}와(과) 스레드를 시작합니다. 로그인은 에이전트 자체 로그인 방식으로 합니다."

msgid "Steer"
msgstr "방향 조정"

msgid "Stop Following the {}"
msgstr "{} 따라가기 중지"

msgid "Stop Following {}"
msgstr "{} 따라가기 중지"

msgid "Stop Generation"
msgstr "생성 중지"

msgid "Stop Subagent"
msgstr "하위 에이전트 중지"

msgid "Stop This Command"
msgstr "이 명령 중지"

msgid "Subagent"
msgstr "하위 에이전트"

msgid "Subagent Canceled"
msgstr "하위 에이전트 취소됨"

msgid "Subagent Cancelled"
msgstr "하위 에이전트 취소됨"

msgid "Subagent Failed"
msgstr "하위 에이전트 실패"

msgid "Subagent Output"
msgstr "하위 에이전트 출력"

msgid "Subagents Awaiting Permission:"
msgstr "권한 대기 중인 하위 에이전트:"

msgid "Submit"
msgstr "제출"

msgid "Submitted"
msgstr "제출됨"

msgid "Subscription"
msgstr "구독"

msgid "Subscription or API Key"
msgstr "구독 또는 API 키"

msgid "Subscription or API key: you sign in on Claude Code's own screen, and Zed never handles the credentials. The subscription can be turned off in Settings."
msgstr "구독 또는 API 키: 로그인은 Claude Code 자체 화면에서 하며, ForgeKairos는 자격 증명을 다루지 않습니다. 구독은 설정에서 끌 수 있습니다."

msgid "Subscription sign-in is turned off by `allow_subscription_sign_in` in settings. You can still use an API key."
msgstr "설정의 `allow_subscription_sign_in`으로 구독 로그인이 꺼져 있습니다. API 키는 계속 사용할 수 있습니다."

msgid "Subscription sign-in is turned off in this agent's settings (`allow_subscription_sign_in`)."
msgstr "이 에이전트의 설정(`allow_subscription_sign_in`)에서 구독 로그인이 꺼져 있습니다."

msgid "Switch to {}"
msgstr "{}(으)로 전환"

msgid "Symbols"
msgstr "심볼"

msgid "Tab"
msgstr "탭"

msgid "Tab Bar"
msgstr "탭 표시줄"

msgid "Target"
msgstr "대상"

msgid "Terminal"
msgstr "터미널"

msgid "Terminal inline assistant error: {}"
msgstr "터미널 인라인 어시스턴트 오류: {}"

msgid "Thanks for your feedback!"
msgstr "피드백을 보내주셔서 감사합니다!"

msgid "The Claude Code sent to the remote host could not be found. Please try again."
msgstr "원격 호스트로 보낸 Claude Code를 찾을 수 없습니다. 다시 시도하세요."

msgid "The JSON is hidden because the saved settings contain values that look like secrets."
msgstr "저장된 설정에 비밀 정보로 보이는 값이 포함되어 있어 JSON을 숨겼습니다."

msgid "The Zed server on the remote host is not ready yet (internal error)."
msgstr "원격 호스트의 ForgeKairos 서버가 아직 준비되지 않았습니다 (내부 오류)."

msgid "The Zed server on the remote host is not ready yet. Wait for the connection to finish and try again."
msgstr "원격 호스트의 ForgeKairos 서버가 아직 준비되지 않았습니다. 연결이 완료될 때까지 기다린 후 다시 시도하세요."

msgid "The agent can read the repository but not change it. Click to turn Git operations on for this thread."
msgstr "에이전트가 저장소를 읽을 수는 있지만 변경할 수는 없습니다. 클릭하면 이 스레드에서 Git 작업을 켭니다."

msgid "The agent can stage, commit, switch branches and so on, with hooks turned off and no network access. Each command follows the git tool permissions. Click to turn this off for this thread."
msgstr "에이전트가 훅을 끄고 네트워크 액세스 없이 스테이징, 커밋, 브랜치 전환 등을 할 수 있습니다. 각 명령은 git 도구 권한을 따릅니다. 클릭하면 이 스레드에서 끕니다."

msgid "The agent can't use `getDiagnostics`, so it can't see the errors and warnings the editor shows. {reason}"
msgstr "에이전트가 `getDiagnostics`를 사용할 수 없어 편집기에 표시되는 오류와 경고를 볼 수 없습니다. {reason}"

msgid "The agent was added to settings.json, but it has not been loaded yet. Open it later from the + menu."
msgstr "에이전트가 settings.json에 추가되었지만 아직 로드되지 않았습니다. 나중에 + 메뉴에서 여세요."

msgid "The agent was stopped because it wasn't in use. Sending a message reconnects it"
msgstr "사용하지 않아 에이전트를 중지했습니다. 메시지를 보내면 다시 연결됩니다"

msgid "The agent's network access needs hosts added to the allowlist"
msgstr "에이전트의 네트워크 액세스를 위해 호스트를 허용 목록에 추가해야 합니다"

msgid "The connection to {provider}'s API was interrupted. Zed will retry automatically. If the problem persists, check your network connection."
msgstr "{provider}의 API 연결이 중단되었습니다. ForgeKairos가 자동으로 다시 시도합니다. 문제가 계속되면 네트워크 연결을 확인하세요."

msgid "The extension's settings must be a JSON object ({{ … }})."
msgstr "확장 프로그램 설정은 JSON 객체({{ … }})여야 합니다."

msgid "The file name for {platform} in the release information ({file_name}) is not the expected one."
msgstr "릴리스 정보에 있는 {platform}용 파일 이름({file_name})이 예상과 다릅니다."

msgid "The hash of the downloaded Claude Code does not match the release information. Canceled because it may have been tampered with."
msgstr "다운로드한 Claude Code의 해시가 릴리스 정보와 일치하지 않습니다. 변조되었을 수 있으므로 취소했습니다."

msgid "The hosts were added to the allowlist, but the change has not taken effect yet. Wait a moment and try again."
msgstr "호스트를 허용 목록에 추가했지만 변경 사항이 아직 적용되지 않았습니다. 잠시 후 다시 시도하세요."

msgid "The key is saved in {store}, not in settings.json."
msgstr "키는 settings.json이 아니라 {store}에 저장됩니다."

msgid "The location of the Claude Code used in the sandbox is not an absolute path (internal error): {claude_path}"
msgstr "샌드박스에서 사용하는 Claude Code의 위치가 절대 경로가 아닙니다 (내부 오류): {claude_path}"

msgid "The message is over its size limit, so {count} large attachment is reduced to an outline or a reference."
msgid_plural "The message is over its size limit, so {count} large attachments are reduced to outlines or references."
msgstr[0] "메시지가 크기 한도를 초과하여 큰 첨부 파일 {count}개를 아웃라인 또는 참조로 줄였습니다."

msgid "The model"
msgstr "모델"

msgid "The model stopped because it reached its maximum output length. You can ask it to continue where it left off."
msgstr "모델이 최대 출력 길이에 도달하여 중지되었습니다. 중단된 지점부터 계속하도록 요청할 수 있습니다."

msgid "The project is not connected to the remote host."
msgstr "프로젝트가 원격 호스트에 연결되어 있지 않습니다."

msgid "The relay cannot be started because the project folder ({root}) contains the IDE integration's rendezvous location."
msgstr "프로젝트 폴더({root})에 IDE 연동의 연결 지점이 포함되어 있어 중계를 시작할 수 없습니다."

msgid "The release information has no file for {platform}."
msgstr "릴리스 정보에 {platform}용 파일이 없습니다."

msgid "The remote Linux host uses musl, so the Linux build of Claude Code (the glibc build) cannot run."
msgstr "원격 Linux 호스트가 musl을 사용하므로 Linux용 Claude Code(glibc 빌드)를 실행할 수 없습니다."

msgid "The remote host did not respond within {seconds} seconds ({step}). Check the state of the remote host and try again."
msgstr "원격 호스트가 {seconds}초 안에 응답하지 않았습니다 ({step}). 원격 호스트 상태를 확인한 후 다시 시도하세요."

msgid "The remote host does not have enough free space ({required} MB needed, {available} MB free). Free up space on the remote host and try again."
msgstr "원격 호스트의 여유 공간이 부족합니다 ({required} MB 필요, {available} MB 남음). 원격 호스트의 공간을 확보한 후 다시 시도하세요."

msgid "The remote host has no `sha256sum`, so it cannot be confirmed that Claude Code has not been replaced. Install coreutils on the remote host and try again."
msgstr "원격 호스트에 `sha256sum`이 없어 Claude Code가 교체되지 않았는지 확인할 수 없습니다. 원격 호스트에 coreutils를 설치한 후 다시 시도하세요."

msgid "The sandboxed Claude Code is not available because no folder is open."
msgstr "열린 폴더가 없어 샌드박스 Claude Code를 사용할 수 없습니다."

msgid "The sandboxed Claude Code is not available because the remote host is not running Linux."
msgstr "원격 호스트가 Linux가 아니므로 샌드박스 Claude Code를 사용할 수 없습니다."

msgid "The sandboxed Claude Code is not available in a project that is being edited collaboratively."
msgstr "공동 편집 중인 프로젝트에서는 샌드박스 Claude Code를 사용할 수 없습니다."

msgid "The sandboxed Claude Code is not available yet for this type of connection."
msgstr "이 연결 유형에서는 아직 샌드박스 Claude Code를 사용할 수 없습니다."

msgid "The sandboxed Claude Code is not available yet on this OS."
msgstr "이 OS에서는 아직 샌드박스 Claude Code를 사용할 수 없습니다."

msgid "The session's terminal was closed right after it opened."
msgstr "세션의 터미널이 열린 직후 닫혔습니다."

msgid "The sign-in is shared with your usual Claude Code (`~/.claude`)."
msgstr "로그인은 평소 사용하는 Claude Code(`~/.claude`)와 공유됩니다."

msgid "The size of the downloaded Claude Code does not match the release information. Canceled."
msgstr "다운로드한 Claude Code의 크기가 릴리스 정보와 일치하지 않습니다. 취소했습니다."

msgid "The terminal panel is not available."
msgstr "터미널 패널을 사용할 수 없습니다."

msgid "The thread cannot be moved back because the agent panel was not found."
msgstr "에이전트 패널을 찾을 수 없어 스레드를 되돌릴 수 없습니다."

msgid "The version in the release information ({manifest_version}) does not match the requested version ({version}). Canceled."
msgstr "릴리스 정보의 버전({manifest_version})이 요청한 버전({version})과 일치하지 않습니다. 취소했습니다."

msgid "The {channel} version v{offered} is older than the installed v{installed}, so it will not be updated."
msgstr "{channel} 버전 v{offered}이(가) 설치된 v{installed}보다 오래되어 업데이트하지 않습니다."

msgid "There is no Linux build of Claude Code for the WSL architecture \"{machine}\" (only x86_64 and aarch64 are supported)."
msgstr "WSL 아키텍처 \"{machine}\"용 Linux Claude Code 빌드가 없습니다 (x86_64와 aarch64만 지원됩니다)."

msgid "There is no Linux build of Claude Code for the remote host's architecture \"{machine}\" (only x86_64 and aarch64 are supported)."
msgstr "원격 호스트 아키텍처 \"{machine}\"용 Linux Claude Code 빌드가 없습니다 (x86_64와 aarch64만 지원됩니다)."

msgid "There is no folder to run Claude Code in."
msgstr "Claude Code를 실행할 폴더가 없습니다."

msgid "Thinking"
msgstr "사고 과정"

msgid "Thinking Effort"
msgstr "사고 강도"

msgid "Thinking: Off"
msgstr "사고: 꺼짐"

msgid "Thinking: On"
msgstr "사고: 켜짐"

msgid "Thinking: {level}"
msgstr "사고: {level}"

msgid "This JSON contains values that the form cannot show. Keep editing it as JSON."
msgstr "이 JSON에는 양식으로 표시할 수 없는 값이 포함되어 있습니다. JSON으로 계속 편집하세요."

msgid "This WSL distribution uses musl, so the Linux build of Claude Code (the glibc build) cannot run."
msgstr "이 WSL 배포판은 musl을 사용하므로 Linux용 Claude Code(glibc 빌드)를 실행할 수 없습니다."

msgid "This Week"
msgstr "이번 주"

msgid "This Window"
msgstr "이 창"

msgid "This agent can use Zed's IDE tools: highlights, annotations, tours, hover, definitions, references, and symbol search"
msgstr "이 에이전트는 ForgeKairos의 IDE 도구를 사용할 수 있습니다: 강조 표시, 주석, 투어, 호버, 정의, 참조, 심볼 검색"

msgid "This agent does not support viewing previous messages. However, your session will still continue from where you last left off."
msgstr "이 에이전트는 이전 메시지 보기를 지원하지 않습니다. 그러나 세션은 마지막으로 중단한 지점부터 계속 진행됩니다."

msgid "This agent doesn't currently support multi-root workspaces"
msgstr "이 에이전트는 현재 다중 루트 작업 영역을 지원하지 않습니다"

msgid "This agent doesn't offer a subscription sign-in. To use it with a subscription, launch the official Claude Code and log in there."
msgstr "이 에이전트는 구독 로그인을 제공하지 않습니다. 구독으로 사용하려면 공식 Claude Code를 시작하고 거기에서 로그인하세요."

msgid "This agent is installed via npx (npm)"
msgstr "이 에이전트는 npx(npm)를 통해 설치됩니다"

msgid "This applies to this start only. To always start outside the sandbox, switch it on the AI page in Settings."
msgstr "이번 시작에만 적용됩니다. 항상 샌드박스 외부에서 시작하려면 설정의 AI 페이지에서 전환하세요."

msgid "This applies to this thread only (you will not be asked again; you can revoke the consent on the AI page in Settings). To always start outside the sandbox, switch it on the AI page in Settings."
msgstr "이 스레드에만 적용됩니다 (다시 묻지 않으며, 설정의 AI 페이지에서 동의를 철회할 수 있습니다). 항상 샌드박스 외부에서 시작하려면 설정의 AI 페이지에서 전환하세요."

msgid "This command can write to a file on a Windows drive"
msgstr "이 명령은 Windows 드라이브의 파일에 쓸 수 있습니다"

msgid "This command ran without a sandbox, allowed by an earlier version when the sandbox could not be created. Commands now always run inside the sandbox."
msgstr "이 명령은 샌드박스를 만들 수 없었을 때 이전 버전에서 허용되어 샌드박스 없이 실행되었습니다. 이제 명령은 항상 샌드박스 안에서 실행됩니다."

msgid "This command was allowed to run without a sandbox by an earlier version when the sandbox could not be created. Commands now always run inside the sandbox."
msgstr "이 명령은 샌드박스를 만들 수 없었을 때 이전 버전에서 샌드박스 없이 실행하도록 허용되었습니다. 이제 명령은 항상 샌드박스 안에서 실행됩니다."

msgid "This conversation is too long for the model's context window. Start a new thread or remove some attached files to continue."
msgstr "이 대화가 모델의 컨텍스트 창에 비해 너무 깁니다. 계속하려면 새 스레드를 시작하거나 첨부 파일 일부를 제거하세요."

msgid "This extension has no settings to configure."
msgstr "이 확장 프로그램에는 구성할 설정이 없습니다."

msgid "This extension's settings cannot be shown as a form, so they are edited as JSON."
msgstr "이 확장 프로그램의 설정은 양식으로 표시할 수 없으므로 JSON으로 편집합니다."

msgid "This internationalized address displays as {decoded_host}. Verify it carefully."
msgstr "이 국제화된 주소는 {decoded_host}(으)로 표시됩니다. 주의 깊게 확인하세요."

msgid "This model does not support images yet"
msgstr "이 모델은 아직 이미지를 지원하지 않습니다"

msgid "This model does not support tools."
msgstr "이 모델은 도구를 지원하지 않습니다."

msgid "This model doesn't support thinking mode"
msgstr "이 모델은 사고 모드를 지원하지 않습니다"

msgid "This model only supports turning thinking on or off (effort levels aren't supported)"
msgstr "이 모델은 사고 켜기/끄기만 지원합니다 (강도 수준은 지원되지 않음)"

msgid "This prompt was pre-filled by an external link. Read it carefully before you submit it to the model."
msgstr "이 프롬프트는 외부 링크로 미리 채워졌습니다. 모델에 제출하기 전에 주의 깊게 읽어 보세요."

msgid "This server is defined in the project's settings file (.zed/settings.json). Saving here writes to your user settings, but the project's definition takes precedence, so it has no effect. Edit the file that defines it from the MCP Servers page of the Settings window."
msgstr "이 서버는 프로젝트 설정 파일(.zed/settings.json)에 정의되어 있습니다. 여기에서 저장하면 사용자 설정에 기록되지만 프로젝트의 정의가 우선하므로 효과가 없습니다. 설정 창의 MCP 서버 페이지에서 이를 정의하는 파일을 편집하세요."

msgid "This server is defined on the remote host (its server settings or an extension running there). Saving here writes to your user settings, but the remote host's definition takes precedence, so it has no effect. Change it on the remote host; the MCP Servers page of the Settings window shows where it is defined."
msgstr "이 서버는 원격 호스트(서버 설정 또는 원격 호스트에서 실행되는 확장 프로그램)에 정의되어 있습니다. 여기에서 저장하면 사용자 설정에 기록되지만 원격 호스트의 정의가 우선하므로 효과가 없습니다. 원격 호스트에서 변경하세요. 정의된 위치는 설정 창의 MCP 서버 페이지에 표시됩니다."

msgid "This server is waiting for approval. Review it on the MCP Servers page of the Settings window."
