msgid "eventmodeling\n    %% tf number type name. ui is a screen, cmd a command, evt an event and rmo a read model. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"
msgstr "eventmodeling\n    %% tf 번호 종류 이름. ui는 화면, cmd는 명령, evt는 이벤트, rmo는 읽기 모델입니다. 이름은 ASCII 영문자와 숫자로 쓰세요 (Mermaid는 ASCII가 아닌 이름을 읽을 수 없습니다)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"

msgid "flowchart TD\n    %% [] is a step and {{}} a decision. |label| annotates a branch\n    start[Start] --> condition{{Condition}}\n    condition -->|Yes| work[Process]\n    condition -->|No| finish[End]\n    work --> finish"
msgstr "flowchart TD\n    %% []는 단계, {{}}는 분기입니다. |레이블|로 분기에 주석을 답니다\n    start[시작] --> condition{{조건}}\n    condition -->|예| work[처리]\n    condition -->|아니요| finish[종료]\n    work --> finish"

msgid "forward declaration"
msgstr "전방 선언"

msgid "gantt\n    title Development Schedule\n    dateFormat YYYY-MM-DD\n    axisFormat %m/%d\n    section Design\n    Requirements :done, req, 2026-01-06, 5d\n    Basic design :active, design, after req, 7d\n    section Implementation\n    Implementation :impl, after design, 10d"
msgstr "gantt\n    title 개발 일정\n    dateFormat YYYY-MM-DD\n    axisFormat %m/%d\n    section 설계\n    요구 사항 정의 :done, req, 2026-01-06, 5d\n    기본 설계 :active, design, after req, 7d\n    section 구현\n    구현 :impl, after design, 10d"

msgid "gitGraph\n    commit id: \"Initial commit\"\n    branch feature\n    checkout feature\n    commit id: \"Add a feature\"\n    checkout main\n    merge feature"
msgstr "gitGraph\n    commit id: \"초기 커밋\"\n    branch feature\n    checkout feature\n    commit id: \"기능 추가\"\n    checkout main\n    merge feature"

msgid "guessed by name only"
msgstr "이름으로만 추정함"

msgid "ishikawa-beta\n    %% The first line is the effect and indented lines its causes\n    Too many defects\n        People\n            Little experience\n        Method\n            Outdated procedures\n        Material\n            Inconsistent suppliers"
msgstr "ishikawa-beta\n    %% 첫 줄은 결과, 들여쓴 줄은 원인입니다\n    불량이 너무 많음\n        사람\n            경험 부족\n        방법\n            오래된 절차\n        재료\n            공급업체의 품질 편차"

msgid "journey\n    %% Task : Satisfaction (1 to 5) : People involved\n    title Path to Purchase\n    section Find\n      Search for a product: 4: Customer\n      Compare: 3: Customer\n    section Buy\n      Add to cart: 5: Customer\n      Pay: 2: Customer, Store"
msgstr "journey\n    %% 작업 : 만족도 (1~5) : 관련된 사람\n    title 구매까지의 과정\n    section 찾기\n      상품 검색: 4: 고객\n      비교: 3: 고객\n    section 구매\n      장바구니에 담기: 5: 고객\n      결제: 2: 고객, 매장"

msgid "kanban\n    %% Less indented lines are columns and more indented lines cards\n    todo[To Do]\n        spec[Write the spec]\n        screen[Build the screen]\n    doing[In Progress]\n        api[Build the API]\n    done[Done]\n        setup[Set up the environment]"
msgstr "kanban\n    %% 들여쓰기가 얕은 줄은 열, 깊은 줄은 카드입니다\n    todo[할 일]\n        spec[사양 작성]\n        screen[화면 만들기]\n    doing[진행 중]\n        api[API 만들기]\n    done[완료]\n        setup[환경 설정]"

msgid "mindmap\n  root((Central Topic))\n    Category A\n      Item 1\n      Item 2\n    Category B\n      Item 3"
msgstr "mindmap\n  root((중심 주제))\n    분류 A\n      항목 1\n      항목 2\n    분류 B\n      항목 3"

msgid "packet-beta\n    %% start bit-end bit: \"Field name\"\n    title UDP Header\n    0-15: \"Source Port\"\n    16-31: \"Destination Port\"\n    32-47: \"Length\"\n    48-63: \"Checksum\"\n    64-95: \"Data (variable length)\""
msgstr "packet-beta\n    %% 시작 비트-끝 비트: \"필드 이름\"\n    title UDP 헤더\n    0-15: \"원본 포트\"\n    16-31: \"대상 포트\"\n    32-47: \"길이\"\n    48-63: \"체크섬\"\n    64-95: \"데이터 (가변 길이)\""

msgid "pie title Breakdown\n    \"Design\" : 30\n    \"Implementation\" : 50\n    \"Testing\" : 20"
msgstr "pie title 내역\n    \"설계\" : 30\n    \"구현\" : 50\n    \"테스트\" : 20"

msgid "quadrantChart\n    %% A point is Name: [x, y], both from 0 to 1\n    title Initiative Priorities\n    x-axis Low Effort --> High Effort\n    y-axis Low Impact --> High Impact\n    quadrant-1 Plan and Do\n    quadrant-2 Do Now\n    quadrant-3 Do Later\n    quadrant-4 Reconsider\n    Initiative A: [0.3, 0.8]\n    Initiative B: [0.7, 0.6]\n    Initiative C: [0.2, 0.3]"
msgstr "quadrantChart\n    %% 점은 이름: [x, y] 형식이며, 둘 다 0에서 1 사이입니다\n    title 과제 우선순위\n    x-axis 적은 노력 --> 많은 노력\n    y-axis 낮은 효과 --> 높은 효과\n    quadrant-1 계획하고 실행\n    quadrant-2 즉시 실행\n    quadrant-3 나중에 실행\n    quadrant-4 재검토\n    과제 A: [0.3, 0.8]\n    과제 B: [0.7, 0.6]\n    과제 C: [0.2, 0.3]"

msgid "radar-beta\n    %% axis defines the axes and curve a series. List the values in the order of the axes\n    title Skill Comparison\n    axis design[\"Design\"], build[\"Implementation\"], test[\"Testing\"], ops[\"Operations\"]\n    curve a[\"Person A\"]{{4, 3, 5, 2}}\n    curve b[\"Person B\"]{{2, 5, 3, 4}}\n    max 5"
msgstr "radar-beta\n    %% axis는 축, curve는 계열을 정의합니다. 값은 축 순서대로 나열하세요\n    title 기술 비교\n    axis design[\"설계\"], build[\"구현\"], test[\"테스트\"], ops[\"운영\"]\n    curve a[\"A 씨\"]{{4, 3, 5, 2}}\n    curve b[\"B 씨\"]{{2, 5, 3, 4}}\n    max 5"

msgid "recursive"
msgstr "재귀"

msgid "requirementDiagram\n    %% requirement declares a requirement; element declares what satisfies it. Connect them with - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Users can log in\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Screen\"\n    }}\n    login_page - satisfies -> login"
msgstr "requirementDiagram\n    %% requirement는 요구 사항을, element는 이를 충족하는 대상을 선언합니다. - satisfies ->로 연결합니다\n    requirement login {{\n        id: 1\n        text: \"사용자가 로그인할 수 있음\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"화면\"\n    }}\n    login_page - satisfies -> login"

msgid "sankey-beta\n    %% Each line is source,target,amount. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"
msgstr "sankey-beta\n    %% 각 줄은 원본,대상,양입니다. 이름은 ASCII 영문자와 숫자로 쓰세요 (Mermaid는 ASCII가 아닌 이름을 읽을 수 없습니다)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"

msgid "sequenceDiagram\n    %% ->> is a call and -->> a reply\n    participant User as User\n    participant App as App\n    User->>App: Request\n    App-->>User: Response\n    Note over App: Note"
msgstr "sequenceDiagram\n    %% ->>는 호출, -->>는 응답입니다\n    participant User as 사용자\n    participant App as 앱\n    User->>App: 요청\n    App-->>User: 응답\n    Note over App: 메모"

msgid "stateDiagram-v2\n    %% [*] is the start and the end. The text after : on an arrow is the event name\n    [*] --> Idle\n    Idle --> Running: Start\n    Running --> Idle: Finish\n    Running --> [*]: Abort"
msgstr "stateDiagram-v2\n    %% [*]는 시작과 끝입니다. 화살표의 : 뒤 텍스트는 이벤트 이름입니다\n    [*] --> Idle\n    Idle --> Running: 시작\n    Running --> Idle: 완료\n    Running --> [*]: 중단"

msgid "the latest version"
msgstr "최신 버전"

msgid "timeline\n    title History\n    2024 : Planning\n    2025 : Development : Release\n    2026 : Operation"
msgstr "timeline\n    title 연혁\n    2024 : 기획\n    2025 : 개발 : 출시\n    2026 : 운영"

msgid "treeView-beta\n    %% Indentation shows the hierarchy\n    \"Project\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""
msgstr "treeView-beta\n    %% 들여쓰기로 계층을 나타냅니다\n    \"프로젝트\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""

msgid "treemap-beta\n    %% Indentation nests items. Give each leaf a value after :\n    \"Development\"\n        \"Design\": 30\n        \"Implementation\": 50\n    \"Operations\"\n        \"Maintenance\": 15\n        \"Monitoring\": 5"
msgstr "treemap-beta\n    %% 들여쓰기로 항목을 중첩합니다. 각 말단 항목에는 : 뒤에 값을 지정하세요\n    \"개발\"\n        \"설계\": 30\n        \"구현\": 50\n    \"운영\"\n        \"유지 관리\": 15\n        \"모니터링\": 5"

msgid "type named by the language server"
msgstr "언어 서버가 지정한 타입"

msgid "venn-beta\n    %% set defines a set and union names an overlap\n    title Overlapping Responsibilities\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"
msgstr "venn-beta\n    %% set은 집합을 정의하고, union은 겹치는 부분에 이름을 붙입니다\n    title 담당 영역의 겹침\n    set Front[\"프런트엔드\"]\n    set Back[\"백엔드\"]\n    union Front,Back[\"API\"]"

msgid "xychart-beta\n    %% bar draws bars and line a line. Give as many values as the x-axis has items\n    title \"Monthly Sales\"\n    x-axis [\"Jan\", \"Feb\", \"Mar\", \"Apr\"]\n    y-axis \"Sales (USD thousands)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"
msgstr "xychart-beta\n    %% bar는 막대, line은 선을 그립니다. x축 항목 수만큼 값을 지정하세요\n    title \"월별 매출\"\n    x-axis [\"1월\", \"2월\", \"3월\", \"4월\"]\n    y-axis \"매출 (천 USD)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"

