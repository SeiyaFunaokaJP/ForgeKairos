msgstr ""
"Language: ko\n"
"X-Language-Name: 한국어\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Accepts this key and continues connecting (the key is recorded in known_hosts)"
msgstr "이 키를 수락하고 연결을 계속합니다 (키는 known_hosts에 기록됩니다)"

msgid "Authentication was canceled."
msgstr "인증이 취소되었습니다."

msgid "Brings the items selected on the remote side to the local side"
msgstr "원격 쪽에서 선택한 항목을 로컬 쪽으로 가져옵니다"

msgid "Cancel"
msgstr "취소"

msgid "Canceled."
msgstr "취소되었습니다."

msgid "Clear Finished"
msgstr "완료된 항목 지우기"

msgid "Connect"
msgstr "연결"

msgid "Connect first."
msgstr "먼저 연결하세요."

msgid "Connected to {target}."
msgstr "{target}에 연결했습니다."

msgid "Connecting to {target}…"
msgstr "{target}에 연결 중…"

msgid "Connection name"
msgstr "연결 이름"

msgid "Connections"
msgstr "연결 대상"

msgid "Could not list the remote folder."
msgstr "원격 폴더 목록을 가져오지 못했습니다."

msgid "Could not open standard input"
msgstr "표준 입력을 열지 못했습니다"

msgid "Could not open the folder: {error}"
msgstr "폴더를 열지 못했습니다: {error}"

msgid "Could not pass on the input: {error}"
msgstr "입력을 전달하지 못했습니다: {error}"

msgid "Could not run {program}."
msgstr "{program}을(를) 실행하지 못했습니다."

msgid "Could not save the connection: {error}"
msgstr "연결 대상을 저장하지 못했습니다: {error}"

msgid "Could not save the order: {error}"
msgstr "순서를 저장하지 못했습니다: {error}"

msgid "Delete"
msgstr "삭제"

msgid "Delete \"{names}\" ({side})?"
msgstr "\"{names}\" ({side})을(를) 삭제하시겠습니까?"

msgid "Disconnect"
msgstr "연결 끊기"

msgid "Disconnected."
msgstr "연결이 끊어졌습니다."

msgid "Done"
msgstr "완료"

msgid "Download"
msgstr "다운로드"

msgid "Enter a host name or an IP address."
msgstr "호스트 이름 또는 IP 주소를 입력하세요."

msgid "Enter a name."
msgstr "이름을 입력하세요."

msgid "Enter the remote path."
msgstr "원격 경로를 입력하세요."

msgid "Failed"
msgstr "실패"

msgid "File Transfer"
msgstr "파일 전송"

msgid "Folder (e.g. Offices/Head Office)"
msgstr "폴더 (예: 지점/본사)"

msgid "Go to Parent Folder"
msgstr "상위 폴더로 이동"

msgid "Host name / IP address"
msgstr "호스트 이름 / IP 주소"

msgid "Loading…"
msgstr "로드 중…"

msgid "Local"
msgstr "로컬"

msgid "Local side"
msgstr "로컬 쪽"

msgid "More than {limit} files would be transferred. Transfer them in smaller batches."
msgstr "{limit}개가 넘는 파일을 전송하게 됩니다. 더 작은 단위로 나누어 전송하세요."

msgid "More than {limit} items would be deleted. Delete them in smaller batches."
msgstr "{limit}개가 넘는 항목을 삭제하게 됩니다. 더 작은 단위로 나누어 삭제하세요."

msgid "Moves down one place within the same folder"
msgstr "같은 폴더 안에서 한 칸 아래로 이동합니다"

msgid "Moves up one place within the same folder"
msgstr "같은 폴더 안에서 한 칸 위로 이동합니다"

msgid "Name of the new folder ({side})"
msgstr "새 폴더 이름 ({side})"

msgid "New name for \"{name}\""
msgstr "\"{name}\"의 새 이름"

msgid "No"
msgstr "아니요"

msgid "No items"
msgstr "항목 없음"

msgid "No saved connections yet."
msgstr "아직 저장된 연결 대상이 없습니다."

msgid "Opens the list of saved connections and Remote SSH hosts"
msgstr "저장된 연결 대상과 원격 SSH 호스트 목록을 엽니다"

msgid "Password (optional)"
msgstr "비밀번호 (선택 사항)"

msgid "Port"
msgstr "포트"

msgid "Progress"
msgstr "진행률"

msgid "Queued"
msgstr "대기 중"

msgid "Reconnect"
msgstr "다시 연결"

msgid "Remember password"
msgstr "비밀번호 기억"

msgid "Remote"
msgstr "원격"

msgid "Remote SSH"
msgstr "원격 SSH"

msgid "Removed the saved password."
msgstr "저장된 비밀번호를 삭제했습니다."

msgid "Removes the saved password of this connection"
msgstr "이 연결 대상의 저장된 비밀번호를 삭제합니다"

msgid "Rename one item at a time."
msgstr "이름은 한 번에 한 항목씩 변경하세요."

msgid "Running"
msgstr "실행 중"

msgid "Save"
msgstr "저장"

msgid "Save this connection"
msgstr "이 연결 대상 저장"

msgid "Saved"
msgstr "저장됨"

msgid "Saved the connection \"{name}\"."
msgstr "연결 대상 \"{name}\"을(를) 저장했습니다."

msgid "Select the item to rename."
msgstr "이름을 변경할 항목을 선택하세요."

msgid "Select the items to delete."
msgstr "삭제할 항목을 선택하세요."

msgid "Select the items to download on the remote side."
msgstr "원격 쪽에서 다운로드할 항목을 선택하세요."

msgid "Select the items to upload on the local side."
msgstr "로컬 쪽에서 업로드할 항목을 선택하세요."

msgid "Sends the items selected on the local side to the remote"
msgstr "로컬 쪽에서 선택한 항목을 원격으로 보냅니다"

msgid "Stopped because the connection was closed."
msgstr "연결이 닫혀 중지했습니다."

msgid "Stops connecting"
msgstr "연결을 중지합니다"

msgid "Target: {side}"
msgstr "대상: {side}"

msgid "That name cannot be used."
msgstr "해당 이름은 사용할 수 없습니다."

msgid "The command failed (it printed no details)."
msgstr "명령이 실패했습니다 (세부 정보가 출력되지 않았습니다)."

msgid "The command failed:\n{detail}"
msgstr "명령이 실패했습니다:\n{detail}"

msgid "The connection timed out."
msgstr "연결 시간이 초과되었습니다."

msgid "The host name contains characters that cannot be used."
msgstr "호스트 이름에 사용할 수 없는 문자가 포함되어 있습니다."

msgid "The list of saved connections has not loaded yet."
msgstr "저장된 연결 대상 목록이 아직 로드되지 않았습니다."

msgid "The name contains characters that cannot be used."
msgstr "이름에 사용할 수 없는 문자가 포함되어 있습니다."

msgid "The operation failed:\n{error}"
msgstr "작업이 실패했습니다:\n{error}"

msgid "The password is stored in the operating system's credential manager and shared with Quick Connect"
msgstr "비밀번호는 운영 체제의 자격 증명 관리자에 저장되며 빠른 연결과 공유됩니다"

msgid "The password you entered was rejected. Enter it again."
msgstr "입력한 비밀번호가 거부되었습니다. 다시 입력하세요."

msgid "The port number is invalid."
msgstr "포트 번호가 잘못되었습니다."

msgid "The remote path contains characters that cannot be used."
msgstr "원격 경로에 사용할 수 없는 문자가 포함되어 있습니다."

msgid "The remote path must start with /."
msgstr "원격 경로는 /로 시작해야 합니다."

msgid "The saved password was rejected. Enter it again."
msgstr "저장된 비밀번호가 거부되었습니다. 다시 입력하세요."

msgid "The user name contains characters that cannot be used."
msgstr "사용자 이름에 사용할 수 없는 문자가 포함되어 있습니다."

msgid "This Computer"
msgstr "이 PC"

msgid "This Remote ({display_name})"
msgstr "이 원격 ({display_name})"

msgid "This host's key has not been seen before. Continue connecting?"
msgstr "이 호스트의 키는 처음 보는 키입니다. 연결을 계속하시겠습니까?"

msgid "Upload"
msgstr "업로드"

msgid "User name"
msgstr "사용자 이름"

msgid "Writes to the list shared with Quick Connect"
msgstr "빠른 연결과 공유하는 목록에 기록합니다"

msgid "Yes"
msgstr "예"

