msgstr "Borde del control deslizante"

msgctxt "settings"
msgid "Time in milliseconds until timeout error when connecting to a TCP debug adapter."
msgstr "Tiempo en milisegundos hasta el error de tiempo de espera al conectar con un adaptador de depuración TCP."

msgctxt "settings"
msgid "Time to wait in milliseconds before hiding the hover popover after the mouse moves away."
msgstr "Tiempo de espera en milisegundos antes de ocultar la ventana emergente al pasar el cursor después de alejar el ratón."

msgctxt "settings"
msgid "Time to wait in milliseconds before showing the informational hover box."
msgstr "Tiempo de espera en milisegundos antes de mostrar el cuadro informativo al pasar el cursor."

msgctxt "settings"
msgid "Timeout"
msgstr "Tiempo de espera"

msgctxt "settings"
msgid "Timestamp Each Line"
msgstr "Marca de tiempo en cada línea"

msgctxt "settings"
msgid "Title Bar"
msgstr "Barra de título"

msgctxt "settings"
msgid "Title Format"
msgstr "Formato del título"

msgctxt "settings"
msgid "Title Override"
msgstr "Sobrescritura de título"

msgctxt "settings"
msgid "Title Separator"
msgstr "Separador del título"

msgctxt "settings"
msgid "Toggle On Modifiers Press"
msgstr "Alternar al presionar modificadores"

msgctxt "settings"
msgid "Toggle Relative Line Numbers"
msgstr "Alternar números de línea relativos"

msgctxt "settings"
