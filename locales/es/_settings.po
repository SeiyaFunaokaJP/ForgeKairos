msgstr "Panel del terminal"

msgctxt "settings"
msgid "Terminal Panel Flexible Sizing"
msgstr "Tamaño flexible del panel del terminal"

msgctxt "settings"
msgid "Terminal Thread Init Command"
msgstr "Comando de inicio de conversación de terminal"

msgctxt "settings"
msgid "Test Audio"
msgstr "Probar audio"

msgctxt "settings"
msgid "Test your microphone and speaker setup"
msgstr "Probar la configuración del micrófono y los altavoces"

