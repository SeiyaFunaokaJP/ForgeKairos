msgstr "Muestra la barra lateral de conversaciones a altura completa en la ventana. Si está desactivada, se usa en su lugar el historial de conversaciones dentro del panel del agente."

msgctxt "settings"
msgid "Show the informational hover box when moving the mouse over symbols in the editor."
msgstr "Muestra el cuadro informativo al pasar el ratón sobre símbolos en el editor."

msgctxt "settings"
msgid "Show the menus in the titlebar."
msgstr "Muestra los menús en la barra de título."

msgctxt "settings"
msgid "Show the name of the active file in the status bar."
msgstr "Muestra el nombre del archivo activo en la barra de estado."

msgctxt "settings"
msgid "Show the navigation history buttons in the tab bar."
msgstr "Muestra los botones del historial de navegación en la barra de pestañas."

msgctxt "settings"
msgid "Show the outline panel button in the status bar."
msgstr "Muestra el botón del panel de esquema en la barra de estado."

msgctxt "settings"
msgid "Show the project diagnostics button in the status bar."
msgstr "Muestra el botón de diagnósticos del proyecto en la barra de estado."

msgctxt "settings"
msgid "Show the project host and name in the titlebar."
msgstr "Muestra el host y el nombre del proyecto en la barra de título."

msgctxt "settings"
msgid "Show the project panel button in the status bar."
msgstr "Muestra el botón del panel de proyecto en la barra de estado."

msgctxt "settings"
msgid "Show the project search button in the status bar."
msgstr "Muestra el botón de búsqueda del proyecto en la barra de estado."

msgctxt "settings"
msgid "Show the scrollbar in the project panel."
msgstr "Muestra la barra de desplazamiento en el panel de proyecto."

msgctxt "settings"
msgid "Show the selections menu in the editor toolbar."
msgstr "Muestra el menú de selecciones en la barra de herramientas del editor."

msgctxt "settings"
msgid "Show the sign in button in the titlebar."
msgstr "Muestra el botón de inicio de sesión en la barra de título."

msgctxt "settings"
msgid "Show the signature help pop-up after completions or bracket pairs are inserted."
msgstr "Muestra la ventana emergente de ayuda de firma después de insertar autocompletados o pares de corchetes."

msgctxt "settings"
msgid "Show the tab bar buttons (New, Split Pane, Zoom)."
msgstr "Muestra los botones de la barra de pestañas (Nuevo, Dividir panel, Zoom)."

msgctxt "settings"
msgid "Show the tab bar buttons (New, Split Pane, Zoom, and so on) in panes that are not focused as well."
msgstr "Muestra también los botones de la barra de pestañas (Nuevo, Dividir panel, Zoom, etc.) en los paneles divididos que no tienen el foco."

msgctxt "settings"
msgid "Show the tab bar in the editor."
msgstr "Muestra la barra de pestañas en el editor."

msgctxt "settings"
msgid "Show the terminal button in the status bar."
msgstr "Muestra el botón del terminal en la barra de estado."

msgctxt "settings"
msgid "Show the thread history to the left of the current thread inside the agent panel. Hidden automatically when the panel is too narrow."
msgstr "Muestra el historial de conversaciones a la izquierda de la conversación actual dentro del panel del agente. Se oculta automáticamente cuando el panel es demasiado estrecho."

msgctxt "settings"
msgid "Show the user menu button in the titlebar."
msgstr "Muestra el botón del menú de usuario en la barra de título."

msgctxt "settings"
msgid "Show the worktree name button in the titlebar."
msgstr "Muestra el botón del nombre del worktree en la barra de título."

msgctxt "settings"
msgid "Show user picture in the titlebar."
msgstr "Muestra la imagen del usuario en la barra de título."

msgctxt "settings"
msgid "Show voting thumbs up/down icon buttons for feedback on agent edits."
msgstr "Muestra botones de icono de pulgar arriba/abajo para enviar comentarios sobre las ediciones del agente."

msgctxt "settings"
msgid "Show wrap guides (vertical rulers)."
msgstr "Muestra las guías de ajuste de línea (reglas verticales)."

msgctxt "settings"
msgid "Show wrap guides in the editor."
msgstr "Muestra las guías de ajuste de línea en el editor."

