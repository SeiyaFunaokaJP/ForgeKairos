msgstr "Familia de fuentes de la interfaz"

msgctxt "settings"
msgid "UI Font Size"
msgstr "Tamaño de fuente de la interfaz"

msgctxt "settings"
msgid "Unnecessary Code Fade"
msgstr "Atenuación de código innecesario"

msgctxt "settings"
