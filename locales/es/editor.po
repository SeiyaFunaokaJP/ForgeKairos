msgid "quadrantChart\n    %% A point is Name: [x, y], both from 0 to 1\n    title Initiative Priorities\n    x-axis Low Effort --> High Effort\n    y-axis Low Impact --> High Impact\n    quadrant-1 Plan and Do\n    quadrant-2 Do Now\n    quadrant-3 Do Later\n    quadrant-4 Reconsider\n    Initiative A: [0.3, 0.8]\n    Initiative B: [0.7, 0.6]\n    Initiative C: [0.2, 0.3]"
msgstr "quadrantChart\n    %% Un punto es Nombre: [x, y], ambos de 0 a 1\n    title Prioridades de las iniciativas\n    x-axis Poco esfuerzo --> Mucho esfuerzo\n    y-axis Poco impacto --> Mucho impacto\n    quadrant-1 Planificar y hacer\n    quadrant-2 Hacer ahora\n    quadrant-3 Hacer más tarde\n    quadrant-4 Reconsiderar\n    Iniciativa A: [0.3, 0.8]\n    Iniciativa B: [0.7, 0.6]\n    Iniciativa C: [0.2, 0.3]"

msgid "radar-beta\n    %% axis defines the axes and curve a series. List the values in the order of the axes\n    title Skill Comparison\n    axis design[\"Design\"], build[\"Implementation\"], test[\"Testing\"], ops[\"Operations\"]\n    curve a[\"Person A\"]{{4, 3, 5, 2}}\n    curve b[\"Person B\"]{{2, 5, 3, 4}}\n    max 5"
msgstr "radar-beta\n    %% axis define los ejes y curve una serie. Enumere los valores en el orden de los ejes\n    title Comparación de habilidades\n    axis design[\"Diseño\"], build[\"Implementación\"], test[\"Pruebas\"], ops[\"Operaciones\"]\n    curve a[\"Persona A\"]{{4, 3, 5, 2}}\n    curve b[\"Persona B\"]{{2, 5, 3, 4}}\n    max 5"

