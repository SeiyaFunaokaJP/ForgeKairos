msgid "requirementDiagram\n    %% requirement declares a requirement; element declares what satisfies it. Connect them with - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Users can log in\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Screen\"\n    }}\n    login_page - satisfies -> login"
msgstr "requirementDiagram\n    %% requirement declara un requisito; element declara lo que lo satisface. Conéctelos con - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Los usuarios pueden iniciar sesión\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Pantalla\"\n    }}\n    login_page - satisfies -> login"

msgid "sankey-beta\n    %% Each line is source,target,amount. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"
msgstr "sankey-beta\n    %% Cada línea es origen,destino,cantidad. Escriba los nombres con letras y dígitos ASCII (Mermaid no puede leer nombres que no sean ASCII)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"

msgid "sequenceDiagram\n    %% ->> is a call and -->> a reply\n    participant User as User\n    participant App as App\n    User->>App: Request\n    App-->>User: Response\n    Note over App: Note"
msgstr "sequenceDiagram\n    %% ->> es una llamada y -->> una respuesta\n    participant User as Usuario\n    participant App as Aplicación\n    User->>App: Solicitud\n    App-->>User: Respuesta\n    Note over App: Nota"

msgid "stateDiagram-v2\n    %% [*] is the start and the end. The text after : on an arrow is the event name\n    [*] --> Idle\n    Idle --> Running: Start\n    Running --> Idle: Finish\n    Running --> [*]: Abort"
msgstr "stateDiagram-v2\n    %% [*] es el inicio y el fin. El texto después de : en una flecha es el nombre del evento\n    [*] --> Idle\n    Idle --> Running: Iniciar\n    Running --> Idle: Terminar\n    Running --> [*]: Anular"

msgid "the latest version"
msgstr "la versión más reciente"

msgid "timeline\n    title History\n    2024 : Planning\n    2025 : Development : Release\n    2026 : Operation"
msgstr "timeline\n    title Historia\n    2024 : Planificación\n    2025 : Desarrollo : Lanzamiento\n    2026 : Operación"

msgid "treeView-beta\n    %% Indentation shows the hierarchy\n    \"Project\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""
msgstr "treeView-beta\n    %% La sangría muestra la jerarquía\n    \"Proyecto\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""

msgid "treemap-beta\n    %% Indentation nests items. Give each leaf a value after :\n    \"Development\"\n        \"Design\": 30\n        \"Implementation\": 50\n    \"Operations\"\n        \"Maintenance\": 15\n        \"Monitoring\": 5"
msgstr "treemap-beta\n    %% La sangría anida los elementos. Asigne un valor a cada hoja después de :\n    \"Desarrollo\"\n        \"Diseño\": 30\n        \"Implementación\": 50\n    \"Operaciones\"\n        \"Mantenimiento\": 15\n        \"Supervisión\": 5"

msgid "type named by the language server"
msgstr "tipo indicado por el servidor de lenguaje"

msgid "venn-beta\n    %% set defines a set and union names an overlap\n    title Overlapping Responsibilities\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"
msgstr "venn-beta\n    %% set define un conjunto y union da nombre a una superposición\n    title Responsabilidades superpuestas\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"

msgid "xychart-beta\n    %% bar draws bars and line a line. Give as many values as the x-axis has items\n    title \"Monthly Sales\"\n    x-axis [\"Jan\", \"Feb\", \"Mar\", \"Apr\"]\n    y-axis \"Sales (USD thousands)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"
msgstr "xychart-beta\n    %% bar dibuja barras y line una línea. Indique tantos valores como elementos tenga el eje x\n    title \"Ventas mensuales\"\n    x-axis [\"Ene\", \"Feb\", \"Mar\", \"Abr\"]\n    y-axis \"Ventas (miles de USD)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"

