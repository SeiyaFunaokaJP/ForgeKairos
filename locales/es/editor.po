msgid "eventmodeling\n    %% tf number type name. ui is a screen, cmd a command, evt an event and rmo a read model. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"
msgstr "eventmodeling\n    %% tf número tipo nombre. ui es una pantalla, cmd un comando, evt un evento y rmo un modelo de lectura. Escriba los nombres con letras y dígitos ASCII (Mermaid no puede leer nombres que no sean ASCII)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"

msgid "flowchart TD\n    %% [] is a step and {{}} a decision. |label| annotates a branch\n    start[Start] --> condition{{Condition}}\n    condition -->|Yes| work[Process]\n    condition -->|No| finish[End]\n    work --> finish"
msgstr "flowchart TD\n    %% [] es un paso y {{}} una decisión. |etiqueta| anota una rama\n    start[Inicio] --> condition{{Condición}}\n    condition -->|Sí| work[Proceso]\n    condition -->|No| finish[Fin]\n    work --> finish"

