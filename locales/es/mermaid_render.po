msgstr "Opcional (opt)"

msgid "Other: {name}"
msgstr "Otro: {name}"

msgid "Otherwise (else)"
msgstr "En otro caso (else)"

msgid "Overlapping parallel (par_over)"
msgstr "Paralelo superpuesto (par_over)"

msgid "Parallel (par)"
msgstr "Paralelo (par)"

msgid "Parallelogram (reversed) [\\output\\]"
msgstr "Paralelogramo (invertido) [\\salida\\]"

