msgid ""
msgstr ""
"Language: es\n"
"X-Language-Name: Español\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "A Note has no target."
msgstr "Una nota (Note) no tiene destino."

msgid "A `%%{{` directive is on the same line as a statement or a comment (Mermaid cuts out only the directive and reads the rest as a statement). Write the directive on a line of its own, or edit it as text."
msgstr "Una directiva `%%{{` está en la misma línea que una instrucción o un comentario (Mermaid recorta solo la directiva y lee el resto como instrucción). Escriba la directiva en una línea propia o edítelo como texto."

msgid "A `%%{{` inside a comment runs on to the next line ({line}). Mermaid does not read the lines in between, so the structured editor cannot handle it."
msgstr "Un `%%{{` dentro de un comentario continúa en la línea siguiente ({line}). Mermaid no lee las líneas intermedias, por lo que el editor estructurado no puede procesarlo."

msgid "A `block` group is not closed with `end`. Edit it as text."
msgstr "Un grupo `block` no está cerrado con `end`. Edítelo como texto."

msgid "A `section` without a name is not supported by the structured editor ({statement}). Give it a name, or edit it as text."
msgstr "El editor estructurado no admite una `section` sin nombre ({statement}). Asígnele un nombre o edítelo como texto."

msgid "A `section` without a name is not supported by the structured editor ({trimmed}). Give it a name, or edit it as text."
msgstr "El editor estructurado no admite una `section` sin nombre ({trimmed}). Asígnele un nombre o edítelo como texto."

msgid "A comment (`%%`) on a line of data `{name}` is lost in the structured editor. Move the comment to a line of its own outside the block, then open it again."
msgstr "Un comentario (`%%`) en una línea de datos `{name}` se pierde en el editor estructurado. Mueva el comentario a una línea propia fuera del bloque y vuelva a abrirlo."

msgid "A comment at the end of a frame line is lost in the structured editor ({line}). Move the comment to a line of its own, then open it again."
msgstr "Un comentario al final de una línea de marco se pierde en el editor estructurado ({line}). Mueva el comentario a una línea propia y vuelva a abrirlo."

msgid "A comment in the middle or at the end of a statement is lost in the structured editor ({trimmed}). Move the comment to a line of its own, or edit it as text."
msgstr "Un comentario en medio o al final de una instrucción se pierde en el editor estructurado ({trimmed}). Mueva el comentario a una línea propia o edítelo como texto."

msgid "A comment inside a `curve` that spans several lines is lost in the structured editor ({trimmed}). Move the comment outside, or edit it as text."
msgstr "Un comentario dentro de un `curve` que abarca varias líneas se pierde en el editor estructurado ({trimmed}). Mueva el comentario fuera o edítelo como texto."

msgid "A comment inside a statement that spans several lines is lost in the structured editor ({trimmed}). Move the comment outside the statement, or edit it as text."
msgstr "Un comentario dentro de una instrucción que abarca varias líneas se pierde en el editor estructurado ({trimmed}). Mueva el comentario fuera de la instrucción o edítelo como texto."

msgid "A comment must be a single line that starts with `%%`."
msgstr "Un comentario debe ser una sola línea que empiece por `%%`."

msgid "A date cannot be written into `{other}` of `dateFormat`"
msgstr "No se puede escribir una fecha en `{other}` de `dateFormat`"

msgid "A deactivate has no target."
msgstr "Un deactivate no tiene destino."

msgid "A field of 0 bits cannot be written ({statement})."
msgstr "No se puede escribir un campo de 0 bits ({statement})."

msgid "A frame whose name contains %% cannot be handled by the structured editor ({line})."
msgstr "El editor estructurado no puede procesar un marco cuyo nombre contiene %% ({line})."

msgid "A group without an ID cannot have a label or a width. Give it an ID."
msgstr "Un grupo sin ID no puede tener etiqueta ni ancho. Asígnele un ID."

msgid "A line of the Sankey diagram has a fourth column ({}). Write only the three columns `source,target,value`."
msgstr "Una línea del diagrama de Sankey tiene una cuarta columna ({}). Escriba solo las tres columnas `source,target,value`."

msgid "A line that contains `end note` cannot be written in the text of a note ({trimmed}). Edit it as text."
msgstr "No se puede escribir una línea que contenga `end note` en el texto de una nota ({trimmed}). Edítelo como texto."

msgid "A multi-line `@{{` is supported only when its first line ends with `@{{` and the lines after it are written as `key: value`."
msgstr "Un `@{{` de varias líneas solo se admite si su primera línea termina con `@{{` y las líneas siguientes se escriben como `key: value`."

msgid "A node label cannot contain line breaks."
msgstr "La etiqueta de un nodo no puede contener saltos de línea."

msgid "A node name cannot contain line breaks."
msgstr "El nombre de un nodo no puede contener saltos de línea."

msgid "A space is needed after `:` ({trimmed})."
msgstr "Se necesita un espacio después de `:` ({trimmed})."

msgid "A statement follows `%%{{…}}%%` on the same line (line {}). Put the directive on its own line, then open it."
msgstr "Hay una instrucción después de `%%{{…}}%%` en la misma línea (línea {}). Coloque la directiva en una línea propia y luego ábralo."

msgid "A statement follows `%%{{…}}%%` on the same line ({}). Put the directive and the statement on separate lines, then open the editor."
msgstr "Hay una instrucción después de `%%{{…}}%%` en la misma línea ({}). Coloque la directiva y la instrucción en líneas separadas y luego abra el editor."

msgid "A {what} has an empty ID."
msgstr "Un elemento ({what}) tiene un ID vacío."

msgid "Aggregation (left is whole)"
msgstr "Agregación (la izquierda es el todo)"

msgid "Aggregation (right is whole)"
msgstr "Agregación (la derecha es el todo)"

msgid "Alternative (alt)"
msgstr "Alternativa (alt)"

msgid "An `accTitle` after `title` becomes the diagram's title, so `title` is not used."
msgstr "Un `accTitle` después de `title` se convierte en el título del diagrama, por lo que `title` no se usa."

msgid "An activate has no target."
msgstr "Un activate no tiene destino."

msgid "An arrow has no receiver."
msgstr "Una flecha no tiene receptor."

msgid "An arrow has no sender."
msgstr "Una flecha no tiene emisor."

msgid "An empty `\"\"` after `-->` is not supported by the structured editor. Remove it, or edit it as text."
msgstr "El editor estructurado no admite un `\"\"` vacío después de `-->`. Quítelo o edítelo como texto."

msgid "An empty label `[\"\"]` is not supported by the structured editor ({line}). Write a label or remove `[\"\"]`, then open it again."
msgstr "El editor estructurado no admite una etiqueta vacía `[\"\"]` ({line}). Escriba una etiqueta o quite `[\"\"]` y vuelva a abrirlo."

msgid "An item outside any group is indented. Use “Move into the Group Above” to put it into a group."
msgstr "Un elemento fuera de cualquier grupo tiene sangría. Use “Mover al grupo de arriba” para colocarlo en un grupo."

msgid "Arrow"
msgstr "Flecha"

msgid "Association (line only)"
msgstr "Asociación (solo línea)"

msgid "Association (pointing left)"
msgstr "Asociación (hacia la izquierda)"

msgid "Association (pointing right)"
msgstr "Asociación (hacia la derecha)"

msgid "At the same time (and)"
msgstr "Al mismo tiempo (and)"

msgid "Automation (pcr)"
msgstr "Automatización (pcr)"

msgid "Background (rect)"
msgstr "Fondo (rect)"

msgid "Bang )) (("
msgstr "Explosión )) (("

msgid "Because of how `%%{{…}}%%` or similar is written, what the structured editor reads does not match the diagram Mermaid draws. Edit it as text."
msgstr "Debido a cómo está escrito `%%{{…}}%%` o algo similar, lo que lee el editor estructurado no coincide con el diagrama que dibuja Mermaid. Edítelo como texto."

msgid "Both inline data and a data reference are written ({line}). Keep only one, then open it again."
msgstr "Se escribieron tanto datos en línea como una referencia a datos ({line}). Conserve solo uno y vuelva a abrirlo."

msgid "Bottom to top (BT)"
msgstr "De abajo arriba (BT)"

msgid "Box (participant)"
msgstr "Caja (participant)"

msgid "Branch `{name}` is referenced by operation {list}. Delete it first, or point it at another branch."
msgid_plural "Branch `{name}` is referenced by operations {list}. Delete them first, or point them at another branch."
msgstr[0] "La operación {list} hace referencia a la rama `{name}`. Elimine primero esa operación o apúntela a otra rama."
msgstr[1] "Las operaciones {list} hacen referencia a la rama `{name}`. Elimínelas primero o apúntelas a otra rama."

msgid "Break (break)"
msgstr "Interrupción (break)"

msgid "Cannot delete {what}, because the dates of the tasks that refer to it cannot be calculated."
msgstr "No se puede eliminar {what} porque no se pueden calcular las fechas de las tareas que hacen referencia a ello."

msgid "Cannot delete {what}, because the dates of the tasks that refer to it cannot be calculated. The diagram cannot be drawn with its current content ({error}). Fix the fields outlined in red first."
msgstr "No se puede eliminar {what} porque no se pueden calcular las fechas de las tareas que hacen referencia a ello. El diagrama no se puede dibujar con su contenido actual ({error}). Corrija primero los campos marcados en rojo."

msgid "Cannot delete {what}."
msgstr "No se puede eliminar {what}."

msgid "Cannot delete {what}: the end of task `{task}`, which refers to it, would change. First rewrite the `after` / `until` of `{task}` as a date."
msgstr "No se puede eliminar {what}: cambiaría el fin de la tarea `{task}`, que hace referencia a ello. Reescriba primero el `after` / `until` de `{task}` como fecha."

msgid "Cannot delete {what}: the end of task `{}` would have to be written as a date, which is not possible ({error})."
msgstr "No se puede eliminar {what}: el fin de la tarea `{}` tendría que escribirse como fecha, lo cual no es posible ({error})."

msgid "Cannot delete {what}: the start of task `{task}`, which refers to it, would change. First rewrite the `after` / `until` of `{task}` as a date."
msgstr "No se puede eliminar {what}: cambiaría el inicio de la tarea `{task}`, que hace referencia a ello. Reescriba primero el `after` / `until` de `{task}` como fecha."

msgid "Cannot delete {what}: the start of task `{}` would have to be written as a date, which is not possible ({error})."
msgstr "No se puede eliminar {what}: el inicio de la tarea `{}` tendría que escribirse como fecha, lo cual no es posible ({error})."

msgid "Central connections written with `()` are not supported by the structured editor. Edit it as text."
msgstr "El editor estructurado no admite las conexiones centrales escritas con `()`. Edítelo como texto."

msgid "Choice (option)"
msgstr "Opción (option)"

msgid "Choice <<choice>>"
msgstr "Elección <<choice>>"

msgid "Choose the commit to cherry-pick."
msgstr "Elija el commit que desea aplicar con cherry-pick."

msgid "Circle (( ))"
msgstr "Círculo (( ))"

msgid "Circle ((point))"
msgstr "Círculo ((punto))"

msgid "Circle end"
msgstr "Extremo circular"

msgid "Close a one-line `namespace` with `}}` on the same line ({statement}). Split it into several lines, or edit it as text."
msgstr "Cierre un `namespace` de una línea con `}}` en la misma línea ({statement}). Divídalo en varias líneas o edítelo como texto."

msgid "Close the arrow block in `{line}` with `]>`."
msgstr "Cierre el bloque de flecha de `{line}` con `]>`."

msgid "Close the arrow direction in `{line}` with `)`."
msgstr "Cierre la dirección de la flecha de `{line}` con `)`."

msgid "Cloud"
msgstr "Nube"

msgid "Cloud ) ("
msgstr "Nube ) ("

msgid "Command (cmd)"
msgstr "Comando (cmd)"

msgid "Comments at the end of a statement (from `#` or `%%` onward) would be lost in the structured editor ({}). Move the comment to its own line, or enclose values that contain `#` in `\"`."
msgstr "Los comentarios al final de una instrucción (desde `#` o `%%` en adelante) se perderían en el editor estructurado ({}). Mueva el comentario a una línea propia o encierre entre `\"` los valores que contengan `#`."

msgid "Comments inside an attribute block would be lost in the structured editor ({statement}). Move the comment out of the block, or edit it as text."
msgstr "Los comentarios dentro de un bloque de atributos se perderían en el editor estructurado ({statement}). Mueva el comentario fuera del bloque o edítelo como texto."

msgid "Commit `{id}` is referenced by the cherry-pick at operation {list}. Delete it first."
msgid_plural "Commit `{id}` is referenced by the cherry-picks at operations {list}. Delete them first."
msgstr[0] "El cherry-pick de la operación {list} hace referencia al commit `{id}`. Elimínelo primero."
msgstr[1] "Los cherry-picks de las operaciones {list} hacen referencia al commit `{id}`. Elimínelos primero."

msgid "Component diagram"
msgstr "Diagrama de componentes"

msgid "Composite states are nested too deeply. Edit it as text."
msgstr "Los estados compuestos están anidados a demasiada profundidad. Edítelo como texto."

msgid "Composition (left is whole)"
msgstr "Composición (la izquierda es el todo)"

msgid "Composition (right is whole)"
msgstr "Composición (la derecha es el todo)"

msgid "Container diagram"
msgstr "Diagrama de contenedores"

msgid "Contains (contains)"
msgstr "Contiene (contains)"

msgid "Context diagram"
msgstr "Diagrama de contexto"

msgid "Copies (copies)"
msgstr "Copia (copies)"

msgid "Could not determine which item the end-of-line comment ({comment}) belongs to. Move the comment to its own line, or edit it as text."
msgstr "No se pudo determinar a qué elemento pertenece el comentario de final de línea ({comment}). Mueva el comentario a una línea propia o edítelo como texto."

msgid "Could not find the details of participant `{model_id}`."
msgstr "No se encontraron los detalles del participante `{model_id}`."

msgid "Could not find the entity on the left side of a relationship."
msgstr "No se encontró la entidad del lado izquierdo de una relación."

msgid "Could not find the entity on the right side of a relationship."
msgstr "No se encontró la entidad del lado derecho de una relación."

msgid "Could not read `{other}` as a requirement field."
msgstr "No se pudo leer `{other}` como campo de requisito."

msgid "Could not read `{other}` as an element field."
msgstr "No se pudo leer `{other}` como campo de elemento."

msgid "Could not read `{rest}` after the `)` of `{statement}`."
msgstr "No se pudo leer `{rest}` después del `)` de `{statement}`."

msgid "Could not read `{rest}` after the `class` statement ({statement})."
msgstr "No se pudo leer `{rest}` después de la instrucción `class` ({statement})."

msgid "Could not read `{rest}` after the relation ({statement})."
msgstr "No se pudo leer `{rest}` después de la relación ({statement})."

msgid "Could not read `{statement}` as a C4 diagram statement. Edit it as text."
msgstr "No se pudo leer `{statement}` como instrucción de diagrama C4. Edítelo como texto."

msgid "Could not read `{statement}` as a class assignment."
msgstr "No se pudo leer `{statement}` como asignación de clase."

msgid "Could not read `{statement}` as a relationship."
msgstr "No se pudo leer `{statement}` como relación."

msgid "Could not read `{statement}` as a requirement diagram statement. Edit it as text."
msgstr "No se pudo leer `{statement}` como instrucción de diagrama de requisitos. Edítelo como texto."

msgid "Could not read `{statement}` as an item of a block (`{opening}`)."
msgstr "No se pudo leer `{statement}` como elemento de un bloque (`{opening}`)."

msgid "Could not read `{statement}`. A class diagram statement is one of `class A`, `A : member`, `A --> B`, `<<annotation>> A` and `note for A \"…\"`."
msgstr "No se pudo leer `{statement}`. Una instrucción de diagrama de clases es una de estas: `class A`, `A : member`, `A --> B`, `<<annotation>> A` y `note for A \"…\"`."

msgid "Could not read `{trailing}` after the `\"` of `{input}`."
msgstr "No se pudo leer `{trailing}` después de la `\"` de `{input}`."

msgid "Could not read `{value}` of `{name}` ({line}). {number_rule}"
msgstr "No se pudo leer `{value}` de `{name}` ({line}). {number_rule}"

msgid "Could not read `{}` after `<<annotation>> ClassName` ({statement})."
msgstr "No se pudo leer `{}` después de `<<annotation>> ClassName` ({statement})."

msgid "Could not read `{}` after `]` ({statement})."
msgstr "No se pudo leer `{}` después de `]` ({statement})."

msgid "Could not read `{}` after axis `{id}` ({line})."
msgstr "No se pudo leer `{}` después del eje `{id}` ({line})."

msgid "Could not read `{}` after the note ({statement})."
msgstr "No se pudo leer `{}` después de la nota ({statement})."

msgid "Could not read `{}` after the quotes ({statement})."
msgstr "No se pudo leer `{}` después de las comillas ({statement})."

msgid "Could not read `{}` after the range ({statement})."
msgstr "No se pudo leer `{}` después del intervalo ({statement})."

msgid "Could not read `{}` as a risk."
msgstr "No se pudo leer `{}` como riesgo."

msgid "Could not read `{}` as a verification method."
msgstr "No se pudo leer `{}` como método de verificación."

msgid "Could not read `{}` in `{statement}`."
msgstr "No se pudo leer `{}` en `{statement}`."

msgid "Could not read `{}` the way Mermaid does. Edit it as text."
msgstr "No se pudo leer `{}` de la misma forma que Mermaid. Edítelo como texto."

msgid "Could not read both ends of `{statement}`."
msgstr "No se pudieron leer ambos extremos de `{statement}`."

msgid "Could not read both ends of `{}`."
msgstr "No se pudieron leer ambos extremos de `{}`."

msgid "Could not read the ID of an edge end ({statement})."
msgstr "No se pudo leer el ID de un extremo de arista ({statement})."

msgid "Could not read the ID of the junction ({statement})."
msgstr "No se pudo leer el ID de la unión ({statement})."

msgid "Could not read the ID of the service ({statement})."
msgstr "No se pudo leer el ID del servicio ({statement})."

msgid "Could not read the alias of `{text}` (write the alias as the first argument, without `$…=`)."
msgstr "No se pudo leer el alias de `{text}` (escriba el alias como primer argumento, sin `$…=`)."

msgid "Could not read the axis ID ({line})."
msgstr "No se pudo leer el ID del eje ({line})."

msgid "Could not read the class name ({statement})."
msgstr "No se pudo leer el nombre de clase ({statement})."

msgid "Could not read the class name `{keyword}` applies to ({statement}). Names enclosed in `` ` `` are not supported by the structured editor. Edit it as text."
msgstr "No se pudo leer el nombre de clase al que se aplica `{keyword}` ({statement}). El editor estructurado no admite nombres encerrados entre `` ` ``. Edítelo como texto."

msgid "Could not read the curve ID ({line})."
msgstr "No se pudo leer el ID de la curva ({line})."

msgid "Could not read the date and time"
msgstr "No se pudo leer la fecha y hora"

msgid "Could not read the end `{end}` ({statement})."
msgstr "No se pudo leer el fin `{end}` ({statement})."

msgid "Could not read the group ID ({statement})."
msgstr "No se pudo leer el ID del grupo ({statement})."

msgid "Could not read the group ID after `in` ({statement})."
msgstr "No se pudo leer el ID del grupo después de `in` ({statement})."

msgid "Could not read the one-line `namespace` ({statement})."
msgstr "No se pudo leer el `namespace` de una línea ({statement})."

msgid "Could not read the position of a Note."
msgstr "No se pudo leer la posición de una nota (Note)."

msgid "Could not read the range `{min} --> {max}` as numbers ({statement})."
msgstr "No se pudo leer el intervalo `{min} --> {max}` como números ({statement})."

msgid "Could not read the start `{text}` ({statement})."
msgstr "No se pudo leer el inicio `{text}` ({statement})."

msgid "Could not read the target of the style assignment ({text})."
msgstr "No se pudo leer el destino de la asignación de estilo ({text})."

msgid "Could not read the targets `{}` of `{keyword}`. Write IDs made of ASCII letters, digits, `_` and `-`, separated by spaces."
msgstr "No se pudieron leer los destinos `{}` de `{keyword}`. Escriba ID formados por letras ASCII, dígitos, `_` y `-`, separados por espacios."

msgid "Could not read the task fields `{}` ({statement}). Of `tags, ID, start, end`, write 1 to 3 fields, not counting the tags."
msgstr "No se pudieron leer los campos de la tarea `{}` ({statement}). De `tags, ID, start, end`, escriba de 1 a 3 campos, sin contar las etiquetas."

msgid "Could not read the value `{entry}` of curve `{curve}` ({line}). {number_rule}"
msgstr "No se pudo leer el valor `{entry}` de la curva `{curve}` ({line}). {number_rule}"

msgid "Could not read the x-axis ticks ({statement})."
msgstr "No se pudieron leer las marcas del eje x ({statement})."

msgid "Could not read the y-axis range ({statement}). Write it as `0 --> 100`."
msgstr "No se pudo leer el intervalo del eje y ({statement}). Escríbalo como `0 --> 100`."

msgid "Could not read this as a Gantt chart line ({statement}). Write it as `task name :start, end`."
msgstr "No se pudo leer esto como una línea de diagrama de Gantt ({statement}). Escríbalo como `task name :start, end`."

msgid "Could not read this as a kanban node ({node_part}). Edit it as text."
msgstr "No se pudo leer esto como un nodo de kanban ({node_part}). Edítelo como texto."

msgid "Could not read this as a radar chart statement ({trimmed}). Edit it as text."
msgstr "No se pudo leer esto como una instrucción de gráfico radial ({trimmed}). Edítelo como texto."

msgid "Could not read this as a style assignment ({text})."
msgstr "No se pudo leer esto como una asignación de estilo ({text})."

msgid "Could not read this as an XY chart statement ({statement}). Edit it as text."
msgstr "No se pudo leer esto como una instrucción de gráfico XY ({statement}). Edítelo como texto."

msgid "Cross end"
msgstr "Extremo en cruz"

msgid "Curve `{id}` mixes values with and without axis names ({line})."
msgstr "La curva `{id}` mezcla valores con y sin nombres de eje ({line})."

msgid "Curve `{}` has a value for `{axis}`, but there is no such axis ({line}). Mermaid does not draw this value, so remove it or add the axis, then open it again."
msgstr "La curva `{}` tiene un valor para `{axis}`, pero ese eje no existe ({line}). Mermaid no dibuja este valor, así que quítelo o agregue el eje y vuelva a abrirlo."

msgid "Curve `{}` has no value for axis `{}` ({line})."
msgstr "La curva `{}` no tiene ningún valor para el eje `{}` ({line})."

msgid "Curve `{}` has no values. Write at least one value (Mermaid does not accept an empty curve)."
msgstr "La curva `{}` no tiene valores. Escriba al menos un valor (Mermaid no acepta una curva vacía)."

msgid "Curve `{}` has two values for axis `{axis}` ({line}). Mermaid draws only the first one, so keep one, then open it again."
msgstr "La curva `{}` tiene dos valores para el eje `{axis}` ({line}). Mermaid solo dibuja el primero, así que conserve uno y vuelva a abrirlo."

msgid "Curve `{}` writes its values with axis names, but there are no axes."
msgstr "La curva `{}` escribe sus valores con nombres de eje, pero no hay ejes."

msgid "Curve `{}` writes its values with axis names, so every axis needs a value."
msgstr "La curva `{}` escribe sus valores con nombres de eje, por lo que cada eje necesita un valor."

msgid "Curve `{}`: value {} is empty. Values in the middle cannot be empty (empty cells at the end count as no value)."
msgstr "Curva `{}`: el valor {} está vacío. Los valores intermedios no pueden estar vacíos (las celdas vacías al final cuentan como sin valor)."

msgid "Cylinder [( )]"
msgstr "Cilindro [( )]"

msgid "Dashed (line only)"
msgstr "Discontinua (solo línea)"

msgid "Data `{name}` cannot be handled by the structured editor. Start it with the line `data {name} {{` and end it with a line that is only `}}` at the start (Mermaid does not accept a one-line block)."
msgstr "El editor estructurado no puede procesar los datos `{name}`. Empiece con la línea `data {name} {{` y termine con una línea que solo contenga `}}` al principio (Mermaid no acepta un bloque de una línea)."

msgid "Data `{name}` has no contents."
msgstr "Los datos `{name}` no tienen contenido."

msgid "Database"
msgstr "Base de datos"

msgid "Database [(store)]"
msgstr "Base de datos [(almacén)]"

msgid "Dependency (pointing left)"
msgstr "Dependencia (hacia la izquierda)"

msgid "Dependency (pointing right)"
msgstr "Dependencia (hacia la derecha)"

msgid "Deployment diagram"
msgstr "Diagrama de implementación"

msgid "Derives (derives)"
msgstr "Deriva (derives)"

msgid "Diagrams that use edge IDs (`{target}@`) are not supported by the structured editor ({statement}). Edit it as text."
msgstr "El editor estructurado no admite diagramas que usan ID de arista (`{target}@`) ({statement}). Edítelo como texto."

msgid "Diagrams where the edge ID `{id}` is the same as a node or group ID are not supported by the structured editor. Edit it as text."
msgstr "El editor estructurado no admite diagramas en los que el ID de arista `{id}` coincide con el ID de un nodo o grupo. Edítelo como texto."

msgid "Diagrams with a class on an edge ({edge}) are not supported by the structured editor. Edit it as text."
msgstr "El editor estructurado no admite diagramas con una clase en una arista ({edge}). Edítelo como texto."

msgid "Diagrams with a duplicate edge ID `{id}` are not supported by the structured editor. Edit it as text."
msgstr "El editor estructurado no admite diagramas con un ID de arista duplicado `{id}`. Edítelo como texto."

msgid "Diamond { }"
