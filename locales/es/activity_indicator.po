msgstr "Agregar a la lista de permitidos y reintentar"

msgid "Building the symbol index ({done} / {total})"
msgstr "Creando el índice de símbolos ({done} / {total})"

msgid "Cancel {title}"
msgstr "Cancelar {title}"

msgid "Checking for updates to {}..."
msgstr "Buscando actualizaciones de {}..."

