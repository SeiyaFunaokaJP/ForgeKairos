msgid "Import"
msgstr "Importar"

msgid "Import Settings"
msgstr "Importar configuración"

msgid "Importing {} settings may overwrite your existing settings. Will import settings from {}"
msgstr "La importación de la configuración de {} puede sobrescribir la configuración existente. Se importará la configuración desde {}"

msgid "Install"
msgstr "Instalar"

