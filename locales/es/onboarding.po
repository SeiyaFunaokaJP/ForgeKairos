msgstr "Más información"

msgid "Light"
msgstr "Claro"

msgid "Normal"
msgstr "Normal"

msgid "Onboarding"
msgstr "Introducción"

msgid "Open Log"
msgstr "Abrir registro"

msgid "Select a base keymap..."
msgstr "Seleccione un mapa de teclas base..."

msgid "Sign In"
msgstr "Iniciar sesión"

msgid "Signing In…"
msgstr "Iniciando sesión…"

msgid "Start Free Trial"
msgstr "Iniciar prueba gratuita"

msgid "System"
msgstr "Sistema"

