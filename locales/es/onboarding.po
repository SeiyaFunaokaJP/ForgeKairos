msgid "Agent Setup"
msgstr "Configuración del agente"

msgid "Automatically mark all new projects as trusted to unlock all Zed's features"
msgstr "Marca automáticamente todos los proyectos nuevos como de confianza para desbloquear todas las funciones de ForgeKairos"

msgid "Automatically pull your settings from other editors"
msgstr "Importa automáticamente la configuración desde otros editores"

msgid "Base Keymap"
msgstr "Mapa de teclas base"

msgid "Cancel"
msgstr "Cancelar"

msgid "Could not find or load a {source} settings file"
