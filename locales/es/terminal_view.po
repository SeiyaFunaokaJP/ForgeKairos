msgid "claude was not found on PATH. Run “terminal: install claude code” from the command palette first."
msgstr "No se encontró claude en el PATH. Ejecute primero “Terminal: instalar Claude Code (comando oficial)” desde la paleta de comandos."

msgid "claude was not found on the remote host. Install it by running this command in a terminal on the remote host:\ncurl -fsSL https://claude.ai/install.sh | bash\nIt is installed to `~/.local/bin/claude` and can be launched from then on."
msgstr "No se encontró claude en el host remoto. Instálelo ejecutando este comando en un terminal del host remoto:\ncurl -fsSL https://claude.ai/install.sh | bash\nSe instala en `~/.local/bin/claude` y a partir de entonces se puede iniciar."

msgid "no count"
msgstr "sin número"

msgid "npm was not found on PATH. Installing Claude Code requires Node.js. Install Node.js from https://nodejs.org/ and try again."
msgstr "No se encontró npm en el PATH. Para instalar Claude Code se requiere Node.js. Instale Node.js desde https://nodejs.org/ e inténtelo de nuevo."

msgid "npm was not found on the remote host. Install Node.js in a terminal on the remote host and try again."
msgstr "No se encontró npm en el host remoto. Instale Node.js en un terminal del host remoto e inténtelo de nuevo."

