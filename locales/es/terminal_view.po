msgid "${{{name}}} (step {})"
msgstr "${{{name}}} (paso {})"

msgid "${{{name}}} gets its value only after this branch, so “Else” runs here."
msgstr "${{{name}}} solo recibe su valor después de esta bifurcación, así que aquí se ejecuta “Si no”."

msgid "(0 = repeat until stopped)"
msgstr "(0 = repetir hasta detener)"

msgid "(0 repeats until stopped)"
msgstr "(0 repite hasta detener)"

msgid "(No folder)"
msgstr "(Sin carpeta)"

msgid "(None)"
msgstr "(Ninguno)"

msgid "A folder with this name already exists."
msgstr "Ya existe una carpeta con este nombre."

msgid "A repetition right after ${{{name}}} applies only to the last character of its value, and when the value is empty it applies to the character before it or makes the regular expression invalid. To apply it to the whole value, wrap it as (?:${{{name}}})."
msgstr "Una repetición justo después de ${{{name}}} solo se aplica al último carácter de su valor y, cuando el valor está vacío, se aplica al carácter anterior o invalida la expresión regular. Para aplicarla a todo el valor, enciérrelo como (?:${{{name}}})."

