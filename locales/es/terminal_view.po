msgid " On a match, puts the line found into ${{{name}}}."
msgstr " Si coincide, guarda la línea encontrada en ${{{name}}}."

msgid " On a match, puts the matched part into ${{{name}}}."
msgstr " Si coincide, guarda la parte coincidente en ${{{name}}}."

msgid " Puts the line found into ${{{name}}}."
