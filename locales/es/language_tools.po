msgstr "Actualizar vista a '{active_tab_name}'"

msgid "Verbose"
msgstr "Detallado"

msgid "View Agent Changes"
msgstr "Ver los cambios del agente"

msgid "View Default Keymap"
msgstr "Ver mapa de teclas predeterminado"

msgid "View Logs"
msgstr "Ver registros"

msgid "View Message"
msgstr "Ver mensaje"

msgid "Waiting for more input: {}"
msgstr "Esperando más entrada: {}"

msgid "Waiting for the remote server to respond."
msgstr "Esperando la respuesta del servidor remoto."

msgid "Warning"
msgstr "Advertencia"

msgid "You can't resume until the agent's response ends. If it doesn't end, stop the agent."
msgstr "No se puede reanudar hasta que termine la respuesta del agente. Si no termina, detenga el agente."

msgid "You can't resume until the running sessions and commands end."
msgstr "No se puede reanudar hasta que terminen las sesiones y los comandos en ejecución."

msgid "clangd is using {used} of memory, over its limit of {limit}. It was restarted less than 10 minutes ago, so it is left running."
msgstr "clangd está usando {used} de memoria, por encima de su límite de {limit}. Se reinició hace menos de 10 minutos, así que se deja en ejecución."

msgid "clangd was using {used} of memory, over its limit of {limit}, and was restarted."
msgstr "clangd estaba usando {used} de memoria, por encima de su límite de {limit}, y se reinició."

