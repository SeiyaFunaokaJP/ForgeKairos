# The descriptions of the settings file's JSON schema, keyed by their English text.
#
# Entries that zed-i18n also translates started from its es-ES translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: es\n"
"X-Language-Name: Español\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "settings schema"
msgid "A block that surrounds the following character"
msgstr "Un bloque que rodea el siguiente carácter"

msgctxt "settings schema"
msgid "A box drawn around the following character"
msgstr "Un recuadro dibujado alrededor del siguiente carácter"

msgctxt "settings schema"
msgid "A capability for an extension."
msgstr "Una capacidad para una extensión."

msgctxt "settings schema"
msgid "A custom Git hosting provider."
msgstr "Un proveedor de alojamiento Git personalizado."

msgctxt "settings schema"
msgid "A custom line height, where 1.0 is the font's height. Must be at least 1.0."
msgstr "Un alto de línea personalizado, donde 1.0 es la altura de la fuente. Debe ser al menos 1.0."

msgctxt "settings schema"
msgid "A custom offset in milliseconds for the tooltip show delay."
msgstr "Un retardo personalizado en milisegundos antes de que aparezca la descripción emergente."

msgctxt "settings schema"
msgid "A denser UI with tighter spacing and smaller elements."
msgstr "Una interfaz más densa con espaciado más ajustado y elementos más pequeños."

msgctxt "settings schema"
msgid "A dynamic icon theme selection, which can change based on the [`ThemeMode`]."
msgstr "Una selección dinámica de tema de iconos, que puede cambiar según [`ThemeMode`]."

msgctxt "settings schema"
msgid "A dynamic theme selection, which can change based the [ThemeMode]."
msgstr "Una selección dinámica de tema, que puede cambiar según [ThemeMode]."

msgctxt "settings schema"
msgid "A fixed pixel width for the git diff indicators."
msgstr "Una anchura fija en píxeles para los indicadores de diferencias de Git."

msgctxt "settings schema"
msgid "A font size value in pixels, wrapping around `f32` for custom settings UI rendering."
msgstr "Un valor de tamaño de fuente en píxeles que encapsula `f32` para representar la interfaz de configuración personalizada."

msgctxt "settings schema"
msgid "A git account a repository can commit and push as."
msgstr "Una cuenta de Git con la que un repositorio puede hacer commit y push."

msgctxt "settings schema"
msgid "A less dense line height."
msgstr "Un alto de línea menos denso."

msgctxt "settings schema"
msgid "A looser UI with more spacing and larger elements."
msgstr "Una interfaz más holgada con más espaciado y elementos más grandes."

msgctxt "settings schema"
msgid "A map of log scopes to the desired log level.\nUseful for filtering out noisy logs or enabling more verbose logging.\n\nExample: {\"log\": {\"client\": \"warn\"}}"
msgstr "Un mapa de ámbitos de registro al nivel de registro deseado.\nÚtil para filtrar registros ruidosos o habilitar un registro más detallado.\n\nEjemplo: {\"log\": {\"client\": \"warn\"}}"

msgctxt "settings schema"
msgid "A model `name` to substitute when calling tools, in case the primary model doesn't support tool calling."
msgstr "Un `name` de modelo para sustituir al llamar a herramientas, en caso de que el modelo principal no admita llamadas a herramientas."

msgctxt "settings schema"
msgid "A named settings profile that can temporarily override settings."
msgstr "Un perfil de configuración con nombre que puede sobrescribir temporalmente la configuración."

msgctxt "settings schema"
msgid "A non-negative size in pixels.\n\nValid range: 0.0 and up"
msgstr "Un tamaño no negativo en píxeles.\n\nIntervalo válido: 0.0 en adelante"

msgctxt "settings schema"
msgid "A panel the default dock layout can name."
msgstr "Un panel que puede indicar el diseño predeterminado de los docks."

msgctxt "settings schema"
msgid "A static icon theme selection, represented by a single icon theme name."
msgstr "Una selección estática de tema de iconos, representada por un único nombre de tema de iconos."

msgctxt "settings schema"
msgid "A static theme selection, represented by a single theme name."
msgstr "Una selección estática de tema, representada por un único nombre de tema."

msgctxt "settings schema"
msgid "A value of `ui_language`, its own type so the settings UI can offer the\nlanguages found at run time instead of a text field."
msgstr "Un valor de `ui_language`, con su propio tipo para que la interfaz de configuración pueda ofrecer los idiomas encontrados en tiempo de ejecución en lugar de un campo de texto."

msgctxt "settings schema"
msgid "A vertical bar"
msgstr "Una barra vertical"

msgctxt "settings schema"
msgid "AI providers whose \"your input may be retained and used for training\"\nwarning the user has explicitly acknowledged. The settings UI refuses to\ntake an API key for, or sign in to, an external provider that is not\nlisted here.\n\nEntries are provider ids. Agent (LLM) providers use their own ids\n(`anthropic`, `openai`, `zed.dev`, ...);\nedit prediction providers are prefixed to keep the two surfaces\nindependent (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nDefault: []"
msgstr "Proveedores de IA cuya advertencia \"su entrada puede conservarse y usarse para entrenamiento\" el usuario ha aceptado explícitamente. La interfaz de configuración se niega a aceptar una clave de API o a iniciar sesión en un proveedor externo que no figure aquí.\n\nLas entradas son ID de proveedor. Los proveedores del agente (LLM) usan sus propios ID (`anthropic`, `openai`, `zed.dev`, ...); los proveedores de predicción de edición llevan un prefijo para mantener independientes ambos ámbitos (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Activates the python virtual environment, if one is found, in the\nterminal's working directory (as resolved by the working_directory\nsetting). Set this to \"off\" to disable this behavior.\n\nDefault: on"
msgstr "Activa el entorno virtual de Python, si se encuentra uno, en el directorio de trabajo del terminal (resuelto por la opción working_directory). Establézcalo en \"off\" para deshabilitar este comportamiento.\n\nValor predeterminado: on"

msgctxt "settings schema"
msgid "Active pane styling settings."
msgstr "Configuración de estilo del panel dividido activo."

msgctxt "settings schema"
msgid "Added version control color."
msgstr "Color para elementos agregados en el control de versiones."

msgctxt "settings schema"
msgid "Additional environment variables to pass to the agent.\n\nDefault: {}"
msgstr "Variables de entorno adicionales que se pasan al agente.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "Additional models with which to generate alternatives when performing inline assists."
msgstr "Modelos adicionales con los que generar alternativas al realizar asistencias en línea."

msgctxt "settings schema"
msgid "Additional parameters for language model requests. When making a request\nto a model, parameters will be taken from the last entry in this list\nthat matches the model's provider and name. In each entry, both provider\nand model are optional, so that you can specify parameters for either\none.\n\nDefault: []"
msgstr "Parámetros adicionales para las solicitudes a modelos de lenguaje. Al hacer una solicitud a un modelo, los parámetros se toman de la última entrada de esta lista que coincida con el proveedor y el nombre del modelo. En cada entrada, tanto el proveedor como el modelo son opcionales, de modo que se pueden especificar parámetros para cualquiera de los dos.\n\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Adjusts indentation based on syntax context when typing.\nUses tree-sitter to analyze code structure and indent accordingly."
msgstr "Ajusta la sangría según el contexto sintáctico al escribir.\nUsa tree-sitter para analizar la estructura del código y aplicar la sangría correspondiente."

msgctxt "settings schema"
msgid "Aliases for the command palette. When you type a key in this map,\nit will be assumed to equal the value.\n\nDefault: {}"
msgstr "Alias para la paleta de comandos. Al escribir una clave de este mapa, se considera equivalente al valor.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "Allow Zed to collect training data from open-source projects."
msgstr "Permite que Zed recopile datos de entrenamiento de proyectos de código abierto."

msgctxt "settings schema"
msgid "Allow rewrapping anywhere."
msgstr "Permite reajustar líneas en cualquier lugar."

msgctxt "settings schema"
msgid "Allow sending requests to Anthropic models that cannot be offered with\nZero Data Retention.\n\nDefault: false"
msgstr "Permite enviar solicitudes a modelos de Anthropic que no se pueden ofrecer con Zero Data Retention.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Allows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\nPrettier formatting is disabled by default."
msgstr "Permite habilitar o deshabilitar el formateo con Prettier y configurar el Prettier predeterminado, que se usa cuando no se encuentra una instalación de Prettier en el proyecto.\nEl formateo con Prettier está deshabilitado de forma predeterminada."

msgctxt "settings schema"
msgid "Always blink the cursor, ignoring the terminal mode."
msgstr "Hace que el cursor parpadee siempre, ignorando el modo del terminal."

msgctxt "settings schema"
msgid "Always fetch document's words for completions along with LSP completions."
msgstr "Obtiene siempre las palabras del documento para el autocompletado junto con los autocompletados de LSP."

msgctxt "settings schema"
msgid "Always index the worktree."
msgstr "Indexar siempre el worktree."

msgctxt "settings schema"
msgid "Always populate the search query with the word under the cursor."
msgstr "Rellena siempre la consulta de búsqueda con la palabra bajo el cursor."

msgctxt "settings schema"
msgid "Always prompt for confirmation (default behavior)."
msgstr "Solicitar siempre confirmación (comportamiento predeterminado)."

msgctxt "settings schema"
msgid "Always reduce motion"
msgstr "Reducir siempre el movimiento"

msgctxt "settings schema"
msgid "Always scan symlinked directories"
msgstr "Analizar siempre los directorios enlazados simbólicamente"

msgctxt "settings schema"
msgid "Always show the minimap thumb."
msgstr "Muestra siempre el control deslizante del minimapa."

msgctxt "settings schema"
msgid "Always show the minimap."
msgstr "Muestra siempre el minimapa."

msgctxt "settings schema"
msgid "Always show the scrollbar."
msgstr "Muestra siempre la barra de desplazamiento."

msgctxt "settings schema"
msgid "Always show the sidebar on the left side."
msgstr "Muestra siempre la barra lateral en el lado izquierdo."

msgctxt "settings schema"
msgid "Always show the sidebar on the right side."
msgstr "Muestra siempre la barra lateral en el lado derecho."

msgctxt "settings schema"
msgid "Always start with an empty editor tab"
msgstr "Empieza siempre con una pestaña de editor vacía"

msgctxt "settings schema"
msgid "Always use a specific directory. This value will be shell expanded.\nIf this path is not a valid directory the terminal will default to\nthis platform's home directory  (if it can be found)."
msgstr "Usar siempre un directorio concreto. Este valor se expande mediante el shell.\nSi esta ruta no es un directorio válido, el terminal usará el directorio personal de esta plataforma (si se encuentra)."

msgctxt "settings schema"
msgid "Always use this platform's home directory (if it can be found)."
msgstr "Usa siempre el directorio personal de esta plataforma (si se puede encontrar)."

msgctxt "settings schema"
msgid "Amount of indentation (in pixels) for nested items.\n\nDefault: 20"
msgstr "Cantidad de sangría (en píxeles) de los elementos anidados.\n\nValor predeterminado: 20"

msgctxt "settings schema"
msgid "An optional string to override the title of the terminal tab"
msgstr "Una cadena opcional para sustituir el título de la pestaña del terminal"

msgctxt "settings schema"
msgid "An underline that runs along the following character"
msgstr "Un subrayado que recorre el carácter siguiente"

msgctxt "settings schema"
msgid "Any extra beta headers to provide when using the model."
msgstr "Cabeceras beta adicionales que se proporcionan al usar el modelo."

msgctxt "settings schema"
msgid "Any key-value pairs added to this list will be added to the terminal's\nenvironment. Use `:` to separate multiple values.\n\nDefault: {}"
msgstr "Los pares clave-valor que se agreguen a esta lista se agregarán al entorno del terminal. Use `:` para separar varios valores.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"\""
msgstr "URL de la API que se usa para los autocompletados.\n\nValor predeterminado: \"\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"http://localhost:11434\""
msgstr "URL de la API que se usa para los autocompletados.\n\nValor predeterminado: \"http://localhost:11434\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"https://codestral.mistral.ai\""
msgstr "URL de la API que se usa para los autocompletados.\n\nValor predeterminado: \"https://codestral.mistral.ai\""

msgctxt "settings schema"
msgid "Apply profile settings on top of Zed's default settings, ignoring user customizations."
msgstr "Aplica la configuración del perfil sobre la configuración predeterminada de ForgeKairos, ignorando las personalizaciones del usuario."

msgctxt "settings schema"
msgid "Apply profile settings on top of the user's current settings."
msgstr "Aplica la configuración del perfil sobre la configuración actual del usuario."

msgctxt "settings schema"
msgid "Ask a separate, cheap language model whether the operation is dangerous,\nand auto-approve it only when that model answers that it is safe.\nEvery rule that outranks the default — the built-in security\nrules and the user's `always_deny`/`always_confirm`/`always_allow`\npatterns — is applied first, so this only replaces the \"ask every time\"\nstep."
msgstr "Pregunta a un modelo de lenguaje independiente y económico si la operación es peligrosa, y la aprueba automáticamente solo cuando ese modelo responde que es segura.\nTodas las reglas con prioridad sobre la predeterminada (las reglas de seguridad integradas y los patrones `always_deny`/`always_confirm`/`always_allow` del usuario) se aplican primero, por lo que esto solo sustituye el paso de \"preguntar cada vez\"."

msgctxt "settings schema"
msgid "Auto-approve without prompting."
msgstr "Aprobar automáticamente sin solicitar confirmación."

msgctxt "settings schema"
msgid "Auto-reject with an error."
msgstr "Rechazar automáticamente con un error."

msgctxt "settings schema"
msgid "Automatically detect the conda manager"
msgstr "Detectar automáticamente el administrador de conda"

msgctxt "settings schema"
msgid "Autosave when focus changes."
msgstr "Guarda automáticamente cuando cambia el foco."

msgctxt "settings schema"
msgid "Autosave when the active window changes."
msgstr "Guarda automáticamente cuando cambia la ventana activa."

msgctxt "settings schema"
msgid "Background Color. Used for grounded surfaces like a panel or tab."
msgstr "Color de fondo. Se usa para superficies de base, como un panel o una pestaña."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of a ghost element that should have the same background as the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Color de fondo. Se usa para el estado activo de un elemento fantasma que debe tener el mismo fondo que la superficie en la que está.\n\nLos estados activos se producen al presionar el botón del mouse sobre un elemento, o al presionar la tecla Return u otro activador."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of an element that should have a different background than the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Color de fondo. Se usa para el estado activo de un elemento que debe tener un fondo distinto del de la superficie en la que está.\n\nLos estados activos se producen al presionar el botón del mouse sobre un elemento, o al presionar la tecla Return u otro activador."

msgctxt "settings schema"
msgid "Background Color. Used for the app background and blank panels or windows."
msgstr "Color de fondo. Se usa para el fondo de la aplicación y los paneles o ventanas vacíos."

msgctxt "settings schema"
msgid "Background Color. Used for the area that shows where a dragged element will be dropped."
msgstr "Color de fondo. Se usa para el área que muestra dónde se soltará un elemento arrastrado."

msgctxt "settings schema"
msgid "Background Color. Used for the background of an element that should have a different background than the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have the same background as the surface it's on, use `ghost_element_background`."
msgstr "Color de fondo. Se usa para el fondo de un elemento que debe tener un fondo distinto del de la superficie en la que está.\n\nLos elementos pueden incluir: botones, campos de entrada, casillas de verificación, botones de opción...\n\nPara un elemento que debe tener el mismo fondo que la superficie en la que está, use `ghost_element_background`."

msgctxt "settings schema"
msgid "Background Color. Used for the background of selections in a UI element."
msgstr "Color de fondo. Se usa para el fondo de las selecciones en un elemento de la interfaz."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of a ghost element that should have the same background as the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Color de fondo. Se usa para el estado deshabilitado de un elemento fantasma que debe tener el mismo fondo que la superficie en la que está.\n\nLos estados deshabilitados se muestran cuando el usuario no puede interactuar con un elemento, como un botón o un campo de entrada deshabilitado."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of an element that should have a different background than the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Color de fondo. Se usa para el estado deshabilitado de un elemento que debe tener un fondo distinto del de la superficie en la que está.\n\nLos estados deshabilitados se muestran cuando el usuario no puede interactuar con un elemento, como un botón o un campo de entrada deshabilitado."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of a ghost element that should have the same background as the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Color de fondo. Se usa para el estado de cursor encima de un elemento fantasma que debe tener el mismo fondo que la superficie en la que está.\n\nEste estado se produce cuando el mouse entra en un elemento o cuando un dedo toca un elemento en una pantalla táctil."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of an element that should have a different background than the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Color de fondo. Se usa para el estado de cursor encima de un elemento que debe tener un fondo distinto del de la superficie en la que está.\n\nEste estado se produce cuando el mouse entra en un elemento o cuando un dedo toca un elemento en una pantalla táctil."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of a ghost element that should have the same background as the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Color de fondo. Se usa para el estado seleccionado de un elemento fantasma que debe tener el mismo fondo que la superficie en la que está.\n\nLos estados seleccionados se producen cuando el usuario selecciona (o \"activa\") el elemento.\n\nPor ejemplo, una casilla de verificación marcada, un botón alternable activado, etc."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of an element that should have a different background than the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Color de fondo. Se usa para el estado seleccionado de un elemento que debe tener un fondo distinto del de la superficie en la que está.\n\nLos estados seleccionados se producen cuando el usuario selecciona (o \"activa\") el elemento.\n\nPor ejemplo, una casilla de verificación marcada, un botón alternable activado, etc."

msgctxt "settings schema"
msgid "Background color for Vim Helix Normal mode indicator."
msgstr "Color de fondo para el indicador del modo Normal de Vim Helix."

msgctxt "settings schema"
msgid "Background color for Vim Helix Select mode indicator."
msgstr "Color de fondo para el indicador del modo Selección de Vim Helix."

msgctxt "settings schema"
msgid "Background color for Vim Insert mode indicator."
msgstr "Color de fondo para el indicador del modo Inserción de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Normal mode indicator."
msgstr "Color de fondo para el indicador del modo Normal de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Replace mode indicator."
msgstr "Color de fondo para el indicador del modo Reemplazo de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual Block mode indicator."
msgstr "Color de fondo para el indicador del modo Bloque visual de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual Line mode indicator."
msgstr "Color de fondo para el indicador del modo Línea visual de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual mode indicator."
msgstr "Color de fondo para el indicador del modo Visual de Vim."

msgctxt "settings schema"
msgid "Background color for Vim yank highlight."
msgstr "Color de fondo para el resaltado de yank de Vim."

msgctxt "settings schema"
msgid "Background color for row highlights of \"ours\" regions in merge conflicts."
msgstr "Color de fondo para el resaltado de filas de las regiones \"ours\" en conflictos de fusión."

msgctxt "settings schema"
msgid "Background color for row highlights of \"theirs\" regions in merge conflicts."
msgstr "Color de fondo para el resaltado de filas de las regiones \"theirs\" en conflictos de fusión."

msgctxt "settings schema"
msgid "Background color. Used for elevated surfaces, like a context menu, popup, or dialog."
msgstr "Color de fondo. Se usa para superficies elevadas, como un menú contextual, una ventana emergente o un cuadro de diálogo."

msgctxt "settings schema"
msgid "Background of active line of debugger"
msgstr "Fondo de la línea activa del depurador"

msgctxt "settings schema"
msgid "Base key bindings scheme. Base keymaps can be overridden with user keymaps.\n\nDefault: Zed"
msgstr "Esquema base de atajos de teclado. Los mapas de teclas base se pueden reemplazar con los mapas de teclas del usuario.\n\nValor predeterminado: Zed"

msgctxt "settings schema"
msgid "Be smart and search for ignored when called from a gitignored worktree"
msgstr "Actuar de forma inteligente y buscar ignorados cuando se llame desde un worktree ignorado por Git"

msgctxt "settings schema"
msgid "Behave as a regular buffer and select the whole word."
msgstr "Se comporta como un búfer normal y selecciona la palabra completa."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text after the cursor is a suffix of the completion, and like\n`\"insert\"` otherwise."
msgstr "Se comporta como `\"replace\"` si el texto que sigue al cursor es un sufijo del autocompletado y, en caso contrario, como `\"insert\"`."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text that would be replaced is a subsequence of the completion text,\nand like `\"insert\"` otherwise."
msgstr "Se comporta como `\"replace\"` si el texto que se reemplazaría es una subsecuencia del texto del autocompletado y, en caso contrario, como `\"insert\"`."

msgctxt "settings schema"
msgid "Black ANSI terminal color."
msgstr "Color negro ANSI del terminal."

msgctxt "settings schema"
msgid "Block cursor that surrounds the character."
msgstr "Cursor de bloque que rodea el carácter."

msgctxt "settings schema"
msgid "Blue ANSI terminal color."
msgstr "Color azul ANSI del terminal."

msgctxt "settings schema"
msgid "Border Color. Used for the border that shows where a dragged element will be dropped."
msgstr "Color del borde. Se usa para el borde que muestra dónde se soltará un elemento arrastrado."

msgctxt "settings schema"
msgid "Border color. Used for deemphasized borders, like a visual divider between two sections"
msgstr "Color del borde. Se usa para bordes con menor énfasis, como un divisor visual entre dos secciones."

msgctxt "settings schema"
msgid "Border color. Used for disabled elements, like a disabled input or button."
msgstr "Color del borde. Se usa para elementos deshabilitados, como una entrada o un botón deshabilitados."

msgctxt "settings schema"
msgid "Border color. Used for focused elements, like keyboard focused list item."
msgstr "Color del borde. Se usa para elementos enfocados, como un elemento de lista enfocado con el teclado."

msgctxt "settings schema"
msgid "Border color. Used for most borders, is usually a high contrast color."
msgstr "Color del borde. Se usa para la mayoría de los bordes; suele ser un color de alto contraste."

msgctxt "settings schema"
msgid "Border color. Used for selected elements, like an active search filter or selected checkbox."
msgstr "Color del borde. Se usa para elementos seleccionados, como un filtro de búsqueda activo o una casilla seleccionada."

msgctxt "settings schema"
msgid "Border color. Used for transparent borders. Used for placeholder borders when an element gains a border on state change."
msgstr "Color del borde. Se usa para bordes transparentes. Se usa para bordes de marcador de posición cuando un elemento obtiene un borde al cambiar de estado."

msgctxt "settings schema"
msgid "Bright black ANSI terminal color."
msgstr "Color negro brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Bright blue ANSI terminal color."
msgstr "Color azul brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Bright cyan ANSI terminal color."
msgstr "Color cian brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Bright green ANSI terminal color."
msgstr "Color verde brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Bright magenta ANSI terminal color."
msgstr "Color magenta brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Bright red ANSI terminal color."
msgstr "Color rojo brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Bright terminal foreground color."
msgstr "Color de primer plano brillante del terminal."

msgctxt "settings schema"
msgid "Bright white ANSI terminal color."
msgstr "Color blanco brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Bright yellow ANSI terminal color."
msgstr "Color amarillo brillante ANSI del terminal."

msgctxt "settings schema"
msgid "Byte budget for a repository map prepended to the agent's system prompt,\nright after the list of project root directories. `0` disables it.\nValues above 32768 are clamped to 32768.\n\nDefault: 0"
msgstr "Presupuesto en bytes para un mapa del repositorio que se antepone al prompt del sistema del agente, justo después de la lista de directorios raíz del proyecto. `0` lo deshabilita.\nLos valores superiores a 32768 se limitan a 32768.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "Callees left out of the list of a function's callees, such as logging\nand assertion macros. A row at the end counts them and shows them on\nrequest.\n\nDefault: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"
msgstr "Llamados que se omiten de la lista de llamados de una función, como las macros de registro y de aserción. Una fila al final indica cuántos son y los muestra si se solicita.\n\nValor predeterminado: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"

msgctxt "settings schema"
msgid "Case-insensitive natural sort with lowercase preferred in ties.\nNumbers in file names are compared by value (e.g., `file2` before `file10`)."
msgstr "Ordenación natural sin distinguir mayúsculas y minúsculas, con preferencia por las minúsculas en caso de empate.\nLos números de los nombres de archivo se comparan por su valor (p. ej., `file2` antes que `file10`)."

msgctxt "settings schema"
msgid "Centered layout related setting (left/right)."
msgstr "Ajuste relacionado con el diseño centrado (izquierda/derecha)."

msgctxt "settings schema"
msgid "Centered layout related settings."
msgstr "Configuración relacionada con el diseño centrado."

msgctxt "settings schema"
msgid "Character counts at which to show wrap guides in the editor.\n\nDefault: []"
msgstr "Número de caracteres en los que se muestran guías de ajuste en el editor.\n\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Close the window when there are no tabs"
msgstr "Cerrar la ventana cuando no haya pestañas"

msgctxt "settings schema"
msgid "Color for added words in word diffs."
msgstr "Color de las palabras agregadas en las diferencias de palabras."

msgctxt "settings schema"
msgid "Color for deleted words in word diffs."
msgstr "Color de las palabras eliminadas en las diferencias de palabras."

msgctxt "settings schema"
msgid "Color used to accent some of the debuggers elements\nOnly accent breakpoint & breakpoint related symbols right now"
msgstr "Color usado para resaltar algunos elementos del depurador.\nPor ahora solo resalta los puntos de interrupción y los símbolos relacionados con ellos."

msgctxt "settings schema"
msgid "Comfortable spacing of entries."
msgstr "Espaciado cómodo de las entradas."

msgctxt "settings schema"
msgid "Command to automatically run when Zed creates a Terminal Thread shell in the agent panel.\nThe command is sent to the shell as if typed, so it is interpreted by your\nconfigured shell (including on Windows and remote/WSL projects).\nAn empty string disables this behavior.\n\nDefault: \"\""
msgstr "Comando que se ejecuta automáticamente cuando ForgeKairos crea un shell de conversación de terminal en el panel del agente.\nEl comando se envía al shell como si se escribiera, por lo que lo interpreta el shell configurado (también en Windows y en proyectos remotos o de WSL).\nUna cadena vacía deshabilita este comportamiento.\n\nValor predeterminado: \"\""

msgctxt "settings schema"
msgid "Common language server settings."
msgstr "Configuración común de servidores de lenguaje."

msgctxt "settings schema"
msgid "Configuration for Debugger-related features"
msgstr "Configuración de las funciones relacionadas con el depurador"

msgctxt "settings schema"
msgid "Configuration for Diagnostics-related features."
msgstr "Configuración de las funciones relacionadas con los diagnósticos."

msgctxt "settings schema"
msgid "Configuration for Git-related features"
msgstr "Configuración de las funciones relacionadas con Git"

msgctxt "settings schema"
msgid "Configuration for Node-related features"
msgstr "Configuración de las funciones relacionadas con Node"

msgctxt "settings schema"
msgid "Configuration for caching language model messages."
msgstr "Configuración del almacenamiento en caché de mensajes de modelos de lenguaje."

msgctxt "settings schema"
msgid "Configuration for developer-oriented instrumentation tools that collect\ndiagnostic data about a running Zed instance."
msgstr "Configuración de las herramientas de instrumentación para desarrolladores que recopilan datos de diagnóstico sobre una instancia de ForgeKairos en ejecución."

msgctxt "settings schema"
msgid "Configuration for how direnv configuration should be loaded"
msgstr "Configuración de cómo debe cargarse la configuración de direnv"

msgctxt "settings schema"
msgid "Configuration for language servers.\n\nThe following settings can be overridden for specific language servers:\n- initialization_options\n\nTo override settings for a language, add an entry for that language server's\nname to the lsp value.\nDefault: null"
msgstr "Configuración de los servidores de lenguaje.\n\nLas siguientes opciones se pueden reemplazar para servidores de lenguaje concretos:\n- initialization_options\n\nPara reemplazar la configuración de un lenguaje, agregue al valor lsp una entrada con el nombre de ese servidor de lenguaje.\nValor predeterminado: null"

msgctxt "settings schema"
msgid "Configuration for session-related features"
msgstr "Configuración de las funciones relacionadas con la sesión"

msgctxt "settings schema"
msgid "Configuration for the collab panel visual settings."
msgstr "Configuración visual del panel de colaboración."

msgctxt "settings schema"
msgid "Configuration for the performance profiler which collects timing data\nfor foreground and background executor tasks."
msgstr "Configuración del generador de perfiles de rendimiento, que recopila datos de tiempo de las tareas de los ejecutores en primer y segundo plano."

msgctxt "settings schema"
msgid "Configuration for the performance profiler, accessed via the\n`zed: open performance profiler` action."
msgstr "Configuración del generador de perfiles de rendimiento, al que se accede con la acción `zed: open performance profiler`."

msgctxt "settings schema"
msgid "Configuration of Anthropic's caching API."
msgstr "Configuración de la API de caché de Anthropic."

msgctxt "settings schema"
msgid "Configuration of audio in Zed."
msgstr "Configuración del audio en ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of the terminal in Zed."
msgstr "Configuración del terminal en ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of voice calls in Zed."
msgstr "Configuración de las llamadas de voz en ForgeKairos."

msgctxt "settings schema"
msgid "Configures what draws Zed's window decorations on Linux.\nThis setting has no effect on other platforms."
msgstr "Configura qué dibuja las decoraciones de ventana de ForgeKairos en Linux.\nEsta opción no tiene efecto en otras plataformas."

msgctxt "settings schema"
msgid "Conflict version control color."
msgstr "Color de conflicto del control de versiones."

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `Authorization` header is sent and the\nprovider counts as configured without a keychain entry.\n\nDefault: false"
msgstr "Conectar sin ninguna credencial, para servidores que no requieren autenticación. Si se establece, no se envía ningún encabezado `Authorization` y el proveedor se considera configurado sin una entrada en el llavero.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `x-api-key` header is sent and the provider\ncounts as configured without a keychain entry.\n\nDefault: false"
msgstr "Conectar sin ninguna credencial, para servidores que no requieren autenticación. Si se establece, no se envía ningún encabezado `x-api-key` y el proveedor se considera configurado sin una entrada en el llavero.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Contained between the left and right docks"
msgstr "Contenido entre los docks izquierdo y derecho"

msgctxt "settings schema"
msgid "Continuation lines get 1 extra indent level beyond the original."
msgstr "Las líneas de continuación tienen 1 nivel de sangría más que la línea original."

msgctxt "settings schema"
msgid "Continuation lines get 2 extra indent levels beyond the original."
msgstr "Las líneas de continuación tienen 2 niveles de sangría más que la línea original."

msgctxt "settings schema"
msgid "Continuation lines match the original line's indentation."
msgstr "Las líneas de continuación tienen la misma sangría que la línea original."

msgctxt "settings schema"
msgid "Continuation lines start at column 0."
msgstr "Las líneas de continuación empiezan en la columna 0."

msgctxt "settings schema"
msgid "Control what info is collected by Zed."
msgstr "Controla qué información recopila Zed."

msgctxt "settings schema"
msgid "Controls automatic indentation behavior when typing.\n\n- \"syntax_aware\": Adjusts indentation based on syntax context (default)\n- \"preserve_indent\": Preserves current line's indentation on new lines\n- \"none\": No automatic indentation\n\nDefault: syntax_aware"
msgstr "Controla el comportamiento de la sangría automática al escribir.\n\n- \"syntax_aware\": ajusta la sangría según el contexto sintáctico (predeterminado)\n- \"preserve_indent\": conserva la sangría de la línea actual en las líneas nuevas\n- \"none\": sin sangría automática\n\nValor predeterminado: syntax_aware"

msgctxt "settings schema"
msgid "Controls how LSP completions are inserted.\n\nDefault: \"replace_suffix\""
msgstr "Controla cómo se insertan los autocompletados de LSP.\n\nValor predeterminado: \"replace_suffix\""

msgctxt "settings schema"
msgid "Controls how completions are processed for this language."
msgstr "Controla cómo se procesan los autocompletados para este lenguaje."

msgctxt "settings schema"
msgid "Controls how document's words are completed."
msgstr "Controla cómo se autocompletan las palabras del documento."

msgctxt "settings schema"
msgid "Controls how line endings are normalized when a buffer is saved."
msgstr "Controla cómo se normalizan los finales de línea al guardar un búfer."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting."
msgstr "Controla cómo se usan los tokens semánticos de los servidores de lenguaje para el resaltado de sintaxis."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting.\n\nOptions:\n- \"off\": Do not request semantic tokens from language servers.\n- \"combined\": Use LSP semantic tokens together with tree-sitter highlighting.\n- \"full\": Use LSP semantic tokens exclusively, replacing tree-sitter highlighting.\n\nDefault: \"off\""
msgstr "Controla cómo se usan los tokens semánticos de los servidores de lenguaje para el resaltado de sintaxis.\n\nOpciones:\n- \"off\": no solicita tokens semánticos a los servidores de lenguaje.\n- \"combined\": usa los tokens semánticos de LSP junto con el resaltado de tree-sitter.\n- \"full\": usa exclusivamente los tokens semánticos de LSP, en lugar del resaltado de tree-sitter.\n\nValor predeterminado: \"off\""

msgctxt "settings schema"
msgid "Controls how the editor handles the autoclosed characters.\nWhen set to `false`(default), skipping over and auto-removing of the closing characters\nhappen only for auto-inserted characters.\nOtherwise(when `true`), the closing characters are always skipped over and auto-removed\nno matter how they were inserted.\n\nDefault: false"
msgstr "Controla cómo trata el editor los caracteres de cierre automático.\nSi se establece en `false` (predeterminado), los caracteres de cierre solo se omiten al escribir y se quitan automáticamente cuando se insertaron automáticamente.\nEn caso contrario (con `true`), los caracteres de cierre siempre se omiten y se quitan automáticamente, sin importar cómo se insertaron.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Controls how whitespace should be displayedin the editor."
msgstr "Controla cómo se muestra el espacio en blanco en el editor."

msgctxt "settings schema"
msgid "Controls how words are completed.\nFor large documents, not all words may be fetched for completion.\n\nDefault: `fallback`"
msgstr "Controla cómo se autocompletan las palabras.\nEn documentos grandes, es posible que no se obtengan todas las palabras para el autocompletado.\n\nValor predeterminado: `fallback`"

msgctxt "settings schema"
msgid "Controls previous session restoration in freshly launched Zed instance.\nValues: empty_tab, last_workspace, last_session, launchpad\nDefault: last_session"
msgstr "Controla la restauración de la sesión anterior en una instancia de ForgeKairos recién iniciada.\nValores: empty_tab, last_workspace, last_session, launchpad\nValor predeterminado: last_session"

msgctxt "settings schema"
msgid "Controls the soft-wrapping behavior in the editor."
msgstr "Controla el comportamiento del ajuste de línea automático en el editor."

msgctxt "settings schema"
msgid "Controls the source of document symbols used for outlines and breadcrumbs.\n\nOptions:\n- \"off\": Use tree-sitter queries to compute document symbols (default).\n- \"on\": Use the language server's `textDocument/documentSymbol` LSP response. When enabled, tree-sitter is not used for document symbols.\n\nDefault: \"off\""
msgstr "Controla el origen de los símbolos del documento que se usan para el esquema y las rutas de navegación.\n\nOpciones:\n- \"off\": usa consultas de tree-sitter para calcular los símbolos del documento (predeterminado).\n- \"on\": usa la respuesta LSP `textDocument/documentSymbol` del servidor de lenguaje. Si está habilitado, tree-sitter no se usa para los símbolos del documento.\n\nValor predeterminado: \"off\""

msgctxt "settings schema"
msgid "Controls the width of the git diff hunk indicators in the gutter."
msgstr "Controla la anchura de los indicadores de fragmentos de diferencias de Git en el margen."

msgctxt "settings schema"
msgid "Controls when to use system clipboard."
msgstr "Controla cuándo se usa el portapapeles del sistema."

msgctxt "settings schema"
msgid "Controls where the `editor::Rewrap` action is allowed for this language.\n\nNote: This setting has no effect in Vim mode, as rewrap is already\nallowed everywhere.\n\nDefault: \"in_comments\""
msgstr "Controla dónde se permite la acción `editor::Rewrap` para este lenguaje.\n\nNota: esta opción no tiene efecto en el modo Vim, ya que allí el reajuste de líneas ya está permitido en todas partes.\n\nValor predeterminado: \"in_comments\""

msgctxt "settings schema"
msgid "Controls whether Zed collects training data when using Zed's Edit Predictions."
msgstr "Controla si Zed recopila datos de entrenamiento al usar las predicciones de edición de Zed."

msgctxt "settings schema"
msgid "Controls whether Zed may collect training data when using Zed's Edit Predictions.\nData is only ever captured for files in projects that are detected as open source.\n\n- `\"default\"`: use the preference previously set via the status-bar toggle,\n  or false if no preference has been stored.\n- `\"yes\"`: allow data collection for files in open-source projects.\n- `\"no\"`: never allow data collection."
msgstr "Controla si Zed puede recopilar datos de entrenamiento al usar las predicciones de edición de Zed.\nSolo se recopilan datos de archivos de proyectos detectados como de código abierto.\n\n- `\"default\"`: usa la preferencia establecida anteriormente con el conmutador de la barra de estado, o false si no se ha guardado ninguna preferencia.\n- `\"yes\"`: permite la recopilación de datos de archivos de proyectos de código abierto.\n- `\"no\"`: nunca permite la recopilación de datos."

msgctxt "settings schema"
msgid "Controls whether Zed or the window manager or compositor draws window decorations on Linux.\n\nDefault: client"
msgstr "Controla si las decoraciones de ventana en Linux las dibuja ForgeKairos, el administrador de ventanas o el compositor.\n\nValor predeterminado: client"

msgctxt "settings schema"
msgid "Controls whether edit predictions are shown immediately (true)\nor manually by triggering `editor::ShowEditPrediction` (false).\n\nDefault: true"
msgstr "Controla si las predicciones de edición se muestran de inmediato (true) o manualmente al ejecutar `editor::ShowEditPrediction` (false).\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Controls whether folding ranges from language servers are used instead of\ntree-sitter and indent-based folding.\n\nOptions:\n- \"off\": Use tree-sitter and indent-based folding (default).\n- \"on\": Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server.\n\nDefault: \"off\""
msgstr "Controla si se usan los intervalos de plegado de los servidores de lenguaje en lugar del plegado de tree-sitter y el basado en la sangría.\n\nOpciones:\n- \"off\": usa el plegado de tree-sitter y el basado en la sangría (predeterminado).\n- \"on\": usa el plegado de LSP siempre que sea posible y recurre al plegado de tree-sitter y al basado en la sangría cuando el servidor no devuelve resultados.\n\nValor predeterminado: \"off\""

msgctxt "settings schema"
msgid "Controls which formatter should be used when formatting code. If there are multiple formatters, they are executed in the order of declaration."
msgstr "Controla qué formateador debe usarse al formatear código. Si hay varios formateadores, se ejecutan en el orden de declaración."

msgctxt "settings schema"
msgid "Controls which formatters should be used when formatting code."
msgstr "Controla qué formateadores deben usarse al formatear código."

msgctxt "settings schema"
msgid "Cursor is a block like `█`."
msgstr "El cursor es un bloque como `█`."

msgctxt "settings schema"
msgid "Cursor is a hollow box like `▯`."
msgstr "El cursor es un cuadro hueco como `▯`."

msgctxt "settings schema"
msgid "Cursor is a vertical bar like `⎸`."
msgstr "El cursor es una barra vertical como `⎸`."

msgctxt "settings schema"
msgid "Cursor is an underscore like `_`."
msgstr "El cursor es un guion bajo como `_`."

msgctxt "settings schema"
msgid "Cursor movement animation settings."
msgstr "Configuración de la animación de movimiento del cursor."

msgctxt "settings schema"
msgid "Cursor shape configuration for insert mode in Vim."
msgstr "Configuración de la forma del cursor para el modo de inserción en Vim."

msgctxt "settings schema"
msgid "Cursor shape for the default editor.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: bar"
msgstr "Forma del cursor del editor predeterminado.\nPuede ser \"bar\", \"block\", \"underline\" o \"hollow\".\n\nValor predeterminado: bar"

msgctxt "settings schema"
msgid "Cursor shape for the insert mode.\n\nThe default value follows the primary cursor_shape."
msgstr "Forma del cursor en el modo de inserción.\n\nEl valor predeterminado sigue al cursor_shape principal."

msgctxt "settings schema"
msgid "Cursor shape for the normal mode.\n\nDefault: block"
msgstr "Forma del cursor en el modo normal.\n\nValor predeterminado: block"

msgctxt "settings schema"
msgid "Cursor shape for the replace mode.\n\nDefault: underline"
msgstr "Forma del cursor en el modo de reemplazo.\n\nValor predeterminado: underline"

msgctxt "settings schema"
msgid "Cursor shape for the visual mode.\n\nDefault: block"
msgstr "Forma del cursor en el modo visual.\n\nValor predeterminado: block"

msgctxt "settings schema"
msgid "Custom Model API URL to use for this model."
msgstr "URL de API de modelo personalizado que se debe usar para este modelo."

msgctxt "settings schema"
msgid "Custom instructions to include in the prompt when generating git commit messages.\nApplied in addition to any project rules files (such as `.rules` or `AGENTS.md`)."
msgstr "Instrucciones personalizadas que se incluyen en el prompt al generar mensajes de commit de git.\nSe aplican además de los archivos de reglas del proyecto (como `.rules` o `AGENTS.md`)."

msgctxt "settings schema"
msgid "Custom models served through the `bedrock-mantle` endpoint's\nOpenAI-compatible APIs, in addition to the built-in Mantle models\n(GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."
msgstr "Modelos personalizados servidos a través de las API compatibles con OpenAI del endpoint `bedrock-mantle`, además de los modelos Mantle integrados (GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."

msgctxt "settings schema"
msgid "Custom rules for rendering LSP semantic tokens."
msgstr "Reglas personalizadas para representar tokens semánticos de LSP."

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by outline panel\n\nDefault: 240"
msgstr "Personaliza el ancho predeterminado (en píxeles) que ocupa el panel de esquema\n\nValor predeterminado: 240"

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by project panel\n\nDefault: 240"
msgstr "Personaliza el ancho predeterminado (en píxeles) que ocupa el panel de proyecto\n\nValor predeterminado: 240"

msgctxt "settings schema"
msgid "Cyan ANSI terminal color."
msgstr "Color cian ANSI del terminal."

msgctxt "settings schema"
msgid "Default action when clicking a changed file in the Git panel.\n\nDefault: project_diff"
msgstr "Acción predeterminada al hacer clic en un archivo modificado en el panel de Git.\n\nValor predeterminado: project_diff"

msgctxt "settings schema"
msgid "Default cursor shape for the terminal.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: \"block\""
msgstr "Forma predeterminada del cursor del terminal.\nPuede ser \"bar\", \"block\", \"underline\" o \"hollow\".\n\nValor predeterminado: \"block\""

msgctxt "settings schema"
msgid "Default depth to expand outline items in the current file.\nThe default depth to which outline entries are expanded on reveal.\n- Set to 0 to collapse all items that have children\n- Set to 1 or higher to collapse items at that depth or deeper\n\nDefault: 100"
msgstr "Profundidad predeterminada a la que se expanden los elementos del esquema del archivo actual.\nLa profundidad predeterminada a la que se expanden las entradas del esquema al mostrarlas.\n- Establézcala en 0 para contraer todos los elementos que tienen hijos\n- Establézcala en 1 o más para contraer los elementos de esa profundidad o más profundos\n\nValor predeterminado: 100"

msgctxt "settings schema"
msgid "Default directories to search for virtual environments, relative\nto the current working directory. We recommend overriding this\nin your project's settings, rather than globally."
msgstr "Directorios predeterminados en los que se buscan entornos virtuales, relativos al directorio de trabajo actual. Se recomienda reemplazar esto en la configuración del proyecto, en lugar de hacerlo globalmente."

msgctxt "settings schema"
msgid "Default fixed width in pixels when the agent panel is docked to the left or right and\n`flexible` is false.\n\nDefault: 640"
msgstr "Ancho fijo predeterminado en píxeles cuando el panel del agente está acoplado a la izquierda o a la derecha y `flexible` es false.\n\nValor predeterminado: 640"

msgctxt "settings schema"
msgid "Default height in pixels when the AI browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Alto predeterminado en píxeles cuando el panel del navegador de IA está acoplado abajo.\n\nValor predeterminado: 320"

msgctxt "settings schema"
msgid "Default height in pixels when the agent panel is docked to the bottom.\n\nDefault: 320"
msgstr "Alto predeterminado en píxeles cuando el panel del agente está acoplado abajo.\n\nValor predeterminado: 320"

msgctxt "settings schema"
msgid "Default height in pixels when the browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Alto predeterminado en píxeles cuando el panel del navegador está acoplado abajo.\n\nValor predeterminado: 320"

msgctxt "settings schema"
msgid "Default height when the terminal is docked to the bottom.\n\nDefault: 320"
msgstr "Alto predeterminado cuando el terminal está acoplado abajo.\n\nValor predeterminado: 320"

msgctxt "settings schema"
msgid "Default is 1500ms."
msgstr "El valor predeterminado es 1500 ms."

msgctxt "settings schema"
msgid "Default kernels to select for each language.\n\nDefault: `{}`"
msgstr "Kernels predeterminados que se seleccionan para cada lenguaje.\n\nValor predeterminado: `{}`"

msgctxt "settings schema"
msgid "Default mode when no regex rules match.\nWhen unset, inherits from the global `tool_permissions.default`."
msgstr "Modo predeterminado cuando no coincide ninguna regla de expresión regular.\nSi no se establece, se hereda del `tool_permissions.default` global."

msgctxt "settings schema"
msgid "Default options for buffer and project search items."
msgstr "Opciones predeterminadas para los elementos de búsqueda en el búfer y el proyecto."

msgctxt "settings schema"
msgid "Default the cursor blink to off, but allow the terminal to\nset blinking."
msgstr "El parpadeo del cursor está desactivado de forma predeterminada, pero se permite que el terminal lo active."

msgctxt "settings schema"
msgid "Default timeout in seconds for context server tool calls.\nCan be overridden per-server in context_servers configuration.\n\nDefault: 60"
msgstr "Tiempo de espera predeterminado, en segundos, de las llamadas a herramientas de los servidores de contexto.\nSe puede reemplazar por servidor en la configuración context_servers.\n\nValor predeterminado: 60"

msgctxt "settings schema"
msgid "Default values for session config options.\n\nThis is a map from config option ID to the default value for that option.\n\nDefault: {}"
msgstr "Valores predeterminados de las opciones de configuración de la sesión.\n\nEs un mapa del ID de cada opción de configuración a su valor predeterminado.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "Default width in pixels when the AI browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Ancho predeterminado en píxeles cuando el panel del navegador de IA está acoplado a la izquierda o a la derecha.\n\nValor predeterminado: 480"

msgctxt "settings schema"
msgid "Default width in pixels when the browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Ancho predeterminado en píxeles cuando el panel del navegador está acoplado a la izquierda o a la derecha.\n\nValor predeterminado: 480"

msgctxt "settings schema"
msgid "Default width of the call graph panel in pixels.\n\nDefault: 320"
msgstr "Ancho predeterminado del panel de grafo de llamadas en píxeles.\n\nValor predeterminado: 320"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 240"
msgstr "Ancho predeterminado del panel en píxeles.\n\nValor predeterminado: 240"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 360"
msgstr "Ancho predeterminado del panel en píxeles.\n\nValor predeterminado: 360"

msgctxt "settings schema"
msgid "Default width of the threads sidebar in pixels.\n\nValues range from 200 to 800, matching the widths the sidebar can be\ndragged to. Values outside that range are clamped into it.\n\nDefault: 300"
msgstr "Ancho predeterminado de la barra lateral de conversaciones en píxeles.\n\nLos valores van de 200 a 800, que son los anchos a los que se puede arrastrar la barra lateral. Los valores fuera de ese intervalo se ajustan a él.\n\nValor predeterminado: 300"

msgctxt "settings schema"
msgid "Default width when the terminal is docked to the left or right.\n\nDefault: 640"
msgstr "Ancho predeterminado cuando el terminal está acoplado a la izquierda o a la derecha.\n\nValor predeterminado: 640"

msgctxt "settings schema"
msgid "Default: 0.2"
msgstr "Valor predeterminado: 0.2"

msgctxt "settings schema"
msgid "Default: {}"
msgstr "Valor predeterminado: {}"

msgctxt "settings schema"
msgid "Defaults to use when opening a new buffer and project search items.\n\nDefault: nothing is enabled"
msgstr "Valores predeterminados que se usan al abrir nuevas búsquedas en el búfer y en el proyecto.\n\nValor predeterminado: no hay nada habilitado"

msgctxt "settings schema"
msgid "Defines the border style for the minimap's scrollbar thumb.\n\nDefault: left_open"
msgstr "Define el estilo del borde del control deslizante de la barra de desplazamiento del minimapa.\n\nValor predeterminado: left_open"

msgctxt "settings schema"
msgid "Delay in milliseconds before showing the which-key popup.\n\nDefault: 1000"
msgstr "Retraso en milisegundos antes de mostrar la ventana emergente de which-key.\n\nValor predeterminado: 1000"

msgctxt "settings schema"
msgid "Deleted version control color."
msgstr "Color para elementos eliminados en el control de versiones."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_ours`."
msgstr "Obsoleto en favor de `version_control_conflict_marker_ours`."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_theirs`."
msgstr "Obsoleto en favor de `version_control_conflict_marker_theirs`."

msgctxt "settings schema"
msgid "Deprecated: use None instead. Left to avoid breaking existing users' configs.\nPrefer a single line generally, unless an overly long line is encountered."
msgstr "Obsoleto: use None en su lugar. Se mantiene para no romper la configuración de los usuarios existentes.\nPreferir en general una sola línea, salvo que se encuentre una línea demasiado larga."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored."
msgstr "Determina cómo se colorean los fondos de las guías de sangría."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored.\n\nDefault: Disabled"
msgstr "Determina cómo se colorean los fondos de las guías de sangría.\n\nValor predeterminado: Disabled"

msgctxt "settings schema"
msgid "Determines how indent guides are colored."
msgstr "Determina cómo se colorean las guías de sangría."

msgctxt "settings schema"
msgid "Determines how indent guides are colored.\n\nDefault: Fixed"
msgstr "Determina cómo se colorean las guías de sangría.\n\nValor predeterminado: Fixed"

msgctxt "settings schema"
msgid "Determines how much space the call hierarchy picker can take up in relation to the available window width.\n\nDefault: medium"
msgstr "Determina cuánto espacio puede ocupar el selector de jerarquía de llamadas en relación con el ancho disponible de la ventana.\n\nValor predeterminado: medium"

msgctxt "settings schema"
msgid "Determines how much space the file finder can take up in relation to the available window width.\n\nDefault: small"
msgstr "Determina cuánto espacio puede ocupar el buscador de archivos en relación con el ancho disponible de la ventana.\n\nValor predeterminado: small"

msgctxt "settings schema"
msgid "Determines how snippets are sorted relative to other completion items.\n\nDefault: inline"
msgstr "Determina cómo se ordenan los fragmentos de código respecto a los demás elementos de autocompletado.\n\nValor predeterminado: inline"

msgctxt "settings schema"
msgid "Determines the modifier to be used to add multiple cursors with the mouse. The open hover link mouse gestures will adapt such that it do not conflict with the multicursor modifier.\n\nDefault: alt"
msgstr "Determina el modificador que se usa para agregar varios cursores con el mouse. Los gestos del mouse para abrir vínculos al pasar el cursor se adaptan para no entrar en conflicto con el modificador de varios cursores.\n\nValor predeterminado: alt"

msgctxt "settings schema"
msgid "Determines the stepping granularity.\n\nDefault: line"
msgstr "Determina la granularidad de los pasos.\n\nValor predeterminado: line"

msgctxt "settings schema"
msgid "Determines what settings a profile starts from before applying its overrides."
msgstr "Determina de qué configuración parte un perfil antes de aplicar sus sobrescrituras."

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to\nkeyboard input. Applies globally across all input surfaces (editors,\nterminals, palettes, etc.).\n\nDefault: on_typing_and_action"
msgstr "Determina cuándo debe ocultarse el cursor del mouse en respuesta a la entrada del teclado. Se aplica globalmente a todas las superficies de entrada (editores, terminales, paletas, etc.).\n\nValor predeterminado: on_typing_and_action"

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to keyboard\ninput.\n\nDefault: on_typing_and_action"
msgstr "Determina cuándo debe ocultarse el cursor del mouse en respuesta a la entrada del teclado.\n\nValor predeterminado: on_typing_and_action"

msgctxt "settings schema"
msgid "Determines whether the file finder should skip focus for the active file in search results.\n\nDefault: true"
msgstr "Determina si el buscador de archivos debe omitir el foco en el archivo activo en los resultados de búsqueda.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Determines whether to reduce non-essential motion in the UI, such as\nloading spinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Determina si se reduce el movimiento no esencial de la interfaz, como los indicadores giratorios de carga y las etiquetas que pulsan, mostrándolos en un estado estático.\n\nValor predeterminado: off"

msgctxt "settings schema"
msgid "Determines which edit prediction provider to use."
msgstr "Determina qué proveedor de predicción de edición se usará."

msgctxt "settings schema"
msgid "Diff against HEAD: show working (uncommitted) changes."
msgstr "Diferencias respecto a HEAD: muestra los cambios sin commit."

msgctxt "settings schema"
msgid "Diff against the merge base between HEAD and the repository's\ndefault branch: show all changes on the branch.\n\nRepositories where no default branch can be resolved fall back\nto `head` behavior."
msgstr "Muestra las diferencias respecto a la base de fusión entre HEAD y la rama predeterminada del repositorio: muestra todos los cambios de la rama.\n\nLos repositorios en los que no se puede resolver una rama predeterminada usan el comportamiento de `head`."

msgctxt "settings schema"
msgid "Dim black ANSI terminal color."
msgstr "Color negro ANSI atenuado del terminal."

msgctxt "settings schema"
msgid "Dim blue ANSI terminal color."
msgstr "Color azul ANSI atenuado del terminal."

msgctxt "settings schema"
msgid "Dim cyan ANSI terminal color."
msgstr "Color cian ANSI atenuado del terminal."

msgctxt "settings schema"
msgid "Dim green ANSI terminal color."
msgstr "Color verde ANSI atenuado del terminal."

msgctxt "settings schema"
msgid "Dim magenta ANSI terminal color."
msgstr "Color magenta ANSI atenuado del terminal."

msgctxt "settings schema"
msgid "Dim red ANSI terminal color."
msgstr "Color rojo ANSI atenuado del terminal."

msgctxt "settings schema"
msgid "Dim terminal foreground color."
msgstr "Color atenuado de primer plano del terminal."

msgctxt "settings schema"
msgid "Dim white ANSI terminal color."
msgstr "Color ANSI blanco atenuado del terminal."

msgctxt "settings schema"
msgid "Dim yellow ANSI terminal color."
msgstr "Color ANSI amarillo atenuado del terminal."

msgctxt "settings schema"
msgid "Direction to split horizontally.\n\nDefault: \"up\""
msgstr "Dirección de la división horizontal.\n\nValor predeterminado: \"up\""

msgctxt "settings schema"
msgid "Direction to split vertically.\n\nDefault: \"left\""
msgstr "Dirección de la división vertical.\n\nValor predeterminado: \"left\""

msgctxt "settings schema"
msgid "Directory subtrees that sandboxed terminal commands may always write\nto without prompting. Each entry is either a bare path string or an\nobject `{requested, resolved}`; Zed writes objects (the canonical,\nsymlink-resolved target established at approval time), while\nhand-authored entries may be bare path strings. Paths written by Zed\nare absolute.\nDefault: []"
msgstr "Subárboles de directorios en los que los comandos de terminal en el sandbox siempre pueden escribir sin preguntar. Cada entrada es una cadena de ruta simple o un objeto `{requested, resolved}`; ForgeKairos escribe objetos (el destino canónico, con los enlaces simbólicos resueltos, establecido en el momento de la aprobación), mientras que las entradas escritas a mano pueden ser cadenas de ruta simples. Las rutas que escribe ForgeKairos son absolutas.\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Directory the log files are written to. `~` is expanded.\nWhen empty, logs go to Zed's log directory under `terminal-sessions`.\n\nDefault: \"\""
msgstr "Directorio en el que se escriben los archivos de registro. `~` se expande.\nSi está vacío, los registros se guardan en `terminal-sessions` dentro del directorio de registros de ForgeKairos.\n\nValor predeterminado: \"\""

msgctxt "settings schema"
msgid "Directory where git worktrees are created, relative to the repository\nworking directory.\n\nWhen the resolved directory is outside the project root, the\nproject's directory name is automatically appended so that\nsibling repos don't collide. For example, with the default\n`\"../worktrees\"` and a project at `~/code/zed`, worktrees are\ncreated under `~/code/worktrees/zed/`.\n\nWhen the resolved directory is inside the project root, no\nextra component is added (it's already project-scoped).\n\nExamples:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (default)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nTrailing slashes are ignored.\n\nDefault: ../worktrees"
msgstr "Directorio en el que se crean los worktrees de git, relativo al directorio de trabajo del repositorio.\n\nSi el directorio resuelto está fuera de la raíz del proyecto, se agrega automáticamente el nombre del directorio del proyecto para que los repositorios vecinos no colisionen. Por ejemplo, con el valor predeterminado `\"../worktrees\"` y un proyecto en `~/code/zed`, los worktrees se crean en `~/code/worktrees/zed/`.\n\nSi el directorio resuelto está dentro de la raíz del proyecto, no se agrega ningún componente adicional (ya es específico del proyecto).\n\nEjemplos:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (predeterminado)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nLas barras finales se ignoran.\n\nValor predeterminado: ../worktrees"

msgctxt "settings schema"
msgid "Disable autosave."
msgstr "Deshabilita el guardado automático."

msgctxt "settings schema"
msgid "Disable certificate verification for the proxy (not recommended).\n\nDefault: false"
msgstr "Deshabilita la verificación de certificados del proxy (no recomendado).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Disable edit predictions for files matching these glob patterns.\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged.\n\nRelative patterns are matched against paths relative to the worktree root.\nAbsolute patterns are matched against absolute paths. A leading `~` is\nexpanded to your home folder."
msgstr "Deshabilita las predicciones de edición en los archivos que coinciden con estos patrones glob.\n\nUse `\"...\"` para agregar patrones sin repetir los valores predeterminados de ForgeKairos. En la configuración del proyecto, amplía el valor de la configuración de usuario o de la configuración superior. Omita `\"...\"` para reemplazar la lista heredada.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nLos patrones heredados se insertan en `\"...\"` y, de los duplicados, se conserva la primera aparición.\n\nEstablezca `[]` para vaciar la lista heredada. Omita esta opción para heredarla sin cambios.\n\nLos patrones relativos se comparan con rutas relativas a la raíz del worktree.\nLos patrones absolutos se comparan con rutas absolutas. Un `~` inicial se expande a su carpeta personal."

msgctxt "settings schema"
msgid "Disable edit predictions in these language scopes, such as \"comment\" and\n\"string\".\n\nDefault:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` to add scopes without repeating the inherited list. In project\nsettings, it extends the user or parent configuration value. In\nlanguage-specific settings, it extends the scopes inherited by that\nlanguage. Omit `\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nInherited scopes are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged."
msgstr "Deshabilita las predicciones de edición en estos ámbitos de lenguaje, como \"comment\" y \"string\".\n\nValor predeterminado:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` para agregar ámbitos sin repetir la lista heredada. En la configuración del proyecto, amplía el valor de la configuración de usuario o de la configuración superior. En la configuración específica de un lenguaje, amplía los ámbitos que hereda ese lenguaje. Omita `\"...\"` para reemplazar la lista heredada.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nLos ámbitos heredados se insertan en `\"...\"` y, de los duplicados, se conserva la primera aparición.\n\nEstablezca `[]` para vaciar la lista heredada. Omita esta opción para heredarla sin cambios."

msgctxt "settings schema"
msgid "Disables the fallback."
msgstr "Deshabilita la alternativa."

msgctxt "settings schema"
msgid "Disables the tooltip"
msgstr "Deshabilita la descripción emergente"

msgctxt "settings schema"
msgid "Discards the changes."
msgstr "Descarta los cambios."

msgctxt "settings schema"
msgid "Display code lenses from language servers above code elements."
msgstr "Muestra CodeLens de los servidores de lenguaje encima de los elementos de código."

msgctxt "settings schema"
msgid "Display code lenses in the code action menu."
msgstr "Muestra CodeLens en el menú de acciones de código."

msgctxt "settings schema"
msgid "Display inline when there are no language server completions available."
msgstr "Se muestra en línea cuando no hay sugerencias de autocompletado del servidor de lenguaje disponibles."

msgctxt "settings schema"
msgid "Displays a border on all sides except the left side of the thumb."
msgstr "Muestra un borde en todos los lados excepto en el lado izquierdo del control deslizante."

msgctxt "settings schema"
msgid "Displays a border on all sides except the right side of the thumb."
msgstr "Muestra un borde en todos los lados excepto en el lado derecho del control deslizante."

msgctxt "settings schema"
msgid "Displays a border on all sides of the thumb."
msgstr "Muestra un borde en todos los lados del control deslizante."

msgctxt "settings schema"
msgid "Displays a border only on the left side of the thumb."
msgstr "Muestra un borde solo en el lado izquierdo del control deslizante."

msgctxt "settings schema"
msgid "Displays file size in binary units (e.g., KiB, MiB)."
msgstr "Muestra el tamaño de archivo en unidades binarias (p. ej., KiB, MiB)."

msgctxt "settings schema"
msgid "Displays file size in decimal units (e.g., KB, MB)."
msgstr "Muestra el tamaño de archivo en unidades decimales (p. ej., KB, MB)."

msgctxt "settings schema"
msgid "Displays the thumb without any border."
msgstr "Muestra el control deslizante sin ningún borde."

msgctxt "settings schema"
msgid "Do not draw any tabs or spaces."
msgstr "No dibuja ninguna tabulación ni espacio."

msgctxt "settings schema"
msgid "Do not format code."
msgstr "No formatea el código."

msgctxt "settings schema"
msgid "Do not load direnv configuration"
msgstr "No cargar la configuración de direnv"

msgctxt "settings schema"
msgid "Do not play any sound."
msgstr "No reproduce ningún sonido."

msgctxt "settings schema"
msgid "Do not query and display code lenses."
msgstr "No consulta ni muestra CodeLens."

msgctxt "settings schema"
msgid "Do not query and render document colors."
msgstr "No consulta ni representa colores de documento."

msgctxt "settings schema"
msgid "Do not render any background for indent guides."
msgstr "No representa ningún fondo para las guías de sangría."

msgctxt "settings schema"
msgid "Do not render any lines for indent guides."
msgstr "No representa ninguna línea para las guías de sangría."

msgctxt "settings schema"
msgid "Do not request folding ranges from language servers; use tree-sitter and indent-based folding."
msgstr "No solicita intervalos de plegado a los servidores de lenguaje; usa tree-sitter y el plegado basado en sangría."

msgctxt "settings schema"
msgid "Do not request semantic tokens from language servers."
msgstr "No solicita tokens semánticos a los servidores de lenguaje."

msgctxt "settings schema"
msgid "Do not show diagnostics."
msgstr "No muestra diagnósticos."

msgctxt "settings schema"
msgid "Do not show snippets in the completion list"
msgstr "No muestra fragmentos de código en la lista de autocompletado"

msgctxt "settings schema"
msgid "Don't list untracked files at all."
msgstr "No enumera en absoluto los archivos sin seguimiento."

msgctxt "settings schema"
msgid "Don't use system clipboard."
msgstr "No usa el portapapeles del sistema."

msgctxt "settings schema"
msgid "Drag and drop related settings"
msgstr "Configuración relacionada con arrastrar y colocar"

msgctxt "settings schema"
msgid "Draw a background behind the color text."
msgstr "Dibuja un fondo detrás del texto de color."

msgctxt "settings schema"
msgid "Draw a border around the color text."
msgstr "Dibuja un borde alrededor del texto de color."

msgctxt "settings schema"
msgid "Draw all invisible symbols."
msgstr "Dibuja todos los símbolos invisibles."

msgctxt "settings schema"
msgid "Draw whitespace only for the selected text."
msgstr "Dibuja los espacios en blanco solo para el texto seleccionado."

msgctxt "settings schema"
msgid "Draw whitespaces at boundaries only.\n\nFor a whitespace to be on a boundary, any of the following conditions need to be met:\n- It is a tab\n- It is adjacent to an edge (start or end)\n- It is adjacent to a whitespace (left or right)"
msgstr "Dibuja los espacios en blanco solo en los límites.\n\nPara que un espacio en blanco esté en un límite, debe cumplirse alguna de las siguientes condiciones:\n- Es una tabulación\n- Está junto a un extremo (inicio o final)\n- Está junto a otro espacio en blanco (a la izquierda o a la derecha)"

msgctxt "settings schema"
msgid "Draw whitespaces only after non-whitespace characters."
msgstr "Dibuja los espacios en blanco solo después de caracteres que no sean espacios en blanco."

msgctxt "settings schema"
msgid "EXPERIMENTAL: Overrides for the current theme.\n\nThese values will override the ones on the current theme specified in `theme`."
msgstr "EXPERIMENTAL: reemplazos para el tema actual.\n\nEstos valores reemplazan los del tema actual especificado en `theme`."

msgctxt "settings schema"
msgid "Enables or disables auto-closing of JSX tags."
msgstr "Habilita o deshabilita el cierre automático de etiquetas JSX."

msgctxt "settings schema"
msgid "Enables or disables formatting with Prettier for a given language."
msgstr "Habilita o deshabilita el formato con Prettier para un lenguaje determinado."

msgctxt "settings schema"
msgid "Enterprise URI for Copilot.\n\nDefault: none"
msgstr "URI de Enterprise para Copilot.\n\nValor predeterminado: none"

msgctxt "settings schema"
msgid "Exclude files matching these glob patterns from file scans, file searches,\nand the project file tree. Takes precedence over `file_scan_inclusions`.\n\nDefault:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Excluye los archivos que coinciden con estos patrones glob de los análisis de archivos, las búsquedas de archivos y el árbol de archivos del proyecto. Tiene prioridad sobre `file_scan_inclusions`.\n\nValor predeterminado:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUse `\"...\"` para agregar patrones sin repetir los valores predeterminados de ForgeKairos. En la configuración del proyecto, amplía el valor de la configuración de usuario o de la configuración superior. Omita `\"...\"` para reemplazar la lista heredada.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nLos patrones heredados se insertan en `\"...\"` y, de los duplicados, se conserva la primera aparición."

msgctxt "settings schema"
msgid "Extends under the left dock while snapping to the right dock"
msgstr "Se extiende bajo el dock izquierdo mientras se ajusta al dock derecho"

msgctxt "settings schema"
msgid "Extends under the right dock while snapping to the left dock"
msgstr "Se extiende bajo el dock derecho mientras se ajusta al dock izquierdo"

msgctxt "settings schema"
msgid "Extra task variables to set for a particular language."
msgstr "Variables de tarea adicionales que se establecen para un lenguaje concreto."

msgctxt "settings schema"
msgid "Favorite models to show at the top of the model selector."
msgstr "Modelos favoritos que se muestran en la parte superior del selector de modelos."

msgctxt "settings schema"
msgid "Favorited values for session config options.\n\nThis is a map from config option ID to a list of favorited value IDs.\n\nDefault: {}"
msgstr "Valores favoritos de las opciones de configuración de la sesión.\n\nEs un mapa del ID de cada opción de configuración a una lista de ID de valores favoritos.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "File diff settings."
msgstr "Configuración de diferencias del archivo."

msgctxt "settings schema"
msgid "File name for a new log. Supports the placeholders `{date}`, `{time}`,\n`{title}`, `{host}` and `{pid}`.\n\nDefault: \"{date}_{time}_{title}.log\""
msgstr "Nombre de archivo de un registro nuevo. Admite los marcadores de posición `{date}`, `{time}`, `{title}`, `{host}` y `{pid}`.\n\nValor predeterminado: \"{date}_{time}_{title}.log\""

msgctxt "settings schema"
msgid "Files larger than this many bytes are attached as an outline (their\nsymbols with line numbers) instead of their full content.\n\nDefault: 16384"
msgstr "Los archivos con más de este número de bytes se adjuntan como esquema (sus símbolos con números de línea) en lugar de su contenido completo.\n\nValor predeterminado: 16384"

msgctxt "settings schema"
msgid "Files should be formatted on save."
msgstr "Los archivos deben formatearse al guardar."

msgctxt "settings schema"
msgid "Files should be formatted using a code action executed by language servers."
msgstr "Los archivos deben formatearse mediante una acción de código ejecutada por servidores de lenguaje."

msgctxt "settings schema"
msgid "Files should not be formatted on save."
msgstr "Los archivos no deben formatearse al guardar."

msgctxt "settings schema"
msgid "Fill Color. Used for the accent fill color of an icon.\n\nThis might be used to show when a toggleable icon button is selected."
msgstr "Color de relleno. Se usa para el color de relleno de énfasis de un icono.\n\nPuede usarse para indicar que un botón de icono alternable está seleccionado."

msgctxt "settings schema"
msgid "Fill Color. Used for the default fill color of an icon."
msgstr "Color de relleno. Se usa como color de relleno predeterminado de un icono."

msgctxt "settings schema"
msgid "Fill Color. Used for the disabled fill color of an icon.\n\nDisabled states are shown when a user cannot interact with an element, like a icon button."
msgstr "Color de relleno. Se usa para el color de relleno deshabilitado de un icono.\n\nLos estados deshabilitados se muestran cuando el usuario no puede interactuar con un elemento, como un botón de icono."

msgctxt "settings schema"
msgid "Fill Color. Used for the muted or deemphasized fill color of an icon.\n\nThis might be used to show an icon in an inactive pane, or to deemphasize a series of icons to give them less visual weight."
msgstr "Color de relleno. Se usa para el color de relleno atenuado o menos destacado de un icono.\n\nPuede usarse para mostrar un icono en un panel dividido inactivo, o para atenuar una serie de iconos y darles menos peso visual."

msgctxt "settings schema"
msgid "Fill Color. Used for the placeholder fill color of an icon.\n\nThis might be used to show an icon in an input that disappears when the user enters text."
msgstr "Color de relleno. Se usa para el color de relleno de marcador de posición de un icono.\n\nPuede usarse para mostrar un icono en un campo de entrada que desaparece cuando el usuario escribe texto."

msgctxt "settings schema"
msgid "Filled background color for added diff hunk row highlights in the editor."
msgstr "Color de fondo relleno para los resaltados de filas de fragmentos de diferencias agregados en el editor."

msgctxt "settings schema"
msgid "Filled background color for deleted diff hunk row highlights in the editor."
msgstr "Color de fondo relleno para los resaltados de filas de fragmentos de diferencias eliminados en el editor."

msgctxt "settings schema"
msgid "Follow the visibility of the scrollbar."
msgstr "Sigue la visibilidad de la barra de desplazamiento."

msgctxt "settings schema"
msgid "Font family name."
msgstr "Nombre de la familia de fuentes."

msgctxt "settings schema"
msgid "Font weight value between 100 (thin) and 900 (black)"
msgstr "Valor del grosor de fuente entre 100 (fino) y 900 (negro)"

msgctxt "settings schema"
msgid "Forcefully enable or disable the scrollbar for each axis"
msgstr "Habilita o deshabilita forzosamente la barra de desplazamiento para cada eje"

msgctxt "settings schema"
msgid "Forces Prettier integration to use a specific parser name when formatting files with the language."
msgstr "Fuerza a la integración de Prettier a usar un nombre de analizador específico al formatear archivos con el lenguaje."

msgctxt "settings schema"
msgid "Forces Prettier integration to use specific plugins when formatting files with the language.\nThe default Prettier will be installed with these plugins."
msgstr "Obliga a la integración de Prettier a usar complementos concretos al formatear archivos de este lenguaje.\nEl Prettier predeterminado se instalará con estos complementos."

msgctxt "settings schema"
msgid "Foreground color for Helix jump labels."
msgstr "Color de primer plano para las etiquetas de salto de Helix."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Normal mode indicator."
msgstr "Color de primer plano para el indicador del modo Normal de Vim Helix."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Select mode indicator."
msgstr "Color de primer plano para el indicador del modo Selección de Vim Helix."

msgctxt "settings schema"
msgid "Foreground color for Vim Insert mode indicator."
msgstr "Color de primer plano para el indicador del modo Inserción de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Replace mode indicator."
msgstr "Color de primer plano para el indicador del modo Reemplazo de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Block mode indicator."
msgstr "Color de primer plano para el indicador del modo Bloque visual de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Line mode indicator."
msgstr "Color de primer plano para el indicador del modo Línea visual de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual mode indicator."
msgstr "Color de primer plano para el indicador del modo Visual de Vim."

msgctxt "settings schema"
msgid "Format code using Zed's Prettier integration."
msgstr "Formatea el código usando la integración de Prettier de ForgeKairos."

msgctxt "settings schema"
msgid "Format code using a language server."
msgstr "Formatea el código usando un servidor de lenguaje."

msgctxt "settings schema"
msgid "Format code using a specific language server."
msgstr "Formatea el código usando un servidor de lenguaje específico."

msgctxt "settings schema"
msgid "Format code using an external command."
msgstr "Formatea el código usando un comando externo."

msgctxt "settings schema"
msgid "Format code using the current language server."
msgstr "Formatea el código usando el servidor de lenguaje actual."

msgctxt "settings schema"
msgid "Format files using Zed's Prettier integration (if applicable),\nor falling back to formatting via language server."
msgstr "Formatea los archivos con la integración de Prettier de ForgeKairos (si corresponde) o, en su defecto, mediante el servidor de lenguaje."

msgctxt "settings schema"
msgid "Git accounts a repository can commit and push as. Which one a repository\nuses is picked in the git panel and kept in `project_accounts`. An\naccount's token is kept in the operating system's credential store, never\nin this file.\n\nDefault: []"
msgstr "Cuentas de Git con las que un repositorio puede hacer commit y push. La que usa cada repositorio se elige en el panel de Git y se guarda en `project_accounts`. El token de una cuenta se guarda en el almacén de credenciales del sistema operativo, nunca en este archivo.\n\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Git blame settings."
msgstr "Configuración de Git blame."

msgctxt "settings schema"
msgid "Global default permission when no tool-specific rules match.\nIndividual tools can override this with their own default.\nDefault: confirm"
msgstr "Permiso predeterminado global cuando no coincide ninguna regla específica de una herramienta.\nCada herramienta puede reemplazarlo con su propio valor predeterminado.\nValor predeterminado: confirm"

msgctxt "settings schema"
msgid "Global switch to toggle hints on and off.\n\nDefault: false"
msgstr "Conmutador global para activar y desactivar las sugerencias.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Global switch to toggle inline values on and off when debugging.\n\nDefault: true"
msgstr "Conmutador global para activar y desactivar los valores en línea durante la depuración.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Green ANSI terminal color."
msgstr "Color verde ANSI del terminal."

msgctxt "settings schema"
msgid "Gutter related settings"
msgstr "Configuración relacionada con el margen"

msgctxt "settings schema"
msgid "HTTP/HTTPS proxy to use for Copilot.\n\nDefault: none"
msgstr "Proxy HTTP/HTTPS que se usa para Copilot.\n\nValor predeterminado: none"

msgctxt "settings schema"
msgid "Hide git gutter"
msgstr "Ocultar el margen de Git"

msgctxt "settings schema"
msgid "Hide on typing and on key bindings that resolve to an action"
msgstr "Ocultar al escribir y al usar atajos de teclado que se resuelvan en una acción"

msgctxt "settings schema"
msgid "Hide only when typing"
msgstr "Ocultar solo al escribir"

msgctxt "settings schema"
msgid "Hide the tab bar while the in-panel thread history is showing and the\npanel holds a single pane: the history lists the open tabs too, so the\nhorizontal row would say the same thing twice. Split the panel or close\nthe history and the tab bar comes back."
msgstr "Oculta la barra de pestañas mientras se muestra el historial de conversaciones dentro del panel y el panel contiene un solo panel dividido: el historial también enumera las pestañas abiertas, por lo que la fila horizontal diría lo mismo dos veces. Al dividir el panel o cerrar el historial, la barra de pestañas vuelve a aparecer."

msgctxt "settings schema"
msgid "Hide the values of variables in `private` files, as defined by the\nprivate_files setting. This only changes the visual representation,\nthe values are still present in the file and can be selected / copied / pasted\n\nDefault: false"
msgstr "Oculta los valores de las variables en los archivos `private`, definidos por la opción private_files. Solo cambia la representación visual; los valores siguen presentes en el archivo y se pueden seleccionar, copiar y pegar\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Highlighted brackets background color.\n\nMatching brackets in the cursor scope are highlighted with this background color."
msgstr "Color de fondo de los delimitadores resaltados.\n\nLos delimitadores coincidentes en el ámbito del cursor se resaltan con este color de fondo."

msgctxt "settings schema"
msgid "Hollow background color for added diff hunk row highlights in the editor."
msgstr "Color de fondo hueco para los resaltados de filas de fragmentos de diferencias agregados en el editor."

msgctxt "settings schema"
msgid "Hollow background color for deleted diff hunk row highlights in the editor."
msgstr "Color de fondo hueco para los resaltados de filas de fragmentos de diferencias eliminados en el editor."

msgctxt "settings schema"
msgid "Hollow border color for added diff hunk row highlights in the editor."
msgstr "Color de borde hueco para los resaltados de filas de fragmentos de diferencias agregados en el editor."

msgctxt "settings schema"
msgid "Hollow border color for deleted diff hunk row highlights in the editor."
msgstr "Color de borde hueco para los resaltados de filas de fragmentos de diferencias eliminados en el editor."

msgctxt "settings schema"
msgid "Hollow box cursor."
msgstr "Cursor de caja hueca."

msgctxt "settings schema"
msgid "Hosts that sandboxed terminal commands may always reach over the\nnetwork without prompting. Each entry is an exact hostname\n(`github.com`) or a leading-`*.` subdomain wildcard (`*.npmjs.org`).\nDefault: []"
msgstr "Hosts a los que los comandos de terminal en el sandbox siempre pueden acceder por la red sin preguntar. Cada entrada es un nombre de host exacto (`github.com`) o un comodín de subdominio que empieza por `*.` (`*.npmjs.org`).\nValor predeterminado: []"

msgctxt "settings schema"
msgid "How and when the scrollbar should be displayed.\n\nDefault: inherits editor scrollbar settings"
msgstr "Cómo y cuándo se muestra la barra de desplazamiento.\n\nValor predeterminado: hereda la configuración de la barra de desplazamiento del editor"

msgctxt "settings schema"
msgid "How entry statuses are displayed.\n\nDefault: icon"
msgstr "Cómo se muestran los estados de las entradas.\n\nValor predeterminado: icon"

msgctxt "settings schema"
msgid "How file paths are displayed in the git gutter.\n\nDefault: file_name_first"
msgstr "Cómo se muestran las rutas de archivo en el margen de Git.\n\nValor predeterminado: file_name_first"

msgctxt "settings schema"
msgid "How hunks are displayed visually in the editor.\n\nDefault: staged_hollow"
msgstr "Cómo se muestran visualmente los fragmentos en el editor.\n\nValor predeterminado: staged_hollow"

msgctxt "settings schema"
msgid "How line endings should be handled for new files and during format and\nsave operations.\n\n- `detect`: Detect existing line endings and otherwise use the platform\n  default (`lf` on Unix, `crlf` on Windows).\n- `prefer_lf`: Prefer LF for new files and files with no existing line\n  ending.\n- `prefer_crlf`: Prefer CRLF for new files and files with no existing\n  line ending.\n- `enforce_lf`: Enforce LF during format and save.\n- `enforce_crlf`: Enforce CRLF during format and save.\n\nThe EditorConfig `end_of_line` property overrides this setting and\nbehaves like `enforce_lf` or `enforce_crlf`.\n\nDefault: detect"
msgstr "Cómo se tratan los finales de línea en los archivos nuevos y durante las operaciones de formateo y guardado.\n\n- `detect`: detecta los finales de línea existentes y, si no los hay, usa el predeterminado de la plataforma (`lf` en Unix, `crlf` en Windows).\n- `prefer_lf`: prefiere LF para los archivos nuevos y los archivos sin final de línea existente.\n- `prefer_crlf`: prefiere CRLF para los archivos nuevos y los archivos sin final de línea existente.\n- `enforce_lf`: impone LF al formatear y guardar.\n- `enforce_crlf`: impone CRLF al formatear y guardar.\n\nLa propiedad `end_of_line` de EditorConfig reemplaza esta opción y se comporta como `enforce_lf` o `enforce_crlf`.\n\nValor predeterminado: detect"

msgctxt "settings schema"
msgid "How long \"go to definition\" waits for the language server before it\nalso offers the index's name matches, in milliseconds, from 100 to\n10000.\n\nDefault: 1500"
msgstr "Tiempo que \"ir a la definición\" espera al servidor de lenguaje antes de ofrecer también las coincidencias de nombre del índice, en milisegundos, de 100 a 10000.\n\nValor predeterminado: 1500"

msgctxt "settings schema"
msgid "How many callers or callees of one function to list before a\n\"Show more\" row.\n\nDefault: 200"
msgstr "Cuántos llamadores o llamados de una función se muestran antes de una fila \"Mostrar más\".\n\nValor predeterminado: 200"

msgctxt "settings schema"
msgid "How many characters has to be in the completions query to automatically show the words-based completions.\nBefore that value, it's still possible to trigger the words-based completion manually with the corresponding editor command.\n\nDefault: 3"
msgstr "Cuántos caracteres debe tener la consulta de autocompletado para mostrar automáticamente los autocompletados basados en palabras.\nAntes de ese valor, todavía se puede activar manualmente el autocompletado basado en palabras con el comando correspondiente del editor.\n\nValor predeterminado: 3"

msgctxt "settings schema"
msgid "How many columns a tab should occupy.\n\nDefault: 4"
msgstr "Cuántas columnas debe ocupar una tabulación.\n\nValor predeterminado: 4"

msgctxt "settings schema"
msgid "How many hours a session stays alive on the host with no terminal\nattached to it before its shell is ended. 0 keeps it forever.\n\nDefault: 24"
msgstr "Cuántas horas permanece activa en el host una sesión sin ningún terminal asociado antes de que se finalice su shell. Con 0 se mantiene para siempre.\n\nValor predeterminado: 24"

msgctxt "settings schema"
msgid "How many lines of context to provide in multibuffer excerpts by default\n\nDefault: 2"
msgstr "Cuántas líneas de contexto se incluyen de forma predeterminada en los extractos del multibúfer\n\nValor predeterminado: 2"

msgctxt "settings schema"
msgid "How many lines to expand the multibuffer excerpts by default\n\nDefault: 3"
msgstr "Cuántas líneas se expanden de forma predeterminada los extractos del multibúfer\n\nValor predeterminado: 3"

msgctxt "settings schema"
msgid "How many minutes an external agent's connection is kept once no thread\nof that agent is open any more. The agent (and the sandbox it runs in)\nis stopped after that, and opening one of its threads again connects\nanew. `0` keeps every connection until the window closes.\n\nDefault: 5"
msgstr "Cuántos minutos se mantiene la conexión de un agente externo una vez que ya no hay ninguna conversación de ese agente abierta. Después, el agente (y el sandbox en el que se ejecuta) se detiene, y al volver a abrir una de sus conversaciones se conecta de nuevo. `0` mantiene todas las conexiones hasta que se cierra la ventana.\n\nValor predeterminado: 5"

msgctxt "settings schema"
msgid "How many threads clangd uses to build and index files (`-j`). Unset\nleaves clangd's own default. Values over 256 are treated as 256.\nIgnored when `lsp.clangd.binary.arguments` already has `-j`. Read from\nthe user's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Cuántos subprocesos usa clangd para compilar e indexar archivos (`-j`). Sin establecer, se mantiene el valor predeterminado de clangd. Los valores superiores a 256 se tratan como 256.\nSe ignora si `lsp.clangd.binary.arguments` ya incluye `-j`. Solo se lee de la configuración de usuario, no del `.zed/settings.json` de un proyecto.\n\nValor predeterminado: null"

msgctxt "settings schema"
msgid "How much memory clangd, the C and C++ language server, may use."
msgstr "Cuánta memoria puede usar clangd, el servidor de lenguaje de C y C++."

msgctxt "settings schema"
msgid "How much to fade out unused code."
msgstr "Cuánto atenuar el código sin usar."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel."
msgstr "Cómo deben mostrarse de forma predeterminada los bloques de razonamiento en el panel del agente."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel.\n\nDefault: automatic"
msgstr "Cómo se muestran de forma predeterminada los bloques de razonamiento en el panel del agente.\n\nValor predeterminado: automatic"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: split"
msgstr "Cómo se muestran las diferencias en el editor.\n\nValor predeterminado: split"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: unified"
msgstr "Cómo se muestran las diferencias en el editor.\n\nValor predeterminado: unified"

msgctxt "settings schema"
msgid "How to display the LSP item kind (function, method, variable, etc.)\nof each entry in the completions menu.\n\n- \"off\": do not display item kinds (default).\n- \"symbol\": display a single-letter badge, colorized based on the\n  active syntax theme.\n\nDefault: off"
msgstr "Cómo se muestra el tipo de elemento LSP (función, método, variable, etc.) de cada entrada en el menú de autocompletado.\n\n- \"off\": no muestra los tipos de elemento (predeterminado).\n- \"symbol\": muestra una insignia de una sola letra, coloreada según el tema de sintaxis activo.\n\nValor predeterminado: off"

msgctxt "settings schema"
msgid "How to group entries in the git panel.\n\nDefault: status"
msgstr "Cómo se agrupan las entradas en el panel de Git.\n\nValor predeterminado: status"

msgctxt "settings schema"
msgid "How to highlight the current line in the editor.\n\nDefault: all"
msgstr "Cómo se resalta la línea actual en el editor.\n\nValor predeterminado: all"

msgctxt "settings schema"
msgid "How to highlight the current line in the minimap.\n\nDefault: inherits editor line highlights setting"
msgstr "Cómo se resalta la línea actual en el minimapa.\n\nValor predeterminado: hereda la opción de resaltado de líneas del editor"

msgctxt "settings schema"
msgid "How to indent soft-wrapped continuation lines.\n\nDefault: same"
msgstr "Cómo aplicar sangría a las líneas de continuación del ajuste de línea automático.\n\nValor predeterminado: same"

msgctxt "settings schema"
msgid "How to order sibling entries in the project panel.\n\nDefault: directories_first"
msgstr "Cómo se ordenan las entradas hermanas en el panel de proyecto.\n\nValor predeterminado: directories_first"

msgctxt "settings schema"
msgid "How to perform a buffer format.\n\nDefault: auto"
msgstr "Cómo se formatea un búfer.\n\nValor predeterminado: auto"

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor."
msgstr "Cómo representar los colores de LSP `textDocument/documentColor` en el editor."

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor.\n\nDefault: [`DocumentColorsRenderMode::Inlay`]"
msgstr "Cómo se representan en el editor los colores de `textDocument/documentColor` de LSP.\n\nValor predeterminado: [`DocumentColorsRenderMode::Inlay`]"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference\n(e.g. Go to Definition, Go to Type Definition, Find All References).\n\nDefault: center"
msgstr "Cómo desplazar el destino para que quede a la vista al navegar a una definición o referencia (p. ej., Ir a la definición, Ir a la definición de tipo, Buscar todas las referencias).\n\nValor predeterminado: center"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference.\n\nDefault: center"
msgstr "Cómo desplazar el destino para que quede a la vista al navegar a una definición o referencia.\n\nValor predeterminado: center"

msgctxt "settings schema"
msgid "How to soft-wrap long lines of text.\n\nDefault: none"
msgstr "Cómo aplicar el ajuste de línea a las líneas de texto largas.\n\nValor predeterminado: none"

msgctxt "settings schema"
msgid "How to sort entries in the git panel.\n\nDefault: path"
msgstr "Cómo se ordenan las entradas en el panel de Git.\n\nValor predeterminado: path"

msgctxt "settings schema"
msgid "IDs of the tools not to suggest (`clangd`, `clang-format`, `ruff` and so\non). \"Don't show again\" in the notification adds a tool here.\n\nDefault: []"
msgstr "ID de las herramientas que no se sugieren (`clangd`, `clang-format`, `ruff`, etc.). \"No volver a mostrar\" en la notificación agrega una herramienta aquí.\n\nValor predeterminado: []"

msgctxt "settings schema"
msgid "IMDSv2, PodIdentity, env vars, etc."
msgstr "IMDSv2, PodIdentity, variables de entorno, etc."

msgctxt "settings schema"
msgid "Icon Theme Name"
msgstr "Nombre del tema de iconos"

msgctxt "settings schema"
msgid "If enabled, Zed will download its own copy of Node."
msgstr "Si se habilita, ForgeKairos descargará su propia copia de Node."

msgctxt "settings schema"
msgid "If provider supports it, display inline when holding modifier key (e.g., alt).\nOtherwise, eager preview is used."
msgstr "Si el proveedor lo admite, se muestra en línea mientras se mantiene presionada una tecla modificadora (p. ej., alt).\nDe lo contrario, se usa la vista previa inmediata."

msgctxt "settings schema"
msgid "If the server supports sending tasks over LSP extensions,\nthis setting can be used to enable or disable them in Zed.\nDefault: true"
msgstr "Si el servidor admite el envío de tareas mediante extensiones de LSP, esta opción permite habilitarlas o deshabilitarlas en ForgeKairos.\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Ignored version control color."
msgstr "Color para elementos ignorados en el control de versiones."

msgctxt "settings schema"
msgid "Include files matching these glob patterns when scanning, even if ignored\nby Git. Note that broad patterns can slow file scanning.\n`file_scan_exclusions` takes precedence.\n\nDefault:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Incluye en el análisis los archivos que coinciden con estos patrones glob, aunque Git los ignore. Tenga en cuenta que los patrones amplios pueden ralentizar el análisis de archivos.\n`file_scan_exclusions` tiene prioridad.\n\nValor predeterminado:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUse `\"...\"` para agregar patrones sin repetir los valores predeterminados de ForgeKairos. En la configuración del proyecto, amplía el valor de la configuración de usuario o de la configuración superior. Omita `\"...\"` para reemplazar la lista heredada.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nLos patrones heredados se insertan en `\"...\"` y, de los duplicados, se conserva la primera aparición."

msgctxt "settings schema"
msgid "Indent guide related settings."
msgstr "Configuración relacionada con las guías de sangría."

msgctxt "settings schema"
msgid "Index a worktree once it has C or C++ files."
msgstr "Indexar un worktree en cuanto tenga archivos C o C++."

msgctxt "settings schema"
msgid "Index only the open files."
msgstr "Indexar solo los archivos abiertos."

msgctxt "settings schema"
msgid "Index the whole project in the background (clangd's default)."
msgstr "Indexar todo el proyecto en segundo plano (valor predeterminado de clangd)."

msgctxt "settings schema"
msgid "Indicates a changed or altered status, like a file that has been edited."
msgstr "Indica un estado cambiado o alterado, como un archivo que se ha editado."

msgctxt "settings schema"
msgid "Indicates a hint or some kind of additional information."
msgstr "Indica una sugerencia o algún tipo de información adicional."

msgctxt "settings schema"
msgid "Indicates a successful operation or task completion."
msgstr "Indica una operación correcta o la finalización de una tarea."

msgctxt "settings schema"
msgid "Indicates a system error, a failed operation or a diagnostic error."
msgstr "Indica un error del sistema, una operación fallida o un error de diagnóstico."

msgctxt "settings schema"
msgid "Indicates some kind of conflict, like a file changed on disk while it was open, or\nmerge conflicts in a Git repository."
msgstr "Indica algún tipo de conflicto, como un archivo que cambió en el disco mientras estaba abierto, o conflictos de fusión en un repositorio de Git."

msgctxt "settings schema"
msgid "Indicates some kind of unreachable status, like a block of code that can never be reached."
msgstr "Indica algún tipo de estado inalcanzable, como un bloque de código al que nunca se puede llegar."

msgctxt "settings schema"
msgid "Indicates something new, like a new file added to a Git repository."
msgstr "Indica algo nuevo, como un archivo nuevo agregado a un repositorio Git."

msgctxt "settings schema"
msgid "Indicates something that is predicted, like automatic code completion, or generated code."
msgstr "Indica algo predicho, como autocompletado automático de código o código generado."

msgctxt "settings schema"
msgid "Indicates that something is deliberately ignored, such as a file or operation ignored by Git."
msgstr "Indica que algo se ignora deliberadamente, como un archivo u operación ignorados por Git."

msgctxt "settings schema"
msgid "Indicates that something no longer exists, like a deleted file."
msgstr "Indica que algo ya no existe, como un archivo eliminado."

msgctxt "settings schema"
msgid "Indicates whether this custom model supports caching."
msgstr "Indica si este modelo personalizado admite almacenamiento en caché."

msgctxt "settings schema"
msgid "Inherit cursor shape from the editor's base cursor_shape setting."
msgstr "Hereda la forma del cursor de la configuración base cursor_shape del editor."

msgctxt "settings schema"
msgid "Inlay hint related settings."
msgstr "Configuración relacionada con las sugerencias insertadas."

msgctxt "settings schema"
msgid "Jupyter REPL settings."
msgstr "Configuración del REPL de Jupyter."

msgctxt "settings schema"
msgid "Keep model alive for N seconds"
msgstr "Mantiene el modelo activo durante N segundos"

msgctxt "settings schema"
msgid "Keep model alive for a fixed duration. Accepts durations like \"5m\", \"10m\", \"1h\", \"1d\", etc."
msgstr "Mantiene el modelo activo durante una duración fija. Acepta duraciones como \"5m\", \"10m\", \"1h\", \"1d\", etc."

msgctxt "settings schema"
msgid "Keep the tab bar hidden, leaving the in-panel thread history as the way\nto the open tabs. A panel too narrow to show that list, or the strip\nthat brings it back, still gets the tab bar: otherwise nothing would\nreach the tabs that are not in front."
msgstr "Mantiene oculta la barra de pestañas y deja el historial de conversaciones dentro del panel como forma de llegar a las pestañas abiertas. Un panel demasiado estrecho para mostrar esa lista, o la franja que la vuelve a mostrar, sigue teniendo la barra de pestañas: de lo contrario, no habría forma de llegar a las pestañas que no están al frente."

msgctxt "settings schema"
msgid "Keeps the changes in the working tree, unstaged."
msgstr "Mantiene los cambios en el árbol de trabajo, sin preparar."

msgctxt "settings schema"
msgid "Keeps the changes staged."
msgstr "Mantiene los cambios preparados."

msgctxt "settings schema"
msgid "Language server settings.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Configuración del servidor de lenguaje.\n\nReferencia: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsulte la documentación del servidor de lenguaje concreto para ver qué opciones admite."

msgctxt "settings schema"
msgid "Language servers from extensions that keep running while their\nworktree's code is paused, by name (for example `\"gopls\"`). Other\nextensions' servers stop until the worktree is resumed. Read from the\nuser settings file only.\n\nDefault: []"
msgstr "Servidores de lenguaje de extensiones que siguen ejecutándose mientras el código de su worktree está detenido, por nombre (por ejemplo, `\"gopls\"`). Los servidores de otras extensiones se detienen hasta que se reanuda el worktree. Solo se lee del archivo de configuración de usuario.\n\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Largest outline sent for one file, in bytes. Deeper symbols are\ndropped first when an outline does not fit.\n\nDefault: 8192"
msgstr "Esquema más grande que se envía para un archivo, en bytes. Si un esquema no cabe, se descartan primero los símbolos más profundos.\n\nValor predeterminado: 8192"

msgctxt "settings schema"
msgid "Largest part of a fetched web page that is attached, in bytes.\n\nDefault: 32768"
msgstr "Parte más grande de una página web obtenida que se adjunta, en bytes.\n\nValor predeterminado: 32768"

msgctxt "settings schema"
msgid "Layout mode for the bottom dock\n\nDefault: contained"
msgstr "Modo de diseño del dock inferior\n\nValor predeterminado: contained"

msgctxt "settings schema"
msgid "Leave the slot empty: the dock shows a single panel, as upstream Zed\ndoes, or none at all."
msgstr "Dejar el espacio vacío: el dock muestra un solo panel, como Zed upstream, o ninguno."

msgctxt "settings schema"
msgid "Leave the window open when there are no tabs"
msgstr "Dejar la ventana abierta cuando no haya pestañas"

msgctxt "settings schema"
msgid "Limits on how much of an attachment (a file, a directory, a selection,\na fetched page, diagnostics or a branch diff) is sent to the agent.\nAnything over these limits is sent as an outline or a reference the\nagent can follow up on instead of in full."
msgstr "Límites de cuánto de un adjunto (un archivo, un directorio, una selección, una página obtenida, diagnósticos o las diferencias de una rama) se envía al agente.\nLo que supere estos límites se envía como esquema o como referencia que el agente puede seguir, en lugar de completo."

msgctxt "settings schema"
msgid "List every file inside untracked directories."
msgstr "Enumerar todos los archivos dentro de los directorios sin seguimiento."

msgctxt "settings schema"
msgid "List untracked directories, but not the files inside them."
msgstr "Enumerar los directorios sin seguimiento, pero no los archivos que contienen."

msgctxt "settings schema"
msgid "Load direnv configuration directly using `direnv export json`"
msgstr "Cargar la configuración de direnv directamente usando `direnv export json`"

msgctxt "settings schema"
msgid "Load direnv configuration through a shell hook"
msgstr "Cargar la configuración de direnv mediante un hook de shell"

msgctxt "settings schema"
msgid "Local overrides for feature flags, keyed by flag name."
msgstr "Sobrescrituras locales para feature flags, indexadas por nombre de flag."

msgctxt "settings schema"
msgid "Looks up references of the same symbol instead."
msgstr "Busca referencias del mismo símbolo en su lugar."

msgctxt "settings schema"
msgid "Lowercase names are grouped before uppercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Los nombres en minúsculas se agrupan antes que los nombres en mayúsculas, con ordenación natural sin distinguir mayúsculas y minúsculas dentro de cada grupo. Los nombres que empiezan por punto se ordenan antes que ambos grupos."

msgctxt "settings schema"
msgid "Magenta ANSI terminal color."
msgstr "Color magenta ANSI del terminal."

msgctxt "settings schema"
msgid "Map from language name to file patterns."
msgstr "Asignación de nombre de lenguaje a patrones de archivo."

msgctxt "settings schema"
msgid "Map from language name to settings."
msgstr "Asignación de nombre de lenguaje a configuración."

msgctxt "settings schema"
msgid "Match platform conventions by default, so \"on\" on macOS and \"off\" everywhere else"
msgstr "Sigue las convenciones de la plataforma de forma predeterminada: \"on\" en macOS y \"off\" en el resto"

msgctxt "settings schema"
msgid "Match platform conventions by default, so don't quit on macOS, and quit on other platforms"
msgstr "Coincide con las convenciones de la plataforma de forma predeterminada, por lo que no se cierra en macOS y se cierra en otras plataformas"

msgctxt "settings schema"
msgid "Match the system's configured behavior."
msgstr "Coincide con el comportamiento configurado del sistema."

msgctxt "settings schema"
msgid "Maximum content width in pixels for the agent panel. Content will be\ncentered when the panel is wider than this value.\n\nDefault: 850"
msgstr "Ancho máximo del contenido en píxeles para el panel del agente. El contenido se centra cuando el panel es más ancho que este valor.\n\nValor predeterminado: 850"

msgctxt "settings schema"
msgid "Maximum directory depth to eagerly index outside of git repositories;\ncontents of directories at this depth or deeper are indexed on demand.\nRepositories rooted shallower than this depth are always indexed fully.\nIn projects that are not rooted at a git repository, repositories directly\ninside a root folder activate their git features immediately; deeper ones\nactivate on first use.\n`0` means no limit and activates all git repositories immediately.\n\nDefault: 5"
msgstr "Profundidad máxima de directorios que se indexa de antemano fuera de los repositorios de git; el contenido de los directorios a esta profundidad o más se indexa cuando se necesita.\nLos repositorios cuya raíz está a menos profundidad siempre se indexan por completo.\nEn los proyectos cuya raíz no es un repositorio de git, los repositorios situados directamente dentro de una carpeta raíz activan sus funciones de git de inmediato; los más profundos las activan al usarse por primera vez.\n`0` significa sin límite y activa todos los repositorios de git de inmediato.\n\nValor predeterminado: 5"

msgctxt "settings schema"
msgid "Maximum length of the commit message title before a warning is shown.\nSet to 0 to disable.\n\nDefault: 0"
msgstr "Longitud máxima del título del mensaje de commit antes de mostrar una advertencia.\nEstablézcala en 0 para deshabilitarla.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "Maximum number of characters for an output to be shown inline.\nOnly applies when `inline_output` is true.\n\nDefault: 50"
msgstr "Número máximo de caracteres para que una salida se muestre en línea.\nSolo se aplica cuando `inline_output` es true.\n\nValor predeterminado: 50"

msgctxt "settings schema"
msgid "Maximum number of columns to display in the minimap.\n\nDefault: 80"
msgstr "Número máximo de columnas que se muestran en el minimapa.\n\nValor predeterminado: 80"

msgctxt "settings schema"
msgid "Maximum number of columns to keep in REPL's scrollback buffer.\nClamped with [20, 512] range.\n\nDefault: 128"
msgstr "Número máximo de columnas que se conservan en el búfer de desplazamiento del REPL.\nSe limita al intervalo [20, 512].\n\nValor predeterminado: 128"

msgctxt "settings schema"
msgid "Maximum number of idle threads with loadable sessions to retain in the\nagent panel. Set to 0 to unload every eligible idle thread when it is\nno longer active.\n\nDefault: 5"
msgstr "Número máximo de conversaciones inactivas con sesiones recargables que se conservan en el panel del agente. Con 0, se descarga cada conversación inactiva que cumpla los requisitos en cuanto deja de estar activa.\n\nValor predeterminado: 5"

msgctxt "settings schema"
msgid "Maximum number of lines of output to display before scrolling.\nSet to 0 to disable output height limits.\n\nDefault: 0"
msgstr "Número máximo de líneas de salida que se muestran antes de desplazarse.\nEstablézcalo en 0 para deshabilitar el límite de altura de la salida.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "Maximum number of lines to keep in REPL's scrollback buffer.\nClamped with [4, 256] range.\n\nDefault: 32"
msgstr "Número máximo de líneas que se conservan en el búfer de desplazamiento del REPL.\nSe limita al intervalo [4, 256].\n\nValor predeterminado: 32"

msgctxt "settings schema"
msgid "Maximum open tabs in a pane. Will not close an unsaved\ntab. Set to `None` for unlimited tabs.\n\nDefault: none"
msgstr "Número máximo de pestañas abiertas en un panel dividido. No se cerrará una pestaña sin guardar. Establézcalo en `None` para no limitar las pestañas.\n\nValor predeterminado: none"

msgctxt "settings schema"
msgid "Maximum tokens to generate for FIM models and self-hosted Sweep rewrite responses.\n\nDefault: 256"
msgstr "Número máximo de tokens que se generan para los modelos FIM y las respuestas de reescritura de Sweep autoalojado.\n\nValor predeterminado: 256"

msgctxt "settings schema"
msgid "Maximum tokens to generate.\n\nDefault: 150"
msgstr "Número máximo de tokens que se generan.\n\nValor predeterminado: 150"

msgctxt "settings schema"
msgid "Minimap related settings"
msgstr "Configuración relacionada con el minimapa"

msgctxt "settings schema"
msgid "Minimum APCA perceptual contrast for text over highlight backgrounds.\n\nValid range: 0.0 to 106.0\nDefault: 45.0"
msgstr "Contraste perceptual APCA mínimo para el texto sobre fondos resaltados.\n\nIntervalo válido: de 0.0 a 106.0\nValor predeterminado: 45.0"

msgctxt "settings schema"
msgid "Minimum number of characters to reserve space for in the gutter.\n\nDefault: 4"
msgstr "Número mínimo de caracteres para los que se reserva espacio en el margen.\n\nValor predeterminado: 4"

msgctxt "settings schema"
msgid "Minimum number of lines of height the agent message editor should have.\n\nDefault: 4"
msgstr "Número mínimo de líneas de altura que debe tener el editor de mensajes del agente.\n\nValor predeterminado: 4"

msgctxt "settings schema"
msgid "Minimum time to wait before pulling diagnostics from the language server(s).\n0 turns the debounce off.\n\nDefault: 50"
msgstr "Tiempo mínimo de espera antes de obtener los diagnósticos de los servidores de lenguaje.\n0 desactiva el retardo de debounce.\n\nValor predeterminado: 50"

msgctxt "settings schema"
msgid "Mix directories and files together"
msgstr "Mezclar directorios y archivos"

msgctxt "settings schema"
msgid "Model that judges whether a tool action is dangerous when the tool\npermission mode is `auto`. Defaults to the fast model, then to\ndefault_model, when not specified."
msgstr "Modelo que juzga si una acción de una herramienta es peligrosa cuando el modo de permisos de herramientas es `auto`. Si no se especifica, se usa el modelo rápido y, en su defecto, default_model."

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: \"codestral-latest\""
msgstr "Modelo que se usa para los autocompletados.\n\nValor predeterminado: \"codestral-latest\""

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: none"
msgstr "Modelo que se usa para los autocompletados.\n\nValor predeterminado: none"

msgctxt "settings schema"
msgid "Model to use for context compaction (`/compact` and auto-compaction).\nFalls back to the thread's currently selected model when not specified.\nIf the configured model is unavailable (provider not registered, model\nnot found), the thread's current model is used instead."
msgstr "Modelo que se usa para la compactación del contexto (`/compact` y la compactación automática).\nSi no se especifica, se usa el modelo seleccionado actualmente en la conversación.\nSi el modelo configurado no está disponible (proveedor no registrado, modelo no encontrado), se usa en su lugar el modelo actual de la conversación."

msgctxt "settings schema"
msgid "Model to use for generating git commit messages. Defaults to default_model when not specified."
msgstr "Modelo que se utilizará para generar mensajes de commit de Git. Si no se especifica, se usa default_model."

msgctxt "settings schema"
msgid "Model to use for generating thread summaries. Defaults to default_model when not specified."
msgstr "Modelo que se utilizará para generar resúmenes de conversaciones. Si no se especifica, se usa default_model."

msgctxt "settings schema"
msgid "Model to use for the inline assistant when streaming tools are enabled.\n\nDefault: true"
msgstr "Modelo que se usa para el asistente en línea cuando las herramientas de streaming están habilitadas.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Model to use for the inline assistant. Defaults to default_model when not specified."
msgstr "Modelo que se utilizará para el asistente en línea. Si no se especifica, se usa default_model."

msgctxt "settings schema"
msgid "Modified version control color."
msgstr "Color para elementos modificados en el control de versiones."

msgctxt "settings schema"
msgid "Most files whose diagnostics are attached with a diagnostics mention.\n\nDefault: 50"
msgstr "Número máximo de archivos cuyos diagnósticos se adjuntan con una mención de diagnósticos.\n\nValor predeterminado: 50"

msgctxt "settings schema"
msgid "Name to use for this server in UI."
msgstr "Nombre que se usará para este servidor en la interfaz."

msgctxt "settings schema"
msgid "Never allow training data collection."
msgstr "No se permite nunca la recopilación de datos de entrenamiento."

msgctxt "settings schema"
msgid "Never blink the cursor, ignoring the terminal mode."
msgstr "No hace parpadear nunca el cursor, ignorando el modo del terminal."

msgctxt "settings schema"
msgid "Never fetch or complete document's words for completions.\n(Word-based completions can still be queried via a separate action)"
msgstr "Nunca obtener ni autocompletar las palabras del documento para los autocompletados.\n(Los autocompletados basados en palabras se pueden seguir consultando mediante una acción independiente)"

msgctxt "settings schema"
msgid "Never hide the mouse cursor"
msgstr "No ocultar nunca el cursor del mouse"

msgctxt "settings schema"
msgid "Never index the worktree."
msgstr "No indexar nunca el worktree."

msgctxt "settings schema"
msgid "Never populate the search query"
msgstr "Nunca rellena la consulta de búsqueda"

msgctxt "settings schema"
msgid "Never reduce motion"
msgstr "No reducir nunca el movimiento"

msgctxt "settings schema"
msgid "Never show the minimap."
msgstr "No muestra nunca el minimapa."

msgctxt "settings schema"
msgid "Never show the scrollbar."
msgstr "No muestra nunca la barra de desplazamiento."

msgctxt "settings schema"
msgid "No automatic indentation. New lines start at column 0."
msgstr "Sin sangría automática. Las líneas nuevas empiezan en la columna 0."

msgctxt "settings schema"
msgid "Normalize line endings to CRLF (`\\r\\n`) during format and save."
msgstr "Normaliza los finales de línea a CRLF (`\\r\\n`) al formatear y guardar."

msgctxt "settings schema"
msgid "Normalize line endings to LF (`\\n`) during format and save."
msgstr "Normaliza los finales de línea a LF (`\\n`) al formatear y guardar."

msgctxt "settings schema"
msgid "Number of lines to search for modelines at the beginning and end of files.\nModelines contain editor directives (e.g., vim/emacs settings) that configure\nthe editor behavior for specific files.\n\nDefault: 5"
msgstr "Número de líneas al principio y al final de los archivos en las que se buscan líneas de modo (modelines).\nLas líneas de modo contienen directivas del editor (p. ej., opciones de vim/emacs) que configuran el comportamiento del editor para archivos concretos.\n\nValor predeterminado: 5"

msgctxt "settings schema"
msgid "Ollama model name for edit predictions."
msgstr "Nombre del modelo de Ollama para predicciones de edición."

msgctxt "settings schema"
msgid "One of `sftp`, `scp`, `ftp` or `ftps`. Any other value means SFTP."
msgstr "Uno de `sftp`, `scp`, `ftp` o `ftps`. Cualquier otro valor significa SFTP."

msgctxt "settings schema"
msgid "Only if LSP response errors or times out,\nuse document's words to show completions."
msgstr "Solo si la respuesta de LSP da error o agota el tiempo de espera, usar las palabras del documento para mostrar autocompletados."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nIf no git diff is available (e.g., when source control is\nunavailable) or if the LSP doesn't support range formatting,\nfalls back to formatting the whole file."
msgstr "Al guardar, solo se formatean las líneas con cambios sin preparar.\nSi no hay diferencias de git disponibles (p. ej., cuando el control de código fuente no está disponible) o si el LSP no admite el formateo de intervalos, se formatea el archivo completo."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nRequires source control and LSP range formatting support.\nIf no git diff is available or if the LSP doesn't support\nrange formatting, formatting is skipped."
msgstr "Al guardar, solo se formatean las líneas con cambios sin preparar.\nRequiere control de código fuente y que el LSP admita el formateo de intervalos.\nSi no hay diferencias de git disponibles o si el LSP no admite el formateo de intervalos, se omite el formateo."

msgctxt "settings schema"
msgid "Only populate the search query when there is text selected."
msgstr "Solo rellena la consulta de búsqueda cuando hay texto seleccionado."

msgctxt "settings schema"
msgid "Only rewrap within comments."
msgstr "Solo reajusta las líneas dentro de los comentarios."

msgctxt "settings schema"
msgid "Only rewrap within the current selection(s)."
msgstr "Solo reajusta las líneas dentro de las selecciones actuales."

msgctxt "settings schema"
msgid "Only scan symlinked directories when they've been expanded in the workspace"
msgstr "Analizar los directorios enlazados simbólicamente solo cuando se hayan expandido en el área de trabajo"

msgctxt "settings schema"
msgid "Only the language server."
msgstr "Solo el servidor de lenguaje."

msgctxt "settings schema"
msgid "Only the symbol index's name matches."
msgstr "Solo las coincidencias de nombre del índice de símbolos."

msgctxt "settings schema"
msgid "Opacity of inactive panels.\nWhen set to 1.0, the inactive panes have the same opacity as the active one.\nIf set to 0, the inactive panes content will not be visible at all.\nValues are clamped to the [0.0, 1.0] range.\n\nDefault: `1.0`"
msgstr "Opacidad de los paneles inactivos.\nCon 1.0, los paneles divididos inactivos tienen la misma opacidad que el activo.\nCon 0, el contenido de los paneles divididos inactivos no se ve en absoluto.\nLos valores se limitan al intervalo [0.0, 1.0].\n\nValor predeterminado: `1.0`"

msgctxt "settings schema"
msgid "Opacity of the inactive panes. 0 means transparent, 1 means opaque.\n\nValid range: 0.0 to 1.0\nDefault: 1.0"
msgstr "Opacidad de los paneles divididos inactivos. 0 significa transparente y 1, opaco.\n\nIntervalo válido: de 0.0 a 1.0\nValor predeterminado: 1.0"

msgctxt "settings schema"
msgid "Open a single-file diff view."
msgstr "Abre una vista de diferencias de un solo archivo."

msgctxt "settings schema"
msgid "Open directories as a new workspace in the current Zed window's sidebar."
msgstr "Abre directorios como un área de trabajo nueva en la barra lateral de la ventana actual de ForgeKairos."

msgctxt "settings schema"
msgid "Open paths in a new window unless they are subpaths of an existing project."
msgstr "Abre rutas en una ventana nueva a menos que sean subrutas de un proyecto existente."

msgctxt "settings schema"
msgid "Open projects in a new window."
msgstr "Abre los proyectos en una ventana nueva."

msgctxt "settings schema"
msgid "Open projects in the current Zed window."
msgstr "Abre los proyectos en la ventana actual de ForgeKairos."

msgctxt "settings schema"
msgid "Open the excerpt clicked as a new buffer in the new tab, if no `alt` modifier was pressed during double click.\nOtherwise, behave as a regular buffer and select the whole word."
msgstr "Abre el extracto en el que se hizo clic como un búfer nuevo en una pestaña nueva, si no se presionó el modificador `alt` durante el doble clic.\nDe lo contrario, se comporta como un búfer normal y selecciona la palabra completa."

msgctxt "settings schema"
msgid "Open the file in the editor without a diff view."
msgstr "Abre el archivo en el editor sin una vista de diferencias."

msgctxt "settings schema"
msgid "Open the project diff, showing all changed files."
msgstr "Abre las diferencias del proyecto, mostrando todos los archivos modificados."

msgctxt "settings schema"
msgid "Open the results in a filterable picker."
msgstr "Abre los resultados en un selector filtrable."

msgctxt "settings schema"
msgid "Open the results in a multibuffer."
msgstr "Abre los resultados en un multibúfer."

msgctxt "settings schema"
msgid "Optional headers to send."
msgstr "Encabezados opcionales que se enviarán."

msgctxt "settings schema"
msgid "Options passed to the language server at startup.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Opciones que se pasan al servidor de lenguaje al iniciarse.\n\nReferencia: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsulte la documentación del servidor de lenguaje concreto para ver qué opciones admite."

msgctxt "settings schema"
msgid "Override this model with a different Anthropic model for tool calls."
msgstr "Sobrescribe este modelo con otro modelo de Anthropic para las llamadas a herramientas."

msgctxt "settings schema"
msgid "Overrides per theme\n\nThese values will override the ones on the specified theme"
msgstr "Reemplazos por tema\n\nEstos valores reemplazan los del tema especificado"

msgctxt "settings schema"
msgid "Overrides the context length reported for every llama.cpp model."
msgstr "Sobrescribe la longitud de contexto indicada para cada modelo de llama.cpp."

msgctxt "settings schema"
msgid "Panel stacked beside it, or `none` for a single panel as upstream Zed\nshows.\n\nDefault: browser"
msgstr "Panel apilado a su lado, o `none` para un solo panel, como muestra Zed upstream.\n\nValor predeterminado: browser"

msgctxt "settings schema"
msgid "Panel that fills that dock, or `none` to leave the dock as it was.\n\nDefault: agent"
msgstr "Panel que ocupa ese dock, o `none` para dejar el dock como estaba.\n\nValor predeterminado: agent"

msgctxt "settings schema"
msgid "Per-tool permission rules for granular control over which tool actions\nrequire confirmation.\n\nThe global `default` applies when no tool-specific rules match.\nFor external agent servers (e.g. Claude Agent) that define their own\npermission modes, \"deny\" and \"confirm\" still take precedence — the\nexternal agent's permission system is only used when Zed would allow\nthe action. Per-tool regex patterns (`always_allow`, `always_deny`,\n`always_confirm`) match against the tool's text input (command, path,\nURL, etc.)."
msgstr "Reglas de permisos por herramienta para controlar de forma detallada qué acciones de las herramientas requieren confirmación.\n\nEl `default` global se aplica cuando no coincide ninguna regla específica de una herramienta.\nPara los servidores de agentes externos (p. ej., Claude Agent) que definen sus propios modos de permisos, \"deny\" y \"confirm\" siguen teniendo prioridad: el sistema de permisos del agente externo solo se usa cuando ForgeKairos permitiría la acción. Los patrones de expresión regular por herramienta (`always_allow`, `always_deny`, `always_confirm`) se comparan con la entrada de texto de la herramienta (comando, ruta, URL, etc.)."

msgctxt "settings schema"
msgid "Per-tool permission rules.\nKeys are tool names (e.g. terminal, edit_file, fetch) including MCP\ntools (e.g. mcp:server_name:tool_name). Any tool name is accepted;\neven tools without meaningful text input can have a `default` set."
msgstr "Reglas de permisos por herramienta.\nLas claves son nombres de herramientas (p. ej., terminal, edit_file, fetch), incluidas las herramientas MCP (p. ej., mcp:server_name:tool_name). Se acepta cualquier nombre de herramienta; incluso las herramientas sin una entrada de texto significativa pueden tener un `default` establecido."

msgctxt "settings schema"
msgid "Persistent sandbox permission grants for agent-run terminal commands.\nThese are populated when choosing \"Allow always\" from a sandbox\nescalation prompt."
msgstr "Concesiones persistentes de permisos del sandbox para los comandos de terminal que ejecuta el agente.\nSe rellenan al elegir \"Permitir siempre\" en una solicitud de elevación de permisos del sandbox."

msgctxt "settings schema"
msgid "Place snippets at the bottom of the completion list"
msgstr "Coloca los fragmentos de código al final de la lista de autocompletado"

msgctxt "settings schema"
msgid "Place snippets at the top of the completion list"
msgstr "Coloca los fragmentos de código al principio de la lista de autocompletado"

msgctxt "settings schema"
msgid "Play an OS-specific alert sound."
msgstr "Reproduce un sonido de alerta específico del sistema operativo."

msgctxt "settings schema"
msgid "Position of the close button in a tab.\n\nDefault: right"
msgstr "Posición del botón de cerrar en una pestaña.\n\nValor predeterminado: right"

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for MCP servers that don't support\nDynamic Client Registration."
msgstr "Credenciales de cliente OAuth registradas previamente para los servidores MCP que no admiten Dynamic Client Registration."

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for authorization servers that\nrequire out-of-band client registration."
msgstr "Credenciales de cliente OAuth registradas previamente para los servidores de autorización que requieren un registro de cliente fuera de banda."

msgctxt "settings schema"
msgid "Prefer a single line generally, unless an overly long line is encountered."
msgstr "Prefiere una sola línea en general, salvo que se encuentre una línea demasiado larga."

msgctxt "settings schema"
msgid "Preferred Conda manager to use when activating Conda environments.\n\nDefault: auto"
msgstr "Administrador de Conda preferido que se usa al activar entornos de Conda.\n\nValor predeterminado: auto"

msgctxt "settings schema"
msgid "Preferred debuggers for this language.\n\nDefault: []"
msgstr "Depuradores preferidos para este lenguaje.\n\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Preserve the cursor's vertical position within the viewport, falling\nback to centering when the cursor is offscreen."
msgstr "Conserva la posición vertical del cursor dentro de la ventanilla y, si el cursor está fuera de la pantalla, lo centra."

msgctxt "settings schema"
msgid "Preserve the existing line endings of the file. New files use the\nplatform default line ending."
msgstr "Conserva los finales de línea existentes del archivo. Los archivos nuevos usan el final de línea predeterminado de la plataforma."

msgctxt "settings schema"
msgid "Preserve the indentation of the current line when creating new lines,\nbut don't adjust based on syntax context."
msgstr "Conserva la sangría de la línea actual al crear líneas nuevas, pero no la ajusta según el contexto sintáctico."

msgctxt "settings schema"
msgid "Pure Unicode codepoint comparison. No case folding, no natural number sorting.\nUppercase ASCII sorts before lowercase. Accented characters sort after ASCII."
msgstr "Comparación pura por punto de código Unicode. Sin unificar mayúsculas y minúsculas ni ordenación natural de números.\nLas mayúsculas ASCII se ordenan antes que las minúsculas. Los caracteres acentuados se ordenan después de ASCII."

msgctxt "settings schema"
msgid "Quit the application the last window is closed"
msgstr "Cierra la aplicación cuando se cierra la última ventana"

msgctxt "settings schema"
msgid "Read-access of a symbol, like reading a variable.\n\nA document highlight is a range inside a text document which deserves\nspecial attention. Usually a document highlight is visualized by changing\nthe background color of its range."
msgstr "Acceso de lectura a un símbolo, como leer una variable.\n\nUn resaltado de documento es un intervalo dentro de un documento de texto que merece especial atención. Normalmente se muestra cambiando el color de fondo de su intervalo."

msgctxt "settings schema"
msgid "Red ANSI terminal color."
msgstr "Color rojo ANSI del terminal."

msgctxt "settings schema"
msgid "Regexes for inputs that must always prompt.\nTakes precedence over always_allow but not always_deny.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Expresiones regulares de las entradas que siempre deben pedir confirmación.\nTienen prioridad sobre always_allow, pero no sobre always_deny.\nPara `copy_path` y `move_path`, los patrones se comparan por separado con cada ruta (origen y destino).\nLos patrones se acumulan entre las capas de configuración (usuario, proyecto, perfil) y una capa de mayor prioridad no puede quitarlos; solo se pueden agregar patrones nuevos.\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-approve.\nFor terminal: matches command. For file tools: matches path. For fetch: matches URL.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Expresiones regulares de las entradas que se aprueban automáticamente.\nPara terminal: se comparan con el comando. Para herramientas de archivos: con la ruta. Para fetch: con la URL.\nPara `copy_path` y `move_path`, los patrones se comparan por separado con cada ruta (origen y destino).\nLos patrones se acumulan entre las capas de configuración (usuario, proyecto, perfil) y una capa de mayor prioridad no puede quitarlos; solo se pueden agregar patrones nuevos.\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-reject.\n**SECURITY**: These take precedence over ALL other rules, across ALL settings layers.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Expresiones regulares de las entradas que se rechazan automáticamente.\n**SEGURIDAD**: tienen prioridad sobre TODAS las demás reglas, en TODAS las capas de configuración.\nPara `copy_path` y `move_path`, los patrones se comparan por separado con cada ruta (origen y destino).\nLos patrones se acumulan entre las capas de configuración (usuario, proyecto, perfil) y una capa de mayor prioridad no puede quitarlos; solo se pueden agregar patrones nuevos.\nValor predeterminado: []"

msgctxt "settings schema"
msgid "Regexes used to identify paths for hyperlink navigation.\n\nDefault:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUse `\"...\"` to add regexes without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list. Set `[]` to clear it. Omitting this\nsetting keeps the inherited list.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nInherited regexes are inserted at `\"...\"`, and duplicates keep their first\noccurrence. Regexes are duplicates when their text is identical after\njoining multiline entries with newlines.\n\nEach regex can be a single string or an array of strings joined with\nnewlines. The marker is recognized only as a top-level string. To use\n`...` as a regex matching three characters, write `[\"...\"]` as an entry.\nA `\"...\"` line inside a multiline entry is always regex text.\n\nThe optional named capture `path` selects the hyperlink target. Without\nit, the entire match is the target. With `path`, `line` and `column`\nspecify the position. Without a captured `line`, built-in suffix\nprocessing parses `line:column` and `(line,column)` variants. The optional\n`link` capture selects the clickable text, otherwise the entire match is\nclickable.\n\nProcessing stops at the first regex that matches the terminal line, even\nif the cursor is outside its clickable text. Put more specific regexes\nbefore broader ones. Regexes use Rust's `regex` syntax. Invalid regexes\nare logged and ignored. The `path_hyperlink_timeout_ms` setting controls\nthe discovery timeout. Setting it to `0` disables path hyperlinks."
msgstr "Expresiones regulares que se usan para identificar rutas para la navegación por hipervínculos.\n\nValor predeterminado:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUse `\"...\"` para agregar expresiones regulares sin repetir los valores predeterminados de ForgeKairos. En la configuración del proyecto, amplía el valor de la configuración de usuario o de la configuración superior. Omita `\"...\"` para reemplazar la lista heredada. Establezca `[]` para vaciarla. Si se omite esta opción, se conserva la lista heredada.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nLas expresiones regulares heredadas se insertan en `\"...\"` y, de los duplicados, se conserva la primera aparición. Dos expresiones regulares son duplicadas cuando su texto es idéntico tras unir con saltos de línea las entradas de varias líneas.\n\nCada expresión regular puede ser una sola cadena o una matriz de cadenas unidas con saltos de línea. El marcador solo se reconoce como cadena de nivel superior. Para usar `...` como expresión regular que coincide con tres caracteres, escriba `[\"...\"]` como entrada.\nUna línea `\"...\"` dentro de una entrada de varias líneas siempre es texto de la expresión regular.\n\nLa captura con nombre opcional `path` selecciona el destino del hipervínculo. Sin ella, el destino es toda la coincidencia. Con `path`, `line` y `column` especifican la posición. Si no se captura `line`, el procesamiento de sufijos integrado analiza las variantes `line:column` y `(line,column)`. La captura opcional `link` selecciona el texto en el que se puede hacer clic; de lo contrario, se puede hacer clic en toda la coincidencia.\n\nEl procesamiento se detiene en la primera expresión regular que coincide con la línea del terminal, aunque el cursor esté fuera de su texto en el que se puede hacer clic. Coloque las expresiones regulares más específicas antes que las más amplias. Las expresiones regulares usan la sintaxis de `regex` de Rust. Las expresiones regulares no válidas se registran y se ignoran. La opción `path_hyperlink_timeout_ms` controla el tiempo de espera de la detección. Establecerla en `0` deshabilita los hipervínculos de rutas."

msgctxt "settings schema"
msgid "Renamed version control color."
msgstr "Color para elementos con nombre cambiado en el control de versiones."

msgctxt "settings schema"
msgid "Render document colors as inlay hints near the color text."
msgstr "Representa los colores del documento como sugerencias insertadas junto al texto del color."

msgctxt "settings schema"
msgid "Replaces text before and after the cursor, using the `replace` range described in the LSP specification."
msgstr "Reemplaza el texto antes y después del cursor, usando el intervalo `replace` descrito en la especificación LSP."

msgctxt "settings schema"
msgid "Replaces text before the cursor, using the `insert` range described in the LSP specification."
msgstr "Reemplaza el texto antes del cursor, usando el intervalo `insert` descrito en la especificación LSP."

msgctxt "settings schema"
msgid "Replaces the grid with the text in the same tab."
msgstr "Reemplaza la cuadrícula por el texto en la misma pestaña."

msgctxt "settings schema"
msgid "Represents a hidden status, such as a file being hidden in a file tree."
msgstr "Representa un estado oculto, como un archivo oculto en un árbol de archivos."

msgctxt "settings schema"
msgid "Represents a renamed status, such as a file that has been renamed."
msgstr "Representa un estado de cambio de nombre, como un archivo al que se le ha cambiado el nombre."

msgctxt "settings schema"
msgid "Represents a warning status, like an operation that is about to fail."
msgstr "Representa un estado de advertencia, como una operación que está a punto de fallar."

msgctxt "settings schema"
msgid "Represents informational status updates or messages."
msgstr "Representa actualizaciones de estado o mensajes informativos."

msgctxt "settings schema"
msgid "Represents the selection of a theme, which can be either static or dynamic."
msgstr "Representa la selección de un tema, que puede ser estática o dinámica."

msgctxt "settings schema"
msgid "Represents the selection of an icon theme, which can be either static or dynamic."
msgstr "Representa la selección de un tema de iconos, que puede ser estática o dinámica."

msgctxt "settings schema"
msgid "Resize the window to cover the entire screen, including the menu bar and,\non notched displays, the area around the notch."
msgstr "Cambia el tamaño de la ventana para cubrir toda la pantalla, incluida la barra de menús y, en pantallas con muesca, el área alrededor de la muesca."

msgctxt "settings schema"
msgid "Restart clangd when its resident memory, measured every 30 seconds,\ngoes over this many megabytes. At most one restart every 10 minutes;\nafter that, a notification only. Unset never restarts. Read from the\nuser's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Reinicia clangd cuando su memoria residente, medida cada 30 segundos, supera este número de megabytes. Como máximo un reinicio cada 10 minutos; después, solo una notificación. Sin establecer, nunca se reinicia. Solo se lee de la configuración de usuario, no del `.zed/settings.json` de un proyecto.\n\nValor predeterminado: null"

msgctxt "settings schema"
msgid "Restore all workspaces that were open when quitting Zed."
msgstr "Restaura todas las áreas de trabajo que estaban abiertas al salir de ForgeKairos."

msgctxt "settings schema"
msgid "Restore the workspace that was closed last."
msgstr "Restaura el área de trabajo que se cerró en último lugar."

msgctxt "settings schema"
msgid "Rules for rendering LSP semantic tokens."
msgstr "Reglas para representar tokens semánticos de LSP."

msgctxt "settings schema"
msgid "Save after inactivity period of `milliseconds`."
msgstr "Guarda tras un periodo de inactividad de `milliseconds`."

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier for fast scrolling. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling. Fast scrolling\nhappens when a user holds the alt or option key while scrolling.\n\nDefault: 4.0"
msgstr "Multiplicador de sensibilidad para el desplazamiento rápido. Este multiplicador se aplica a los valores delta horizontal y vertical durante el desplazamiento. El desplazamiento rápido se produce cuando el usuario mantiene presionada la tecla alt u option mientras se desplaza.\n\nValor predeterminado: 4.0"

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling.\n\nDefault: 1.0"
msgstr "Multiplicador de sensibilidad del desplazamiento. Este multiplicador se aplica a los valores delta horizontal y vertical durante el desplazamiento.\n\nValor predeterminado: 1.0"

msgctxt "settings schema"
msgid "Scroll so the target appears near the top of the viewport."
msgstr "Desplaza para que el objetivo aparezca cerca de la parte superior del área visible."

msgctxt "settings schema"
msgid "Scroll the minimum amount needed to make the target visible."
msgstr "Desplaza solo lo necesario para que el destino sea visible."

msgctxt "settings schema"
msgid "Scrollbar related settings"
msgstr "Configuración relacionada con la barra de desplazamiento"

msgctxt "settings schema"
msgid "Scrollbar-related settings"
msgstr "Configuración relacionada con la barra de desplazamiento"

msgctxt "settings schema"
msgid "Select specific input audio device."
msgstr "Selecciona un dispositivo de entrada de audio específico."

msgctxt "settings schema"
msgid "Select specific output audio device."
msgstr "Selecciona un dispositivo de salida de audio específico."

msgctxt "settings schema"
msgid "Send anonymized usage data like what languages you're using Zed with.\n\nDefault: true"
msgstr "Enviar datos de uso anonimizados, como los lenguajes con los que usa ForgeKairos.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Send debug info like crash reports.\n\nDefault: true"
msgstr "Enviar información de depuración, como informes de errores.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Session log (TeraTerm-style output recording) settings."
msgstr "Configuración del registro de sesión (grabación de la salida al estilo de TeraTerm)."

msgctxt "settings schema"
msgid "Sets the cursor blinking behavior in the terminal.\n\nDefault: terminal_controlled"
msgstr "Establece el comportamiento del parpadeo del cursor en el terminal.\n\nValor predeterminado: terminal_controlled"

msgctxt "settings schema"
msgid "Sets the debounce threshold (in milliseconds) after which changes are reflected in the git gutter.\n\nDefault: 0"
msgstr "Establece el umbral de debounce (en milisegundos) tras el que los cambios se reflejan en el margen de git.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "Sets the terminal's font fallbacks.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font fallbacks."
msgstr "Establece las fuentes de reserva del terminal.\n\nSi no se incluye esta opción, el terminal usa de forma predeterminada las fuentes de reserva del búfer."

msgctxt "settings schema"
msgid "Sets the terminal's font family.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font family."
msgstr "Establece la familia de fuentes del terminal.\n\nSi no se incluye esta opción, el terminal usa de forma predeterminada la familia de fuentes del búfer."

msgctxt "settings schema"
msgid "Sets the terminal's font size.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font size."
msgstr "Establece el tamaño de fuente del terminal.\n\nSi no se incluye esta opción, el terminal usa de forma predeterminada el tamaño de fuente del búfer."

msgctxt "settings schema"
msgid "Sets the terminal's font weight in CSS weight units 0-900."
msgstr "Establece el peso de la fuente del terminal en unidades de peso CSS de 0 a 900."

msgctxt "settings schema"
msgid "Sets the terminal's line height.\n\nDefault: comfortable"
msgstr "Establece el alto de línea del terminal.\n\nValor predeterminado: comfortable"

msgctxt "settings schema"
msgid "Sets whether Alternate Scroll mode (code: ?1007) is active by default.\nAlternate Scroll mode converts mouse scroll events into up / down key\npresses when in the alternate screen (e.g. when running applications\nlike vim or  less). The terminal can still set and unset this mode.\n\nDefault: on"
msgstr "Establece si el modo Alternate Scroll (código: ?1007) está activo de forma predeterminada.\nEl modo Alternate Scroll convierte los eventos de desplazamiento del mouse en pulsaciones de las teclas arriba / abajo cuando se está en la pantalla alternativa (p. ej., al ejecutar aplicaciones como vim o less). El terminal todavía puede activar y desactivar este modo.\n\nValor predeterminado: on"

msgctxt "settings schema"
msgid "Sets whether the option key behaves as the meta key.\n\nDefault: false"
msgstr "Establece si la tecla option se comporta como la tecla meta.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Settings for associating file extensions and filenames\nwith languages."
msgstr "Configuración para asociar extensiones y nombres de archivo con lenguajes."

msgctxt "settings schema"
msgid "Settings for automatic agent context compaction, which summarizes\nearlier messages to free up room in the model's context window once the\ncontext grows too large."
msgstr "Configuración de la compactación automática del contexto del agente, que resume los mensajes anteriores para liberar espacio en la ventana de contexto del modelo cuando el contexto crece demasiado."

msgctxt "settings schema"
msgid "Settings for automatically opening files."
msgstr "Configuración para abrir archivos automáticamente."

msgctxt "settings schema"
msgid "Settings for configuring REPL display and behavior."
msgstr "Configuración de la visualización y el comportamiento del REPL."

msgctxt "settings schema"
msgid "Settings for configuring the which-key popup behaviour."
msgstr "Configuración del comportamiento de la ventana emergente de which-key."

msgctxt "settings schema"
msgid "Settings for context servers used for AI-related features."
msgstr "Configuración de los servidores de contexto usados para funciones relacionadas con IA."

msgctxt "settings schema"
msgid "Settings for developer-oriented instrumentation tools (profilers,\ntracers, etc.) that can be toggled at runtime."
msgstr "Configuración de las herramientas de instrumentación para desarrolladores (generadores de perfiles, trazadores, etc.) que se pueden alternar en tiempo de ejecución."

msgctxt "settings schema"
msgid "Settings for language server notifications"
msgstr "Configuración de las notificaciones del servidor de lenguaje"

msgctxt "settings schema"
msgid "Settings for showing inline diagnostics."
msgstr "Configuración para mostrar diagnósticos en línea."

msgctxt "settings schema"
msgid "Settings for sticking scopes to the top of the editor.\n\nDefault: sticky scroll is disabled"
msgstr "Configuración para fijar ámbitos en la parte superior del editor.\n\nValor predeterminado: el desplazamiento fijo está deshabilitado"

msgctxt "settings schema"
msgid "Settings for tabular files such as CSV and TSV."
msgstr "Configuración de los archivos tabulares, como CSV y TSV."

msgctxt "settings schema"
msgid "Settings for the built-in IDE server.\n\nThe server binds a random port on `127.0.0.1` only and never talks to the\nnetwork, so it is outside the scope of the egress allowlist."
msgstr "Configuración del servidor IDE integrado.\n\nEl servidor escucha solo en un puerto aleatorio de `127.0.0.1` y nunca se comunica con la red, por lo que queda fuera del ámbito de la lista de permitidos del tráfico saliente."

msgctxt "settings schema"
msgid "Settings for the built-in browser panel."
msgstr "Configuración del panel del navegador integrado."

msgctxt "settings schema"
msgid "Settings for the built-in loopback IDE server."
msgstr "Configuración del servidor IDE de loopback integrado."

msgctxt "settings schema"
msgid "Settings for the machine a remote project runs on, as opposed to the\nlists of connections next to them. Written under `\"remote\"` in\n`settings.json`, and carried to the remote host with the rest of the user\nsettings, which is where they take effect."
msgstr "Configuración del equipo en el que se ejecuta un proyecto remoto, a diferencia de las listas de conexiones que figuran junto a ella. Se escribe bajo `\"remote\"` en `settings.json` y se lleva al host remoto con el resto de la configuración de usuario, que es donde surte efecto."

msgctxt "settings schema"
msgid "Settings for the threads sidebar."
msgstr "Configuración de la barra lateral de conversaciones."

msgctxt "settings schema"
msgid "Settings for the which-key popup."
msgstr "Configuración de la ventana emergente de which-key."

msgctxt "settings schema"
msgid "Settings for using LSP pull diagnostics mechanism in Zed."
msgstr "Configuración para usar el mecanismo de diagnósticos pull de LSP en ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to Vim mode in Zed."
msgstr "Configuración relacionada con el modo Vim en ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to indent guides in the outline panel."
msgstr "Configuración relacionada con las guías de sangría en el panel de esquema."

msgctxt "settings schema"
msgid "Settings related to indent guides in the project panel."
msgstr "Configuración relacionada con las guías de sangría en el panel de proyecto."

msgctxt "settings schema"
msgid "Settings related to the command palette."
msgstr "Configuración relacionada con la paleta de comandos."

msgctxt "settings schema"
msgid "Settings related to the file finder."
msgstr "Configuración relacionada con el buscador de archivos."

msgctxt "settings schema"
msgid "Settings specific to Codestral."
msgstr "Configuración específica de Codestral."

msgctxt "settings schema"
msgid "Settings specific to GitHub Copilot."
msgstr "Configuración específica de GitHub Copilot."

msgctxt "settings schema"
msgid "Settings specific to Ollama."
msgstr "Configuración específica de Ollama."

msgctxt "settings schema"
msgid "Settings specific to Zed's Edit Predictions provider."
msgstr "Configuración específica del proveedor de predicciones de edición de Zed."

msgctxt "settings schema"
msgid "Settings specific to journaling"
msgstr "Configuración específica del diario"

msgctxt "settings schema"
msgid "Settings specific to the Mercury Edit Predictions provider."
msgstr "Configuración específica del proveedor de predicciones de edición de Mercury."

msgctxt "settings schema"
msgid "Settings specific to using custom OpenAI-compatible servers for edit prediction."
msgstr "Configuración específica para usar servidores personalizados compatibles con OpenAI para la predicción de edición."

msgctxt "settings schema"
msgid "Settings that apply to the host a remote project runs on."
msgstr "Configuración que se aplica al host en el que se ejecuta un proyecto remoto."

msgctxt "settings schema"
msgid "Settings-layer–free model mode enum.\n\nMirrors the shape of `settings_content::ModelMode` but lives here so that\ncrates below the settings layer can reference it."
msgstr "Enumeración del modo del modelo independiente de la capa de configuración.\n\nReproduce la forma de `settings_content::ModelMode`, pero está aquí para que las crates por debajo de la capa de configuración puedan hacer referencia a ella."

msgctxt "settings schema"
msgid "Settings-layer–free reasoning-effort enum.\n\nMirrors the shape of `settings_content::OpenAiReasoningEffort` but lives\nhere so that crates below the settings layer can reference it."
msgstr "Enumeración del nivel de razonamiento independiente de la capa de configuración.\n\nReproduce la forma de `settings_content::OpenAiReasoningEffort`, pero está aquí para que las crates por debajo de la capa de configuración puedan hacer referencia a ella."

msgctxt "settings schema"
msgid "Shell configuration to open the terminal with."
msgstr "Configuración del shell con el que se abre el terminal."

msgctxt "settings schema"
msgid "Show a disclosure chevron followed by a folder icon."
msgstr "Muestra una flecha de despliegue seguida de un icono de carpeta."

msgctxt "settings schema"
msgid "Show a disclosure chevron."
msgstr "Muestra una flecha de despliegue."

msgctxt "settings schema"
msgid "Show a folder icon."
msgstr "Muestra un icono de carpeta."

msgctxt "settings schema"
msgid "Show all diagnostic levels: hint, information, warnings, error."
msgstr "Muestra todos los niveles de diagnóstico: sugerencia, información, advertencias, error."

msgctxt "settings schema"
msgid "Show an empty untitled buffer when opening a new window"
msgstr "Muestra un búfer vacío sin título al abrir una ventana nueva"

msgctxt "settings schema"
msgid "Show diffs in a single unified view."
msgstr "Muestra diferencias en una única vista unificada."

msgctxt "settings schema"
msgid "Show diffs in a split view."
msgstr "Muestra diferencias en una vista dividida."

msgctxt "settings schema"
msgid "Show directories first, then files"
msgstr "Mostrar primero directorios y luego archivos"

msgctxt "settings schema"
msgid "Show file name first, then path"
msgstr "Mostrar primero el nombre de archivo y luego la ruta"

msgctxt "settings schema"
msgid "Show files first, then directories"
msgstr "Mostrar primero los archivos y luego los directorios"

msgctxt "settings schema"
msgid "Show full path first"
msgstr "Mostrar primero la ruta completa"

msgctxt "settings schema"
msgid "Show git blame in the status bar at the bottom of the window."
msgstr "Muestra Git blame en la barra de estado en la parte inferior de la ventana."

msgctxt "settings schema"
msgid "Show git blame inline at the current line."
msgstr "Muestra Git blame en línea en la línea actual."

msgctxt "settings schema"
msgid "Show git gutter in tracked files."
msgstr "Muestra el margen de Git en los archivos con seguimiento."

msgctxt "settings schema"
msgid "Show on all open editors."
msgstr "Muestra en todos los editores abiertos."

msgctxt "settings schema"
msgid "Show only the following diagnostic level: error."
msgstr "Muestra solo el siguiente nivel de diagnóstico: error."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: information, warning, error."
msgstr "Muestra solo los siguientes niveles de diagnóstico: información, advertencia, error."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: warning, error."
msgstr "Muestra solo los siguientes niveles de diagnóstico: advertencia, error."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects (no tabs)."
msgstr "Muestra Launchpad con proyectos recientes (sin pestañas)."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects when opening a new window"
msgstr "Muestra Launchpad con proyectos recientes al abrir una ventana nueva"

msgctxt "settings schema"
msgid "Show the minimap on the active editor only."
msgstr "Muestra el minimapa solo en el editor activo."

msgctxt "settings schema"
msgid "Show the minimap thumb only when the mouse is hovering over the minimap."
msgstr "Muestra el control deslizante del minimapa solo cuando el mouse pasa sobre el minimapa."

msgctxt "settings schema"
msgid "Show the scrollbar if there's important information or\nfollow the system's configured behavior."
msgstr "Mostrar la barra de desplazamiento si hay información importante o seguir el comportamiento configurado en el sistema."

msgctxt "settings schema"
msgid "Show unstaged hunks hollow and staged hunks with a filled background."
msgstr "Muestra los fragmentos sin preparar con contorno y los fragmentos preparados con fondo relleno."

msgctxt "settings schema"
msgid "Show unstaged hunks with a filled background and staged hunks hollow."
msgstr "Muestra los fragmentos sin preparar con fondo relleno y los fragmentos preparados con contorno."

msgctxt "settings schema"
msgid "Size of the border surrounding the active pane.\nWhen set to 0, the active pane doesn't have any border.\nThe border is drawn inset.\n\nDefault: `0.0`"
msgstr "Tamaño del borde que rodea el panel dividido activo.\nCon 0, el panel dividido activo no tiene ningún borde.\nEl borde se dibuja hacia dentro.\n\nValor predeterminado: `0.0`"

msgctxt "settings schema"
msgid "Soft wrap line at the preferred line length or the editor width (whichever is smaller)."
msgstr "Ajusta la línea a la longitud de línea preferida o al ancho del editor (lo que sea menor)."

msgctxt "settings schema"
msgid "Soft wrap lines that exceed the editor width."
msgstr "Ajusta las líneas que superan el ancho del editor."

msgctxt "settings schema"
msgid "Sort snippets normally using the default comparison logic"
msgstr "Ordena los fragmentos de código normalmente usando la lógica de comparación predeterminada"

msgctxt "settings schema"
msgid "Spacing between worktree entries in the project panel.\n\nDefault: comfortable"
msgstr "Espaciado entre las entradas del worktree en el panel de proyecto.\n\nValor predeterminado: comfortable"

msgctxt "settings schema"
msgid "Specifies the density of the UI.\nNote: This setting is still experimental. See [this tracking issue](https://github.com/zed-industries/zed/issues/18078)"
msgstr "Especifica la densidad de la interfaz.\nNota: esta opción todavía es experimental. Consulte [este issue de seguimiento](https://github.com/zed-industries/zed/issues/18078)"

msgctxt "settings schema"
msgid "Start searching as you type in project search, without pressing Enter."
msgstr "Empieza a buscar a medida que se escribe en la búsqueda del proyecto, sin presionar Enter."

msgctxt "settings schema"
msgid "Sticky scroll related settings"
msgstr "Configuración relacionada con el desplazamiento fijo"

msgctxt "settings schema"
msgid "String substituted for `${separator}` in the window title format.\nInclude any surrounding whitespace in the value.\n\nDefault: ` — `"
msgstr "Cadena que sustituye a `${separator}` en el formato del título de la ventana.\nIncluya en el valor los espacios en blanco que la rodeen.\n\nValor predeterminado: ` — `"

msgctxt "settings schema"
msgid "Suggesting and installing missing development tools."
msgstr "Sugerencia e instalación de las herramientas de desarrollo que faltan."

msgctxt "settings schema"
msgid "Suggestions of the development tools (language servers, formatters) that\nthe language of an opened file needs, when they are missing."
msgstr "Sugerencias de las herramientas de desarrollo (servidores de lenguaje, formateadores) que necesita el lenguaje de un archivo abierto, cuando faltan."

msgctxt "settings schema"
msgid "Supported reasoning effort levels, for example `[\"low\", \"medium\", \"high\"]."
msgstr "Niveles de esfuerzo de razonamiento admitidos, por ejemplo `[\"low\", \"medium\", \"high\"]."

msgctxt "settings schema"
msgid "TODO: this should just be a bool\nControls the behavior of formatting files when they are saved."
msgstr "TODO: this should just be a bool\nControla el comportamiento del formateo de los archivos al guardarlos."

msgctxt "settings schema"
msgid "Takes up the full width of the window"
msgstr "Ocupa todo el ancho de la ventana"

msgctxt "settings schema"
msgid "Task configuration for this language.\n\nDefault: {}"
msgstr "Configuración de tareas para este lenguaje.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "Terminal ANSI background color."
msgstr "Color de fondo ANSI del terminal."

msgctxt "settings schema"
msgid "Terminal background color."
msgstr "Color de fondo del terminal."

msgctxt "settings schema"
msgid "Terminal foreground color."
msgstr "Color de primer plano del terminal."

msgctxt "settings schema"
msgid "Text Color. Color of muted or deemphasized text. It is a subdued version of the standard text color."
msgstr "Color de texto. Color del texto atenuado o con menor énfasis. Es una versión discreta del color de texto estándar."

msgctxt "settings schema"
msgid "Text Color. Color of the placeholder text typically shown in input fields to guide the user to enter valid data."
msgstr "Color de texto. Color del texto de marcador de posición que se muestra habitualmente en los campos de entrada para guiar al usuario a escribir datos válidos."

msgctxt "settings schema"
msgid "Text Color. Color used for emphasis or highlighting certain text, like an active filter or a matched character in a search."
msgstr "Color de texto. Color usado para enfatizar o resaltar cierto texto, como un filtro activo o un carácter coincidente en una búsqueda."

msgctxt "settings schema"
msgid "Text Color. Color used for text denoting disabled elements. Typically, the color is faded or grayed out to emphasize the disabled state."
msgstr "Color de texto. Color usado para el texto que indica elementos deshabilitados. Normalmente, el color aparece desvaído o atenuado para enfatizar el estado deshabilitado."

msgctxt "settings schema"
msgid "Text Color. Default text color used for most text."
msgstr "Color de texto. Color de texto predeterminado usado para la mayoría del texto."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is highlighted."
msgstr "Color de texto. Se usa para el texto del número de línea en el margen del editor cuando la línea está resaltada."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is hovered over."
msgstr "Color de texto. Se usa para el texto del número de línea en el margen del editor al pasar el cursor sobre la línea."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter."
msgstr "Color de texto. Se usa para el texto del número de línea en el margen del editor."

msgctxt "settings schema"
msgid "Text Color. Used to mark invisible characters in the editor.\n\nExample: spaces, tabs, carriage returns, etc."
msgstr "Color del texto. Se usa para marcar los caracteres invisibles en el editor.\n\nEjemplo: espacios, tabulaciones, retornos de carro, etc."

msgctxt "settings schema"
msgid "Text color used for CodeLens items in the editor."
msgstr "Color de texto usado para los elementos de CodeLens en el editor."

msgctxt "settings schema"
msgid "The AI browser panel, which holds the AI tabs that AI agents drive."
msgstr "El panel del navegador de IA, que contiene las pestañas de IA que manejan los agentes de IA."

msgctxt "settings schema"
msgid "The API protocol to use for this model: \"anthropic\", \"openai_responses\", \"openai_chat\", or \"google\". Defaults to \"openai_chat\"."
msgstr "El protocolo de API que se usará para este modelo: \"anthropic\", \"openai_responses\", \"openai_chat\" o \"google\". El valor predeterminado es \"openai_chat\"."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka n_ctx)."
msgstr "El parámetro de longitud de contexto del modelo (también conocido como n_ctx)."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka num_ctx or n_ctx)"
msgstr "El parámetro de longitud de contexto del modelo (también conocido como num_ctx o n_ctx)"

msgctxt "settings schema"
msgid "The HTTPS host the account's token signs in to, such as `github.com`.\nWithout one, pushing and pulling sign in as git is configured to."
msgstr "El host HTTPS en el que inicia sesión el token de la cuenta, como `github.com`.\nSi no se indica, el push y el pull inician sesión según la configuración de git."

msgctxt "settings schema"
msgid "The OAuth client ID obtained from out-of-band registration with the\nauthorization server."
msgstr "El ID de cliente OAuth obtenido mediante el registro fuera de banda en el servidor de autorización."

msgctxt "settings schema"
msgid "The OAuth client secret, if this is a confidential client. For security,\nprefer providing this interactively; we will prompt and store it in\nthe system keychain."
msgstr "El secreto de cliente OAuth, si se trata de un cliente confidencial. Por seguridad, es preferible proporcionarlo de forma interactiva; se solicitará y se guardará en el llavero del sistema."

msgctxt "settings schema"
msgid "The OpenAI Chat Completions API (`/chat/completions`)."
msgstr "La API de OpenAI Chat Completions (`/chat/completions`)."

msgctxt "settings schema"
msgid "The OpenAI Responses API (`/responses`)."
msgstr "La API de OpenAI Responses (`/responses`)."

msgctxt "settings schema"
msgid "The OpenAI-compatible API this model must be called through."
msgstr "La API compatible con OpenAI a través de la cual se debe llamar a este modelo."

msgctxt "settings schema"
msgid "The OpenType features to enable for rendering in text buffers."
msgstr "Las características de OpenType que se habilitarán para la representación en búferes de texto."

msgctxt "settings schema"
msgid "The OpenType features to enable for text in the UI."
msgstr "Las características de OpenType que se habilitarán para el texto en la interfaz de usuario."

msgctxt "settings schema"
msgid "The SHA of the commit to apply."
msgstr "El SHA del commit que se aplica."

msgctxt "settings schema"
msgid "The SHA of the commit to check out."
msgstr "El SHA del commit del que se hace checkout."

msgctxt "settings schema"
msgid "The SHA of the commit to put the changes into."
msgstr "El SHA del commit en el que se incorporan los cambios."

msgctxt "settings schema"
msgid "The SHA of the commit to remove."
msgstr "El SHA del commit que se quita."

msgctxt "settings schema"
msgid "The SHA of the commit to reset to."
msgstr "El SHA del commit al que se restablece."

msgctxt "settings schema"
msgid "The SHA of the commit to start the branch from."
msgstr "El SHA del commit desde el que se inicia la rama."

msgctxt "settings schema"
msgid "The SHA of the commit to tag."
msgstr "El SHA del commit que se etiqueta."

msgctxt "settings schema"
msgid "The SHA of the commit to undo."
msgstr "El SHA del commit que se deshace."

msgctxt "settings schema"
msgid "The SHA of the commit whose message to rewrite."
msgstr "El SHA del commit cuyo mensaje se reescribe."

msgctxt "settings schema"
msgid "The SHA of the commit."
msgstr "El SHA del commit."

msgctxt "settings schema"
msgid "The URL of the Zed server to connect to."
msgstr "La URL del servidor de Zed al que conectarse."

msgctxt "settings schema"
msgid "The URL of the remote context server."
msgstr "La URL del servidor de contexto remoto."

msgctxt "settings schema"
msgid "The URL template used by `browser_panel::AskCopilot`. `{query}` is\nreplaced with the percent-encoded query when present; without the\nplaceholder the page is opened as-is and the query is put on the\nclipboard instead.\n\nDefault: https://github.com/copilot"
msgstr "La plantilla de URL que usa `browser_panel::AskCopilot`. `{query}` se reemplaza por la consulta codificada con porcentajes si está presente; sin el marcador de posición, la página se abre tal cual y la consulta se coloca en el portapapeles.\n\nValor predeterminado: https://github.com/copilot"

msgctxt "settings schema"
msgid "The URL template used when the address bar input is not a URL, and for\n`browser_panel::SearchSelection`. `{query}` is replaced with the\npercent-encoded query.\n\nDefault: https://www.google.com/search?q={query}"
msgstr "La plantilla de URL que se usa cuando lo escrito en la barra de direcciones no es una URL, y para `browser_panel::SearchSelection`. `{query}` se reemplaza por la consulta codificada con porcentajes.\n\nValor predeterminado: https://www.google.com/search?q={query}"

msgctxt "settings schema"
msgid "The URL used as the key for credential storage.\n\nWhen set, credentials are stored under this URL instead of `server_url`.\nThis allows running multiple Zed instances side by side without them\noverwriting each other's keychain entries."
msgstr "La URL que se usa como clave para el almacenamiento de credenciales.\n\nSi se establece, las credenciales se guardan bajo esta URL en lugar de `server_url`.\nEsto permite ejecutar varias instancias de ForgeKairos a la vez sin que sobrescriban las entradas del llavero de las demás."

msgctxt "settings schema"
msgid "The account each repository commits and pushes as, by the absolute path of\nthe repository's working directory. A repository not listed here uses git's\nown configuration. Only read from the user settings file.\n\nDefault: {}"
msgstr "La cuenta con la que cada repositorio hace commit y push, según la ruta absoluta del directorio de trabajo del repositorio. Un repositorio que no figure aquí usa la configuración propia de Git. Solo se lee del archivo de configuración de usuario.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "The alt key\nSometimes also known as the 'meta' key"
msgstr "La tecla alt\nA veces también se conoce como la tecla 'meta'"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline blame in units of columns.\n\nDefault: 7"
msgstr "La cantidad de relleno, en columnas, entre el final de la línea de código y el inicio de la autoría en línea.\n\nValor predeterminado: 7"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline diagnostic in units of columns.\n\nDefault: 4"
msgstr "La cantidad de relleno, en columnas, entre el final de la línea de código y el inicio del diagnóstico en línea.\n\nValor predeterminado: 4"

msgctxt "settings schema"
msgid "The arguments to pass to the command. Use `*` for a single wildcard argument.\nIf the last element is `**`, then any trailing arguments are allowed."
msgstr "Los argumentos que se pasan al comando. Use `*` para un único argumento comodín.\nSi el último elemento es `**`, se permite cualquier argumento final."

msgctxt "settings schema"
msgid "The arguments to pass to the program."
msgstr "Los argumentos que se pasan al programa."

msgctxt "settings schema"
msgid "The arguments to pass to the program.\n\nSupported placeholders:\n\n- `{buffer_path}`: the path of the buffer being formatted, or\n  `Untitled` when it has never been saved.\n- `{start_line}` and `{end_line}`: the first and last line of a\n  selected range, 1-based and inclusive. An argument naming either\n  of them is repeated once per selected range when formatting\n  selections (e.g. `\"--lines={start_line}:{end_line}\"` for\n  clang-format), and is dropped when formatting the whole buffer.\n  Naming them is also what marks the command as able to format\n  selections at all."
msgstr "Los argumentos que se pasan al programa.\n\nMarcadores de posición admitidos:\n\n- `{buffer_path}`: la ruta del búfer que se formatea, o `Untitled` si nunca se ha guardado.\n- `{start_line}` y `{end_line}`: la primera y la última línea de un intervalo seleccionado, contadas desde 1 e incluidas. Un argumento que mencione cualquiera de ellos se repite una vez por cada intervalo seleccionado al formatear selecciones (p. ej., `\"--lines={start_line}:{end_line}\"` para clang-format), y se omite al formatear el búfer completo.\n  Mencionarlos es también lo que indica que el comando puede formatear selecciones."

msgctxt "settings schema"
msgid "The author and committer email (`user.email`)."
msgstr "El correo electrónico del autor y del committer (`user.email`)."

msgctxt "settings schema"
msgid "The author and committer name (`user.name`)."
msgstr "El nombre del autor y del committer (`user.name`)."

msgctxt "settings schema"
msgid "The available agent profiles."
msgstr "Los perfiles de agente disponibles."

msgctxt "settings schema"
msgid "The background appearance of the window."
msgstr "El aspecto del fondo de la ventana."

msgctxt "settings schema"
msgid "The background color of the scrollbar track."
msgstr "El color de fondo de la pista de la barra de desplazamiento."

msgctxt "settings schema"
msgid "The base URL for the provider (e.g., \"https://code.corp.big.com\")."
msgstr "La URL base del proveedor (p. ej., \"https://code.corp.big.com\")."

msgctxt "settings schema"
msgid "The behavior of `editor::Rewrap`."
msgstr "El comportamiento de `editor::Rewrap`."

msgctxt "settings schema"
msgid "The border color of the minimap thumb."
msgstr "El color del borde del control del minimapa."

msgctxt "settings schema"
msgid "The border color of the scrollbar thumb."
msgstr "El color del borde del control de la barra de desplazamiento."

msgctxt "settings schema"
msgid "The border color of the scrollbar track."
msgstr "El color del borde de la pista de la barra de desplazamiento."

msgctxt "settings schema"
msgid "The buffer's line height."
msgstr "El alto de línea del búfer."

msgctxt "settings schema"
msgid "The capabilities granted to extensions."
msgstr "Las capacidades concedidas a las extensiones."

msgctxt "settings schema"
msgid "The color of the minimap thumb when hovered over."
msgstr "El color del control del minimapa al pasar el cursor por encima."

msgctxt "settings schema"
msgid "The color of the minimap thumb whilst being actively dragged."
msgstr "El color del control del minimapa mientras se arrastra activamente."

msgctxt "settings schema"
msgid "The color of the minimap thumb."
msgstr "El color del control del minimapa."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb when hovered over."
msgstr "El color del control de la barra de desplazamiento al pasar el cursor por encima."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb whilst being actively dragged."
msgstr "El color del control de la barra de desplazamiento mientras se arrastra activamente."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb."
msgstr "El color del control de la barra de desplazamiento."

msgctxt "settings schema"
msgid "The column at which to soft-wrap lines, for buffers where soft-wrap\nis enabled.\n\nDefault: 80"
msgstr "La columna en la que se ajustan las líneas, en los búferes con el ajuste de línea habilitado.\n\nValor predeterminado: 80"

msgctxt "settings schema"
msgid "The command key, on macos\nthe windows key, on windows\nthe super key, on linux"
msgstr "La tecla command, en macOS\nla tecla Windows, en Windows\nla tecla super, en Linux"

msgctxt "settings schema"
msgid "The command to execute."
msgstr "El comando que se va a ejecutar."

msgctxt "settings schema"
msgid "The content of a serialized theme."
msgstr "El contenido de un tema serializado."

msgctxt "settings schema"
msgid "The contents of the edit prediction settings."
msgstr "El contenido de la configuración de predicción de edición."

msgctxt "settings schema"
msgid "The control key"
msgstr "La tecla Control"

msgctxt "settings schema"
msgid "The debounce delay before querying highlights from the language\nserver based on the current cursor location.\n\nDefault: 75"
msgstr "El retardo de debounce antes de consultar al servidor de lenguaje los resaltados según la posición actual del cursor.\n\nValor predeterminado: 75"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 0"
msgstr "El retardo de debounce, en milisegundos, antes de solicitar automáticamente una predicción cuando se deja de escribir. Establézcalo en 0 para solicitar predicciones de inmediato.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 150"
msgstr "El retardo de debounce, en milisegundos, antes de solicitar automáticamente una predicción cuando se deja de escribir. Establézcalo en 0 para solicitar predicciones de inmediato.\n\nValor predeterminado: 150"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 75"
msgstr "El retardo de debounce, en milisegundos, antes de solicitar automáticamente una predicción cuando se deja de escribir. Establézcalo en 0 para solicitar predicciones de inmediato.\n\nValor predeterminado: 75"

msgctxt "settings schema"
msgid "The default UI density."
msgstr "La densidad predeterminada de la interfaz de usuario."

msgctxt "settings schema"
msgid "The default behavior when opening paths from the CLI without\nan explicit `-e` or `-n` flag.\n\nDefault: existing_window"
msgstr "El comportamiento predeterminado al abrir rutas desde la CLI sin una opción `-e` o `-n` explícita.\n\nValor predeterminado: existing_window"

msgctxt "settings schema"
msgid "The default behavior when opening projects from the UI.\n\nDefault: existing_window"
msgstr "El comportamiento predeterminado al abrir proyectos desde la interfaz.\n\nValor predeterminado: existing_window"

msgctxt "settings schema"
msgid "The default font size for rendering in text buffers."
msgstr "El tamaño de fuente predeterminado para la representación en búferes de texto."

msgctxt "settings schema"
msgid "The default font size for text in the UI."
msgstr "El tamaño de fuente predeterminado del texto en la interfaz de usuario."

msgctxt "settings schema"
msgid "The default language model selected when using this profile."
msgstr "El modelo de lenguaje predeterminado seleccionado al usar este perfil."

msgctxt "settings schema"
msgid "The default line height."
msgstr "El alto de línea predeterminado."

msgctxt "settings schema"
msgid "The default mode to use for this agent.\n\nNote: Not only all agents support modes.\n\nDefault: None"
msgstr "El modo predeterminado que se usa para este agente.\n\nNota: no todos los agentes admiten modos.\n\nValor predeterminado: None"

msgctxt "settings schema"
msgid "The default model to use when creating new chats and for other features when a specific model is not specified."
msgstr "El modelo predeterminado que se usa al crear chats nuevos y para otras funciones cuando no se especifica un modelo concreto."

msgctxt "settings schema"
msgid "The default profile to use in the Agent.\n\nDefault: write"
msgstr "El perfil predeterminado que se usa en el agente.\n\nValor predeterminado: write"

msgctxt "settings schema"
msgid "The default temperature to use for this model."
msgstr "La temperatura predeterminada que se usa para este modelo."

msgctxt "settings schema"
msgid "The delay in milliseconds that must elapse before drag and drop is allowed. Otherwise, a new text selection is created.\n\nDefault: 300"
msgstr "El retraso, en milisegundos, que debe transcurrir antes de permitir arrastrar y colocar. De lo contrario, se crea una nueva selección de texto.\n\nValor predeterminado: 300"

msgctxt "settings schema"
msgid "The display name for the provider (e.g., \"BigCorp GitHub\")."
msgstr "El nombre para mostrar del proveedor (p. ej., \"BigCorp GitHub\")."

msgctxt "settings schema"
msgid "The dock position of the debug panel\n\nDefault: Bottom"
msgstr "La posición del panel de depuración en el dock\n\nValor predeterminado: Bottom"

msgctxt "settings schema"
msgid "The edit prediction settings."
msgstr "La configuración de predicción de edición."

msgctxt "settings schema"
msgid "The editor will not scroll beyond the last line."
msgstr "El editor no se desplazará más allá de la última línea."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by one page."
msgstr "El editor se desplazará una página más allá de la última línea."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by the same number of lines as vertical_scroll_margin."
msgstr "El editor se desplazará más allá de la última línea tantas líneas como indique vertical_scroll_margin."

msgctxt "settings schema"
msgid "The extensions that should be automatically installed by Zed.\n\nThis is used to make functionality provided by extensions (e.g., language support)\navailable out-of-the-box.\n\nDefault: {}"
msgstr "Las extensiones que ForgeKairos debe instalar automáticamente.\n\nSe usa para que la funcionalidad proporcionada por extensiones (p. ej., la compatibilidad con lenguajes) esté disponible de inmediato.\n\nValor predeterminado: {}"

msgctxt "settings schema"
msgid "The external program to run."
msgstr "El programa externo que se va a ejecutar."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in text buffers."
msgstr "Las fuentes de reserva que se usan para la representación en búferes de texto."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in the UI."
msgstr "Las fuentes de reserva que se usan para la representación en la interfaz de usuario."

msgctxt "settings schema"
msgid "The font size for agent responses in the agent panel. Falls back to the UI font size if unset."
msgstr "El tamaño de fuente de las respuestas del agente en el panel del agente. Recurre al tamaño de fuente de la interfaz de usuario si no se establece."

msgctxt "settings schema"
msgid "The font size for user messages in the agent panel."
msgstr "El tamaño de fuente de los mensajes del usuario en el panel del agente."

msgctxt "settings schema"
msgid "The font size to use for rendering in the markdown preview.\nFalls back to the UI font size if unset."
msgstr "El tamaño de fuente que se usa para la representación en la vista previa de Markdown.\nSi no se establece, se usa el tamaño de fuente de la interfaz."

msgctxt "settings schema"
msgid "The function key"
msgstr "La tecla Fn"

msgctxt "settings schema"
msgid "The granularity of one 'step' in the stepping requests `next`, `stepIn`, `stepOut`, and `stepBack`."
msgstr "La granularidad de un 'paso' en las solicitudes de paso `next`, `stepIn`, `stepOut` y `stepBack`."

msgctxt "settings schema"
msgid "The guardrail identifier (ARN or ID) to apply to Bedrock API requests."
msgstr "El identificador de la barrera de protección (ARN o ID) que se aplicará a las solicitudes de la API de Bedrock."

msgctxt "settings schema"
msgid "The guardrail version to use. Defaults to \"DRAFT\" if not specified."
msgstr "La versión de la barrera de protección que se usará. Se establece en \"DRAFT\" de forma predeterminada si no se especifica."

msgctxt "settings schema"
msgid "The icon theme to use for dark mode."
msgstr "El tema de iconos que se usará en el modo oscuro."

msgctxt "settings schema"
msgid "The icon theme to use for light mode."
msgstr "El tema de iconos que se usará en el modo claro."

msgctxt "settings schema"
msgid "The key commits are signed with (`user.signingkey`), when signing is on."
msgstr "La clave con la que se firman los commits (`user.signingkey`), cuando la firma está activada."

msgctxt "settings schema"
msgid "The key to use for adding multiple cursors\n\nDefault: alt"
msgstr "La tecla que se usa para agregar varios cursores\n\nValor predeterminado: alt"

msgctxt "settings schema"
msgid "The language of the UI: \"system\" to follow the operating system, or a BCP 47\ntag such as \"en\", \"ja\" or \"pt-BR\".\n\nDefault: \"system\""
msgstr "El idioma de la interfaz: \"system\" para seguir el sistema operativo, o una etiqueta BCP 47 como \"en\", \"ja\" o \"pt-BR\".\n\nValor predeterminado: \"system\""

msgctxt "settings schema"
msgid "The language server and, in C and C++, the symbol index."
msgstr "El servidor de lenguaje y, en C y C++, el índice de símbolos."

msgctxt "settings schema"
msgid "The layout of window control buttons as represented by user settings.\n\nCustom layout strings use the GNOME `button-layout` format (e.g.\n`\"close:minimize,maximize\"`)."
msgstr "El diseño de los botones de control de la ventana tal como se representa en la configuración de usuario.\n\nLas cadenas de diseño personalizadas usan el formato `button-layout` de GNOME (p. ej., `\"close:minimize,maximize\"`)."

msgctxt "settings schema"
msgid "The layout of window control buttons in the title bar (Linux only).\n\nThis can be set to \"platform_default\" to follow the system configuration, or\n\"standard\" to use Zed's built-in layout. For custom layouts, use a\nGNOME-style layout string like \"close:minimize,maximize\".\n\nDefault: \"platform_default\""
msgstr "El diseño de los botones de control de la ventana en la barra de título (solo Linux).\n\nSe puede establecer en \"platform_default\" para seguir la configuración del sistema, o en \"standard\" para usar el diseño integrado de ForgeKairos. Para diseños personalizados, use una cadena de diseño de estilo GNOME como \"close:minimize,maximize\".\n\nValor predeterminado: \"platform_default\""

msgctxt "settings schema"
msgid "The list of custom Git hosting providers."
msgstr "La lista de proveedores personalizados de alojamiento de Git."

msgctxt "settings schema"
msgid "The list of language servers to use (or disable) for this language.\n\nThis array should consist of language server IDs, as well as the following\nspecial tokens:\n- `\"!<language_server_id>\"` - A language server ID prefixed with a `!` will be disabled.\n- `\"...\"` - A placeholder to refer to the **rest** of the registered language servers for this language.\n\nDefault: [\"...\"]"
msgstr "La lista de servidores de lenguaje que se usan (o se deshabilitan) para este lenguaje.\n\nEsta matriz debe contener ID de servidores de lenguaje, así como los siguientes tokens especiales:\n- `\"!<language_server_id>\"`: un ID de servidor de lenguaje precedido por `!` se deshabilita.\n- `\"...\"`: un marcador de posición que hace referencia al **resto** de los servidores de lenguaje registrados para este lenguaje.\n\nValor predeterminado: [\"...\"]"

msgctxt "settings schema"
msgid "The maximum amount of time to wait for responses from language servers, in seconds.\nA value of `0` will result in no timeout being applied (causing all LSP responses to wait indefinitely until completed).\n\nDefault: `120`"
msgstr "El tiempo máximo de espera de las respuestas de los servidores de lenguaje, en segundos.\nUn valor de `0` hace que no se aplique ningún tiempo de espera (todas las respuestas de LSP esperan indefinidamente hasta completarse).\n\nValor predeterminado: `120`"

msgctxt "settings schema"
msgid "The maximum line length a buffer may contain before language server features are disabled for the entire buffer.\n\nDefault: `20000`"
msgstr "La longitud máxima de línea que puede contener un búfer antes de que se deshabiliten las funciones del servidor de lenguaje para todo el búfer.\n\nValor predeterminado: `20000`"

msgctxt "settings schema"
msgid "The maximum number of completion tokens allowed by the model (o1-* only)"
msgstr "El número máximo de tokens de generación permitidos por el modelo (solo o1-*)"

msgctxt "settings schema"
msgid "The maximum number of lines to keep in the scrollback history.\nMaximum allowed value is 100_000, all values above that will be treated as 100_000.\n0 disables the scrolling.\nExisting terminals will not pick up this change until they are recreated.\nSee <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">Alacritty documentation</a> for more information.\n\nDefault: 10_000"
msgstr "El número máximo de líneas que se conservan en el historial de desplazamiento.\nEl valor máximo permitido es 100_000; cualquier valor superior se trata como 100_000.\n0 deshabilita el desplazamiento.\nLos terminales existentes no aplican este cambio hasta que se vuelven a crear.\nConsulte la <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">documentación de Alacritty</a> para obtener más información.\n\nValor predeterminado: 10_000"

msgctxt "settings schema"
msgid "The maximum number of output tokens allowed by the model."
msgstr "El número máximo de tokens de salida permitidos por el modelo."

msgctxt "settings schema"
msgid "The maximum width, in pixels, of the rendered markdown content when\n`limit_content_width` is enabled.\n\nDefault: 800"
msgstr "El ancho máximo, en píxeles, del contenido Markdown representado cuando `limit_content_width` está habilitado.\n\nValor predeterminado: 800"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast between foreground and background colors.\n\nAPCA (Accessible Perceptual Contrast Algorithm) is more accurate than WCAG 2.x,\nespecially for dark mode. Values range from 0 to 106.\n\nBased on APCA Readability Criterion (ARC) Bronze Simple Mode:\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: No contrast adjustment\n- 45: Minimum for large fluent text (36px+)\n- 60: Minimum for other content text\n- 75: Minimum for body text\n- 90: Preferred for body text\n\nDefault: 45"
msgstr "El contraste perceptual APCA mínimo entre los colores de primer plano y de fondo.\n\nAPCA (Accessible Perceptual Contrast Algorithm) es más preciso que WCAG 2.x, especialmente en el modo oscuro. Los valores van de 0 a 106.\n\nBasado en el modo Bronze Simple de APCA Readability Criterion (ARC):\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: sin ajuste de contraste\n- 45: mínimo para texto fluido grande (36px o más)\n- 60: mínimo para el resto del texto de contenido\n- 75: mínimo para el texto del cuerpo\n- 90: preferido para el texto del cuerpo\n\nValor predeterminado: 45"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast to maintain when\nrendering text over highlight backgrounds in the editor.\n\nValues range from 0 to 106. Set to 0 to disable adjustments.\nDefault: 45"
msgstr "El contraste perceptual APCA mínimo que se mantiene al representar texto sobre fondos resaltados en el editor.\n\nLos valores van de 0 a 106. Establézcalo en 0 para deshabilitar los ajustes.\nValor predeterminado: 45"

msgctxt "settings schema"
msgid "The minimum column number to show the inline blame information at\n\nDefault: 0"
msgstr "El número de columna mínimo en el que se muestra la información de autoría en línea\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "The minimum column to display inline diagnostics. This setting can be\nused to horizontally align inline diagnostics at some position. Lines\nlonger than this value will still push diagnostics further to the right.\n\nDefault: 0"
msgstr "La columna mínima en la que se muestran los diagnósticos en línea. Esta opción sirve para alinear horizontalmente los diagnósticos en línea en una posición. Las líneas más largas que este valor seguirán desplazando los diagnósticos más a la derecha.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "The minimum width (in em-widths) at which the split diff view is used.\nWhen the editor is narrower than this, the diff view automatically\nswitches to unified mode and switches back when the editor is wide\nenough. Set to 0 to disable automatic switching.\n\nDefault: 100"
msgstr "El ancho mínimo (en anchos de em) a partir del cual se usa la vista de diferencias dividida.\nCuando el editor es más estrecho, la vista de diferencias cambia automáticamente al modo unificado y vuelve al dividido cuando el editor es lo bastante ancho. Establézcalo en 0 para deshabilitar el cambio automático.\n\nValor predeterminado: 100"

msgctxt "settings schema"
msgid "The mode in which edit predictions should be displayed."
msgstr "El modo en el que se muestran las predicciones de edición."

msgctxt "settings schema"
msgid "The mode use to select a theme.\n\n`Light` and `Dark` will select their respective themes.\n\n`System` will select the theme based on the system's appearance."
msgstr "El modo que se usa para seleccionar un tema.\n\n`Light` y `Dark` seleccionan sus respectivos temas.\n\n`System` selecciona el tema según la apariencia del sistema."

msgctxt "settings schema"
msgid "The mode used to determine which theme to use."
msgstr "El modo usado para determinar qué tema se usará."

msgctxt "settings schema"
msgid "The mode used to display edit predictions in the buffer.\nProvider support required."
msgstr "El modo que se usa para mostrar las predicciones de edición en el búfer.\nRequiere compatibilidad del proveedor."

msgctxt "settings schema"
msgid "The model id as expected in Bedrock Mantle request bodies, e.g. `openai.gpt-5.5`."
msgstr "El ID del modelo esperado en los cuerpos de las solicitudes de Bedrock Mantle, p. ej., `openai.gpt-5.5`."

msgctxt "settings schema"
msgid "The model id reported by the llama.cpp server (its `--alias` or the model file path)."
msgstr "El ID del modelo indicado por el servidor de llama.cpp (su `--alias` o la ruta del archivo del modelo)."

msgctxt "settings schema"
msgid "The model name in the Ollama API (e.g. \"llama3.2:latest\")"
msgstr "El nombre del modelo en la API de Ollama (p. ej., \"llama3.2:latest\")"

msgctxt "settings schema"
msgid "The model to use for subagents spawned via the `spawn_agent` tool. Defaults to the parent agent's model when not specified."
msgstr "El modelo que se usará para los subagentes generados mediante la herramienta `spawn_agent`. Si no se especifica, se usa de forma predeterminada el modelo del agente padre."

msgctxt "settings schema"
msgid "The model's context window size."
msgstr "El tamaño de la ventana de contexto del modelo."

msgctxt "settings schema"
msgid "The model's mode (e.g. thinking)"
msgstr "El modo del modelo (p. ej., thinking)"

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the agent panel."
msgstr "El nombre del modelo en la interfaz de ForgeKairos, como en el menú desplegable del selector de modelos del panel del agente."

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the assistant panel."
msgstr "El nombre del modelo en la interfaz de ForgeKairos, por ejemplo en el menú desplegable del selector de modelos del panel del asistente."

msgctxt "settings schema"
msgid "The model's name in the Anthropic API. e.g. claude-3-5-sonnet-latest, claude-3-opus-20240229, etc"
msgstr "El nombre del modelo en la API de Anthropic, p. ej., claude-3-5-sonnet-latest, claude-3-opus-20240229, etc."

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-20240620"
msgstr "El nombre del modelo en la API del proveedor, p. ej., claude-3-5-sonnet-20240620"

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-latest"
msgstr "El nombre del modelo en la API del proveedor, p. ej., claude-3-5-sonnet-latest"

msgctxt "settings schema"
msgid "The multiplier for scrolling with the mouse wheel.\n\nDefault: 1.0"
msgstr "El multiplicador del desplazamiento con la rueda del mouse.\n\nValor predeterminado: 1.0"

msgctxt "settings schema"
msgid "The name displayed in the UI, such as in the agent panel model dropdown menu."
msgstr "El nombre que se muestra en la interfaz, como en el menú desplegable de modelos del panel del agente."

msgctxt "settings schema"
msgid "The name of a font to use for agent responses in the agent panel. Falls back to the UI font if unset."
msgstr "El nombre de una fuente que se usará para las respuestas del agente en el panel del agente. Usa la fuente de la interfaz como alternativa si no se establece."

msgctxt "settings schema"
msgid "The name of a font to use for code (code blocks and inline code) in the\nmarkdown preview. Falls back to the buffer font if unset."
msgstr "El nombre de la fuente que se usa para el código (bloques de código y código en línea) en la vista previa de Markdown. Si no se establece, se usa la fuente del búfer."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in text buffers."
msgstr "El nombre de una fuente que se usará para la representación en búferes de texto."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the UI."
msgstr "El nombre de una fuente que se usará para la representación en la interfaz."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the markdown preview.\nFalls back to the UI font if unset."
msgstr "El nombre de la fuente que se usa para la representación en la vista previa de Markdown.\nSi no se establece, se usa la fuente de la interfaz."

msgctxt "settings schema"
msgid "The name of a font to use for user messages in the agent panel. Falls back to the buffer font if unset."
msgstr "El nombre de una fuente que se usará para los mensajes de usuario en el panel del agente. Usa la fuente del búfer como alternativa si no se establece."

msgctxt "settings schema"
msgid "The name of the Zed theme to use."
msgstr "El nombre del tema de ForgeKairos que se usará."

msgctxt "settings schema"
msgid "The name of the icon theme to use."
msgstr "El nombre del tema de iconos que se usará."

msgctxt "settings schema"
msgid "The name of the language server to format with"
msgstr "El nombre del servidor de lenguaje con el que se aplica formato"

msgctxt "settings schema"
msgid "The name of the model.\n\nDefault: \"\""
msgstr "El nombre del modelo.\n\nValor predeterminado: \"\""

msgctxt "settings schema"
msgid "The name the account is picked by, unique among the accounts."
msgstr "El nombre con el que se elige la cuenta, único entre las cuentas."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files, which answers\nproject-wide symbol search, \"go to definition\" when the language server has\nno answer, and callers and callees, without compilation information."
msgstr "El índice de símbolos por nombre de los archivos C y C++, que responde a la búsqueda de símbolos en todo el proyecto, a \"ir a la definición\" cuando el servidor de lenguaje no tiene respuesta, y a los llamadores y llamados, sin información de compilación."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files."
msgstr "El índice de símbolos por nombre de los archivos C y C++."

msgctxt "settings schema"
msgid "The number of characters to keep on either side when scrolling with the mouse.\n\nDefault: 5."
msgstr "El número de caracteres que se mantienen a cada lado al desplazarse con el mouse.\n\nValor predeterminado: 5."

msgctxt "settings schema"
msgid "The number of lines to keep above/below the cursor when auto-scrolling.\n\nDefault: 3."
msgstr "El número de líneas que se mantienen por encima y por debajo del cursor al desplazarse automáticamente.\n\nValor predeterminado: 3."

msgctxt "settings schema"
msgid "The number of seconds to keep the connection open after the last request"
msgstr "El número de segundos que se mantendrá abierta la conexión después de la última solicitud"

msgctxt "settings schema"
msgid "The page opened when a built-in browser panel or tab first loads.\n\nDefault: https://m365.cloud.microsoft/chat"
msgstr "La página que se abre cuando un panel o una pestaña del navegador integrado se carga por primera vez.\n\nValor predeterminado: https://m365.cloud.microsoft/chat"

msgctxt "settings schema"
msgid "The path of the directory where journal entries are stored.\n\nDefault: `~`"
msgstr "La ruta del directorio en el que se guardan las entradas del diario.\n\nValor predeterminado: `~`"

msgctxt "settings schema"
msgid "The path to the Node binary."
msgstr "La ruta al binario de Node."

msgctxt "settings schema"
msgid "The path to the npm binary Zed should use (defaults to `.path/../npm`)."
msgstr "La ruta al binario de npm que debe usar ForgeKairos (el valor predeterminado es `.path/../npm`)."

msgctxt "settings schema"
msgid "The position of outline panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "La posición del panel de esquema\n\nValor predeterminado: right (diseño Agentic), left (diseño Classic)"

msgctxt "settings schema"
msgid "The position of project panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "La posición del panel de proyecto\n\nValor predeterminado: right (diseño Agentic), left (diseño Classic)"

msgctxt "settings schema"
msgid "The private key file (an absolute path, or one starting with `~`) that pushing, pulling\nand fetching reach SSH remotes with, offered alone (`IdentitiesOnly`). Local projects\nonly. Not used when `GIT_SSH_COMMAND`, `GIT_SSH` or `core.sshCommand` is set."
msgstr "El archivo de clave privada (una ruta absoluta o que empiece por `~`) con el que el push, el pull y el fetch acceden a los remotos SSH, ofrecido en exclusiva (`IdentitiesOnly`). Solo proyectos locales. No se usa si está establecido `GIT_SSH_COMMAND`, `GIT_SSH` o `core.sshCommand`."

msgctxt "settings schema"
msgid "The program to run."
msgstr "El programa que se ejecutará."

msgctxt "settings schema"
msgid "The prompt format to use for completions. Set to `\"\"` to have the format be derived from the model name.\n\nDefault: \"\""
msgstr "El formato de prompt que se usa para los autocompletados. Establézcalo en `\"\"` para que el formato se derive del nombre del modelo.\n\nValor predeterminado: \"\""

msgctxt "settings schema"
msgid "The provider of the language model."
msgstr "El proveedor del modelo de lenguaje."

msgctxt "settings schema"
msgid "The provider that supplies edit predictions."
msgstr "El proveedor que suministra predicciones de edición."

msgctxt "settings schema"
msgid "The regex pattern to match."
msgstr "El patrón de regex con el que se buscarán coincidencias."

msgctxt "settings schema"
msgid "The relative width of the left padding of the central pane from the\nworkspace when the centered layout is used.\n\nDefault: 0.2"
msgstr "El ancho relativo del relleno izquierdo del panel dividido central respecto al área de trabajo cuando se usa el diseño centrado.\n\nValor predeterminado: 0.2"

msgctxt "settings schema"
msgid "The settings for a particular language."
msgstr "La configuración de un lenguaje concreto."

msgctxt "settings schema"
msgid "The settings for cursor shape."
msgstr "La configuración de la forma del cursor."

msgctxt "settings schema"
msgid "The settings for indent guides."
msgstr "La configuración de las guías de sangría."

msgctxt "settings schema"
msgid "The settings for individual languages."
msgstr "La configuración de lenguajes individuales."

msgctxt "settings schema"
msgid "The settings for inlay hints."
msgstr "La configuración de las sugerencias insertadas."

msgctxt "settings schema"
msgid "The settings for the image viewer."
msgstr "La configuración del visor de imágenes."

msgctxt "settings schema"
msgid "The settings for the markdown preview."
msgstr "La configuración de la vista previa de Markdown."

msgctxt "settings schema"
msgid "The settings for this context server specified by the extension.\n\nConsult the documentation for the context server to see what settings\nare supported."
msgstr "La configuración de este servidor de contexto especificada por la extensión.\n\nConsulte la documentación del servidor de contexto para ver qué opciones admite."

msgctxt "settings schema"
msgid "The settings overrides for this profile."
msgstr "Las sobrescrituras de configuración para este perfil."

msgctxt "settings schema"
msgid "The shape of a selection cursor."
msgstr "La forma de un cursor de selección."

msgctxt "settings schema"
msgid "The shift key"
msgstr "La tecla Shift"

msgctxt "settings schema"
msgid "The size of the context window, indicating the maximum number of tokens the model can process."
msgstr "El tamaño de la ventana de contexto, que indica el número máximo de tokens que puede procesar el modelo."

msgctxt "settings schema"
msgid "The size of the workspace split drop targets on the outer edges.\nGiven as a fraction that will be multiplied by the smaller dimension of the workspace.\n\nDefault: `0.2` (20% of the smaller dimension of the workspace)"
msgstr "El tamaño de los destinos para soltar de división del área de trabajo en los bordes exteriores.\nSe indica como una fracción que se multiplica por la dimensión menor del área de trabajo.\n\nValor predeterminado: `0.2` (el 20 % de la dimensión menor del área de trabajo)"

msgctxt "settings schema"
msgid "The smallest model context window (in tokens) for which auto-compaction\nstill runs. Models below this are left uncompacted and the UI warns\nabout the token limit instead. Lower this to make auto-compaction work\nwith local models that have a small context window. Values below 8000\nare clamped to 8000.\n\nDefault: 80000"
msgstr "La ventana de contexto de modelo más pequeña (en tokens) para la que todavía se ejecuta la compactación automática. Los modelos por debajo se dejan sin compactar y, en su lugar, la interfaz advierte del límite de tokens. Redúzcala para que la compactación automática funcione con modelos locales que tienen una ventana de contexto pequeña. Los valores inferiores a 8000 se limitan a 8000.\n\nValor predeterminado: 80000"

msgctxt "settings schema"
msgid "The standard spacing of entries."
msgstr "El espaciado estándar de las entradas."

msgctxt "settings schema"
msgid "The state of the modifier keys at some point in time"
msgstr "El estado de las teclas modificadoras en un momento dado"

msgctxt "settings schema"
msgid "The step should allow one instruction to execute (e.g. one x86 instruction)."
msgstr "El paso debe permitir ejecutar una instrucción (por ejemplo, una instrucción x86)."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current source line has executed."
msgstr "El paso debe permitir que el programa se ejecute hasta que se haya ejecutado la línea de código fuente actual."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current statement has finished executing.\nThe meaning of a statement is determined by the adapter and it may be considered equivalent to a line.\nFor example 'for(int i = 0; i < 10; i++)' could be considered to have 3 statements 'int i = 0', 'i < 10', and 'i++'."
msgstr "El paso debe permitir que el programa se ejecute hasta que termine de ejecutarse la instrucción actual.\nEl significado de una instrucción lo determina el adaptador y puede considerarse equivalente a una línea.\nPor ejemplo, 'for(int i = 0; i < 10; i++)' podría considerarse que tiene 3 instrucciones: 'int i = 0', 'i < 10' e 'i++'."

msgctxt "settings schema"
msgid "The styles for syntax nodes."
msgstr "Los estilos de los nodos de sintaxis."

msgctxt "settings schema"
msgid "The subscription for this model: \"zen\" or \"go\". Defaults to Zen."
msgstr "La suscripción de este modelo: \"zen\" o \"go\". El valor predeterminado es Zen."

msgctxt "settings schema"
msgid "The task settings for a particular language."
msgstr "La configuración de tareas de un lenguaje concreto."

msgctxt "settings schema"
msgid "The text rendering mode to use.\n\nDefault: platform_default"
msgstr "El modo de representación de texto que se usa.\n\nValor predeterminado: platform_default"

msgctxt "settings schema"
msgid "The theme to use for dark mode."
msgstr "El tema que se usará en el modo oscuro."

msgctxt "settings schema"
msgid "The theme to use for light mode."
msgstr "El tema que se usará en el modo claro."

msgctxt "settings schema"
msgid "The theme to use for the markdown preview.\nFalls back to the main editor theme if unset."
msgstr "El tema que se usa para la vista previa de Markdown.\nSi no se establece, se usa el tema principal del editor."

msgctxt "settings schema"
msgid "The threshold at which auto-compaction runs. This is one of:\n\n- A percentage string ending in `%`, e.g. `\"90%\"`, measured against the\n  model's context window. `\"90%\"` compacts once the context is 90% full.\n- A positive integer: compaction runs once that many tokens have been\n  used. For example, `100000` compacts after 100,000 tokens are used.\n- A negative integer: compaction runs once that many tokens remain in\n  the context window. For example, `-20000` compacts once there are\n  fewer than 20,000 tokens of headroom left in the context window.\n\n`0` is not a valid threshold.\n\nDefault: \"90%\""
msgstr "El umbral a partir del cual se ejecuta la compactación automática. Es uno de los siguientes:\n\n- Una cadena de porcentaje que termina en `%`, p. ej. `\"90%\"`, medida respecto a la ventana de contexto del modelo. `\"90%\"` compacta cuando el contexto está lleno al 90 %.\n- Un entero positivo: la compactación se ejecuta cuando se ha usado ese número de tokens. Por ejemplo, `100000` compacta después de usar 100,000 tokens.\n- Un entero negativo: la compactación se ejecuta cuando quedan ese número de tokens en la ventana de contexto. Por ejemplo, `-20000` compacta cuando quedan menos de 20,000 tokens de margen en la ventana de contexto.\n\n`0` no es un umbral válido.\n\nValor predeterminado: \"90%\""

msgctxt "settings schema"
msgid "The topic whose entries to show first, such as \"merge_request\". Without it, the usual order."
msgstr "El tema cuyas entradas se muestran primero, como \"merge_request\". Sin él, el orden habitual."

msgctxt "settings schema"
msgid "The type of the provider.\n\nMust be one of `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut`, or `tangled`."
msgstr "El tipo del proveedor.\n\nDebe ser uno de `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut` o `tangled`."

msgctxt "settings schema"
msgid "The unit to use for displaying image file sizes.\n\nDefault: \"binary\""
msgstr "La unidad que se usa para mostrar el tamaño de los archivos de imagen.\n\nValor predeterminado: \"binary\""

msgctxt "settings schema"
msgid "The user name on `host` that goes with the token."
msgstr "El nombre de usuario en `host` que corresponde al token."

msgctxt "settings schema"
msgid "The value to pass to the CLI's `--effort`, such as `low`, `medium` or `high`. Without it, the CLI uses its default."
msgstr "El valor que se pasa a `--effort` de la CLI, como `low`, `medium` o `high`. Sin él, la CLI usa su valor predeterminado."

msgctxt "settings schema"
msgid "The weight of the UI font in CSS units from 100 to 900."
msgstr "El grosor de la fuente de la interfaz en unidades CSS de 100 a 900."

msgctxt "settings schema"
msgid "The weight of the editor font in CSS units from 100 to 900."
msgstr "El grosor de la fuente del editor en unidades CSS de 100 a 900."

msgctxt "settings schema"
msgid "The width of the active indent guide in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "El ancho de la guía de sangría activa en píxeles, entre 1 y 10.\n\nValor predeterminado: 1"

msgctxt "settings schema"
msgid "The width of the git diff hunk indicators in the gutter.\nUse \"default\" to scale with the buffer font size, or {\"custom\": <pixels>} for a fixed width.\n\nDefault: \"default\""
msgstr "El ancho de los indicadores de fragmentos de diferencias de git en el margen.\nUse \"default\" para que se escale con el tamaño de fuente del búfer, o {\"custom\": <pixels>} para un ancho fijo.\n\nValor predeterminado: \"default\""

msgctxt "settings schema"
msgid "The width of the indent guides in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "El ancho de las guías de sangría en píxeles, entre 1 y 10.\n\nValor predeterminado: 1"

msgctxt "settings schema"
msgid "The window manager or compositor draws the server-side window\ndecorations (not supported by GNOME Wayland)."
msgstr "El administrador de ventanas o el compositor dibuja las decoraciones de ventana del lado del servidor (no compatible con GNOME Wayland)."

msgctxt "settings schema"
msgid "Theme name."
msgstr "Nombre del tema."

msgctxt "settings schema"
msgid "Thinking blocks are always collapsed by default."
msgstr "Los bloques de razonamiento siempre se contraen de forma predeterminada."

msgctxt "settings schema"
msgid "Thinking blocks are always fully expanded by default (no height constraint)."
msgstr "Los bloques de razonamiento siempre se expanden por completo de forma predeterminada (sin restricción de altura)."

msgctxt "settings schema"
msgid "Thinking blocks auto-expand with a height constraint during streaming,\nthen remain in their constrained state when complete. Users can click\nto fully expand or collapse."
msgstr "Los bloques de razonamiento se expanden automáticamente con un límite de altura durante el streaming y permanecen en ese estado limitado al terminar. Los usuarios pueden hacer clic para expandirlos por completo o contraerlos."

msgctxt "settings schema"
msgid "Thinking blocks fully expand during streaming, then auto-collapse\nwhen the model finishes thinking. Users can re-expand after collapse."
msgstr "Los bloques de razonamiento se expanden por completo durante el streaming y se contraen automáticamente cuando el modelo termina de razonar. Los usuarios pueden volver a expandirlos después de contraerse."

msgctxt "settings schema"
msgid "Thinking effort levels this model accepts in Ollama's `think` parameter,\nfor example `[\"low\", \"medium\", \"high\"]`. Only some models (e.g. `gpt-oss`)\naccept a level instead of a plain on/off; leave unset for those that don't."
msgstr "Niveles de razonamiento que este modelo acepta en el parámetro `think` de Ollama, por ejemplo `[\"low\", \"medium\", \"high\"]`. Solo algunos modelos (p. ej., `gpt-oss`) aceptan un nivel en lugar de un simple activado/desactivado; déjelo sin establecer para los que no lo aceptan."

msgctxt "settings schema"
msgid "This base keymap settings adjusts the default keybindings in Zed to be similar\nto other common code editors. By default, Zed's keymap closely follows VSCode's\nkeymap, with minor adjustments, this corresponds to the \"VSCode\" setting.\n\nDefault: VSCode"
msgstr "Esta opción de mapa de teclas base ajusta los atajos de teclado predeterminados de ForgeKairos para que se parezcan a los de otros editores de código habituales. De forma predeterminada, el mapa de teclas de ForgeKairos sigue de cerca el de VSCode, con pequeños ajustes; esto corresponde a la opción \"VSCode\".\n\nValor predeterminado: VSCode"

msgctxt "settings schema"
msgid "Time in milliseconds until timeout error when connecting to a TCP debug adapter\n\nDefault: 2000ms"
msgstr "Tiempo en milisegundos hasta que se produce un error de tiempo de espera al conectarse a un adaptador de depuración TCP\n\nValor predeterminado: 2000ms"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before hiding the hover popover\nafter the mouse moves away from the hover target.\nOnly applies when `hover_popover_sticky` is enabled.\n\nDefault: 300"
msgstr "Tiempo de espera en milisegundos antes de ocultar la ventana emergente al pasar el cursor después de que el mouse se aleja del destino.\nSolo se aplica cuando `hover_popover_sticky` está habilitado.\n\nValor predeterminado: 300"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before showing the informational hover box.\nThis delay also applies to auto signature help when `auto_signature_help` is enabled.\n\nDefault: 300"
msgstr "Tiempo de espera en milisegundos antes de mostrar el cuadro informativo al pasar el cursor.\nEste retraso también se aplica a la ayuda de firma automática cuando `auto_signature_help` está habilitado.\n\nValor predeterminado: 300"

msgctxt "settings schema"
msgid "Timeout for hover and Cmd-click path hyperlink discovery in milliseconds.\n\nDefault: 1"
msgstr "Tiempo de espera, en milisegundos, para la detección de hipervínculos de rutas al pasar el cursor y al hacer Cmd+clic.\n\nValor predeterminado: 1"

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to 60 if not specified."
msgstr "Tiempo de espera para llamadas a herramientas, en segundos. El valor predeterminado es 60 si no se especifica."

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to global context_server_timeout if not specified."
msgstr "Tiempo de espera para llamadas a herramientas, en segundos. El valor predeterminado es context_server_timeout global si no se especifica."

msgctxt "settings schema"
msgid "Timeout in milliseconds for automatically dismissing language server notifications.\nSet to 0 to disable auto-dismiss.\n\nDefault: 5000"
msgstr "Tiempo de espera, en milisegundos, para cerrar automáticamente las notificaciones de los servidores de lenguaje.\nEstablézcalo en 0 para deshabilitar el cierre automático.\n\nValor predeterminado: 5000"

msgctxt "settings schema"
msgid "Timeout in seconds for SSH connection and downloading the remote server binary.\nDefaults to 10 seconds if not specified."
msgstr "Tiempo de espera, en segundos, para la conexión SSH y la descarga del binario del servidor remoto.\nSi no se especifica, el valor predeterminado es 10 segundos."

msgctxt "settings schema"
msgid "Toggles inlay hints (hides or shows) when the user presses the modifiers specified.\nIf only a subset of the modifiers specified is pressed, hints are not toggled.\nIf no modifiers are specified, this is equivalent to `null`.\n\nDefault: null"
msgstr "Alterna las sugerencias insertadas (las oculta o las muestra) cuando el usuario presiona los modificadores especificados.\nSi solo se presiona una parte de los modificadores especificados, las sugerencias no se alternan.\nSi no se especifica ningún modificador, equivale a `null`.\n\nValor predeterminado: null"

msgctxt "settings schema"
msgid "Toolbar related settings"
msgstr "Configuración relacionada con la barra de herramientas"

msgctxt "settings schema"
msgid "Treat files and folders matching these glob patterns as hidden, including\nfiles inside matching folders. To hide these entries, run\n`project panel: toggle hide hidden` from the command palette or set\n`project_panel.hide_hidden` to `true`.\n\nDefault:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Trata como ocultos los archivos y carpetas que coinciden con estos patrones glob, incluidos los archivos dentro de las carpetas coincidentes. Para ocultar estas entradas, ejecute `project panel: toggle hide hidden` desde la paleta de comandos o establezca `project_panel.hide_hidden` en `true`.\n\nValor predeterminado:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUse `\"...\"` para agregar patrones sin repetir los valores predeterminados de ForgeKairos. En la configuración del proyecto, amplía el valor de la configuración de usuario o de la configuración superior. Omita `\"...\"` para reemplazar la lista heredada.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nLos patrones heredados se insertan en `\"...\"` y, de los duplicados, se conserva la primera aparición."

msgctxt "settings schema"
msgid "Treat files matching these glob patterns as read-only when opened. You can\nview but not edit them, which is useful for build outputs, external\ndependencies, or generated files.\n\nDefault:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Trata como de solo lectura al abrirlos los archivos que coinciden con estos patrones glob. Se pueden ver pero no editar, lo que resulta útil para salidas de compilación, dependencias externas o archivos generados.\n\nValor predeterminado:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUse `\"...\"` para agregar patrones sin repetir los valores predeterminados de ForgeKairos. En la configuración del proyecto, amplía el valor de la configuración de usuario o de la configuración superior. Omita `\"...\"` para reemplazar la lista heredada.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nLos patrones heredados se insertan en `\"...\"` y, de los duplicados, se conserva la primera aparición."

msgctxt "settings schema"
msgid "Treat the files matching these globs as `.env` files.\nDefault: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"
msgstr "Trata los archivos que coinciden con estos globs como archivos `.env`.\nValor predeterminado: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"

msgctxt "settings schema"
msgid "UNSTABLE: Expect many elements to be broken."
msgstr "INESTABLE: cabe esperar que muchos elementos no funcionen."

msgctxt "settings schema"
msgid "Underline cursor."
msgstr "Cursor de subrayado."

msgctxt "settings schema"
msgid "Uppercase names are grouped before lowercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Los nombres en mayúsculas se agrupan antes que los nombres en minúsculas, con ordenación natural sin distinguir mayúsculas y minúsculas dentro de cada grupo. Los nombres que empiezan por punto se ordenan antes que ambos grupos."

msgctxt "settings schema"
msgid "Use CRLF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "Usa CRLF para los archivos nuevos y los archivos sin una convención de final de línea existente, y conserva los archivos LF o CRLF existentes."

msgctxt "settings schema"
msgid "Use LF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "Usa LF para los archivos nuevos y los archivos sin una convención de final de línea existente, y conserva los archivos LF o CRLF existentes."

msgctxt "settings schema"
msgid "Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server."
msgstr "Usa el plegado de LSP siempre que sea posible, recurriendo al plegado basado en tree-sitter y en la sangría cuando el servidor no devuelva resultados."

msgctxt "settings schema"
msgid "Use LSP semantic tokens exclusively, replacing tree-sitter highlighting."
msgstr "Usa exclusivamente tokens semánticos de LSP, sustituyendo el resaltado de tree-sitter."

msgctxt "settings schema"
msgid "Use LSP semantic tokens together with tree-sitter highlighting."
msgstr "Usa tokens semánticos de LSP junto con el resaltado de tree-sitter."

msgctxt "settings schema"
msgid "Use LSP tasks over Zed language extension ones.\nIf no LSP tasks are returned due to error/timeout or regular execution,\nZed language extension tasks will be used instead.\n\nOther Zed tasks will still be shown:\n* Zed task from either of the task config file\n* Zed task from history (e.g. one-off task was spawned before)"
msgstr "Usa las tareas de LSP en lugar de las de las extensiones de lenguaje de ForgeKairos.\nSi no se devuelve ninguna tarea de LSP por error, tiempo de espera o ejecución normal, se usan en su lugar las tareas de las extensiones de lenguaje de ForgeKairos.\n\nLas demás tareas de ForgeKairos se siguen mostrando:\n* tareas de ForgeKairos de cualquiera de los archivos de configuración de tareas\n* tareas de ForgeKairos del historial (p. ej., una tarea puntual que se ejecutó antes)"

msgctxt "settings schema"
msgid "Use a custom line height."
msgstr "Usa un alto de línea personalizado."

msgctxt "settings schema"
msgid "Use a different color for each indentation level."
msgstr "Usa un color diferente para cada nivel de sangría."

msgctxt "settings schema"
msgid "Use a line height that's comfortable for reading, 1.618"
msgstr "Usa un alto de línea cómodo para la lectura, 1.618"

msgctxt "settings schema"
msgid "Use a specific program with arguments."
msgstr "Usa un programa específico con argumentos."

msgctxt "settings schema"
msgid "Use a specific program with no arguments."
msgstr "Usa un programa específico sin argumentos."

msgctxt "settings schema"
msgid "Use a standard line height, 1.3. This option is useful for TUIs,\nparticularly if they use box characters"
msgstr "Usa un alto de línea estándar, 1.3. Esta opción es útil para las TUI, sobre todo si usan caracteres de dibujo de cuadros"

msgctxt "settings schema"
msgid "Use all gitignored files"
msgstr "Usar todos los archivos ignorados por Git"

msgctxt "settings schema"
msgid "Use conda"
msgstr "Usar conda"

msgctxt "settings schema"
msgid "Use grayscale text rendering."
msgstr "Usa la representación de texto en escala de grises."

msgctxt "settings schema"
msgid "Use macOS's native fullscreen, which moves the window into its own\nMission Control space."
msgstr "Usa la pantalla completa nativa de macOS, que mueve la ventana a su propio espacio de Mission Control."

msgctxt "settings schema"
msgid "Use mamba"
msgstr "Usar mamba"

msgctxt "settings schema"
msgid "Use micromamba"
msgstr "Usar micromamba"

msgctxt "settings schema"
msgid "Use only the files Zed had indexed"
msgstr "Usar solo los archivos que ForgeKairos había indexado"

msgctxt "settings schema"
msgid "Use platform default behavior."
msgstr "Usa el comportamiento predeterminado de la plataforma."

msgctxt "settings schema"
msgid "Use subpixel (ClearType-style) text rendering."
msgstr "Usa la representación de texto subpíxel (estilo ClearType)."

msgctxt "settings schema"
msgid "Use system clipboard for yank operations."
msgstr "Usa el portapapeles del sistema para operaciones de yank."

msgctxt "settings schema"
msgid "Use system clipboard."
msgstr "Usa el portapapeles del sistema."

msgctxt "settings schema"
msgid "Use the current file's directory, falling back to the project directory,\nthen the first project in the workspace."
msgstr "Usa el directorio del archivo actual; en su defecto, el directorio del proyecto y, después, el primer proyecto del área de trabajo."

msgctxt "settings schema"
msgid "Use the current file's project directory. Fallback to the\nfirst project directory strategy if unsuccessful."
msgstr "Usa el directorio del proyecto del archivo actual. Si no es posible, recurre a la estrategia del primer directorio de proyecto."

msgctxt "settings schema"
msgid "Use the first project in this workspace's directory. Fallback to using\nthis platform's home directory."
msgstr "Usa el directorio del primer proyecto de esta área de trabajo. Si no es posible, usa el directorio personal de esta plataforma."

msgctxt "settings schema"
msgid "Use the language server's `textDocument/documentSymbol` LSP response for outlines and\nbreadcrumbs. When enabled, tree-sitter is not used for document symbols."
msgstr "Usa la respuesta LSP `textDocument/documentSymbol` del servidor de lenguaje para el esquema y las rutas de navegación. Si está habilitado, tree-sitter no se usa para los símbolos del documento."

msgctxt "settings schema"
msgid "Use the preference previously set via the status-bar toggle, or false\nif no preference has been stored."
msgstr "Usa la preferencia establecida anteriormente con el conmutador de la barra de estado, o false si no se ha guardado ninguna preferencia."

msgctxt "settings schema"
msgid "Use the same color for all indentation levels."
msgstr "Usa el mismo color para todos los niveles de sangría."

msgctxt "settings schema"
msgid "Use the specified `dark` theme."
msgstr "Usa el tema `dark` especificado."

msgctxt "settings schema"
msgid "Use the specified `light` theme."
msgstr "Usa el tema `light` especificado."

msgctxt "settings schema"
msgid "Use the system's default terminal configuration in /etc/passwd"
msgstr "Usa la configuración de terminal predeterminada del sistema en /etc/passwd"

msgctxt "settings schema"
msgid "Use the theme based on the system's appearance."
msgstr "Usa el tema basado en la apariencia del sistema."

msgctxt "settings schema"
msgid "Use tree-sitter queries to compute document symbols for outlines and breadcrumbs (default)."
msgstr "Usa consultas de tree-sitter para calcular símbolos de documento para esquemas y rutas de navegación (predeterminado)."

msgctxt "settings schema"
msgid "Used for the background of a ghost element that should have the same background as the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have a different background than the surface it's on, use `element_background`."
msgstr "Se usa para el fondo de un elemento fantasma que debe tener el mismo fondo que la superficie en la que está.\n\nLos elementos pueden incluir: botones, campos de entrada, casillas de verificación, botones de opción...\n\nPara un elemento que debe tener un fondo distinto del de la superficie en la que está, use `element_background`."

msgctxt "settings schema"
msgid "Vertical bar cursor."
msgstr "Cursor de barra vertical."

msgctxt "settings schema"
msgid "Vertically center the target in the viewport."
msgstr "Centra verticalmente el destino en el área visible."

msgctxt "settings schema"
msgid "Visible characters used to render whitespace when show_whitespaces is enabled.\n\nDefault: \"•\" for spaces, \"→\" for tabs."
msgstr "Caracteres visibles que se usan para representar los espacios en blanco cuando show_whitespaces está habilitado.\n\nValor predeterminado: \"•\" para los espacios, \"→\" para las tabulaciones."

msgctxt "settings schema"
msgid "What `git reset` keeps of the changes."
msgstr "Qué conserva `git reset` de los cambios."

msgctxt "settings schema"
msgid "What base settings to start from before applying this profile's overrides.\n\n- `user`: Apply on top of user's settings (default)\n- `default`: Apply on top of Zed's default settings, ignoring user customizations"
msgstr "La configuración base desde la que se parte antes de aplicar los reemplazos de este perfil.\n\n- `user`: se aplica sobre la configuración del usuario (predeterminado)\n- `default`: se aplica sobre la configuración predeterminada de ForgeKairos, sin tener en cuenta las personalizaciones del usuario"

msgctxt "settings schema"
msgid "What format to display the hours in.\n\nDefault: hour12"
msgstr "El formato en el que se muestran las horas.\n\nValor predeterminado: hour12"

msgctxt "settings schema"
msgid "What shell to use when opening a terminal.\n\nDefault: system"
msgstr "El shell que se usa al abrir un terminal.\n\nValor predeterminado: system"

msgctxt "settings schema"
msgid "What the default branch name should be when\n`init.defaultBranch` is not set in git\n\nDefault: main"
msgstr "El nombre de rama predeterminado cuando `init.defaultBranch` no está establecido en git\n\nValor predeterminado: main"

msgctxt "settings schema"
msgid "What to do after closing the current tab.\n\nDefault: history"
msgstr "Qué hacer después de cerrar la pestaña actual.\n\nValor predeterminado: history"

msgctxt "settings schema"
msgid "What to do when go to definition yields no results."
msgstr "Indica qué hacer cuando ir a la definición no produce resultados."

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts\n(parts of singleton buffers).\n\nDefault: select"
msgstr "Qué hacer al hacer doble clic en alguno de los extractos de un multibúfer (partes de búferes individuales).\n\nValor predeterminado: select"

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts (parts of singleton buffers)."
msgstr "Indica qué hacer cuando se hace doble clic en el multibúfer en algunos de sus extractos (partes de búferes únicos)."

msgctxt "settings schema"
msgid "What to do when the `BEL` character (`\\a`) is printed to terminal.\n\nDefault: \"system\""
msgstr "Qué hacer cuando se imprime el carácter `BEL` (`\\a`) en el terminal.\n\nValor predeterminado: \"system\""

msgctxt "settings schema"
msgid "What to do when the last window is closed\n\nDefault: auto (nothing on macOS, \"app quit\" otherwise)"
msgstr "Qué hacer cuando se cierra la última ventana\n\nValor predeterminado: auto (nada en macOS, \"app quit\" en los demás sistemas)"

msgctxt "settings schema"
msgid "What to show for directories in the git panel.\n\nDefault: icon"
msgstr "Qué mostrar para los directorios en el panel de Git.\n\nValor predeterminado: icon"

msgctxt "settings schema"
msgid "What to show for directories in the outline panel.\n\nDefault: icon"
msgstr "Qué mostrar para los directorios en el panel de esquema.\n\nValor predeterminado: icon"

msgctxt "settings schema"
msgid "What to show for directories in the project panel.\n\nDefault: icon"
msgstr "Qué mostrar para los directorios en el panel de proyecto.\n\nValor predeterminado: icon"

msgctxt "settings schema"
msgid "What to show when opening a new window.\nValues: empty_tab, launchpad\nDefault: launchpad"
msgstr "Qué mostrar al abrir una ventana nueva.\nValores: empty_tab, launchpad\nValor predeterminado: launchpad"

msgctxt "settings schema"
msgid "What working directory to use when launching the terminal\n\nDefault: current_project_directory"
msgstr "El directorio de trabajo que se usa al iniciar el terminal\n\nValor predeterminado: current_project_directory"

msgctxt "settings schema"
msgid "When enabled, edit predictions are shown in Vim normal mode.\nBy default, edit predictions are only shown in insert and replace modes."
msgstr "Si está habilitado, las predicciones de edición se muestran en el modo normal de Vim.\nDe forma predeterminada, las predicciones de edición solo se muestran en los modos de inserción y de reemplazo."

msgctxt "settings schema"
msgid "When enabled, the `:substitute` command replaces all matches in a line\nby default. The 'g' flag then toggles this behavior.,"
msgstr "Si está habilitado, el comando `:substitute` reemplaza de forma predeterminada todas las coincidencias de una línea. La marca 'g' alterna entonces este comportamiento."

msgctxt "settings schema"
msgid "When false, forcefully disables the horizontal scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Si es false, deshabilita de forma forzada la barra de desplazamiento horizontal. En caso contrario, sigue las demás opciones.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "When false, forcefully disables the vertical scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Si es false, deshabilita de forma forzada la barra de desplazamiento vertical. En caso contrario, sigue las demás opciones.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "When fetching LSP completions, determines how long to wait for a response of a particular server.\nWhen set to 0, waits indefinitely.\n\nDefault: 0"
msgstr "Al obtener autocompletados de LSP, determina cuánto tiempo se espera la respuesta de cada servidor.\nCon 0, se espera indefinidamente.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane."
msgstr "Cuándo muestra el panel del agente la barra de pestañas de su propio panel dividido."

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane.\n\nDefault: auto"
msgstr "Cuándo muestra el panel del agente la barra de pestañas de su propio panel dividido.\n\nValor predeterminado: auto"

msgctxt "settings schema"
msgid "When the attachments of one message add up to more than this many\nbytes, the largest ones are sent as an outline or a reference until the\nmessage fits. Attachments set to be sent in full are never reduced.\n\nDefault: 65536"
msgstr "Cuando los adjuntos de un mensaje suman más de este número de bytes, los más grandes se envían como esquema o referencia hasta que el mensaje cabe. Los adjuntos configurados para enviarse completos nunca se reducen.\n\nValor predeterminado: 65536"

msgctxt "settings schema"
msgid "When to automatically save edited buffers.\n\nDefault: off"
msgstr "Cuándo se guardan automáticamente los búferes editados.\n\nValor predeterminado: off"

msgctxt "settings schema"
msgid "When to index the worktree's C and C++ files.\n\nDefault: auto"
msgstr "Cuándo se indexan los archivos C y C++ del worktree.\n\nValor predeterminado: auto"

msgctxt "settings schema"
msgid "When to play a sound when the agent has either completed its response, or needs user input.\n\nDefault: never"
msgstr "Cuándo se reproduce un sonido cuando el agente ha terminado su respuesta o necesita una entrada del usuario.\n\nValor predeterminado: never"

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor."
msgstr "Cuándo rellenar la consulta de una búsqueda nueva en función del texto bajo el cursor."

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor.\n\nDefault: always"
msgstr "Cuándo se rellena la consulta de una nueva búsqueda con el texto bajo el cursor.\n\nValor predeterminado: always"

msgctxt "settings schema"
msgid "When to scan content of linked directories."
msgstr "Cuándo analizar el contenido de los directorios enlazados."

msgctxt "settings schema"
msgid "When to scan content of linked directories.\n\nDefault: expanded"
msgstr "Cuándo se analiza el contenido de los directorios enlazados.\n\nValor predeterminado: expanded"

msgctxt "settings schema"
msgid "When to show the minimap in the editor.\n\nDefault: never"
msgstr "Cuándo se muestra el minimapa en el editor.\n\nValor predeterminado: never"

msgctxt "settings schema"
msgid "When to show the minimap thumb.\n\nDefault: always"
msgstr "Cuándo se muestra el control deslizante del minimapa.\n\nValor predeterminado: always"

msgctxt "settings schema"
msgid "When to show the scrollbar in the completion menu.\nThis setting can take four values:\n\n1. Show the scrollbar if there's important information or\n   follow the system's configured behavior\n  \"auto\"\n2. Match the system's configured behavior:\n   \"system\"\n3. Always show the scrollbar:\n   \"always\"\n4. Never show the scrollbar:\n   \"never\" (default)"
msgstr "Cuándo se muestra la barra de desplazamiento en el menú de autocompletado.\nEsta opción admite cuatro valores:\n\n1. Mostrar la barra de desplazamiento si hay información importante o seguir el comportamiento configurado en el sistema\n  \"auto\"\n2. Seguir el comportamiento configurado en el sistema:\n   \"system\"\n3. Mostrar siempre la barra de desplazamiento:\n   \"always\"\n4. No mostrar nunca la barra de desplazamiento:\n   \"never\" (predeterminado)"

msgctxt "settings schema"
msgid "When to show the scrollbar in the editor.\n\nDefault: auto"
msgstr "Cuándo se muestra la barra de desplazamiento en el editor.\n\nValor predeterminado: auto"

msgctxt "settings schema"
msgid "When to show the scrollbar in the outline panel."
msgstr "Cuándo mostrar la barra de desplazamiento en el panel de esquema."

msgctxt "settings schema"
msgid "When to show the scrollbar in the project panel.\n\nDefault: inherits editor scrollbar settings"
msgstr "Cuándo se muestra la barra de desplazamiento en el panel de proyecto.\n\nValor predeterminado: hereda la configuración de la barra de desplazamiento del editor"

msgctxt "settings schema"
msgid "When to show the scrollbar in the terminal.\n\nDefault: inherits editor scrollbar settings"
msgstr "Cuándo se muestra la barra de desplazamiento en el terminal.\n\nValor predeterminado: hereda la configuración de la barra de desplazamiento del editor"

msgctxt "settings schema"
msgid "When to show the scrollbar.\n\nDefault: auto"
msgstr "Cuándo se muestra la barra de desplazamiento.\n\nValor predeterminado: auto"

msgctxt "settings schema"
msgid "When true, enables drag and drop text selection in buffer.\n\nDefault: true"
msgstr "Si es true, habilita arrastrar y colocar la selección de texto en el búfer.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "When using OpenAiChat protocol, whether thinking tokens are sent as a dedicated `reasoning_content` field or inline in message text."
msgstr "Cuando se usa el protocolo OpenAiChat, indica si los tokens de razonamiento se envían como un campo dedicado `reasoning_content` o en línea en el texto del mensaje."

msgctxt "settings schema"
msgid "Where to dock the AI browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Dónde acoplar el panel del navegador de IA. Puede ser 'left', 'right' o 'bottom'.\n\nValor predeterminado: right"

msgctxt "settings schema"
msgid "Where to dock the agent panel.\n\nDefault: left (Agentic layout), right (Classic layout)"
msgstr "Dónde acoplar el panel del agente.\n\nValor predeterminado: left (diseño Agentic), right (diseño Classic)"

msgctxt "settings schema"
msgid "Where to dock the browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Dónde acoplar el panel del navegador. Puede ser 'left', 'right' o 'bottom'.\n\nValor predeterminado: right"

msgctxt "settings schema"
msgid "Where to dock the call graph panel.\n\nDefault: right"
msgstr "Dónde acoplar el panel de grafo de llamadas.\n\nValor predeterminado: right"

msgctxt "settings schema"
msgid "Where to dock the panel.\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "Dónde acoplar el panel.\n\nValor predeterminado: right (diseño Agentic), left (diseño Classic)"

msgctxt "settings schema"
msgid "Where to keep the changes."
msgstr "Dónde se conservan los cambios."

msgctxt "settings schema"
msgid "Where to position the threads sidebar."
msgstr "Dónde colocar la barra lateral de conversaciones."

msgctxt "settings schema"
msgid "Where to position the threads sidebar.\n\nDefault: left"
msgstr "Dónde se coloca la barra lateral de conversaciones.\n\nValor predeterminado: left"

msgctxt "settings schema"
msgid "Where to render the blame information when enabled.\n\nDefault: inline"
msgstr "Dónde se representa la información de autoría cuando está habilitada.\n\nValor predeterminado: inline"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations\n(Go to Definition, Go to Implementation, Find All References). A single\nresult always opens directly. Individual actions can override this with\ntheir `open_results_in` argument.\n\nDefault: multi_buffer"
msgstr "Dónde se muestran los resultados de LSP que pueden contener varias ubicaciones (Ir a la definición, Ir a la implementación, Buscar todas las referencias). Un único resultado siempre se abre directamente. Cada acción puede reemplazar esto con su argumento `open_results_in`.\n\nValor predeterminado: multi_buffer"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations."
msgstr "Dónde mostrar los resultados de LSP que pueden contener varias ubicaciones."

msgctxt "settings schema"
msgid "Where to show a popup notification when the agent is waiting for user input.\n\nDefault: \"primary_screen\""
msgstr "Dónde se muestra una notificación emergente cuando el agente espera una entrada del usuario.\n\nValor predeterminado: \"primary_screen\""

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: [`DisplayIn::ActiveEditor`]"
msgstr "Dónde se muestra el minimapa en el editor.\n\nValor predeterminado: [`DisplayIn::ActiveEditor`]"

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: all_editors"
msgstr "Dónde se muestra el minimapa en el editor.\n\nValor predeterminado: all_editors"

msgctxt "settings schema"
msgid "Whether \"Launch Claude Code\" always launches outside the sandbox, without\nasking. Outside, writes are not restricted, and network restrictions only\napply to programs that read the proxy settings (and not at all on SSH\nhosts). Can only be set in the user settings, not in a project's settings.\n\nDefault: false"
msgstr "Indica si \"Iniciar Claude Code\" siempre se inicia fuera del sandbox, sin preguntar. Fuera, las escrituras no están restringidas y las restricciones de red solo se aplican a los programas que leen la configuración del proxy (y en los hosts SSH, en absoluto). Solo se puede establecer en la configuración de usuario, no en la configuración de un proyecto.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether AI agents (the built-in agent and MCP clients) may drive the\nbuilt-in browser's AI tabs, for debugging web apps.\n\nAI tabs use their own browser profile and always go through the egress\nallowlist proxy, whatever `use_egress_proxy` says.\n\nDefault: false"
msgstr "Indica si los agentes de IA (el agente integrado y los clientes MCP) pueden manejar las pestañas de IA del navegador integrado para depurar aplicaciones web.\n\nLas pestañas de IA usan su propio perfil de navegador y siempre pasan por el proxy de la lista de permitidos del tráfico saliente, sea cual sea el valor de `use_egress_proxy`.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether Anthropic's fast mode is available for this model."
msgstr "Indica si el modo rápido de Anthropic está disponible para este modelo."

msgctxt "settings schema"
msgid "Whether SSH terminals keep their shell running on the remote host\nacross disconnects, and for how long."
msgstr "Indica si los terminales SSH mantienen su shell en ejecución en el host remoto tras una desconexión, y durante cuánto tiempo."

msgctxt "settings schema"
msgid "Whether a new agent thread starts with Git operations turned on: the\nagent gets the `git` tool, which runs git (with every hook turned off)\nafter each call is approved. The chat input's Git button turns it on\nor off for one thread.\n\nDefault: true"
msgstr "Indica si una nueva conversación del agente empieza con las operaciones de Git activadas: el agente obtiene la herramienta `git`, que ejecuta git (con todos los hooks desactivados) después de que se apruebe cada llamada. El botón Git de la entrada del chat lo activa o desactiva para una conversación.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether a terminal opened over SSH runs its shell inside a session the\nremote server keeps alive, so that a dropped connection neither stops\nrunning commands nor loses the output: reconnecting shows everything\nagain and continues. Only for SSH hosts that are not Windows.\n\nDefault: true"
msgstr "Indica si un terminal abierto por SSH ejecuta su shell dentro de una sesión que el servidor remoto mantiene activa, de modo que una conexión perdida no detiene los comandos en ejecución ni pierde la salida: al volver a conectar se muestra todo de nuevo y se continúa. Solo para hosts SSH que no son Windows.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether a worktree an agent wrote into stops running its own code\n(project language server modes, formatters, the project's prettier)\nuntil the user reviews the changes and resumes it. Read from the user\nsettings file only: project and server settings cannot turn it off.\n\nDefault: true"
msgstr "Indica si un worktree en el que escribió un agente deja de ejecutar su propio código (modos de servidor de lenguaje del proyecto, formateadores, el prettier del proyecto) hasta que el usuario revisa los cambios y lo reanuda. Solo se lee del archivo de configuración de usuario: la configuración del proyecto y del servidor no puede desactivarlo.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether agents connected over the IDE server may read the output of the\nlast task that failed in this window (the `getLastTaskOutput` tool, at\nmost the last 4 KB of the task's terminal).\n\nDefault: true"
msgstr "Indica si los agentes conectados mediante el servidor IDE pueden leer la salida de la última tarea que falló en esta ventana (la herramienta `getLastTaskOutput`, como máximo los últimos 4 KB del terminal de la tarea).\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether all context servers are enabled by default."
msgstr "Indica si todos los servidores de contexto están habilitados de forma predeterminada."

msgctxt "settings schema"
msgid "Whether and how to display code lenses from language servers.\n\nDefault: \"off\""
msgstr "Indica si se muestran los CodeLens de los servidores de lenguaje y cómo.\n\nValor predeterminado: \"off\""

msgctxt "settings schema"
msgid "Whether anything the agent features start may run outside the sandbox\nat all. While this is off, every new way out is refused without asking:\nagent terminal commands that cannot run in the sandbox (and\n`allow_unsandboxed`, which is then ignored), external agents and Claude\nCode started outside it (the one-time starts and the \"always outside\"\nsettings, which are then ignored), and threads resumed outside it. A\nconnection already running outside the sandbox keeps running, and MCP\nservers (context servers) are not covered. While it is on, each of\nthose asks or follows its own setting as before. Only the user settings\nfile is read: neither a project's settings nor an agent can turn it on.\nDefault: false"
msgstr "Indica si algo de lo que inician las funciones del agente puede ejecutarse fuera del sandbox. Mientras está desactivado, toda nueva vía de salida se rechaza sin preguntar: los comandos de terminal del agente que no pueden ejecutarse en el sandbox (y `allow_unsandboxed`, que entonces se ignora), los agentes externos y Claude Code iniciados fuera de él (los inicios puntuales y las opciones \"siempre fuera\", que entonces se ignoran) y las conversaciones reanudadas fuera de él. Una conexión que ya se está ejecutando fuera del sandbox sigue ejecutándose, y los servidores MCP (servidores de contexto) no están incluidos. Mientras está activado, cada uno de ellos pregunta o sigue su propia opción como antes. Solo se lee el archivo de configuración de usuario: ni la configuración de un proyecto ni un agente pueden activarlo.\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether clangd indexes the whole project in the background. `light`\nskips that index (`--background-index=false`), which saves the most\nmemory: references, call hierarchy and renames then only cover the\nfiles that are open. Ignored when `lsp.clangd.binary.arguments`\nalready has `--background-index`.\n\nDefault: full"
msgstr "Indica si clangd indexa todo el proyecto en segundo plano. `light` omite ese índice (`--background-index=false`), lo que ahorra la mayor cantidad de memoria: las referencias, la jerarquía de llamadas y los cambios de nombre abarcan entonces solo los archivos abiertos. Se ignora si `lsp.clangd.binary.arguments` ya incluye `--background-index`.\n\nValor predeterminado: full"

msgctxt "settings schema"
msgid "Whether clicking the stop button on a running terminal tool should also cancel the agent's generation.\nNote that this only applies to the stop button, not to ctrl+c inside the terminal.\n\nDefault: true"
msgstr "Indica si al hacer clic en el botón de detener de una herramienta de terminal en ejecución también se cancela la generación del agente.\nTenga en cuenta que esto solo se aplica al botón de detener, no a ctrl+c dentro del terminal.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether cmd-click (ctrl-click on Linux and Windows) opens hyperlinks even\nwhen the terminal application has enabled mouse reporting (e.g. vim with\nmouse=a, htop). When false, these clicks are forwarded to the application\ninstead, and hyperlinks can still be opened with shift-cmd-click\n(shift-ctrl-click).\n\nDefault: true"
msgstr "Indica si cmd-clic (ctrl-clic en Linux y Windows) abre los hipervínculos incluso cuando la aplicación del terminal ha habilitado el informe del mouse (p. ej., vim con mouse=a, htop). Si es false, estos clics se reenvían a la aplicación y los hipervínculos se pueden seguir abriendo con shift-cmd-clic (shift-ctrl-clic).\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether cursor movement animation is enabled.\n\nDefault: false"
msgstr "Indica si la animación del movimiento del cursor está habilitada.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether every new terminal starts recording its output automatically.\n\nDefault: false"
msgstr "Indica si todos los terminales nuevos empiezan a grabar su salida automáticamente.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether hovering a name in C and C++ also shows what its type holds\n(members, enumerators, a macro's definition), found by name in the\nindex.\n\nDefault: true"
msgstr "Indica si al pasar el cursor sobre un nombre en C y C++ también se muestra el contenido de su tipo (miembros, enumeradores, la definición de una macro), buscado por nombre en el índice.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether indentation of pasted content should be adjusted based on the context.\n\nDefault: true"
msgstr "Indica si la sangría del contenido pegado se ajusta según el contexto.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether invoking a panel's `ToggleFocus` action while the panel is\nalready focused closes the panel, instead of just moving focus back\nto the editor. This only applies to a panel's focus-toggle action, not\nto its regular visibility-toggle action.\n\nDefault: false"
msgstr "Indica si al invocar la acción `ToggleFocus` de un panel mientras ya tiene el foco se cierra el panel, en lugar de solo devolver el foco al editor. Esto solo se aplica a la acción de alternar el foco de un panel, no a su acción normal de alternar la visibilidad.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether newly opened file diffs show the full file instead of changes only.\n\nDefault: true"
msgstr "Indica si las diferencias de archivo recién abiertas muestran el archivo completo en lugar de solo los cambios.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether opening a folder in an existing window automatically opens the\nThreads Sidebar. Applies when `default_open_behavior` or\n`cli_default_open_behavior` is set to `existing_window`.\n\nDefault: true"
msgstr "Indica si al abrir una carpeta en una ventana existente se abre automáticamente la barra lateral de conversaciones. Se aplica cuando `default_open_behavior` o `cli_default_open_behavior` está establecido en `existing_window`.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not selecting text in the terminal will automatically\ncopy to the system clipboard.\n\nDefault: false"
msgstr "Indica si al seleccionar texto en el terminal se copia automáticamente en el portapapeles del sistema.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether or not to automatically check for updates.\n\nDefault: false"
msgstr "Indica si se buscan actualizaciones automáticamente.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer edits.\n\nSet to 0 to disable debouncing.\n\nDefault: 700"
msgstr "Indica si se aplica debounce a las actualizaciones de las sugerencias insertadas después de editar el búfer.\n\nEstablézcalo en 0 para deshabilitar el debounce.\n\nValor predeterminado: 700"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer scrolls.\n\nSet to 0 to disable debouncing.\n\nDefault: 50"
msgstr "Indica si se aplica debounce a las actualizaciones de las sugerencias insertadas después de desplazar el búfer.\n\nEstablézcalo en 0 para deshabilitar el debounce.\n\nValor predeterminado: 50"

msgctxt "settings schema"
msgid "Whether or not to enable Helix mode.\n\nDefault: false"
msgstr "Indica si se habilita el modo Helix.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether or not to enable Vim mode.\n\nDefault: false"
msgstr "Indica si se habilita el modo Vim.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether or not to ensure there's a single newline at the end of a buffer\nwhen saving it.\n\nDefault: true"
msgstr "Indica si se garantiza que haya un único salto de línea al final de un búfer al guardarlo.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to include warning diagnostics.\n\nDefault: true"
msgstr "Indica si se incluyen los diagnósticos de advertencia.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to keep the tab bar buttons on panes that are not active.\nWhen disabled, only the focused pane shows them, so a split leaves the\nother panes without a new / split / zoom button.\n\nDefault: true"
msgstr "Indica si se mantienen los botones de la barra de pestañas en los paneles divididos que no están activos.\nSi está deshabilitado, solo el panel dividido con el foco los muestra, por lo que al dividir, los demás paneles divididos quedan sin botón de nuevo / dividir / zoom.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to perform a buffer format before saving.\n\nDefault: on"
msgstr "Indica si se formatea el búfer antes de guardarlo.\n\nValor predeterminado: on"

msgctxt "settings schema"
msgid "Whether or not to prompt the user to confirm before closing the application.\n\nDefault: false"
msgstr "Indica si se pide confirmación al usuario antes de cerrar la aplicación.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether or not to remove any trailing whitespace from lines of a buffer\nbefore saving it.\n\nDefault: true"
msgstr "Indica si se quitan los espacios en blanco finales de las líneas de un búfer antes de guardarlo.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to restore unsaved buffers on restart.\n\nIf this is true, user won't be prompted whether to save/discard\ndirty files when closing the application.\n\nDefault: true"
msgstr "Indica si se restauran los búferes sin guardar al reiniciar.\n\nSi es true, no se preguntará al usuario si desea guardar o descartar los archivos modificados al cerrar la aplicación.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: on"
msgstr "Indica si se muestran en línea los datos de autoría de git en la línea que tiene el foco.\n\nValor predeterminado: on"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: true"
msgstr "Indica si se muestran en línea los datos de autoría de git en la línea que tiene el foco.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to show inline diagnostics\n\nDefault: false"
msgstr "Indica si se muestran los diagnósticos en línea\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether or not to show pinned tabs in a separate row.\nWhen enabled, pinned tabs appear in a top row and unpinned tabs in a bottom row.\n\nDefault: false"
msgstr "Indica si las pestañas fijadas se muestran en una fila aparte.\nSi está habilitado, las pestañas fijadas aparecen en una fila superior y las no fijadas, en una fila inferior.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether or not to show the call status icon in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el icono del estado de la llamada en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to show the git gutter.\n\nDefault: tracked_files"
msgstr "Indica si se muestra el margen de git.\n\nValor predeterminado: tracked_files"

msgctxt "settings schema"
msgid "Whether or not to show the navigation history buttons in the tab bar.\n\nDefault: true"
msgstr "Indica si se muestran los botones del historial de navegación en la barra de pestañas.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar buttons.\n\nDefault: true"
msgstr "Indica si se muestran los botones de la barra de pestañas.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar in the editor.\n\nDefault: true"
msgstr "Indica si se muestra la barra de pestañas en el editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether or not to skip worktree trust checks.\nWhen trusted, project settings are synchronized automatically,\nlanguage and MCP servers are downloaded and started automatically.\n\nDefault: false"
msgstr "Indica si se omiten las comprobaciones de confianza del worktree.\nCuando es de confianza, la configuración del proyecto se sincroniza automáticamente y los servidores de lenguaje y MCP se descargan e inician automáticamente.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether other hints should be shown.\n\nDefault: true"
msgstr "Indica si se muestran las demás sugerencias.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether parameter hints should be shown.\n\nDefault: true"
msgstr "Indica si se muestran las sugerencias de parámetros.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether pressing enter should first append two spaces to the current line,\nwhich is how Markdown spells a hard line break. Lines where the break would\nbe dropped (headings, tables, list items, code fences, blank lines, and lines\nthat already end in a break) are left alone.\n\nDefault: false"
msgstr "Indica si al presionar Enter se agregan primero dos espacios al final de la línea actual, que es como Markdown escribe un salto de línea forzado. Las líneas en las que el salto se perdería (encabezados, tablas, elementos de lista, delimitadores de bloques de código, líneas en blanco y líneas que ya terminan en un salto) no se modifican.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may always reach any host over the\nnetwork without prompting.\nDefault: false"
msgstr "Indica si los comandos de terminal en el sandbox siempre pueden acceder a cualquier host por la red sin preguntar.\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may write anywhere on the\nfilesystem except protected paths. That is nearly the same as running\noutside the sandbox, so while this is on terminal commands are never\nauto-approved: each one asks first.\nDefault: false"
msgstr "Indica si los comandos de terminal en el sandbox pueden escribir en cualquier lugar del sistema de archivos excepto en las rutas protegidas. Eso equivale casi a ejecutarse fuera del sandbox, por lo que, mientras esté activado, los comandos de terminal nunca se aprueban automáticamente: cada uno pregunta primero.\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether sticky scroll is enabled.\n\nDefault: false"
msgstr "Indica si el desplazamiento fijo está habilitado.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the Agent is enabled.\n\nDefault: true"
msgstr "Indica si el agente está habilitado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the Copilot Next Edit Suggestions feature is enabled.\n\nDefault: true"
msgstr "Indica si la función Copilot Next Edit Suggestions está habilitada.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the Jupyter feature is enabled.\n\nDefault: true"
msgstr "Indica si la función de Jupyter está habilitada.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the agent panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Indica si el panel del agente debe abrirse al iniciar, aunque su dock estuviera cerrado la última vez.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the agent panel should use flexible (proportional) sizing when docked to the\nleft or right.\n\nWhen enabled, `default_width` does not control the panel width, and resetting the panel\nrestores the default proportion.\n\nDefault: true"
msgstr "Indica si el panel del agente usa un tamaño flexible (proporcional) cuando está acoplado a la izquierda o a la derecha.\n\nSi está habilitado, `default_width` no controla el ancho del panel, y al restablecer el panel se recupera la proporción predeterminada.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the breakpoints should be reused across Zed sessions.\n\nDefault: true"
msgstr "Indica si los puntos de interrupción se reutilizan entre sesiones de ForgeKairos.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the browser panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Indica si el panel del navegador debe abrirse al iniciar, aunque su dock estuviera cerrado la última vez.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the built-in browser goes through the egress allowlist proxy.\n\nThe browser is human-driven, so like the terminal it is outside egress\ncontrol by default.\n\nDefault: false"
msgstr "Indica si el navegador integrado pasa por el proxy de la lista de permitidos del tráfico saliente.\n\nEl navegador lo maneja una persona, por lo que, al igual que el terminal, de forma predeterminada queda fuera del control del tráfico saliente.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the context server is enabled."
msgstr "Indica si el servidor de contexto está habilitado."

msgctxt "settings schema"
msgid "Whether the cursor blinks in the editor.\n\nDefault: true"
msgstr "Indica si el cursor parpadea en el editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the editor search results will loop\n\nDefault: true"
msgstr "Indica si los resultados de búsqueda del editor vuelven al principio al llegar al final\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the editor will scroll beyond the last line.\n\nDefault: one_page"
msgstr "Indica si el editor se desplaza más allá de la última línea.\n\nValor predeterminado: one_page"

msgctxt "settings schema"
msgid "Whether the focused panel follows the mouse location\nDefault: false"
msgstr "Indica si el panel con el foco sigue la posición del mouse\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the folders of the macro picker start collapsed when it opens.\n\nDefault: false"
msgstr "Indica si las carpetas del selector de macros empiezan contraídas al abrirlo.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the git panel should open on startup.\n\nDefault: false"
msgstr "Indica si el panel de Git debe abrirse al iniciar.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the hover popover sticks when the mouse moves toward it,\nallowing interaction with its contents before it disappears.\n\nDefault: true"
msgstr "Indica si la ventana emergente al pasar el cursor se mantiene cuando el mouse se mueve hacia ella, lo que permite interactuar con su contenido antes de que desaparezca.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the line numbers on editors gutter are relative or not.\nWhen \"enabled\" shows relative number of buffer lines, when \"wrapped\" shows\nrelative number of display lines.\n\nDefault: \"disabled\""
msgstr "Indica si los números de línea del margen de los editores son relativos o no.\nCon \"enabled\" se muestra el número relativo de líneas del búfer; con \"wrapped\", el número relativo de líneas mostradas.\n\nValor predeterminado: \"disabled\""

msgctxt "settings schema"
msgid "Whether the microphone should be muted when joining a channel or a call.\n\nDefault: false"
msgstr "Indica si el micrófono se silencia al unirse a un canal o a una llamada.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the model emits reasoning/thinking content."
msgstr "Indica si el modelo emite contenido de razonamiento/pensamiento."

msgctxt "settings schema"
msgid "Whether the model emits thinking (reasoning) content."
msgstr "Indica si el modelo emite contenido de razonamiento."

msgctxt "settings schema"
msgid "Whether the model supports tools"
msgstr "Indica si el modelo admite herramientas"

msgctxt "settings schema"
msgid "Whether the model supports tools."
msgstr "Indica si el modelo admite herramientas."

msgctxt "settings schema"
msgid "Whether the model supports vision"
msgstr "Indica si el modelo admite visión"

msgctxt "settings schema"
msgid "Whether the model supports vision."
msgstr "Indica si el modelo admite visión."

msgctxt "settings schema"
msgid "Whether the panel follows the cursor, making the function under it the\nroot whenever the cursor moves. When off, the root changes only when\nasked for.\n\nDefault: false"
msgstr "Indica si el panel sigue al cursor y convierte la función bajo él en la raíz cada vez que el cursor se mueve. Si está desactivado, la raíz solo cambia cuando se solicita.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether the project panel should open on startup.\n\nDefault: true"
msgstr "Indica si el panel de proyecto debe abrirse al iniciar.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the regex is case-sensitive.\nDefault: false (case-insensitive)"
msgstr "Indica si la expresión regular distingue mayúsculas y minúsculas.\nValor predeterminado: false (no distingue mayúsculas y minúsculas)"

msgctxt "settings schema"
msgid "Whether the remote host should make its outgoing HTTP(S) requests —\nlanguage server and node downloads, extension archives, agent binaries\n— through this machine instead of its own network.\n\nThis is what makes a remote host that has no internet access able to\ninstall language servers at all, and it puts those downloads under this\nmachine's network allowlist, consent prompts and proxy. Turn it off to\nhave the remote host connect out on its own.\n\nDefault: true"
msgstr "Indica si el host remoto realiza sus solicitudes HTTP(S) salientes (descargas de servidores de lenguaje y de node, archivos de extensiones, binarios de agentes) a través de este equipo en lugar de su propia red.\n\nEsto es lo que permite que un host remoto sin acceso a internet pueda instalar servidores de lenguaje, y somete esas descargas a la lista de permitidos de red, las solicitudes de consentimiento y el proxy de este equipo. Desactívelo para que el host remoto se conecte por su cuenta.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the terminal panel should open on startup.\n\nDefault: true"
msgstr "Indica si el panel del terminal debe abrirse al iniciar.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the terminal panel should use flexible (proportional) sizing.\n\nDefault: true"
msgstr "Indica si el panel del terminal usa un tamaño flexible (proporcional).\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the text selection should have rounded corners.\n\nDefault: true"
msgstr "Indica si la selección de texto tiene esquinas redondeadas.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether the window-wide threads sidebar is available at all.\n\nDefault: false"
msgstr "Indica si la barra lateral de conversaciones de toda la ventana está disponible.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether this agent always launches outside the sandbox, without asking.\n\nOutside, writes are not restricted, and network restrictions only apply\nto programs that read the proxy settings. Can only be set in the user\nsettings, not in a project's settings (`.zed/settings.json`).\n\nDefault: false"
msgstr "Indica si este agente siempre se inicia fuera del sandbox, sin preguntar.\n\nFuera, las escrituras no están restringidas y las restricciones de red solo se aplican a los programas que leen la configuración del proxy. Solo se puede establecer en la configuración de usuario, no en la configuración de un proyecto (`.zed/settings.json`).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether this agent may offer signing in with a subscription (an\nauthentication method such as `/login`).\n\nWhen `false`, the agent's sign-in disappears from the authentication card\nand is refused when it is requested another way. Using an API key works\nregardless of this setting.\n\nDefault: true"
msgstr "Indica si este agente puede ofrecer el inicio de sesión con una suscripción (un método de autenticación como `/login`).\n\nSi es `false`, el inicio de sesión del agente desaparece de la tarjeta de autenticación y se rechaza cuando se solicita de otra forma. El uso de una clave de API funciona independientemente de esta opción.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether this custom Mantle model supports OpenAI reasoning effort parameters."
msgstr "Indica si este modelo personalizado de Mantle admite los parámetros de esfuerzo de razonamiento de OpenAI."

msgctxt "settings schema"
msgid "Whether to align detail text in code completions context menus left or right.\n\nDefault: left"
msgstr "Indica si el texto de detalle de los menús contextuales de autocompletado de código se alinea a la izquierda o a la derecha.\n\nValor predeterminado: left"

msgctxt "settings schema"
msgid "Whether to allow drag and drop text selection in buffer."
msgstr "Indica si se permite la selección de texto mediante arrastrar y colocar en el búfer."

msgctxt "settings schema"
msgid "Whether to allow horizontal scrolling in the project panel.\nWhen false, the view is locked to the leftmost position and\nlong file names are clipped.\n\nDefault: true"
msgstr "Indica si se permite el desplazamiento horizontal en el panel de proyecto.\nSi es false, la vista se fija en la posición más a la izquierda y los nombres de archivo largos se recortan.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to allow windows to tab together based on the user's tabbing preference (macOS only).\n\nDefault: false"
msgstr "Indica si se permite agrupar las ventanas en pestañas según la preferencia de pestañas del usuario (solo macOS).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to always show the close button on tabs.\n\nDefault: false"
msgstr "Indica si se muestra siempre el botón de cerrar en las pestañas.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to always use cmd-enter (or ctrl-enter on Linux or Windows) to send messages in the agent panel.\n\nDefault: false"
msgstr "Indica si se usa siempre cmd-enter (o ctrl-enter en Linux o Windows) para enviar mensajes en el panel del agente.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to attempt to restore previous file's state when opening it again.\nThe state is stored per pane.\nWhen disabled, defaults are applied instead of the state restoration.\n\nE.g. for editors, selections, folds and scroll positions are restored, if the same file is closed and, later, opened again in the same pane.\nWhen disabled, a single selection in the very beginning of the file, zero scroll position and no folds state is used as a default.\n\nDefault: true"
msgstr "Indica si se intenta restaurar el estado anterior de un archivo al volver a abrirlo.\nEl estado se guarda por panel dividido.\nSi está deshabilitado, se aplican los valores predeterminados en lugar de restaurar el estado.\n\nP. ej., en los editores se restauran las selecciones, los plegados y las posiciones de desplazamiento si el mismo archivo se cierra y, más tarde, se vuelve a abrir en el mismo panel dividido.\nSi está deshabilitado, se usa de forma predeterminada una única selección al principio del archivo, la posición de desplazamiento cero y ningún plegado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to automatically attach the active editor to every message that\nis sent: the selected lines when there is a selection, otherwise the\nwhole file. A file that is already mentioned by hand is not attached\ntwice.\n\nDefault: false"
msgstr "Indica si se adjunta automáticamente el editor activo a cada mensaje que se envía: las líneas seleccionadas si hay una selección; de lo contrario, el archivo completo. Un archivo que ya se mencionó manualmente no se adjunta dos veces.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to automatically close JSX tags."
msgstr "Indica si se deben cerrar automáticamente las etiquetas JSX."

msgctxt "settings schema"
msgid "Whether to automatically close files that have been deleted on disk.\n\nDefault: false"
msgstr "Indica si se cierran automáticamente los archivos que se han eliminado del disco.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to automatically compact the agent's context when it grows too\nlarge, summarizing earlier messages to free up room in the model's\ncontext window.\n\nDefault: true"
msgstr "Indica si se compacta automáticamente el contexto del agente cuando crece demasiado, resumiendo los mensajes anteriores para liberar espacio en la ventana de contexto del modelo.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to automatically detect the language of an untitled buffer from its contents.\nLanguages explicitly selected from the language selector are not changed.\n\nDefault: true"
msgstr "Indica si se detecta automáticamente el lenguaje de un búfer sin título a partir de su contenido.\nLos lenguajes seleccionados explícitamente en el selector de lenguajes no se cambian.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to automatically discover models served by the llama.cpp server.\nDefaults to true."
msgstr "Indica si se detectan automáticamente los modelos que ofrece el servidor de llama.cpp.\nEl valor predeterminado es true."

msgctxt "settings schema"
msgid "Whether to automatically open Markdown files in the preview.\n\nDefault: false"
msgstr "Indica si los archivos Markdown se abren automáticamente en la vista previa.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to automatically open files after pasting or duplicating them.\n\nDefault: true"
msgstr "Indica si los archivos se abren automáticamente después de pegarlos o duplicarlos.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to automatically open files dropped from external sources.\n\nDefault: true"
msgstr "Indica si se abren automáticamente los archivos soltados desde orígenes externos.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to automatically open newly created files in the editor.\n\nDefault: true"
msgstr "Indica si los archivos recién creados se abren automáticamente en el editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to automatically open the menus in the title bar on hover.\n\nDefault: false"
msgstr "Indica si los menús de la barra de título se abren automáticamente al pasar el cursor por encima.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to automatically show a signature help pop-up or not.\n\nDefault: false"
msgstr "Indica si se muestra automáticamente una ventana emergente de ayuda de firma.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to automatically surround text with characters for you. For example,\nwhen you select text and type '(', Zed will automatically surround text with ().\n\nDefault: true"
msgstr "Indica si el texto se rodea automáticamente con caracteres. Por ejemplo, al seleccionar texto y escribir '(', ForgeKairos rodeará automáticamente el texto con ().\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to automatically type closing characters for you. For example,\nwhen you type '(', Zed will automatically add a closing ')' at the correct position.\n\nDefault: true"
msgstr "Indica si se escriben automáticamente los caracteres de cierre. Por ejemplo, al escribir '(', ForgeKairos agregará automáticamente un ')' de cierre en la posición correcta.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to build dev container images with BuildKit.\n\nWhen unset, Zed auto-detects BuildKit by probing for the `buildx` CLI\nplugin. Set to `false` to force the classic Docker builder, which is\nrequired for Docker-compatible engines that lack an integrated BuildKit\n(e.g. Apple Container via a Docker-API bridge), where BuildKit builds\ncannot resolve locally-built images.\n\nDefault: null (auto-detect)"
msgstr "Indica si las imágenes de contenedores de desarrollo se compilan con BuildKit.\n\nSi no se establece, ForgeKairos detecta automáticamente BuildKit comprobando si existe el complemento `buildx` de la CLI. Establézcalo en `false` para forzar el compilador clásico de Docker, necesario para los motores compatibles con Docker que no incluyen BuildKit integrado (p. ej., Apple Container mediante un puente de la API de Docker), en los que las compilaciones de BuildKit no pueden resolver las imágenes compiladas localmente.\n\nValor predeterminado: null (detección automática)"

msgctxt "settings schema"
msgid "Whether to center the cursor on each search match when navigating."
msgstr "Indica si se centra el cursor en cada coincidencia de búsqueda al navegar."

msgctxt "settings schema"
msgid "Whether to close the window when using 'close active item' on a workspace with no tabs\n\nDefault: auto (\"on\" on macOS, \"off\" otherwise)"
msgstr "Indica si se cierra la ventana al usar 'cerrar el elemento activo' en un área de trabajo sin pestañas\n\nValor predeterminado: auto (\"on\" en macOS, \"off\" en los demás sistemas)"

msgctxt "settings schema"
msgid "Whether to collapse untracked files in the diff panel.\n\nDefault: false"
msgstr "Indica si se contraen los archivos sin seguimiento en el panel de diferencias.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to collect timing data for foreground and background executor\ntasks. Enabling this may lead to increased memory usage, hence it's\ndisabled by default for regular builds.\n\nDefault: false"
msgstr "Indica si se recopilan datos de tiempo de las tareas de los ejecutores en primer y segundo plano. Habilitarlo puede aumentar el uso de memoria, por lo que está deshabilitado de forma predeterminada en las compilaciones normales.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to continue markdown lists when pressing enter.\n\nDefault: true"
msgstr "Indica si las listas de Markdown continúan al presionar Enter.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to disable all AI features in Zed.\n\nDefault: false"
msgstr "Indica si se deshabilitan todas las funciones de IA en ForgeKairos.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to display Agent review buttons in the editor toolbar.\nOnly applicable while reviewing a file edited by the Agent.\n\nDefault: true"
msgstr "Indica si se muestran los botones de revisión del agente en la barra de herramientas del editor.\nSolo se aplica al revisar un archivo editado por el agente.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to display agent edits in single-file editors in addition to the review multibuffer pane.\n\nDefault: false"
msgstr "Indica si las ediciones del agente se muestran en los editores de un solo archivo, además de en el panel de revisión del multibúfer.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to display breadcrumbs in the editor toolbar.\n\nDefault: true"
msgstr "Indica si se muestran las rutas de navegación en la barra de herramientas del editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to display code action buttons in the editor toolbar.\n\nDefault: false"
msgstr "Indica si se muestran los botones de acciones de código en la barra de herramientas del editor.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to display code lenses from language servers above code elements."
msgstr "Indica si se muestran los CodeLens de los servidores de lenguaje encima de los elementos de código."

msgctxt "settings schema"
msgid "Whether to display indent guides in the editor.\n\nDefault: true"
msgstr "Indica si se muestran las guías de sangría en el editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to display inline and alongside documentation for items in the\ncompletions menu.\n\nDefault: true"
msgstr "Indica si se muestra la documentación en línea y al lado de los elementos del menú de autocompletado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to display quick action buttons in the editor toolbar.\n\nDefault: true"
msgstr "Indica si se muestran los botones de acciones rápidas en la barra de herramientas del editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to display the Markdown formatting row below the editor toolbar\nwhile a Markdown file is open.\n\nDefault: true"
msgstr "Indica si se muestra la fila de formato de Markdown debajo de la barra de herramientas del editor mientras hay un archivo Markdown abierto.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to display the active language button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del lenguaje activo en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to display the terminal title in breadcrumbs inside the terminal pane.\nOnly shown if the terminal title is not empty.\n\nThe shell running in the terminal needs to be configured to emit the title.\nExample: `echo -e \"\\e]2;New Title\\007\";`\n\nDefault: true"
msgstr "Indica si se muestra el título del terminal en las rutas de navegación dentro del panel dividido del terminal.\nSolo se muestra si el título del terminal no está vacío.\n\nEl shell que se ejecuta en el terminal debe estar configurado para emitir el título.\nEjemplo: `echo -e \"\\e]2;New Title\\007\";`\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to enable drag-and-drop operations in the project panel.\n\nDefault: true"
msgstr "Indica si se habilitan las operaciones de arrastrar y colocar en el panel de proyecto.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to enable middle-click paste on Linux\n\nDefault: true"
msgstr "Indica si se habilita pegar con clic con el botón central en Linux\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to enable think mode"
msgstr "Indica si se habilita el modo de razonamiento"

msgctxt "settings schema"
msgid "Whether to enable word diff highlighting in the editor.\n\nWhen enabled, changed words within modified lines are highlighted\nto show exactly what changed.\n\nDefault: true"
msgstr "Indica si se habilita el resaltado de diferencias por palabras en el editor.\n\nSi está habilitado, las palabras cambiadas dentro de las líneas modificadas se resaltan para mostrar exactamente qué cambió.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to expose this window over the loopback IDE server, so that\nexternal agents such as the Claude Code CLI can read the open editors,\nthe selection and the diagnostics, and show diffs inside Zed.\n\nDefault: false"
msgstr "Indica si esta ventana se expone mediante el servidor IDE de loopback, para que agentes externos como la CLI de Claude Code puedan leer los editores abiertos, la selección y los diagnósticos, y mostrar diferencias dentro de ForgeKairos.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to fetch LSP completions or not.\n\nDefault: true"
msgstr "Indica si se obtienen autocompletados de LSP.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to filter ANSI/VT escape sequences so the log reads as plain\ntext, the way TeraTerm's text log does.\n\nDefault: true"
msgstr "Indica si se filtran las secuencias de escape ANSI/VT para que el registro se lea como texto sin formato, como hace el registro de texto de TeraTerm.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to fold directories automatically\nwhen directory has only one directory inside.\n\nDefault: true"
msgstr "Indica si los directorios se pliegan automáticamente cuando un directorio contiene un solo directorio.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to follow-up empty go to definition responses from the language server or not.\n`FindAllReferences` allows to look up references of the same symbol instead.\n`None` disables the fallback.\n\nDefault: FindAllReferences"
msgstr "Indica si se hace un seguimiento de las respuestas vacías de ir a la definición del servidor de lenguaje.\n`FindAllReferences` permite buscar en su lugar las referencias del mismo símbolo.\n`None` deshabilita esta alternativa.\n\nValor predeterminado: FindAllReferences"

msgctxt "settings schema"
msgid "Whether to format dap messages in when adding them to debug adapter logger\n\nDefault: true"
msgstr "Indica si se formatean los mensajes DAP al agregarlos al registrador del adaptador de depuración\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to give agents Zed's IDE tools (the `zed` MCP server: highlights,\nannotations, code tours, hover, definitions, references and symbol\nsearch), in the Claude Code CLI tabs and in external agents' sessions\nalike. Independent of `enabled`: the server starts for them on demand\nand writes no lock file unless `enabled` is on.\n\nDefault: true"
msgstr "Indica si se dan a los agentes las herramientas del IDE de ForgeKairos (el servidor MCP `zed`: resaltados, anotaciones, recorridos de código, información al pasar el cursor, definiciones, referencias y búsqueda de símbolos), tanto en las pestañas de la CLI de Claude Code como en las sesiones de agentes externos. Es independiente de `enabled`: el servidor se inicia para ellos cuando se necesita y no escribe ningún archivo de bloqueo salvo que `enabled` esté activado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to have edit cards in the agent panel expanded, showing a preview of the full diff.\n\nDefault: true"
msgstr "Indica si las tarjetas de edición del panel del agente se muestran expandidas, con una vista previa de las diferencias completas.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to have terminal cards in the agent panel expanded, showing the whole command output.\n\nDefault: true"
msgstr "Indica si las tarjetas de terminal del panel del agente se muestran expandidas, con toda la salida del comando.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to hide gitignore files in the project panel.\n\nDefault: false"
msgstr "Indica si se ocultan los archivos ignorados por gitignore en el panel de proyecto.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to hide symbols, excerpts and search matches in the outline panel\nwhen a multi-buffer view (e.g. a diff or search results) is active,\nshowing only files and directories.\nDoes not affect single-file views.\n\nDefault: false"
msgstr "Indica si se ocultan los símbolos, extractos y coincidencias de búsqueda en el panel de esquema cuando hay una vista de multibúfer activa (p. ej., diferencias o resultados de búsqueda), mostrando solo archivos y directorios.\nNo afecta a las vistas de un solo archivo.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to hide the hidden entries in the project panel.\n\nDefault: false"
msgstr "Indica si se ocultan las entradas ocultas en el panel de proyecto.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to hide the root entry when only one folder is open in the window.\n\nDefault: false"
msgstr "Indica si se oculta la entrada raíz cuando solo hay una carpeta abierta en la ventana.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to highlight all occurrences of the selected text in an editor.\n\nDefault: true"
msgstr "Indica si se resaltan todas las apariciones del texto seleccionado en un editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to include gitignored files in search results."
msgstr "Indica si se incluyen los archivos ignorados por Git en los resultados de búsqueda."

msgctxt "settings schema"
msgid "Whether to include project rules files (AGENTS.md, CLAUDE.md, .rules, etc.)\nin the prompt when generating git commit messages.\n\nDefault: true"
msgstr "Indica si se incluyen los archivos de reglas del proyecto (AGENTS.md, CLAUDE.md, .rules, etc.) en el prompt al generar mensajes de commit de git.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to include text channels in file finder results.\n\nDefault: false"
msgstr "Indica si se incluyen los canales de texto en los resultados del buscador de archivos.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to indent lines using tab characters, as opposed to multiple\nspaces.\n\nDefault: false"
msgstr "Indica si las líneas se sangran con caracteres de tabulación en lugar de varios espacios.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to indent list items when pressing tab after a list marker.\n\nDefault: true"
msgstr "Indica si se aplica sangría a los elementos de lista al presionar Tab después de un marcador de lista.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to index files that `.gitignore` excludes (only the ones the\nproject panel has loaded: ignored folders are read when expanded).\n\nDefault: false"
msgstr "Indica si se indexan los archivos que excluye `.gitignore` (solo los que ha cargado el panel de proyecto: las carpetas ignoradas se leen al expandirlas).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to interpret the search query as a regular expression."
msgstr "Indica si se interpreta la consulta de búsqueda como una expresión regular."

msgctxt "settings schema"
msgid "Whether to keep tabs in preview mode when code navigation is used to navigate away from them.\nIf `enable_preview_file_from_code_navigation` or `enable_preview_multibuffer_from_code_navigation` is also true, the new tab may replace the existing one.\n\nDefault: false"
msgstr "Indica si las pestañas se mantienen en modo de vista previa cuando se usa la navegación de código para salir de ellas.\nSi `enable_preview_file_from_code_navigation` o `enable_preview_multibuffer_from_code_navigation` también es true, la nueva pestaña puede reemplazar a la existente.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to keep the system awake while agent threads are running.\n\nDefault: true"
msgstr "Indica si se impide que el sistema entre en suspensión mientras se ejecutan conversaciones del agente.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to keep the text selection after copying it to the clipboard.\n\nDefault: true"
msgstr "Indica si se mantiene la selección de texto después de copiarla en el portapapeles.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to limit the content width in the agent panel. When enabled,\ncontent will be constrained to `max_content_width` and centered when\nthe panel is wider than that value, for optimal readability.\n\nDefault: true"
msgstr "Indica si se limita el ancho del contenido en el panel del agente. Si está habilitado, el contenido se limita a `max_content_width` y se centra cuando el panel es más ancho que ese valor, para una legibilidad óptima.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to limit the width of the rendered markdown content. When\nenabled, content is constrained to `max_width` and centered\nhorizontally within the preview pane, for optimal readability.\n\nDefault: false"
msgstr "Indica si se limita el ancho del contenido Markdown representado. Si está habilitado, el contenido se limita a `max_width` y se centra horizontalmente dentro del panel de vista previa, para una legibilidad óptima.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to log messages between active debug adapters and Zed\n\nDefault: true"
msgstr "Indica si se registran los mensajes entre los adaptadores de depuración activos y ForgeKairos\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to match case sensitively."
msgstr "Indica si se distingue entre mayúsculas y minúsculas."

msgctxt "settings schema"
msgid "Whether to only match on whole words."
msgstr "Indica si solo se buscan palabras completas."

msgctxt "settings schema"
msgid "Whether to only show the inline blame information\nafter a delay once the cursor stops moving.\n\nDefault: 0"
msgstr "Indica si la información de autoría en línea solo se muestra tras un retraso una vez que el cursor deja de moverse.\n\nValor predeterminado: 0"

msgctxt "settings schema"
msgid "Whether to only show the inline diagnostics after a delay after the\nlast editor event.\n\nDefault: 150"
msgstr "Indica si los diagnósticos en línea solo se muestran tras un retraso desde el último evento del editor.\n\nValor predeterminado: 150"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a multibuffer.\n\nDefault: false"
msgstr "Indica si las pestañas se abren en modo de vista previa cuando se usa la navegación de código para abrir un multibúfer.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a single file.\n\nDefault: true"
msgstr "Indica si las pestañas se abren en modo de vista previa cuando se usa la navegación de código para abrir un solo archivo.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from a multibuffer.\n\nDefault: true"
msgstr "Indica si las pestañas se abren en modo de vista previa al abrirlas desde un multibúfer.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from the project panel\nwith a single click or the `project_panel::Open` action.\n\nDefault: true"
msgstr "Indica si las pestañas se abren en modo de vista previa al abrirlas desde el panel de proyecto con un solo clic o con la acción `project_panel::Open`.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when selected from the file finder.\n\nDefault: false"
msgstr "Indica si las pestañas se abren en modo de vista previa al seleccionarlas en el buscador de archivos.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to open tabular files such as CSV and TSV as a table (grid). When\noff, they open in the text editor.\n\nDefault: true"
msgstr "Indica si los archivos tabulares, como CSV y TSV, se abren como tabla (cuadrícula). Si está desactivado, se abren en el editor de texto.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to optimize Zed's interface for assistive technology such as\nscreen readers.\n\nDefault: false"
msgstr "Indica si se optimiza la interfaz de ForgeKairos para tecnologías de asistencia, como los lectores de pantalla.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to perform linked edits of associated ranges, if the language server supports it.\nFor example, when editing opening <html> tag, the contents of the closing </html> tag will be edited as well.\n\nDefault: true"
msgstr "Indica si se realizan ediciones vinculadas de los intervalos asociados, si el servidor de lenguaje lo admite.\nPor ejemplo, al editar la etiqueta de apertura <html>, también se edita el contenido de la etiqueta de cierre </html>.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to point out missing development tools in a notification and offer\nto install them from it. While connected to a remote host, the host is\nchecked and the tools are installed there.\n\nDefault: true"
msgstr "Indica si se avisa en una notificación de las herramientas de desarrollo que faltan y se ofrece instalarlas desde ella. Mientras hay una conexión a un host remoto, se comprueba ese host y las herramientas se instalan allí.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to pop the completions menu while typing in an editor without\nexplicitly requesting it.\n\nDefault: true"
msgstr "Indica si se muestra el menú de autocompletado mientras se escribe en un editor sin solicitarlo explícitamente.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to prefix each logged line with `[YYYY-MM-DD HH:MM:SS] `.\n\nDefault: false"
msgstr "Indica si cada línea registrada lleva el prefijo `[YYYY-MM-DD HH:MM:SS] `.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to prevent this project from being shared in public channels.\n\nDefault: false"
msgstr "Indica si se impide que este proyecto se comparta en canales públicos.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to pull for diagnostics or not.\n\nDefault: true"
msgstr "Indica si se solicitan (pull) los diagnósticos.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to query and display LSP `textDocument/documentLink` links in the editor.\n\nDefault: true"
msgstr "Indica si se consultan y muestran en el editor los enlaces LSP `textDocument/documentLink`.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to reduce non-essential motion in the UI, such as loading\nspinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Indica si se reduce el movimiento no esencial de la interfaz, como los indicadores giratorios de carga y las etiquetas pulsantes, mostrándolos en estado estático.\n\nValor predeterminado: off"

msgctxt "settings schema"
msgid "Whether to resize all the panels in a dock when resizing the dock.\n\nDefault: [\"left\"]"
msgstr "Indica si se cambia el tamaño de todos los paneles de un dock al cambiar el tamaño del dock.\n\nValor predeterminado: [\"left\"]"

msgctxt "settings schema"
msgid "Whether to reveal an already open file in an existing pane instead of opening it in the active pane.\n\nDefault: false"
msgstr "Indica si un archivo ya abierto se muestra en un panel dividido existente en lugar de abrirlo en el panel dividido activo.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to reveal it in the outline panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Indica si se muestra automáticamente en el panel de esquema cuando se activa la entrada del proyecto correspondiente. Las entradas ignoradas por Git nunca se muestran automáticamente.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to reveal it in the project panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Indica si se muestra automáticamente en el panel de proyecto cuando se activa la entrada del proyecto correspondiente. Las entradas ignoradas por Git nunca se muestran automáticamente.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to run agent terminal commands outside the OS sandbox, with\nZed's own permissions (the inverse of the settings UI's \"enable sandbox\"\nswitch). When true, the sandboxed terminal tool is not exposed and the\nsystem prompt omits the sandbox section, so the model uses the plain\n`terminal` tool; on Windows, WSL sandbox setup is skipped. Such commands\nare never auto-approved: each one asks first. Only the user sets this;\nthe agent has no way to ask for a command to run outside the sandbox.\nDefault: false"
msgstr "Indica si los comandos de terminal del agente se ejecutan fuera del sandbox del sistema operativo, con los permisos propios de ForgeKairos (lo contrario del interruptor \"habilitar sandbox\" de la interfaz de configuración). Si es true, no se ofrece la herramienta de terminal en el sandbox y el prompt del sistema omite la sección del sandbox, por lo que el modelo usa la herramienta `terminal` normal; en Windows se omite la preparación del sandbox de WSL. Estos comandos nunca se aprueban automáticamente: cada uno pide confirmación antes. Solo el usuario establece este valor; el agente no tiene forma de pedir que un comando se ejecute fuera del sandbox.\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to run the context server on the remote server when using remote development.\n\nIf this is false, the context server will always run on the local machine.\n\nDefault: false"
msgstr "Indica si el servidor de contexto se ejecuta en el servidor remoto al usar el desarrollo remoto.\n\nSi es false, el servidor de contexto siempre se ejecuta en el equipo local.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to scroll when clicking near the edge of the visible text area.\n\nDefault: false"
msgstr "Indica si se desplaza la vista al hacer clic cerca del borde del área de texto visible.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to send explicit `cache_control` breakpoints for prompt caching.\nLeave disabled if the provider rejects requests containing them."
msgstr "Indica si se envían puntos de interrupción `cache_control` explícitos para el almacenamiento en caché de prompts. Déjelo deshabilitado si el proveedor rechaza las solicitudes que los contienen."

msgctxt "settings schema"
msgid "Whether to show OpenCode Go models. Defaults to true."
msgstr "Indica si se deben mostrar los modelos OpenCode Go. El valor predeterminado es true."

msgctxt "settings schema"
msgid "Whether to show OpenCode Zen models. Defaults to true."
msgstr "Indica si se deben mostrar los modelos OpenCode Zen. El valor predeterminado es true."

msgctxt "settings schema"
msgid "Whether to show a background for inlay hints.\n\nIf set to `true`, the background will use the `hint.background` color\nfrom the current theme.\n\nDefault: false"
msgstr "Indica si se muestra un fondo para las sugerencias insertadas.\n\nSi se establece en `true`, el fondo usa el color `hint.background` del tema actual.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show a badge on the git panel icon with the count of uncommitted changes.\n\nDefault: false"
msgstr "Indica si se muestra en el icono del panel de Git una insignia con el número de cambios sin commit.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show a badge on the terminal panel icon with the count of open terminals.\n\nDefault: false"
msgstr "Indica si se muestra en el icono del panel del terminal una insignia con el número de terminales abiertos.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show a git status indicator next to file names in the project panel.\n\nDefault: false"
msgstr "Indica si se muestra un indicador de estado de Git junto a los nombres de archivo en el panel de proyecto.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show a single line break as a line break. When off, it is one\nspace as CommonMark specifies, and only two trailing spaces, `\\` or `<br>`\nbreak the line. Exporting to PDF follows the same setting.\n\nDefault: true"
msgstr "Indica si un salto de línea simple se muestra como salto de línea. Si está desactivado, equivale a un espacio, como especifica CommonMark, y solo dos espacios finales, `\\` o `<br>` saltan de línea. La exportación a PDF sigue la misma configuración.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show active line endings button in the status bar.\n\nDefault: false"
msgstr "Indica si se muestra en la barra de estado el botón del final de línea activo.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show an indicator while multi-stroke input is pending.\nIf the input has a timeout, a countdown is shown and hovering the indicator pauses it.\nIts binding preview popover is disabled when the which-key popup is enabled.\n\nDefault: true"
msgstr "Indica si se muestra un indicador mientras hay una entrada de varias pulsaciones pendiente. Si la entrada tiene un tiempo de espera, se muestra una cuenta atrás que se pausa al pasar el cursor por encima del indicador. Su ventana emergente de vista previa de atajos se deshabilita cuando está habilitada la ventana emergente which-key.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show author name as part of the commit information.\n\nDefault: false"
msgstr "Indica si se muestra el nombre del autor como parte de la información del commit.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show bookmarks in the gutter.\n\nDefault: true"
msgstr "Indica si se muestran los marcadores en el margen.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show breakpoints in the gutter.\n\nDefault: true"
msgstr "Indica si se muestran los puntos de interrupción en el margen.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show buffer search result indicators in the scrollbar.\n\nDefault: true"
msgstr "Indica si se muestran en la barra de desplazamiento los indicadores de resultados de búsqueda en el búfer.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show cells that contain line breaks in full, making the row\ntaller. When off, they are cut to one line.\n\nDefault: true"
msgstr "Indica si las celdas que contienen saltos de línea se muestran completas, haciendo la fila más alta. Si está desactivado, se recortan a una línea.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show code action button at start of buffer line.\n\nDefault: true"
msgstr "Indica si se muestra el botón de acciones de código al principio de la línea del búfer.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show commit summary as part of the inline blame.\n\nDefault: false"
msgstr "Indica si se muestra el resumen del commit como parte de la autoría en línea (blame).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show cursor positions in the scrollbar.\n\nDefault: true"
msgstr "Indica si se muestran las posiciones del cursor en la barra de desplazamiento.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show entries with tree or flat view in the panel\n\nDefault: false"
msgstr "Indica si las entradas del panel se muestran en vista de árbol o en vista plana\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show error and warning count badges next to file names in the project panel.\n\nDefault: false"
msgstr "Indica si se muestran insignias con el número de errores y advertencias junto a los nombres de archivo en el panel de proyecto.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show file icons in the file finder.\n\nDefault: true"
msgstr "Indica si se muestran los iconos de archivo en el buscador de archivos.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show file icons in the git panel.\n\nDefault: false"
msgstr "Indica si se muestran los iconos de archivo en el panel de Git.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show file icons in the outline panel.\n\nDefault: true"
msgstr "Indica si se muestran los iconos de archivo en el panel de esquema.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show file icons in the project panel.\n\nDefault: true"
msgstr "Indica si se muestran los iconos de archivo en el panel de proyecto.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show fold buttons in the gutter.\n\nDefault: true"
msgstr "Indica si se muestran los botones de plegado en el margen.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show folder names with bold text in the project panel.\n\nDefault: false"
msgstr "Indica si los nombres de carpeta se muestran en negrita en el panel de proyecto.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show git diff indicators in the scrollbar.\n\nDefault: true"
msgstr "Indica si se muestran los indicadores de diferencias de Git en la barra de desplazamiento.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show git status indicators on the branch icon in the title bar.\nWhen enabled, the branch icon changes to reflect the current repository\nstatus (e.g. modified, added, deleted, or conflict).\n\nDefault: false"
msgstr "Indica si se muestran indicadores de estado de Git en el icono de rama de la barra de título. Si está habilitado, el icono de rama cambia para reflejar el estado actual del repositorio (p. ej., modificado, agregado, eliminado o en conflicto).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show line numbers in the gutter.\n\nDefault: true"
msgstr "Indica si se muestran los números de línea en el margen.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show onboarding banners in the title bar.\n\nDefault: true"
msgstr "Indica si se muestran los banners de introducción en la barra de título.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show opened editors as preview tabs.\nPreview tabs do not stay open, are reused until explicitly set to be kept open opened (via double-click or editing) and show file names in italic.\n\nDefault: true"
msgstr "Indica si los editores abiertos se muestran como pestañas de vista previa. Las pestañas de vista previa no permanecen abiertas, se reutilizan hasta que se indica explícitamente que se mantengan abiertas (con doble clic o al editar) y muestran el nombre del archivo en cursiva.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show padding for zoomed panels.\nWhen enabled, zoomed bottom panels will have some top padding,\nwhile zoomed left/right panels will have padding to the right/left (respectively).\n\nDefault: true"
msgstr "Indica si se muestra relleno en los paneles ampliados. Si está habilitado, los paneles inferiores ampliados tienen algo de relleno superior, y los paneles izquierdo/derecho ampliados tienen relleno a la derecha/izquierda (respectivamente).\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show runnable buttons in the gutter.\n\nDefault: true"
msgstr "Indica si se muestran los botones de ejecución en el margen.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show selected symbol occurrences in the scrollbar.\n\nDefault: true"
msgstr "Indica si se muestran en la barra de desplazamiento las apariciones del símbolo seleccionado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show selected text occurrences in the scrollbar.\n\nDefault: true"
msgstr "Indica si se muestran en la barra de desplazamiento las apariciones del texto seleccionado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show small single-line outputs inline instead of in a block.\n\nDefault: true"
msgstr "Indica si las salidas pequeñas de una sola línea se muestran en línea en lugar de en un bloque.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show tabs and spaces in the editor."
msgstr "Indica si se deben mostrar tabulaciones y espacios en el editor."

msgctxt "settings schema"
msgid "Whether to show the AI browser panel button in the status bar while AI\ncontrol of the built-in browser is on.\n\nDefault: true"
msgstr "Indica si se muestra el botón del panel del navegador de IA en la barra de estado mientras el control del navegador integrado por la IA está activado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the Git file status on a tab item.\n\nDefault: false"
msgstr "Indica si se muestra el estado de Git del archivo en una pestaña.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show the LSP servers button in the status bar.\n\nDefault: `true`"
msgstr "Indica si se muestra el botón de servidores LSP en la barra de estado.\n\nValor predeterminado: `true`"

msgctxt "settings schema"
msgid "Whether to show the active encoding button in the status bar.\n\nDefault: non_utf8"
msgstr "Indica si se muestra el botón de la codificación activa en la barra de estado.\n\nValor predeterminado: non_utf8"

msgctxt "settings schema"
msgid "Whether to show the addition/deletion change count next to each file in the Git panel.\n\nDefault: true"
msgstr "Indica si se muestra el número de cambios (adiciones/eliminaciones) junto a cada archivo en el panel de Git.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the agent panel button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del panel del agente en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the avatar of the author of the commit.\n\nDefault: true"
msgstr "Indica si se muestra el avatar del autor del commit.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the branch name button in the titlebar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del nombre de la rama en la barra de título.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the browser panel button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del panel del navegador en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the call graph panel button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del panel de grafo de llamadas en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the cursor position button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón de la posición del cursor en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the debug button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón de depuración en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the file icon for a tab.\n\nDefault: false"
msgstr "Indica si se muestra el icono de archivo en una pestaña.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show the git status in the outline panel.\n\nDefault: true"
msgstr "Indica si se muestra el estado de Git en el panel de esquema.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the git status in the project panel.\n\nDefault: true"
msgstr "Indica si se muestra el estado de Git en el panel de proyecto.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the informational hover box when moving the mouse\nover symbols in the editor.\n\nDefault: true"
msgstr "Indica si se muestra el cuadro informativo al pasar el cursor del mouse por encima de los símbolos en el editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the menus in the title bar.\n\nDefault: false"
msgstr "Indica si se muestran los menús en la barra de título.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show the merge conflict indicator in the status bar\nthat offers to resolve conflicts using the agent.\n\nDefault: true"
msgstr "Indica si se muestra en la barra de estado el indicador de conflictos de fusión, que ofrece resolver los conflictos con el agente.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the name of the active file in the status bar.\n\nDefault: false"
msgstr "Indica si se muestra el nombre del archivo activo en la barra de estado.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show the outline panel button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del panel de esquema en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the panel button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del panel en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the project diagnostics button in the status bar."
msgstr "Indica si se debe mostrar el botón de diagnósticos del proyecto en la barra de estado."

msgctxt "settings schema"
msgid "Whether to show the project host and name in the titlebar.\n\nDefault: true"
msgstr "Indica si se muestran el host y el nombre del proyecto en la barra de título.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the project panel button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del panel de proyecto en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the project search button in the status bar."
msgstr "Indica si se debe mostrar el botón de búsqueda en el proyecto en la barra de estado."

msgctxt "settings schema"
msgid "Whether to show the selections menu in the editor toolbar.\n\nDefault: true"
msgstr "Indica si se muestra el menú de selecciones en la barra de herramientas del editor.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the sign in button in the title bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón de inicio de sesión en la barra de título.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the signature help pop-up after completions or bracket pairs inserted.\n\nDefault: false"
msgstr "Indica si se muestra la ventana emergente de ayuda de firma después de insertar autocompletados o pares de delimitadores.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show the stage and restore buttons on diff hunks.\n\nDefault: true"
msgstr "Indica si se muestran los botones de preparar y restaurar en los fragmentos de diferencias.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the status bar.\n\nDefault: true"
msgstr "Indica si se muestra la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the terminal button in the status bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del terminal en la barra de estado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the user menu button in the title bar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del menú de usuario en la barra de título.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show the which-key popup when holding down key combinations.\nWhen enabled, the pending keystrokes indicator remains visible, but its binding preview\npopover is disabled.\n\nDefault: false"
msgstr "Indica si se muestra la ventana emergente which-key al mantener presionadas combinaciones de teclas. Si está habilitado, el indicador de pulsaciones pendientes sigue visible, pero su ventana emergente de vista previa de atajos se deshabilita.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show the worktree name button in the titlebar.\n\nDefault: true"
msgstr "Indica si se muestra el botón del nombre del worktree en la barra de título.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show thumb buttons for feedback in the agent panel.\n\nDefault: true"
msgstr "Indica si se muestran los botones de pulgar arriba/abajo para enviar comentarios en el panel del agente.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show turn statistics (elapsed time during generation, final turn duration).\n\nDefault: false"
msgstr "Indica si se muestran las estadísticas del turno (tiempo transcurrido durante la generación y duración final del turno).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to show user avatar in the title bar.\n\nDefault: true"
msgstr "Indica si se muestra el avatar del usuario en la barra de título.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to show wrap guides in the editor. Setting this to true will\nshow a guide at the 'preferred_line_length' value if softwrap is set to\n'preferred_line_length', and will show any additional guides as specified\nby the 'wrap_guides' setting.\n\nDefault: true"
msgstr "Indica si se muestran las guías de ajuste en el editor. Si se establece en true, se muestra una guía en el valor de 'preferred_line_length' cuando softwrap está establecido en 'preferred_line_length', y se muestran las guías adicionales que especifique la configuración 'wrap_guides'.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to sort file and folder names case-sensitively in the project panel.\nThis works in combination with `sort_mode`. `sort_mode` controls how files and\ndirectories are grouped, while this setting controls how names are compared.\n\nDefault: default"
msgstr "Indica si los nombres de archivos y carpetas se ordenan distinguiendo mayúsculas y minúsculas en el panel de proyecto. Funciona en combinación con `sort_mode`: `sort_mode` controla cómo se agrupan los archivos y directorios, mientras que esta configuración controla cómo se comparan los nombres.\n\nValor predeterminado: default"

msgctxt "settings schema"
msgid "Whether to split the thread history into the agent panel itself,\nas a list to the left of the current thread.\n\nDefault: true"
msgstr "Indica si el historial de conversaciones se separa dentro del propio panel del agente, como una lista a la izquierda de la conversación actual.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to start a new line with a comment when a previous line is a comment as well.\n\nDefault: true"
msgstr "Indica si una línea nueva comienza con un comentario cuando la línea anterior también es un comentario.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to stick parent directories at top of the project panel.\n\nDefault: true"
msgstr "Indica si los directorios superiores se fijan en la parte superior del panel de proyecto.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to tell a connected Claude Code CLI which file is open when\nnothing is selected (the CLI shows it as \"In <file>\" and attaches the\nfile to the next message). When off, only a selection of one or more\nlines is sent.\n\nDefault: true"
msgstr "Indica si se comunica a la CLI de Claude Code conectada qué archivo está abierto cuando no hay nada seleccionado (la CLI lo muestra como \"In <file>\" y adjunta el archivo al siguiente mensaje). Si está desactivado, solo se envía una selección de una o más líneas.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to use additional LSP queries to format (and amend) the code after\nevery \"trigger\" symbol input, defined by LSP server capabilities.\n\nDefault: true"
msgstr "Indica si se usan consultas LSP adicionales para formatear (y corregir) el código después de cada entrada de un símbolo \"desencadenador\", definido por las capacidades del servidor LSP.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to use command history ranking for sorting in the command palette.\n\nDefault: true"
msgstr "Indica si se usa la clasificación del historial de comandos para ordenar en la paleta de comandos.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to use gitignored files when searching.\nOnly the file Zed had indexed will be used, not necessary all the gitignored files.\n\nDefault: Smart"
msgstr "Indica si se usan los archivos ignorados por Git al buscar. Solo se usan los archivos que ForgeKairos haya indexado, no necesariamente todos los archivos ignorados por Git.\n\nValor predeterminado: Smart"

msgctxt "settings schema"
msgid "Whether to use language servers to provide code intelligence.\n\nDefault: true"
msgstr "Indica si se usan servidores de lenguaje para proporcionar inteligencia de código.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to use the system provided dialogs for Open and Save As.\nWhen set to false, Zed will use the built-in keyboard-first pickers.\n\nDefault: true"
msgstr "Indica si se usan los cuadros de diálogo del sistema para Abrir y Guardar como. Si se establece en false, ForgeKairos usa los selectores integrados orientados al teclado.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to use the system provided prompts.\nWhen set to false, Zed will use the built-in prompts.\nNote that this setting has no effect on Linux, where Zed will always\nuse the built-in prompts.\n\nDefault: true"
msgstr "Indica si se usan los cuadros de diálogo del sistema. Si se establece en false, ForgeKairos usa los cuadros de diálogo integrados. Tenga en cuenta que esta configuración no tiene efecto en Linux, donde ForgeKairos siempre usa los cuadros de diálogo integrados.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to use tree-sitter bracket queries to detect and colorize the brackets in the editor.\n\nDefault: false"
msgstr "Indica si se usan consultas de corchetes de tree-sitter para detectar y colorear los corchetes en el editor.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether to warn (Windows/WSL only) when a sandbox grant targets a file on\na Windows-hosted (DrvFs) filesystem. Such grants are enforced inside WSL\nvia a translated path, and their sandbox-integrity guarantees are weaker\nthan a distro-native filesystem. When enabled, such grants show a warning\nthat must be acknowledged before the command runs.\nDefault: true"
msgstr "Indica si se muestra una advertencia (solo Windows/WSL) cuando una concesión del sandbox apunta a un archivo de un sistema de archivos alojado en Windows (DrvFs). Estas concesiones se aplican dentro de WSL mediante una ruta traducida, y sus garantías de integridad del sandbox son más débiles que las de un sistema de archivos nativo de la distribución. Si está habilitado, estas concesiones muestran una advertencia que debe confirmarse antes de que se ejecute el comando.\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to warn when a sandbox escalation prompt requests a domain or\nwrite path that contains potentially confusable Unicode characters\n(homoglyphs, invisible characters, or bidirectional overrides). When\nenabled, such prompts show a warning that must be acknowledged before\nthe request can be allowed.\nDefault: true"
msgstr "Indica si se muestra una advertencia cuando una solicitud de elevación de permisos del sandbox pide un dominio o una ruta de escritura que contiene caracteres Unicode potencialmente confusos (homoglifos, caracteres invisibles o invalidaciones bidireccionales). Si está habilitado, estas solicitudes muestran una advertencia que debe confirmarse antes de poder permitir la solicitud.\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether to zoom the editor font size with the mouse wheel\nwhile holding the primary modifier key (Cmd on macOS, Ctrl on other platforms).\n\nDefault: false"
msgstr "Indica si se cambia el tamaño de fuente del editor con la rueda del mouse mientras se mantiene presionada la tecla modificadora principal (Cmd en macOS, Ctrl en las demás plataformas).\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether type hints should be shown.\n\nDefault: true"
msgstr "Indica si se muestran las sugerencias de tipo.\n\nValor predeterminado: true"

msgctxt "settings schema"
msgid "Whether update checks also consider pre-releases. By default only releases are considered.\n\nDefault: false"
msgstr "Indica si la búsqueda de actualizaciones también tiene en cuenta las versiones preliminares. De forma predeterminada, solo se tienen en cuenta las versiones estables.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Whether your current project should be shared when joining an empty channel.\n\nDefault: false"
msgstr "Indica si se comparte el proyecto actual al unirse a un canal vacío.\n\nValor predeterminado: false"

msgctxt "settings schema"
msgid "Which base git features (gutter, file colors, git::Diff) diff against.\n\nDefault: head"
msgstr "Base con la que comparan las funciones de Git (margen, colores de archivo, git::Diff).\n\nValor predeterminado: head"

msgctxt "settings schema"
msgid "Which code actions to run on save before the formatter.\nThese are not run if formatting is off.\n\nDefault: {} (or {\"source.organizeImports\": true} for Go)."
msgstr "Acciones de código que se ejecutan al guardar, antes del formateador. No se ejecutan si el formateo está desactivado.\n\nValor predeterminado: {} (o {\"source.organizeImports\": true} para Go)."

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar.\n\nDefault: all"
msgstr "Indicadores de diagnóstico que se muestran en la barra de desplazamiento.\n\nValor predeterminado: all"

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar:\n\nDefault: all"
msgstr "Indicadores de diagnóstico que se muestran en la barra de desplazamiento:\n\nValor predeterminado: all"

msgctxt "settings schema"
msgid "Which dock gets a pair of panels arranged in it the first time a project\nis opened. The dock itself is not opened for it; each panel's\n`starts_open` decides that. Once a project has a saved dock layout, that\nlayout is restored instead and this setting no longer applies to it.\n\nDefault: right"
msgstr "Dock en el que se colocan dos paneles la primera vez que se abre un proyecto. El dock en sí no se abre por ello; lo decide el `starts_open` de cada panel. Cuando un proyecto ya tiene un diseño de docks guardado, se restaura ese diseño y esta configuración deja de aplicarse.\n\nValor predeterminado: right"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the project panel.\n\nDefault: all"
msgstr "Archivos con errores/advertencias de diagnóstico que se marcan en el panel de proyecto.\n\nValor predeterminado: all"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the tabs.\nThis setting can take the following three values:\n\nDefault: off"
msgstr "Archivos con errores/advertencias de diagnóstico que se marcan en las pestañas. Esta configuración admite los tres valores siguientes:\n\nValor predeterminado: off"

msgctxt "settings schema"
msgid "Which fullscreen mode the `zed::ToggleFullScreen` action enters (macOS only).\n\nDefault: native"
msgstr "Modo de pantalla completa al que entra la acción `zed::ToggleFullScreen` (solo macOS).\n\nValor predeterminado: native"

msgctxt "settings schema"
msgid "Which information to show in the branch picker.\n\nDefault: on"
msgstr "Información que se muestra en el selector de ramas.\n\nValor predeterminado: on"

msgctxt "settings schema"
msgid "Which level to use to filter out diagnostics displayed in the editor.\n\nAffects the editor rendering only, and does not interrupt\nthe functionality of diagnostics fetching and project diagnostics editor.\nWhich files containing diagnostic errors/warnings to mark in the tabs.\nDiagnostics are only shown when file icons are also active.\n\nShows all diagnostics if not specified.\n\nDefault: warning"
msgstr "Nivel que se usa para filtrar los diagnósticos que se muestran en el editor.\n\nSolo afecta a la representación del editor y no interrumpe la obtención de diagnósticos ni el editor de diagnósticos del proyecto. Archivos con errores/advertencias de diagnóstico que se marcan en las pestañas. Los diagnósticos solo se muestran cuando los iconos de archivo también están activos.\n\nSi no se especifica, se muestran todos los diagnósticos.\n\nValor predeterminado: warning"

msgctxt "settings schema"
msgid "Which sources the panel lists calls from: the language server, which\nis exact, the symbol index of C and C++ files, which matches names, or\nboth.\n\nDefault: all"
msgstr "Orígenes de los que el panel enumera las llamadas: el servidor de lenguaje, que es exacto; el índice de símbolos de los archivos C y C++, que busca coincidencias por nombre; o ambos.\n\nValor predeterminado: all"

msgctxt "settings schema"
msgid "Which untracked files `git status` reports.\n\n`all` lists every file inside an untracked directory, which is what\ncolours individual entries in the project panel. `normal` only lists the\nuntracked directory itself, and `no` skips untracked files entirely;\nboth make `git status` markedly cheaper on very large trees.\n\nDefault: all"
msgstr "Archivos sin seguimiento que informa `git status`.\n\n`all` enumera todos los archivos dentro de un directorio sin seguimiento, lo que permite colorear cada entrada en el panel de proyecto. `normal` solo enumera el propio directorio sin seguimiento, y `no` omite por completo los archivos sin seguimiento; ambos hacen que `git status` sea notablemente más ligero en árboles muy grandes.\n\nValor predeterminado: all"

msgctxt "settings schema"
msgid "White ANSI terminal color."
msgstr "Color blanco ANSI del terminal."

msgctxt "settings schema"
msgid "Width scales automatically with the buffer font size."
msgstr "La anchura se ajusta automáticamente al tamaño de la fuente del búfer."

msgctxt "settings schema"
msgid "Window title template.\n\nAvailable variables are `${projectName}`, `${fileName}`,\n`${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`,\n`${remoteHost}`, `${appName}`, `${branch}`,\nand `${separator}`.\n`${separator}` is omitted when adjacent variables are empty,\nbut literal text is preserved.\nThe collaboration indicator, when present, is appended after the\nrendered template.\nIf the template renders to nothing, the default template is used instead.\n\nDefault: `${projectName}${separator}${fileName}`"
msgstr "Plantilla del título de la ventana.\n\nLas variables disponibles son `${projectName}`, `${fileName}`, `${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`, `${remoteHost}`, `${appName}`, `${branch}` y `${separator}`.\n`${separator}` se omite cuando las variables adyacentes están vacías, pero el texto literal se conserva.\nEl indicador de colaboración, si existe, se agrega después de la plantilla representada.\nSi la plantilla queda vacía, se usa la plantilla predeterminada.\n\nValor predeterminado: `${projectName}${separator}${fileName}`"

msgctxt "settings schema"
msgid "Yellow ANSI terminal color."
msgstr "Color amarillo ANSI del terminal."

msgctxt "settings schema"
msgid "Zed draws its own window decorations/titlebar (client-side decoration)."
msgstr "ForgeKairos dibuja sus propias decoraciones de ventana/barra de título (decoración del lado del cliente)."

msgctxt "settings schema"
msgid "Zed's Prettier integration settings.\nAllows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\n\nDefault: off"
msgstr "Configuración de la integración de Prettier en ForgeKairos. Permite habilitar o deshabilitar el formateo con Prettier y configurar el Prettier predeterminado, que se usa cuando no se encuentra una instalación de Prettier en el proyecto.\n\nValor predeterminado: off"

msgctxt "settings schema"
msgid "clangd's memory use: its index mode, worker count and a limit at which it\nis restarted."
msgstr "Uso de memoria de clangd: su modo de indexación, el número de procesos de trabajo y un límite a partir del cual se reinicia."
