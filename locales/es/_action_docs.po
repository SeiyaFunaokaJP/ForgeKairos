#. Scroll until the cursor displays at the bottom
msgctxt "action documentation"
msgid "outline_panel::ScrollCursorBottom"
msgstr "Desplaza hasta que el cursor se muestre en la parte inferior"

#. Scroll until the cursor displays at the center
msgctxt "action documentation"
msgid "outline_panel::ScrollCursorCenter"
msgstr "Desplaza hasta que el cursor se muestre en el centro"

#. Scroll until the cursor displays at the top
msgctxt "action documentation"
msgid "outline_panel::ScrollCursorTop"
msgstr "Desplaza hasta que el cursor se muestre en la parte superior"

#. Scroll half a page downwards
msgctxt "action documentation"
msgid "outline_panel::ScrollDown"
msgstr "Se desplaza media página hacia abajo"

#. Scroll half a page upwards
