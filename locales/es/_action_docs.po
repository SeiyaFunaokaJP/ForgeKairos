# The descriptions of actions (their doc comments), keyed by the action name.
# The #. comments of an entry are the English it translates, one per line.
#
# Entries that zed-i18n also translates started from its es-ES translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: es\n"
"X-Language-Name: Español\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. Runs a sequence of actions.
#.
#. NOTE: This does **not** wait for asynchronous actions to complete before running the next action.
msgctxt "action documentation"
msgid "action::Sequence"
msgstr "Ejecuta una secuencia de acciones.\n\nNOTA: **No** espera a que terminen las acciones asíncronas antes de ejecutar la siguiente acción."

#. Displays error messages from language servers in the status bar.
msgctxt "action documentation"
msgid "activity_indicator::ShowErrorMessage"
msgstr "Muestra mensajes de error de los servidores de lenguaje en la barra de estado."

#. Add the current selection as context for threads in the agent panel.
msgctxt "action documentation"
msgid "agent::AddSelectionToThread"
msgstr "Agrega la selección actual como contexto para conversaciones en el panel del agente."

#. Allow this operation and remember the choice.
msgctxt "action documentation"
msgid "agent::AllowAlways"
msgstr "Permite esta operación y recuerda la elección."

#. Allow this operation only this time.
msgctxt "action documentation"
msgid "agent::AllowOnce"
msgstr "Permite esta operación solo esta vez."

#. Archives the currently selected thread.
msgctxt "action documentation"
msgid "agent::ArchiveSelectedThread"
msgstr "Archiva la conversación seleccionada actualmente."

#. Action to authorize a tool call with a specific permission option.
#. This is used by the permission granularity dropdown to authorize tool calls.
msgctxt "action documentation"
msgid "agent::AuthorizeToolCall"
msgstr "Acción para autorizar una llamada a herramienta con una opción de permiso específica.\nLo utiliza el desplegable de granularidad de permisos para autorizar llamadas a herramientas."

#. Starts a chat conversation with the agent.
msgctxt "action documentation"
msgid "agent::Chat"
msgstr "Inicia una conversación de chat con el agente."

#. Starts a chat conversation with follow-up enabled.
msgctxt "action documentation"
msgid "agent::ChatWithFollow"
msgstr "Inicia una conversación de chat con seguimiento habilitado."

#. Checks the ACP registry for newer versions of the installed external agents, and asks before updating them.
msgctxt "action documentation"
msgid "agent::CheckForAgentUpdates"
msgstr "Busca en el registro de ACP versiones nuevas de los agentes externos instalados y pregunta antes de actualizarlos."

#. Clears all messages from the queue.
msgctxt "action documentation"
msgid "agent::ClearMessageQueue"
msgstr "Borra todos los mensajes de la cola."

#. Copies the current thread to the clipboard as JSON for debugging.
msgctxt "action documentation"
msgid "agent::CopyThreadToClipboard"
msgstr "Copia la conversación actual al portapapeles como JSON para depuración."

#. Opens the skill creator window to import a skill from a GitHub URL.
msgctxt "action documentation"
msgid "agent::CreateSkillFromUrl"
msgstr "Abre la ventana del creador de habilidades para importar una habilidad desde una URL de GitHub."

#. Cycles through favorited models in the ACP model selector.
msgctxt "action documentation"
msgid "agent::CycleFavoriteModels"
msgstr "Alterna entre los modelos favoritos en el selector de modelos ACP."

#. Cycles through available session modes.
msgctxt "action documentation"
msgid "agent::CycleModeSelector"
msgstr "Alterna entre los modos de sesión disponibles."

#. Cycles to the next inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CycleNextInlineAssist"
msgstr "Pasa a la siguiente sugerencia del asistente en línea."

#. Cycles to the previous inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CyclePreviousInlineAssist"
msgstr "Pasa a la sugerencia anterior del asistente en línea."

#. Cycles through available thinking effort levels for the current model.
msgctxt "action documentation"
msgid "agent::CycleThinkingEffort"
msgstr "Alterna entre los niveles de razonamiento disponibles para el modelo actual."

#. Closes the thread search bar.
msgctxt "action documentation"
msgid "agent::DismissThreadSearch"
msgstr "Cierra la barra de búsqueda de la conversación."

#. Edits the first message in the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::EditFirstQueuedMessage"
msgstr "Edita el primer mensaje de la cola (el siguiente que se enviará)."

#. Expands the message editor to full size.
msgctxt "action documentation"
msgid "agent::ExpandMessageEditor"
msgstr "Expande el editor de mensajes a tamaño completo."

#. Moves focus down in the interface.
msgctxt "action documentation"
msgid "agent::FocusDown"
msgstr "Mueve el foco hacia abajo en la interfaz."

#. Moves focus left in the interface.
msgctxt "action documentation"
msgid "agent::FocusLeft"
msgstr "Mueve el foco a la izquierda en la interfaz."

#. Moves focus right in the interface.
msgctxt "action documentation"
msgid "agent::FocusRight"
msgstr "Mueve el foco a la derecha en la interfaz."

#. Moves focus up in the interface.
msgctxt "action documentation"
msgid "agent::FocusUp"
msgstr "Mueve el foco hacia arriba en la interfaz."

#. Follows the agent's suggestions.
msgctxt "action documentation"
msgid "agent::Follow"
msgstr "Sigue las sugerencias del agente."

#. Import agent threads from other Zed release channels (e.g. Preview, Nightly).
msgctxt "action documentation"
msgid "agent::ImportThreadsFromOtherChannels"
msgstr "Importa conversaciones de agentes de otros canales de publicación de ForgeKairos (p. ej., Preview, Nightly)."

#. Keeps the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Keep"
msgstr "Conserva la sugerencia o el cambio actual."

#. Keeps all suggestions or changes.
msgctxt "action documentation"
msgid "agent::KeepAll"
msgstr "Conserva todas las sugerencias o cambios."

#. Loads a thread from the clipboard JSON for debugging.
msgctxt "action documentation"
msgid "agent::LoadThreadFromClipboard"
msgstr "Carga una conversación desde el JSON del portapapeles para depuración."

#. Logs out of the current external agent
msgctxt "action documentation"
msgid "agent::LogoutAgent"
msgstr "Cierra sesión en el agente externo actual"

#. Opens the profile management interface for configuring agent tools and settings.
msgctxt "action documentation"
msgid "agent::ManageProfiles"
msgstr "Abre la interfaz de gestión de perfiles para configurar herramientas y configuración del agente."

#. Opens the skills manager in the settings window.
msgctxt "action documentation"
msgid "agent::ManageSkills"
msgstr "Abre el administrador de habilidades en la ventana de configuración."

#. Moves the thread open in a tab back to the agent panel.
msgctxt "action documentation"
msgid "agent::MoveThreadToPanel"
msgstr "Devuelve al panel del agente la conversación abierta en una pestaña."

#. Creates a new external agent conversation thread.
msgctxt "action documentation"
msgid "agent::NewExternalAgentThread"
msgstr "Crea una nueva conversación de agente externo."

#. Starts a new terminal thread.
msgctxt "action documentation"
msgid "agent::NewTerminalThread"
msgstr "Inicia una nueva conversación de terminal."

#. Creates a new conversation thread, optionally based on an existing thread.
msgctxt "action documentation"
msgid "agent::NewThread"
msgstr "Crea una nueva conversación, opcionalmente basada en una conversación existente."

#. Starts a new thread of the built-in agent on a model of the given
#. language model provider.
msgctxt "action documentation"
msgid "agent::NewThreadWithLanguageModelProvider"
msgstr "Inicia una nueva conversación del agente integrado con un modelo del proveedor de LLM indicado."

#. Opens the active thread as a markdown file.
msgctxt "action documentation"
msgid "agent::OpenActiveThreadAsMarkdown"
msgstr "Abre la conversación activa como archivo Markdown."

#. Opens the "Add Context" menu in the message editor.
msgctxt "action documentation"
msgid "agent::OpenAddContextMenu"
msgstr "Abre el menú \"Agregar contexto\" en el editor de mensajes."

#. Opens the agent diff view to review changes.
msgctxt "action documentation"
msgid "agent::OpenAgentDiff"
msgstr "Abre la vista de diferencias del agente para revisar los cambios."

#. Opens the user-global AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenGlobalAGENTS.mdRules"
msgstr "Abre el archivo de reglas AGENTS.md global del usuario."

#. Opens the agent onboarding modal.
msgctxt "action documentation"
msgid "agent::OpenOnboardingModal"
msgstr "Abre el cuadro de diálogo de introducción del agente."

#. Opens the permission granularity dropdown for the current tool call.
msgctxt "action documentation"
msgid "agent::OpenPermissionDropdown"
msgstr "Abre el desplegable de granularidad de permisos de la llamada a herramienta actual."

#. Opens the project AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenProjectAGENTS.mdRules"
msgstr "Abre el archivo de reglas AGENTS.md del proyecto."

#. Opens the agent settings UI.
msgctxt "action documentation"
msgid "agent::OpenSettings"
msgstr "Abre la interfaz de configuración del agente."

#. Opens the skill creator window for creating a new skill.
msgctxt "action documentation"
msgid "agent::OpenSkillCreator"
msgstr "Abre la ventana del creador de habilidades para crear una nueva habilidad."

#. Opens the current thread as a tab in a pane split to the right.
msgctxt "action documentation"
msgid "agent::OpenThreadInSplit"
msgstr "Abre la conversación actual como una pestaña en un panel dividido a la derecha."

#. Opens the current thread as a tab in the workspace. The panel goes back
#. to a new draft.
msgctxt "action documentation"
msgid "agent::OpenThreadInTab"
msgstr "Abre la conversación actual como una pestaña en el área de trabajo. El panel vuelve a un nuevo borrador."

#. Pastes clipboard content without any formatting.
msgctxt "action documentation"
msgid "agent::PasteRaw"
msgstr "Pega el contenido del portapapeles sin ningún formato."

#. Triggers re-authentication on Gemini
msgctxt "action documentation"
msgid "agent::ReauthenticateAgent"
msgstr "Activa la reautenticación en Gemini"

#. Reconnects to an agent that was stopped while unused, without sending anything.
msgctxt "action documentation"
msgid "agent::ReconnectParkedAgent"
msgstr "Vuelve a conectar con un agente que se detuvo mientras no se usaba, sin enviar nada."

#. Rejects the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Reject"
msgstr "Rechaza la sugerencia o cambio actual."

#. Rejects all suggestions or changes.
msgctxt "action documentation"
msgid "agent::RejectAll"
msgstr "Rechaza todas las sugerencias o cambios."

#. Reject this operation only this time.
msgctxt "action documentation"
msgid "agent::RejectOnce"
msgstr "Rechaza esta operación solo esta vez."

#. Removes the first message from the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::RemoveFirstQueuedMessage"
msgstr "Elimina el primer mensaje de la cola (el siguiente que se enviará)."

#. Removes the currently selected thread.
msgctxt "action documentation"
msgid "agent::RemoveSelectedThread"
msgstr "Elimina la conversación seleccionada actualmente."

#. Renames the currently selected thread.
msgctxt "action documentation"
msgid "agent::RenameSelectedThread"
msgstr "Cambia el nombre de la conversación seleccionada actualmente."

#. Reruns the rules-to-skills migration.
msgctxt "action documentation"
msgid "agent::RerunRulesToSkillsMigration"
msgstr "Vuelve a ejecutar la migración de reglas a habilidades."

#. Resets the agent panel zoom levels (agent UI and buffer font sizes).
msgctxt "action documentation"
msgid "agent::ResetAgentZoom"
msgstr "Restablece los niveles de zoom del panel del agente (tamaños de fuente de la interfaz del agente y del búfer)."

#. Re-enables the fast mode warning for every provider and model.
msgctxt "action documentation"
msgid "agent::ResetFastModeWarnings"
msgstr "Vuelve a habilitar la advertencia de modo rápido para cada proveedor y modelo."

#. Resets the agent onboarding state.
msgctxt "action documentation"
msgid "agent::ResetOnboarding"
msgstr "Restablece el estado de introducción del agente."

#. Resets the trial end upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialEndUpsell"
msgstr "Restablece la notificación de promoción de fin de prueba."

#. Resets the trial upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialUpsell"
msgstr "Restablece la notificación de promoción de la prueba."

#. Opens a new agent thread to resolve merge conflicts in the given file paths.
msgctxt "action documentation"
msgid "agent::ResolveConflictedFilesWithAgent"
msgstr "Abre una nueva conversación de agente para resolver conflictos de fusión en las rutas de archivo indicadas."

#. Opens a new agent thread to resolve specific merge conflicts.
msgctxt "action documentation"
msgid "agent::ResolveConflictsWithAgent"
msgstr "Abre una nueva conversación de agente para resolver conflictos de fusión específicos."

#. Opens a new agent thread with the provided branch diff for review.
msgctxt "action documentation"
msgid "agent::ReviewBranchDiff"
msgstr "Abre una nueva conversación de agente con las diferencias de la rama proporcionadas para revisión."

#. Takes back every start of an agent outside its sandbox that was
#. confirmed for a thread, so that each thread asks again.
msgctxt "action documentation"
msgid "agent::RevokeOutsideSandboxConsents"
msgstr "Revoca todos los inicios de un agente fuera de su sandbox que se confirmaron para una conversación, de modo que cada conversación vuelva a preguntar."

#. Scroll the output down by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineDown"
msgstr "Desplaza la salida tres líneas hacia abajo."

#. Scroll the output up by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineUp"
msgstr "Desplaza la salida tres líneas hacia arriba."

#. Scroll the output by one page down.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageDown"
msgstr "Desplaza la salida una página hacia abajo."

#. Scroll the output by one page up.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageUp"
msgstr "Desplaza la salida una página hacia arriba."

#. Scroll the output to the bottom.
msgctxt "action documentation"
msgid "agent::ScrollOutputToBottom"
msgstr "Desplaza la salida hasta el final."

#. Scroll the output to the next user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToNextMessage"
msgstr "Desplaza la salida hasta el siguiente mensaje de usuario."

#. Scroll the output to the previous user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToPreviousMessage"
msgstr "Desplaza la salida hasta el mensaje de usuario anterior."

#. Scroll the output to the top.
msgctxt "action documentation"
msgid "agent::ScrollOutputToTop"
msgstr "Desplaza la salida hasta el principio."

#. Selects the agent used for new threads in the agent panel, without
#. opening the panel. The selected agent is launched the next time the
#. panel is opened.
msgctxt "action documentation"
msgid "agent::SelectAgent"
msgstr "Selecciona el agente que se usará para las conversaciones nuevas en el panel del agente, sin\nabrir el panel. El agente seleccionado se inicia la próxima vez que se\nabra el panel."

#. Selects the next thread search match.
msgctxt "action documentation"
msgid "agent::SelectNextThreadMatch"
msgstr "Selecciona la siguiente coincidencia de búsqueda de la conversación."

#. Action to select a permission granularity option from the dropdown.
#. This updates the selected granularity without triggering authorization.
msgctxt "action documentation"
msgid "agent::SelectPermissionGranularity"
msgstr "Acción para seleccionar una opción de granularidad de permisos en el desplegable.\nEsto actualiza la granularidad seleccionada sin activar la autorización."

#. Selects the previous thread search match.
msgctxt "action documentation"
msgid "agent::SelectPreviousThreadMatch"
msgstr "Selecciona la coincidencia anterior de búsqueda de la conversación."

#. Interrupts the current generation and sends the message immediately.
msgctxt "action documentation"
msgid "agent::SendImmediately"
msgstr "Interrumpe la generación actual y envía el mensaje inmediatamente."

#. Sends the next queued message immediately.
msgctxt "action documentation"
msgid "agent::SendNextQueuedMessage"
msgstr "Envía inmediatamente el siguiente mensaje en cola."

#. Opens a small window over the workspace that sets up a language model
#. provider in place (its consent, key or sign-in), and then starts a
#. thread on it.
msgctxt "action documentation"
msgid "agent::SetUpLanguageModelProvider"
msgstr "Abre una ventana pequeña sobre el área de trabajo que configura allí mismo un proveedor de LLM (su consentimiento, su clave o el inicio de sesión) y, a continuación, inicia una conversación con él."

#. Toggles the agent panel.
msgctxt "action documentation"
msgid "agent::Toggle"
msgstr "Muestra u oculta el panel del agente."

#. Switches `agent.tool_permissions.default` between "confirm" and
#. "allow", so every tool action can be auto-approved without a prompt.
#. From "auto" (the AI judge) it also switches back to "confirm", so
#. the shortcut always leads out of an unattended mode.
msgctxt "action documentation"
msgid "agent::ToggleAutoApproveToolActions"
msgstr "Alterna `agent.tool_permissions.default` entre \"confirm\" y \"allow\", de modo que todas las acciones de las herramientas se puedan aprobar automáticamente sin preguntar.\nDesde \"auto\" (decide la IA) también vuelve a \"confirm\", por lo que el atajo siempre sale de un modo desatendido."

#. Action to toggle a command pattern checkbox in the permission dropdown.
msgctxt "action documentation"
msgid "agent::ToggleCommandPattern"
msgstr "Acción para activar o desactivar una casilla de patrón de comando en el desplegable de permisos."

#. Toggles fast mode for models that support it.
msgctxt "action documentation"
msgid "agent::ToggleFastMode"
msgstr "Alterna el modo rápido para los modelos que lo admiten."

#. Toggles the language model selector dropdown.
msgctxt "action documentation"
msgid "agent::ToggleModelSelector"
msgstr "Muestra u oculta el desplegable de selección de modelo de lenguaje."

#. Toggles the menu to create new agent threads.
msgctxt "action documentation"
msgid "agent::ToggleNewThreadMenu"
msgstr "Muestra u oculta el menú para crear nuevas conversaciones de agente."

#. Toggles the options menu for agent settings and preferences.
msgctxt "action documentation"
msgid "agent::ToggleOptionsMenu"
msgstr "Muestra u oculta el menú de opciones de configuración y preferencias del agente."

#. Toggles the tab bar of the agent panel's own pane.
msgctxt "action documentation"
msgid "agent::TogglePanelTabBar"
msgstr "Muestra u oculta la barra de pestañas del panel dividido propio del panel del agente."

#. Toggles the thread history list shown inside the agent panel.
msgctxt "action documentation"
msgid "agent::TogglePanelThreadHistory"
msgstr "Muestra u oculta la lista del historial de conversaciones dentro del panel del agente."

#. Toggles the profile or mode selector for switching between agent profiles.
msgctxt "action documentation"
msgid "agent::ToggleProfileSelector"
msgstr "Muestra u oculta el selector de perfil o modo para cambiar entre perfiles de agente."

#. Toggles in-thread search over the current agent thread's contents.
msgctxt "action documentation"
msgid "agent::ToggleSearch"
msgstr "Activa o desactiva la búsqueda dentro de la conversación actual del agente."

#. Toggles steering for the first queued message: when on, it interrupts
#. the agent at its next step instead of waiting for it to finish.
msgctxt "action documentation"
msgid "agent::ToggleSteerFirstQueuedMessage"
msgstr "Alterna la redirección del primer mensaje en cola: cuando está activada, interrumpe\nal agente en su siguiente paso en lugar de esperar a que termine."

#. Toggles the thinking effort selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleThinkingEffortMenu"
msgstr "Abre o cierra el menú de selección del nivel de razonamiento."

#. Toggles thinking mode for models that support extended thinking.
msgctxt "action documentation"
msgid "agent::ToggleThinkingMode"
msgstr "Alterna el modo de razonamiento para los modelos que admiten razonamiento extendido."

#. Toggles the tool permission mode selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleToolPermissionSelector"
msgstr "Abre o cierra el menú para elegir el modo de permisos de herramientas."

#. Undoes the most recent reject operation, restoring the rejected changes.
msgctxt "action documentation"
msgid "agent::UndoLastReject"
msgstr "Deshace la operación de rechazo más reciente y restaura los cambios rechazados."

#. Moves focus to the sidebar's search/filter editor.
msgctxt "action documentation"
msgid "agents_sidebar::FocusSidebarFilter"
msgstr "Mueve el foco al editor de búsqueda/filtro de la barra lateral."

#. Creates a new thread in the currently selected or active project group.
msgctxt "action documentation"
msgid "agents_sidebar::NewThreadInGroup"
msgstr "Crea una nueva conversación en el grupo de proyectos seleccionado o activo actualmente."

#. Toggles between the thread list and the thread history.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadHistory"
msgstr "Alterna entre la lista de conversaciones y el historial de conversaciones."

#. Toggles the thread switcher popup when the sidebar is focused.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadSwitcher"
msgstr "Alterna el menú emergente del selector de conversación cuando la barra lateral tiene el foco."

#. Toggles the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::Toggle"
msgstr "Muestra u oculta el panel del navegador de IA, donde los agentes de IA abren las pestañas del navegador que controlan."

#. Toggles focus on the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::ToggleFocus"
msgstr "Alterna el foco en el panel del navegador de IA, donde los agentes de IA abren las pestañas del navegador que controlan."

#. Activates the menu on the left in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuLeft"
msgstr "Activa el menú de la izquierda en el menú de aplicación del lado del cliente.\n\nNo se aplica a las barras de menú de la plataforma (p. ej., en macOS)."

#. Activates the menu on the right in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuRight"
msgstr "Activa el menú de la derecha en el menú de aplicación del lado del cliente.\n\nNo se aplica a las barras de menú de la plataforma (p. ej., en macOS)."

#. Opens the named menu in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::OpenApplicationMenu"
msgstr "Abre el menú indicado en el menú de la aplicación del lado del cliente.\n\nNo se aplica a las barras de menús de la plataforma (p. ej., en macOS)."

#. Deploys the assistant interface with the specified configuration.
msgctxt "action documentation"
msgid "assistant::InlineAssist"
msgstr "Despliega la interfaz del asistente con la configuración especificada."

#. Checks for available updates.
msgctxt "action documentation"
msgid "auto_update::Check"
msgstr "Busca actualizaciones disponibles."

#. Dismisses the update error message.
msgctxt "action documentation"
msgid "auto_update::DismissMessage"
msgstr "Cierra el mensaje de error de actualización."

#. Opens the release notes for the current version in a browser.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotes"
msgstr "Abre las notas de la versión actual en un navegador."

#. Opens the release notes for the current version in a new tab.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotesLocally"
msgstr "Abre las notas de la versión actual en una pestaña nueva."

#. Cycle through branch filters.
msgctxt "action documentation"
msgid "branch_picker::CycleBranchFilter"
msgstr "Alterna entre los filtros de ramas."

#. Deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::DeleteBranch"
msgstr "Elimina la rama de git o el remoto seleccionado."

#. Force deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::ForceDeleteBranch"
msgstr "Elimina de forma forzada la rama o el remoto de git seleccionado."

#. Show all branches.
msgctxt "action documentation"
msgid "branch_picker::ShowAllBranches"
msgstr "Muestra todas las ramas."

#. Show only local branches.
msgctxt "action documentation"
msgid "branch_picker::ShowLocalBranches"
msgstr "Muestra solo las ramas locales."

#. Show only remote branches.
msgctxt "action documentation"
msgid "branch_picker::ShowRemoteBranches"
msgstr "Muestra solo las ramas remotas."

#. Toggles the branch filter menu.
msgctxt "action documentation"
msgid "branch_picker::ToggleFilterMenu"
msgstr "Muestra u oculta el menú de filtros de ramas."

#. Adds the current page to the bookmarks.
msgctxt "action documentation"
msgid "browser_panel::AddBookmark"
msgstr "Agrega la página actual a los marcadores."

#. Asks Copilot about the selected text.
msgctxt "action documentation"
msgid "browser_panel::AskCopilot"
msgstr "Pregunta a Copilot sobre el texto seleccionado."

#. Closes the current tab of the browser panel.
msgctxt "action documentation"
msgid "browser_panel::ClosePanelTab"
msgstr "Cierra la pestaña actual del panel del navegador."

#. Moves focus to the address bar.
msgctxt "action documentation"
msgid "browser_panel::FocusAddressBar"
msgstr "Mueve el foco a la barra de direcciones."

#. Moves focus to the next pane of the split browser panel.
msgctxt "action documentation"
msgid "browser_panel::FocusNextPaneGroup"
msgstr "Mueve el foco al siguiente panel dividido del panel del navegador dividido."

#. Opens the URL set as the home page.
msgctxt "action documentation"
msgid "browser_panel::GoHome"
msgstr "Abre la URL configurada como página de inicio."

#. Goes back to the previous page.
msgctxt "action documentation"
msgid "browser_panel::NavigateBack"
msgstr "Vuelve a la página anterior."

#. Goes forward to the next page.
msgctxt "action documentation"
msgid "browser_panel::NavigateForward"
msgstr "Avanza a la página siguiente."

#. Opens a new AI tab in the AI browser panel: a tab with its own browser profile that AI agents can drive, with its traffic limited to the network allowlist.
msgctxt "action documentation"
msgid "browser_panel::NewAiTab"
msgstr "Abre una nueva pestaña de IA en el panel del navegador de IA: una pestaña con su propio perfil de navegador que los agentes de IA pueden controlar, con su tráfico limitado a la lista de permitidos de red."

#. Opens a new browser tab in the editor area.
msgctxt "action documentation"
msgid "browser_panel::NewBrowserTab"
msgstr "Abre una nueva pestaña del navegador en el área del editor."

#. Opens a new tab in the browser panel.
msgctxt "action documentation"
msgid "browser_panel::NewPanelTab"
msgstr "Abre una nueva pestaña en el panel del navegador."

#. Opens the developer tools of the current browser tab.
msgctxt "action documentation"
msgid "browser_panel::OpenDeveloperTools"
msgstr "Abre las herramientas de desarrollo de la pestaña actual del navegador."

#. Moves the page open in the browser panel to a tab in the editor area.
msgctxt "action documentation"
msgid "browser_panel::OpenInCenter"
msgstr "Mueve la página abierta en el panel del navegador a una pestaña del área del editor."

#. Opens the current page in the system's default browser.
msgctxt "action documentation"
msgid "browser_panel::OpenInExternalBrowser"
msgstr "Abre la página actual en el navegador predeterminado del sistema."

#. Reloads the current page.
msgctxt "action documentation"
msgid "browser_panel::Reload"
msgstr "Recarga la página actual."

#. Lets AI agents drive the current AI tab again after it was stopped.
msgctxt "action documentation"
msgid "browser_panel::ResumeAiControl"
msgstr "Permite que los agentes de IA vuelvan a controlar la pestaña de IA actual después de haberse detenido."

#. Searches the web for the selected text.
msgctxt "action documentation"
msgid "browser_panel::SearchSelection"
msgstr "Busca en la web el texto seleccionado."

#. Makes the current page the page opened at startup (browser.home_url).
msgctxt "action documentation"
msgid "browser_panel::SetAsHomePage"
msgstr "Convierte la página actual en la página que se abre al iniciar (browser.home_url)."

#. Moves the current tab to the right, splitting the browser panel in two.
msgctxt "action documentation"
msgid "browser_panel::SplitPanelRight"
msgstr "Mueve la pestaña actual a la derecha y divide el panel del navegador en dos."

#. Stops AI control of the current AI tab: the running command is cancelled and further commands are refused until it is resumed.
msgctxt "action documentation"
msgid "browser_panel::StopAiControl"
msgstr "Detiene el control por IA de la pestaña de IA actual: se cancela el comando en ejecución y se rechazan los siguientes comandos hasta que se reanude."

#. Opens the URL or the search terms typed in the address bar.
msgctxt "action documentation"
msgid "browser_panel::SubmitAddress"
msgstr "Abre la URL o los términos de búsqueda escritos en la barra de direcciones."

#. Toggles the built-in browser panel.
msgctxt "action documentation"
msgid "browser_panel::Toggle"
msgstr "Muestra u oculta el panel del navegador integrado."

#. Shows or hides the list of bookmarks.
msgctxt "action documentation"
msgid "browser_panel::ToggleBookmarks"
msgstr "Muestra u oculta la lista de marcadores."

#. Toggles focus on the built-in browser panel.
msgctxt "action documentation"
msgid "browser_panel::ToggleFocus"
msgstr "Alterna el foco en el panel del navegador integrado."

#. Opens the buffer search interface with the specified configuration.
msgctxt "action documentation"
msgid "buffer_search::Deploy"
msgstr "Abre la interfaz de búsqueda del búfer con la configuración especificada."

#. Deploys the search and replace interface.
msgctxt "action documentation"
msgid "buffer_search::DeployReplace"
msgstr "Despliega la interfaz de búsqueda y reemplazo."

#. Dismisses the search bar.
msgctxt "action documentation"
msgid "buffer_search::Dismiss"
msgstr "Cierra la barra de búsqueda."

#. Focuses back on the editor.
msgctxt "action documentation"
msgid "buffer_search::FocusEditor"
msgstr "Devuelve el foco al editor."

#. Sets the search query from the selection or word under cursor.
msgctxt "action documentation"
msgid "buffer_search::UseSelectionForFind"
msgstr "Establece la consulta de búsqueda a partir de la selección o la palabra bajo el cursor."

#. Collapses every function under the root.
msgctxt "action documentation"
msgid "call_graph_panel::CollapseAll"
msgstr "Contrae todas las funciones bajo la raíz."

#. Collapses the selected function, or moves to its parent.
msgctxt "action documentation"
msgid "call_graph_panel::CollapseSelected"
msgstr "Contrae la función seleccionada o se mueve a su elemento primario."

#. Copies the name of the selected function.
msgctxt "action documentation"
msgid "call_graph_panel::CopySymbolName"
msgstr "Copia el nombre de la función seleccionada."

#. Expands the selected function, or moves into its first child.
msgctxt "action documentation"
msgid "call_graph_panel::ExpandSelected"
msgstr "Expande la función seleccionada o se mueve a su primer elemento secundario."

#. Makes the function under the editor's cursor the root.
msgctxt "action documentation"
msgid "call_graph_panel::InspectCursor"
msgstr "Convierte en raíz la función que está bajo el cursor del editor."

#. Goes forward to the next root.
msgctxt "action documentation"
msgid "call_graph_panel::NextRoot"
msgstr "Avanza a la raíz siguiente."

#. Opens the selected call in the editor. Repeating it on a row with
#. several calls goes to the next one.
msgctxt "action documentation"
msgid "call_graph_panel::OpenSelected"
msgstr "Abre la llamada seleccionada en el editor. Al repetirlo en una fila con varias llamadas, va a la siguiente."

#. Shows the selected call in the editor, keeping focus in the panel.
msgctxt "action documentation"
msgid "call_graph_panel::PreviewSelected"
msgstr "Muestra la llamada seleccionada en el editor, manteniendo el foco en el panel."

#. Goes back to the previous root.
msgctxt "action documentation"
msgid "call_graph_panel::PreviousRoot"
msgstr "Vuelve a la raíz anterior."

#. Asks again for everything shown, keeping the root.
msgctxt "action documentation"
msgid "call_graph_panel::Refresh"
msgstr "Vuelve a consultar todo lo que se muestra, manteniendo la raíz."

#. Opens the call graph panel with the callees of the function under the cursor.
msgctxt "action documentation"
msgid "call_graph_panel::ShowCallees"
msgstr "Abre el panel de grafo de llamadas con las funciones a las que llama la función que está bajo el cursor."

#. Opens the call graph panel with the callers of the function under the cursor.
msgctxt "action documentation"
msgid "call_graph_panel::ShowCallers"
msgstr "Abre el panel de grafo de llamadas con las funciones que llaman a la función que está bajo el cursor."

#. Toggles the call graph panel.
msgctxt "action documentation"
msgid "call_graph_panel::Toggle"
msgstr "Muestra u oculta el panel de grafo de llamadas."

#. Switches between showing callers and callees of the root.
msgctxt "action documentation"
msgid "call_graph_panel::ToggleDirection"
msgstr "Alterna entre mostrar las funciones que llaman a la raíz y las funciones a las que llama."

#. Toggles focus on the call graph panel.
msgctxt "action documentation"
msgid "call_graph_panel::ToggleFocus"
msgstr "Alterna el foco en el panel de grafo de llamadas."

#. Toggles whether the root follows the editor's cursor.
msgctxt "action documentation"
msgid "call_graph_panel::ToggleFollowCursor"
msgstr "Alterna si la raíz sigue al cursor del editor."

#. Registers this application's URL scheme handler.
msgctxt "action documentation"
msgid "cli::RegisterZedScheme"
msgstr "Registra el controlador del esquema de URL de esta aplicación."

#. Reconnects to the collaboration server.
msgctxt "action documentation"
msgid "client::Reconnect"
msgstr "Vuelve a conectar con el servidor de colaboración."

#. Signs in to Zed account.
msgctxt "action documentation"
msgid "client::SignIn"
msgstr "Inicia sesión en la cuenta de Zed."

#. Signs out of Zed account.
msgctxt "action documentation"
msgid "client::SignOut"
msgstr "Cierra sesión en la cuenta de Zed."

#. Copies the current room name and session id for debugging purposes.
msgctxt "action documentation"
msgid "collab::CopyRoomId"
msgstr "Copia el nombre de la sala actual y el ID de sesión con fines de depuración."

#. Deafens yourself (mute both microphone and speakers).
msgctxt "action documentation"
msgid "collab::Deafen"
msgstr "Silencia por completo el audio propio (tanto el micrófono como los altavoces)."

#. Leaves the current call.
msgctxt "action documentation"
msgid "collab::LeaveCall"
msgstr "Sale de la llamada actual."

#. Mutes your microphone.
msgctxt "action documentation"
msgid "collab::Mute"
msgstr "Silencia el micrófono."

#. Opens the channel notes for the current call.
#.
#. Use `collab_panel::OpenSelectedChannelNotes` to open the channel notes for the selected
#. channel in the collab panel.
#.
#. If you want to open a specific channel, use `zed::OpenZedUrl` with a channel notes URL -
#. can be copied via "Copy link to section" in the context menu of the channel notes
#. buffer. These URLs look like `https://zed.dev/channel/channel-name-CHANNEL_ID/notes`.
msgctxt "action documentation"
msgid "collab::OpenChannelNotes"
msgstr "Abre las notas del canal de la llamada actual.\n\nUse `collab_panel::OpenSelectedChannelNotes` para abrir las notas del canal seleccionado\nen el panel de colaboración.\n\nPara abrir un canal específico, use `zed::OpenZedUrl` con una URL de notas del canal:\nse puede copiar mediante \"Copiar enlace a la sección\" en el menú contextual del búfer\nde notas del canal. Estas URL tienen este aspecto: `https://zed.dev/channel/channel-name-CHANNEL_ID/notes`."

#. Opens the channel notes for a specific channel by its ID.
msgctxt "action documentation"
msgid "collab::OpenChannelNotesById"
msgstr "Abre las notas de un canal específico por su ID."

#. Shares your screen with collaborators.
msgctxt "action documentation"
msgid "collab::ScreenShare"
msgstr "Comparte la pantalla con los colaboradores."

#. Shares the current project with collaborators.
msgctxt "action documentation"
msgid "collab::ShareProject"
msgstr "Comparte el proyecto actual con colaboradores."

#. Show call diagnostics and connection quality statistics.
msgctxt "action documentation"
msgid "collab::ShowCallStats"
msgstr "Muestra diagnósticos de llamada y estadísticas de calidad de la conexión."

#. A debug action to simulate an update being available to test the update banner UI.
msgctxt "action documentation"
msgid "collab::SimulateUpdateAvailable"
msgstr "Una acción de depuración para simular que hay una actualización disponible y probar la interfaz del banner de actualización."

#. Switches to a different git branch.
msgctxt "action documentation"
msgid "collab::SwitchBranch"
msgstr "Cambia a una rama de git diferente."

#. Toggles the project menu dropdown.
msgctxt "action documentation"
msgid "collab::ToggleProjectMenu"
msgstr "Alterna el desplegable del menú de proyecto."

#. Toggles the user menu dropdown.
msgctxt "action documentation"
msgid "collab::ToggleUserMenu"
msgstr "Alterna el desplegable del menú de usuario."

#. Toggles the command palette.
msgctxt "action documentation"
msgid "command_palette::Toggle"
msgstr "Muestra u oculta la paleta de comandos."

#. Adds an expression to the watch list.
msgctxt "action documentation"
msgid "console::WatchExpression"
msgstr "Agrega una expresión a la lista de inspección."

#. Restarts the context server.
msgctxt "action documentation"
msgid "context_server::Restart"
msgstr "Reinicia el servidor de contexto."

#. Reinstalls the Copilot Edit Predictions language server.
msgctxt "action documentation"
msgid "copilot_edit_predictions::Reinstall"
msgstr "Reinstala el servidor de lenguaje de Copilot Edit Predictions."

#. Toggles the debug panel.
msgctxt "action documentation"
msgid "debug_panel::Toggle"
msgstr "Muestra u oculta el panel de depuración."

#. Toggles focus on the debug panel.
msgctxt "action documentation"
msgid "debug_panel::ToggleFocus"
msgstr "Alterna el foco en el panel de depuración."

#. Clears all breakpoints in the project.
msgctxt "action documentation"
msgid "debugger::ClearAllBreakpoints"
msgstr "Borra todos los puntos de interrupción del proyecto."

#. Continues all threads until the next breakpoint.
msgctxt "action documentation"
msgid "debugger::Continue"
msgstr "Continúa todos los subprocesos hasta el siguiente punto de interrupción."

#. Continues the selected thread until the next breakpoint.
msgctxt "action documentation"
msgid "debugger::ContinueThread"
msgstr "Continúa el subproceso seleccionado hasta el siguiente punto de interrupción."

#. Detaches the debugger from the running process.
msgctxt "action documentation"
msgid "debugger::Detach"
msgstr "Desasocia el depurador del proceso en ejecución."

#. Evaluates the selected text in the debugger context.
msgctxt "action documentation"
msgid "debugger::EvaluateSelectedText"
msgstr "Evalúa el texto seleccionado en el contexto del depurador."

#. Focuses on the breakpoint list panel.
msgctxt "action documentation"
msgid "debugger::FocusBreakpointList"
msgstr "Enfoca el panel de lista de puntos de interrupción."

#. Focuses on the debugger console panel.
msgctxt "action documentation"
msgid "debugger::FocusConsole"
msgstr "Enfoca el panel de consola del depurador."

#. Focuses on the call stack frames panel.
msgctxt "action documentation"
msgid "debugger::FocusFrames"
msgstr "Enfoca el panel de marcos de la pila de llamadas."

#. Focuses on the loaded sources panel.
msgctxt "action documentation"
msgid "debugger::FocusLoadedSources"
msgstr "Enfoca el panel de fuentes cargadas."

#. Focuses on the loaded modules panel.
msgctxt "action documentation"
msgid "debugger::FocusModules"
msgstr "Enfoca el panel de módulos cargados."

#. Focuses on the terminal panel.
msgctxt "action documentation"
msgid "debugger::FocusTerminal"
msgstr "Enfoca el panel del terminal."

#. Focuses on the variables panel.
msgctxt "action documentation"
msgid "debugger::FocusVariables"
msgstr "Enfoca el panel de variables."

#. Navigates to the next breakpoint property in the list.
msgctxt "action documentation"
msgid "debugger::NextBreakpointProperty"
msgstr "Navega a la propiedad de punto de interrupción siguiente en la lista."

#. Opens the project debug tasks configuration.
msgctxt "action documentation"
msgid "debugger::OpenProjectDebugTasks"
msgstr "Abre la configuración de tareas de depuración del proyecto."

#. Pauses the currently running program.
msgctxt "action documentation"
msgid "debugger::Pause"
msgstr "Pausa el programa en ejecución."

#. Navigates to the previous breakpoint property in the list.
msgctxt "action documentation"
msgid "debugger::PreviousBreakpointProperty"
msgstr "Navega a la propiedad de punto de interrupción anterior en la lista."

#. Reruns the last debugging session.
msgctxt "action documentation"
msgid "debugger::Rerun"
msgstr "Vuelve a ejecutar la última sesión de depuración."

#. Reruns the current debugging session with the same configuration.
msgctxt "action documentation"
msgid "debugger::RerunSession"
msgstr "Vuelve a ejecutar la sesión de depuración actual con la misma configuración."

#. Restarts the current debugging session.
msgctxt "action documentation"
msgid "debugger::Restart"
msgstr "Reinicia la sesión de depuración actual."

#. Runs program execution to the current cursor position.
msgctxt "action documentation"
msgid "debugger::RunToCursor"
msgstr "Ejecuta el programa hasta la posición actual del cursor."

#. Starts a new debugging session.
msgctxt "action documentation"
msgid "debugger::Start"
msgstr "Inicia una nueva sesión de depuración."

#. Steps back to the previous statement.
msgctxt "action documentation"
msgid "debugger::StepBack"
msgstr "Retrocede a la instrucción anterior."

#. Steps into the next function call.
msgctxt "action documentation"
msgid "debugger::StepInto"
msgstr "Entra en la siguiente llamada de función."

#. Steps out of the current function.
msgctxt "action documentation"
msgid "debugger::StepOut"
msgstr "Sale de la función actual."

#. Steps over the current line.
msgctxt "action documentation"
msgid "debugger::StepOver"
msgstr "Ejecuta la línea actual sin entrar en las llamadas de función."

#. Stops the debugging session.
msgctxt "action documentation"
msgid "debugger::Stop"
msgstr "Detiene la sesión de depuración."

#. Set a data breakpoint on the selected variable or memory region.
msgctxt "action documentation"
msgid "debugger::ToggleDataBreakpoint"
msgstr "Establece un punto de interrupción de datos en la variable o región de memoria seleccionada."

#. Toggles the enabled state of a breakpoint.
msgctxt "action documentation"
msgid "debugger::ToggleEnableBreakpoint"
msgstr "Habilita o deshabilita un punto de interrupción."

#. Toggles expansion of the selected item in the debugger UI.
msgctxt "action documentation"
msgid "debugger::ToggleExpandItem"
msgstr "Alterna la expansión del elemento seleccionado en la interfaz del depurador."

#. Toggles whether to ignore all breakpoints.
msgctxt "action documentation"
msgid "debugger::ToggleIgnoreBreakpoints"
msgstr "Activa o desactiva la opción de ignorar todos los puntos de interrupción."

#. Toggles the session picker dropdown.
msgctxt "action documentation"
msgid "debugger::ToggleSessionPicker"
msgstr "Muestra u oculta el desplegable de selección de sesión."

#. Toggles the thread picker dropdown.
msgctxt "action documentation"
msgid "debugger::ToggleThreadPicker"
msgstr "Muestra u oculta el desplegable de selección de subprocesos."

#. Toggle the user frame filter in the stack frame list
#. When toggled on, only frames from the user's code are shown
#. When toggled off, all frames are shown
msgctxt "action documentation"
msgid "debugger::ToggleUserFrames"
msgstr "Alterna el filtro de marcos de usuario en la lista de marcos de pila.\nCuando está activado, solo se muestran los marcos del código del usuario.\nCuando está desactivado, se muestran todos los marcos."

#. Removes a breakpoint.
msgctxt "action documentation"
msgid "debugger::UnsetBreakpoint"
msgstr "Quita un punto de interrupción."

#. Copies the current accessibility tree to the clipboard as JSON,
#. without opening a buffer. See [`DumpAccessibilityTree`].
msgctxt "action documentation"
msgid "dev::CopyAccessibilityTree"
msgstr "Copia el árbol de accesibilidad actual al portapapeles como JSON,\nsin abrir un búfer. Consulte [`DumpAccessibilityTree`]."

#. Copies debug adapter launch arguments to clipboard.
msgctxt "action documentation"
msgid "dev::CopyDebugAdapterArguments"
msgstr "Copia los argumentos de inicio del adaptador de depuración en el portapapeles."

#. Open an app-wide recording of raw local filesystem watcher events.
msgctxt "action documentation"
msgid "dev::DebugFilesystemWatching"
msgstr "Abre una grabación, a escala de toda la aplicación, de eventos sin procesar de vigilancia del sistema de archivos local."

#. Dumps the current accessibility tree (the last update sent to the
#. platform adapter) to a new buffer as JSON, for debugging what is
#. exposed to assistive technology.
msgctxt "action documentation"
msgid "dev::DumpAccessibilityTree"
msgstr "Vuelca el árbol de accesibilidad actual (la última actualización enviada al\nadaptador de la plataforma) en un búfer nuevo como JSON, para depurar lo que se\nexpone a la tecnología de asistencia."

#. Opens a buffer showing the input-to-frame latency histogram for the current window.
msgctxt "action documentation"
msgid "dev::DumpInputLatencyHistogram"
msgstr "Abre un búfer que muestra el histograma de latencia de entrada a fotograma de la ventana actual."

#. Dumps multi-workspace state (projects, worktrees, active threads) into a new buffer.
msgctxt "action documentation"
msgid "dev::DumpWorkspaceInfo"
msgstr "Vuelca el estado de múltiples áreas de trabajo (proyectos, worktrees, conversaciones activas) en un búfer nuevo."

#. Go to the previous context retrieval run
msgctxt "action documentation"
msgid "dev::EditPredictionContextGoBack"
msgstr "Va a la ejecución anterior de recuperación de contexto"

#. Go to the next context retrieval run
msgctxt "action documentation"
msgid "dev::EditPredictionContextGoForward"
msgstr "Va a la siguiente ejecución de recuperación de contexto"

#. Causes a performance hang to test performance monitoring
msgctxt "action documentation"
msgid "dev::HangAction"
msgstr "Provoca un bloqueo de rendimiento para probar la monitorización del rendimiento"

#. Causes a performance hang to test performance monitoring
msgctxt "action documentation"
msgid "dev::HangBackground"
msgstr "Provoca un bloqueo de rendimiento para probar la monitorización del rendimiento"

#. Causes a performance hang to test performance monitoring
msgctxt "action documentation"
msgid "dev::HangForeground"
msgstr "Provoca un bloqueo de rendimiento para probar la monitorización del rendimiento"

#. Opens the debug adapter protocol logs viewer.
msgctxt "action documentation"
msgid "dev::OpenDebugAdapterLogs"
msgstr "Abre el visor de registros del protocolo del adaptador de depuración."

#. Opens the edit prediction context view.
msgctxt "action documentation"
msgid "dev::OpenEditPredictionContextView"
msgstr "Abre la vista de contexto de predicción de edición."

#. Opens the highlights tree view for the current file.
msgctxt "action documentation"
msgid "dev::OpenHighlightsTreeView"
msgstr "Abre la vista de árbol de resaltados del archivo actual."

#. Opens the key context view for debugging keybindings.
msgctxt "action documentation"
msgid "dev::OpenKeyContextView"
msgstr "Abre la vista de contexto de teclas para depurar atajos de teclado."

#. Opens the language server protocol logs viewer.
msgctxt "action documentation"
msgid "dev::OpenLanguageServerLogs"
msgstr "Abre el visor de registros del protocolo de servidor de lenguaje."

#. Opens the syntax tree view for the current file.
msgctxt "action documentation"
msgid "dev::OpenSyntaxTreeView"
msgstr "Abre la vista de árbol de sintaxis del archivo actual."

#. Opens the theme preview window.
msgctxt "action documentation"
msgid "dev::OpenThemePreview"
msgstr "Abre la ventana de vista previa del tema."

#. Opens a prompt to enter a URL to open.
msgctxt "action documentation"
msgid "dev::OpenUrlPrompt"
msgstr "Abre un cuadro de diálogo para escribir la URL que se abrirá."

#. Resets the debug frame-time overlay's statistics, except for the
#. total frame count.
msgctxt "action documentation"
msgid "dev::ResetFrameOverlayStats"
msgstr "Restablece las estadísticas de la superposición de depuración de tiempo de fotograma, excepto el\nrecuento total de fotogramas."

#. Shows metadata for all threads in the sidebar.
msgctxt "action documentation"
msgid "dev::ShowAllSidebarThreadMetadata"
msgstr "Muestra los metadatos de todas las conversaciones en la barra lateral."

#. Shows the current git job queue debug state for the active repository.
msgctxt "action documentation"
msgid "dev::ShowGitJobQueue"
msgstr "Muestra el estado de depuración actual de la cola de trabajos de Git del repositorio activo."

#. Shows metadata for the currently active thread.
msgctxt "action documentation"
msgid "dev::ShowThreadMetadata"
msgstr "Muestra los metadatos de la conversación activa actualmente."

#. Show an error on the workspace level.
msgctxt "action documentation"
msgid "dev::ShowWorkspaceError"
msgstr "Muestra un error en el nivel del área de trabajo."

#. Cycles the debug frame-time overlay between hidden, current
#. frame-time, and detailed frame-time statistics.
msgctxt "action documentation"
msgid "dev::ToggleFpsOverlay"
msgstr "Alterna la superposición de depuración de tiempo de fotograma entre oculta, el tiempo de fotograma actual\ny las estadísticas detalladas de tiempo de fotograma."

#. Toggles the developer inspector for debugging UI elements.
msgctxt "action documentation"
msgid "dev::ToggleInspector"
msgstr "Muestra u oculta el inspector de desarrollador para depurar elementos de la interfaz."

#. Opens the project diagnostics view.
msgctxt "action documentation"
msgid "diagnostics::Deploy"
msgstr "Abre la vista de diagnósticos del proyecto."

#. Opens the project diagnostics view for the currently focused file.
msgctxt "action documentation"
msgid "diagnostics::DeployCurrentFile"
msgstr "Abre la vista de diagnósticos del proyecto para el archivo enfocado actualmente."

#. Toggles automatic refresh of diagnostics.
msgctxt "action documentation"
msgid "diagnostics::ToggleDiagnosticsRefresh"
msgstr "Alterna la actualización automática de diagnósticos."

#. Toggles the display of warning-level diagnostics.
msgctxt "action documentation"
msgid "diagnostics::ToggleWarnings"
msgstr "Muestra u oculta los diagnósticos de nivel de advertencia."

#. Clears the edit prediction history.
msgctxt "action documentation"
msgid "edit_prediction::ClearHistory"
msgstr "Borra el historial de predicciones de edición."

#. Opens the rate completions modal.
msgctxt "action documentation"
msgid "edit_prediction::RatePredictions"
msgstr "Abre el cuadro de diálogo para valorar autocompletados."

#. Resets the edit prediction onboarding state.
msgctxt "action documentation"
msgid "edit_prediction::ResetOnboarding"
msgstr "Restablece el estado de introducción de la predicción de edición."

#. Toggles the edit prediction menu.
msgctxt "action documentation"
msgid "edit_prediction::ToggleMenu"
msgstr "Muestra u oculta el menú de predicción de edición."

#. Accepts the full edit prediction.
msgctxt "action documentation"
msgid "editor::AcceptEditPrediction"
msgstr "Acepta la predicción de edición completa."

#. Accepts a partial edit prediction.
msgctxt "action documentation"
msgid "editor::AcceptNextWordEditPrediction"
msgstr "Acepta una predicción de edición parcial."

#. Adds a cursor above the current selection.
msgctxt "action documentation"
msgid "editor::AddSelectionAbove"
msgstr "Agrega un cursor encima de la selección actual."

#. Adds a cursor below the current selection.
msgctxt "action documentation"
msgid "editor::AddSelectionBelow"
msgstr "Agrega un cursor debajo de la selección actual."

#. Aligns selections from different rows into the same column
msgctxt "action documentation"
msgid "editor::AlignSelections"
msgstr "Alinea selecciones de distintas filas en la misma columna"

#. Applies all diff hunks in the editor.
msgctxt "action documentation"
msgid "editor::ApplyAllDiffHunks"
msgstr "Aplica todos los fragmentos de diferencias en el editor."

#. Applies the diff hunk at the current position.
msgctxt "action documentation"
msgid "editor::ApplyDiffHunk"
msgstr "Aplica el fragmento de diferencias en la posición actual."

#. Automatically adjusts indentation based on context.
msgctxt "action documentation"
msgid "editor::AutoIndent"
msgstr "Ajusta automáticamente la sangría según el contexto."

#. Deletes the character before the cursor.
msgctxt "action documentation"
