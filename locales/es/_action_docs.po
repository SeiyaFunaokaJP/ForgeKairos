msgctxt "action documentation"
msgid "zed::OpenTelemetryLog"
msgstr "Abre el registro de telemetría."

#. Opens the project tasks configuration with worktree setup guidance.
msgctxt "action documentation"
msgid "zed::OpenWorktreeSetupTasks"
msgstr "Abre la configuración de tareas del proyecto con instrucciones para configurar el worktree."

#. Opens the Zed repository on GitHub.
msgctxt "action documentation"
msgid "zed::OpenZedRepo"
msgstr "Abre el repositorio de Zed en GitHub."

#. Opens a zed:// URL within the application.
msgctxt "action documentation"
msgid "zed::OpenZedUrl"
msgstr "Abre una URL zed:// dentro de la aplicación."

#. Quits the application.
msgctxt "action documentation"
msgid "zed::Quit"
msgstr "Sale de la aplicación."

#. Rebuilds an installed dev extension.
msgctxt "action documentation"
msgid "zed::RebuildDevExtension"
msgstr "Recompila una extensión de desarrollo instalada."

#. Starts recording an ETW (Event Tracing for Windows) trace.
msgctxt "action documentation"
msgid "zed::RecordEtwTrace"
msgstr "Inicia la grabación de una traza ETW (Event Tracing for Windows)."

#. Starts recording an ETW (Event Tracing for Windows) trace with heap tracing.
msgctxt "action documentation"
msgid "zed::RecordEtwTraceWithHeapTracing"
msgstr "Inicia la grabación de una traza ETW (Event Tracing for Windows) con seguimiento de heap."

#. Reloads all installed extensions.
msgctxt "action documentation"
msgid "zed::ReloadExtensions"
msgstr "Recarga todas las extensiones instaladas."

#. Resets all zoom levels (UI and buffer font sizes, including in the agent panel) to their default values.
msgctxt "action documentation"
msgid "zed::ResetAllZoom"
msgstr "Restablece todos los niveles de zoom (tamaños de fuente de la interfaz y del búfer, incluidos los del panel del agente) a sus valores predeterminados."

#. Resets the buffer font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetBufferFontSize"
msgstr "Restablece el tamaño de la fuente del búfer a su valor predeterminado."

#. Resets the application database.
msgctxt "action documentation"
msgid "zed::ResetDatabase"
msgstr "Restablece la base de datos de la aplicación."

#. Resets the UI font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetUiFontSize"
msgstr "Restablece el tamaño de la fuente de la interfaz a su valor predeterminado."

#. Reveals the Zed log file in the system file manager.
msgctxt "action documentation"
msgid "zed::RevealLogInFileManager"
msgstr "Muestra el archivo de registro de ForgeKairos en el administrador de archivos del sistema."

#. Saves an in-progress ETW trace to disk.
msgctxt "action documentation"
msgid "zed::SaveEtwTrace"
msgstr "Guarda en disco una traza ETW en curso."

#. Shows all hidden windows.
msgctxt "action documentation"
msgid "zed::ShowAll"
msgstr "Muestra todas las ventanas ocultas."

#. Shows the default semantic token rules (read-only).
msgctxt "action documentation"
msgid "zed::ShowDefaultSemanticTokenRules"
msgstr "Muestra las reglas predeterminadas de tokens semánticos (solo lectura)."

#. Shows the auto-update notification for testing.
msgctxt "action documentation"
msgid "zed::ShowUpdateNotification"
msgstr "Muestra la notificación de actualización automática para pruebas."

#. Show the Zed welcome screen
msgctxt "action documentation"
msgid "zed::ShowWelcome"
msgstr "Muestra la pantalla de bienvenida de ForgeKairos"

#. Triggers a hard crash for debugging.
msgctxt "action documentation"
msgid "zed::TestCrash"
msgstr "Provoca un fallo grave para depuración."

#. Triggers a test panic for debugging.
msgctxt "action documentation"
msgid "zed::TestPanic"
msgstr "Provoca un panic de prueba para depuración."

#. Toggles the base keymap selector modal.
msgctxt "action documentation"
msgid "zed::ToggleBaseKeymapSelector"
msgstr "Muestra u oculta el cuadro de diálogo de selección del mapa de teclas base."

#. Toggles fullscreen mode.
msgctxt "action documentation"
msgid "zed::ToggleFullScreen"
msgstr "Activa o desactiva el modo de pantalla completa."

#. Action with special handling which unbinds later bindings for the same keystrokes when they
#. dispatch the named action, regardless of that action's context.
#.
#. In keymap JSON this is written as:
#.
#. `["zed::Unbind", "editor::NewLine"]`
msgctxt "action documentation"
msgid "zed::Unbind"
msgstr "Acción con un tratamiento especial que anula los atajos de teclado posteriores para las mismas pulsaciones de teclas cuando ejecutan la acción indicada, independientemente del contexto de esa acción.\n\nEn el JSON del mapa de teclas se escribe así:\n\n`[\"zed::Unbind\", \"editor::NewLine\"]`"

#. Zooms the window.
msgctxt "action documentation"
msgid "zed::Zoom"
msgstr "Aplica zoom a la ventana."

#. Opens the Zed Predict onboarding modal.
msgctxt "action documentation"
msgid "zed_predict_onboarding::OpenZedPredictOnboarding"
msgstr "Abre el cuadro de diálogo de introducción de Zed Predict."

#. Focuses on the completions list.
msgctxt "action documentation"
msgid "zeta::FocusPredictions"
msgstr "Enfoca la lista de autocompletado."

#. Navigates to the next edit in the completion history.
msgctxt "action documentation"
msgid "zeta::NextEdit"
msgstr "Navega a la edición siguiente en el historial de autocompletado."

#. Previews the selected completion.
msgctxt "action documentation"
msgid "zeta::PreviewPrediction"
msgstr "Muestra una vista previa del autocompletado seleccionado."

#. Navigates to the previous edit in the completion history.
msgctxt "action documentation"
msgid "zeta::PreviousEdit"
msgstr "Navega a la edición anterior en el historial de autocompletado."

#. Rates the active completion with a thumbs down.
msgctxt "action documentation"
msgid "zeta::ThumbsDownActivePrediction"
msgstr "Valora el autocompletado activo con un pulgar hacia abajo."

#. Rates the active completion with a thumbs up.
msgctxt "action documentation"
msgid "zeta::ThumbsUpActivePrediction"
msgstr "Valora el autocompletado activo con un pulgar hacia arriba."
