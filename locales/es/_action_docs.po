msgctxt "action documentation"
msgid "editor::WrapWithAbbreviation"
msgstr "Envuelve las selecciones en una abreviatura de Emmet expandida."

#. Toggles the encoding selector modal.
msgctxt "action documentation"
msgid "encoding_selector::Toggle"
msgstr "Muestra u oculta el cuadro de diálogo de selección de codificación."

#. Opens email client to send feedback to Zed support.
msgctxt "action documentation"
msgid "feedback::EmailZed"
msgstr "Abre el cliente de correo electrónico para enviar comentarios al soporte de Zed."

#. Opens the bug report form.
msgctxt "action documentation"
msgid "feedback::FileBugReport"
msgstr "Abre el formulario de informe de errores."

#. Opens the feature request form.
msgctxt "action documentation"
msgid "feedback::RequestFeature"
msgstr "Abre el formulario de solicitud de una función."

#. Opens the selected file in the editor without dismissing the file finder,
#. so additional files can be opened in sequence.
msgctxt "action documentation"
msgid "file_finder::OpenWithoutDismiss"
msgstr "Abre el archivo seleccionado en el editor sin cerrar el buscador de archivos,\npara poder abrir más archivos de forma consecutiva."

#. Selects the previous item in the file finder.
msgctxt "action documentation"
msgid "file_finder::SelectPrevious"
msgstr "Selecciona el elemento anterior en el buscador de archivos."

#. Toggles the file finder interface.
msgctxt "action documentation"
msgid "file_finder::Toggle"
msgstr "Muestra u oculta la interfaz del buscador de archivos."

#. Moves to the next field.
msgctxt "action documentation"
msgid "file_transfer::FocusNextField"
msgstr "Se mueve al campo siguiente."

#. Moves to the previous field.
msgctxt "action documentation"
msgid "file_transfer::FocusPreviousField"
msgstr "Se mueve al campo anterior."

#. Adds files to the git staging area.
msgctxt "action documentation"
msgid "git::Add"
msgstr "Agrega archivos al área de preparación de Git."

#. Adds a file to the repository's .git/info/exclude.
msgctxt "action documentation"
msgid "git::AddToGitInfoExclude"
msgstr "Agrega un archivo al .git/info/exclude del repositorio."

#. Adds a file to .gitignore.
msgctxt "action documentation"
msgid "git::AddToGitignore"
msgstr "Agrega un archivo a .gitignore."

#. Amends the last commit with staged changes.
msgctxt "action documentation"
msgid "git::Amend"
msgstr "Enmienda el último commit con los cambios preparados."

#. Applies a patch file to the working tree.
msgctxt "action documentation"
msgid "git::ApplyPatch"
msgstr "Aplica un archivo de parche al árbol de trabajo."

#. Shows git blame information for the current file.
msgctxt "action documentation"
msgid "git::Blame"
msgstr "Muestra información de autoría de Git para el archivo actual."

#. Opens the git branch selector.
msgctxt "action documentation"
msgid "git::Branch"
msgstr "Abre el selector de ramas de Git."

#. Cancels the current git operation.
msgctxt "action documentation"
msgid "git::Cancel"
msgstr "Cancela la operación de git actual."

#. Checks out a different git branch.
msgctxt "action documentation"
msgid "git::CheckoutBranch"
msgstr "Cambia a otra rama de git."

#. Checks out the selected commit (in a detached HEAD).
msgctxt "action documentation"
msgid "git::CheckoutCommit"
msgstr "Hace checkout del commit seleccionado (en un detached HEAD)."

#. Applies the selected commit to the current branch (cherry-pick).
msgctxt "action documentation"
msgid "git::CherryPickCommit"
msgstr "Aplica el commit seleccionado a la rama actual (cherry-pick)."

#. Opens the commit graph to choose the commit that the current changes go into (fixup).
msgctxt "action documentation"
msgid "git::ChooseFixupCommit"
msgstr "Abre el grafo de commits para elegir el commit en el que se incorporan los cambios actuales (fixup)."

#. Clones a repository.
msgctxt "action documentation"
msgid "git::Clone"
msgstr "Clona un repositorio."

#. Creates a new commit with staged changes.
msgctxt "action documentation"
msgid "git::Commit"
msgstr "Crea un nuevo commit con los cambios preparados."

#. Compares the contents of two branches or tags.
msgctxt "action documentation"
msgid "git::CompareRefs"
msgstr "Compara el contenido de dos ramas o etiquetas."

#. Compare with a specific branch
msgctxt "action documentation"
msgid "git::CompareWithBranch"
msgstr "Compara con una rama específica"

#. Force-pushes (with a lease) after asking for confirmation.
msgctxt "action documentation"
msgid "git::ConfirmForcePush"
msgstr "Fuerza el push (con lease) después de pedir confirmación."

#. Copies the current branch name to the clipboard.
msgctxt "action documentation"
msgid "git::CopyBranchName"
msgstr "Copia el nombre de la rama actual al portapapeles."

#. Copies a permalink for the selected file on its Git hosting provider.
msgctxt "action documentation"
msgid "git::CopyFilePermalink"
msgstr "Copia un enlace permanente para el archivo seleccionado en su proveedor de alojamiento de Git."

#. Copies the distance from the latest tag (`v1.2.3-5-gabcdef`) to the clipboard.
msgctxt "action documentation"
msgid "git::CopyTagDistance"
msgstr "Copia en el portapapeles la distancia desde la última etiqueta (`v1.2.3-5-gabcdef`)."

#. Creates a new branch from the selected commit.
msgctxt "action documentation"
msgid "git::CreateBranchFrom"
msgstr "Crea una nueva rama a partir del commit seleccionado."

#. Creates a patch file from the changes.
msgctxt "action documentation"
msgid "git::CreatePatch"
msgstr "Crea un archivo de parche a partir de los cambios."

#. Creates a pull request for the current branch.
msgctxt "action documentation"
msgid "git::CreatePullRequest"
msgstr "Crea una solicitud de cambios para la rama actual."

#. Create a git remote.
msgctxt "action documentation"
msgid "git::CreateRemote"
msgstr "Crea un remoto de Git."

#. Tags the selected commit.
msgctxt "action documentation"
msgid "git::CreateTagAt"
msgstr "Etiqueta el commit seleccionado."

#. Creates a new git worktree and switches the workspace to it.
#. Dispatched by the unified worktree picker when the user selects a "Create new worktree" entry.
msgctxt "action documentation"
msgid "git::CreateWorktree"
msgstr "Crea un nuevo worktree de Git y cambia el área de trabajo a ese worktree.\nEsta acción se ejecuta desde el selector unificado de worktrees cuando se selecciona la opción \"Crear nuevo worktree\"."

#. Shows the diff against the configured diff base: working changes
#. relative to HEAD, or all branch changes relative to the default
#. branch, following the `git.diff_base` setting.
msgctxt "action documentation"
msgid "git::Diff"
msgstr "Muestra las diferencias respecto a la base de diferencias configurada: los cambios sin commit\nrespecto a HEAD, o todos los cambios de la rama respecto a la rama\npredeterminada, según la configuración `git.diff_base`."

#. Shows the diff between the working directory and your default
#. branch (typically main or master).
msgctxt "action documentation"
msgid "git::DiffBranch"
msgstr "Muestra las diferencias entre el directorio de trabajo y la\nrama predeterminada (normalmente main o master)."

#. Shows working changes relative to HEAD.
msgctxt "action documentation"
msgid "git::DiffHead"
msgstr "Muestra los cambios sin commit respecto a HEAD."

#. Removes the selected commit from the history (the SHAs of the commits after it change).
msgctxt "action documentation"
msgid "git::DropCommit"
msgstr "Quita el commit seleccionado del historial (cambian los SHA de los commits posteriores)."

#. Expands the commit message editor.
msgctxt "action documentation"
msgid "git::ExpandCommitEditor"
msgstr "Expande el editor de mensajes de commit."

#. Fetches changes from the remote repository.
msgctxt "action documentation"
msgid "git::Fetch"
msgstr "Hace fetch de cambios del repositorio remoto."

#. Fetches changes from a specific remote.
msgctxt "action documentation"
msgid "git::FetchFrom"
msgstr "Hace fetch de cambios de un remoto específico."

#. Shows the git history for the selected file, folder, or project.
msgctxt "action documentation"
msgid "git::FileHistory"
msgstr "Muestra el historial de Git del archivo, la carpeta o el proyecto seleccionado."

#. Filter remotes.
msgctxt "action documentation"
msgid "git::FilterRemotes"
msgstr "Filtra remotos."

#. Puts the current changes into the selected commit (fixup; the SHAs of the commits after it change).
msgctxt "action documentation"
msgid "git::FixupCommit"
msgstr "Incorpora los cambios actuales en el commit seleccionado (fixup; cambian los SHA de los commits posteriores)."

#. Force pushes commits to the remote repository.
msgctxt "action documentation"
msgid "git::ForcePush"
msgstr "Hace push forzado de commits al repositorio remoto."

#. Force-pushes without a lease (this also overwrites commits others have pushed).
msgctxt "action documentation"
msgid "git::ForcePushWithoutLease"
msgstr "Fuerza el push sin lease (esto también sobrescribe los commits que otros hayan subido)."

#. Generates a commit message using AI.
msgctxt "action documentation"
msgid "git::GenerateCommitMessage"
msgstr "Genera un mensaje de commit usando IA."

#. Initializes a new git repository.
msgctxt "action documentation"
msgid "git::Init"
msgstr "Inicializa un nuevo repositorio Git."

#. Merges the selected branch into the current branch.
msgctxt "action documentation"
msgid "git::Merge"
msgstr "Fusiona la rama seleccionada en la rama actual."

#. Opens the current file in a solo diff view.
msgctxt "action documentation"
msgid "git::OpenFileDiff"
msgstr "Abre el archivo actual en una vista de diferencias de un solo archivo."

#. Opens a permalink for the selected file on its Git hosting provider.
msgctxt "action documentation"
msgid "git::OpenFilePermalink"
msgstr "Abre un enlace permanente para el archivo seleccionado en su proveedor de alojamiento de Git."

#. Opens the merge request box of the commit graph (and keeps it open if it already is).
msgctxt "action documentation"
msgid "git::OpenMergeRequestBox"
msgstr "Abre la caja de MR del grafo de commits (y la mantiene abierta si ya lo está)."

#. Opens all modified files in the editor.
msgctxt "action documentation"
msgid "git::OpenModifiedFiles"
msgstr "Abre todos los archivos modificados en el editor."

#. Opens an existing worktree in a new window.
#. Dispatched by the worktree picker's "Open in New Window" button.
msgctxt "action documentation"
msgid "git::OpenWorktreeInNewWindow"
msgstr "Abre un worktree existente en una ventana nueva.\nEsta acción se ejecuta mediante el botón \"Abrir en ventana nueva\" del selector de worktrees."

#. Packs loose refs into one file, which speeds up repositories with many branches or tags (git pack-refs --all).
msgctxt "action documentation"
msgid "git::PackRefs"
msgstr "Empaqueta las refs sueltas en un solo archivo, lo que acelera los repositorios con muchas ramas o etiquetas (git pack-refs --all)."

#. Pulls changes from the remote repository.
msgctxt "action documentation"
msgid "git::Pull"
msgstr "Hace pull de cambios del repositorio remoto."

#. Pulls changes from the remote repository with rebase.
msgctxt "action documentation"
msgid "git::PullRebase"
msgstr "Hace pull de cambios del repositorio remoto con rebase."

#. Pushes commits to the remote repository.
msgctxt "action documentation"
msgid "git::Push"
msgstr "Hace push de commits al repositorio remoto."

#. Pushes commits to a specific remote branch.
msgctxt "action documentation"
msgid "git::PushTo"
msgstr "Hace push de commits a una rama remota específica."

#. Removes a registered remote repository.
msgctxt "action documentation"
msgid "git::RemoveRemote"
msgstr "Quita un repositorio remoto registrado."

#. Renames a git branch.
msgctxt "action documentation"
msgid "git::RenameBranch"
msgstr "Cambia el nombre de una rama de git."

#. Resets the current branch to the selected commit.
msgctxt "action documentation"
msgid "git::ResetToCommit"
msgstr "Restablece la rama actual al commit seleccionado."

#. Fetches, then forces the local branch to match the remote (uncommitted changes are lost).
msgctxt "action documentation"
msgid "git::ResetToRemote"
msgstr "Hace fetch y luego fuerza la rama local para que coincida con la remota (se pierden los cambios sin commit)."

#. Restores the selected hunks to their original state.
msgctxt "action documentation"
msgid "git::Restore"
msgstr "Restaura los fragmentos seleccionados a su estado original."

#. Restores the selected hunks to their original state and moves to the
#. next one.
msgctxt "action documentation"
msgid "git::RestoreAndNext"
msgstr "Restaura los fragmentos seleccionados a su estado original y avanza al\nsiguiente."

#. Restores a file to its last committed state, discarding local changes.
msgctxt "action documentation"
msgid "git::RestoreFile"
msgstr "Restaura un archivo a su último estado confirmado, descartando los cambios locales."

#. Restores all tracked files to their last committed state.
msgctxt "action documentation"
msgid "git::RestoreTrackedFiles"
msgstr "Restaura todos los archivos con seguimiento a su último estado confirmado."

#. Creates a commit that undoes the selected commit (revert).
msgctxt "action documentation"
msgid "git::RevertCommit"
msgstr "Crea un commit que deshace el commit seleccionado (revert)."

#. Opens a new agent thread with the branch diff for review.
msgctxt "action documentation"
msgid "git::ReviewDiff"
msgstr "Abre una nueva conversación de agente con las diferencias de la rama para revisión."

#. Rewrites the message of the selected commit (the SHAs of the commits after it change).
msgctxt "action documentation"
msgid "git::RewordCommit"
msgstr "Reescribe el mensaje del commit seleccionado (cambian los SHA de los commits posteriores)."

#. Selects a different repository.
msgctxt "action documentation"
msgid "git::SelectRepo"
msgstr "Selecciona un repositorio distinto."

#. Opens the Git guide, which lists operations by what you want to do.
msgctxt "action documentation"
msgid "git::ShowGuide"
msgstr "Abre la guía de Git, que enumera las operaciones según lo que se quiera hacer."

#. Enable the --signoff option.
msgctxt "action documentation"
msgid "git::Signoff"
msgstr "Habilita la opción --signoff."

#. Runs the next commit with `git commit --no-verify`.
msgctxt "action documentation"
msgid "git::SkipHooks"
msgstr "Ejecuta el próximo commit con `git commit --no-verify`."

#. Stages all changes in the repository.
msgctxt "action documentation"
msgid "git::StageAll"
msgstr "Prepara todos los cambios del repositorio."

#. Stages the current hunk and moves to the next one.
msgctxt "action documentation"
msgid "git::StageAndNext"
msgstr "Prepara el fragmento actual y avanza al siguiente."

#. Stages the current file.
msgctxt "action documentation"
msgid "git::StageFile"
msgstr "Prepara el archivo actual."

#. Stage status entries between an anchor entry and the cursor.
msgctxt "action documentation"
msgid "git::StageRange"
msgstr "Prepara las entradas de estado entre una entrada de anclaje y el cursor."

#. Stages every entry in the section containing the selected entry.
msgctxt "action documentation"
msgid "git::StageSection"
msgstr "Prepara todas las entradas de la sección que contiene la entrada seleccionada."

#. Opens the Git panel and starts amending the last commit.
msgctxt "action documentation"
msgid "git::StartAmend"
msgstr "Abre el panel de Git y empieza a enmendar el último commit."

#. Stashes all changes in the repository, including untracked files.
msgctxt "action documentation"
msgid "git::StashAll"
msgstr "Guarda todos los cambios del repositorio en el stash, incluidos los archivos sin seguimiento."

#. Apply the most recent stash.
msgctxt "action documentation"
msgid "git::StashApply"
msgstr "Aplica el stash más reciente."

#. Pops the most recent stash.
msgctxt "action documentation"
msgid "git::StashPop"
msgstr "Extrae el stash más reciente."

#. Stashes staged changes in the repository, leaving unstaged changes in place.
msgctxt "action documentation"
msgid "git::StashStaged"
msgstr "Guarda los cambios preparados del repositorio en el stash y deja intactos los cambios sin preparar."

#. Stashes tracked changes in the repository, leaving untracked files in place.
msgctxt "action documentation"
msgid "git::StashTracked"
msgstr "Guarda los cambios con seguimiento del repositorio en el stash y deja intactos los archivos sin seguimiento."

#. Switches to a different git branch.
msgctxt "action documentation"
msgid "git::Switch"
msgstr "Cambia a una rama de git diferente."

#. Switches the workspace to an existing linked worktree.
#. Dispatched by the unified worktree picker when the user selects an existing worktree.
msgctxt "action documentation"
msgid "git::SwitchWorktree"
msgstr "Cambia el área de trabajo a un worktree enlazado existente.\nEsta acción se ejecuta desde el selector unificado de worktrees cuando se selecciona un worktree existente."

#. Toggles the git diff base between HEAD and the default branch.
msgctxt "action documentation"
msgid "git::ToggleDiffBase"
msgstr "Alterna la base de diferencias de Git entre HEAD y la rama predeterminada."

#. Toggles whether the commit message editor fills all the available
#. vertical space within the git panel.
msgctxt "action documentation"
msgid "git::ToggleFillCommitEditor"
msgstr "Alterna si el editor de mensajes de commit ocupa todo el\nespacio vertical disponible dentro del panel de Git."

#. Opens or closes the merge request box of the commit graph.
msgctxt "action documentation"
msgid "git::ToggleMergeRequestBox"
msgstr "Abre o cierra la caja de MR del grafo de commits."

#. Toggles the staged state of the hunk or status entry at cursor.
msgctxt "action documentation"
msgid "git::ToggleStaged"
msgstr "Alterna el estado preparado del fragmento o de la entrada de estado en el cursor."

#. Moves all untracked files to trash.
msgctxt "action documentation"
msgid "git::TrashUntrackedFiles"
msgstr "Mueve todos los archivos sin seguimiento a la papelera."

#. Undoes the last commit, keeping changes in the working directory.
msgctxt "action documentation"
msgid "git::Uncommit"
msgstr "Deshace el último commit y conserva los cambios en el directorio de trabajo."

#. Unstages all changes in the repository.
msgctxt "action documentation"
msgid "git::UnstageAll"
msgstr "Quita todos los cambios de preparados en el repositorio."

#. Unstages the current hunk and moves to the next one.
msgctxt "action documentation"
msgid "git::UnstageAndNext"
msgstr "Quita el fragmento actual de preparados y avanza al siguiente."

#. Unstages the current file.
msgctxt "action documentation"
msgid "git::UnstageFile"
msgstr "Quita el archivo actual de preparados."

#. Unstages every entry in the section containing the selected entry.
msgctxt "action documentation"
msgid "git::UnstageSection"
msgstr "Quita de preparados todas las entradas de la sección que contiene la entrada seleccionada."

#. Opens the selected file in the editor without a diff view.
msgctxt "action documentation"
msgid "git::ViewFile"
msgstr "Abre el archivo seleccionado en el editor sin una vista de diferencias."

#. Shows staged changes across the project.
msgctxt "action documentation"
msgid "git::ViewStagedChanges"
msgstr "Muestra los cambios preparados en todo el proyecto."

#. Opens the git stash selector.
msgctxt "action documentation"
msgid "git::ViewStash"
msgstr "Abre el selector de stash de Git."

#. Shows uncommitted changes across the project.
msgctxt "action documentation"
msgid "git::ViewUncommittedChanges"
msgstr "Muestra los cambios sin commit en todo el proyecto."

#. Shows unstaged changes across the project.
msgctxt "action documentation"
msgid "git::ViewUnstagedChanges"
msgstr "Muestra los cambios sin preparar en todo el proyecto."

#. Opens the git worktree selector.
msgctxt "action documentation"
msgid "git::Worktree"
msgstr "Abre el selector de worktrees de Git."

#. Copies the SHA of the selected commit to the clipboard.
msgctxt "action documentation"
msgid "git_graph::CopyCommitSha"
msgstr "Copia el SHA del commit seleccionado al portapapeles."

#. Copies a tag from the selected commit to the clipboard.
msgctxt "action documentation"
msgid "git_graph::CopyCommitTag"
msgstr "Copia una etiqueta del commit seleccionado al portapapeles."

#. Reorders, squashes, rewords or drops the selected commits in one edit.
msgctxt "action documentation"
msgid "git_graph::EditSelectedCommits"
msgstr "Reordena, combina (squash), cambia el mensaje o descarta los commits seleccionados en una sola edición."

#. Focuses the next git graph tab stop.
msgctxt "action documentation"
msgid "git_graph::FocusNextTabStop"
msgstr "Mueve el foco al siguiente elemento enfocable del grafo de Git."

#. Focuses the previous git graph tab stop.
msgctxt "action documentation"
msgid "git_graph::FocusPreviousTabStop"
msgstr "Mueve el foco al elemento enfocable anterior del grafo de Git."

#. Focuses the search field.
msgctxt "action documentation"
msgid "git_graph::FocusSearch"
msgstr "Enfoca el campo de búsqueda."

#. Opens the Git Graph Tab.
msgctxt "action documentation"
msgid "git_graph::Open"
msgstr "Abre la pestaña del grafo de commits."

#. Opens the Git Graph Tab at a specific commit.
msgctxt "action documentation"
msgid "git_graph::OpenAtCommit"
msgstr "Abre la pestaña del grafo de commits en un commit específico."

#. Opens the commit view for the selected commit.
msgctxt "action documentation"
msgid "git_graph::OpenCommitView"
msgstr "Abre la vista de commit para el commit seleccionado."

#. Selects a commit half a page below the current selection.
msgctxt "action documentation"
msgid "git_graph::ScrollDown"
msgstr "Selecciona un commit media página por debajo de la selección actual."

#. Selects a commit half a page above the current selection.
msgctxt "action documentation"
msgid "git_graph::ScrollUp"
msgstr "Selecciona un commit media página por encima de la selección actual."

#. Toggles the selected commit's changed files between flat and tree views.
msgctxt "action documentation"
msgid "git_graph::ToggleChangedFilesView"
msgstr "Alterna los archivos modificados del commit seleccionado entre las vistas plana y de árbol."

#. Opens the git integration onboarding modal.
msgctxt "action documentation"
msgid "git_onboarding::OpenGitIntegrationOnboarding"
msgstr "Abre el cuadro de diálogo de introducción a la integración con Git."

#. Activates the Changes tab.
msgctxt "action documentation"
msgid "git_panel::ActivateChangesTab"
msgstr "Activa la pestaña Cambios."

#. Activates the History tab.
msgctxt "action documentation"
msgid "git_panel::ActivateHistoryTab"
msgstr "Activa la pestaña Historial."

#. Closes the git panel.
msgctxt "action documentation"
msgid "git_panel::Close"
msgstr "Cierra el panel de Git."

#. Collapses the selected entry to hide its children.
msgctxt "action documentation"
msgid "git_panel::CollapseSelectedEntry"
msgstr "Contrae la entrada seleccionada para ocultar sus elementos secundarios."

#. Expands the selected entry to show its children.
msgctxt "action documentation"
msgid "git_panel::ExpandSelectedEntry"
msgstr "Expande la entrada seleccionada para mostrar sus elementos secundarios."

#. Select first git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::FirstEntry"
msgstr "Selecciona el primer elemento del menú del panel de Git y lo muestra en la vista de diferencias"

#. Focuses on the changes list.
msgctxt "action documentation"
msgid "git_panel::FocusChanges"
msgstr "Enfoca la lista de cambios."

#. Focuses on the commit message editor.
msgctxt "action documentation"
msgid "git_panel::FocusEditor"
msgstr "Enfoca el editor de mensajes de commit."

#. Select last git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::LastEntry"
msgstr "Selecciona el último elemento del menú del panel de Git y lo muestra en la vista de diferencias"

#. Select next git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::NextEntry"
msgstr "Selecciona el siguiente elemento del menú del panel de Git y lo muestra en la vista de diferencias"

#. Opens the git panel menu.
msgctxt "action documentation"
msgid "git_panel::OpenMenu"
msgstr "Abre el menú del panel de Git."

#. Select previous git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::PreviousEntry"
msgstr "Selecciona el elemento anterior del menú del panel de Git y lo muestra en la vista de diferencias"

#. Disables grouping entries by status.
msgctxt "action documentation"
msgid "git_panel::SetGroupByNone"
msgstr "Deshabilita la agrupación de entradas por estado."

#. Groups entries by staging state.
msgctxt "action documentation"
msgid "git_panel::SetGroupByStaging"
msgstr "Agrupa las entradas por estado de preparación."

#. Groups entries by status.
msgctxt "action documentation"
msgid "git_panel::SetGroupByStatus"
msgstr "Agrupa las entradas por estado."

#. Sorts entries by name.
msgctxt "action documentation"
msgid "git_panel::SetSortByName"
msgstr "Ordena las entradas por nombre."

#. Sorts entries by path.
msgctxt "action documentation"
msgid "git_panel::SetSortByPath"
msgstr "Ordena las entradas por ruta."

#. Toggles the git panel.
msgctxt "action documentation"
msgid "git_panel::Toggle"
msgstr "Muestra u oculta el panel de Git."

#. Toggles automatic co-author suggestions.
msgctxt "action documentation"
msgid "git_panel::ToggleFillCoAuthors"
msgstr "Alterna las sugerencias automáticas de coautor."

#. Toggles focus on the git panel.
msgctxt "action documentation"
msgid "git_panel::ToggleFocus"
msgstr "Alterna el foco en el panel de Git."

#. Toggles showing entries in tree vs flat view.
msgctxt "action documentation"
msgid "git_panel::ToggleTreeView"
msgstr "Alterna entre mostrar las entradas en vista de árbol o en vista plana."

#. View staged changes
msgctxt "action documentation"
msgid "git_panel::ViewStagedChanges"
msgstr "Muestra los cambios preparados"

#. View unstaged changes
msgctxt "action documentation"
msgid "git_panel::ViewUnstagedChanges"
msgstr "Muestra los cambios sin preparar"

#. Toggles the go to line dialog.
msgctxt "action documentation"
msgid "go_to_line::Toggle"
msgstr "Muestra u oculta el cuadro de diálogo para ir a una línea."

#. Toggles showing semantic token highlights.
msgctxt "action documentation"
msgid "highlights_tree_view::ToggleSemanticTokens"
msgstr "Muestra u oculta los resaltados de tokens semánticos."

#. Toggles showing syntax token highlights.
msgctxt "action documentation"
msgid "highlights_tree_view::ToggleSyntaxTokens"
msgstr "Muestra u oculta los resaltados de tokens de sintaxis."

#. Toggles showing text highlights.
msgctxt "action documentation"
msgid "highlights_tree_view::ToggleTextHighlights"
msgstr "Muestra u oculta los resaltados de texto."

#. Toggles the icon theme selector interface.
