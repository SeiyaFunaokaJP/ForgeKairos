msgstr "以前从未见过此主机的密钥。是否继续连接？"

msgid "Upload"
msgstr "上传"

msgid "User name"
msgstr "用户名"

msgid "Writes to the list shared with Quick Connect"
msgstr "写入与快速连接共享的列表"

msgid "Yes"
msgstr "是"

