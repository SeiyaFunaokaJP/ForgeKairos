msgid ""
msgstr ""
"Language: zh-Hans\n"
"X-Language-Name: 简体中文\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Auto-updates disabled for non-bundled app."
msgstr "非打包版本的应用已禁用自动更新。"

msgid "Could not auto-update because the required rsync utility was not found."
msgstr "找不到所需的 rsync 工具，无法自动更新。"

msgid "Could not check for updates"
msgstr "无法检查更新"

msgid "Couldn't add the hosts to the allowlist: {error}"
msgstr "无法将主机添加到允许列表：{error}"

msgid "Couldn't check for updates: GitHub answered with HTTP status {status}."
msgstr "无法检查更新：GitHub 返回了 HTTP 状态 {status}。"

msgid "Couldn't check for updates: GitHub could not be reached ({error})."
msgstr "无法检查更新：无法访问 GitHub（{error}）。"

msgid "Couldn't check for updates: GitHub has no release list for {repository}. The repository may be private or not published yet."
msgstr "无法检查更新：GitHub 上没有 {repository} 的发布列表。该仓库可能是私有的或尚未发布。"

msgid "Couldn't check for updates: GitHub's limit for requests without signing in was reached. Try again in {count} minute."
msgid_plural "Couldn't check for updates: GitHub's limit for requests without signing in was reached. Try again in {count} minutes."
msgstr[0] "无法检查更新：已达到 GitHub 对未登录请求的限制。请在 {count} 分钟后重试。"

msgid "Couldn't check for updates: GitHub's limit for requests without signing in was reached. Try again later."
msgstr "无法检查更新：已达到 GitHub 对未登录请求的限制。请稍后重试。"

msgid "Couldn't check for updates: GitHub's release list was not in the expected format."
msgstr "无法检查更新：GitHub 的发布列表不是预期的格式。"

msgid "Downloading remote server"
msgstr "正在下载远程服务器"

msgid "Fetching remote server release"
msgstr "正在获取远程服务器的发布信息"

msgid "Install it with: sudo apt install rsync"
msgstr "使用以下命令安装：sudo apt install rsync"

msgid "Install it with: sudo dnf install rsync"
msgstr "使用以下命令安装：sudo dnf install rsync"

msgid "Install it with: sudo pacman -S rsync"
msgstr "使用以下命令安装：sudo pacman -S rsync"

msgid "Install pkgs.rsync from nixpkgs"
msgstr "请从 nixpkgs 安装 pkgs.rsync"

msgid "Please install rsync using your package manager"
msgstr "请使用包管理器安装 rsync"

msgid "Zed was installed via a package manager."
msgstr "ForgeKairos 是通过包管理器安装的。"

msgid "rsync is required for auto-updates but is not installed. {install_hint}"
msgstr "自动更新需要 rsync，但尚未安装。{install_hint}"
