msgstr "在你审阅并恢复之前，语言服务器将保持受限模式或停止状态。"

msgid "Last Keystroke"
msgstr "最后按键"

msgid "Light mode saves the most memory by not indexing the whole project; references and renames then only cover the open files."
msgstr "轻量模式不为整个项目建立索引，因此最节省内存；但此时查找引用和重命名仅覆盖已打开的文件。"

msgid "Log"
msgstr "日志"

msgid "Log level"
msgstr "日志级别"

msgid "Memory {used}"
msgstr "内存 {used}"

msgid "Memory {used} (background index {background_index}, open files {open_files})"
msgstr "内存 {used}（后台索引 {background_index}，已打开的文件 {open_files}）"

