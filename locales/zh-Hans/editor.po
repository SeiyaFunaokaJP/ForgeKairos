msgid "architecture-beta\n    %% group is a grouping and service a component. :L :R :T :B choose the side a line connects to\n    group app(cloud)[App]\n    service web(server)[Web Server] in app\n    service db(database)[Database] in app\n    service disk(disk)[Storage] in app\n    web:R -- L:db\n    web:B -- T:disk"
msgstr "architecture-beta\n    %% group 是分组，service 是组件。:L :R :T :B 选择连线连接的边\n    group app(cloud)[\"应用\"]\n    service web(server)[\"Web 服务器\"] in app\n    service db(database)[\"数据库\"] in app\n    service disk(disk)[\"存储\"] in app\n    web:R -- L:db\n    web:B -- T:disk"

