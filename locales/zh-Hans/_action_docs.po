msgctxt "action documentation"
msgid "vim::ScrollDown"
msgstr "向下滚动半页。"

#. Scrolls up by half a page.
msgctxt "action documentation"
msgid "vim::ScrollUp"
msgstr "向上滚动半页。"

#. Initiates a search operation with the specified parameters.
msgctxt "action documentation"
msgid "vim::Search"
msgstr "使用指定参数发起搜索操作。"

#. Submits the current search query.
msgctxt "action documentation"
msgid "vim::SearchSubmit"
msgstr "提交当前搜索查询。"

#. Searches for the word under the cursor without moving.
msgctxt "action documentation"
msgid "vim::SearchUnderCursor"
msgstr "搜索光标下的词（不移动光标）。"

#. Searches for the word under the cursor without moving (backwards).
msgctxt "action documentation"
msgid "vim::SearchUnderCursorPrevious"
msgstr "搜索光标下的词（向后，不移动光标）。"

#. Selects the next larger syntax node.
msgctxt "action documentation"
msgid "vim::SelectLargerSyntaxNode"
msgstr "选中下一个更大的语法节点。"

#. Selects the next occurrence of the current selection.
msgctxt "action documentation"
msgid "vim::SelectNext"
msgstr "选中当前选区的下一个匹配位置。"

#. Selects the next match of the current selection.
msgctxt "action documentation"
msgid "vim::SelectNextMatch"
msgstr "选中当前选区的下一个匹配项。"

#. Selects the next syntax node sibling.
msgctxt "action documentation"
msgid "vim::SelectNextSyntaxNode"
msgstr "选中下一个同级语法节点。"

#. Selects the previous occurrence of the current selection.
msgctxt "action documentation"
msgid "vim::SelectPrevious"
msgstr "选中当前选区的上一个匹配位置。"

#. Selects the previous match of the current selection.
msgctxt "action documentation"
msgid "vim::SelectPreviousMatch"
msgstr "选中当前选区的上一个匹配项。"

#. Selects the previous syntax node sibling.
msgctxt "action documentation"
msgid "vim::SelectPreviousSyntaxNode"
msgstr "选中上一个同级语法节点。"

#. Selects the next smaller syntax node.
msgctxt "action documentation"
msgid "vim::SelectSmallerSyntaxNode"
msgstr "选中下一个更小的语法节点。"

#. Selects a sentence text object.
msgctxt "action documentation"
msgid "vim::Sentence"
msgstr "选择一个句子文本对象。"

#. Moves to the start of the previous sentence.
msgctxt "action documentation"
msgid "vim::SentenceBackward"
msgstr "移至上一个句子的开头。"

#. Moves to the start of the next sentence.
msgctxt "action documentation"
msgid "vim::SentenceForward"
msgstr "移至下一个句子的开头。"

#. Executes a shell command.
msgctxt "action documentation"
msgid "vim::ShellCommand"
msgstr "执行 Shell 命令。"

#. Shows the current location in the file.
msgctxt "action documentation"
msgid "vim::ShowLocation"
msgstr "显示当前在文件中的位置。"

#. Operates on text within or around square brackets `[]`.
msgctxt "action documentation"
msgid "vim::SquareBrackets"
msgstr "操作方括号 `[]` 内部或周围的文本。"

#. Moves to the start of the document.
msgctxt "action documentation"
msgid "vim::StartOfDocument"
msgstr "移至文档开头。"

#. Moves to the start of the current line.
msgctxt "action documentation"
msgid "vim::StartOfLine"
msgstr "移至当前行的行首。"

#. Moves to the start of a line downward.
msgctxt "action documentation"
msgid "vim::StartOfLineDownward"
msgstr "向下移至相应行的行首。"

#. Moves to the start of the paragraph.
msgctxt "action documentation"
msgid "vim::StartOfParagraph"
msgstr "移至段落开头。"

#. Substitutes characters in the current selection.
msgctxt "action documentation"
msgid "vim::Substitute"
msgstr "替换当前选区中的字符。"

#. Substitutes the entire line.
msgctxt "action documentation"
msgid "vim::SubstituteLine"
msgstr "替换整行。"

#. Selects a subword text object.
msgctxt "action documentation"
msgid "vim::Subword"
msgstr "选择一个子词文本对象。"

#. Switches to Helix-style normal mode.
msgctxt "action documentation"
msgid "vim::SwitchToHelixNormalMode"
msgstr "切换到 Helix 风格的普通模式。"

#. Switches to insert mode.
msgctxt "action documentation"
msgid "vim::SwitchToInsertMode"
msgstr "切换到插入模式。"

#. Switches to normal mode.
msgctxt "action documentation"
msgid "vim::SwitchToNormalMode"
msgstr "切换到普通模式。"

#. Switches to replace mode.
msgctxt "action documentation"
msgid "vim::SwitchToReplaceMode"
msgstr "切换到替换模式。"

#. Switches to visual block mode.
msgctxt "action documentation"
msgid "vim::SwitchToVisualBlockMode"
msgstr "切换到可视块模式。"

#. Switches to visual line mode.
msgctxt "action documentation"
msgid "vim::SwitchToVisualLineMode"
msgstr "切换到可视行模式。"

#. Switches to visual mode.
msgctxt "action documentation"
msgid "vim::SwitchToVisualMode"
msgstr "切换到可视模式。"

#. Inserts a tab character.
msgctxt "action documentation"
msgid "vim::Tab"
msgstr "插入制表符。"

#. Selects an HTML/XML tag.
msgctxt "action documentation"
msgid "vim::Tag"
msgstr "选择一个 HTML/XML 标签。"

#. Temporarily switches to normal mode for one command.
msgctxt "action documentation"
msgid "vim::TemporaryNormal"
msgstr "临时切换到普通模式以执行一个命令。"

#. Toggles block comments for selected lines.
msgctxt "action documentation"
msgid "vim::ToggleBlockComments"
msgstr "切换所选行的块注释。"

#. Toggles comments for selected lines.
msgctxt "action documentation"
msgid "vim::ToggleComments"
msgstr "切换所选行的注释。"

#. Toggles the marks view.
msgctxt "action documentation"
msgid "vim::ToggleMarksView"
msgstr "切换标记视图。"

#. Clears count or toggles project panel focus
msgctxt "action documentation"
msgid "vim::ToggleProjectPanelFocus"
msgstr "清除计数或切换项目面板焦点。"

#. Toggles macro recording.
msgctxt "action documentation"
msgid "vim::ToggleRecord"
msgstr "切换宏录制。"

#. Toggles the registers view.
msgctxt "action documentation"
msgid "vim::ToggleRegistersView"
msgstr "切换寄存器视图。"

#. Toggles replace mode.
msgctxt "action documentation"
msgid "vim::ToggleReplace"
msgstr "切换替换模式。"

#. Toggles visual mode.
msgctxt "action documentation"
msgid "vim::ToggleVisual"
msgstr "切换可视模式。"

#. Toggles visual block mode.
msgctxt "action documentation"
msgid "vim::ToggleVisualBlock"
msgstr "切换可视块模式。"

#. Toggles visual line mode.
msgctxt "action documentation"
msgid "vim::ToggleVisualLine"
msgstr "切换可视行模式。"

#. Undoes the last change.
msgctxt "action documentation"
msgid "vim::Undo"
msgstr "撤销上次更改。"

#. Undoes all changes to the most recently changed line.
msgctxt "action documentation"
msgid "vim::UndoLastLine"
msgstr "撤销最近更改行的所有更改。"

#. Undoes the last replacement.
msgctxt "action documentation"
msgid "vim::UndoReplace"
msgstr "撤销上一次替换。"

#. Finds the previous unmatched bracket or delimiter.
msgctxt "action documentation"
msgid "vim::UnmatchedBackward"
msgstr "查找上一个未匹配的括号或分隔符。"

#. Finds the next unmatched bracket or delimiter.
msgctxt "action documentation"
msgid "vim::UnmatchedForward"
msgstr "查找下一个未匹配的括号或分隔符。"

#. Moves cursor up by the specified number of lines.
msgctxt "action documentation"
msgid "vim::Up"
msgstr "将光标向上移动指定行数。"

#. Selects text within vertical bars (pipes).
msgctxt "action documentation"
msgid "vim::VerticalBars"
msgstr "选择竖线（管道符）内的文本。"

#. Executes a command in visual mode.
msgctxt "action documentation"
msgid "vim::VisualCommand"
msgstr "在可视模式下执行命令。"

#. Deletes the visual selection.
msgctxt "action documentation"
msgid "vim::VisualDelete"
msgstr "删除可视选区。"

#. Deletes entire lines in visual selection.
msgctxt "action documentation"
msgid "vim::VisualDeleteLine"
msgstr "删除可视选区中的整行。"

#. Inserts at the end of each line in visual selection.
msgctxt "action documentation"
msgid "vim::VisualInsertEndOfLine"
msgstr "在可视选区每行末尾插入。"

#. Inserts at the first non-whitespace character of each line.
msgctxt "action documentation"
msgid "vim::VisualInsertFirstNonWhiteSpace"
msgstr "在每行第一个非空白字符处插入。"

#. Yanks (copies) the visual selection.
msgctxt "action documentation"
msgid "vim::VisualYank"
msgstr "复制可视模式下的选区。"

#. Yanks entire lines in visual selection.
msgctxt "action documentation"
msgid "vim::VisualYankLine"
msgstr "复制可视模式选区中的整行。"

#. Moves to the bottom of the window.
msgctxt "action documentation"
msgid "vim::WindowBottom"
msgstr "移到窗口底部。"

#. Moves to the middle of the window.
msgctxt "action documentation"
msgid "vim::WindowMiddle"
msgstr "移到窗口中间。"

#. Moves to the top of the window.
msgctxt "action documentation"
msgid "vim::WindowTop"
msgstr "移至窗口顶部。"

#. Selects a word text object.
msgctxt "action documentation"
msgid "vim::Word"
msgstr "选择一个单词文本对象。"

#. Moves cursor left one character, wrapping to previous line.
msgctxt "action documentation"
msgid "vim::WrappingLeft"
msgstr "将光标向左移动一个字符，到达行首时换到上一行。"

#. Moves cursor right one character, wrapping to next line.
msgctxt "action documentation"
msgid "vim::WrappingRight"
msgstr "将光标向右移动一个字符，到达行末时换到下一行。"

#. Yanks (copies) the selected text.
msgctxt "action documentation"
msgid "vim::Yank"
msgstr "复制选定的文本。"

#. Yanks the entire line.
msgctxt "action documentation"
msgid "vim::YankLine"
msgstr "复制整行。"

#. Yanks from cursor to end of line.
msgctxt "action documentation"
msgid "vim::YankToEndOfLine"
msgstr "从光标处复制到行尾。"

#. Shows the bindings that can complete the pending key sequence. Must be bound to a
#. single keystroke.
msgctxt "action documentation"
msgid "which_key::ShowPendingBindings"
msgstr "显示可补全当前待处理按键序列的键绑定。必须绑定到单个按键。"

#. Activates the last pane in the workspace.
msgctxt "action documentation"
msgid "workspace::ActivateLastPane"
msgstr "激活工作区中的最后一个窗格。"

#. Activates the next pane in the workspace.
msgctxt "action documentation"
msgid "workspace::ActivateNextPane"
msgstr "激活工作区中的下一个窗格。"

#. Switches to the next window.
msgctxt "action documentation"
msgid "workspace::ActivateNextWindow"
msgstr "切换到下一个窗口。"

#. Activates a specific pane by its index.
msgctxt "action documentation"
msgid "workspace::ActivatePane"
msgstr "按索引激活特定窗格。"

#. Activates the pane below.
msgctxt "action documentation"
msgid "workspace::ActivatePaneDown"
msgstr "激活下方的窗格。"

#. Activates the pane to the left.
msgctxt "action documentation"
msgid "workspace::ActivatePaneLeft"
msgstr "激活左侧的窗格。"

#. Activates the pane to the right.
msgctxt "action documentation"
msgid "workspace::ActivatePaneRight"
msgstr "激活右侧的窗格。"

#. Activates the pane above.
msgctxt "action documentation"
msgid "workspace::ActivatePaneUp"
msgstr "激活上方的窗格。"

#. Activates the previous pane in the workspace.
msgctxt "action documentation"
msgid "workspace::ActivatePreviousPane"
msgstr "激活工作区中的上一个窗格。"

#. Switches to the previous window.
msgctxt "action documentation"
msgid "workspace::ActivatePreviousWindow"
msgstr "切换到上一个窗口。"

#. Adds a folder to the current project.
msgctxt "action documentation"
msgid "workspace::AddFolderToProject"
msgstr "向当前项目添加文件夹。"

#. Replaces the project's open folder with a different one, adding the
#. new worktree before closing the previous one so a remote connection
#. does not need to be re-established.
msgctxt "action documentation"
msgid "workspace::ChangeProjectFolder"
msgstr "将项目中打开的文件夹替换为另一个文件夹，会先添加新的工作树再关闭之前的工作树，因此无需重新建立远程连接。"

#. Clears all notifications.
msgctxt "action documentation"
msgid "workspace::ClearAllNotifications"
msgstr "清除所有通知。"

#. Clears all bookmarks in the project.
msgctxt "action documentation"
msgid "workspace::ClearBookmarks"
msgstr "清除项目中的所有书签。"

#. Clears all navigation history, including forward/backward navigation, recently opened files, and recently closed tabs. **This action is irreversible**.
msgctxt "action documentation"
msgid "workspace::ClearNavigationHistory"
msgstr "清除所有导航历史记录，包括前进/后退导航、最近打开的文件和最近关闭的标签页。**此操作不可撤销**。"

#. Clears all trusted worktrees, placing them in restricted mode on next open.
#. Requires restart to take effect on already opened projects.
msgctxt "action documentation"
msgid "workspace::ClearTrustedWorktrees"
msgstr "清除对所有工作树的信任，使其在下次打开时进入受限模式。\n需要重启才能对已打开的项目生效。"

#. Closes the active dock.
msgctxt "action documentation"
msgid "workspace::CloseActiveDock"
msgstr "关闭活动停靠栏。"

#. Closes all docks.
msgctxt "action documentation"
msgid "workspace::CloseAllDocks"
msgstr "关闭所有停靠栏。"

#. Closes all items and panes in the workspace.
msgctxt "action documentation"
msgid "workspace::CloseAllItemsAndPanes"
msgstr "关闭工作区中所有项和窗格。"

#. Closes all inactive tabs and panes in the workspace.
msgctxt "action documentation"
msgid "workspace::CloseInactiveTabsAndPanes"
msgstr "关闭工作区中所有非活动标签页和窗格。"

#. Closes the active item across all panes.
msgctxt "action documentation"
msgid "workspace::CloseItemInAllPanes"
msgstr "关闭所有窗格中的活动项。"

#. Closes the current project.
msgctxt "action documentation"
msgid "workspace::CloseProject"
msgstr "关闭当前项目。"

#. Closes the current window.
msgctxt "action documentation"
msgid "workspace::CloseWindow"
msgstr "关闭当前窗口。"

#. Decreases size of a currently focused dock by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::DecreaseActiveDockSize"
msgstr "将当前聚焦的停靠栏减小指定像素。"

#. Decreases size of all currently visible docks uniformly, by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::DecreaseOpenDocksSize"
msgstr "将所有当前可见的停靠栏均匀减小指定像素。"

#. Opens the feedback dialog.
msgctxt "action documentation"
msgid "workspace::Feedback"
msgstr "打开反馈对话框。"

#. Moves Focus to the central panes in the workspace.
msgctxt "action documentation"
msgid "workspace::FocusCenterPane"
msgstr "将焦点移至工作区中央窗格。"

#. Moves focus to the next major region of the window (editor, open
#. panels, status bar), cycling and wrapping around. Intended as a
#. discoverable, screen-reader-friendly way to navigate the window.
msgctxt "action documentation"
msgid "workspace::FocusNextPart"
msgstr "将焦点移至窗口的下一个主要区域，\n包括编辑器、打开的面板和状态栏，并循环切换、在末尾回绕。\n这是一种易于发现且适合屏幕阅读器的窗口导航方式。"

#. Moves focus to the previous major region of the window. See
#. [`FocusNextPart`].
msgctxt "action documentation"
msgid "workspace::FocusPreviousPart"
msgstr "将焦点移至窗口的上一个主要区域。参见\n[`FocusNextPart`]。"

#. Follows the next collaborator in the session.
msgctxt "action documentation"
msgid "workspace::FollowNextCollaborator"
msgstr "跟随会话中的下一位协作者。"

#. Formats and saves the current file, regardless of the format_on_save setting.
msgctxt "action documentation"
msgid "workspace::FormatAndSave"
msgstr "格式化并保存当前文件，忽略 format_on_save 设置。"

#. Increases size of a currently focused dock by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::IncreaseActiveDockSize"
msgstr "将当前聚焦的停靠栏增大指定像素。"

#. Increases size of all currently visible docks uniformly, by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::IncreaseOpenDocksSize"
msgstr "将所有当前可见停靠栏均匀增大指定像素。"

#. Moves the focused panel to the next position.
msgctxt "action documentation"
msgid "workspace::MoveFocusedPanelToNextPosition"
msgstr "将聚焦面板移到下一个位置。"

#. Moves the active tab into a new window of its own.
msgctxt "action documentation"
msgid "workspace::MoveItemToNewWindow"
msgstr "将活动标签页移到一个单独的新窗口中。"

#. Moves an item to a specific pane by index.
msgctxt "action documentation"
msgid "workspace::MoveItemToPane"
msgstr "将项移至指定索引的窗格。"

#. Moves an item to a pane in the specified direction.
msgctxt "action documentation"
msgid "workspace::MoveItemToPaneInDirection"
msgstr "将项移至指定方向的窗格。"

#. Move the current pane to be at the very bottom.
msgctxt "action documentation"
msgid "workspace::MovePaneDown"
msgstr "将当前窗格移至最底部。"

#. Move the current pane to be at the far left.
msgctxt "action documentation"
msgid "workspace::MovePaneLeft"
msgstr "将当前窗格移至最左侧。"

#. Move the current pane to be at the far right.
msgctxt "action documentation"
msgid "workspace::MovePaneRight"
msgstr "将当前窗格移至最右侧。"

#. Move the current pane to be at the very top.
msgctxt "action documentation"
msgid "workspace::MovePaneUp"
msgstr "将当前窗格移至最顶部。"

#. Opens a new terminal in the center.
msgctxt "action documentation"
msgid "workspace::NewCenterTerminal"
msgstr "在中央区域打开一个新终端。"

#. Creates a new file.
msgctxt "action documentation"
msgid "workspace::NewFile"
msgstr "创建新文件。"

#. Creates a new file in a split of the desired direction.
msgctxt "action documentation"
msgid "workspace::NewFileSplit"
msgstr "在指定方向的拆分窗格中创建新文件。"

#. Creates a new file in a horizontal split.
msgctxt "action documentation"
msgid "workspace::NewFileSplitHorizontal"
msgstr "在水平拆分窗格中创建新文件。"

#. Creates a new file in a vertical split.
msgctxt "action documentation"
msgid "workspace::NewFileSplitVertical"
msgstr "在垂直拆分窗格中创建新文件。"

#. Opens a new search.
msgctxt "action documentation"
msgid "workspace::NewSearch"
msgstr "打开新的搜索。"

#. Opens a new terminal.
msgctxt "action documentation"
msgid "workspace::NewTerminal"
msgstr "打开一个新终端。"

#. Opens a new window.
msgctxt "action documentation"
msgid "workspace::NewWindow"
msgstr "打开一个新窗口。"

#. Opens a file or directory.
msgctxt "action documentation"
msgid "workspace::Open"
msgstr "打开一个文件或文件夹。"

#. Opens the component preview.
msgctxt "action documentation"
msgid "workspace::OpenComponentPreview"
msgstr "打开组件预览。"

#. Opens multiple files.
msgctxt "action documentation"
msgid "workspace::OpenFiles"
msgstr "打开多个文件。"

#. Opens the current location in terminal.
msgctxt "action documentation"
msgid "workspace::OpenInTerminal"
msgstr "在终端中打开当前位置。"

#. Opens a new terminal with the specified working directory.
msgctxt "action documentation"
msgid "workspace::OpenTerminal"
msgstr "以指定工作目录打开一个新终端。"

#. Opens the selected file with the system's default application.
msgctxt "action documentation"
msgid "workspace::OpenWithSystem"
msgstr "用系统默认应用程序打开所选文件。"

#. Reloads the application
msgctxt "action documentation"
msgid "workspace::Reload"
msgstr "重新加载应用程序。"

#. Reloads the active item.
msgctxt "action documentation"
msgid "workspace::ReloadActiveItem"
msgstr "重新加载当前活动项。"

#. Reopens the most recently dismissed picker in the current window.
msgctxt "action documentation"
msgid "workspace::ReopenLastPicker"
msgstr "重新打开当前窗口中最近关闭的选择器。"

#. Resets the active dock to its default size.
msgctxt "action documentation"
msgid "workspace::ResetActiveDockSize"
msgstr "将当前停靠栏重置为默认大小。"

#. Resets all open docks to their default sizes.
msgctxt "action documentation"
msgid "workspace::ResetOpenDocksSize"
msgstr "将所有已打开的停靠栏重置为默认大小。"

#. Resets all panes in the center group to equal sizes, preserving the split layout.
msgctxt "action documentation"
msgid "workspace::ResetPaneSizes"
msgstr "将中央组中的所有窗格重置为相同大小，同时保留拆分布局。"

#. Restores the banner.
msgctxt "action documentation"
msgid "workspace::RestoreBanner"
msgstr "恢复横幅。"

#. Saves the current file with the specified options.
msgctxt "action documentation"
msgid "workspace::Save"
msgstr "使用指定选项保存当前文件。"

#. Saves all open files in the workspace.
msgctxt "action documentation"
msgid "workspace::SaveAll"
msgstr "保存工作区中所有打开的文件。"

#. Saves the current file with a new name.
msgctxt "action documentation"
msgid "workspace::SaveAs"
msgstr "将当前文件另存为新文件。"

#. Saves without formatting.
msgctxt "action documentation"
msgid "workspace::SaveWithoutFormat"
msgstr "保存时不进行格式化。"

#. Sends a sequence of keystrokes to the active element.
msgctxt "action documentation"
msgid "workspace::SendKeystrokes"
msgstr "向当前活动元素发送按键序列。"

#. Shuts down all debug adapters.
msgctxt "action documentation"
msgid "workspace::ShutdownDebugAdapters"
msgstr "关闭所有调试适配器。"

#. Suppresses the current notification.
msgctxt "action documentation"
msgid "workspace::SuppressNotification"
msgstr "屏蔽当前通知。"

#. Swaps the current pane with the one below.
msgctxt "action documentation"
msgid "workspace::SwapPaneDown"
msgstr "将当前窗格与下方窗格交换。"

#. Swaps the current pane with the one to the left.
msgctxt "action documentation"
msgid "workspace::SwapPaneLeft"
msgstr "将当前窗格与左侧窗格交换。"

#. Swaps the current pane with the one to the right.
msgctxt "action documentation"
msgid "workspace::SwapPaneRight"
msgstr "将当前窗格与右侧窗格交换。"

#. Swaps the current pane with the one above.
msgctxt "action documentation"
msgid "workspace::SwapPaneUp"
msgstr "将当前窗格与上方窗格交换。"

#. Toggles all docks.
msgctxt "action documentation"
msgid "workspace::ToggleAllDocks"
msgstr "切换所有停靠栏。"

#. Toggles the bottom dock.
msgctxt "action documentation"
msgid "workspace::ToggleBottomDock"
msgstr "切换底部停靠栏。"

#. Toggles centered layout mode.
msgctxt "action documentation"
msgid "workspace::ToggleCenteredLayout"
msgstr "切换居中布局模式。"

#. Toggles edit prediction feature globally for all files.
msgctxt "action documentation"
msgid "workspace::ToggleEditPrediction"
msgstr "全局切换所有文件的编辑预测功能。"

#. Toggles maximizing the active editor pane within the center area,
#. hiding other split panes but leaving docks/panels unaffected.
msgctxt "action documentation"
msgid "workspace::ToggleEditorZoom"
msgstr "切换中央区域内活动编辑器窗格的最大化状态，\n隐藏其他拆分窗格，但不影响停靠栏和面板。"

#. Toggles expansion of the selected item.
msgctxt "action documentation"
msgid "workspace::ToggleExpandItem"
msgstr "切换所选项的展开状态。"

#. Toggles Helix mode on or off.
msgctxt "action documentation"
msgid "workspace::ToggleHelixMode"
msgstr "开启或关闭 Helix 模式。"

#. Toggles the left dock.
msgctxt "action documentation"
msgid "workspace::ToggleLeftDock"
msgstr "切换左侧停靠栏。"

#. Toggles read-only mode for the active item (if supported by that item).
msgctxt "action documentation"
msgid "workspace::ToggleReadOnlyFile"
msgstr "切换活动项的只读模式（如果该项支持）。"

#. Toggles the right dock.
msgctxt "action documentation"
msgid "workspace::ToggleRightDock"
msgstr "切换右侧停靠栏。"

#. Toggles Vim mode on or off.
msgctxt "action documentation"
msgid "workspace::ToggleVimMode"
msgstr "开启或关闭 Vim 模式。"

#. If any worktrees are in restricted mode, shows a modal with possible actions.
#. If the modal is shown already, closes it without trusting any worktree.
msgctxt "action documentation"
msgid "workspace::ToggleWorktreeSecurity"
msgstr "如果任何工作树处于受限模式，则显示包含可用操作的对话框。\n如果对话框已显示，则关闭它而不信任任何工作树。"

#. Toggles zoom on the active pane.
msgctxt "action documentation"
msgid "workspace::ToggleZoom"
msgstr "切换活动窗格的缩放。"

#. Stops following a collaborator.
msgctxt "action documentation"
msgid "workspace::Unfollow"
msgstr "停止跟随协作者。"

#. Switches to the agentic panel layout.
msgctxt "action documentation"
msgid "workspace::UseAgenticLayout"
msgstr "切换到智能体式面板布局。"

#. Switches to the classic, editor-focused panel layout.
msgctxt "action documentation"
msgid "workspace::UseClassicLayout"
msgstr "切换到以编辑器为中心的经典面板布局。"

#. Zooms in on the active pane.
msgctxt "action documentation"
msgid "workspace::ZoomIn"
msgstr "放大活动窗格。"

#. Zooms out of the active pane.
msgctxt "action documentation"
msgid "workspace::ZoomOut"
msgstr "缩小活动窗格。"

#. Deletes the selected git worktree.
msgctxt "action documentation"
msgid "worktree_picker::DeleteWorktree"
msgstr "删除所选 Git 工作树。"

#. Force deletes the selected git worktree.
msgctxt "action documentation"
msgid "worktree_picker::ForceDeleteWorktree"
msgstr "强制删除所选 Git 工作树。"

#. Shows information about Zed.
msgctxt "action documentation"
msgid "zed::About"
msgstr "显示 ForgeKairos 的相关信息。"

#. Opens the ACP registry.
msgctxt "action documentation"
msgid "zed::AcpRegistry"
msgstr "打开 ACP 注册表。"

#. Cancels an in-progress ETW trace without saving.
msgctxt "action documentation"
msgid "zed::CancelEtwTrace"
msgstr "取消正在进行的 ETW 跟踪而不保存。"

#. Copies installed extensions to the clipboard for bug reports.
msgctxt "action documentation"
msgid "zed::CopyInstalledExtensionsIntoClipboard"
msgstr "将已安装的扩展信息复制到剪贴板以用于错误报告。"

#. Copies system specifications to the clipboard for bug reports.
msgctxt "action documentation"
msgid "zed::CopySystemSpecsIntoClipboard"
msgstr "将系统规格信息复制到剪贴板以用于错误报告。"

#. Opens the element inspector for debugging UI.
msgctxt "action documentation"
msgid "zed::DebugElements"
msgstr "打开元素检查器以调试 UI。"

#. Decreases the font size in the editor buffer.
msgctxt "action documentation"
msgid "zed::DecreaseBufferFontSize"
msgstr "减小编辑器缓冲区的字体大小。"

#. Decreases the font size of the user interface.
msgctxt "action documentation"
msgid "zed::DecreaseUiFontSize"
msgstr "减小用户界面的字体大小。"

#. Opens the extensions management interface.
msgctxt "action documentation"
msgid "zed::Extensions"
msgstr "打开扩展管理界面。"

#. Opens the Zed merch store.
msgctxt "action documentation"
msgid "zed::GetMerch"
msgstr "打开 Zed 周边商店。"

#. Hides the application window.
msgctxt "action documentation"
msgid "zed::Hide"
msgstr "隐藏应用程序窗口。"

#. Hides all other application windows.
msgctxt "action documentation"
msgid "zed::HideOthers"
msgstr "隐藏所有其他应用程序窗口。"

#. Imports settings from Cursor editor.
msgctxt "action documentation"
msgid "zed::ImportCursorSettings"
msgstr "从 Cursor 编辑器导入设置。"

#. Imports settings from Visual Studio Code.
msgctxt "action documentation"
msgid "zed::ImportVsCodeSettings"
msgstr "从 Visual Studio Code 导入设置。"

#. Increases the font size in the editor buffer.
msgctxt "action documentation"
msgid "zed::IncreaseBufferFontSize"
msgstr "增大编辑器缓冲区的字体大小。"

#. Increases the font size of the user interface.
msgctxt "action documentation"
msgid "zed::IncreaseUiFontSize"
msgstr "增大用户界面的字体大小。"

#. Installs an extension from a local directory for development.
msgctxt "action documentation"
msgid "zed::InstallDevExtension"
msgstr "从本地目录安装扩展用于开发。"

#. Minimizes the current window.
msgctxt "action documentation"
msgid "zed::Minimize"
msgstr "最小化当前窗口。"

#. Action with special handling which unbinds the keybinding this is associated with,
#. if it is the highest precedence match.
msgctxt "action documentation"
msgid "zed::NoAction"
msgstr "具有特殊处理的操作，用于解绑与之关联的键绑定，\n如果它是最高优先级匹配项。"

#. Opens account settings.
msgctxt "action documentation"
msgid "zed::OpenAccountSettings"
msgstr "打开账户设置。"

#. Opens a URL in the system's default web browser.
msgctxt "action documentation"
msgid "zed::OpenBrowser"
msgstr "在系统默认浏览器中打开一个 URL。"

#. Opens debug tasks configuration.
msgctxt "action documentation"
msgid "zed::OpenDebugTasks"
msgstr "打开调试任务配置。"

#. Opens the default keymap file.
msgctxt "action documentation"
msgid "zed::OpenDefaultKeymap"
msgstr "打开默认键映射文件。"

#. Opens the default settings file.
msgctxt "action documentation"
msgid "zed::OpenDefaultSettings"
msgstr "打开默认设置文件。"

#. Opens the documentation website.
msgctxt "action documentation"
msgid "zed::OpenDocs"
msgstr "打开文档网站。"

#. Opens the keymap editor.
msgctxt "action documentation"
msgid "zed::OpenKeymap"
msgstr "打开键映射编辑器。"

#. Opens the user keymap file.
msgctxt "action documentation"
msgid "zed::OpenKeymapFile"
msgstr "打开用户键映射文件。"

#. Views open source licenses.
msgctxt "action documentation"
msgid "zed::OpenLicenses"
msgstr "查看开源许可证。"

#. Opens the Zed log file.
msgctxt "action documentation"
msgid "zed::OpenLog"
msgstr "打开 ForgeKairos 日志文件。"

#. Opens the onboarding view.
msgctxt "action documentation"
msgid "zed::OpenOnboarding"
msgstr "打开入门引导视图。"

#. Opens the performance profiler.
msgctxt "action documentation"
msgid "zed::OpenPerformanceProfiler"
msgstr "打开性能分析器。"

#. Opens project-specific settings.
msgctxt "action documentation"
msgid "zed::OpenProjectSettings"
msgstr "打开项目专属设置。"

#. Opens project-specific settings file.
msgctxt "action documentation"
msgid "zed::OpenProjectSettingsFile"
msgstr "打开项目专属设置文件。"

#. Opens the project tasks configuration.
msgctxt "action documentation"
msgid "zed::OpenProjectTasks"
msgstr "打开项目任务配置。"

#. Opens server settings.
msgctxt "action documentation"
msgid "zed::OpenServerSettings"
msgstr "打开服务器设置。"

#. Opens the settings editor.
msgctxt "action documentation"
msgid "zed::OpenSettings"
msgstr "打开设置编辑器。"

#. Opens the settings editor at a specific path.
msgctxt "action documentation"
msgid "zed::OpenSettingsAt"
msgstr "在指定路径处打开设置编辑器。"

#. Opens the settings JSON file.
msgctxt "action documentation"
msgid "zed::OpenSettingsFile"
msgstr "打开设置 JSON 文件。"

#. Opens the Zed status page.
msgctxt "action documentation"
msgid "zed::OpenStatusPage"
msgstr "打开 Zed 状态页面。"

#. Opens the tasks panel.
msgctxt "action documentation"
msgid "zed::OpenTasks"
msgstr "打开任务面板。"

#. Opens the telemetry log.
msgctxt "action documentation"
msgid "zed::OpenTelemetryLog"
msgstr "打开遥测日志。"

#. Opens the project tasks configuration with worktree setup guidance.
msgctxt "action documentation"
msgid "zed::OpenWorktreeSetupTasks"
msgstr "打开项目任务配置，并提供工作树设置指南。"

#. Opens the Zed repository on GitHub.
msgctxt "action documentation"
msgid "zed::OpenZedRepo"
msgstr "在 GitHub 上打开 Zed 仓库。"

#. Opens a zed:// URL within the application.
msgctxt "action documentation"
msgid "zed::OpenZedUrl"
msgstr "在应用程序内打开一个 zed:// URL。"

#. Quits the application.
msgctxt "action documentation"
msgid "zed::Quit"
msgstr "退出应用程序。"

#. Rebuilds an installed dev extension.
msgctxt "action documentation"
msgid "zed::RebuildDevExtension"
msgstr "重新构建已安装的开发扩展。"

#. Starts recording an ETW (Event Tracing for Windows) trace.
msgctxt "action documentation"
msgid "zed::RecordEtwTrace"
msgstr "开始录制 ETW（Windows 事件跟踪）跟踪。"

#. Starts recording an ETW (Event Tracing for Windows) trace with heap tracing.
msgctxt "action documentation"
msgid "zed::RecordEtwTraceWithHeapTracing"
msgstr "开始录制带堆跟踪的 ETW（Windows 事件跟踪）跟踪。"

#. Reloads all installed extensions.
msgctxt "action documentation"
msgid "zed::ReloadExtensions"
msgstr "重新加载所有已安装的扩展。"

#. Resets all zoom levels (UI and buffer font sizes, including in the agent panel) to their default values.
msgctxt "action documentation"
msgid "zed::ResetAllZoom"
msgstr "将所有缩放级别（UI 和缓冲区字体大小，包括智能体面板）重置为默认值。"

#. Resets the buffer font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetBufferFontSize"
msgstr "将缓冲区字体大小重置为默认值。"

#. Resets the application database.
msgctxt "action documentation"
msgid "zed::ResetDatabase"
msgstr "重置应用程序数据库。"

#. Resets the UI font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetUiFontSize"
msgstr "将 UI 字体大小重置为默认值。"

#. Reveals the Zed log file in the system file manager.
msgctxt "action documentation"
msgid "zed::RevealLogInFileManager"
msgstr "在系统文件管理器中显示 ForgeKairos 日志文件。"

#. Saves an in-progress ETW trace to disk.
msgctxt "action documentation"
msgid "zed::SaveEtwTrace"
msgstr "将进行中的 ETW 跟踪保存到磁盘。"

#. Shows all hidden windows.
msgctxt "action documentation"
msgid "zed::ShowAll"
msgstr "显示所有隐藏窗口。"

#. Shows the default semantic token rules (read-only).
msgctxt "action documentation"
msgid "zed::ShowDefaultSemanticTokenRules"
msgstr "显示默认语义标记规则（只读）。"

#. Shows the auto-update notification for testing.
msgctxt "action documentation"
msgid "zed::ShowUpdateNotification"
msgstr "显示用于测试的自动更新通知。"

#. Show the Zed welcome screen
msgctxt "action documentation"
msgid "zed::ShowWelcome"
msgstr "显示 ForgeKairos 欢迎屏幕。"

#. Triggers a hard crash for debugging.
msgctxt "action documentation"
msgid "zed::TestCrash"
msgstr "触发用于调试的强制崩溃。"

#. Triggers a test panic for debugging.
msgctxt "action documentation"
msgid "zed::TestPanic"
msgstr "触发用于调试的测试 panic。"

#. Toggles the base keymap selector modal.
msgctxt "action documentation"
msgid "zed::ToggleBaseKeymapSelector"
msgstr "切换基础键映射选择器对话框。"

#. Toggles fullscreen mode.
msgctxt "action documentation"
msgid "zed::ToggleFullScreen"
msgstr "切换全屏模式。"

#. Action with special handling which unbinds later bindings for the same keystrokes when they
#. dispatch the named action, regardless of that action's context.
#.
#. In keymap JSON this is written as:
#.
#. `["zed::Unbind", "editor::NewLine"]`
msgctxt "action documentation"
msgid "zed::Unbind"
msgstr "一个经特殊处理的操作：当后定义的、相同按键的绑定会派发指定的操作时，取消这些绑定，无论该操作的上下文如何。\n\n在键映射 JSON 中写作：\n\n`[\"zed::Unbind\", \"editor::NewLine\"]`"

#. Zooms the window.
msgctxt "action documentation"
msgid "zed::Zoom"
msgstr "缩放窗口。"

#. Opens the Zed Predict onboarding modal.
msgctxt "action documentation"
msgid "zed_predict_onboarding::OpenZedPredictOnboarding"
msgstr "打开 Zed Predict 入门引导对话框。"

#. Focuses on the completions list.
msgctxt "action documentation"
msgid "zeta::FocusPredictions"
msgstr "聚焦到补全列表。"

#. Navigates to the next edit in the completion history.
msgctxt "action documentation"
msgid "zeta::NextEdit"
msgstr "跳转到补全历史中的下一处编辑。"

#. Previews the selected completion.
msgctxt "action documentation"
msgid "zeta::PreviewPrediction"
msgstr "预览所选补全项。"

#. Navigates to the previous edit in the completion history.
msgctxt "action documentation"
msgid "zeta::PreviousEdit"
msgstr "跳转到补全历史中的上一处编辑。"

#. Rates the active completion with a thumbs down.
msgctxt "action documentation"
msgid "zeta::ThumbsDownActivePrediction"
msgstr "对当前补全给出差评。"

#. Rates the active completion with a thumbs up.
msgctxt "action documentation"
msgid "zeta::ThumbsUpActivePrediction"
msgstr "对当前补全给出好评。"
