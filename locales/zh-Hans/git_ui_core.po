msgstr "当前窗口"

msgid "Use local {}"
msgstr "使用本地 {}"

msgid "View Log"
msgstr "查看日志"

msgid "Worktree \"{display_name}\" contains modified or untracked files. Force delete it?"
msgstr "工作树“{display_name}”包含已修改或未跟踪的文件。是否强制删除？"

msgid "Worktree creation is not supported in collaborative projects"
msgstr "协作项目不支持创建工作树"

msgid "You may need to configure git for Github."
msgstr "你可能需要为 GitHub 配置 Git。"

msgid "current branches"
msgstr "当前各分支"

msgid "git fetch failed for {}"
msgstr "对 {} 执行 git fetch 失败"

msgid "git {} failed"
msgstr "git {} 失败"
