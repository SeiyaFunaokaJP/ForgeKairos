msgstr "自动化工作树设置"

msgid "Cancel"
msgstr "取消"

msgid "Cannot create a named worktree in a project with multiple repositories"
msgstr "无法在包含多个仓库的项目中创建命名工作树"

msgid "Create"
msgstr "创建"

msgid "Create \"{name}\" based on {branch_label}"
msgstr "基于 {branch_label} 创建“{name}”"

msgid "Create new worktree based on {branch_label}"
msgstr "基于 {branch_label} 创建新工作树"

msgid "Delete"
msgstr "删除"

msgid "Delete Worktree"
msgstr "删除工作树"

msgid "Deleting…"
msgstr "正在删除…"

msgid "Failed to connect"
msgstr "连接失败"

msgid "Force Delete"
msgstr "强制删除"

msgid "Force Delete Worktree"
msgstr "强制删除工作树"

msgid "Hold {} to force delete"
msgstr "按住 {} 可强制删除"

msgid "Learn more"
msgstr "了解详情"

msgid "Open"
msgstr "打开"

