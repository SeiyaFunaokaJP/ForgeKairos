msgstr "编辑"

msgid "Edit Folder"
msgstr "编辑文件夹"

msgid "Enter a URL or search terms"
msgstr "输入 URL 或搜索词"

msgid "Enter a URL."
msgstr "请输入 URL。"

msgid "Enter a name."
msgstr "请输入名称。"

