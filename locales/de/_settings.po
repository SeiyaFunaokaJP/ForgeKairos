msgstr "Nutzungstelemetrie"

msgctxt "settings"
msgid "Tell the connected Claude Code which file is open even when nothing is selected (the \"In <file name>\" in its input). When off, only selected lines are sent."
msgstr "Teilt dem verbundenen Claude Code mit, welche Datei geöffnet ist, auch wenn nichts ausgewählt ist (das „In <Dateiname>“ in seiner Eingabe). Wenn deaktiviert, werden nur ausgewählte Zeilen gesendet."

msgctxt "settings"
msgid "Terminal"
msgstr "Terminal"

msgctxt "settings"
msgid "Terminal Button"
msgstr "Terminal-Schaltfläche"

