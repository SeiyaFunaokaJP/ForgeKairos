msgstr "Vorkommen des ausgewählten Texts in der Scrollleiste anzeigen."

msgctxt "settings"
msgid "Show the AI browser panel button in the status bar while AI agents may use the built-in browser."
msgstr "Zeigt die Schaltfläche des KI-Browser-Panels in der Statusleiste an, solange KI-Agenten den integrierten Browser verwenden dürfen."

msgctxt "settings"
msgid "Show the Git file status on a tab item."
msgstr "Git-Dateistatus auf einem Tab-Element anzeigen."

msgctxt "settings"
msgid "Show the Git panel button in the status bar."
msgstr "Git-Panel-Schaltfläche in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the Git status in the outline panel."
msgstr "Git-Status im Gliederungspanel anzeigen."

msgctxt "settings"
msgid "Show the Git status in the project panel."
msgstr "Git-Status im Projektpanel anzeigen."

msgctxt "settings"
msgid "Show the active language button in the status bar."
msgstr "Schaltfläche für die aktive Sprache in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the active line endings button in the status bar."
msgstr "Zeigt die Schaltfläche für die aktiven Zeilenenden in der Statusleiste an."

msgctxt "settings"
msgid "Show the avatar of the author of the commit."
msgstr "Zeigt den Avatar des Autors des Commits an."

msgctxt "settings"
msgid "Show the branch name button in the titlebar."
msgstr "Schaltfläche mit dem Branch-Namen in der Titelleiste anzeigen."

msgctxt "settings"
msgid "Show the browser panel button in the status bar."
msgstr "Zeigt die Schaltfläche des Browser-Panels in der Statusleiste an."

msgctxt "settings"
msgid "Show the call graph panel button in the status bar."
msgstr "Zeigt die Schaltfläche des Aufrufgraph-Panels in der Statusleiste an."

msgctxt "settings"
msgid "Show the collaboration panel button in the status bar."
msgstr "Schaltfläche für das Kollaborationspanel in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the cursor position button in the status bar."
msgstr "Schaltfläche für die Cursorposition in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the debugger button in the status bar."
msgstr "Debugger-Schaltfläche in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the file icon for a tab."
msgstr "Dateisymbol für einen Tab anzeigen."

msgctxt "settings"
msgid "Show the full-height threads sidebar in the window. When off, the thread history inside the agent panel is used instead."
msgstr "Zeigt die Thread-Seitenleiste in voller Höhe im Fenster an. Wenn deaktiviert, wird stattdessen der Thread-Verlauf im Agent-Panel verwendet."

msgctxt "settings"
msgid "Show the informational hover box when moving the mouse over symbols in the editor."
msgstr "Informations-Hover-Feld anzeigen, wenn die Maus über Symbole im Editor bewegt wird."

msgctxt "settings"
msgid "Show the menus in the titlebar."
msgstr "Menüs in der Titelleiste anzeigen."

msgctxt "settings"
msgid "Show the name of the active file in the status bar."
msgstr "Namen der aktiven Datei in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the navigation history buttons in the tab bar."
msgstr "Schaltflächen für den Navigationsverlauf in der Tab-Leiste anzeigen."

msgctxt "settings"
msgid "Show the outline panel button in the status bar."
msgstr "Schaltfläche für das Gliederungspanel in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the project diagnostics button in the status bar."
msgstr "Schaltfläche für Projektdiagnosen in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the project host and name in the titlebar."
msgstr "Projekt-Host und -Namen in der Titelleiste anzeigen."

msgctxt "settings"
msgid "Show the project panel button in the status bar."
msgstr "Schaltfläche für das Projektpanel in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the project search button in the status bar."
msgstr "Schaltfläche für die Projektsuche in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the scrollbar in the project panel."
msgstr "Scrollleiste im Projektpanel anzeigen."

msgctxt "settings"
msgid "Show the selections menu in the editor toolbar."
msgstr "Auswahlmenü in der Editor-Symbolleiste anzeigen."

msgctxt "settings"
msgid "Show the sign in button in the titlebar."
msgstr "Anmeldeschaltfläche in der Titelleiste anzeigen."

msgctxt "settings"
msgid "Show the signature help pop-up after completions or bracket pairs are inserted."
msgstr "Popup für Signaturhilfe anzeigen, nachdem Vervollständigungen oder Klammerpaare eingefügt wurden."

msgctxt "settings"
msgid "Show the tab bar buttons (New, Split Pane, Zoom)."
msgstr "Schaltflächen der Tab-Leiste anzeigen (Neu, Bereich teilen, Zoom)."

msgctxt "settings"
msgid "Show the tab bar buttons (New, Split Pane, Zoom, and so on) in panes that are not focused as well."
msgstr "Zeigt die Schaltflächen der Tab-Leiste (Neu, Bereich teilen, Zoomen usw.) auch in Bereichen an, die nicht fokussiert sind."

msgctxt "settings"
msgid "Show the tab bar in the editor."
msgstr "Tab-Leiste im Editor anzeigen."

msgctxt "settings"
msgid "Show the terminal button in the status bar."
msgstr "Terminal-Schaltfläche in der Statusleiste anzeigen."

msgctxt "settings"
msgid "Show the thread history to the left of the current thread inside the agent panel. Hidden automatically when the panel is too narrow."
msgstr "Zeigt den Thread-Verlauf links neben dem aktuellen Thread im Agent-Panel an. Wird automatisch ausgeblendet, wenn das Panel zu schmal ist."

msgctxt "settings"
msgid "Show the user menu button in the titlebar."
msgstr "Schaltfläche für das Benutzermenü in der Titelleiste anzeigen."

msgctxt "settings"
msgid "Show the worktree name button in the titlebar."
msgstr "Schaltfläche mit dem Worktree-Namen in der Titelleiste anzeigen."

msgctxt "settings"
msgid "Show user picture in the titlebar."
msgstr "Benutzerbild in der Titelleiste anzeigen."

msgctxt "settings"
msgid "Show voting thumbs up/down icon buttons for feedback on agent edits."
msgstr "Symbolschaltflächen mit Daumen hoch/runter für Feedback zu Agent-Bearbeitungen anzeigen."

msgctxt "settings"
msgid "Show wrap guides (vertical rulers)."
msgstr "Umbruchführungslinien anzeigen (vertikale Lineale)."

msgctxt "settings"
msgid "Show wrap guides in the editor."
msgstr "Umbruchführungslinien im Editor anzeigen."

