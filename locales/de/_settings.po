msgid "Sort Order"
msgstr "Sortierreihenfolge"

msgctxt "settings"
msgid "Sort order for entries in the project panel."
msgstr "Legt die Sortierreihenfolge für Einträge im Projektpanel fest."

msgctxt "settings"
msgid "Space Whitespace Indicator"
msgstr "Leerzeichen-Indikator"

msgctxt "settings"
