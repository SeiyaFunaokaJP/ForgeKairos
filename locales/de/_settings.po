msgid "String substituted for `${separator}` in the window title format. Include any surrounding whitespace in the value."
msgstr "Zeichenfolge, die im Fenstertitelformat für `${separator}` eingesetzt wird. Etwaigen umgebenden Leerraum in den Wert aufnehmen."

msgctxt "settings"
msgid "Strip Control Sequences"
msgstr "Steuersequenzen entfernen"

msgctxt "settings"
msgid "Suggest Extensions"
msgstr "Erweiterungen vorschlagen"

msgctxt "settings"
msgid "Suggest Missing Development Tools"
msgstr "Fehlende Entwicklungstools vorschlagen"

