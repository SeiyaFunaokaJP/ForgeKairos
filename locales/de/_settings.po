msgid "Tab Settings"
msgstr "Tab-Einstellungen"

msgctxt "settings"
msgid "Tab Show Diagnostics"
msgstr "Diagnosen in Tabs anzeigen"

msgctxt "settings"
msgid "Tab Size"
msgstr "Tabulatorgröße"

msgctxt "settings"
msgid "Tab Whitespace Indicator"
msgstr "Leerraumindikator für Tabulatoren"

msgctxt "settings"
msgid "Tasks"
msgstr "Aufgaben"

msgctxt "settings"
msgid "Telemetry Diagnostics"
msgstr "Diagnosetelemetrie"

