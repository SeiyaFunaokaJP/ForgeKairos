# The descriptions of the settings file's JSON schema, keyed by their English text.
#
# Entries that zed-i18n also translates started from its de-DE translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: de\n"
"X-Language-Name: Deutsch\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "settings schema"
msgid "A block that surrounds the following character"
msgstr "Ein Block, der das folgende Zeichen umgibt"

msgctxt "settings schema"
msgid "A box drawn around the following character"
msgstr "Ein Rahmen, der um das folgende Zeichen gezeichnet wird"

msgctxt "settings schema"
msgid "A capability for an extension."
msgstr "Eine Berechtigung für eine Erweiterung."

msgctxt "settings schema"
msgid "A custom Git hosting provider."
msgstr "Ein benutzerdefinierter Git-Hostinganbieter."

msgctxt "settings schema"
msgid "A custom line height, where 1.0 is the font's height. Must be at least 1.0."
msgstr "Eine benutzerdefinierte Zeilenhöhe, bei der 1.0 der Schrifthöhe entspricht. Muss mindestens 1.0 betragen."

msgctxt "settings schema"
msgid "A custom offset in milliseconds for the tooltip show delay."
msgstr "Eine benutzerdefinierte Verzögerung in Millisekunden vor der Anzeige des Tooltips."

msgctxt "settings schema"
msgid "A denser UI with tighter spacing and smaller elements."
msgstr "Eine dichtere Benutzeroberfläche mit engerem Abstand und kleineren Elementen."

msgctxt "settings schema"
msgid "A dynamic icon theme selection, which can change based on the [`ThemeMode`]."
msgstr "Eine dynamische Symboldesign-Auswahl, die sich basierend auf [`ThemeMode`] ändern kann."

msgctxt "settings schema"
msgid "A dynamic theme selection, which can change based the [ThemeMode]."
msgstr "Eine dynamische Designauswahl, die sich basierend auf [ThemeMode] ändern kann."

msgctxt "settings schema"
msgid "A fixed pixel width for the git diff indicators."
msgstr "Eine feste Breite in Pixeln für die Git-Diff-Markierungen."

msgctxt "settings schema"
msgid "A font size value in pixels, wrapping around `f32` for custom settings UI rendering."
msgstr "Ein Schriftgrößenwert in Pixeln, der `f32` für die Darstellung der benutzerdefinierten Einstellungs-UI kapselt."

msgctxt "settings schema"
msgid "A git account a repository can commit and push as."
msgstr "Ein Git-Konto, als das ein Repository committen und pushen kann."

msgctxt "settings schema"
msgid "A less dense line height."
msgstr "Eine weniger dichte Zeilenhöhe."

msgctxt "settings schema"
msgid "A looser UI with more spacing and larger elements."
msgstr "Eine lockerere Benutzeroberfläche mit mehr Abstand und größeren Elementen."

msgctxt "settings schema"
msgid "A map of log scopes to the desired log level.\nUseful for filtering out noisy logs or enabling more verbose logging.\n\nExample: {\"log\": {\"client\": \"warn\"}}"
msgstr "Eine Zuordnung von Protokollbereichen zur gewünschten Protokollebene.\nNützlich, um störende Protokolle herauszufiltern oder ausführlichere Protokollierung zu aktivieren.\n\nBeispiel: {\"log\": {\"client\": \"warn\"}}"

msgctxt "settings schema"
msgid "A model `name` to substitute when calling tools, in case the primary model doesn't support tool calling."
msgstr "Ein Modell-`name`, der beim Aufrufen von Tools substituiert wird, falls das primäre Modell keine Toolaufrufe unterstützt."

msgctxt "settings schema"
msgid "A named settings profile that can temporarily override settings."
msgstr "Ein benanntes Einstellungsprofil, das Einstellungen vorübergehend überschreiben kann."

msgctxt "settings schema"
msgid "A non-negative size in pixels.\n\nValid range: 0.0 and up"
msgstr "Eine nicht negative Größe in Pixeln.\n\nGültiger Bereich: 0.0 und größer"

msgctxt "settings schema"
msgid "A panel the default dock layout can name."
msgstr "Ein Panel, das das Standard-Docklayout benennen kann."

msgctxt "settings schema"
msgid "A static icon theme selection, represented by a single icon theme name."
msgstr "Eine statische Symboldesign-Auswahl, dargestellt durch einen einzelnen Symboldesign-Namen."

msgctxt "settings schema"
msgid "A static theme selection, represented by a single theme name."
msgstr "Eine statische Designauswahl, dargestellt durch einen einzelnen Designnamen."

msgctxt "settings schema"
msgid "A value of `ui_language`, its own type so the settings UI can offer the\nlanguages found at run time instead of a text field."
msgstr "Ein Wert von `ui_language`, als eigener Typ, damit die Einstellungsoberfläche statt eines Textfelds die zur Laufzeit gefundenen Sprachen anbieten kann."

msgctxt "settings schema"
msgid "A vertical bar"
msgstr "Ein senkrechter Strich"

msgctxt "settings schema"
msgid "AI providers whose \"your input may be retained and used for training\"\nwarning the user has explicitly acknowledged. The settings UI refuses to\ntake an API key for, or sign in to, an external provider that is not\nlisted here.\n\nEntries are provider ids. Agent (LLM) providers use their own ids\n(`anthropic`, `openai`, `zed.dev`, ...);\nedit prediction providers are prefixed to keep the two surfaces\nindependent (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nDefault: []"
msgstr "KI-Anbieter, deren Warnung „Ihre Eingabe kann gespeichert und für Training verwendet werden“ der Benutzer ausdrücklich bestätigt hat. Die Einstellungsoberfläche nimmt für einen externen Anbieter, der hier nicht aufgeführt ist, weder einen API-Schlüssel an noch erlaubt sie die Anmeldung.\n\nEinträge sind Anbieter-IDs. Agent-(LLM-)Anbieter verwenden ihre eigenen IDs (`anthropic`, `openai`, `zed.dev`, ...); Anbieter für Bearbeitungsvorhersagen erhalten ein Präfix, damit beide Bereiche unabhängig bleiben (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nStandard: []"

msgctxt "settings schema"
msgid "Activates the python virtual environment, if one is found, in the\nterminal's working directory (as resolved by the working_directory\nsetting). Set this to \"off\" to disable this behavior.\n\nDefault: on"
msgstr "Aktiviert die virtuelle Python-Umgebung, falls eine gefunden wird, im Arbeitsverzeichnis des Terminals (wie über die Einstellung working_directory aufgelöst). Setzen Sie dies auf \"off\", um dieses Verhalten zu deaktivieren.\n\nStandard: on"

msgctxt "settings schema"
msgid "Active pane styling settings."
msgstr "Stileinstellungen für den aktiven Bereich."

msgctxt "settings schema"
msgid "Added version control color."
msgstr "Farbe für hinzugefügte Versionskontrollinhalte."

msgctxt "settings schema"
msgid "Additional environment variables to pass to the agent.\n\nDefault: {}"
msgstr "Zusätzliche Umgebungsvariablen, die an den Agenten übergeben werden.\n\nStandard: {}"

msgctxt "settings schema"
msgid "Additional models with which to generate alternatives when performing inline assists."
msgstr "Zusätzliche Modelle, mit denen Alternativen bei Inline-Assistenz generiert werden."

msgctxt "settings schema"
msgid "Additional parameters for language model requests. When making a request\nto a model, parameters will be taken from the last entry in this list\nthat matches the model's provider and name. In each entry, both provider\nand model are optional, so that you can specify parameters for either\none.\n\nDefault: []"
msgstr "Zusätzliche Parameter für Anfragen an Sprachmodelle. Bei einer Anfrage an ein Modell werden die Parameter aus dem letzten Eintrag dieser Liste übernommen, der zu Anbieter und Namen des Modells passt. In jedem Eintrag sind Anbieter und Modell optional, sodass Sie Parameter für eines von beiden angeben können.\n\nStandard: []"

msgctxt "settings schema"
msgid "Adjusts indentation based on syntax context when typing.\nUses tree-sitter to analyze code structure and indent accordingly."
msgstr "Passt die Einrückung beim Tippen anhand des Syntaxkontexts an.\nVerwendet Tree-sitter, um die Codestruktur zu analysieren und entsprechend einzurücken."

msgctxt "settings schema"
msgid "Aliases for the command palette. When you type a key in this map,\nit will be assumed to equal the value.\n\nDefault: {}"
msgstr "Aliasse für die Befehlspalette. Wenn Sie einen Schlüssel aus dieser Zuordnung eingeben, wird er als gleichbedeutend mit dem Wert behandelt.\n\nStandard: {}"

msgctxt "settings schema"
msgid "Allow Zed to collect training data from open-source projects."
msgstr "Zed erlauben, Trainingsdaten aus Open-Source-Projekten zu sammeln."

msgctxt "settings schema"
msgid "Allow rewrapping anywhere."
msgstr "Neuumbruch an beliebiger Stelle zulassen."

msgctxt "settings schema"
msgid "Allow sending requests to Anthropic models that cannot be offered with\nZero Data Retention.\n\nDefault: false"
msgstr "Erlaubt das Senden von Anfragen an Anthropic-Modelle, die nicht mit Zero Data Retention angeboten werden können.\n\nStandard: false"

msgctxt "settings schema"
msgid "Allows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\nPrettier formatting is disabled by default."
msgstr "Ermöglicht das Aktivieren/Deaktivieren der Formatierung mit Prettier und das Konfigurieren des Standard-Prettier, das verwendet wird, wenn keine Prettier-Installation auf Projektebene gefunden wird.\nDie Formatierung mit Prettier ist standardmäßig deaktiviert."

msgctxt "settings schema"
msgid "Always blink the cursor, ignoring the terminal mode."
msgstr "Cursor immer blinken lassen, unabhängig vom Terminal-Modus."

msgctxt "settings schema"
msgid "Always fetch document's words for completions along with LSP completions."
msgstr "Ruft immer die Wörter des Dokuments für Vervollständigungen zusammen mit LSP-Vervollständigungen ab."

msgctxt "settings schema"
msgid "Always index the worktree."
msgstr "Den Worktree immer indizieren."

msgctxt "settings schema"
msgid "Always populate the search query with the word under the cursor."
msgstr "Füllt die Suchanfrage immer mit dem Wort unter dem Cursor."

msgctxt "settings schema"
msgid "Always prompt for confirmation (default behavior)."
msgstr "Immer eine Bestätigung anfordern (Standardverhalten)."

msgctxt "settings schema"
msgid "Always reduce motion"
msgstr "Bewegung immer reduzieren"

msgctxt "settings schema"
msgid "Always scan symlinked directories"
msgstr "Symbolisch verknüpfte Verzeichnisse immer scannen"

msgctxt "settings schema"
msgid "Always show the minimap thumb."
msgstr "Zeigt den Minimap-Regler immer an."

msgctxt "settings schema"
msgid "Always show the minimap."
msgstr "Minimap immer anzeigen."

msgctxt "settings schema"
msgid "Always show the scrollbar."
msgstr "Zeigt die Scrollleiste immer an."

msgctxt "settings schema"
msgid "Always show the sidebar on the left side."
msgstr "Zeigt die Seitenleiste immer auf der linken Seite an."

msgctxt "settings schema"
msgid "Always show the sidebar on the right side."
msgstr "Zeigt die Seitenleiste immer auf der rechten Seite an."

msgctxt "settings schema"
msgid "Always start with an empty editor tab"
msgstr "Immer mit einem leeren Editor-Tab starten"

msgctxt "settings schema"
msgid "Always use a specific directory. This value will be shell expanded.\nIf this path is not a valid directory the terminal will default to\nthis platform's home directory  (if it can be found)."
msgstr "Immer ein bestimmtes Verzeichnis verwenden. Dieser Wert wird von der Shell erweitert.\nIst dieser Pfad kein gültiges Verzeichnis, verwendet das Terminal das Home-Verzeichnis dieser Plattform (sofern es gefunden wird)."

msgctxt "settings schema"
msgid "Always use this platform's home directory (if it can be found)."
msgstr "Verwendet immer das Home-Verzeichnis dieser Plattform (sofern es gefunden werden kann)."

msgctxt "settings schema"
msgid "Amount of indentation (in pixels) for nested items.\n\nDefault: 20"
msgstr "Einrückung (in Pixeln) für verschachtelte Elemente.\n\nStandard: 20"

msgctxt "settings schema"
msgid "An optional string to override the title of the terminal tab"
msgstr "Eine optionale Zeichenkette zum Überschreiben des Titels des Terminal-Tabs"

msgctxt "settings schema"
msgid "An underline that runs along the following character"
msgstr "Eine Unterstreichung entlang des folgenden Zeichens"

msgctxt "settings schema"
msgid "Any extra beta headers to provide when using the model."
msgstr "Zusätzliche Beta-Header, die bei der Verwendung des Modells bereitgestellt werden."

msgctxt "settings schema"
msgid "Any key-value pairs added to this list will be added to the terminal's\nenvironment. Use `:` to separate multiple values.\n\nDefault: {}"
msgstr "Alle Schlüssel-Wert-Paare in dieser Liste werden der Umgebung des Terminals hinzugefügt. Verwenden Sie `:`, um mehrere Werte zu trennen.\n\nStandard: {}"

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"\""
msgstr "API-URL für Vervollständigungen.\n\nStandard: \"\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"http://localhost:11434\""
msgstr "API-URL für Vervollständigungen.\n\nStandard: \"http://localhost:11434\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"https://codestral.mistral.ai\""
msgstr "API-URL für Vervollständigungen.\n\nStandard: \"https://codestral.mistral.ai\""

msgctxt "settings schema"
msgid "Apply profile settings on top of Zed's default settings, ignoring user customizations."
msgstr "Wendet Profileinstellungen auf die Standardeinstellungen von ForgeKairos an und ignoriert dabei Benutzeranpassungen."

msgctxt "settings schema"
msgid "Apply profile settings on top of the user's current settings."
msgstr "Wendet Profileinstellungen auf die aktuellen Benutzereinstellungen an."

msgctxt "settings schema"
msgid "Ask a separate, cheap language model whether the operation is dangerous,\nand auto-approve it only when that model answers that it is safe.\nEvery rule that outranks the default — the built-in security\nrules and the user's `always_deny`/`always_confirm`/`always_allow`\npatterns — is applied first, so this only replaces the \"ask every time\"\nstep."
msgstr "Fragt ein separates, günstiges Sprachmodell, ob der Vorgang gefährlich ist, und genehmigt ihn nur dann automatisch, wenn dieses Modell antwortet, dass er sicher ist.\nJede Regel, die Vorrang vor dem Standard hat — die integrierten Sicherheitsregeln und die Muster `always_deny`/`always_confirm`/`always_allow` des Benutzers — wird zuerst angewendet, sodass dies nur den Schritt „jedes Mal fragen“ ersetzt."

msgctxt "settings schema"
msgid "Auto-approve without prompting."
msgstr "Automatisch genehmigen, ohne Rückfrage."

msgctxt "settings schema"
msgid "Auto-reject with an error."
msgstr "Automatisch ablehnen mit einem Fehler."

msgctxt "settings schema"
msgid "Automatically detect the conda manager"
msgstr "Conda-Manager automatisch erkennen"

msgctxt "settings schema"
msgid "Autosave when focus changes."
msgstr "Automatisch speichern, wenn sich der Fokus ändert."

msgctxt "settings schema"
msgid "Autosave when the active window changes."
msgstr "Automatisch speichern, wenn sich das aktive Fenster ändert."

msgctxt "settings schema"
msgid "Background Color. Used for grounded surfaces like a panel or tab."
msgstr "Hintergrundfarbe. Wird für nicht erhöhte Oberflächen wie ein Panel oder einen Tab verwendet."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of a ghost element that should have the same background as the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Hintergrundfarbe. Wird für den aktiven Zustand eines Ghost-Elements verwendet, das denselben Hintergrund wie die Fläche haben soll, auf der es liegt.\n\nAktive Zustände werden ausgelöst, wenn die Maustaste auf einem Element gedrückt wird oder die Return-Taste bzw. ein anderer Auslöser betätigt wird."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of an element that should have a different background than the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Hintergrundfarbe. Wird für den aktiven Zustand eines Elements verwendet, das einen anderen Hintergrund als die Fläche haben soll, auf der es liegt.\n\nAktive Zustände werden ausgelöst, wenn die Maustaste auf einem Element gedrückt wird oder die Return-Taste bzw. ein anderer Auslöser betätigt wird."

msgctxt "settings schema"
msgid "Background Color. Used for the app background and blank panels or windows."
msgstr "Hintergrundfarbe. Wird für den App-Hintergrund und leere Panels oder Fenster verwendet."

msgctxt "settings schema"
msgid "Background Color. Used for the area that shows where a dragged element will be dropped."
msgstr "Hintergrundfarbe. Wird für den Bereich verwendet, der anzeigt, wo ein gezogenes Element abgelegt wird."

msgctxt "settings schema"
msgid "Background Color. Used for the background of an element that should have a different background than the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have the same background as the surface it's on, use `ghost_element_background`."
msgstr "Hintergrundfarbe. Wird für den Hintergrund eines Elements verwendet, das einen anderen Hintergrund als die Fläche haben soll, auf der es liegt.\n\nElemente können sein: Schaltflächen, Eingabefelder, Kontrollkästchen, Optionsfelder...\n\nFür ein Element, das denselben Hintergrund wie die Fläche haben soll, auf der es liegt, verwenden Sie `ghost_element_background`."

msgctxt "settings schema"
msgid "Background Color. Used for the background of selections in a UI element."
msgstr "Hintergrundfarbe. Wird für den Hintergrund von Auswahlen in einem UI-Element verwendet."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of a ghost element that should have the same background as the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Hintergrundfarbe. Wird für den deaktivierten Zustand eines Ghost-Elements verwendet, das denselben Hintergrund wie die Fläche haben soll, auf der es liegt.\n\nDeaktivierte Zustände werden angezeigt, wenn ein Benutzer nicht mit einem Element interagieren kann, etwa bei einer deaktivierten Schaltfläche oder einem deaktivierten Eingabefeld."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of an element that should have a different background than the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Hintergrundfarbe. Wird für den deaktivierten Zustand eines Elements verwendet, das einen anderen Hintergrund als die Fläche haben soll, auf der es liegt.\n\nDeaktivierte Zustände werden angezeigt, wenn ein Benutzer nicht mit einem Element interagieren kann, etwa bei einer deaktivierten Schaltfläche oder einem deaktivierten Eingabefeld."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of a ghost element that should have the same background as the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Hintergrundfarbe. Wird für den Hover-Zustand eines Ghost-Elements verwendet, das denselben Hintergrund wie die Fläche haben soll, auf der es liegt.\n\nHover-Zustände werden ausgelöst, wenn die Maus ein Element erreicht oder ein Finger ein Element auf einem Touchscreen berührt."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of an element that should have a different background than the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Hintergrundfarbe. Wird für den Hover-Zustand eines Elements verwendet, das einen anderen Hintergrund als die Fläche haben soll, auf der es liegt.\n\nHover-Zustände werden ausgelöst, wenn die Maus ein Element erreicht oder ein Finger ein Element auf einem Touchscreen berührt."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of a ghost element that should have the same background as the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Hintergrundfarbe. Wird für den ausgewählten Zustand eines Ghost-Elements verwendet, das denselben Hintergrund wie die Fläche haben soll, auf der es liegt.\n\nAusgewählte Zustände werden ausgelöst, wenn das Element vom Benutzer ausgewählt (oder „aktiviert“) wird.\n\nDazu gehören etwa ein aktiviertes Kontrollkästchen, eine eingeschaltete Umschaltfläche usw."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of an element that should have a different background than the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Hintergrundfarbe. Wird für den ausgewählten Zustand eines Elements verwendet, das einen anderen Hintergrund als die Fläche haben soll, auf der es liegt.\n\nAusgewählte Zustände werden ausgelöst, wenn das Element vom Benutzer ausgewählt (oder „aktiviert“) wird.\n\nDazu gehören etwa ein aktiviertes Kontrollkästchen, eine eingeschaltete Umschaltfläche usw."

msgctxt "settings schema"
msgid "Background color for Vim Helix Normal mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den Vim-Helix-Normalmodus."

msgctxt "settings schema"
msgid "Background color for Vim Helix Select mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den Vim-Helix-Auswahlmodus."

msgctxt "settings schema"
msgid "Background color for Vim Insert mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den Vim-Einfügemodus."

msgctxt "settings schema"
msgid "Background color for Vim Normal mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den Vim-Normalmodus."

msgctxt "settings schema"
msgid "Background color for Vim Replace mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den Vim-Ersetzungsmodus."

msgctxt "settings schema"
msgid "Background color for Vim Visual Block mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den visuellen Vim-Blockmodus."

msgctxt "settings schema"
msgid "Background color for Vim Visual Line mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den visuellen Vim-Zeilenmodus."

msgctxt "settings schema"
msgid "Background color for Vim Visual mode indicator."
msgstr "Hintergrundfarbe der Modusanzeige für den visuellen Vim-Modus."

msgctxt "settings schema"
msgid "Background color for Vim yank highlight."
msgstr "Hintergrundfarbe für die Vim-Yank-Hervorhebung."

msgctxt "settings schema"
msgid "Background color for row highlights of \"ours\" regions in merge conflicts."
msgstr "Hintergrundfarbe für Zeilenhervorhebungen der \"ours\"-Bereiche bei Merge-Konflikten."

msgctxt "settings schema"
msgid "Background color for row highlights of \"theirs\" regions in merge conflicts."
msgstr "Hintergrundfarbe für Zeilenhervorhebungen der \"theirs\"-Bereiche bei Merge-Konflikten."

msgctxt "settings schema"
msgid "Background color. Used for elevated surfaces, like a context menu, popup, or dialog."
msgstr "Hintergrundfarbe. Wird für erhöhte Oberflächen wie ein Kontextmenü, Popup oder einen Dialog verwendet."

msgctxt "settings schema"
msgid "Background of active line of debugger"
msgstr "Hintergrund der aktiven Debugger-Zeile"

msgctxt "settings schema"
msgid "Base key bindings scheme. Base keymaps can be overridden with user keymaps.\n\nDefault: Zed"
msgstr "Schema der Basis-Tastenkombinationen. Basis-Keymaps können mit Benutzer-Keymaps überschrieben werden.\n\nStandard: Zed"

msgctxt "settings schema"
msgid "Be smart and search for ignored when called from a gitignored worktree"
msgstr "Intelligent suchen und ignorierte Dateien einbeziehen, wenn der Aufruf aus einem gitignorierten Worktree erfolgt"

msgctxt "settings schema"
msgid "Behave as a regular buffer and select the whole word."
msgstr "Verhält sich wie ein normaler Puffer und wählt das gesamte Wort aus."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text after the cursor is a suffix of the completion, and like\n`\"insert\"` otherwise."
msgstr "Verhält sich wie `\"replace\"`, wenn der Text nach dem Cursor ein Suffix der Vervollständigung ist, und sonst wie `\"insert\"`."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text that would be replaced is a subsequence of the completion text,\nand like `\"insert\"` otherwise."
msgstr "Verhält sich wie `\"replace\"`, wenn der zu ersetzende Text eine Teilfolge des Vervollständigungstexts ist, und sonst wie `\"insert\"`."

msgctxt "settings schema"
msgid "Black ANSI terminal color."
msgstr "Schwarze ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Block cursor that surrounds the character."
msgstr "Block-Cursor, der das Zeichen umgibt."

msgctxt "settings schema"
msgid "Blue ANSI terminal color."
msgstr "Blaue ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Border Color. Used for the border that shows where a dragged element will be dropped."
msgstr "Rahmenfarbe. Wird für den Rahmen verwendet, der anzeigt, wo ein gezogenes Element abgelegt wird."

msgctxt "settings schema"
msgid "Border color. Used for deemphasized borders, like a visual divider between two sections"
msgstr "Rahmenfarbe. Wird für dezente Rahmen verwendet, z. B. als visuelle Trennlinie zwischen zwei Abschnitten."

msgctxt "settings schema"
msgid "Border color. Used for disabled elements, like a disabled input or button."
msgstr "Rahmenfarbe. Wird für deaktivierte Elemente verwendet, z. B. ein deaktiviertes Eingabefeld oder eine deaktivierte Schaltfläche."

msgctxt "settings schema"
msgid "Border color. Used for focused elements, like keyboard focused list item."
msgstr "Rahmenfarbe. Wird für fokussierte Elemente verwendet, z. B. ein per Tastatur fokussiertes Listenelement."

msgctxt "settings schema"
msgid "Border color. Used for most borders, is usually a high contrast color."
msgstr "Rahmenfarbe. Wird für die meisten Rahmen verwendet und ist üblicherweise eine kontraststarke Farbe."

msgctxt "settings schema"
msgid "Border color. Used for selected elements, like an active search filter or selected checkbox."
msgstr "Rahmenfarbe. Wird für ausgewählte Elemente verwendet, z. B. einen aktiven Suchfilter oder ein ausgewähltes Kontrollkästchen."

msgctxt "settings schema"
msgid "Border color. Used for transparent borders. Used for placeholder borders when an element gains a border on state change."
msgstr "Rahmenfarbe. Wird für transparente Rahmen verwendet. Dient als Platzhalterrahmen, wenn ein Element bei einer Zustandsänderung einen Rahmen erhält."

msgctxt "settings schema"
msgid "Bright black ANSI terminal color."
msgstr "Helles Schwarz als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Bright blue ANSI terminal color."
msgstr "Helles Blau als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Bright cyan ANSI terminal color."
msgstr "Helles Cyan als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Bright green ANSI terminal color."
msgstr "Helles Grün als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Bright magenta ANSI terminal color."
msgstr "Helles Magenta als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Bright red ANSI terminal color."
msgstr "Helles Rot als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Bright terminal foreground color."
msgstr "Helle Terminalvordergrundfarbe."

msgctxt "settings schema"
msgid "Bright white ANSI terminal color."
msgstr "Helles Weiß als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Bright yellow ANSI terminal color."
msgstr "Helles Gelb als ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Byte budget for a repository map prepended to the agent's system prompt,\nright after the list of project root directories. `0` disables it.\nValues above 32768 are clamped to 32768.\n\nDefault: 0"
msgstr "Byte-Budget für eine Repository-Übersicht, die dem System-Prompt des Agenten direkt nach der Liste der Projektstammverzeichnisse vorangestellt wird. `0` deaktiviert sie.\nWerte über 32768 werden auf 32768 begrenzt.\n\nStandard: 0"

msgctxt "settings schema"
msgid "Callees left out of the list of a function's callees, such as logging\nand assertion macros. A row at the end counts them and shows them on\nrequest.\n\nDefault: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"
msgstr "Aufgerufene, die aus der Liste der Aufgerufenen einer Funktion ausgelassen werden, etwa Protokollierungs- und Assertion-Makros. Eine Zeile am Ende zählt sie und zeigt sie auf Anforderung an.\n\nStandard: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"

msgctxt "settings schema"
msgid "Case-insensitive natural sort with lowercase preferred in ties.\nNumbers in file names are compared by value (e.g., `file2` before `file10`)."
msgstr "Natürliche Sortierung ohne Beachtung der Groß-/Kleinschreibung, bei Gleichstand haben Kleinbuchstaben Vorrang.\nZahlen in Dateinamen werden nach ihrem Wert verglichen (z. B. `file2` vor `file10`)."

msgctxt "settings schema"
msgid "Centered layout related setting (left/right)."
msgstr "Einstellung für das zentrierte Layout (links/rechts)."

msgctxt "settings schema"
msgid "Centered layout related settings."
msgstr "Einstellungen für das zentrierte Layout."

msgctxt "settings schema"
msgid "Character counts at which to show wrap guides in the editor.\n\nDefault: []"
msgstr "Zeichenanzahlen, bei denen im Editor Umbruchführungslinien angezeigt werden.\n\nStandard: []"

msgctxt "settings schema"
msgid "Close the window when there are no tabs"
msgstr "Fenster schließen, wenn keine Tabs vorhanden sind"

msgctxt "settings schema"
msgid "Color for added words in word diffs."
msgstr "Farbe für hinzugefügte Wörter in Wort-Diffs."

msgctxt "settings schema"
msgid "Color for deleted words in word diffs."
msgstr "Farbe für gelöschte Wörter in Wort-Diffs."

msgctxt "settings schema"
msgid "Color used to accent some of the debuggers elements\nOnly accent breakpoint & breakpoint related symbols right now"
msgstr "Farbe zum Hervorheben einiger Elemente des Debuggers.\nHebt derzeit nur Haltepunkte und haltepunktbezogene Symbole hervor."

msgctxt "settings schema"
msgid "Comfortable spacing of entries."
msgstr "Komfortabler Abstand zwischen Einträgen."

msgctxt "settings schema"
msgid "Command to automatically run when Zed creates a Terminal Thread shell in the agent panel.\nThe command is sent to the shell as if typed, so it is interpreted by your\nconfigured shell (including on Windows and remote/WSL projects).\nAn empty string disables this behavior.\n\nDefault: \"\""
msgstr "Befehl, der automatisch ausgeführt wird, wenn ForgeKairos im Agent-Panel eine Shell für einen Terminal-Thread erstellt.\nDer Befehl wird an die Shell gesendet, als wäre er eingetippt worden, und daher von Ihrer konfigurierten Shell interpretiert (auch unter Windows und in Remote-/WSL-Projekten).\nEine leere Zeichenfolge deaktiviert dieses Verhalten.\n\nStandard: \"\""

msgctxt "settings schema"
msgid "Common language server settings."
msgstr "Allgemeine Sprachserver-Einstellungen."

msgctxt "settings schema"
msgid "Configuration for Debugger-related features"
msgstr "Konfiguration für Debugger-bezogene Funktionen"

msgctxt "settings schema"
msgid "Configuration for Diagnostics-related features."
msgstr "Konfiguration für Diagnose-bezogene Funktionen."

msgctxt "settings schema"
msgid "Configuration for Git-related features"
msgstr "Konfiguration für Git-bezogene Funktionen"

msgctxt "settings schema"
msgid "Configuration for Node-related features"
msgstr "Konfiguration für Node-bezogene Funktionen"

msgctxt "settings schema"
msgid "Configuration for caching language model messages."
msgstr "Konfiguration für das Zwischenspeichern von Sprachmodell-Nachrichten."

msgctxt "settings schema"
msgid "Configuration for developer-oriented instrumentation tools that collect\ndiagnostic data about a running Zed instance."
msgstr "Konfiguration für entwicklerorientierte Instrumentierungstools, die Diagnosedaten über eine laufende ForgeKairos-Instanz sammeln."

msgctxt "settings schema"
msgid "Configuration for how direnv configuration should be loaded"
msgstr "Konfiguration, wie die direnv-Konfiguration geladen werden soll"

msgctxt "settings schema"
msgid "Configuration for language servers.\n\nThe following settings can be overridden for specific language servers:\n- initialization_options\n\nTo override settings for a language, add an entry for that language server's\nname to the lsp value.\nDefault: null"
msgstr "Konfiguration für Sprachserver.\n\nDie folgenden Einstellungen können für bestimmte Sprachserver überschrieben werden:\n- initialization_options\n\nUm Einstellungen für eine Sprache zu überschreiben, fügen Sie dem Wert lsp einen Eintrag mit dem Namen dieses Sprachservers hinzu.\nStandard: null"

msgctxt "settings schema"
msgid "Configuration for session-related features"
msgstr "Konfiguration für sitzungsbezogene Funktionen"

msgctxt "settings schema"
msgid "Configuration for the collab panel visual settings."
msgstr "Konfiguration der visuellen Einstellungen des Kollaborationspanels."

msgctxt "settings schema"
msgid "Configuration for the performance profiler which collects timing data\nfor foreground and background executor tasks."
msgstr "Konfiguration für den Performance-Profiler, der Zeitdaten für Executor-Aufgaben im Vorder- und Hintergrund sammelt."

msgctxt "settings schema"
msgid "Configuration for the performance profiler, accessed via the\n`zed: open performance profiler` action."
msgstr "Konfiguration für den Performance-Profiler, erreichbar über die Aktion\n`zed: open performance profiler`."

msgctxt "settings schema"
msgid "Configuration of Anthropic's caching API."
msgstr "Konfiguration der Caching-API von Anthropic."

msgctxt "settings schema"
msgid "Configuration of audio in Zed."
msgstr "Konfiguration von Audio in ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of the terminal in Zed."
msgstr "Konfiguration des Terminals in ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of voice calls in Zed."
msgstr "Konfiguration von Sprachanrufen in ForgeKairos."

msgctxt "settings schema"
msgid "Configures what draws Zed's window decorations on Linux.\nThis setting has no effect on other platforms."
msgstr "Legt fest, wer unter Linux die Fensterdekorationen von ForgeKairos zeichnet.\nDiese Einstellung hat auf anderen Plattformen keine Wirkung."

msgctxt "settings schema"
msgid "Conflict version control color."
msgstr "Farbe für Versionskontroll-Konflikte."

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `Authorization` header is sent and the\nprovider counts as configured without a keychain entry.\n\nDefault: false"
msgstr "Verbindet ohne Anmeldedaten, für Server, die keine Authentifizierung erfordern. Wenn gesetzt, wird kein `Authorization`-Header gesendet, und der Anbieter gilt auch ohne Schlüsselbundeintrag als konfiguriert.\n\nStandard: false"

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `x-api-key` header is sent and the provider\ncounts as configured without a keychain entry.\n\nDefault: false"
msgstr "Verbindet ohne Anmeldedaten, für Server, die keine Authentifizierung erfordern. Wenn gesetzt, wird kein `x-api-key`-Header gesendet, und der Anbieter gilt auch ohne Schlüsselbundeintrag als konfiguriert.\n\nStandard: false"

msgctxt "settings schema"
msgid "Contained between the left and right docks"
msgstr "Zwischen dem linken und rechten Dock eingeschlossen"

msgctxt "settings schema"
msgid "Continuation lines get 1 extra indent level beyond the original."
msgstr "Fortsetzungszeilen werden um eine Einzugsebene tiefer als die Originalzeile eingerückt."

msgctxt "settings schema"
msgid "Continuation lines get 2 extra indent levels beyond the original."
msgstr "Fortsetzungszeilen werden um zwei Einzugsebenen tiefer als die Originalzeile eingerückt."

msgctxt "settings schema"
msgid "Continuation lines match the original line's indentation."
msgstr "Fortsetzungszeilen übernehmen die Einrückung der Originalzeile."

msgctxt "settings schema"
msgid "Continuation lines start at column 0."
msgstr "Fortsetzungszeilen beginnen in Spalte 0."

msgctxt "settings schema"
msgid "Control what info is collected by Zed."
msgstr "Steuert, welche Informationen Zed erfasst."

msgctxt "settings schema"
msgid "Controls automatic indentation behavior when typing.\n\n- \"syntax_aware\": Adjusts indentation based on syntax context (default)\n- \"preserve_indent\": Preserves current line's indentation on new lines\n- \"none\": No automatic indentation\n\nDefault: syntax_aware"
msgstr "Steuert das automatische Einrücken beim Tippen.\n\n- \"syntax_aware\": Passt die Einrückung anhand des Syntaxkontexts an (Standard)\n- \"preserve_indent\": Behält die Einrückung der aktuellen Zeile in neuen Zeilen bei\n- \"none\": Keine automatische Einrückung\n\nStandard: syntax_aware"

msgctxt "settings schema"
msgid "Controls how LSP completions are inserted.\n\nDefault: \"replace_suffix\""
msgstr "Steuert, wie LSP-Vervollständigungen eingefügt werden.\n\nStandard: \"replace_suffix\""

msgctxt "settings schema"
msgid "Controls how completions are processed for this language."
msgstr "Steuert, wie Vervollständigungen für diese Sprache verarbeitet werden."

msgctxt "settings schema"
msgid "Controls how document's words are completed."
msgstr "Steuert, wie Wörter im Dokument vervollständigt werden."

msgctxt "settings schema"
msgid "Controls how line endings are normalized when a buffer is saved."
msgstr "Steuert, wie Zeilenenden beim Speichern eines Puffers normalisiert werden."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting."
msgstr "Steuert, wie semantische Token von Sprachservern für die Syntaxhervorhebung verwendet werden."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting.\n\nOptions:\n- \"off\": Do not request semantic tokens from language servers.\n- \"combined\": Use LSP semantic tokens together with tree-sitter highlighting.\n- \"full\": Use LSP semantic tokens exclusively, replacing tree-sitter highlighting.\n\nDefault: \"off\""
msgstr "Steuert, wie semantische Token von Sprachservern für die Syntaxhervorhebung verwendet werden.\n\nOptionen:\n- \"off\": Keine semantischen Token von Sprachservern anfordern.\n- \"combined\": LSP-Semantiktoken zusammen mit der Tree-sitter-Hervorhebung verwenden.\n- \"full\": Ausschließlich LSP-Semantiktoken verwenden, die die Tree-sitter-Hervorhebung ersetzen.\n\nStandard: \"off\""

msgctxt "settings schema"
msgid "Controls how the editor handles the autoclosed characters.\nWhen set to `false`(default), skipping over and auto-removing of the closing characters\nhappen only for auto-inserted characters.\nOtherwise(when `true`), the closing characters are always skipped over and auto-removed\nno matter how they were inserted.\n\nDefault: false"
msgstr "Steuert, wie der Editor automatisch geschlossene Zeichen behandelt.\nBei `false` (Standard) werden schließende Zeichen nur dann übersprungen und automatisch entfernt, wenn sie automatisch eingefügt wurden.\nAndernfalls (bei `true`) werden schließende Zeichen immer übersprungen und automatisch entfernt, unabhängig davon, wie sie eingefügt wurden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Controls how whitespace should be displayedin the editor."
msgstr "Steuert, wie Leerraum im Editor angezeigt wird."

msgctxt "settings schema"
msgid "Controls how words are completed.\nFor large documents, not all words may be fetched for completion.\n\nDefault: `fallback`"
msgstr "Steuert, wie Wörter vervollständigt werden.\nBei großen Dokumenten werden möglicherweise nicht alle Wörter für die Vervollständigung abgerufen.\n\nStandard: `fallback`"

msgctxt "settings schema"
msgid "Controls previous session restoration in freshly launched Zed instance.\nValues: empty_tab, last_workspace, last_session, launchpad\nDefault: last_session"
msgstr "Steuert die Wiederherstellung der vorherigen Sitzung in einer neu gestarteten ForgeKairos-Instanz.\nWerte: empty_tab, last_workspace, last_session, launchpad\nStandard: last_session"

msgctxt "settings schema"
msgid "Controls the soft-wrapping behavior in the editor."
msgstr "Steuert das Verhalten des weichen Zeilenumbruchs im Editor."

msgctxt "settings schema"
msgid "Controls the source of document symbols used for outlines and breadcrumbs.\n\nOptions:\n- \"off\": Use tree-sitter queries to compute document symbols (default).\n- \"on\": Use the language server's `textDocument/documentSymbol` LSP response. When enabled, tree-sitter is not used for document symbols.\n\nDefault: \"off\""
msgstr "Steuert die Quelle der Dokumentsymbole für Gliederungen und Breadcrumbs.\n\nOptionen:\n- \"off\": Tree-sitter-Abfragen zur Berechnung der Dokumentsymbole verwenden (Standard).\n- \"on\": Die LSP-Antwort `textDocument/documentSymbol` des Sprachservers verwenden. Wenn aktiviert, wird Tree-sitter nicht für Dokumentsymbole verwendet.\n\nStandard: \"off\""

msgctxt "settings schema"
msgid "Controls the width of the git diff hunk indicators in the gutter."
msgstr "Steuert die Breite der Markierungen für Git-Diff-Hunks in der Randleiste."

msgctxt "settings schema"
msgid "Controls when to use system clipboard."
msgstr "Steuert, wann die Systemzwischenablage verwendet wird."

msgctxt "settings schema"
msgid "Controls where the `editor::Rewrap` action is allowed for this language.\n\nNote: This setting has no effect in Vim mode, as rewrap is already\nallowed everywhere.\n\nDefault: \"in_comments\""
msgstr "Steuert, wo die Aktion `editor::Rewrap` für diese Sprache erlaubt ist.\n\nHinweis: Diese Einstellung hat im Vim-Modus keine Wirkung, da das Neuumbrechen dort bereits überall erlaubt ist.\n\nStandard: \"in_comments\""

msgctxt "settings schema"
msgid "Controls whether Zed collects training data when using Zed's Edit Predictions."
msgstr "Steuert, ob Zed bei der Verwendung der Bearbeitungsvorhersagen von Zed Trainingsdaten erfasst."

msgctxt "settings schema"
msgid "Controls whether Zed may collect training data when using Zed's Edit Predictions.\nData is only ever captured for files in projects that are detected as open source.\n\n- `\"default\"`: use the preference previously set via the status-bar toggle,\n  or false if no preference has been stored.\n- `\"yes\"`: allow data collection for files in open-source projects.\n- `\"no\"`: never allow data collection."
msgstr "Legt fest, ob Zed bei Verwendung der Bearbeitungsvorhersagen von Zed Trainingsdaten sammeln darf.\nDaten werden nur für Dateien in Projekten erfasst, die als Open Source erkannt werden.\n\n- `\"default\"`: Die zuvor über den Schalter in der Statusleiste gesetzte Einstellung verwenden,\n  oder false, wenn keine Einstellung gespeichert ist.\n- `\"yes\"`: Datenerfassung für Dateien in Open-Source-Projekten erlauben.\n- `\"no\"`: Datenerfassung nie erlauben."

msgctxt "settings schema"
msgid "Controls whether Zed or the window manager or compositor draws window decorations on Linux.\n\nDefault: client"
msgstr "Steuert, ob ForgeKairos oder der Fenstermanager bzw. Compositor unter Linux die Fensterdekorationen zeichnet.\n\nStandard: client"

msgctxt "settings schema"
msgid "Controls whether edit predictions are shown immediately (true)\nor manually by triggering `editor::ShowEditPrediction` (false).\n\nDefault: true"
msgstr "Steuert, ob Bearbeitungsvorhersagen sofort angezeigt werden (true) oder manuell durch Auslösen von `editor::ShowEditPrediction` (false).\n\nStandard: true"

msgctxt "settings schema"
msgid "Controls whether folding ranges from language servers are used instead of\ntree-sitter and indent-based folding.\n\nOptions:\n- \"off\": Use tree-sitter and indent-based folding (default).\n- \"on\": Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server.\n\nDefault: \"off\""
msgstr "Steuert, ob Faltbereiche von Sprachservern anstelle der Tree-sitter- und einrückungsbasierten Faltung verwendet werden.\n\nOptionen:\n- \"off\": Tree-sitter- und einrückungsbasierte Faltung verwenden (Standard).\n- \"on\": Wo möglich LSP-Faltung verwenden und auf Tree-sitter- und einrückungsbasierte Faltung zurückgreifen, wenn der Server keine Ergebnisse geliefert hat.\n\nStandard: \"off\""

msgctxt "settings schema"
msgid "Controls which formatter should be used when formatting code. If there are multiple formatters, they are executed in the order of declaration."
msgstr "Steuert, welcher Formatierer beim Formatieren von Code verwendet werden soll. Bei mehreren Formatierern werden diese in der Reihenfolge ihrer Deklaration ausgeführt."

msgctxt "settings schema"
msgid "Controls which formatters should be used when formatting code."
msgstr "Steuert, welche Formatierer beim Formatieren von Code verwendet werden sollen."

msgctxt "settings schema"
msgid "Cursor is a block like `█`."
msgstr "Cursor ist ein Block wie `█`."

msgctxt "settings schema"
msgid "Cursor is a hollow box like `▯`."
msgstr "Cursor ist ein hohles Rechteck wie `▯`."

msgctxt "settings schema"
msgid "Cursor is a vertical bar like `⎸`."
msgstr "Cursor ist ein senkrechter Strich wie `⎸`."

msgctxt "settings schema"
msgid "Cursor is an underscore like `_`."
msgstr "Cursor ist ein Unterstrich wie `_`."

msgctxt "settings schema"
msgid "Cursor movement animation settings."
msgstr "Einstellungen für die Cursor-Bewegungsanimation."

msgctxt "settings schema"
msgid "Cursor shape configuration for insert mode in Vim."
msgstr "Cursorform-Konfiguration für den Einfügemodus in Vim."

msgctxt "settings schema"
msgid "Cursor shape for the default editor.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: bar"
msgstr "Cursorform für den Standardeditor.\nKann \"bar\", \"block\", \"underline\" oder \"hollow\" sein.\n\nStandard: bar"

msgctxt "settings schema"
msgid "Cursor shape for the insert mode.\n\nThe default value follows the primary cursor_shape."
msgstr "Cursorform für den Einfügemodus.\n\nDer Standardwert folgt der primären cursor_shape."

msgctxt "settings schema"
msgid "Cursor shape for the normal mode.\n\nDefault: block"
msgstr "Cursorform für den Normalmodus.\n\nStandard: block"

msgctxt "settings schema"
msgid "Cursor shape for the replace mode.\n\nDefault: underline"
msgstr "Cursorform für den Ersetzungsmodus.\n\nStandard: underline"

msgctxt "settings schema"
msgid "Cursor shape for the visual mode.\n\nDefault: block"
msgstr "Cursorform für den visuellen Modus.\n\nStandard: block"

msgctxt "settings schema"
msgid "Custom Model API URL to use for this model."
msgstr "Benutzerdefinierte Modell-API-URL für dieses Modell."

msgctxt "settings schema"
msgid "Custom instructions to include in the prompt when generating git commit messages.\nApplied in addition to any project rules files (such as `.rules` or `AGENTS.md`)."
msgstr "Benutzerdefinierte Anweisungen, die beim Generieren von Git-Commit-Nachrichten in den Prompt aufgenommen werden.\nWerden zusätzlich zu Projektregeldateien (etwa `.rules` oder `AGENTS.md`) angewendet."

msgctxt "settings schema"
msgid "Custom models served through the `bedrock-mantle` endpoint's\nOpenAI-compatible APIs, in addition to the built-in Mantle models\n(GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."
msgstr "Benutzerdefinierte Modelle, die über die OpenAI-kompatiblen APIs des Endpunkts `bedrock-mantle` bereitgestellt werden, zusätzlich zu den integrierten Mantle-Modellen\n(GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."

msgctxt "settings schema"
msgid "Custom rules for rendering LSP semantic tokens."
msgstr "Benutzerdefinierte Regeln für das Rendern semantischer LSP-Token."

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by outline panel\n\nDefault: 240"
msgstr "Passt die Standardbreite (in Pixeln) des Gliederungspanels an.\n\nStandard: 240"

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by project panel\n\nDefault: 240"
msgstr "Passt die Standardbreite (in Pixeln) des Projektpanels an.\n\nStandard: 240"

msgctxt "settings schema"
msgid "Cyan ANSI terminal color."
msgstr "Cyan-ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Default action when clicking a changed file in the Git panel.\n\nDefault: project_diff"
msgstr "Standardaktion beim Klicken auf eine geänderte Datei im Git-Panel.\n\nStandard: project_diff"

msgctxt "settings schema"
msgid "Default cursor shape for the terminal.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: \"block\""
msgstr "Standard-Cursorform für das Terminal.\nKann \"bar\", \"block\", \"underline\" oder \"hollow\" sein.\n\nStandard: \"block\""

msgctxt "settings schema"
msgid "Default depth to expand outline items in the current file.\nThe default depth to which outline entries are expanded on reveal.\n- Set to 0 to collapse all items that have children\n- Set to 1 or higher to collapse items at that depth or deeper\n\nDefault: 100"
msgstr "Standardtiefe, bis zu der Gliederungselemente in der aktuellen Datei aufgeklappt werden.\nDie Standardtiefe, bis zu der Gliederungseinträge beim Anzeigen aufgeklappt werden.\n- Auf 0 setzen, um alle Elemente mit Unterelementen zuzuklappen\n- Auf 1 oder höher setzen, um Elemente ab dieser Tiefe zuzuklappen\n\nStandard: 100"

msgctxt "settings schema"
msgid "Default directories to search for virtual environments, relative\nto the current working directory. We recommend overriding this\nin your project's settings, rather than globally."
msgstr "Standardverzeichnisse für die Suche nach virtuellen Umgebungen, relativ zum aktuellen Arbeitsverzeichnis. Wir empfehlen, dies in den Einstellungen Ihres Projekts statt global zu überschreiben."

msgctxt "settings schema"
msgid "Default fixed width in pixels when the agent panel is docked to the left or right and\n`flexible` is false.\n\nDefault: 640"
msgstr "Standardmäßige feste Breite in Pixeln, wenn das Agent-Panel links oder rechts angedockt ist und `flexible` false ist.\n\nStandard: 640"

msgctxt "settings schema"
msgid "Default height in pixels when the AI browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Standardhöhe in Pixeln, wenn das KI-Browser-Panel unten angedockt ist.\n\nStandard: 320"

msgctxt "settings schema"
msgid "Default height in pixels when the agent panel is docked to the bottom.\n\nDefault: 320"
msgstr "Standardhöhe in Pixeln, wenn das Agent-Panel unten angedockt ist.\n\nStandard: 320"

msgctxt "settings schema"
msgid "Default height in pixels when the browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Standardhöhe in Pixeln, wenn das Browser-Panel unten angedockt ist.\n\nStandard: 320"

msgctxt "settings schema"
msgid "Default height when the terminal is docked to the bottom.\n\nDefault: 320"
msgstr "Standardhöhe, wenn das Terminal unten angedockt ist.\n\nStandard: 320"

msgctxt "settings schema"
msgid "Default is 1500ms."
msgstr "Der Standard ist 1500 ms."

msgctxt "settings schema"
msgid "Default kernels to select for each language.\n\nDefault: `{}`"
msgstr "Standardkernel, die für jede Sprache ausgewählt werden.\n\nStandard: `{}`"

msgctxt "settings schema"
msgid "Default mode when no regex rules match.\nWhen unset, inherits from the global `tool_permissions.default`."
msgstr "Standardmodus, wenn keine Regex-Regel zutrifft.\nWenn nicht gesetzt, wird der globale Wert `tool_permissions.default` übernommen."

msgctxt "settings schema"
msgid "Default options for buffer and project search items."
msgstr "Standardoptionen für Puffer- und Projektsuchelemente."

msgctxt "settings schema"
msgid "Default the cursor blink to off, but allow the terminal to\nset blinking."
msgstr "Cursor-Blinken standardmäßig aus, aber dem Terminal erlauben, das Blinken festzulegen."

msgctxt "settings schema"
msgid "Default timeout in seconds for context server tool calls.\nCan be overridden per-server in context_servers configuration.\n\nDefault: 60"
msgstr "Standard-Zeitlimit in Sekunden für Toolaufrufe von Kontextservern.\nKann in der Konfiguration context_servers pro Server überschrieben werden.\n\nStandard: 60"

msgctxt "settings schema"
msgid "Default values for session config options.\n\nThis is a map from config option ID to the default value for that option.\n\nDefault: {}"
msgstr "Standardwerte für Sitzungskonfigurationsoptionen.\n\nDies ist eine Zuordnung von der ID einer Konfigurationsoption zu ihrem Standardwert.\n\nStandard: {}"

msgctxt "settings schema"
msgid "Default width in pixels when the AI browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Standardbreite in Pixeln, wenn das KI-Browser-Panel links oder rechts angedockt ist.\n\nStandard: 480"

msgctxt "settings schema"
msgid "Default width in pixels when the browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Standardbreite in Pixeln, wenn das Browser-Panel links oder rechts angedockt ist.\n\nStandard: 480"

msgctxt "settings schema"
msgid "Default width of the call graph panel in pixels.\n\nDefault: 320"
msgstr "Standardbreite des Aufrufgraph-Panels in Pixeln.\n\nStandard: 320"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 240"
msgstr "Standardbreite des Panels in Pixeln.\n\nStandard: 240"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 360"
msgstr "Standardbreite des Panels in Pixeln.\n\nStandard: 360"

msgctxt "settings schema"
msgid "Default width of the threads sidebar in pixels.\n\nValues range from 200 to 800, matching the widths the sidebar can be\ndragged to. Values outside that range are clamped into it.\n\nDefault: 300"
msgstr "Standardbreite der Thread-Seitenleiste in Pixeln.\n\nWerte reichen von 200 bis 800, entsprechend den Breiten, auf die die Seitenleiste gezogen werden kann. Werte außerhalb dieses Bereichs werden darauf begrenzt.\n\nStandard: 300"

msgctxt "settings schema"
msgid "Default width when the terminal is docked to the left or right.\n\nDefault: 640"
msgstr "Standardbreite, wenn das Terminal links oder rechts angedockt ist.\n\nStandard: 640"

msgctxt "settings schema"
msgid "Default: 0.2"
msgstr "Standard: 0.2"

msgctxt "settings schema"
msgid "Default: {}"
msgstr "Standard: {}"

msgctxt "settings schema"
msgid "Defaults to use when opening a new buffer and project search items.\n\nDefault: nothing is enabled"
msgstr "Standardwerte beim Öffnen neuer Puffer- und Projektsuchelemente.\n\nStandard: nichts ist aktiviert"

msgctxt "settings schema"
msgid "Defines the border style for the minimap's scrollbar thumb.\n\nDefault: left_open"
msgstr "Legt den Rahmenstil für den Schieberegler der Scrollleiste der Minimap fest.\n\nStandard: left_open"

msgctxt "settings schema"
msgid "Delay in milliseconds before showing the which-key popup.\n\nDefault: 1000"
msgstr "Verzögerung in Millisekunden vor dem Anzeigen des Which-Key-Popups.\n\nStandard: 1000"

msgctxt "settings schema"
msgid "Deleted version control color."
msgstr "Farbe für gelöschte Versionskontrolleinträge."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_ours`."
msgstr "Veraltet; verwenden Sie stattdessen `version_control_conflict_marker_ours`."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_theirs`."
msgstr "Veraltet; verwenden Sie stattdessen `version_control_conflict_marker_theirs`."

msgctxt "settings schema"
msgid "Deprecated: use None instead. Left to avoid breaking existing users' configs.\nPrefer a single line generally, unless an overly long line is encountered."
msgstr "Veraltet: Verwenden Sie stattdessen None. Beibehalten, um bestehende Benutzerkonfigurationen nicht zu beschädigen.\nBevorzugt grundsätzlich eine einzelne Zeile, außer bei übermäßig langen Zeilen."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored."
msgstr "Legt fest, wie die Hintergründe der Einzugsführungslinien eingefärbt werden."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored.\n\nDefault: Disabled"
msgstr "Legt fest, wie die Hintergründe der Einzugsführungslinien eingefärbt werden.\n\nStandard: Disabled"

msgctxt "settings schema"
msgid "Determines how indent guides are colored."
msgstr "Legt fest, wie die Einzugsführungslinien eingefärbt werden."

msgctxt "settings schema"
msgid "Determines how indent guides are colored.\n\nDefault: Fixed"
msgstr "Legt fest, wie Einzugsführungslinien eingefärbt werden.\n\nStandard: Fixed"

msgctxt "settings schema"
msgid "Determines how much space the call hierarchy picker can take up in relation to the available window width.\n\nDefault: medium"
msgstr "Legt fest, wie viel Platz die Aufrufhierarchie-Auswahl im Verhältnis zur verfügbaren Fensterbreite einnehmen darf.\n\nStandard: medium"

msgctxt "settings schema"
msgid "Determines how much space the file finder can take up in relation to the available window width.\n\nDefault: small"
msgstr "Legt fest, wie viel Platz die Dateisuche im Verhältnis zur verfügbaren Fensterbreite einnehmen darf.\n\nStandard: small"

msgctxt "settings schema"
msgid "Determines how snippets are sorted relative to other completion items.\n\nDefault: inline"
msgstr "Legt fest, wie Snippets im Verhältnis zu anderen Vervollständigungselementen sortiert werden.\n\nStandard: inline"

msgctxt "settings schema"
msgid "Determines the modifier to be used to add multiple cursors with the mouse. The open hover link mouse gestures will adapt such that it do not conflict with the multicursor modifier.\n\nDefault: alt"
msgstr "Legt die Zusatztaste fest, mit der per Maus mehrere Cursor hinzugefügt werden. Die Mausgesten zum Öffnen von Hover-Links passen sich so an, dass sie nicht mit der Zusatztaste für Mehrfachcursor kollidieren.\n\nStandard: alt"

msgctxt "settings schema"
msgid "Determines the stepping granularity.\n\nDefault: line"
msgstr "Legt die Granularität der Schritte fest.\n\nStandard: line"

msgctxt "settings schema"
msgid "Determines what settings a profile starts from before applying its overrides."
msgstr "Legt fest, von welchen Einstellungen ein Profil ausgeht, bevor seine Überschreibungen angewendet werden."

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to\nkeyboard input. Applies globally across all input surfaces (editors,\nterminals, palettes, etc.).\n\nDefault: on_typing_and_action"
msgstr "Legt fest, wann der Mauszeiger als Reaktion auf Tastatureingaben ausgeblendet wird. Gilt global für alle Eingabeflächen (Editoren, Terminals, Paletten usw.).\n\nStandard: on_typing_and_action"

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to keyboard\ninput.\n\nDefault: on_typing_and_action"
msgstr "Legt fest, wann der Mauszeiger als Reaktion auf Tastatureingaben ausgeblendet wird.\n\nStandard: on_typing_and_action"

msgctxt "settings schema"
msgid "Determines whether the file finder should skip focus for the active file in search results.\n\nDefault: true"
msgstr "Legt fest, ob die Dateisuche den Fokus für die aktive Datei in den Suchergebnissen überspringt.\n\nStandard: true"

msgctxt "settings schema"
msgid "Determines whether to reduce non-essential motion in the UI, such as\nloading spinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Legt fest, ob nicht notwendige Bewegungen in der Oberfläche, etwa Ladeanimationen und pulsierende Beschriftungen, durch statische Darstellung reduziert werden.\n\nStandard: off"

msgctxt "settings schema"
msgid "Determines which edit prediction provider to use."
msgstr "Legt fest, welcher Anbieter für Bearbeitungsvorhersagen verwendet wird."

msgctxt "settings schema"
msgid "Diff against HEAD: show working (uncommitted) changes."
msgstr "Vergleich mit HEAD: Zeigt Änderungen im Arbeitsverzeichnis (nicht committete Änderungen)."

msgctxt "settings schema"
msgid "Diff against the merge base between HEAD and the repository's\ndefault branch: show all changes on the branch.\n\nRepositories where no default branch can be resolved fall back\nto `head` behavior."
msgstr "Diff gegen die Merge-Basis zwischen HEAD und dem Standardbranch des Repositorys: zeigt alle Änderungen auf dem Branch.\n\nRepositorys, für die kein Standardbranch ermittelt werden kann, verhalten sich wie `head`."

msgctxt "settings schema"
msgid "Dim black ANSI terminal color."
msgstr "Gedämpfte schwarze ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Dim blue ANSI terminal color."
msgstr "Gedämpfte blaue ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Dim cyan ANSI terminal color."
msgstr "Gedämpfte cyanfarbene ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Dim green ANSI terminal color."
msgstr "Gedämpfte grüne ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Dim magenta ANSI terminal color."
msgstr "Gedämpfte magentafarbene ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Dim red ANSI terminal color."
msgstr "Gedämpfte rote ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Dim terminal foreground color."
msgstr "Gedämpfte Terminal-Vordergrundfarbe."

msgctxt "settings schema"
msgid "Dim white ANSI terminal color."
msgstr "Gedämpfte weiße ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Dim yellow ANSI terminal color."
msgstr "Gedämpfte gelbe ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Direction to split horizontally.\n\nDefault: \"up\""
msgstr "Richtung für horizontales Teilen.\n\nStandard: \"up\""

msgctxt "settings schema"
msgid "Direction to split vertically.\n\nDefault: \"left\""
msgstr "Richtung für vertikales Teilen.\n\nStandard: \"left\""

msgctxt "settings schema"
msgid "Directory subtrees that sandboxed terminal commands may always write\nto without prompting. Each entry is either a bare path string or an\nobject `{requested, resolved}`; Zed writes objects (the canonical,\nsymlink-resolved target established at approval time), while\nhand-authored entries may be bare path strings. Paths written by Zed\nare absolute.\nDefault: []"
msgstr "Verzeichnisunterbäume, in die Terminalbefehle in der Sandbox immer ohne Abfrage schreiben dürfen. Jeder Eintrag ist entweder eine einfache Pfadzeichenfolge oder ein Objekt `{requested, resolved}`; ForgeKairos schreibt Objekte (das kanonische, bei der Genehmigung ermittelte Ziel mit aufgelösten symbolischen Links), während von Hand geschriebene Einträge einfache Pfadzeichenfolgen sein können. Von ForgeKairos geschriebene Pfade sind absolut.\nStandard: []"

msgctxt "settings schema"
msgid "Directory the log files are written to. `~` is expanded.\nWhen empty, logs go to Zed's log directory under `terminal-sessions`.\n\nDefault: \"\""
msgstr "Verzeichnis, in das die Protokolldateien geschrieben werden. `~` wird erweitert.\nWenn leer, werden Protokolle im Protokollverzeichnis von ForgeKairos unter `terminal-sessions` abgelegt.\n\nStandard: \"\""

msgctxt "settings schema"
msgid "Directory where git worktrees are created, relative to the repository\nworking directory.\n\nWhen the resolved directory is outside the project root, the\nproject's directory name is automatically appended so that\nsibling repos don't collide. For example, with the default\n`\"../worktrees\"` and a project at `~/code/zed`, worktrees are\ncreated under `~/code/worktrees/zed/`.\n\nWhen the resolved directory is inside the project root, no\nextra component is added (it's already project-scoped).\n\nExamples:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (default)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nTrailing slashes are ignored.\n\nDefault: ../worktrees"
msgstr "Verzeichnis, in dem Git-Worktrees erstellt werden, relativ zum Arbeitsverzeichnis des Repositorys.\n\nLiegt das aufgelöste Verzeichnis außerhalb des Projektstamms, wird automatisch der Verzeichnisname des Projekts angehängt, damit benachbarte Repositorys nicht kollidieren. Mit dem Standardwert `\"../worktrees\"` und einem Projekt unter `~/code/zed` werden Worktrees beispielsweise unter `~/code/worktrees/zed/` erstellt.\n\nLiegt das aufgelöste Verzeichnis innerhalb des Projektstamms, wird nichts angehängt (es ist bereits projektbezogen).\n\nBeispiele:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (Standard)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nSchrägstriche am Ende werden ignoriert.\n\nStandard: ../worktrees"

msgctxt "settings schema"
msgid "Disable autosave."
msgstr "Automatisches Speichern deaktivieren."

msgctxt "settings schema"
msgid "Disable certificate verification for the proxy (not recommended).\n\nDefault: false"
msgstr "Deaktiviert die Zertifikatsprüfung für den Proxy (nicht empfohlen).\n\nStandard: false"

msgctxt "settings schema"
msgid "Disable edit predictions for files matching these glob patterns.\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged.\n\nRelative patterns are matched against paths relative to the worktree root.\nAbsolute patterns are matched against absolute paths. A leading `~` is\nexpanded to your home folder."
msgstr "Deaktiviert Bearbeitungsvorhersagen für Dateien, die diesen Glob-Mustern entsprechen.\n\nVerwenden Sie `\"...\"`, um Muster hinzuzufügen, ohne die Standardwerte von ForgeKairos zu wiederholen. In Projekteinstellungen wird damit der Wert der Benutzer- oder übergeordneten Konfiguration erweitert. Lassen Sie `\"...\"` weg, um die geerbte Liste zu ersetzen.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nGeerbte Muster werden an der Stelle von `\"...\"` eingefügt, und bei Duplikaten bleibt das erste Vorkommen erhalten.\n\nSetzen Sie `[]`, um die geerbte Liste zu leeren. Lassen Sie diese Einstellung weg, um sie unverändert zu übernehmen.\n\nRelative Muster werden mit Pfaden relativ zum Worktree-Stamm abgeglichen.\nAbsolute Muster werden mit absoluten Pfaden abgeglichen. Ein führendes `~` wird zu Ihrem Home-Ordner erweitert."

msgctxt "settings schema"
msgid "Disable edit predictions in these language scopes, such as \"comment\" and\n\"string\".\n\nDefault:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` to add scopes without repeating the inherited list. In project\nsettings, it extends the user or parent configuration value. In\nlanguage-specific settings, it extends the scopes inherited by that\nlanguage. Omit `\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nInherited scopes are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged."
msgstr "Deaktiviert Bearbeitungsvorhersagen in diesen Sprachbereichen, etwa \"comment\" und \"string\".\n\nStandard:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nVerwenden Sie `\"...\"`, um Bereiche hinzuzufügen, ohne die geerbte Liste zu wiederholen. In Projekteinstellungen wird damit der Wert der Benutzer- oder übergeordneten Konfiguration erweitert. In sprachspezifischen Einstellungen werden die von dieser Sprache geerbten Bereiche erweitert. Lassen Sie `\"...\"` weg, um die geerbte Liste zu ersetzen.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nGeerbte Bereiche werden an der Stelle von `\"...\"` eingefügt, und bei Duplikaten bleibt das erste Vorkommen erhalten.\n\nSetzen Sie `[]`, um die geerbte Liste zu leeren. Lassen Sie diese Einstellung weg, um sie unverändert zu übernehmen."

msgctxt "settings schema"
msgid "Disables the fallback."
msgstr "Deaktiviert den Fallback."

msgctxt "settings schema"
msgid "Disables the tooltip"
msgstr "Deaktiviert den Tooltip"

msgctxt "settings schema"
msgid "Discards the changes."
msgstr "Verwirft die Änderungen."

msgctxt "settings schema"
msgid "Display code lenses from language servers above code elements."
msgstr "Zeigt CodeLens von Sprachservern oberhalb von Code-Elementen an."

msgctxt "settings schema"
msgid "Display code lenses in the code action menu."
msgstr "Zeigt CodeLens im Codeaktionsmenü an."

msgctxt "settings schema"
msgid "Display inline when there are no language server completions available."
msgstr "Inline anzeigen, wenn keine Sprachserver-Vervollständigungen verfügbar sind."

msgctxt "settings schema"
msgid "Displays a border on all sides except the left side of the thumb."
msgstr "Zeigt einen Rahmen auf allen Seiten außer der linken Seite des Reglers an."

msgctxt "settings schema"
msgid "Displays a border on all sides except the right side of the thumb."
msgstr "Zeigt einen Rahmen auf allen Seiten außer der rechten Seite des Reglers an."

msgctxt "settings schema"
msgid "Displays a border on all sides of the thumb."
msgstr "Zeigt einen Rahmen auf allen Seiten des Reglers an."

msgctxt "settings schema"
msgid "Displays a border only on the left side of the thumb."
msgstr "Zeigt einen Rahmen nur auf der linken Seite des Reglers an."

msgctxt "settings schema"
msgid "Displays file size in binary units (e.g., KiB, MiB)."
msgstr "Zeigt die Dateigröße in binären Einheiten an (z. B. KiB, MiB)."

msgctxt "settings schema"
msgid "Displays file size in decimal units (e.g., KB, MB)."
msgstr "Zeigt die Dateigröße in dezimalen Einheiten an (z. B. KB, MB)."

msgctxt "settings schema"
msgid "Displays the thumb without any border."
msgstr "Zeigt den Regler ohne Rahmen an."

msgctxt "settings schema"
msgid "Do not draw any tabs or spaces."
msgstr "Keine Tabulatoren oder Leerzeichen zeichnen."

msgctxt "settings schema"
msgid "Do not format code."
msgstr "Code nicht formatieren."

msgctxt "settings schema"
msgid "Do not load direnv configuration"
msgstr "Lädt die direnv-Konfiguration nicht"

msgctxt "settings schema"
msgid "Do not play any sound."
msgstr "Keinen Ton abspielen."

msgctxt "settings schema"
msgid "Do not query and display code lenses."
msgstr "CodeLens nicht abfragen und anzeigen."

msgctxt "settings schema"
msgid "Do not query and render document colors."
msgstr "Dokumentfarben nicht abfragen und rendern."

msgctxt "settings schema"
msgid "Do not render any background for indent guides."
msgstr "Keinen Hintergrund für Einzugsführungslinien rendern."

msgctxt "settings schema"
msgid "Do not render any lines for indent guides."
msgstr "Keine Linien für Einzugsführungslinien rendern."

msgctxt "settings schema"
msgid "Do not request folding ranges from language servers; use tree-sitter and indent-based folding."
msgstr "Keine Faltungsbereiche von Sprachservern anfordern; stattdessen tree-sitter- und einrückungsbasierte Faltung verwenden."

msgctxt "settings schema"
msgid "Do not request semantic tokens from language servers."
msgstr "Keine semantischen Token von Sprachservern anfordern."

msgctxt "settings schema"
msgid "Do not show diagnostics."
msgstr "Keine Diagnosen anzeigen."

msgctxt "settings schema"
msgid "Do not show snippets in the completion list"
msgstr "Keine Snippets in der Vervollständigungsliste anzeigen"

msgctxt "settings schema"
msgid "Don't list untracked files at all."
msgstr "Nicht verfolgte Dateien überhaupt nicht auflisten."

msgctxt "settings schema"
msgid "Don't use system clipboard."
msgstr "Verwendet die Systemzwischenablage nicht."

msgctxt "settings schema"
msgid "Drag and drop related settings"
msgstr "Einstellungen für Drag & Drop"

msgctxt "settings schema"
msgid "Draw a background behind the color text."
msgstr "Zeichnet einen Hintergrund hinter dem Farbtext."

msgctxt "settings schema"
msgid "Draw a border around the color text."
msgstr "Zeichnet einen Rahmen um den Farbtext."

msgctxt "settings schema"
msgid "Draw all invisible symbols."
msgstr "Alle unsichtbaren Symbole anzeigen."

msgctxt "settings schema"
msgid "Draw whitespace only for the selected text."
msgstr "Leerraum nur für den ausgewählten Text anzeigen."

msgctxt "settings schema"
msgid "Draw whitespaces at boundaries only.\n\nFor a whitespace to be on a boundary, any of the following conditions need to be met:\n- It is a tab\n- It is adjacent to an edge (start or end)\n- It is adjacent to a whitespace (left or right)"
msgstr "Leerraum nur an Grenzen darstellen.\n\nDamit sich Leerraum an einer Grenze befindet, muss eine der folgenden Bedingungen erfüllt sein:\n- Es ist ein Tabulator\n- Er grenzt an einen Rand (Anfang oder Ende)\n- Er grenzt an Leerraum (links oder rechts)"

msgctxt "settings schema"
msgid "Draw whitespaces only after non-whitespace characters."
msgstr "Leerraum nur nach Zeichen anzeigen, die kein Leerraum sind."

msgctxt "settings schema"
msgid "EXPERIMENTAL: Overrides for the current theme.\n\nThese values will override the ones on the current theme specified in `theme`."
msgstr "EXPERIMENTELL: Überschreibungen für das aktuelle Design.\n\nDiese Werte überschreiben die des aktuellen, in `theme` angegebenen Designs."

msgctxt "settings schema"
msgid "Enables or disables auto-closing of JSX tags."
msgstr "Aktiviert oder deaktiviert das automatische Schließen von JSX-Tags."

msgctxt "settings schema"
msgid "Enables or disables formatting with Prettier for a given language."
msgstr "Aktiviert oder deaktiviert die Formatierung mit Prettier für eine bestimmte Sprache."

msgctxt "settings schema"
msgid "Enterprise URI for Copilot.\n\nDefault: none"
msgstr "Enterprise-URI für Copilot.\n\nStandard: none"

msgctxt "settings schema"
msgid "Exclude files matching these glob patterns from file scans, file searches,\nand the project file tree. Takes precedence over `file_scan_inclusions`.\n\nDefault:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Schließt Dateien, die diesen Glob-Mustern entsprechen, von Dateiscans, Dateisuchen und dem Dateibaum des Projekts aus. Hat Vorrang vor `file_scan_inclusions`.\n\nStandard:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nVerwenden Sie `\"...\"`, um Muster hinzuzufügen, ohne die Standardwerte von ForgeKairos zu wiederholen. In Projekteinstellungen wird damit der Wert der Benutzer- oder übergeordneten Konfiguration erweitert. Lassen Sie `\"...\"` weg, um die geerbte Liste zu ersetzen.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nGeerbte Muster werden an der Stelle von `\"...\"` eingefügt, und bei Duplikaten bleibt das erste Vorkommen erhalten."

msgctxt "settings schema"
msgid "Extends under the left dock while snapping to the right dock"
msgstr "Dehnt sich unter dem linken Dock aus und rastet am rechten Dock ein"

msgctxt "settings schema"
msgid "Extends under the right dock while snapping to the left dock"
msgstr "Dehnt sich unter dem rechten Dock aus und rastet am linken Dock ein"

msgctxt "settings schema"
msgid "Extra task variables to set for a particular language."
msgstr "Zusätzliche Aufgabenvariablen, die für eine bestimmte Sprache festgelegt werden sollen."

msgctxt "settings schema"
msgid "Favorite models to show at the top of the model selector."
msgstr "Favoritenmodelle, die oben in der Modellauswahl angezeigt werden."

msgctxt "settings schema"
msgid "Favorited values for session config options.\n\nThis is a map from config option ID to a list of favorited value IDs.\n\nDefault: {}"
msgstr "Favorisierte Werte für Sitzungskonfigurationsoptionen.\n\nDies ist eine Zuordnung von der ID einer Konfigurationsoption zu einer Liste favorisierter Wert-IDs.\n\nStandard: {}"

msgctxt "settings schema"
msgid "File diff settings."
msgstr "Datei-Diff-Einstellungen."

msgctxt "settings schema"
msgid "File name for a new log. Supports the placeholders `{date}`, `{time}`,\n`{title}`, `{host}` and `{pid}`.\n\nDefault: \"{date}_{time}_{title}.log\""
msgstr "Dateiname für ein neues Protokoll. Unterstützt die Platzhalter `{date}`, `{time}`, `{title}`, `{host}` und `{pid}`.\n\nStandard: \"{date}_{time}_{title}.log\""

msgctxt "settings schema"
msgid "Files larger than this many bytes are attached as an outline (their\nsymbols with line numbers) instead of their full content.\n\nDefault: 16384"
msgstr "Dateien, die größer als diese Anzahl Bytes sind, werden als Gliederung (ihre Symbole mit Zeilennummern) statt mit vollständigem Inhalt angehängt.\n\nStandard: 16384"

msgctxt "settings schema"
msgid "Files should be formatted on save."
msgstr "Dateien werden beim Speichern formatiert."

msgctxt "settings schema"
msgid "Files should be formatted using a code action executed by language servers."
msgstr "Dateien werden mithilfe einer Codeaktion formatiert, die von Sprachservern ausgeführt wird."

msgctxt "settings schema"
msgid "Files should not be formatted on save."
msgstr "Dateien werden beim Speichern nicht formatiert."

msgctxt "settings schema"
msgid "Fill Color. Used for the accent fill color of an icon.\n\nThis might be used to show when a toggleable icon button is selected."
msgstr "Füllfarbe. Wird für die Akzent-Füllfarbe eines Symbols verwendet.\n\nKann verwendet werden, um anzuzeigen, dass eine umschaltbare Symbolschaltfläche ausgewählt ist."

msgctxt "settings schema"
msgid "Fill Color. Used for the default fill color of an icon."
msgstr "Füllfarbe. Wird als Standard-Füllfarbe eines Symbols verwendet."

msgctxt "settings schema"
msgid "Fill Color. Used for the disabled fill color of an icon.\n\nDisabled states are shown when a user cannot interact with an element, like a icon button."
msgstr "Füllfarbe. Wird für die deaktivierte Füllfarbe eines Symbols verwendet.\n\nDeaktivierte Zustände werden angezeigt, wenn ein Benutzer nicht mit einem Element interagieren kann, etwa mit einer Symbolschaltfläche."

msgctxt "settings schema"
msgid "Fill Color. Used for the muted or deemphasized fill color of an icon.\n\nThis might be used to show an icon in an inactive pane, or to deemphasize a series of icons to give them less visual weight."
msgstr "Füllfarbe. Wird für die gedämpfte oder zurückgenommene Füllfarbe eines Symbols verwendet.\n\nKann verwendet werden, um ein Symbol in einem inaktiven Bereich anzuzeigen oder um eine Reihe von Symbolen optisch zurückzunehmen."

msgctxt "settings schema"
msgid "Fill Color. Used for the placeholder fill color of an icon.\n\nThis might be used to show an icon in an input that disappears when the user enters text."
msgstr "Füllfarbe. Wird für die Platzhalter-Füllfarbe eines Symbols verwendet.\n\nKann verwendet werden, um ein Symbol in einem Eingabefeld anzuzeigen, das verschwindet, sobald der Benutzer Text eingibt."

msgctxt "settings schema"
msgid "Filled background color for added diff hunk row highlights in the editor."
msgstr "Hintergrundfarbe für gefüllte Zeilenhervorhebungen hinzugefügter Diff-Hunks im Editor."

msgctxt "settings schema"
msgid "Filled background color for deleted diff hunk row highlights in the editor."
msgstr "Hintergrundfarbe für gefüllte Zeilenhervorhebungen gelöschter Diff-Hunks im Editor."

msgctxt "settings schema"
msgid "Follow the visibility of the scrollbar."
msgstr "Der Sichtbarkeit der Scrollleiste folgen."

msgctxt "settings schema"
msgid "Font family name."
msgstr "Name der Schriftfamilie."

msgctxt "settings schema"
msgid "Font weight value between 100 (thin) and 900 (black)"
msgstr "Schriftstärke zwischen 100 (dünn) und 900 (schwarz)"

msgctxt "settings schema"
msgid "Forcefully enable or disable the scrollbar for each axis"
msgstr "Scrollleiste für jede Achse erzwungen aktivieren oder deaktivieren"

msgctxt "settings schema"
msgid "Forces Prettier integration to use a specific parser name when formatting files with the language."
msgstr "Erzwingt, dass die Prettier-Integration beim Formatieren von Dateien mit der Sprache einen bestimmten Parser-Namen verwendet."

msgctxt "settings schema"
msgid "Forces Prettier integration to use specific plugins when formatting files with the language.\nThe default Prettier will be installed with these plugins."
msgstr "Zwingt die Prettier-Integration, beim Formatieren von Dateien dieser Sprache bestimmte Plug-ins zu verwenden.\nDas Standard-Prettier wird mit diesen Plug-ins installiert."

msgctxt "settings schema"
msgid "Foreground color for Helix jump labels."
msgstr "Vordergrundfarbe für Helix-Sprungbeschriftungen."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Normal mode indicator."
msgstr "Vordergrundfarbe der Modusanzeige für den Vim-Helix-Normalmodus."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Select mode indicator."
msgstr "Vordergrundfarbe der Modusanzeige für den Vim-Helix-Auswahlmodus."

msgctxt "settings schema"
msgid "Foreground color for Vim Insert mode indicator."
msgstr "Vordergrundfarbe der Modusanzeige für den Vim-Einfügemodus."

msgctxt "settings schema"
msgid "Foreground color for Vim Replace mode indicator."
msgstr "Vordergrundfarbe der Modusanzeige für den Vim-Ersetzungsmodus."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Block mode indicator."
msgstr "Vordergrundfarbe der Modusanzeige für den visuellen Vim-Blockmodus."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Line mode indicator."
msgstr "Vordergrundfarbe der Modusanzeige für den visuellen Vim-Zeilenmodus."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual mode indicator."
msgstr "Vordergrundfarbe der Modusanzeige für den visuellen Vim-Modus."

msgctxt "settings schema"
msgid "Format code using Zed's Prettier integration."
msgstr "Formatiert Code mit der Prettier-Integration von ForgeKairos."

msgctxt "settings schema"
msgid "Format code using a language server."
msgstr "Formatiert Code über einen Sprachserver."

msgctxt "settings schema"
msgid "Format code using a specific language server."
msgstr "Formatiert Code über einen bestimmten Sprachserver."

msgctxt "settings schema"
msgid "Format code using an external command."
msgstr "Formatiert Code über einen externen Befehl."

msgctxt "settings schema"
msgid "Format code using the current language server."
msgstr "Formatiert Code über den aktuellen Sprachserver."

msgctxt "settings schema"
msgid "Format files using Zed's Prettier integration (if applicable),\nor falling back to formatting via language server."
msgstr "Formatiert Dateien mit der Prettier-Integration von ForgeKairos (falls zutreffend) oder greift ersatzweise auf die Formatierung über den Sprachserver zurück."

msgctxt "settings schema"
msgid "Git accounts a repository can commit and push as. Which one a repository\nuses is picked in the git panel and kept in `project_accounts`. An\naccount's token is kept in the operating system's credential store, never\nin this file.\n\nDefault: []"
msgstr "Git-Konten, als die ein Repository committen und pushen kann. Welches ein Repository verwendet, wird im Git-Panel ausgewählt und in `project_accounts` gespeichert. Das Token eines Kontos wird im Anmeldedatenspeicher des Betriebssystems abgelegt, nie in dieser Datei.\n\nStandard: []"

msgctxt "settings schema"
msgid "Git blame settings."
msgstr "Git-Blame-Einstellungen."

msgctxt "settings schema"
msgid "Global default permission when no tool-specific rules match.\nIndividual tools can override this with their own default.\nDefault: confirm"
msgstr "Globale Standardberechtigung, wenn keine toolspezifischen Regeln zutreffen.\nEinzelne Tools können dies mit einem eigenen Standard überschreiben.\nStandard: confirm"

msgctxt "settings schema"
msgid "Global switch to toggle hints on and off.\n\nDefault: false"
msgstr "Globaler Schalter zum Ein- und Ausschalten von Hinweisen.\n\nStandard: false"

msgctxt "settings schema"
msgid "Global switch to toggle inline values on and off when debugging.\n\nDefault: true"
msgstr "Globaler Schalter zum Ein- und Ausschalten von Inline-Werten beim Debuggen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Green ANSI terminal color."
msgstr "Grüne ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Gutter related settings"
msgstr "Einstellungen für die Randleiste"

msgctxt "settings schema"
msgid "HTTP/HTTPS proxy to use for Copilot.\n\nDefault: none"
msgstr "HTTP/HTTPS-Proxy für Copilot.\n\nStandard: none"

msgctxt "settings schema"
msgid "Hide git gutter"
msgstr "Git-Randleiste ausblenden"

msgctxt "settings schema"
msgid "Hide on typing and on key bindings that resolve to an action"
msgstr "Beim Tippen und bei Tastenkombinationen, die eine Aktion auslösen, ausblenden"

msgctxt "settings schema"
msgid "Hide only when typing"
msgstr "Nur beim Tippen ausblenden"

msgctxt "settings schema"
msgid "Hide the tab bar while the in-panel thread history is showing and the\npanel holds a single pane: the history lists the open tabs too, so the\nhorizontal row would say the same thing twice. Split the panel or close\nthe history and the tab bar comes back."
msgstr "Blendet die Tab-Leiste aus, solange der Thread-Verlauf im Panel angezeigt wird und das Panel nur einen Bereich enthält: Der Verlauf listet die geöffneten Tabs ebenfalls auf, sodass die horizontale Reihe dasselbe doppelt zeigen würde. Wenn Sie das Panel teilen oder den Verlauf schließen, erscheint die Tab-Leiste wieder."

msgctxt "settings schema"
msgid "Hide the values of variables in `private` files, as defined by the\nprivate_files setting. This only changes the visual representation,\nthe values are still present in the file and can be selected / copied / pasted\n\nDefault: false"
msgstr "Blendet die Werte von Variablen in `private`-Dateien aus, wie durch die Einstellung private_files festgelegt. Dies ändert nur die Darstellung; die Werte sind weiterhin in der Datei vorhanden und können ausgewählt / kopiert / eingefügt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Highlighted brackets background color.\n\nMatching brackets in the cursor scope are highlighted with this background color."
msgstr "Hintergrundfarbe hervorgehobener Klammern.\n\nZusammengehörige Klammern im Bereich des Cursors werden mit dieser Hintergrundfarbe hervorgehoben."

msgctxt "settings schema"
msgid "Hollow background color for added diff hunk row highlights in the editor."
msgstr "Hintergrundfarbe für ungefüllte Zeilenhervorhebungen hinzugefügter Diff-Hunks im Editor."

msgctxt "settings schema"
msgid "Hollow background color for deleted diff hunk row highlights in the editor."
msgstr "Hintergrundfarbe für ungefüllte Zeilenhervorhebungen gelöschter Diff-Hunks im Editor."

msgctxt "settings schema"
msgid "Hollow border color for added diff hunk row highlights in the editor."
msgstr "Rahmenfarbe für ungefüllte Zeilenhervorhebungen hinzugefügter Diff-Hunks im Editor."

msgctxt "settings schema"
msgid "Hollow border color for deleted diff hunk row highlights in the editor."
msgstr "Rahmenfarbe für ungefüllte Zeilenhervorhebungen gelöschter Diff-Hunks im Editor."

msgctxt "settings schema"
msgid "Hollow box cursor."
msgstr "Umrandeter Cursor."

msgctxt "settings schema"
msgid "Hosts that sandboxed terminal commands may always reach over the\nnetwork without prompting. Each entry is an exact hostname\n(`github.com`) or a leading-`*.` subdomain wildcard (`*.npmjs.org`).\nDefault: []"
msgstr "Hosts, die Terminalbefehle in der Sandbox immer ohne Abfrage über das Netzwerk erreichen dürfen. Jeder Eintrag ist ein exakter Hostname (`github.com`) oder ein Subdomain-Platzhalter mit führendem `*.` (`*.npmjs.org`).\nStandard: []"

msgctxt "settings schema"
msgid "How and when the scrollbar should be displayed.\n\nDefault: inherits editor scrollbar settings"
msgstr "Wie und wann die Scrollleiste angezeigt wird.\n\nStandard: übernimmt die Scrollleisteneinstellungen des Editors"

msgctxt "settings schema"
msgid "How entry statuses are displayed.\n\nDefault: icon"
msgstr "Wie der Status von Einträgen angezeigt wird.\n\nStandard: icon"

msgctxt "settings schema"
msgid "How file paths are displayed in the git gutter.\n\nDefault: file_name_first"
msgstr "Wie Dateipfade in der Git-Randleiste angezeigt werden.\n\nStandard: file_name_first"

msgctxt "settings schema"
msgid "How hunks are displayed visually in the editor.\n\nDefault: staged_hollow"
msgstr "Wie Hunks im Editor dargestellt werden.\n\nStandard: staged_hollow"

msgctxt "settings schema"
msgid "How line endings should be handled for new files and during format and\nsave operations.\n\n- `detect`: Detect existing line endings and otherwise use the platform\n  default (`lf` on Unix, `crlf` on Windows).\n- `prefer_lf`: Prefer LF for new files and files with no existing line\n  ending.\n- `prefer_crlf`: Prefer CRLF for new files and files with no existing\n  line ending.\n- `enforce_lf`: Enforce LF during format and save.\n- `enforce_crlf`: Enforce CRLF during format and save.\n\nThe EditorConfig `end_of_line` property overrides this setting and\nbehaves like `enforce_lf` or `enforce_crlf`.\n\nDefault: detect"
msgstr "Wie Zeilenenden bei neuen Dateien sowie beim Formatieren und Speichern behandelt werden.\n\n- `detect`: Vorhandene Zeilenenden erkennen und andernfalls den Plattformstandard verwenden (`lf` unter Unix, `crlf` unter Windows).\n- `prefer_lf`: LF für neue Dateien und Dateien ohne vorhandenes Zeilenende bevorzugen.\n- `prefer_crlf`: CRLF für neue Dateien und Dateien ohne vorhandenes Zeilenende bevorzugen.\n- `enforce_lf`: LF beim Formatieren und Speichern erzwingen.\n- `enforce_crlf`: CRLF beim Formatieren und Speichern erzwingen.\n\nDie EditorConfig-Eigenschaft `end_of_line` überschreibt diese Einstellung und verhält sich wie `enforce_lf` oder `enforce_crlf`.\n\nStandard: detect"

msgctxt "settings schema"
msgid "How long \"go to definition\" waits for the language server before it\nalso offers the index's name matches, in milliseconds, from 100 to\n10000.\n\nDefault: 1500"
msgstr "Wie lange „Zur Definition wechseln“ auf den Sprachserver wartet, bevor auch die Namensübereinstimmungen des Index angeboten werden, in Millisekunden, von 100 bis 10000.\n\nStandard: 1500"

msgctxt "settings schema"
msgid "How many callers or callees of one function to list before a\n\"Show more\" row.\n\nDefault: 200"
msgstr "Wie viele Aufrufer oder Aufgerufene einer Funktion vor einer Zeile „Mehr anzeigen“ aufgelistet werden.\n\nStandard: 200"

msgctxt "settings schema"
msgid "How many characters has to be in the completions query to automatically show the words-based completions.\nBefore that value, it's still possible to trigger the words-based completion manually with the corresponding editor command.\n\nDefault: 3"
msgstr "Wie viele Zeichen die Vervollständigungsabfrage enthalten muss, damit wortbasierte Vervollständigungen automatisch angezeigt werden.\nVorher lässt sich die wortbasierte Vervollständigung weiterhin manuell mit dem entsprechenden Editorbefehl auslösen.\n\nStandard: 3"

msgctxt "settings schema"
msgid "How many columns a tab should occupy.\n\nDefault: 4"
msgstr "Wie viele Spalten ein Tabulator einnimmt.\n\nStandard: 4"

msgctxt "settings schema"
msgid "How many hours a session stays alive on the host with no terminal\nattached to it before its shell is ended. 0 keeps it forever.\n\nDefault: 24"
msgstr "Wie viele Stunden eine Sitzung ohne verbundenes Terminal auf dem Host bestehen bleibt, bevor ihre Shell beendet wird. 0 behält sie für immer.\n\nStandard: 24"

msgctxt "settings schema"
msgid "How many lines of context to provide in multibuffer excerpts by default\n\nDefault: 2"
msgstr "Wie viele Kontextzeilen Multibuffer-Auszüge standardmäßig enthalten.\n\nStandard: 2"

msgctxt "settings schema"
msgid "How many lines to expand the multibuffer excerpts by default\n\nDefault: 3"
msgstr "Um wie viele Zeilen Multibuffer-Auszüge standardmäßig erweitert werden.\n\nStandard: 3"

msgctxt "settings schema"
msgid "How many minutes an external agent's connection is kept once no thread\nof that agent is open any more. The agent (and the sandbox it runs in)\nis stopped after that, and opening one of its threads again connects\nanew. `0` keeps every connection until the window closes.\n\nDefault: 5"
msgstr "Wie viele Minuten die Verbindung eines externen Agenten erhalten bleibt, wenn kein Thread dieses Agenten mehr geöffnet ist. Danach wird der Agent (und die Sandbox, in der er läuft) beendet, und beim erneuten Öffnen eines seiner Threads wird neu verbunden. `0` hält jede Verbindung, bis das Fenster geschlossen wird.\n\nStandard: 5"

msgctxt "settings schema"
msgid "How many threads clangd uses to build and index files (`-j`). Unset\nleaves clangd's own default. Values over 256 are treated as 256.\nIgnored when `lsp.clangd.binary.arguments` already has `-j`. Read from\nthe user's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Wie viele Threads clangd zum Erstellen und Indizieren von Dateien verwendet (`-j`). Nicht gesetzt behält den eigenen Standard von clangd bei. Werte über 256 werden als 256 behandelt.\nWird ignoriert, wenn `lsp.clangd.binary.arguments` bereits `-j` enthält. Wird nur aus den Benutzereinstellungen gelesen, nicht aus der `.zed/settings.json` eines Projekts.\n\nStandard: null"

msgctxt "settings schema"
msgid "How much memory clangd, the C and C++ language server, may use."
msgstr "Wie viel Speicher clangd, der Sprachserver für C und C++, verwenden darf."

msgctxt "settings schema"
msgid "How much to fade out unused code."
msgstr "Legt fest, wie stark nicht verwendeter Code ausgeblendet wird."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel."
msgstr "Legt fest, wie Denkblöcke standardmäßig im Agent-Panel angezeigt werden."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel.\n\nDefault: automatic"
msgstr "Wie Denkblöcke im Agent-Panel standardmäßig angezeigt werden.\n\nStandard: automatic"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: split"
msgstr "Wie Diffs im Editor angezeigt werden.\n\nStandard: split"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: unified"
msgstr "Wie Diffs im Editor angezeigt werden.\n\nStandard: unified"

msgctxt "settings schema"
msgid "How to display the LSP item kind (function, method, variable, etc.)\nof each entry in the completions menu.\n\n- \"off\": do not display item kinds (default).\n- \"symbol\": display a single-letter badge, colorized based on the\n  active syntax theme.\n\nDefault: off"
msgstr "Wie die LSP-Elementart (Funktion, Methode, Variable usw.) jedes Eintrags im Vervollständigungsmenü angezeigt wird.\n\n- \"off\": Elementarten nicht anzeigen (Standard).\n- \"symbol\": Ein Badge mit einem Buchstaben anzeigen, eingefärbt nach dem aktiven Syntaxdesign.\n\nStandard: off"

msgctxt "settings schema"
msgid "How to group entries in the git panel.\n\nDefault: status"
msgstr "Wie Einträge im Git-Panel gruppiert werden.\n\nStandard: status"

msgctxt "settings schema"
msgid "How to highlight the current line in the editor.\n\nDefault: all"
msgstr "Wie die aktuelle Zeile im Editor hervorgehoben wird.\n\nStandard: all"

msgctxt "settings schema"
msgid "How to highlight the current line in the minimap.\n\nDefault: inherits editor line highlights setting"
msgstr "Wie die aktuelle Zeile in der Minimap hervorgehoben wird.\n\nStandard: übernimmt die Zeilenhervorhebungs-Einstellung des Editors"

msgctxt "settings schema"
msgid "How to indent soft-wrapped continuation lines.\n\nDefault: same"
msgstr "Legt fest, wie weich umbrochene Fortsetzungszeilen eingerückt werden.\n\nStandard: same"

msgctxt "settings schema"
msgid "How to order sibling entries in the project panel.\n\nDefault: directories_first"
msgstr "Wie Einträge derselben Ebene im Projektpanel angeordnet werden.\n\nStandard: directories_first"

msgctxt "settings schema"
msgid "How to perform a buffer format.\n\nDefault: auto"
msgstr "Wie ein Puffer formatiert wird.\n\nStandard: auto"

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor."
msgstr "Legt fest, wie LSP-`textDocument/documentColor`-Farben im Editor gerendert werden."

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor.\n\nDefault: [`DocumentColorsRenderMode::Inlay`]"
msgstr "Wie LSP-Farben aus `textDocument/documentColor` im Editor dargestellt werden.\n\nStandard: [`DocumentColorsRenderMode::Inlay`]"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference\n(e.g. Go to Definition, Go to Type Definition, Find All References).\n\nDefault: center"
msgstr "Wie das Ziel beim Navigieren zu einer Definition oder Referenz in den sichtbaren Bereich gescrollt wird\n(z. B. Zur Definition wechseln, Zur Typdefinition wechseln, Alle Referenzen suchen).\n\nStandard: center"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference.\n\nDefault: center"
msgstr "Wie das Ziel beim Navigieren zu einer Definition oder Referenz in den sichtbaren Bereich gescrollt wird.\n\nStandard: center"

msgctxt "settings schema"
msgid "How to soft-wrap long lines of text.\n\nDefault: none"
msgstr "Wie lange Textzeilen weich umbrochen werden.\n\nStandard: none"

msgctxt "settings schema"
msgid "How to sort entries in the git panel.\n\nDefault: path"
msgstr "Wie Einträge im Git-Panel sortiert werden.\n\nStandard: path"

msgctxt "settings schema"
msgid "IDs of the tools not to suggest (`clangd`, `clang-format`, `ruff` and so\non). \"Don't show again\" in the notification adds a tool here.\n\nDefault: []"
msgstr "IDs der Tools, die nicht vorgeschlagen werden sollen (`clangd`, `clang-format`, `ruff` usw.). „Nicht mehr anzeigen“ in der Benachrichtigung fügt ein Tool hier hinzu.\n\nStandard: []"

msgctxt "settings schema"
msgid "IMDSv2, PodIdentity, env vars, etc."
msgstr "IMDSv2, PodIdentity, Umgebungsvariablen usw."

msgctxt "settings schema"
msgid "Icon Theme Name"
msgstr "Name des Symboldesigns"

msgctxt "settings schema"
msgid "If enabled, Zed will download its own copy of Node."
msgstr "Wenn aktiviert, lädt ForgeKairos eine eigene Kopie von Node herunter."

msgctxt "settings schema"
msgid "If provider supports it, display inline when holding modifier key (e.g., alt).\nOtherwise, eager preview is used."
msgstr "Wenn der Anbieter es unterstützt, inline anzeigen, solange eine Zusatztaste (z. B. alt) gedrückt gehalten wird.\nAndernfalls wird die sofortige Vorschau verwendet."

msgctxt "settings schema"
msgid "If the server supports sending tasks over LSP extensions,\nthis setting can be used to enable or disable them in Zed.\nDefault: true"
msgstr "Wenn der Server das Senden von Aufgaben über LSP-Erweiterungen unterstützt, können sie mit dieser Einstellung in ForgeKairos aktiviert oder deaktiviert werden.\nStandard: true"

msgctxt "settings schema"
msgid "Ignored version control color."
msgstr "Farbe für ignorierte Dateien in der Versionskontrolle."

msgctxt "settings schema"
msgid "Include files matching these glob patterns when scanning, even if ignored\nby Git. Note that broad patterns can slow file scanning.\n`file_scan_exclusions` takes precedence.\n\nDefault:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Bezieht Dateien, die diesen Glob-Mustern entsprechen, beim Scannen ein, auch wenn Git sie ignoriert. Beachten Sie, dass weit gefasste Muster den Dateiscan verlangsamen können.\n`file_scan_exclusions` hat Vorrang.\n\nStandard:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nVerwenden Sie `\"...\"`, um Muster hinzuzufügen, ohne die Standardwerte von ForgeKairos zu wiederholen. In Projekteinstellungen wird damit der Wert der Benutzer- oder übergeordneten Konfiguration erweitert. Lassen Sie `\"...\"` weg, um die geerbte Liste zu ersetzen.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nGeerbte Muster werden an der Stelle von `\"...\"` eingefügt, und bei Duplikaten bleibt das erste Vorkommen erhalten."

msgctxt "settings schema"
msgid "Indent guide related settings."
msgstr "Einstellungen für Einzugsführungslinien."

msgctxt "settings schema"
msgid "Index a worktree once it has C or C++ files."
msgstr "Einen Worktree indizieren, sobald er C- oder C++-Dateien enthält."

msgctxt "settings schema"
msgid "Index only the open files."
msgstr "Nur die geöffneten Dateien indizieren."

msgctxt "settings schema"
msgid "Index the whole project in the background (clangd's default)."
msgstr "Das ganze Projekt im Hintergrund indizieren (Standard von clangd)."

msgctxt "settings schema"
msgid "Indicates a changed or altered status, like a file that has been edited."
msgstr "Zeigt einen geänderten oder bearbeiteten Status an, z. B. eine bearbeitete Datei."

msgctxt "settings schema"
msgid "Indicates a hint or some kind of additional information."
msgstr "Zeigt einen Hinweis oder eine zusätzliche Information an."

msgctxt "settings schema"
msgid "Indicates a successful operation or task completion."
msgstr "Zeigt einen erfolgreichen Vorgang oder Aufgabenabschluss an."

msgctxt "settings schema"
msgid "Indicates a system error, a failed operation or a diagnostic error."
msgstr "Zeigt einen Systemfehler, einen fehlgeschlagenen Vorgang oder einen Diagnosefehler an."

msgctxt "settings schema"
msgid "Indicates some kind of conflict, like a file changed on disk while it was open, or\nmerge conflicts in a Git repository."
msgstr "Zeigt einen Konflikt an, etwa eine Datei, die auf dem Datenträger geändert wurde, während sie geöffnet war, oder Merge-Konflikte in einem Git-Repository."

msgctxt "settings schema"
msgid "Indicates some kind of unreachable status, like a block of code that can never be reached."
msgstr "Zeigt einen nicht erreichbaren Status an, z. B. einen Codeblock, der niemals ausgeführt werden kann."

msgctxt "settings schema"
msgid "Indicates something new, like a new file added to a Git repository."
msgstr "Zeigt etwas Neues an, z. B. eine dem Git-Repository hinzugefügte Datei."

msgctxt "settings schema"
msgid "Indicates something that is predicted, like automatic code completion, or generated code."
msgstr "Zeigt etwas Vorhergesagtes an, z. B. automatische Codevervollständigung oder generierten Code."

msgctxt "settings schema"
msgid "Indicates that something is deliberately ignored, such as a file or operation ignored by Git."
msgstr "Zeigt an, dass etwas absichtlich ignoriert wird, z. B. eine von Git ignorierte Datei oder ein ignorierter Vorgang."

msgctxt "settings schema"
msgid "Indicates that something no longer exists, like a deleted file."
msgstr "Zeigt an, dass etwas nicht mehr vorhanden ist, z. B. eine gelöschte Datei."

msgctxt "settings schema"
msgid "Indicates whether this custom model supports caching."
msgstr "Gibt an, ob dieses benutzerdefinierte Modell Caching unterstützt."

msgctxt "settings schema"
msgid "Inherit cursor shape from the editor's base cursor_shape setting."
msgstr "Übernimmt die Cursorform aus der Basis-Einstellung cursor_shape des Editors."

msgctxt "settings schema"
msgid "Inlay hint related settings."
msgstr "Einstellungen zu Inlay-Hinweisen."

msgctxt "settings schema"
msgid "Jupyter REPL settings."
msgstr "Jupyter-REPL-Einstellungen."

msgctxt "settings schema"
msgid "Keep model alive for N seconds"
msgstr "Modell für N Sekunden aktiv halten"

msgctxt "settings schema"
msgid "Keep model alive for a fixed duration. Accepts durations like \"5m\", \"10m\", \"1h\", \"1d\", etc."
msgstr "Modell für eine feste Zeitdauer aktiv halten. Akzeptiert Angaben wie „5m“, „10m“, „1h“, „1d“ usw."

msgctxt "settings schema"
msgid "Keep the tab bar hidden, leaving the in-panel thread history as the way\nto the open tabs. A panel too narrow to show that list, or the strip\nthat brings it back, still gets the tab bar: otherwise nothing would\nreach the tabs that are not in front."
msgstr "Hält die Tab-Leiste ausgeblendet, sodass der Thread-Verlauf im Panel der Weg zu den geöffneten Tabs bleibt. Ein Panel, das zu schmal ist, um diese Liste oder die Leiste zu ihrer Wiederherstellung anzuzeigen, erhält dennoch die Tab-Leiste: Sonst wären die Tabs, die nicht im Vordergrund sind, nicht erreichbar."

msgctxt "settings schema"
msgid "Keeps the changes in the working tree, unstaged."
msgstr "Behält die Änderungen im Arbeitsverzeichnis, nicht gestagt."

msgctxt "settings schema"
msgid "Keeps the changes staged."
msgstr "Behält die Änderungen gestagt."

msgctxt "settings schema"
msgid "Language server settings.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Einstellungen des Sprachservers.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nWelche Einstellungen unterstützt werden, entnehmen Sie der Dokumentation des jeweiligen Sprachservers."

msgctxt "settings schema"
msgid "Language servers from extensions that keep running while their\nworktree's code is paused, by name (for example `\"gopls\"`). Other\nextensions' servers stop until the worktree is resumed. Read from the\nuser settings file only.\n\nDefault: []"
msgstr "Sprachserver aus Erweiterungen, die weiterlaufen, während der Code ihres Worktrees angehalten ist, nach Namen (zum Beispiel `\"gopls\"`). Server anderer Erweiterungen werden angehalten, bis der Worktree fortgesetzt wird. Wird nur aus der Benutzereinstellungsdatei gelesen.\n\nStandard: []"

msgctxt "settings schema"
msgid "Largest outline sent for one file, in bytes. Deeper symbols are\ndropped first when an outline does not fit.\n\nDefault: 8192"
msgstr "Größte Gliederung, die für eine Datei gesendet wird, in Bytes. Passt eine Gliederung nicht, werden tiefere Symbole zuerst weggelassen.\n\nStandard: 8192"

msgctxt "settings schema"
msgid "Largest part of a fetched web page that is attached, in bytes.\n\nDefault: 32768"
msgstr "Größter Teil einer abgerufenen Webseite, der angehängt wird, in Bytes.\n\nStandard: 32768"

msgctxt "settings schema"
msgid "Layout mode for the bottom dock\n\nDefault: contained"
msgstr "Layoutmodus für das untere Dock\n\nStandard: contained"

msgctxt "settings schema"
msgid "Leave the slot empty: the dock shows a single panel, as upstream Zed\ndoes, or none at all."
msgstr "Den Platz leer lassen: Das Dock zeigt wie das Upstream-Zed ein einzelnes Panel oder gar keines."

msgctxt "settings schema"
msgid "Leave the window open when there are no tabs"
msgstr "Das Fenster offen lassen, wenn keine Tabs vorhanden sind"

msgctxt "settings schema"
msgid "Limits on how much of an attachment (a file, a directory, a selection,\na fetched page, diagnostics or a branch diff) is sent to the agent.\nAnything over these limits is sent as an outline or a reference the\nagent can follow up on instead of in full."
msgstr "Grenzen dafür, wie viel eines Anhangs (einer Datei, eines Verzeichnisses, einer Auswahl, einer abgerufenen Seite, von Diagnosen oder eines Branch-Diffs) an den Agenten gesendet wird. Alles über diesen Grenzen wird statt vollständig als Gliederung oder als Verweis gesendet, dem der Agent nachgehen kann."

msgctxt "settings schema"
msgid "List every file inside untracked directories."
msgstr "Jede Datei in nicht verfolgten Verzeichnissen auflisten."

msgctxt "settings schema"
msgid "List untracked directories, but not the files inside them."
msgstr "Nicht verfolgte Verzeichnisse auflisten, aber nicht die Dateien darin."

msgctxt "settings schema"
msgid "Load direnv configuration directly using `direnv export json`"
msgstr "Lädt die direnv-Konfiguration direkt mit `direnv export json`"

msgctxt "settings schema"
msgid "Load direnv configuration through a shell hook"
msgstr "Lädt die direnv-Konfiguration über einen Shell-Hook"

msgctxt "settings schema"
msgid "Local overrides for feature flags, keyed by flag name."
msgstr "Lokale Überschreibungen für Feature-Flags, mit Flag-Namen als Schlüssel."

msgctxt "settings schema"
msgid "Looks up references of the same symbol instead."
msgstr "Sucht stattdessen nach Referenzen desselben Symbols."

msgctxt "settings schema"
msgid "Lowercase names are grouped before uppercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Namen in Kleinbuchstaben werden vor Namen in Großbuchstaben gruppiert, mit natürlicher Sortierung ohne Beachtung der Groß-/Kleinschreibung innerhalb jeder Gruppe. Namen mit vorangestelltem Punkt werden vor beiden Gruppen einsortiert."

msgctxt "settings schema"
msgid "Magenta ANSI terminal color."
msgstr "Magentafarbene ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Map from language name to file patterns."
msgstr "Zuordnung von Sprachnamen zu Dateimustern."

msgctxt "settings schema"
msgid "Map from language name to settings."
msgstr "Zuordnung von Sprachnamen zu Einstellungen."

msgctxt "settings schema"
msgid "Match platform conventions by default, so \"on\" on macOS and \"off\" everywhere else"
msgstr "Entspricht standardmäßig den Plattformkonventionen: \"on\" unter macOS und \"off\" auf allen anderen Plattformen"

msgctxt "settings schema"
msgid "Match platform conventions by default, so don't quit on macOS, and quit on other platforms"
msgstr "Entspricht standardmäßig den Plattformkonventionen: unter macOS nicht beenden, auf anderen Plattformen beenden"

msgctxt "settings schema"
msgid "Match the system's configured behavior."
msgstr "Entspricht dem konfigurierten Systemverhalten."

msgctxt "settings schema"
msgid "Maximum content width in pixels for the agent panel. Content will be\ncentered when the panel is wider than this value.\n\nDefault: 850"
msgstr "Maximale Inhaltsbreite des Agent-Panels in Pixeln. Der Inhalt wird zentriert, wenn das Panel breiter als dieser Wert ist.\n\nStandard: 850"

msgctxt "settings schema"
msgid "Maximum directory depth to eagerly index outside of git repositories;\ncontents of directories at this depth or deeper are indexed on demand.\nRepositories rooted shallower than this depth are always indexed fully.\nIn projects that are not rooted at a git repository, repositories directly\ninside a root folder activate their git features immediately; deeper ones\nactivate on first use.\n`0` means no limit and activates all git repositories immediately.\n\nDefault: 5"
msgstr "Maximale Verzeichnistiefe, bis zu der außerhalb von Git-Repositorys vorab indiziert wird; Inhalte von Verzeichnissen in dieser oder größerer Tiefe werden bei Bedarf indiziert.\nRepositorys, deren Stamm weniger tief liegt, werden immer vollständig indiziert.\nIn Projekten, deren Stamm kein Git-Repository ist, aktivieren Repositorys direkt in einem Stammordner ihre Git-Funktionen sofort; tiefer liegende werden bei der ersten Verwendung aktiviert.\n`0` bedeutet keine Begrenzung und aktiviert alle Git-Repositorys sofort.\n\nStandard: 5"

msgctxt "settings schema"
msgid "Maximum length of the commit message title before a warning is shown.\nSet to 0 to disable.\n\nDefault: 0"
msgstr "Maximale Länge des Titels der Commit-Nachricht, bevor eine Warnung angezeigt wird.\nAuf 0 setzen, um dies zu deaktivieren.\n\nStandard: 0"

msgctxt "settings schema"
msgid "Maximum number of characters for an output to be shown inline.\nOnly applies when `inline_output` is true.\n\nDefault: 50"
msgstr "Maximale Anzahl Zeichen, bis zu der eine Ausgabe inline angezeigt wird.\nGilt nur, wenn `inline_output` true ist.\n\nStandard: 50"

msgctxt "settings schema"
msgid "Maximum number of columns to display in the minimap.\n\nDefault: 80"
msgstr "Maximale Anzahl Spalten, die in der Minimap angezeigt werden.\n\nStandard: 80"

msgctxt "settings schema"
msgid "Maximum number of columns to keep in REPL's scrollback buffer.\nClamped with [20, 512] range.\n\nDefault: 128"
msgstr "Maximale Anzahl Spalten im Scrollback-Puffer der REPL.\nWird auf den Bereich [20, 512] begrenzt.\n\nStandard: 128"

msgctxt "settings schema"
msgid "Maximum number of idle threads with loadable sessions to retain in the\nagent panel. Set to 0 to unload every eligible idle thread when it is\nno longer active.\n\nDefault: 5"
msgstr "Maximale Anzahl inaktiver Threads mit ladbaren Sitzungen, die im Agent-Panel erhalten bleiben. Bei 0 wird jeder infrage kommende inaktive Thread entladen, sobald er nicht mehr aktiv ist.\n\nStandard: 5"

msgctxt "settings schema"
msgid "Maximum number of lines of output to display before scrolling.\nSet to 0 to disable output height limits.\n\nDefault: 0"
msgstr "Maximale Anzahl Ausgabezeilen, die vor dem Scrollen angezeigt werden.\nAuf 0 setzen, um die Höhenbegrenzung der Ausgabe zu deaktivieren.\n\nStandard: 0"

msgctxt "settings schema"
msgid "Maximum number of lines to keep in REPL's scrollback buffer.\nClamped with [4, 256] range.\n\nDefault: 32"
msgstr "Maximale Anzahl Zeilen im Scrollback-Puffer der REPL.\nWird auf den Bereich [4, 256] begrenzt.\n\nStandard: 32"

msgctxt "settings schema"
msgid "Maximum open tabs in a pane. Will not close an unsaved\ntab. Set to `None` for unlimited tabs.\n\nDefault: none"
msgstr "Maximale Anzahl geöffneter Tabs in einem Bereich. Ein nicht gespeicherter Tab wird nicht geschlossen. Auf `None` setzen für unbegrenzt viele Tabs.\n\nStandard: none"

msgctxt "settings schema"
msgid "Maximum tokens to generate for FIM models and self-hosted Sweep rewrite responses.\n\nDefault: 256"
msgstr "Maximale Anzahl zu generierender Token für FIM-Modelle und Umschreibantworten eines selbst gehosteten Sweep.\n\nStandard: 256"

msgctxt "settings schema"
msgid "Maximum tokens to generate.\n\nDefault: 150"
msgstr "Maximale Anzahl zu generierender Token.\n\nStandard: 150"

msgctxt "settings schema"
msgid "Minimap related settings"
msgstr "Einstellungen zur Minimap"

msgctxt "settings schema"
msgid "Minimum APCA perceptual contrast for text over highlight backgrounds.\n\nValid range: 0.0 to 106.0\nDefault: 45.0"
msgstr "Minimaler wahrnehmungsbasierter APCA-Kontrast für Text auf Hervorhebungshintergründen.\n\nGültiger Bereich: 0.0 bis 106.0\nStandard: 45.0"

msgctxt "settings schema"
msgid "Minimum number of characters to reserve space for in the gutter.\n\nDefault: 4"
msgstr "Minimale Anzahl Zeichen, für die in der Randleiste Platz reserviert wird.\n\nStandard: 4"

msgctxt "settings schema"
msgid "Minimum number of lines of height the agent message editor should have.\n\nDefault: 4"
msgstr "Minimale Höhe des Nachrichteneditors des Agenten in Zeilen.\n\nStandard: 4"

msgctxt "settings schema"
msgid "Minimum time to wait before pulling diagnostics from the language server(s).\n0 turns the debounce off.\n\nDefault: 50"
msgstr "Minimale Wartezeit, bevor Diagnosen vom Sprachserver bzw. von den Sprachservern abgerufen werden.\n0 deaktiviert die Entprellung.\n\nStandard: 50"

msgctxt "settings schema"
msgid "Mix directories and files together"
msgstr "Verzeichnisse und Dateien zusammenmischen"

msgctxt "settings schema"
msgid "Model that judges whether a tool action is dangerous when the tool\npermission mode is `auto`. Defaults to the fast model, then to\ndefault_model, when not specified."
msgstr "Modell, das beurteilt, ob eine Tool-Aktion gefährlich ist, wenn der Tool-Berechtigungsmodus `auto` ist. Ohne Angabe wird das schnelle Modell verwendet, danach default_model."

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: \"codestral-latest\""
msgstr "Modell für Vervollständigungen.\n\nStandard: \"codestral-latest\""

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: none"
msgstr "Modell für Vervollständigungen.\n\nStandard: none"

msgctxt "settings schema"
msgid "Model to use for context compaction (`/compact` and auto-compaction).\nFalls back to the thread's currently selected model when not specified.\nIf the configured model is unavailable (provider not registered, model\nnot found), the thread's current model is used instead."
msgstr "Modell für die Kontextkomprimierung (`/compact` und automatische Komprimierung).\nOhne Angabe wird das aktuell im Thread ausgewählte Modell verwendet.\nIst das konfigurierte Modell nicht verfügbar (Anbieter nicht registriert, Modell nicht gefunden), wird stattdessen das aktuelle Modell des Threads verwendet."

msgctxt "settings schema"
msgid "Model to use for generating git commit messages. Defaults to default_model when not specified."
msgstr "Modell, das zum Generieren von Git-Commit-Nachrichten verwendet wird. Verwendet standardmäßig default_model, wenn nichts angegeben ist."

msgctxt "settings schema"
msgid "Model to use for generating thread summaries. Defaults to default_model when not specified."
msgstr "Modell, das zum Generieren von Thread-Zusammenfassungen verwendet wird. Verwendet standardmäßig default_model, wenn nichts angegeben ist."

msgctxt "settings schema"
msgid "Model to use for the inline assistant when streaming tools are enabled.\n\nDefault: true"
msgstr "Modell für den Inline-Assistenten, wenn Streaming-Tools aktiviert sind.\n\nStandard: true"

msgctxt "settings schema"
msgid "Model to use for the inline assistant. Defaults to default_model when not specified."
msgstr "Modell, das für den Inline-Assistenten verwendet wird. Verwendet standardmäßig default_model, wenn nichts angegeben ist."

msgctxt "settings schema"
msgid "Modified version control color."
msgstr "Farbe der Versionskontrolle für Änderungen."

msgctxt "settings schema"
msgid "Most files whose diagnostics are attached with a diagnostics mention.\n\nDefault: 50"
msgstr "Maximale Anzahl Dateien, deren Diagnosen mit einer Diagnose-Erwähnung angehängt werden.\n\nStandard: 50"

msgctxt "settings schema"
msgid "Name to use for this server in UI."
msgstr "Name, der für diesen Server in der UI verwendet wird."

msgctxt "settings schema"
msgid "Never allow training data collection."
msgstr "Erfassung von Trainingsdaten nie erlauben."

msgctxt "settings schema"
msgid "Never blink the cursor, ignoring the terminal mode."
msgstr "Cursor nie blinken lassen, unabhängig vom Terminal-Modus."

msgctxt "settings schema"
msgid "Never fetch or complete document's words for completions.\n(Word-based completions can still be queried via a separate action)"
msgstr "Wörter des Dokuments nie für Vervollständigungen abrufen oder vervollständigen.\n(Wortbasierte Vervollständigungen können weiterhin über eine separate Aktion abgefragt werden)"

msgctxt "settings schema"
msgid "Never hide the mouse cursor"
msgstr "Mauszeiger nie ausblenden"

msgctxt "settings schema"
msgid "Never index the worktree."
msgstr "Den Worktree nie indizieren."

msgctxt "settings schema"
msgid "Never populate the search query"
msgstr "Füllt die Suchanfrage nie aus."

msgctxt "settings schema"
msgid "Never reduce motion"
msgstr "Bewegung nie reduzieren"

msgctxt "settings schema"
msgid "Never show the minimap."
msgstr "Minimap nie anzeigen."

msgctxt "settings schema"
msgid "Never show the scrollbar."
msgstr "Scrollleiste nie anzeigen."

msgctxt "settings schema"
msgid "No automatic indentation. New lines start at column 0."
msgstr "Keine automatische Einrückung. Neue Zeilen beginnen bei Spalte 0."

msgctxt "settings schema"
msgid "Normalize line endings to CRLF (`\\r\\n`) during format and save."
msgstr "Normalisiert Zeilenenden beim Formatieren und Speichern auf CRLF (`\\r\\n`)."

msgctxt "settings schema"
msgid "Normalize line endings to LF (`\\n`) during format and save."
msgstr "Normalisiert Zeilenenden beim Formatieren und Speichern auf LF (`\\n`)."

msgctxt "settings schema"
msgid "Number of lines to search for modelines at the beginning and end of files.\nModelines contain editor directives (e.g., vim/emacs settings) that configure\nthe editor behavior for specific files.\n\nDefault: 5"
msgstr "Anzahl der Zeilen am Anfang und Ende von Dateien, in denen nach Modelines gesucht wird.\nModelines enthalten Editoranweisungen (z. B. Vim-/Emacs-Einstellungen), die das Verhalten des Editors für bestimmte Dateien festlegen.\n\nStandard: 5"

msgctxt "settings schema"
msgid "Ollama model name for edit predictions."
msgstr "Ollama-Modellname für Bearbeitungsvorhersagen."

msgctxt "settings schema"
msgid "One of `sftp`, `scp`, `ftp` or `ftps`. Any other value means SFTP."
msgstr "Einer der Werte `sftp`, `scp`, `ftp` oder `ftps`. Jeder andere Wert bedeutet SFTP."

msgctxt "settings schema"
msgid "Only if LSP response errors or times out,\nuse document's words to show completions."
msgstr "Nur wenn die LSP-Antwort einen Fehler liefert oder eine Zeitüberschreitung auftritt, die Wörter des Dokuments für Vervollständigungen verwenden."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nIf no git diff is available (e.g., when source control is\nunavailable) or if the LSP doesn't support range formatting,\nfalls back to formatting the whole file."
msgstr "Beim Speichern werden nur Zeilen mit nicht gestagten Änderungen formatiert.\nIst kein Git-Diff verfügbar (z. B. wenn keine Versionskontrolle verfügbar ist) oder unterstützt der LSP keine Bereichsformatierung, wird ersatzweise die ganze Datei formatiert."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nRequires source control and LSP range formatting support.\nIf no git diff is available or if the LSP doesn't support\nrange formatting, formatting is skipped."
msgstr "Beim Speichern werden nur Zeilen mit nicht gestagten Änderungen formatiert.\nErfordert Versionskontrolle und Unterstützung der LSP-Bereichsformatierung.\nIst kein Git-Diff verfügbar oder unterstützt der LSP keine Bereichsformatierung, wird die Formatierung übersprungen."

msgctxt "settings schema"
msgid "Only populate the search query when there is text selected."
msgstr "Füllt die Suchanfrage nur aus, wenn Text ausgewählt ist."

msgctxt "settings schema"
msgid "Only rewrap within comments."
msgstr "Neuumbruch nur innerhalb von Kommentaren."

msgctxt "settings schema"
msgid "Only rewrap within the current selection(s)."
msgstr "Neuumbruch nur innerhalb der aktuellen Auswahl(en)."

msgctxt "settings schema"
msgid "Only scan symlinked directories when they've been expanded in the workspace"
msgstr "Symbolisch verknüpfte Verzeichnisse nur scannen, wenn sie im Arbeitsbereich aufgeklappt wurden"

msgctxt "settings schema"
msgid "Only the language server."
msgstr "Nur der Sprachserver."

msgctxt "settings schema"
msgid "Only the symbol index's name matches."
msgstr "Nur die Namensübereinstimmungen des Symbolindex."

msgctxt "settings schema"
msgid "Opacity of inactive panels.\nWhen set to 1.0, the inactive panes have the same opacity as the active one.\nIf set to 0, the inactive panes content will not be visible at all.\nValues are clamped to the [0.0, 1.0] range.\n\nDefault: `1.0`"
msgstr "Deckkraft inaktiver Panels.\nBei 1.0 haben inaktive Bereiche dieselbe Deckkraft wie der aktive.\nBei 0 ist der Inhalt inaktiver Bereiche überhaupt nicht sichtbar.\nWerte werden auf den Bereich [0.0, 1.0] begrenzt.\n\nStandard: `1.0`"

msgctxt "settings schema"
msgid "Opacity of the inactive panes. 0 means transparent, 1 means opaque.\n\nValid range: 0.0 to 1.0\nDefault: 1.0"
msgstr "Deckkraft der inaktiven Bereiche. 0 bedeutet transparent, 1 bedeutet deckend.\n\nGültiger Bereich: 0.0 bis 1.0\nStandard: 1.0"

msgctxt "settings schema"
msgid "Open a single-file diff view."
msgstr "Öffnet eine Diff-Ansicht für eine einzelne Datei."

msgctxt "settings schema"
msgid "Open directories as a new workspace in the current Zed window's sidebar."
msgstr "Öffnet Verzeichnisse als neuen Arbeitsbereich in der Seitenleiste des aktuellen ForgeKairos-Fensters."

msgctxt "settings schema"
msgid "Open paths in a new window unless they are subpaths of an existing project."
msgstr "Öffnet Pfade in einem neuen Fenster, sofern sie keine Unterpfade eines vorhandenen Projekts sind."

msgctxt "settings schema"
msgid "Open projects in a new window."
msgstr "Projekte in einem neuen Fenster öffnen."

msgctxt "settings schema"
msgid "Open projects in the current Zed window."
msgstr "Projekte im aktuellen ForgeKairos-Fenster öffnen."

msgctxt "settings schema"
msgid "Open the excerpt clicked as a new buffer in the new tab, if no `alt` modifier was pressed during double click.\nOtherwise, behave as a regular buffer and select the whole word."
msgstr "Öffnet den angeklickten Auszug als neuen Puffer im neuen Tab, wenn beim Doppelklick keine `alt`-Zusatztaste gedrückt war.\nAndernfalls wie ein normaler Puffer verhalten und das ganze Wort auswählen."

msgctxt "settings schema"
msgid "Open the file in the editor without a diff view."
msgstr "Öffnet die Datei im Editor ohne Diff-Ansicht."

msgctxt "settings schema"
msgid "Open the project diff, showing all changed files."
msgstr "Öffnet den Projekt-Diff und zeigt alle geänderten Dateien an."

msgctxt "settings schema"
msgid "Open the results in a filterable picker."
msgstr "Öffnet die Ergebnisse in einer filterbaren Auswahl."

msgctxt "settings schema"
msgid "Open the results in a multibuffer."
msgstr "Öffnet die Ergebnisse in einem Multibuffer."

msgctxt "settings schema"
msgid "Optional headers to send."
msgstr "Optionale Header zum Senden."

msgctxt "settings schema"
msgid "Options passed to the language server at startup.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Optionen, die beim Start an den Sprachserver übergeben werden.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nWelche Einstellungen unterstützt werden, entnehmen Sie der Dokumentation des jeweiligen Sprachservers."

msgctxt "settings schema"
msgid "Override this model with a different Anthropic model for tool calls."
msgstr "Dieses Modell für Toolaufrufe durch ein anderes Anthropic-Modell ersetzen."

msgctxt "settings schema"
msgid "Overrides per theme\n\nThese values will override the ones on the specified theme"
msgstr "Überschreibungen pro Design\n\nDiese Werte überschreiben die des angegebenen Designs"

msgctxt "settings schema"
msgid "Overrides the context length reported for every llama.cpp model."
msgstr "Überschreibt die von llama.cpp für jedes Modell gemeldete Kontextlänge."

msgctxt "settings schema"
msgid "Panel stacked beside it, or `none` for a single panel as upstream Zed\nshows.\n\nDefault: browser"
msgstr "Daneben gestapeltes Panel, oder `none` für ein einzelnes Panel wie im Upstream-Zed.\n\nStandard: browser"

msgctxt "settings schema"
msgid "Panel that fills that dock, or `none` to leave the dock as it was.\n\nDefault: agent"
msgstr "Panel, das dieses Dock füllt, oder `none`, um das Dock unverändert zu lassen.\n\nStandard: agent"

msgctxt "settings schema"
msgid "Per-tool permission rules for granular control over which tool actions\nrequire confirmation.\n\nThe global `default` applies when no tool-specific rules match.\nFor external agent servers (e.g. Claude Agent) that define their own\npermission modes, \"deny\" and \"confirm\" still take precedence — the\nexternal agent's permission system is only used when Zed would allow\nthe action. Per-tool regex patterns (`always_allow`, `always_deny`,\n`always_confirm`) match against the tool's text input (command, path,\nURL, etc.)."
msgstr "Tool-spezifische Berechtigungsregeln zur feinen Steuerung, welche Tool-Aktionen eine Bestätigung erfordern.\n\nDer globale Wert `default` gilt, wenn keine toolspezifischen Regeln zutreffen.\nFür externe Agent-Server (z. B. Claude Agent), die eigene Berechtigungsmodi definieren, haben \"deny\" und \"confirm\" weiterhin Vorrang — das Berechtigungssystem des externen Agenten wird nur verwendet, wenn ForgeKairos die Aktion zulassen würde. Tool-spezifische Regex-Muster (`always_allow`, `always_deny`, `always_confirm`) werden mit der Texteingabe des Tools (Befehl, Pfad, URL usw.) abgeglichen."

msgctxt "settings schema"
msgid "Per-tool permission rules.\nKeys are tool names (e.g. terminal, edit_file, fetch) including MCP\ntools (e.g. mcp:server_name:tool_name). Any tool name is accepted;\neven tools without meaningful text input can have a `default` set."
msgstr "Tool-spezifische Berechtigungsregeln.\nSchlüssel sind Toolnamen (z. B. terminal, edit_file, fetch) einschließlich MCP-Tools (z. B. mcp:server_name:tool_name). Jeder Toolname wird akzeptiert; auch Tools ohne sinnvolle Texteingabe können einen `default` haben."

msgctxt "settings schema"
msgid "Persistent sandbox permission grants for agent-run terminal commands.\nThese are populated when choosing \"Allow always\" from a sandbox\nescalation prompt."
msgstr "Dauerhafte Sandbox-Berechtigungen für vom Agenten ausgeführte Terminalbefehle.\nSie werden gefüllt, wenn in einer Abfrage zur Rechteerweiterung der Sandbox „Immer zulassen“ gewählt wird."

msgctxt "settings schema"
msgid "Place snippets at the bottom of the completion list"
msgstr "Snippets am Ende der Vervollständigungsliste platzieren"

msgctxt "settings schema"
msgid "Place snippets at the top of the completion list"
msgstr "Snippets am Anfang der Vervollständigungsliste platzieren"

msgctxt "settings schema"
msgid "Play an OS-specific alert sound."
msgstr "Einen betriebssystemspezifischen Alarmton abspielen."

msgctxt "settings schema"
msgid "Position of the close button in a tab.\n\nDefault: right"
msgstr "Position der Schließen-Schaltfläche in einem Tab.\n\nStandard: right"

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for MCP servers that don't support\nDynamic Client Registration."
msgstr "Vorab registrierte OAuth-Client-Anmeldedaten für MCP-Server, die Dynamic Client Registration nicht unterstützen."

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for authorization servers that\nrequire out-of-band client registration."
msgstr "Vorab registrierte OAuth-Client-Anmeldedaten für Autorisierungsserver, die eine Out-of-Band-Clientregistrierung erfordern."

msgctxt "settings schema"
msgid "Prefer a single line generally, unless an overly long line is encountered."
msgstr "Im Allgemeinen eine einzelne Zeile bevorzugen, sofern keine übermäßig lange Zeile auftritt."

msgctxt "settings schema"
msgid "Preferred Conda manager to use when activating Conda environments.\n\nDefault: auto"
msgstr "Bevorzugter Conda-Manager zum Aktivieren von Conda-Umgebungen.\n\nStandard: auto"

msgctxt "settings schema"
msgid "Preferred debuggers for this language.\n\nDefault: []"
msgstr "Bevorzugte Debugger für diese Sprache.\n\nStandard: []"

msgctxt "settings schema"
msgid "Preserve the cursor's vertical position within the viewport, falling\nback to centering when the cursor is offscreen."
msgstr "Behält die vertikale Position des Cursors im sichtbaren Bereich bei und zentriert ersatzweise, wenn der Cursor außerhalb des Bildschirms liegt."

msgctxt "settings schema"
msgid "Preserve the existing line endings of the file. New files use the\nplatform default line ending."
msgstr "Behält die vorhandenen Zeilenenden der Datei bei. Neue Dateien verwenden das Standard-Zeilenende der Plattform."

msgctxt "settings schema"
msgid "Preserve the indentation of the current line when creating new lines,\nbut don't adjust based on syntax context."
msgstr "Behält beim Erstellen neuer Zeilen die Einrückung der aktuellen Zeile bei, passt sie aber nicht anhand des Syntaxkontexts an."

msgctxt "settings schema"
msgid "Pure Unicode codepoint comparison. No case folding, no natural number sorting.\nUppercase ASCII sorts before lowercase. Accented characters sort after ASCII."
msgstr "Reiner Vergleich der Unicode-Codepoints. Keine Angleichung von Groß-/Kleinschreibung, keine natürliche Zahlensortierung.\nASCII-Großbuchstaben werden vor Kleinbuchstaben einsortiert. Zeichen mit Akzent werden nach ASCII einsortiert."

msgctxt "settings schema"
msgid "Quit the application the last window is closed"
msgstr "Anwendung beenden, wenn das letzte Fenster geschlossen wird"

msgctxt "settings schema"
msgid "Read-access of a symbol, like reading a variable.\n\nA document highlight is a range inside a text document which deserves\nspecial attention. Usually a document highlight is visualized by changing\nthe background color of its range."
msgstr "Lesezugriff auf ein Symbol, etwa das Lesen einer Variablen.\n\nEine Dokumenthervorhebung ist ein Bereich in einem Textdokument, der besondere Aufmerksamkeit verdient. Üblicherweise wird sie durch Ändern der Hintergrundfarbe ihres Bereichs dargestellt."

msgctxt "settings schema"
msgid "Red ANSI terminal color."
msgstr "Rote ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Regexes for inputs that must always prompt.\nTakes precedence over always_allow but not always_deny.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Regex-Ausdrücke für Eingaben, die immer eine Abfrage erfordern.\nHat Vorrang vor always_allow, aber nicht vor always_deny.\nBei `copy_path` und `move_path` werden die Muster unabhängig mit jedem Pfad (Quelle und Ziel) abgeglichen.\nMuster sammeln sich über die Einstellungsebenen (Benutzer, Projekt, Profil) an und können von einer Ebene mit höherer Priorität nicht entfernt werden — es können nur neue Muster hinzugefügt werden.\nStandard: []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-approve.\nFor terminal: matches command. For file tools: matches path. For fetch: matches URL.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Regex-Ausdrücke für Eingaben, die automatisch genehmigt werden.\nFür terminal: gleicht den Befehl ab. Für Datei-Tools: gleicht den Pfad ab. Für fetch: gleicht die URL ab.\nBei `copy_path` und `move_path` werden die Muster unabhängig mit jedem Pfad (Quelle und Ziel) abgeglichen.\nMuster sammeln sich über die Einstellungsebenen (Benutzer, Projekt, Profil) an und können von einer Ebene mit höherer Priorität nicht entfernt werden — es können nur neue Muster hinzugefügt werden.\nStandard: []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-reject.\n**SECURITY**: These take precedence over ALL other rules, across ALL settings layers.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Regex-Ausdrücke für Eingaben, die automatisch abgelehnt werden.\n**SICHERHEIT**: Diese haben Vorrang vor ALLEN anderen Regeln, über ALLE Einstellungsebenen hinweg.\nBei `copy_path` und `move_path` werden die Muster unabhängig mit jedem Pfad (Quelle und Ziel) abgeglichen.\nMuster sammeln sich über die Einstellungsebenen (Benutzer, Projekt, Profil) an und können von einer Ebene mit höherer Priorität nicht entfernt werden — es können nur neue Muster hinzugefügt werden.\nStandard: []"

msgctxt "settings schema"
msgid "Regexes used to identify paths for hyperlink navigation.\n\nDefault:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUse `\"...\"` to add regexes without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list. Set `[]` to clear it. Omitting this\nsetting keeps the inherited list.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nInherited regexes are inserted at `\"...\"`, and duplicates keep their first\noccurrence. Regexes are duplicates when their text is identical after\njoining multiline entries with newlines.\n\nEach regex can be a single string or an array of strings joined with\nnewlines. The marker is recognized only as a top-level string. To use\n`...` as a regex matching three characters, write `[\"...\"]` as an entry.\nA `\"...\"` line inside a multiline entry is always regex text.\n\nThe optional named capture `path` selects the hyperlink target. Without\nit, the entire match is the target. With `path`, `line` and `column`\nspecify the position. Without a captured `line`, built-in suffix\nprocessing parses `line:column` and `(line,column)` variants. The optional\n`link` capture selects the clickable text, otherwise the entire match is\nclickable.\n\nProcessing stops at the first regex that matches the terminal line, even\nif the cursor is outside its clickable text. Put more specific regexes\nbefore broader ones. Regexes use Rust's `regex` syntax. Invalid regexes\nare logged and ignored. The `path_hyperlink_timeout_ms` setting controls\nthe discovery timeout. Setting it to `0` disables path hyperlinks."
msgstr "Regex-Ausdrücke zum Erkennen von Pfaden für die Hyperlink-Navigation.\n\nStandard:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nVerwenden Sie `\"...\"`, um Regex-Ausdrücke hinzuzufügen, ohne die Standardwerte von ForgeKairos zu wiederholen. In Projekteinstellungen wird damit der Wert der Benutzer- oder übergeordneten Konfiguration erweitert. Lassen Sie `\"...\"` weg, um die geerbte Liste zu ersetzen. Setzen Sie `[]`, um sie zu leeren. Wird diese Einstellung weggelassen, bleibt die geerbte Liste erhalten.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nGeerbte Regex-Ausdrücke werden an der Stelle von `\"...\"` eingefügt, und bei Duplikaten bleibt das erste Vorkommen erhalten. Regex-Ausdrücke gelten als Duplikate, wenn ihr Text nach dem Verbinden mehrzeiliger Einträge mit Zeilenumbrüchen identisch ist.\n\nJeder Regex-Ausdruck kann eine einzelne Zeichenfolge oder ein Array von Zeichenfolgen sein, die mit Zeilenumbrüchen verbunden werden. Die Markierung wird nur als Zeichenfolge auf oberster Ebene erkannt. Um `...` als Regex-Ausdruck zu verwenden, der drei Zeichen abgleicht, schreiben Sie `[\"...\"]` als Eintrag.\nEine Zeile `\"...\"` innerhalb eines mehrzeiligen Eintrags ist immer Regex-Text.\n\nDie optionale benannte Erfassung `path` wählt das Ziel des Hyperlinks. Ohne sie ist der gesamte Treffer das Ziel. Mit `path` geben `line` und `column` die Position an. Ohne erfasstes `line` wertet die integrierte Suffixverarbeitung die Varianten `line:column` und `(line,column)` aus. Die optionale Erfassung `link` wählt den anklickbaren Text, andernfalls ist der gesamte Treffer anklickbar.\n\nDie Verarbeitung endet beim ersten Regex-Ausdruck, der auf die Terminalzeile passt, selbst wenn der Cursor außerhalb seines anklickbaren Texts liegt. Stellen Sie spezifischere Regex-Ausdrücke vor allgemeinere. Regex-Ausdrücke verwenden die `regex`-Syntax von Rust. Ungültige Regex-Ausdrücke werden protokolliert und ignoriert. Die Einstellung `path_hyperlink_timeout_ms` steuert das Zeitlimit für die Erkennung. Der Wert `0` deaktiviert Pfad-Hyperlinks."

msgctxt "settings schema"
msgid "Renamed version control color."
msgstr "Farbe für umbenannte Versionskontrolldateien."

msgctxt "settings schema"
msgid "Render document colors as inlay hints near the color text."
msgstr "Rendert Dokumentfarben als Inlay-Hinweise in der Nähe des Farbtexts."

msgctxt "settings schema"
msgid "Replaces text before and after the cursor, using the `replace` range described in the LSP specification."
msgstr "Ersetzt Text vor und nach dem Cursor mithilfe des in der LSP-Spezifikation beschriebenen `replace`-Bereichs."

msgctxt "settings schema"
msgid "Replaces text before the cursor, using the `insert` range described in the LSP specification."
msgstr "Ersetzt Text vor dem Cursor mithilfe des in der LSP-Spezifikation beschriebenen `insert`-Bereichs."

msgctxt "settings schema"
msgid "Replaces the grid with the text in the same tab."
msgstr "Ersetzt das Raster im selben Tab durch den Text."

msgctxt "settings schema"
msgid "Represents a hidden status, such as a file being hidden in a file tree."
msgstr "Stellt einen ausgeblendeten Status dar, z. B. eine Datei, die in einem Dateibaum ausgeblendet ist."

msgctxt "settings schema"
msgid "Represents a renamed status, such as a file that has been renamed."
msgstr "Stellt einen umbenannten Status dar, z. B. eine Datei, die umbenannt wurde."

msgctxt "settings schema"
msgid "Represents a warning status, like an operation that is about to fail."
msgstr "Stellt einen Warnstatus dar, z. B. einen Vorgang, der kurz vor dem Fehlschlagen steht."

msgctxt "settings schema"
msgid "Represents informational status updates or messages."
msgstr "Stellt informative Statusaktualisierungen oder Nachrichten dar."

msgctxt "settings schema"
msgid "Represents the selection of a theme, which can be either static or dynamic."
msgstr "Stellt die Auswahl eines Designs dar, das entweder statisch oder dynamisch sein kann."

msgctxt "settings schema"
msgid "Represents the selection of an icon theme, which can be either static or dynamic."
msgstr "Stellt die Auswahl eines Symboldesigns dar, das entweder statisch oder dynamisch sein kann."

msgctxt "settings schema"
msgid "Resize the window to cover the entire screen, including the menu bar and,\non notched displays, the area around the notch."
msgstr "Passt die Fenstergröße so an, dass der gesamte Bildschirm bedeckt wird, einschließlich der Menüleiste und bei Displays mit Notch des Bereichs um die Notch."

msgctxt "settings schema"
msgid "Restart clangd when its resident memory, measured every 30 seconds,\ngoes over this many megabytes. At most one restart every 10 minutes;\nafter that, a notification only. Unset never restarts. Read from the\nuser's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Startet clangd neu, wenn sein residenter Speicher, alle 30 Sekunden gemessen, so viele Megabyte überschreitet. Höchstens ein Neustart alle 10 Minuten; danach nur eine Benachrichtigung. Nicht gesetzt startet nie neu. Wird nur aus den Benutzereinstellungen gelesen, nicht aus der `.zed/settings.json` eines Projekts.\n\nStandard: null"

msgctxt "settings schema"
msgid "Restore all workspaces that were open when quitting Zed."
msgstr "Alle Arbeitsbereiche wiederherstellen, die beim Beenden von ForgeKairos geöffnet waren."

msgctxt "settings schema"
msgid "Restore the workspace that was closed last."
msgstr "Den zuletzt geschlossenen Arbeitsbereich wiederherstellen."

msgctxt "settings schema"
msgid "Rules for rendering LSP semantic tokens."
msgstr "Regeln zum Rendern semantischer LSP-Token."

msgctxt "settings schema"
msgid "Save after inactivity period of `milliseconds`."
msgstr "Speichert nach einer Inaktivitätsperiode von `milliseconds`."

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier for fast scrolling. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling. Fast scrolling\nhappens when a user holds the alt or option key while scrolling.\n\nDefault: 4.0"
msgstr "Multiplikator der Scrollempfindlichkeit für schnelles Scrollen. Dieser Multiplikator wird beim Scrollen auf die horizontalen und vertikalen Deltawerte angewendet. Schnelles Scrollen erfolgt, wenn der Benutzer beim Scrollen die Alt- bzw. Option-Taste gedrückt hält.\n\nStandard: 4.0"

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling.\n\nDefault: 1.0"
msgstr "Multiplikator der Scrollempfindlichkeit. Dieser Multiplikator wird beim Scrollen auf die horizontalen und vertikalen Deltawerte angewendet.\n\nStandard: 1.0"

msgctxt "settings schema"
msgid "Scroll so the target appears near the top of the viewport."
msgstr "Scrollt so, dass das Ziel nahe dem oberen Rand des Ansichtsbereichs erscheint."

msgctxt "settings schema"
msgid "Scroll the minimum amount needed to make the target visible."
msgstr "Scrollt nur so weit wie nötig, um das Ziel sichtbar zu machen."

msgctxt "settings schema"
msgid "Scrollbar related settings"
msgstr "Einstellungen zur Scrollleiste"

msgctxt "settings schema"
msgid "Scrollbar-related settings"
msgstr "Einstellungen zur Scrollleiste"

msgctxt "settings schema"
msgid "Select specific input audio device."
msgstr "Bestimmtes Audioeingabegerät auswählen."

msgctxt "settings schema"
msgid "Select specific output audio device."
msgstr "Bestimmtes Audioausgabegerät auswählen."

msgctxt "settings schema"
msgid "Send anonymized usage data like what languages you're using Zed with.\n\nDefault: true"
msgstr "Sendet anonymisierte Nutzungsdaten, etwa mit welchen Sprachen Sie ForgeKairos verwenden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Send debug info like crash reports.\n\nDefault: true"
msgstr "Sendet Debuginformationen wie Absturzberichte.\n\nStandard: true"

msgctxt "settings schema"
msgid "Session log (TeraTerm-style output recording) settings."
msgstr "Einstellungen für das Sitzungsprotokoll (Aufzeichnung der Ausgabe im Stil von TeraTerm)."

msgctxt "settings schema"
msgid "Sets the cursor blinking behavior in the terminal.\n\nDefault: terminal_controlled"
msgstr "Legt das Blinkverhalten des Cursors im Terminal fest.\n\nStandard: terminal_controlled"

msgctxt "settings schema"
msgid "Sets the debounce threshold (in milliseconds) after which changes are reflected in the git gutter.\n\nDefault: 0"
msgstr "Legt die Entprellungsschwelle (in Millisekunden) fest, nach der Änderungen in der Git-Randleiste angezeigt werden.\n\nStandard: 0"

msgctxt "settings schema"
msgid "Sets the terminal's font fallbacks.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font fallbacks."
msgstr "Legt die Ersatzschriftarten des Terminals fest.\n\nIst diese Option nicht angegeben, übernimmt das Terminal standardmäßig die Ersatzschriftarten des Puffers."

msgctxt "settings schema"
msgid "Sets the terminal's font family.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font family."
msgstr "Legt die Schriftfamilie des Terminals fest.\n\nIst diese Option nicht angegeben, übernimmt das Terminal standardmäßig die Schriftfamilie des Puffers."

msgctxt "settings schema"
msgid "Sets the terminal's font size.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font size."
msgstr "Legt die Schriftgröße des Terminals fest.\n\nIst diese Option nicht angegeben, übernimmt das Terminal standardmäßig die Schriftgröße des Puffers."

msgctxt "settings schema"
msgid "Sets the terminal's font weight in CSS weight units 0-900."
msgstr "Legt die Schriftstärke des Terminals in CSS-Gewichtseinheiten (0–900) fest."

msgctxt "settings schema"
msgid "Sets the terminal's line height.\n\nDefault: comfortable"
msgstr "Legt die Zeilenhöhe des Terminals fest.\n\nStandard: comfortable"

msgctxt "settings schema"
msgid "Sets whether Alternate Scroll mode (code: ?1007) is active by default.\nAlternate Scroll mode converts mouse scroll events into up / down key\npresses when in the alternate screen (e.g. when running applications\nlike vim or  less). The terminal can still set and unset this mode.\n\nDefault: on"
msgstr "Legt fest, ob der Alternate-Scroll-Modus (Code: ?1007) standardmäßig aktiv ist.\nDer Alternate-Scroll-Modus wandelt Mausscroll-Ereignisse im alternativen Bildschirm (z. B. beim Ausführen von Anwendungen wie vim oder less) in Tastendrücke nach oben / unten um. Das Terminal kann diesen Modus weiterhin setzen und aufheben.\n\nStandard: on"

msgctxt "settings schema"
msgid "Sets whether the option key behaves as the meta key.\n\nDefault: false"
msgstr "Legt fest, ob sich die Option-Taste wie die Meta-Taste verhält.\n\nStandard: false"

msgctxt "settings schema"
msgid "Settings for associating file extensions and filenames\nwith languages."
msgstr "Einstellungen zum Zuordnen von Dateierweiterungen und Dateinamen zu Sprachen."

msgctxt "settings schema"
msgid "Settings for automatic agent context compaction, which summarizes\nearlier messages to free up room in the model's context window once the\ncontext grows too large."
msgstr "Einstellungen für die automatische Komprimierung des Agent-Kontexts, die frühere Nachrichten zusammenfasst, um im Kontextfenster des Modells Platz zu schaffen, sobald der Kontext zu groß wird."

msgctxt "settings schema"
msgid "Settings for automatically opening files."
msgstr "Einstellungen zum automatischen Öffnen von Dateien."

msgctxt "settings schema"
msgid "Settings for configuring REPL display and behavior."
msgstr "Einstellungen zur Konfiguration der REPL-Anzeige und des REPL-Verhaltens."

msgctxt "settings schema"
msgid "Settings for configuring the which-key popup behaviour."
msgstr "Einstellungen zur Konfiguration des Which-Key-Popup-Verhaltens."

msgctxt "settings schema"
msgid "Settings for context servers used for AI-related features."
msgstr "Einstellungen für Kontextserver, die für KI-bezogene Funktionen verwendet werden."

msgctxt "settings schema"
msgid "Settings for developer-oriented instrumentation tools (profilers,\ntracers, etc.) that can be toggled at runtime."
msgstr "Einstellungen für entwicklerorientierte Instrumentierungstools (Profiler, Tracer usw.), die zur Laufzeit umgeschaltet werden können."

msgctxt "settings schema"
msgid "Settings for language server notifications"
msgstr "Einstellungen für Sprachserver-Benachrichtigungen"

msgctxt "settings schema"
msgid "Settings for showing inline diagnostics."
msgstr "Einstellungen zur Anzeige von Inline-Diagnosen."

msgctxt "settings schema"
msgid "Settings for sticking scopes to the top of the editor.\n\nDefault: sticky scroll is disabled"
msgstr "Einstellungen zum Fixieren von Bereichen am oberen Rand des Editors.\n\nStandard: Fixierter Bildlauf ist deaktiviert"

msgctxt "settings schema"
msgid "Settings for tabular files such as CSV and TSV."
msgstr "Einstellungen für Tabellendateien wie CSV und TSV."

msgctxt "settings schema"
msgid "Settings for the built-in IDE server.\n\nThe server binds a random port on `127.0.0.1` only and never talks to the\nnetwork, so it is outside the scope of the egress allowlist."
msgstr "Einstellungen für den integrierten IDE-Server.\n\nDer Server bindet nur einen zufälligen Port auf `127.0.0.1` und kommuniziert nie mit dem Netzwerk; daher liegt er außerhalb der Zulassungsliste für ausgehende Verbindungen."

msgctxt "settings schema"
msgid "Settings for the built-in browser panel."
msgstr "Einstellungen für das integrierte Browser-Panel."

msgctxt "settings schema"
msgid "Settings for the built-in loopback IDE server."
msgstr "Einstellungen für den integrierten Loopback-IDE-Server."

msgctxt "settings schema"
msgid "Settings for the machine a remote project runs on, as opposed to the\nlists of connections next to them. Written under `\"remote\"` in\n`settings.json`, and carried to the remote host with the rest of the user\nsettings, which is where they take effect."
msgstr "Einstellungen für den Computer, auf dem ein Remote-Projekt läuft, im Gegensatz zu den Verbindungslisten daneben. Werden unter `\"remote\"` in `settings.json` geschrieben und mit den übrigen Benutzereinstellungen zum Remote-Host übertragen, wo sie wirken."

msgctxt "settings schema"
msgid "Settings for the threads sidebar."
msgstr "Einstellungen für die Thread-Seitenleiste."

msgctxt "settings schema"
msgid "Settings for the which-key popup."
msgstr "Einstellungen für das Which-Key-Popup."

msgctxt "settings schema"
msgid "Settings for using LSP pull diagnostics mechanism in Zed."
msgstr "Einstellungen für die Verwendung des LSP-Pull-Diagnosemechanismus in ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to Vim mode in Zed."
msgstr "Einstellungen zum Vim-Modus in ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to indent guides in the outline panel."
msgstr "Einstellungen für Einzugsführungslinien im Gliederungspanel."

msgctxt "settings schema"
msgid "Settings related to indent guides in the project panel."
msgstr "Einstellungen für Einzugsführungslinien im Projektpanel."

msgctxt "settings schema"
msgid "Settings related to the command palette."
msgstr "Einstellungen für die Befehlspalette."

msgctxt "settings schema"
msgid "Settings related to the file finder."
msgstr "Einstellungen für die Dateisuche."

msgctxt "settings schema"
msgid "Settings specific to Codestral."
msgstr "Einstellungen speziell für Codestral."

msgctxt "settings schema"
msgid "Settings specific to GitHub Copilot."
msgstr "Einstellungen speziell für GitHub Copilot."

msgctxt "settings schema"
msgid "Settings specific to Ollama."
msgstr "Einstellungen speziell für Ollama."

msgctxt "settings schema"
msgid "Settings specific to Zed's Edit Predictions provider."
msgstr "Einstellungen speziell für Zed als Anbieter für Bearbeitungsvorhersagen."

msgctxt "settings schema"
msgid "Settings specific to journaling"
msgstr "Einstellungen für das Journal"

msgctxt "settings schema"
msgid "Settings specific to the Mercury Edit Predictions provider."
msgstr "Einstellungen speziell für Mercury als Anbieter für Bearbeitungsvorhersagen."

msgctxt "settings schema"
msgid "Settings specific to using custom OpenAI-compatible servers for edit prediction."
msgstr "Einstellungen für die Verwendung benutzerdefinierter OpenAI-kompatibler Server zur Bearbeitungsvorhersage."

msgctxt "settings schema"
msgid "Settings that apply to the host a remote project runs on."
msgstr "Einstellungen, die für den Host gelten, auf dem ein Remote-Projekt läuft."

msgctxt "settings schema"
msgid "Settings-layer–free model mode enum.\n\nMirrors the shape of `settings_content::ModelMode` but lives here so that\ncrates below the settings layer can reference it."
msgstr "Enum für den Modellmodus ohne Abhängigkeit von der Einstellungsebene.\n\nEntspricht der Form von `settings_content::ModelMode`, liegt aber hier, damit Crates unterhalb der Einstellungsebene darauf verweisen können."

msgctxt "settings schema"
msgid "Settings-layer–free reasoning-effort enum.\n\nMirrors the shape of `settings_content::OpenAiReasoningEffort` but lives\nhere so that crates below the settings layer can reference it."
msgstr "Enum für den Denkaufwand ohne Abhängigkeit von der Einstellungsebene.\n\nEntspricht der Form von `settings_content::OpenAiReasoningEffort`, liegt aber hier, damit Crates unterhalb der Einstellungsebene darauf verweisen können."

msgctxt "settings schema"
msgid "Shell configuration to open the terminal with."
msgstr "Shell-Konfiguration zum Öffnen des Terminals."

msgctxt "settings schema"
msgid "Show a disclosure chevron followed by a folder icon."
msgstr "Zeigt einen Aufklapppfeil gefolgt von einem Ordnersymbol an."

msgctxt "settings schema"
msgid "Show a disclosure chevron."
msgstr "Zeigt einen Aufklapppfeil an."

msgctxt "settings schema"
msgid "Show a folder icon."
msgstr "Zeigt ein Ordnersymbol an."

msgctxt "settings schema"
msgid "Show all diagnostic levels: hint, information, warnings, error."
msgstr "Zeigt alle Diagnosestufen an: Hinweis, Information, Warnungen, Fehler."

msgctxt "settings schema"
msgid "Show an empty untitled buffer when opening a new window"
msgstr "Einen leeren unbenannten Puffer beim Öffnen eines neuen Fensters anzeigen"

msgctxt "settings schema"
msgid "Show diffs in a single unified view."
msgstr "Zeigt Diffs in einer einzigen einheitlichen Ansicht an."

msgctxt "settings schema"
msgid "Show diffs in a split view."
msgstr "Zeigt Diffs in einer geteilten Ansicht an."

msgctxt "settings schema"
msgid "Show directories first, then files"
msgstr "Verzeichnisse zuerst anzeigen, dann Dateien"

msgctxt "settings schema"
msgid "Show file name first, then path"
msgstr "Dateinamen zuerst anzeigen, dann Pfad"

msgctxt "settings schema"
msgid "Show files first, then directories"
msgstr "Zuerst Dateien, dann Verzeichnisse anzeigen"

msgctxt "settings schema"
msgid "Show full path first"
msgstr "Zuerst vollständigen Pfad anzeigen"

msgctxt "settings schema"
msgid "Show git blame in the status bar at the bottom of the window."
msgstr "Zeigt Git-Blame in der Statusleiste am unteren Fensterrand an."

msgctxt "settings schema"
msgid "Show git blame inline at the current line."
msgstr "Zeigt Git-Blame inline an der aktuellen Zeile an."

msgctxt "settings schema"
msgid "Show git gutter in tracked files."
msgstr "Git-Randleiste in verfolgten Dateien anzeigen."

msgctxt "settings schema"
msgid "Show on all open editors."
msgstr "In allen geöffneten Editoren anzeigen."

msgctxt "settings schema"
msgid "Show only the following diagnostic level: error."
msgstr "Nur die folgende Diagnosestufe anzeigen: Fehler."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: information, warning, error."
msgstr "Nur die folgenden Diagnosestufen anzeigen: Informationen, Warnung, Fehler."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: warning, error."
msgstr "Nur die folgenden Diagnosestufen anzeigen: Warnung, Fehler."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects (no tabs)."
msgstr "Launchpad mit zuletzt verwendeten Projekten anzeigen (ohne Tabs)."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects when opening a new window"
msgstr "Das Launchpad mit zuletzt verwendeten Projekten beim Öffnen eines neuen Fensters anzeigen"

msgctxt "settings schema"
msgid "Show the minimap on the active editor only."
msgstr "Minimap nur im aktiven Editor anzeigen."

msgctxt "settings schema"
msgid "Show the minimap thumb only when the mouse is hovering over the minimap."
msgstr "Minimap-Regler nur anzeigen, wenn sich der Mauszeiger über der Minimap befindet."

msgctxt "settings schema"
msgid "Show the scrollbar if there's important information or\nfollow the system's configured behavior."
msgstr "Die Scrollleiste anzeigen, wenn wichtige Informationen vorliegen, oder dem im System konfigurierten Verhalten folgen."

msgctxt "settings schema"
msgid "Show unstaged hunks hollow and staged hunks with a filled background."
msgstr "Nicht gestagte Hunks umrandet und gestagte Hunks mit gefülltem Hintergrund anzeigen."

msgctxt "settings schema"
msgid "Show unstaged hunks with a filled background and staged hunks hollow."
msgstr "Nicht gestagte Hunks mit gefülltem Hintergrund und gestagte Hunks umrandet anzeigen."

msgctxt "settings schema"
msgid "Size of the border surrounding the active pane.\nWhen set to 0, the active pane doesn't have any border.\nThe border is drawn inset.\n\nDefault: `0.0`"
msgstr "Stärke des Rahmens um den aktiven Bereich.\nBei 0 hat der aktive Bereich keinen Rahmen.\nDer Rahmen wird nach innen gezeichnet.\n\nStandard: `0.0`"

msgctxt "settings schema"
msgid "Soft wrap line at the preferred line length or the editor width (whichever is smaller)."
msgstr "Bricht Zeilen bei der bevorzugten Zeilenlänge oder der Editor-Breite um (je nachdem, welcher Wert kleiner ist)."

msgctxt "settings schema"
msgid "Soft wrap lines that exceed the editor width."
msgstr "Bricht Zeilen um, die die Editor-Breite überschreiten."

msgctxt "settings schema"
msgid "Sort snippets normally using the default comparison logic"
msgstr "Snippets normal gemäß der Standard-Vergleichslogik sortieren"

msgctxt "settings schema"
msgid "Spacing between worktree entries in the project panel.\n\nDefault: comfortable"
msgstr "Abstand zwischen Worktree-Einträgen im Projektpanel.\n\nStandard: comfortable"

msgctxt "settings schema"
msgid "Specifies the density of the UI.\nNote: This setting is still experimental. See [this tracking issue](https://github.com/zed-industries/zed/issues/18078)"
msgstr "Legt die Dichte der Oberfläche fest.\nHinweis: Diese Einstellung ist noch experimentell. Siehe [dieses Tracking-Issue](https://github.com/zed-industries/zed/issues/18078)"

msgctxt "settings schema"
msgid "Start searching as you type in project search, without pressing Enter."
msgstr "Startet die Suche in der Projektsuche bereits beim Tippen, ohne Enter zu drücken."

msgctxt "settings schema"
msgid "Sticky scroll related settings"
msgstr "Einstellungen für den fixierten Bildlauf"

msgctxt "settings schema"
msgid "String substituted for `${separator}` in the window title format.\nInclude any surrounding whitespace in the value.\n\nDefault: ` — `"
msgstr "Zeichenfolge, die im Format des Fenstertitels für `${separator}` eingesetzt wird.\nSchließen Sie umgebenden Leerraum in den Wert ein.\n\nStandard: ` — `"

msgctxt "settings schema"
msgid "Suggesting and installing missing development tools."
msgstr "Vorschlagen und Installieren fehlender Entwicklungstools."

msgctxt "settings schema"
msgid "Suggestions of the development tools (language servers, formatters) that\nthe language of an opened file needs, when they are missing."
msgstr "Vorschläge für die Entwicklungstools (Sprachserver, Formatierer), die die Sprache einer geöffneten Datei benötigt, wenn sie fehlen."

msgctxt "settings schema"
msgid "Supported reasoning effort levels, for example `[\"low\", \"medium\", \"high\"]."
msgstr "Unterstützte Stufen für den Denkaufwand, zum Beispiel `[\"low\", \"medium\", \"high\"]."

msgctxt "settings schema"
msgid "TODO: this should just be a bool\nControls the behavior of formatting files when they are saved."
msgstr "TODO: this should just be a bool\nSteuert, wie Dateien beim Speichern formatiert werden."

msgctxt "settings schema"
msgid "Takes up the full width of the window"
msgstr "Nimmt die gesamte Breite des Fensters ein"

msgctxt "settings schema"
msgid "Task configuration for this language.\n\nDefault: {}"
msgstr "Aufgabenkonfiguration für diese Sprache.\n\nStandard: {}"

msgctxt "settings schema"
msgid "Terminal ANSI background color."
msgstr "ANSI-Hintergrundfarbe des Terminals."

msgctxt "settings schema"
msgid "Terminal background color."
msgstr "Hintergrundfarbe des Terminals."

msgctxt "settings schema"
msgid "Terminal foreground color."
msgstr "Vordergrundfarbe des Terminals."

msgctxt "settings schema"
msgid "Text Color. Color of muted or deemphasized text. It is a subdued version of the standard text color."
msgstr "Textfarbe. Farbe von gedämpftem oder weniger betontem Text. Eine abgeschwächte Variante der Standardtextfarbe."

msgctxt "settings schema"
msgid "Text Color. Color of the placeholder text typically shown in input fields to guide the user to enter valid data."
msgstr "Textfarbe. Farbe des Platzhaltertexts, der typischerweise in Eingabefeldern angezeigt wird, um die Eingabe gültiger Daten zu unterstützen."

msgctxt "settings schema"
msgid "Text Color. Color used for emphasis or highlighting certain text, like an active filter or a matched character in a search."
msgstr "Textfarbe. Farbe zur Hervorhebung bestimmter Texte, z. B. ein aktiver Filter oder ein übereinstimmendes Zeichen in einer Suche."

msgctxt "settings schema"
msgid "Text Color. Color used for text denoting disabled elements. Typically, the color is faded or grayed out to emphasize the disabled state."
msgstr "Textfarbe. Farbe für Text, der deaktivierte Elemente kennzeichnet. In der Regel ausgeblendet oder ausgegraut, um den deaktivierten Zustand zu betonen."

msgctxt "settings schema"
msgid "Text Color. Default text color used for most text."
msgstr "Textfarbe. Standardtextfarbe für den größten Teil des Textes."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is highlighted."
msgstr "Textfarbe. Wird für den Text der Zeilennummer in der Editor-Randleiste verwendet, wenn die Zeile hervorgehoben ist."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is hovered over."
msgstr "Textfarbe. Wird für den Text der Zeilennummer in der Editor-Randleiste verwendet, wenn die Zeile mit dem Mauszeiger überfahren wird."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter."
msgstr "Textfarbe. Wird für den Text der Zeilennummer in der Editor-Randleiste verwendet."

msgctxt "settings schema"
msgid "Text Color. Used to mark invisible characters in the editor.\n\nExample: spaces, tabs, carriage returns, etc."
msgstr "Textfarbe. Wird verwendet, um unsichtbare Zeichen im Editor zu kennzeichnen.\n\nBeispiel: Leerzeichen, Tabulatoren, Wagenrückläufe usw."

msgctxt "settings schema"
msgid "Text color used for CodeLens items in the editor."
msgstr "Textfarbe für CodeLens-Elemente im Editor."

msgctxt "settings schema"
msgid "The AI browser panel, which holds the AI tabs that AI agents drive."
msgstr "Das KI-Browser-Panel, das die von KI-Agenten gesteuerten KI-Tabs enthält."

msgctxt "settings schema"
msgid "The API protocol to use for this model: \"anthropic\", \"openai_responses\", \"openai_chat\", or \"google\". Defaults to \"openai_chat\"."
msgstr "Das zu verwendende API-Protokoll für dieses Modell: \"anthropic\", \"openai_responses\", \"openai_chat\" oder \"google\". Standardmäßig \"openai_chat\"."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka n_ctx)."
msgstr "Der Kontextlängenparameter für das Modell (auch bekannt als n_ctx)."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka num_ctx or n_ctx)"
msgstr "Der Kontextlängenparameter für das Modell (auch bekannt als num_ctx oder n_ctx)"

msgctxt "settings schema"
msgid "The HTTPS host the account's token signs in to, such as `github.com`.\nWithout one, pushing and pulling sign in as git is configured to."
msgstr "Der HTTPS-Host, bei dem sich das Token des Kontos anmeldet, etwa `github.com`.\nOhne Angabe melden sich Push und Pull so an, wie Git konfiguriert ist."

msgctxt "settings schema"
msgid "The OAuth client ID obtained from out-of-band registration with the\nauthorization server."
msgstr "Die OAuth-Client-ID aus der Out-of-Band-Registrierung beim Autorisierungsserver."

msgctxt "settings schema"
msgid "The OAuth client secret, if this is a confidential client. For security,\nprefer providing this interactively; we will prompt and store it in\nthe system keychain."
msgstr "Das OAuth-Clientgeheimnis, falls es sich um einen vertraulichen Client handelt. Aus Sicherheitsgründen sollten Sie es lieber interaktiv angeben; es wird abgefragt und im Schlüsselbund des Systems gespeichert."

msgctxt "settings schema"
msgid "The OpenAI Chat Completions API (`/chat/completions`)."
msgstr "Die OpenAI-Chat-Completions-API (`/chat/completions`)."

msgctxt "settings schema"
msgid "The OpenAI Responses API (`/responses`)."
msgstr "Die OpenAI-Responses-API (`/responses`)."

msgctxt "settings schema"
msgid "The OpenAI-compatible API this model must be called through."
msgstr "Die OpenAI-kompatible API, über die dieses Modell aufgerufen werden muss."

msgctxt "settings schema"
msgid "The OpenType features to enable for rendering in text buffers."
msgstr "Die OpenType-Features, die für die Darstellung in Textpuffern aktiviert werden."

msgctxt "settings schema"
msgid "The OpenType features to enable for text in the UI."
msgstr "Die zu aktivierenden OpenType-Funktionen für Text in der Benutzeroberfläche."

msgctxt "settings schema"
msgid "The SHA of the commit to apply."
msgstr "Der SHA des anzuwendenden Commits."

msgctxt "settings schema"
msgid "The SHA of the commit to check out."
msgstr "Der SHA des auszucheckenden Commits."

msgctxt "settings schema"
msgid "The SHA of the commit to put the changes into."
msgstr "Der SHA des Commits, in den die Änderungen aufgenommen werden."

msgctxt "settings schema"
msgid "The SHA of the commit to remove."
msgstr "Der SHA des zu entfernenden Commits."

msgctxt "settings schema"
msgid "The SHA of the commit to reset to."
msgstr "Der SHA des Commits, auf den zurückgesetzt wird."

msgctxt "settings schema"
msgid "The SHA of the commit to start the branch from."
msgstr "Der SHA des Commits, von dem aus der Branch beginnt."

msgctxt "settings schema"
msgid "The SHA of the commit to tag."
msgstr "Der SHA des zu taggenden Commits."

msgctxt "settings schema"
msgid "The SHA of the commit to undo."
msgstr "Der SHA des rückgängig zu machenden Commits."

msgctxt "settings schema"
msgid "The SHA of the commit whose message to rewrite."
msgstr "Der SHA des Commits, dessen Nachricht umgeschrieben wird."

msgctxt "settings schema"
msgid "The SHA of the commit."
msgstr "Der SHA des Commits."

msgctxt "settings schema"
msgid "The URL of the Zed server to connect to."
msgstr "Die URL des Zed-Servers, mit dem eine Verbindung hergestellt werden soll."

msgctxt "settings schema"
msgid "The URL of the remote context server."
msgstr "Die URL des Remote-Kontextservers."

msgctxt "settings schema"
msgid "The URL template used by `browser_panel::AskCopilot`. `{query}` is\nreplaced with the percent-encoded query when present; without the\nplaceholder the page is opened as-is and the query is put on the\nclipboard instead.\n\nDefault: https://github.com/copilot"
msgstr "Die URL-Vorlage, die von `browser_panel::AskCopilot` verwendet wird. `{query}` wird, falls vorhanden, durch die prozentkodierte Abfrage ersetzt; ohne den Platzhalter wird die Seite unverändert geöffnet und die Abfrage stattdessen in die Zwischenablage gelegt.\n\nStandard: https://github.com/copilot"

msgctxt "settings schema"
msgid "The URL template used when the address bar input is not a URL, and for\n`browser_panel::SearchSelection`. `{query}` is replaced with the\npercent-encoded query.\n\nDefault: https://www.google.com/search?q={query}"
msgstr "Die URL-Vorlage, die verwendet wird, wenn die Eingabe in der Adressleiste keine URL ist, sowie für `browser_panel::SearchSelection`. `{query}` wird durch die prozentkodierte Abfrage ersetzt.\n\nStandard: https://www.google.com/search?q={query}"

msgctxt "settings schema"
msgid "The URL used as the key for credential storage.\n\nWhen set, credentials are stored under this URL instead of `server_url`.\nThis allows running multiple Zed instances side by side without them\noverwriting each other's keychain entries."
msgstr "Die URL, die als Schlüssel für die Speicherung von Anmeldedaten verwendet wird.\n\nWenn gesetzt, werden Anmeldedaten unter dieser URL statt unter `server_url` gespeichert.\nSo können mehrere ForgeKairos-Instanzen nebeneinander laufen, ohne gegenseitig ihre Schlüsselbundeinträge zu überschreiben."

msgctxt "settings schema"
msgid "The account each repository commits and pushes as, by the absolute path of\nthe repository's working directory. A repository not listed here uses git's\nown configuration. Only read from the user settings file.\n\nDefault: {}"
msgstr "Das Konto, als das jedes Repository committet und pusht, nach dem absoluten Pfad des Arbeitsverzeichnisses des Repositorys. Ein hier nicht aufgeführtes Repository verwendet die eigene Konfiguration von Git. Wird nur aus der Benutzereinstellungsdatei gelesen.\n\nStandard: {}"

msgctxt "settings schema"
msgid "The alt key\nSometimes also known as the 'meta' key"
msgstr "Die Alt-Taste\nManchmal auch als 'Meta'-Taste bezeichnet"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline blame in units of columns.\n\nDefault: 7"
msgstr "Abstand in Spalten zwischen dem Ende der Quellzeile und dem Beginn des Inline-Blame.\n\nStandard: 7"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline diagnostic in units of columns.\n\nDefault: 4"
msgstr "Abstand in Spalten zwischen dem Ende der Quellzeile und dem Beginn der Inline-Diagnose.\n\nStandard: 4"

msgctxt "settings schema"
msgid "The arguments to pass to the command. Use `*` for a single wildcard argument.\nIf the last element is `**`, then any trailing arguments are allowed."
msgstr "Die an den Befehl zu übergebenden Argumente. Verwenden Sie `*` für ein einzelnes Platzhalterargument.\nIst das letzte Element `**`, sind beliebige weitere Argumente erlaubt."

msgctxt "settings schema"
msgid "The arguments to pass to the program."
msgstr "Die Argumente, die an das Programm übergeben werden."

msgctxt "settings schema"
msgid "The arguments to pass to the program.\n\nSupported placeholders:\n\n- `{buffer_path}`: the path of the buffer being formatted, or\n  `Untitled` when it has never been saved.\n- `{start_line}` and `{end_line}`: the first and last line of a\n  selected range, 1-based and inclusive. An argument naming either\n  of them is repeated once per selected range when formatting\n  selections (e.g. `\"--lines={start_line}:{end_line}\"` for\n  clang-format), and is dropped when formatting the whole buffer.\n  Naming them is also what marks the command as able to format\n  selections at all."
msgstr "Die an das Programm zu übergebenden Argumente.\n\nUnterstützte Platzhalter:\n\n- `{buffer_path}`: der Pfad des zu formatierenden Puffers oder `Untitled`, wenn er nie gespeichert wurde.\n- `{start_line}` und `{end_line}`: die erste und letzte Zeile eines ausgewählten Bereichs, 1-basiert und einschließlich. Ein Argument, das einen der beiden enthält, wird beim Formatieren von Auswahlen einmal pro ausgewähltem Bereich wiederholt (z. B. `\"--lines={start_line}:{end_line}\"` für clang-format) und beim Formatieren des ganzen Puffers weggelassen. Ihre Verwendung kennzeichnet den Befehl außerdem überhaupt erst als fähig, Auswahlen zu formatieren."

msgctxt "settings schema"
msgid "The author and committer email (`user.email`)."
msgstr "Die E-Mail-Adresse von Autor und Committer (`user.email`)."

msgctxt "settings schema"
msgid "The author and committer name (`user.name`)."
msgstr "Der Name von Autor und Committer (`user.name`)."

msgctxt "settings schema"
msgid "The available agent profiles."
msgstr "Die verfügbaren Agent-Profile."

msgctxt "settings schema"
msgid "The background appearance of the window."
msgstr "Die Hintergrunddarstellung des Fensters."

msgctxt "settings schema"
msgid "The background color of the scrollbar track."
msgstr "Die Hintergrundfarbe der Scrollleistenbahn."

msgctxt "settings schema"
msgid "The base URL for the provider (e.g., \"https://code.corp.big.com\")."
msgstr "Die Basis-URL für den Anbieter (z. B. \"https://code.corp.big.com\")."

msgctxt "settings schema"
msgid "The behavior of `editor::Rewrap`."
msgstr "Das Verhalten von `editor::Rewrap`."

msgctxt "settings schema"
msgid "The border color of the minimap thumb."
msgstr "Die Rahmenfarbe des Minimap-Schiebereglers."

msgctxt "settings schema"
msgid "The border color of the scrollbar thumb."
msgstr "Die Rahmenfarbe des Scrollleisten-Schiebereglers."

msgctxt "settings schema"
msgid "The border color of the scrollbar track."
msgstr "Die Rahmenfarbe der Scrollleistenbahn."

msgctxt "settings schema"
msgid "The buffer's line height."
msgstr "Die Zeilenhöhe des Puffers."

msgctxt "settings schema"
msgid "The capabilities granted to extensions."
msgstr "Die den Erweiterungen gewährten Berechtigungen."

msgctxt "settings schema"
msgid "The color of the minimap thumb when hovered over."
msgstr "Die Farbe des Minimap-Schiebereglers beim Darüberfahren mit der Maus."

msgctxt "settings schema"
msgid "The color of the minimap thumb whilst being actively dragged."
msgstr "Die Farbe des Minimap-Schiebereglers beim aktiven Ziehen."

msgctxt "settings schema"
msgid "The color of the minimap thumb."
msgstr "Die Farbe des Minimap-Schiebereglers."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb when hovered over."
msgstr "Die Farbe des Scrollleisten-Schiebereglers beim Darüberfahren mit der Maus."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb whilst being actively dragged."
msgstr "Die Farbe des Scrollleisten-Schiebereglers beim aktiven Ziehen."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb."
msgstr "Die Farbe des Scrollleisten-Schiebereglers."

msgctxt "settings schema"
msgid "The column at which to soft-wrap lines, for buffers where soft-wrap\nis enabled.\n\nDefault: 80"
msgstr "Die Spalte, an der Zeilen in Puffern mit aktiviertem weichem Zeilenumbruch umbrochen werden.\n\nStandard: 80"

msgctxt "settings schema"
msgid "The command key, on macos\nthe windows key, on windows\nthe super key, on linux"
msgstr "Die Command-Taste unter macOS\ndie Windows-Taste unter Windows\ndie Super-Taste unter Linux"

msgctxt "settings schema"
msgid "The command to execute."
msgstr "Der auszuführende Befehl."

msgctxt "settings schema"
msgid "The content of a serialized theme."
msgstr "Der Inhalt eines serialisierten Designs."

msgctxt "settings schema"
msgid "The contents of the edit prediction settings."
msgstr "Der Inhalt der Einstellungen für Bearbeitungsvorhersagen."

msgctxt "settings schema"
msgid "The control key"
msgstr "Die Ctrl-Taste"

msgctxt "settings schema"
msgid "The debounce delay before querying highlights from the language\nserver based on the current cursor location.\n\nDefault: 75"
msgstr "Die Entprellungsverzögerung, bevor anhand der aktuellen Cursorposition Hervorhebungen vom Sprachserver abgefragt werden.\n\nStandard: 75"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 0"
msgstr "Die Entprellungsverzögerung in Millisekunden, bevor nach dem Ende der Eingabe automatisch eine Vorhersage angefordert wird. Auf 0 setzen, um Vorhersagen sofort anzufordern.\n\nStandard: 0"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 150"
msgstr "Die Entprellungsverzögerung in Millisekunden, bevor nach dem Ende der Eingabe automatisch eine Vorhersage angefordert wird. Auf 0 setzen, um Vorhersagen sofort anzufordern.\n\nStandard: 150"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 75"
msgstr "Die Entprellungsverzögerung in Millisekunden, bevor nach dem Ende der Eingabe automatisch eine Vorhersage angefordert wird. Auf 0 setzen, um Vorhersagen sofort anzufordern.\n\nStandard: 75"

msgctxt "settings schema"
msgid "The default UI density."
msgstr "Die Standard-UI-Dichte."

msgctxt "settings schema"
msgid "The default behavior when opening paths from the CLI without\nan explicit `-e` or `-n` flag.\n\nDefault: existing_window"
msgstr "Das Standardverhalten beim Öffnen von Pfaden über die CLI ohne ausdrückliches Flag `-e` oder `-n`.\n\nStandard: existing_window"

msgctxt "settings schema"
msgid "The default behavior when opening projects from the UI.\n\nDefault: existing_window"
msgstr "Das Standardverhalten beim Öffnen von Projekten über die Oberfläche.\n\nStandard: existing_window"

msgctxt "settings schema"
msgid "The default font size for rendering in text buffers."
msgstr "Die standardmäßige Schriftgröße für die Darstellung in Textpuffern."

msgctxt "settings schema"
msgid "The default font size for text in the UI."
msgstr "Die standardmäßige Schriftgröße für Text in der Benutzeroberfläche."

msgctxt "settings schema"
msgid "The default language model selected when using this profile."
msgstr "Das standardmäßig ausgewählte Sprachmodell bei Verwendung dieses Profils."

msgctxt "settings schema"
msgid "The default line height."
msgstr "Die Standard-Zeilenhöhe."

msgctxt "settings schema"
msgid "The default mode to use for this agent.\n\nNote: Not only all agents support modes.\n\nDefault: None"
msgstr "Der Standardmodus für diesen Agenten.\n\nHinweis: Nicht alle Agenten unterstützen Modi.\n\nStandard: None"

msgctxt "settings schema"
msgid "The default model to use when creating new chats and for other features when a specific model is not specified."
msgstr "Das Standardmodell für neue Chats und andere Funktionen, wenn kein bestimmtes Modell angegeben ist."

msgctxt "settings schema"
msgid "The default profile to use in the Agent.\n\nDefault: write"
msgstr "Das Standardprofil für den Agenten.\n\nStandard: write"

msgctxt "settings schema"
msgid "The default temperature to use for this model."
msgstr "Die Standardtemperatur für dieses Modell."

msgctxt "settings schema"
msgid "The delay in milliseconds that must elapse before drag and drop is allowed. Otherwise, a new text selection is created.\n\nDefault: 300"
msgstr "Die Verzögerung in Millisekunden, die vergehen muss, bevor Drag & Drop erlaubt ist. Andernfalls wird eine neue Textauswahl erstellt.\n\nStandard: 300"

msgctxt "settings schema"
msgid "The display name for the provider (e.g., \"BigCorp GitHub\")."
msgstr "Der Anzeigename des Anbieters (z. B. „BigCorp GitHub“)."

msgctxt "settings schema"
msgid "The dock position of the debug panel\n\nDefault: Bottom"
msgstr "Die Dockposition des Debug-Panels\n\nStandard: Bottom"

msgctxt "settings schema"
msgid "The edit prediction settings."
msgstr "Die Einstellungen für Bearbeitungsvorhersagen."

msgctxt "settings schema"
msgid "The editor will not scroll beyond the last line."
msgstr "Der Editor scrollt nicht über die letzte Zeile hinaus."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by one page."
msgstr "Der Editor scrollt eine Seite über die letzte Zeile hinaus."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by the same number of lines as vertical_scroll_margin."
msgstr "Der Editor scrollt um so viele Zeilen über die letzte Zeile hinaus, wie durch vertical_scroll_margin festgelegt."

msgctxt "settings schema"
msgid "The extensions that should be automatically installed by Zed.\n\nThis is used to make functionality provided by extensions (e.g., language support)\navailable out-of-the-box.\n\nDefault: {}"
msgstr "Die Erweiterungen, die von ForgeKairos automatisch installiert werden sollen.\n\nDamit werden Funktionen, die von Erweiterungen bereitgestellt werden (z. B. Sprachunterstützung), sofort verfügbar.\n\nStandard: {}"

msgctxt "settings schema"
msgid "The external program to run."
msgstr "Das auszuführende externe Programm."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in text buffers."
msgstr "Die Ersatzschriftarten, die für das Rendern in Textpuffern verwendet werden."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in the UI."
msgstr "Die Ersatzschriftarten, die für das Rendern in der UI verwendet werden."

msgctxt "settings schema"
msgid "The font size for agent responses in the agent panel. Falls back to the UI font size if unset."
msgstr "Die Schriftgröße für Agent-Antworten im Agent-Panel. Falls nicht festgelegt, wird die UI-Schriftgröße verwendet."

msgctxt "settings schema"
msgid "The font size for user messages in the agent panel."
msgstr "Die Schriftgröße für Benutzernachrichten im Agent-Panel."

msgctxt "settings schema"
msgid "The font size to use for rendering in the markdown preview.\nFalls back to the UI font size if unset."
msgstr "Die Schriftgröße für die Darstellung in der Markdown-Vorschau.\nWenn nicht gesetzt, wird die UI-Schriftgröße verwendet."

msgctxt "settings schema"
msgid "The function key"
msgstr "Die Fn-Taste"

msgctxt "settings schema"
msgid "The granularity of one 'step' in the stepping requests `next`, `stepIn`, `stepOut`, and `stepBack`."
msgstr "Die Granularität eines einzelnen Schritts bei den Schrittanforderungen `next`, `stepIn`, `stepOut` und `stepBack`."

msgctxt "settings schema"
msgid "The guardrail identifier (ARN or ID) to apply to Bedrock API requests."
msgstr "Die Guardrail-Kennung (ARN oder ID), die auf Bedrock-API-Anfragen angewendet werden soll."

msgctxt "settings schema"
msgid "The guardrail version to use. Defaults to \"DRAFT\" if not specified."
msgstr "Die zu verwendende Guardrail-Version. Standardmäßig \"DRAFT\", wenn nicht angegeben."

msgctxt "settings schema"
msgid "The icon theme to use for dark mode."
msgstr "Das Symboldesign für den Dunkelmodus."

msgctxt "settings schema"
msgid "The icon theme to use for light mode."
msgstr "Das Symboldesign für den Hellmodus."

msgctxt "settings schema"
msgid "The key commits are signed with (`user.signingkey`), when signing is on."
msgstr "Der Schlüssel, mit dem Commits signiert werden (`user.signingkey`), wenn das Signieren aktiviert ist."

msgctxt "settings schema"
msgid "The key to use for adding multiple cursors\n\nDefault: alt"
msgstr "Die Taste zum Hinzufügen mehrerer Cursor\n\nStandard: alt"

msgctxt "settings schema"
msgid "The language of the UI: \"system\" to follow the operating system, or a BCP 47\ntag such as \"en\", \"ja\" or \"pt-BR\".\n\nDefault: \"system\""
msgstr "Die Sprache der Oberfläche: \"system\", um dem Betriebssystem zu folgen, oder ein BCP-47-Tag wie \"en\", \"ja\" oder \"pt-BR\".\n\nStandard: \"system\""

msgctxt "settings schema"
msgid "The language server and, in C and C++, the symbol index."
msgstr "Der Sprachserver und in C und C++ der Symbolindex."

msgctxt "settings schema"
msgid "The layout of window control buttons as represented by user settings.\n\nCustom layout strings use the GNOME `button-layout` format (e.g.\n`\"close:minimize,maximize\"`)."
msgstr "Das Layout der Fenstersteuerungsschaltflächen, wie es in den Benutzereinstellungen dargestellt wird.\n\nBenutzerdefinierte Layout-Zeichenfolgen verwenden das GNOME-Format `button-layout` (z. B. `\"close:minimize,maximize\"`)."

msgctxt "settings schema"
msgid "The layout of window control buttons in the title bar (Linux only).\n\nThis can be set to \"platform_default\" to follow the system configuration, or\n\"standard\" to use Zed's built-in layout. For custom layouts, use a\nGNOME-style layout string like \"close:minimize,maximize\".\n\nDefault: \"platform_default\""
msgstr "Das Layout der Fenstersteuerungsschaltflächen in der Titelleiste (nur Linux).\n\nKann auf \"platform_default\" gesetzt werden, um der Systemkonfiguration zu folgen, oder auf \"standard\", um das integrierte Layout von ForgeKairos zu verwenden. Für benutzerdefinierte Layouts verwenden Sie eine Layout-Zeichenfolge im GNOME-Stil wie \"close:minimize,maximize\".\n\nStandard: \"platform_default\""

msgctxt "settings schema"
msgid "The list of custom Git hosting providers."
msgstr "Die Liste der benutzerdefinierten Git-Hosting-Anbieter."

msgctxt "settings schema"
msgid "The list of language servers to use (or disable) for this language.\n\nThis array should consist of language server IDs, as well as the following\nspecial tokens:\n- `\"!<language_server_id>\"` - A language server ID prefixed with a `!` will be disabled.\n- `\"...\"` - A placeholder to refer to the **rest** of the registered language servers for this language.\n\nDefault: [\"...\"]"
msgstr "Die Liste der Sprachserver, die für diese Sprache verwendet (oder deaktiviert) werden.\n\nDieses Array sollte aus Sprachserver-IDs sowie den folgenden speziellen Token bestehen:\n- `\"!<language_server_id>\"` - Eine Sprachserver-ID mit vorangestelltem `!` wird deaktiviert.\n- `\"...\"` - Ein Platzhalter, der auf die **übrigen** für diese Sprache registrierten Sprachserver verweist.\n\nStandard: [\"...\"]"

msgctxt "settings schema"
msgid "The maximum amount of time to wait for responses from language servers, in seconds.\nA value of `0` will result in no timeout being applied (causing all LSP responses to wait indefinitely until completed).\n\nDefault: `120`"
msgstr "Die maximale Wartezeit auf Antworten von Sprachservern in Sekunden.\nBei `0` gilt kein Zeitlimit (alle LSP-Antworten warten unbegrenzt bis zum Abschluss).\n\nStandard: `120`"

msgctxt "settings schema"
msgid "The maximum line length a buffer may contain before language server features are disabled for the entire buffer.\n\nDefault: `20000`"
msgstr "Die maximale Zeilenlänge, die ein Puffer enthalten darf, bevor Sprachserverfunktionen für den gesamten Puffer deaktiviert werden.\n\nStandard: `20000`"

msgctxt "settings schema"
msgid "The maximum number of completion tokens allowed by the model (o1-* only)"
msgstr "Die maximale Anzahl von Antwort-Token, die das Modell zulässt (nur o1-*)"

msgctxt "settings schema"
msgid "The maximum number of lines to keep in the scrollback history.\nMaximum allowed value is 100_000, all values above that will be treated as 100_000.\n0 disables the scrolling.\nExisting terminals will not pick up this change until they are recreated.\nSee <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">Alacritty documentation</a> for more information.\n\nDefault: 10_000"
msgstr "Die maximale Anzahl Zeilen im Scrollback-Verlauf.\nDer höchste zulässige Wert ist 100_000; alle größeren Werte werden als 100_000 behandelt.\n0 deaktiviert das Scrollen.\nBestehende Terminals übernehmen diese Änderung erst, wenn sie neu erstellt werden.\nWeitere Informationen finden Sie in der <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">Alacritty-Dokumentation</a>.\n\nStandard: 10_000"

msgctxt "settings schema"
msgid "The maximum number of output tokens allowed by the model."
msgstr "Die maximale Anzahl von Ausgabetoken, die das Modell zulässt."

msgctxt "settings schema"
msgid "The maximum width, in pixels, of the rendered markdown content when\n`limit_content_width` is enabled.\n\nDefault: 800"
msgstr "Die maximale Breite des dargestellten Markdown-Inhalts in Pixeln, wenn `limit_content_width` aktiviert ist.\n\nStandard: 800"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast between foreground and background colors.\n\nAPCA (Accessible Perceptual Contrast Algorithm) is more accurate than WCAG 2.x,\nespecially for dark mode. Values range from 0 to 106.\n\nBased on APCA Readability Criterion (ARC) Bronze Simple Mode:\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: No contrast adjustment\n- 45: Minimum for large fluent text (36px+)\n- 60: Minimum for other content text\n- 75: Minimum for body text\n- 90: Preferred for body text\n\nDefault: 45"
msgstr "Der minimale wahrnehmungsbasierte APCA-Kontrast zwischen Vorder- und Hintergrundfarben.\n\nAPCA (Accessible Perceptual Contrast Algorithm) ist genauer als WCAG 2.x, besonders im dunklen Modus. Werte reichen von 0 bis 106.\n\nBasierend auf APCA Readability Criterion (ARC) Bronze Simple Mode:\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: Keine Kontrastanpassung\n- 45: Minimum für großen Fließtext (36px+)\n- 60: Minimum für sonstigen Inhaltstext\n- 75: Minimum für Fließtext\n- 90: Empfohlen für Fließtext\n\nStandard: 45"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast to maintain when\nrendering text over highlight backgrounds in the editor.\n\nValues range from 0 to 106. Set to 0 to disable adjustments.\nDefault: 45"
msgstr "Der minimale wahrnehmungsbasierte APCA-Kontrast, der beim Darstellen von Text auf Hervorhebungshintergründen im Editor eingehalten wird.\n\nWerte reichen von 0 bis 106. Auf 0 setzen, um Anpassungen zu deaktivieren.\nStandard: 45"

msgctxt "settings schema"
msgid "The minimum column number to show the inline blame information at\n\nDefault: 0"
msgstr "Die minimale Spaltennummer, ab der die Inline-Blame-Informationen angezeigt werden\n\nStandard: 0"

msgctxt "settings schema"
msgid "The minimum column to display inline diagnostics. This setting can be\nused to horizontally align inline diagnostics at some position. Lines\nlonger than this value will still push diagnostics further to the right.\n\nDefault: 0"
msgstr "Die minimale Spalte für die Anzeige von Inline-Diagnosen. Mit dieser Einstellung lassen sich Inline-Diagnosen horizontal an einer bestimmten Position ausrichten. Längere Zeilen schieben Diagnosen weiterhin nach rechts.\n\nStandard: 0"

msgctxt "settings schema"
msgid "The minimum width (in em-widths) at which the split diff view is used.\nWhen the editor is narrower than this, the diff view automatically\nswitches to unified mode and switches back when the editor is wide\nenough. Set to 0 to disable automatic switching.\n\nDefault: 100"
msgstr "Die minimale Breite (in Em-Breiten), ab der die geteilte Diff-Ansicht verwendet wird.\nIst der Editor schmaler, wechselt die Diff-Ansicht automatisch in den einheitlichen Modus und wieder zurück, sobald der Editor breit genug ist. Auf 0 setzen, um den automatischen Wechsel zu deaktivieren.\n\nStandard: 100"

msgctxt "settings schema"
msgid "The mode in which edit predictions should be displayed."
msgstr "Der Modus, in dem Bearbeitungsvorhersagen angezeigt werden sollen."

msgctxt "settings schema"
msgid "The mode use to select a theme.\n\n`Light` and `Dark` will select their respective themes.\n\n`System` will select the theme based on the system's appearance."
msgstr "Der Modus zur Auswahl eines Designs.\n\n`Light` und `Dark` wählen das jeweilige Design.\n\n`System` wählt das Design anhand der Systemdarstellung."

msgctxt "settings schema"
msgid "The mode used to determine which theme to use."
msgstr "Der Modus, der bestimmt, welches Design verwendet wird."

msgctxt "settings schema"
msgid "The mode used to display edit predictions in the buffer.\nProvider support required."
msgstr "Der Modus, in dem Bearbeitungsvorhersagen im Puffer angezeigt werden.\nErfordert Unterstützung durch den Anbieter."

msgctxt "settings schema"
msgid "The model id as expected in Bedrock Mantle request bodies, e.g. `openai.gpt-5.5`."
msgstr "Die Modell-ID, wie sie in Bedrock-Mantle-Anfragetexten erwartet wird, z. B. `openai.gpt-5.5`."

msgctxt "settings schema"
msgid "The model id reported by the llama.cpp server (its `--alias` or the model file path)."
msgstr "Die von llama.cpp gemeldete Modell-ID (sein `--alias` oder der Pfad zur Modelldatei)."

msgctxt "settings schema"
msgid "The model name in the Ollama API (e.g. \"llama3.2:latest\")"
msgstr "Der Modellname in der Ollama-API (z. B. „llama3.2:latest“)"

msgctxt "settings schema"
msgid "The model to use for subagents spawned via the `spawn_agent` tool. Defaults to the parent agent's model when not specified."
msgstr "Das Modell, das für über das Tool `spawn_agent` gestartete Unteragenten verwendet wird. Standardmäßig wird das Modell des übergeordneten Agenten verwendet, wenn kein Modell angegeben ist."

msgctxt "settings schema"
msgid "The model's context window size."
msgstr "Die Kontextfenstergröße des Modells."

msgctxt "settings schema"
msgid "The model's mode (e.g. thinking)"
msgstr "Der Modus des Modells (z. B. „thinking“)"

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the agent panel."
msgstr "Der Name des Modells in der Benutzeroberfläche von ForgeKairos, z. B. im Modellauswahl-Dropdown des Agent-Panels."

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the assistant panel."
msgstr "Der Name des Modells in der Benutzeroberfläche von ForgeKairos, z. B. im Modellauswahl-Dropdown des Assistenten-Panels."

msgctxt "settings schema"
msgid "The model's name in the Anthropic API. e.g. claude-3-5-sonnet-latest, claude-3-opus-20240229, etc"
msgstr "Der Name des Modells in der Anthropic-API, z. B. claude-3-5-sonnet-latest, claude-3-opus-20240229 usw."

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-20240620"
msgstr "Der Name des Modells in der API des Anbieters, z. B. claude-3-5-sonnet-20240620"

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-latest"
msgstr "Der Name des Modells in der API des Anbieters, z. B. claude-3-5-sonnet-latest"

msgctxt "settings schema"
msgid "The multiplier for scrolling with the mouse wheel.\n\nDefault: 1.0"
msgstr "Der Multiplikator für das Scrollen mit dem Mausrad.\n\nStandard: 1.0"

msgctxt "settings schema"
msgid "The name displayed in the UI, such as in the agent panel model dropdown menu."
msgstr "Der in der Benutzeroberfläche angezeigte Name, z. B. im Modell-Dropdown des Agent-Panels."

msgctxt "settings schema"
msgid "The name of a font to use for agent responses in the agent panel. Falls back to the UI font if unset."
msgstr "Name der Schriftart für Agent-Antworten im Agent-Panel. Falls nicht festgelegt, wird die UI-Schriftart verwendet."

msgctxt "settings schema"
msgid "The name of a font to use for code (code blocks and inline code) in the\nmarkdown preview. Falls back to the buffer font if unset."
msgstr "Der Name einer Schriftart für Code (Codeblöcke und Inline-Code) in der Markdown-Vorschau. Wenn nicht gesetzt, wird die Pufferschriftart verwendet."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in text buffers."
msgstr "Der Name der Schriftart für die Darstellung in Textpuffern."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the UI."
msgstr "Der Name der Schriftart für die Darstellung in der Benutzeroberfläche."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the markdown preview.\nFalls back to the UI font if unset."
msgstr "Der Name einer Schriftart für die Darstellung in der Markdown-Vorschau.\nWenn nicht gesetzt, wird die UI-Schriftart verwendet."

msgctxt "settings schema"
msgid "The name of a font to use for user messages in the agent panel. Falls back to the buffer font if unset."
msgstr "Name der Schriftart für Benutzernachrichten im Agent-Panel. Falls nicht festgelegt, wird die Pufferschriftart verwendet."

msgctxt "settings schema"
msgid "The name of the Zed theme to use."
msgstr "Der Name des zu verwendenden ForgeKairos-Designs."

msgctxt "settings schema"
msgid "The name of the icon theme to use."
msgstr "Der Name des zu verwendenden Symboldesigns."

msgctxt "settings schema"
msgid "The name of the language server to format with"
msgstr "Der Name des Sprachservers, mit dem formatiert werden soll"

msgctxt "settings schema"
msgid "The name of the model.\n\nDefault: \"\""
msgstr "Der Name des Modells.\n\nStandard: \"\""

msgctxt "settings schema"
msgid "The name the account is picked by, unique among the accounts."
msgstr "Der Name, unter dem das Konto ausgewählt wird; muss unter den Konten eindeutig sein."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files, which answers\nproject-wide symbol search, \"go to definition\" when the language server has\nno answer, and callers and callees, without compilation information."
msgstr "Der namensbasierte Symbolindex der C- und C++-Dateien, der ohne Kompilierungsinformationen die projektweite Symbolsuche, „Zur Definition wechseln“, wenn der Sprachserver keine Antwort hat, sowie Aufrufer und Aufgerufene beantwortet."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files."
msgstr "Der namensbasierte Symbolindex der C- und C++-Dateien."

msgctxt "settings schema"
msgid "The number of characters to keep on either side when scrolling with the mouse.\n\nDefault: 5."
msgstr "Die Anzahl Zeichen, die beim Scrollen mit der Maus auf beiden Seiten frei bleiben.\n\nStandard: 5."

msgctxt "settings schema"
msgid "The number of lines to keep above/below the cursor when auto-scrolling.\n\nDefault: 3."
msgstr "Die Anzahl Zeilen, die beim automatischen Scrollen über/unter dem Cursor frei bleiben.\n\nStandard: 3."

msgctxt "settings schema"
msgid "The number of seconds to keep the connection open after the last request"
msgstr "Die Anzahl der Sekunden, die die Verbindung nach der letzten Anfrage offen gehalten wird"

msgctxt "settings schema"
msgid "The page opened when a built-in browser panel or tab first loads.\n\nDefault: https://m365.cloud.microsoft/chat"
msgstr "Die Seite, die geöffnet wird, wenn ein Panel oder Tab des integrierten Browsers zum ersten Mal lädt.\n\nStandard: https://m365.cloud.microsoft/chat"

msgctxt "settings schema"
msgid "The path of the directory where journal entries are stored.\n\nDefault: `~`"
msgstr "Der Pfad des Verzeichnisses, in dem Journaleinträge gespeichert werden.\n\nStandard: `~`"

msgctxt "settings schema"
msgid "The path to the Node binary."
msgstr "Der Pfad zur Node-Binärdatei."

msgctxt "settings schema"
msgid "The path to the npm binary Zed should use (defaults to `.path/../npm`)."
msgstr "Der Pfad zur npm-Binärdatei, die ForgeKairos verwenden soll (Standard: `.path/../npm`)."

msgctxt "settings schema"
msgid "The position of outline panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "Die Position des Gliederungspanels\n\nStandard: right (Agentic-Layout), left (Classic-Layout)"

msgctxt "settings schema"
msgid "The position of project panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "Die Position des Projektpanels\n\nStandard: right (Agentic-Layout), left (Classic-Layout)"

msgctxt "settings schema"
msgid "The private key file (an absolute path, or one starting with `~`) that pushing, pulling\nand fetching reach SSH remotes with, offered alone (`IdentitiesOnly`). Local projects\nonly. Not used when `GIT_SSH_COMMAND`, `GIT_SSH` or `core.sshCommand` is set."
msgstr "Die private Schlüsseldatei (ein absoluter Pfad oder einer, der mit `~` beginnt), mit der Push, Pull und Fetch SSH-Remotes erreichen, wobei nur dieser Schlüssel angeboten wird (`IdentitiesOnly`). Nur lokale Projekte. Wird nicht verwendet, wenn `GIT_SSH_COMMAND`, `GIT_SSH` oder `core.sshCommand` gesetzt ist."

msgctxt "settings schema"
msgid "The program to run."
msgstr "Das auszuführende Programm."

msgctxt "settings schema"
msgid "The prompt format to use for completions. Set to `\"\"` to have the format be derived from the model name.\n\nDefault: \"\""
msgstr "Das Prompt-Format für Vervollständigungen. Auf `\"\"` setzen, um das Format aus dem Modellnamen abzuleiten.\n\nStandard: \"\""

msgctxt "settings schema"
msgid "The provider of the language model."
msgstr "Der Anbieter des Sprachmodells."

msgctxt "settings schema"
msgid "The provider that supplies edit predictions."
msgstr "Der Anbieter, der Bearbeitungsvorhersagen liefert."

msgctxt "settings schema"
msgid "The regex pattern to match."
msgstr "Das abzugleichende Regex-Muster."

msgctxt "settings schema"
msgid "The relative width of the left padding of the central pane from the\nworkspace when the centered layout is used.\n\nDefault: 0.2"
msgstr "Die relative Breite des linken Abstands des zentralen Bereichs zum Arbeitsbereich, wenn das zentrierte Layout verwendet wird.\n\nStandard: 0.2"

msgctxt "settings schema"
msgid "The settings for a particular language."
msgstr "Die Einstellungen für eine bestimmte Sprache."

msgctxt "settings schema"
msgid "The settings for cursor shape."
msgstr "Die Einstellungen für die Cursorform."

msgctxt "settings schema"
msgid "The settings for indent guides."
msgstr "Die Einstellungen für Einzugsführungslinien."

msgctxt "settings schema"
msgid "The settings for individual languages."
msgstr "Die Einstellungen für einzelne Sprachen."

msgctxt "settings schema"
msgid "The settings for inlay hints."
msgstr "Die Einstellungen für Inlay-Hinweise."

msgctxt "settings schema"
msgid "The settings for the image viewer."
msgstr "Die Einstellungen für den Bildbetrachter."

msgctxt "settings schema"
msgid "The settings for the markdown preview."
msgstr "Die Einstellungen für die Markdown-Vorschau."

msgctxt "settings schema"
msgid "The settings for this context server specified by the extension.\n\nConsult the documentation for the context server to see what settings\nare supported."
msgstr "Die von der Erweiterung angegebenen Einstellungen für diesen Kontextserver.\n\nWelche Einstellungen unterstützt werden, entnehmen Sie der Dokumentation des Kontextservers."

msgctxt "settings schema"
msgid "The settings overrides for this profile."
msgstr "Die Einstellungsüberschreibungen für dieses Profil."

msgctxt "settings schema"
msgid "The shape of a selection cursor."
msgstr "Die Form des Auswahlcursors."

msgctxt "settings schema"
msgid "The shift key"
msgstr "Die Shift-Taste"

msgctxt "settings schema"
msgid "The size of the context window, indicating the maximum number of tokens the model can process."
msgstr "Die Größe des Kontextfensters, d. h. die maximale Anzahl von Token, die das Modell verarbeiten kann."

msgctxt "settings schema"
msgid "The size of the workspace split drop targets on the outer edges.\nGiven as a fraction that will be multiplied by the smaller dimension of the workspace.\n\nDefault: `0.2` (20% of the smaller dimension of the workspace)"
msgstr "Die Größe der Ablageziele zum Teilen des Arbeitsbereichs an den äußeren Rändern.\nAngegeben als Bruchteil, der mit der kleineren Abmessung des Arbeitsbereichs multipliziert wird.\n\nStandard: `0.2` (20 % der kleineren Abmessung des Arbeitsbereichs)"

msgctxt "settings schema"
msgid "The smallest model context window (in tokens) for which auto-compaction\nstill runs. Models below this are left uncompacted and the UI warns\nabout the token limit instead. Lower this to make auto-compaction work\nwith local models that have a small context window. Values below 8000\nare clamped to 8000.\n\nDefault: 80000"
msgstr "Das kleinste Kontextfenster eines Modells (in Token), für das die automatische Komprimierung noch ausgeführt wird. Modelle darunter werden nicht komprimiert, und die Oberfläche warnt stattdessen vor dem Tokenlimit. Verringern Sie den Wert, damit die automatische Komprimierung mit lokalen Modellen mit kleinem Kontextfenster funktioniert. Werte unter 8000 werden auf 8000 begrenzt.\n\nStandard: 80000"

msgctxt "settings schema"
msgid "The standard spacing of entries."
msgstr "Der Standardabstand zwischen Einträgen."

msgctxt "settings schema"
msgid "The state of the modifier keys at some point in time"
msgstr "Der Zustand der Modifikatortasten zu einem bestimmten Zeitpunkt"

msgctxt "settings schema"
msgid "The step should allow one instruction to execute (e.g. one x86 instruction)."
msgstr "Der Schritt soll die Ausführung einer Instruktion ermöglichen (z. B. eine x86-Instruktion)."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current source line has executed."
msgstr "Der Schritt soll das Programm ausführen, bis die aktuelle Quellzeile abgearbeitet ist."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current statement has finished executing.\nThe meaning of a statement is determined by the adapter and it may be considered equivalent to a line.\nFor example 'for(int i = 0; i < 10; i++)' could be considered to have 3 statements 'int i = 0', 'i < 10', and 'i++'."
msgstr "Der Schritt soll das Programm laufen lassen, bis die aktuelle Anweisung vollständig ausgeführt ist.\nWas eine Anweisung ist, bestimmt der Adapter; sie kann einer Zeile gleichgesetzt werden.\nBeispielsweise könnte 'for(int i = 0; i < 10; i++)' als 3 Anweisungen 'int i = 0', 'i < 10' und 'i++' betrachtet werden."

msgctxt "settings schema"
msgid "The styles for syntax nodes."
msgstr "Die Stile für Syntaxknoten."

msgctxt "settings schema"
msgid "The subscription for this model: \"zen\" or \"go\". Defaults to Zen."
msgstr "Das Abonnement für dieses Modell: \"zen\" oder \"go\". Standard ist Zen."

msgctxt "settings schema"
msgid "The task settings for a particular language."
msgstr "Die Aufgabeneinstellungen für eine bestimmte Sprache."

msgctxt "settings schema"
msgid "The text rendering mode to use.\n\nDefault: platform_default"
msgstr "Der zu verwendende Textrendermodus.\n\nStandard: platform_default"

msgctxt "settings schema"
msgid "The theme to use for dark mode."
msgstr "Das Design für den Dunkelmodus."

msgctxt "settings schema"
msgid "The theme to use for light mode."
msgstr "Das Design für den Hellmodus."

msgctxt "settings schema"
msgid "The theme to use for the markdown preview.\nFalls back to the main editor theme if unset."
msgstr "Das Design für die Markdown-Vorschau.\nWenn nicht gesetzt, wird das Design des Haupteditors verwendet."

msgctxt "settings schema"
msgid "The threshold at which auto-compaction runs. This is one of:\n\n- A percentage string ending in `%`, e.g. `\"90%\"`, measured against the\n  model's context window. `\"90%\"` compacts once the context is 90% full.\n- A positive integer: compaction runs once that many tokens have been\n  used. For example, `100000` compacts after 100,000 tokens are used.\n- A negative integer: compaction runs once that many tokens remain in\n  the context window. For example, `-20000` compacts once there are\n  fewer than 20,000 tokens of headroom left in the context window.\n\n`0` is not a valid threshold.\n\nDefault: \"90%\""
msgstr "Der Schwellenwert, ab dem die automatische Komprimierung ausgeführt wird. Einer der folgenden Werte:\n\n- Eine Prozentzeichenfolge, die auf `%` endet, z. B. `\"90%\"`, gemessen am Kontextfenster des Modells. `\"90%\"` komprimiert, sobald der Kontext zu 90 % gefüllt ist.\n- Eine positive ganze Zahl: Die Komprimierung erfolgt, sobald so viele Token verbraucht wurden. Beispielsweise komprimiert `100000`, nachdem 100.000 Token verbraucht wurden.\n- Eine negative ganze Zahl: Die Komprimierung erfolgt, sobald nur noch so viele Token im Kontextfenster übrig sind. Beispielsweise komprimiert `-20000`, sobald weniger als 20.000 Token Spielraum im Kontextfenster verbleiben.\n\n`0` ist kein gültiger Schwellenwert.\n\nStandard: \"90%\""

msgctxt "settings schema"
msgid "The topic whose entries to show first, such as \"merge_request\". Without it, the usual order."
msgstr "Das Thema, dessen Einträge zuerst angezeigt werden, etwa \"merge_request\". Ohne Angabe gilt die übliche Reihenfolge."

msgctxt "settings schema"
msgid "The type of the provider.\n\nMust be one of `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut`, or `tangled`."
msgstr "Der Typ des Anbieters.\n\nMuss einer der Werte `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut` oder `tangled` sein."

msgctxt "settings schema"
msgid "The unit to use for displaying image file sizes.\n\nDefault: \"binary\""
msgstr "Die Einheit für die Anzeige von Bilddateigrößen.\n\nStandard: \"binary\""

msgctxt "settings schema"
msgid "The user name on `host` that goes with the token."
msgstr "Der zum Token gehörende Benutzername auf `host`."

msgctxt "settings schema"
msgid "The value to pass to the CLI's `--effort`, such as `low`, `medium` or `high`. Without it, the CLI uses its default."
msgstr "Der Wert, der an `--effort` der CLI übergeben wird, etwa `low`, `medium` oder `high`. Ohne Angabe verwendet die CLI ihren Standard."

msgctxt "settings schema"
msgid "The weight of the UI font in CSS units from 100 to 900."
msgstr "Die Stärke der Benutzeroberflächenschriftart in CSS-Einheiten von 100 bis 900."

msgctxt "settings schema"
msgid "The weight of the editor font in CSS units from 100 to 900."
msgstr "Die Stärke der Editorschriftart in CSS-Einheiten von 100 bis 900."

msgctxt "settings schema"
msgid "The width of the active indent guide in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "Die Breite der aktiven Einzugsführungslinie in Pixeln, zwischen 1 und 10.\n\nStandard: 1"

msgctxt "settings schema"
msgid "The width of the git diff hunk indicators in the gutter.\nUse \"default\" to scale with the buffer font size, or {\"custom\": <pixels>} for a fixed width.\n\nDefault: \"default\""
msgstr "Die Breite der Git-Diff-Hunk-Markierungen in der Randleiste.\nVerwenden Sie \"default\", um mit der Pufferschriftgröße zu skalieren, oder {\"custom\": <pixels>} für eine feste Breite.\n\nStandard: \"default\""

msgctxt "settings schema"
msgid "The width of the indent guides in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "Die Breite der Einzugsführungslinien in Pixeln, zwischen 1 und 10.\n\nStandard: 1"

msgctxt "settings schema"
msgid "The window manager or compositor draws the server-side window\ndecorations (not supported by GNOME Wayland)."
msgstr "Der Fenstermanager oder Compositor zeichnet die serverseitigen Fensterdekorationen (unter GNOME Wayland nicht unterstützt)."

msgctxt "settings schema"
msgid "Theme name."
msgstr "Designname."

msgctxt "settings schema"
msgid "Thinking blocks are always collapsed by default."
msgstr "Denkblöcke sind standardmäßig immer zugeklappt."

msgctxt "settings schema"
msgid "Thinking blocks are always fully expanded by default (no height constraint)."
msgstr "Denkblöcke sind standardmäßig immer vollständig aufgeklappt (ohne Höhenbeschränkung)."

msgctxt "settings schema"
msgid "Thinking blocks auto-expand with a height constraint during streaming,\nthen remain in their constrained state when complete. Users can click\nto fully expand or collapse."
msgstr "Denkblöcke werden während des Streamings mit begrenzter Höhe automatisch aufgeklappt und bleiben nach Abschluss in diesem begrenzten Zustand. Benutzer können sie per Klick vollständig auf- oder zuklappen."

msgctxt "settings schema"
msgid "Thinking blocks fully expand during streaming, then auto-collapse\nwhen the model finishes thinking. Users can re-expand after collapse."
msgstr "Denkblöcke werden während des Streamings vollständig aufgeklappt und automatisch zugeklappt, wenn das Modell mit dem Denken fertig ist. Benutzer können sie danach wieder aufklappen."

msgctxt "settings schema"
msgid "Thinking effort levels this model accepts in Ollama's `think` parameter,\nfor example `[\"low\", \"medium\", \"high\"]`. Only some models (e.g. `gpt-oss`)\naccept a level instead of a plain on/off; leave unset for those that don't."
msgstr "Denkaufwand-Stufen, die dieses Modell im Ollama-Parameter `think` akzeptiert, zum Beispiel `[\"low\", \"medium\", \"high\"]`. Nur einige Modelle (z. B. `gpt-oss`) akzeptieren eine Stufe statt eines einfachen Ein/Aus; für die übrigen nicht setzen."

msgctxt "settings schema"
msgid "This base keymap settings adjusts the default keybindings in Zed to be similar\nto other common code editors. By default, Zed's keymap closely follows VSCode's\nkeymap, with minor adjustments, this corresponds to the \"VSCode\" setting.\n\nDefault: VSCode"
msgstr "Diese Basis-Keymap-Einstellung passt die Standard-Tastenkombinationen von ForgeKairos so an, dass sie anderen gängigen Code-Editoren ähneln. Standardmäßig folgt die Keymap von ForgeKairos mit kleinen Anpassungen weitgehend der Keymap von VSCode; dies entspricht der Einstellung \"VSCode\".\n\nStandard: VSCode"

msgctxt "settings schema"
msgid "Time in milliseconds until timeout error when connecting to a TCP debug adapter\n\nDefault: 2000ms"
msgstr "Zeit in Millisekunden bis zum Zeitüberschreitungsfehler beim Verbinden mit einem TCP-Debugadapter\n\nStandard: 2000ms"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before hiding the hover popover\nafter the mouse moves away from the hover target.\nOnly applies when `hover_popover_sticky` is enabled.\n\nDefault: 300"
msgstr "Wartezeit in Millisekunden, bevor das Hover-Popup ausgeblendet wird, nachdem die Maus das Hover-Ziel verlassen hat.\nGilt nur, wenn `hover_popover_sticky` aktiviert ist.\n\nStandard: 300"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before showing the informational hover box.\nThis delay also applies to auto signature help when `auto_signature_help` is enabled.\n\nDefault: 300"
msgstr "Wartezeit in Millisekunden, bevor das Hover-Infofeld angezeigt wird.\nDiese Verzögerung gilt auch für die automatische Signaturhilfe, wenn `auto_signature_help` aktiviert ist.\n\nStandard: 300"

msgctxt "settings schema"
msgid "Timeout for hover and Cmd-click path hyperlink discovery in milliseconds.\n\nDefault: 1"
msgstr "Zeitlimit in Millisekunden für die Erkennung von Pfad-Hyperlinks bei Hover und Cmd+Klick.\n\nStandard: 1"

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to 60 if not specified."
msgstr "Zeitlimit für Toolaufrufe in Sekunden. Standardmäßig 60, wenn nicht angegeben."

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to global context_server_timeout if not specified."
msgstr "Zeitlimit für Toolaufrufe in Sekunden. Standardmäßig der globale context_server_timeout, wenn nicht angegeben."

msgctxt "settings schema"
msgid "Timeout in milliseconds for automatically dismissing language server notifications.\nSet to 0 to disable auto-dismiss.\n\nDefault: 5000"
msgstr "Zeitlimit in Millisekunden, nach dem Benachrichtigungen von Sprachservern automatisch geschlossen werden.\nAuf 0 setzen, um das automatische Schließen zu deaktivieren.\n\nStandard: 5000"

msgctxt "settings schema"
msgid "Timeout in seconds for SSH connection and downloading the remote server binary.\nDefaults to 10 seconds if not specified."
msgstr "Zeitlimit in Sekunden für die SSH-Verbindung und den Download der Remote-Server-Binärdatei.\nOhne Angabe 10 Sekunden."

msgctxt "settings schema"
msgid "Toggles inlay hints (hides or shows) when the user presses the modifiers specified.\nIf only a subset of the modifiers specified is pressed, hints are not toggled.\nIf no modifiers are specified, this is equivalent to `null`.\n\nDefault: null"
msgstr "Schaltet Inlay-Hinweise um (blendet sie aus oder ein), wenn der Benutzer die angegebenen Zusatztasten drückt.\nWird nur ein Teil der angegebenen Zusatztasten gedrückt, werden die Hinweise nicht umgeschaltet.\nSind keine Zusatztasten angegeben, entspricht dies `null`.\n\nStandard: null"

msgctxt "settings schema"
msgid "Toolbar related settings"
msgstr "Einstellungen zur Symbolleiste"

msgctxt "settings schema"
msgid "Treat files and folders matching these glob patterns as hidden, including\nfiles inside matching folders. To hide these entries, run\n`project panel: toggle hide hidden` from the command palette or set\n`project_panel.hide_hidden` to `true`.\n\nDefault:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Behandelt Dateien und Ordner, die diesen Glob-Mustern entsprechen, als versteckt, einschließlich der Dateien in passenden Ordnern. Um diese Einträge auszublenden, führen Sie `project panel: toggle hide hidden` aus der Befehlspalette aus oder setzen Sie `project_panel.hide_hidden` auf `true`.\n\nStandard:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nVerwenden Sie `\"...\"`, um Muster hinzuzufügen, ohne die Standardwerte von ForgeKairos zu wiederholen. In Projekteinstellungen wird damit der Wert der Benutzer- oder übergeordneten Konfiguration erweitert. Lassen Sie `\"...\"` weg, um die geerbte Liste zu ersetzen.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nGeerbte Muster werden an der Stelle von `\"...\"` eingefügt, und bei Duplikaten bleibt das erste Vorkommen erhalten."

msgctxt "settings schema"
msgid "Treat files matching these glob patterns as read-only when opened. You can\nview but not edit them, which is useful for build outputs, external\ndependencies, or generated files.\n\nDefault:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Behandelt Dateien, die diesen Glob-Mustern entsprechen, beim Öffnen als schreibgeschützt. Sie können sie ansehen, aber nicht bearbeiten; das ist nützlich für Build-Ausgaben, externe Abhängigkeiten oder generierte Dateien.\n\nStandard:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nVerwenden Sie `\"...\"`, um Muster hinzuzufügen, ohne die Standardwerte von ForgeKairos zu wiederholen. In Projekteinstellungen wird damit der Wert der Benutzer- oder übergeordneten Konfiguration erweitert. Lassen Sie `\"...\"` weg, um die geerbte Liste zu ersetzen.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nGeerbte Muster werden an der Stelle von `\"...\"` eingefügt, und bei Duplikaten bleibt das erste Vorkommen erhalten."

msgctxt "settings schema"
msgid "Treat the files matching these globs as `.env` files.\nDefault: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"
msgstr "Behandelt Dateien, die diesen Glob-Mustern entsprechen, als `.env`-Dateien.\nStandard: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"

msgctxt "settings schema"
msgid "UNSTABLE: Expect many elements to be broken."
msgstr "INSTABIL: Es ist damit zu rechnen, dass viele Elemente fehlerhaft sind."

msgctxt "settings schema"
msgid "Underline cursor."
msgstr "Unterstrich-Cursor."

msgctxt "settings schema"
msgid "Uppercase names are grouped before lowercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Namen in Großbuchstaben werden vor Namen in Kleinbuchstaben gruppiert, mit natürlicher Sortierung ohne Beachtung der Groß-/Kleinschreibung innerhalb jeder Gruppe. Namen mit vorangestelltem Punkt werden vor beiden Gruppen einsortiert."

msgctxt "settings schema"
msgid "Use CRLF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "CRLF für neue Dateien und Dateien ohne bestehende Zeilenende-Konvention verwenden, vorhandene LF- oder CRLF-Dateien aber beibehalten."

msgctxt "settings schema"
msgid "Use LF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "LF für neue Dateien und Dateien ohne bestehende Zeilenende-Konvention verwenden, vorhandene LF- oder CRLF-Dateien aber beibehalten."

msgctxt "settings schema"
msgid "Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server."
msgstr "Verwendet LSP-Faltung, wo immer möglich, und greift auf tree-sitter- und einrückungsbasierte Faltung zurück, wenn der Server keine Ergebnisse zurückgegeben hat."

msgctxt "settings schema"
msgid "Use LSP semantic tokens exclusively, replacing tree-sitter highlighting."
msgstr "Verwendet ausschließlich semantische LSP-Token und ersetzt damit die tree-sitter-Hervorhebung."

msgctxt "settings schema"
msgid "Use LSP semantic tokens together with tree-sitter highlighting."
msgstr "Verwendet semantische LSP-Token zusammen mit der tree-sitter-Hervorhebung."

msgctxt "settings schema"
msgid "Use LSP tasks over Zed language extension ones.\nIf no LSP tasks are returned due to error/timeout or regular execution,\nZed language extension tasks will be used instead.\n\nOther Zed tasks will still be shown:\n* Zed task from either of the task config file\n* Zed task from history (e.g. one-off task was spawned before)"
msgstr "LSP-Aufgaben gegenüber denen der Spracherweiterungen von ForgeKairos bevorzugen.\nWerden aufgrund eines Fehlers/einer Zeitüberschreitung oder bei regulärer Ausführung keine LSP-Aufgaben zurückgegeben, werden stattdessen die Aufgaben der Spracherweiterungen von ForgeKairos verwendet.\n\nAndere ForgeKairos-Aufgaben werden weiterhin angezeigt:\n* ForgeKairos-Aufgaben aus einer der Aufgabenkonfigurationsdateien\n* ForgeKairos-Aufgaben aus dem Verlauf (z. B. wenn zuvor eine einmalige Aufgabe gestartet wurde)"

msgctxt "settings schema"
msgid "Use a custom line height."
msgstr "Verwendet eine benutzerdefinierte Zeilenhöhe."

msgctxt "settings schema"
msgid "Use a different color for each indentation level."
msgstr "Verwendet für jede Einrückungsebene eine andere Farbe."

msgctxt "settings schema"
msgid "Use a line height that's comfortable for reading, 1.618"
msgstr "Verwendet eine für das Lesen angenehme Zeilenhöhe: 1.618"

msgctxt "settings schema"
msgid "Use a specific program with arguments."
msgstr "Verwendet ein bestimmtes Programm mit Argumenten."

msgctxt "settings schema"
msgid "Use a specific program with no arguments."
msgstr "Verwendet ein bestimmtes Programm ohne Argumente."

msgctxt "settings schema"
msgid "Use a standard line height, 1.3. This option is useful for TUIs,\nparticularly if they use box characters"
msgstr "Eine Standard-Zeilenhöhe von 1.3 verwenden. Diese Option ist nützlich für TUIs, besonders wenn sie Rahmenzeichen verwenden"

msgctxt "settings schema"
msgid "Use all gitignored files"
msgstr "Alle per .gitignore ignorierten Dateien verwenden"

msgctxt "settings schema"
msgid "Use conda"
msgstr "conda verwenden"

msgctxt "settings schema"
msgid "Use grayscale text rendering."
msgstr "Verwendet Graustufen-Textrendering."

msgctxt "settings schema"
msgid "Use macOS's native fullscreen, which moves the window into its own\nMission Control space."
msgstr "Den nativen Vollbildmodus von macOS verwenden, der das Fenster in einen eigenen Mission-Control-Space verschiebt."

msgctxt "settings schema"
msgid "Use mamba"
msgstr "mamba verwenden"

msgctxt "settings schema"
msgid "Use micromamba"
msgstr "micromamba verwenden"

msgctxt "settings schema"
msgid "Use only the files Zed had indexed"
msgstr "Nur von ForgeKairos indizierte Dateien verwenden"

msgctxt "settings schema"
msgid "Use platform default behavior."
msgstr "Verwendet das Standardverhalten der Plattform."

msgctxt "settings schema"
msgid "Use subpixel (ClearType-style) text rendering."
msgstr "Verwendet Subpixel-Textrendering (ClearType-Stil)."

msgctxt "settings schema"
msgid "Use system clipboard for yank operations."
msgstr "Verwendet die Systemzwischenablage für Yank-Operationen."

msgctxt "settings schema"
msgid "Use system clipboard."
msgstr "Verwendet die Systemzwischenablage."

msgctxt "settings schema"
msgid "Use the current file's directory, falling back to the project directory,\nthen the first project in the workspace."
msgstr "Das Verzeichnis der aktuellen Datei verwenden, ersatzweise das Projektverzeichnis, danach das erste Projekt im Arbeitsbereich."

msgctxt "settings schema"
msgid "Use the current file's project directory. Fallback to the\nfirst project directory strategy if unsuccessful."
msgstr "Das Projektverzeichnis der aktuellen Datei verwenden. Bei Misserfolg auf die Strategie „erstes Projektverzeichnis“ zurückgreifen."

msgctxt "settings schema"
msgid "Use the first project in this workspace's directory. Fallback to using\nthis platform's home directory."
msgstr "Das Verzeichnis des ersten Projekts in diesem Arbeitsbereich verwenden. Ersatzweise das Home-Verzeichnis dieser Plattform verwenden."

msgctxt "settings schema"
msgid "Use the language server's `textDocument/documentSymbol` LSP response for outlines and\nbreadcrumbs. When enabled, tree-sitter is not used for document symbols."
msgstr "Die LSP-Antwort `textDocument/documentSymbol` des Sprachservers für Gliederungen und Breadcrumbs verwenden. Wenn aktiviert, wird Tree-sitter nicht für Dokumentsymbole verwendet."

msgctxt "settings schema"
msgid "Use the preference previously set via the status-bar toggle, or false\nif no preference has been stored."
msgstr "Die zuvor über den Schalter in der Statusleiste gesetzte Einstellung verwenden, oder false, wenn keine Einstellung gespeichert ist."

msgctxt "settings schema"
msgid "Use the same color for all indentation levels."
msgstr "Verwendet für alle Einrückungsebenen dieselbe Farbe."

msgctxt "settings schema"
msgid "Use the specified `dark` theme."
msgstr "Verwendet das angegebene `dark`-Design."

msgctxt "settings schema"
msgid "Use the specified `light` theme."
msgstr "Verwendet das angegebene `light`-Design."

msgctxt "settings schema"
msgid "Use the system's default terminal configuration in /etc/passwd"
msgstr "Verwendet die Standard-Terminaleinstellung des Systems aus /etc/passwd"

msgctxt "settings schema"
msgid "Use the theme based on the system's appearance."
msgstr "Verwendet das Design entsprechend der Systemdarstellung."

msgctxt "settings schema"
msgid "Use tree-sitter queries to compute document symbols for outlines and breadcrumbs (default)."
msgstr "Verwendet tree-sitter-Abfragen zur Berechnung von Dokumentsymbolen für Gliederungen und Breadcrumbs (Standard)."

msgctxt "settings schema"
msgid "Used for the background of a ghost element that should have the same background as the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have a different background than the surface it's on, use `element_background`."
msgstr "Wird für den Hintergrund eines Ghost-Elements verwendet, das denselben Hintergrund wie die Fläche haben soll, auf der es liegt.\n\nElemente können sein: Schaltflächen, Eingabefelder, Kontrollkästchen, Optionsfelder...\n\nFür ein Element, das einen anderen Hintergrund als die Fläche haben soll, auf der es liegt, verwenden Sie `element_background`."

msgctxt "settings schema"
msgid "Vertical bar cursor."
msgstr "Vertikaler Balkencursor."

msgctxt "settings schema"
msgid "Vertically center the target in the viewport."
msgstr "Ziel im Ansichtsbereich vertikal zentrieren."

msgctxt "settings schema"
msgid "Visible characters used to render whitespace when show_whitespaces is enabled.\n\nDefault: \"•\" for spaces, \"→\" for tabs."
msgstr "Sichtbare Zeichen zur Darstellung von Leerraum, wenn show_whitespaces aktiviert ist.\n\nStandard: \"•\" für Leerzeichen, \"→\" für Tabulatoren."

msgctxt "settings schema"
msgid "What `git reset` keeps of the changes."
msgstr "Was `git reset` von den Änderungen behält."

msgctxt "settings schema"
msgid "What base settings to start from before applying this profile's overrides.\n\n- `user`: Apply on top of user's settings (default)\n- `default`: Apply on top of Zed's default settings, ignoring user customizations"
msgstr "Von welchen Basiseinstellungen ausgegangen wird, bevor die Überschreibungen dieses Profils angewendet werden.\n\n- `user`: Auf die Benutzereinstellungen anwenden (Standard)\n- `default`: Auf die Standardeinstellungen von ForgeKairos anwenden, Benutzeranpassungen werden ignoriert"

msgctxt "settings schema"
msgid "What format to display the hours in.\n\nDefault: hour12"
msgstr "In welchem Format Stunden angezeigt werden.\n\nStandard: hour12"

msgctxt "settings schema"
msgid "What shell to use when opening a terminal.\n\nDefault: system"
msgstr "Welche Shell beim Öffnen eines Terminals verwendet wird.\n\nStandard: system"

msgctxt "settings schema"
msgid "What the default branch name should be when\n`init.defaultBranch` is not set in git\n\nDefault: main"
msgstr "Wie der Standardbranch heißen soll, wenn `init.defaultBranch` in Git nicht gesetzt ist\n\nStandard: main"

msgctxt "settings schema"
msgid "What to do after closing the current tab.\n\nDefault: history"
msgstr "Was nach dem Schließen des aktuellen Tabs geschieht.\n\nStandard: history"

msgctxt "settings schema"
msgid "What to do when go to definition yields no results."
msgstr "Legt fest, was geschieht, wenn „Zur Definition wechseln“ keine Ergebnisse liefert."

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts\n(parts of singleton buffers).\n\nDefault: select"
msgstr "Was geschieht, wenn in einem Multibuffer auf einen seiner Auszüge (Teile einzelner Puffer) doppelgeklickt wird.\n\nStandard: select"

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts (parts of singleton buffers)."
msgstr "Legt fest, was geschieht, wenn auf einen Auszug im Multibuffer (Teil eines einzelnen Puffers) doppelt geklickt wird."

msgctxt "settings schema"
msgid "What to do when the `BEL` character (`\\a`) is printed to terminal.\n\nDefault: \"system\""
msgstr "Was geschieht, wenn das Zeichen `BEL` (`\\a`) im Terminal ausgegeben wird.\n\nStandard: \"system\""

msgctxt "settings schema"
msgid "What to do when the last window is closed\n\nDefault: auto (nothing on macOS, \"app quit\" otherwise)"
msgstr "Was geschieht, wenn das letzte Fenster geschlossen wird\n\nStandard: auto (unter macOS nichts, sonst \"app quit\")"

msgctxt "settings schema"
msgid "What to show for directories in the git panel.\n\nDefault: icon"
msgstr "Was für Verzeichnisse im Git-Panel angezeigt wird.\n\nStandard: icon"

msgctxt "settings schema"
msgid "What to show for directories in the outline panel.\n\nDefault: icon"
msgstr "Was für Verzeichnisse im Gliederungspanel angezeigt wird.\n\nStandard: icon"

msgctxt "settings schema"
msgid "What to show for directories in the project panel.\n\nDefault: icon"
msgstr "Was für Verzeichnisse im Projektpanel angezeigt wird.\n\nStandard: icon"

msgctxt "settings schema"
msgid "What to show when opening a new window.\nValues: empty_tab, launchpad\nDefault: launchpad"
msgstr "Was beim Öffnen eines neuen Fensters angezeigt wird.\nWerte: empty_tab, launchpad\nStandard: launchpad"

msgctxt "settings schema"
msgid "What working directory to use when launching the terminal\n\nDefault: current_project_directory"
msgstr "Welches Arbeitsverzeichnis beim Starten des Terminals verwendet wird\n\nStandard: current_project_directory"

msgctxt "settings schema"
msgid "When enabled, edit predictions are shown in Vim normal mode.\nBy default, edit predictions are only shown in insert and replace modes."
msgstr "Wenn aktiviert, werden Bearbeitungsvorhersagen im Vim-Normalmodus angezeigt.\nStandardmäßig werden Bearbeitungsvorhersagen nur im Einfüge- und Ersetzungsmodus angezeigt."

msgctxt "settings schema"
msgid "When enabled, the `:substitute` command replaces all matches in a line\nby default. The 'g' flag then toggles this behavior.,"
msgstr "Wenn aktiviert, ersetzt der Befehl `:substitute` standardmäßig alle Treffer in einer Zeile. Das Flag 'g' kehrt dieses Verhalten dann um.,"

msgctxt "settings schema"
msgid "When false, forcefully disables the horizontal scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Wenn false, wird die horizontale Scrollleiste zwangsweise deaktiviert. Andernfalls gelten die übrigen Einstellungen.\n\nStandard: true"

msgctxt "settings schema"
msgid "When false, forcefully disables the vertical scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Wenn false, wird die vertikale Scrollleiste zwangsweise deaktiviert. Andernfalls gelten die übrigen Einstellungen.\n\nStandard: true"

msgctxt "settings schema"
msgid "When fetching LSP completions, determines how long to wait for a response of a particular server.\nWhen set to 0, waits indefinitely.\n\nDefault: 0"
msgstr "Legt beim Abrufen von LSP-Vervollständigungen fest, wie lange auf die Antwort eines bestimmten Servers gewartet wird.\nBei 0 wird unbegrenzt gewartet.\n\nStandard: 0"

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane."
msgstr "Wann das Agent-Panel die Tab-Leiste seines eigenen Bereichs anzeigt."

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane.\n\nDefault: auto"
msgstr "Wann das Agent-Panel die Tab-Leiste seines eigenen Bereichs anzeigt.\n\nStandard: auto"

msgctxt "settings schema"
msgid "When the attachments of one message add up to more than this many\nbytes, the largest ones are sent as an outline or a reference until the\nmessage fits. Attachments set to be sent in full are never reduced.\n\nDefault: 65536"
msgstr "Wenn die Anhänge einer Nachricht zusammen mehr als diese Anzahl Bytes ergeben, werden die größten als Gliederung oder Verweis gesendet, bis die Nachricht passt. Anhänge, die vollständig gesendet werden sollen, werden nie reduziert.\n\nStandard: 65536"

msgctxt "settings schema"
msgid "When to automatically save edited buffers.\n\nDefault: off"
msgstr "Wann bearbeitete Puffer automatisch gespeichert werden.\n\nStandard: off"

msgctxt "settings schema"
msgid "When to index the worktree's C and C++ files.\n\nDefault: auto"
msgstr "Wann die C- und C++-Dateien des Worktrees indiziert werden.\n\nStandard: auto"

msgctxt "settings schema"
msgid "When to play a sound when the agent has either completed its response, or needs user input.\n\nDefault: never"
msgstr "Wann ein Ton abgespielt wird, wenn der Agent seine Antwort abgeschlossen hat oder eine Benutzereingabe benötigt.\n\nStandard: never"

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor."
msgstr "Legt fest, wann die Suchanfrage einer neuen Suche anhand des Textes unter dem Cursor vorbelegt wird."

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor.\n\nDefault: always"
msgstr "Wann die Abfrage einer neuen Suche anhand des Texts unter dem Cursor vorausgefüllt wird.\n\nStandard: always"

msgctxt "settings schema"
msgid "When to scan content of linked directories."
msgstr "Legt fest, wann der Inhalt symbolisch verknüpfter Verzeichnisse gescannt wird."

msgctxt "settings schema"
msgid "When to scan content of linked directories.\n\nDefault: expanded"
msgstr "Wann der Inhalt verknüpfter Verzeichnisse gescannt wird.\n\nStandard: expanded"

msgctxt "settings schema"
msgid "When to show the minimap in the editor.\n\nDefault: never"
msgstr "Wann die Minimap im Editor angezeigt wird.\n\nStandard: never"

msgctxt "settings schema"
msgid "When to show the minimap thumb.\n\nDefault: always"
msgstr "Wann der Schieberegler der Minimap angezeigt wird.\n\nStandard: always"

msgctxt "settings schema"
msgid "When to show the scrollbar in the completion menu.\nThis setting can take four values:\n\n1. Show the scrollbar if there's important information or\n   follow the system's configured behavior\n  \"auto\"\n2. Match the system's configured behavior:\n   \"system\"\n3. Always show the scrollbar:\n   \"always\"\n4. Never show the scrollbar:\n   \"never\" (default)"
msgstr "Wann die Scrollleiste im Vervollständigungsmenü angezeigt wird.\nDiese Einstellung kann vier Werte annehmen:\n\n1. Die Scrollleiste anzeigen, wenn wichtige Informationen vorliegen, oder\n   dem im System konfigurierten Verhalten folgen\n  \"auto\"\n2. Dem im System konfigurierten Verhalten entsprechen:\n   \"system\"\n3. Die Scrollleiste immer anzeigen:\n   \"always\"\n4. Die Scrollleiste nie anzeigen:\n   \"never\" (Standard)"

msgctxt "settings schema"
msgid "When to show the scrollbar in the editor.\n\nDefault: auto"
msgstr "Wann die Scrollleiste im Editor angezeigt wird.\n\nStandard: auto"

msgctxt "settings schema"
msgid "When to show the scrollbar in the outline panel."
msgstr "Legt fest, wann die Scrollleiste im Gliederungspanel angezeigt wird."

msgctxt "settings schema"
msgid "When to show the scrollbar in the project panel.\n\nDefault: inherits editor scrollbar settings"
msgstr "Wann die Scrollleiste im Projektpanel angezeigt wird.\n\nStandard: übernimmt die Scrollleisteneinstellungen des Editors"

msgctxt "settings schema"
msgid "When to show the scrollbar in the terminal.\n\nDefault: inherits editor scrollbar settings"
msgstr "Wann die Scrollleiste im Terminal angezeigt wird.\n\nStandard: übernimmt die Scrollleisteneinstellungen des Editors"

msgctxt "settings schema"
msgid "When to show the scrollbar.\n\nDefault: auto"
msgstr "Wann die Scrollleiste angezeigt wird.\n\nStandard: auto"

msgctxt "settings schema"
msgid "When true, enables drag and drop text selection in buffer.\n\nDefault: true"
msgstr "Wenn true, wird Drag & Drop für Textauswahlen im Puffer aktiviert.\n\nStandard: true"

msgctxt "settings schema"
msgid "When using OpenAiChat protocol, whether thinking tokens are sent as a dedicated `reasoning_content` field or inline in message text."
msgstr "Bei Verwendung des OpenAiChat-Protokolls: ob Denk-Token als dediziertes `reasoning_content`-Feld oder inline im Nachrichtentext gesendet werden."

msgctxt "settings schema"
msgid "Where to dock the AI browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Wo das KI-Browser-Panel angedockt wird. Mögliche Werte: 'left', 'right' oder 'bottom'.\n\nStandard: right"

msgctxt "settings schema"
msgid "Where to dock the agent panel.\n\nDefault: left (Agentic layout), right (Classic layout)"
msgstr "Wo das Agent-Panel angedockt wird.\n\nStandard: left (Agentic-Layout), right (Classic-Layout)"

msgctxt "settings schema"
msgid "Where to dock the browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Wo das Browser-Panel angedockt wird. Mögliche Werte: 'left', 'right' oder 'bottom'.\n\nStandard: right"

msgctxt "settings schema"
msgid "Where to dock the call graph panel.\n\nDefault: right"
msgstr "Wo das Aufrufgraph-Panel angedockt wird.\n\nStandard: right"

msgctxt "settings schema"
msgid "Where to dock the panel.\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "Wo das Panel angedockt wird.\n\nStandard: right (Agentic-Layout), left (Classic-Layout)"

msgctxt "settings schema"
msgid "Where to keep the changes."
msgstr "Wo die Änderungen behalten werden."

msgctxt "settings schema"
msgid "Where to position the threads sidebar."
msgstr "Wo die Thread-Seitenleiste positioniert werden soll."

msgctxt "settings schema"
msgid "Where to position the threads sidebar.\n\nDefault: left"
msgstr "Wo die Thread-Seitenleiste positioniert wird.\n\nStandard: left"

msgctxt "settings schema"
msgid "Where to render the blame information when enabled.\n\nDefault: inline"
msgstr "Wo die Blame-Informationen angezeigt werden, wenn aktiviert.\n\nStandard: inline"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations\n(Go to Definition, Go to Implementation, Find All References). A single\nresult always opens directly. Individual actions can override this with\ntheir `open_results_in` argument.\n\nDefault: multi_buffer"
msgstr "Wo LSP-Ergebnisse angezeigt werden, die mehrere Orte enthalten können (Zur Definition wechseln, Zur Implementierung wechseln, Alle Referenzen suchen). Ein einzelnes Ergebnis wird immer direkt geöffnet. Einzelne Aktionen können dies mit ihrem Argument `open_results_in` überschreiben.\n\nStandard: multi_buffer"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations."
msgstr "Legt fest, wo LSP-Ergebnisse angezeigt werden, die mehrere Positionen enthalten können."

msgctxt "settings schema"
msgid "Where to show a popup notification when the agent is waiting for user input.\n\nDefault: \"primary_screen\""
msgstr "Wo eine Popup-Benachrichtigung angezeigt wird, wenn der Agent auf eine Benutzereingabe wartet.\n\nStandard: \"primary_screen\""

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: [`DisplayIn::ActiveEditor`]"
msgstr "Wo die Minimap im Editor angezeigt wird.\n\nStandard: [`DisplayIn::ActiveEditor`]"

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: all_editors"
msgstr "Wo die Minimap im Editor angezeigt wird.\n\nStandard: all_editors"

msgctxt "settings schema"
msgid "Whether \"Launch Claude Code\" always launches outside the sandbox, without\nasking. Outside, writes are not restricted, and network restrictions only\napply to programs that read the proxy settings (and not at all on SSH\nhosts). Can only be set in the user settings, not in a project's settings.\n\nDefault: false"
msgstr "Legt fest, ob „Claude Code starten“ immer ohne Rückfrage außerhalb der Sandbox startet. Außerhalb sind Schreibzugriffe nicht eingeschränkt, und Netzwerkeinschränkungen gelten nur für Programme, die die Proxy-Einstellungen lesen (auf SSH-Hosts überhaupt nicht). Kann nur in den Benutzereinstellungen gesetzt werden, nicht in den Einstellungen eines Projekts.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether AI agents (the built-in agent and MCP clients) may drive the\nbuilt-in browser's AI tabs, for debugging web apps.\n\nAI tabs use their own browser profile and always go through the egress\nallowlist proxy, whatever `use_egress_proxy` says.\n\nDefault: false"
msgstr "Legt fest, ob KI-Agenten (der integrierte Agent und MCP-Clients) die KI-Tabs des integrierten Browsers zum Debuggen von Web-Apps steuern dürfen.\n\nKI-Tabs verwenden ein eigenes Browserprofil und laufen unabhängig vom Wert von `use_egress_proxy` immer über den Proxy der Zulassungsliste für ausgehende Verbindungen.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether Anthropic's fast mode is available for this model."
msgstr "Gibt an, ob der Schnellmodus von Anthropic für dieses Modell verfügbar ist."

msgctxt "settings schema"
msgid "Whether SSH terminals keep their shell running on the remote host\nacross disconnects, and for how long."
msgstr "Legt fest, ob SSH-Terminals ihre Shell auf dem Remote-Host über Verbindungsabbrüche hinweg weiterlaufen lassen und wie lange."

msgctxt "settings schema"
msgid "Whether a new agent thread starts with Git operations turned on: the\nagent gets the `git` tool, which runs git (with every hook turned off)\nafter each call is approved. The chat input's Git button turns it on\nor off for one thread.\n\nDefault: true"
msgstr "Legt fest, ob ein neuer Agent-Thread mit aktivierten Git-Vorgängen beginnt: Der Agent erhält das Tool `git`, das Git (mit allen Hooks deaktiviert) ausführt, nachdem jeder Aufruf genehmigt wurde. Die Git-Schaltfläche in der Chateingabe schaltet dies für einen Thread ein oder aus.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether a terminal opened over SSH runs its shell inside a session the\nremote server keeps alive, so that a dropped connection neither stops\nrunning commands nor loses the output: reconnecting shows everything\nagain and continues. Only for SSH hosts that are not Windows.\n\nDefault: true"
msgstr "Legt fest, ob ein über SSH geöffnetes Terminal seine Shell in einer Sitzung ausführt, die der Remote-Server am Leben hält, sodass eine abgebrochene Verbindung weder laufende Befehle stoppt noch die Ausgabe verliert: Beim erneuten Verbinden wird alles wieder angezeigt und es geht weiter. Nur für SSH-Hosts, die nicht unter Windows laufen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether a worktree an agent wrote into stops running its own code\n(project language server modes, formatters, the project's prettier)\nuntil the user reviews the changes and resumes it. Read from the user\nsettings file only: project and server settings cannot turn it off.\n\nDefault: true"
msgstr "Legt fest, ob ein Worktree, in den ein Agent geschrieben hat, die Ausführung seines eigenen Codes (Projektmodi von Sprachservern, Formatierer, das Prettier des Projekts) anhält, bis der Benutzer die Änderungen prüft und ihn fortsetzt. Wird nur aus der Benutzereinstellungsdatei gelesen: Projekt- und Servereinstellungen können dies nicht deaktivieren.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether agents connected over the IDE server may read the output of the\nlast task that failed in this window (the `getLastTaskOutput` tool, at\nmost the last 4 KB of the task's terminal).\n\nDefault: true"
msgstr "Legt fest, ob über den IDE-Server verbundene Agenten die Ausgabe der letzten in diesem Fenster fehlgeschlagenen Aufgabe lesen dürfen (das Tool `getLastTaskOutput`, höchstens die letzten 4 KB des Terminals der Aufgabe).\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether all context servers are enabled by default."
msgstr "Gibt an, ob alle Kontextserver standardmäßig aktiviert sind."

msgctxt "settings schema"
msgid "Whether and how to display code lenses from language servers.\n\nDefault: \"off\""
msgstr "Legt fest, ob und wie CodeLens-Elemente von Sprachservern angezeigt werden.\n\nStandard: \"off\""

msgctxt "settings schema"
msgid "Whether anything the agent features start may run outside the sandbox\nat all. While this is off, every new way out is refused without asking:\nagent terminal commands that cannot run in the sandbox (and\n`allow_unsandboxed`, which is then ignored), external agents and Claude\nCode started outside it (the one-time starts and the \"always outside\"\nsettings, which are then ignored), and threads resumed outside it. A\nconnection already running outside the sandbox keeps running, and MCP\nservers (context servers) are not covered. While it is on, each of\nthose asks or follows its own setting as before. Only the user settings\nfile is read: neither a project's settings nor an agent can turn it on.\nDefault: false"
msgstr "Legt fest, ob überhaupt etwas, das die Agent-Funktionen starten, außerhalb der Sandbox laufen darf. Solange dies deaktiviert ist, wird jeder neue Weg nach draußen ohne Rückfrage abgelehnt: Agent-Terminalbefehle, die nicht in der Sandbox laufen können (und `allow_unsandboxed`, das dann ignoriert wird), externe Agenten und Claude Code, die außerhalb gestartet werden (die einmaligen Starts und die Einstellungen „immer außerhalb“, die dann ignoriert werden), sowie außerhalb fortgesetzte Threads. Eine bereits außerhalb der Sandbox laufende Verbindung läuft weiter, und MCP-Server (Kontextserver) sind nicht betroffen. Solange dies aktiviert ist, fragt jeder dieser Fälle wie bisher nach oder folgt seiner eigenen Einstellung. Nur die Benutzereinstellungsdatei wird gelesen: Weder die Einstellungen eines Projekts noch ein Agent können dies aktivieren.\nStandard: false"

msgctxt "settings schema"
msgid "Whether clangd indexes the whole project in the background. `light`\nskips that index (`--background-index=false`), which saves the most\nmemory: references, call hierarchy and renames then only cover the\nfiles that are open. Ignored when `lsp.clangd.binary.arguments`\nalready has `--background-index`.\n\nDefault: full"
msgstr "Legt fest, ob clangd das ganze Projekt im Hintergrund indiziert. `light` lässt diesen Index aus (`--background-index=false`) und spart so am meisten Speicher: Referenzen, Aufrufhierarchie und Umbenennungen umfassen dann nur die geöffneten Dateien. Wird ignoriert, wenn `lsp.clangd.binary.arguments` bereits `--background-index` enthält.\n\nStandard: full"

msgctxt "settings schema"
msgid "Whether clicking the stop button on a running terminal tool should also cancel the agent's generation.\nNote that this only applies to the stop button, not to ctrl+c inside the terminal.\n\nDefault: true"
msgstr "Legt fest, ob ein Klick auf die Stopp-Schaltfläche eines laufenden Terminal-Tools auch die Generierung des Agenten abbricht.\nDies gilt nur für die Stopp-Schaltfläche, nicht für ctrl+c im Terminal.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether cmd-click (ctrl-click on Linux and Windows) opens hyperlinks even\nwhen the terminal application has enabled mouse reporting (e.g. vim with\nmouse=a, htop). When false, these clicks are forwarded to the application\ninstead, and hyperlinks can still be opened with shift-cmd-click\n(shift-ctrl-click).\n\nDefault: true"
msgstr "Legt fest, ob Cmd+Klick (Ctrl+Klick unter Linux und Windows) Hyperlinks auch dann öffnet, wenn die Terminalanwendung die Mausmeldung aktiviert hat (z. B. vim mit mouse=a, htop). Bei false werden diese Klicks stattdessen an die Anwendung weitergeleitet, und Hyperlinks lassen sich weiterhin mit Shift+Cmd+Klick (Shift+Ctrl+Klick) öffnen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether cursor movement animation is enabled.\n\nDefault: false"
msgstr "Legt fest, ob die Animation von Cursorbewegungen aktiviert ist.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether every new terminal starts recording its output automatically.\n\nDefault: false"
msgstr "Legt fest, ob jedes neue Terminal automatisch beginnt, seine Ausgabe aufzuzeichnen.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether hovering a name in C and C++ also shows what its type holds\n(members, enumerators, a macro's definition), found by name in the\nindex.\n\nDefault: true"
msgstr "Legt fest, ob beim Hover über einen Namen in C und C++ auch der Inhalt seines Typs (Member, Enumeratoren, die Definition eines Makros) angezeigt wird, per Namen im Index gefunden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether indentation of pasted content should be adjusted based on the context.\n\nDefault: true"
msgstr "Legt fest, ob die Einrückung eingefügter Inhalte anhand des Kontexts angepasst wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether invoking a panel's `ToggleFocus` action while the panel is\nalready focused closes the panel, instead of just moving focus back\nto the editor. This only applies to a panel's focus-toggle action, not\nto its regular visibility-toggle action.\n\nDefault: false"
msgstr "Legt fest, ob das Ausführen der Aktion `ToggleFocus` eines Panels, während dieses bereits fokussiert ist, das Panel schließt, statt nur den Fokus zurück in den Editor zu verschieben. Dies gilt nur für die Fokus-Umschaltaktion eines Panels, nicht für seine normale Aktion zum Ein-/Ausblenden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether newly opened file diffs show the full file instead of changes only.\n\nDefault: true"
msgstr "Legt fest, ob neu geöffnete Datei-Diffs die vollständige Datei statt nur der Änderungen zeigen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether opening a folder in an existing window automatically opens the\nThreads Sidebar. Applies when `default_open_behavior` or\n`cli_default_open_behavior` is set to `existing_window`.\n\nDefault: true"
msgstr "Legt fest, ob beim Öffnen eines Ordners in einem vorhandenen Fenster automatisch die Thread-Seitenleiste geöffnet wird. Gilt, wenn `default_open_behavior` oder `cli_default_open_behavior` auf `existing_window` gesetzt ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not selecting text in the terminal will automatically\ncopy to the system clipboard.\n\nDefault: false"
msgstr "Legt fest, ob ausgewählter Text im Terminal automatisch in die Zwischenablage des Systems kopiert wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether or not to automatically check for updates.\n\nDefault: false"
msgstr "Legt fest, ob automatisch nach Updates gesucht wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer edits.\n\nSet to 0 to disable debouncing.\n\nDefault: 700"
msgstr "Legt fest, ob Aktualisierungen von Inlay-Hinweisen nach Pufferbearbeitungen entprellt werden.\n\nAuf 0 setzen, um die Entprellung zu deaktivieren.\n\nStandard: 700"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer scrolls.\n\nSet to 0 to disable debouncing.\n\nDefault: 50"
msgstr "Legt fest, ob Aktualisierungen von Inlay-Hinweisen nach dem Scrollen im Puffer entprellt werden.\n\nAuf 0 setzen, um die Entprellung zu deaktivieren.\n\nStandard: 50"

msgctxt "settings schema"
msgid "Whether or not to enable Helix mode.\n\nDefault: false"
msgstr "Legt fest, ob der Helix-Modus aktiviert wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether or not to enable Vim mode.\n\nDefault: false"
msgstr "Legt fest, ob der Vim-Modus aktiviert wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether or not to ensure there's a single newline at the end of a buffer\nwhen saving it.\n\nDefault: true"
msgstr "Legt fest, ob beim Speichern sichergestellt wird, dass am Ende eines Puffers genau ein Zeilenumbruch steht.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to include warning diagnostics.\n\nDefault: true"
msgstr "Legt fest, ob Warnungen unter den Diagnosen einbezogen werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to keep the tab bar buttons on panes that are not active.\nWhen disabled, only the focused pane shows them, so a split leaves the\nother panes without a new / split / zoom button.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltflächen der Tab-Leiste auch in nicht aktiven Bereichen erhalten bleiben.\nWenn deaktiviert, zeigt nur der fokussierte Bereich sie an, sodass nach einer Teilung die anderen Bereiche keine Schaltflächen für Neu / Teilen / Zoomen haben.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to perform a buffer format before saving.\n\nDefault: on"
msgstr "Legt fest, ob ein Puffer vor dem Speichern formatiert wird.\n\nStandard: on"

msgctxt "settings schema"
msgid "Whether or not to prompt the user to confirm before closing the application.\n\nDefault: false"
msgstr "Legt fest, ob vor dem Schließen der Anwendung eine Bestätigung angefordert wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether or not to remove any trailing whitespace from lines of a buffer\nbefore saving it.\n\nDefault: true"
msgstr "Legt fest, ob vor dem Speichern nachgestellter Leerraum aus den Zeilen eines Puffers entfernt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to restore unsaved buffers on restart.\n\nIf this is true, user won't be prompted whether to save/discard\ndirty files when closing the application.\n\nDefault: true"
msgstr "Legt fest, ob nicht gespeicherte Puffer beim Neustart wiederhergestellt werden.\n\nWenn true, wird der Benutzer beim Schließen der Anwendung nicht gefragt, ob geänderte Dateien gespeichert oder verworfen werden sollen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: on"
msgstr "Legt fest, ob Git-Blame-Daten in der aktuell fokussierten Zeile inline angezeigt werden.\n\nStandard: on"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: true"
msgstr "Legt fest, ob Git-Blame-Daten in der aktuell fokussierten Zeile inline angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to show inline diagnostics\n\nDefault: false"
msgstr "Legt fest, ob Inline-Diagnosen angezeigt werden\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether or not to show pinned tabs in a separate row.\nWhen enabled, pinned tabs appear in a top row and unpinned tabs in a bottom row.\n\nDefault: false"
msgstr "Legt fest, ob angeheftete Tabs in einer eigenen Reihe angezeigt werden.\nWenn aktiviert, erscheinen angeheftete Tabs in einer oberen Reihe und nicht angeheftete in einer unteren.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether or not to show the call status icon in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob das Symbol für den Anrufstatus in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to show the git gutter.\n\nDefault: tracked_files"
msgstr "Legt fest, ob die Git-Randleiste angezeigt wird.\n\nStandard: tracked_files"

msgctxt "settings schema"
msgid "Whether or not to show the navigation history buttons in the tab bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltflächen für den Navigationsverlauf in der Tab-Leiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar buttons.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltflächen der Tab-Leiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar in the editor.\n\nDefault: true"
msgstr "Legt fest, ob die Tab-Leiste im Editor angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether or not to skip worktree trust checks.\nWhen trusted, project settings are synchronized automatically,\nlanguage and MCP servers are downloaded and started automatically.\n\nDefault: false"
msgstr "Legt fest, ob die Vertrauensprüfung für Worktrees übersprungen wird.\nBei Vertrauen werden Projekteinstellungen automatisch synchronisiert sowie Sprach- und MCP-Server automatisch heruntergeladen und gestartet.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether other hints should be shown.\n\nDefault: true"
msgstr "Legt fest, ob sonstige Hinweise angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether parameter hints should be shown.\n\nDefault: true"
msgstr "Legt fest, ob Parameterhinweise angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether pressing enter should first append two spaces to the current line,\nwhich is how Markdown spells a hard line break. Lines where the break would\nbe dropped (headings, tables, list items, code fences, blank lines, and lines\nthat already end in a break) are left alone.\n\nDefault: false"
msgstr "Legt fest, ob beim Drücken von Enter zuerst zwei Leerzeichen an die aktuelle Zeile angehängt werden, so schreibt Markdown einen harten Zeilenumbruch. Zeilen, in denen der Umbruch verloren ginge (Überschriften, Tabellen, Listenelemente, Code-Fences, Leerzeilen und Zeilen, die bereits mit einem Umbruch enden), bleiben unverändert.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may always reach any host over the\nnetwork without prompting.\nDefault: false"
msgstr "Legt fest, ob Terminalbefehle in der Sandbox immer ohne Abfrage jeden Host über das Netzwerk erreichen dürfen.\nStandard: false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may write anywhere on the\nfilesystem except protected paths. That is nearly the same as running\noutside the sandbox, so while this is on terminal commands are never\nauto-approved: each one asks first.\nDefault: false"
msgstr "Legt fest, ob Terminalbefehle in der Sandbox überall im Dateisystem außer in geschützten Pfaden schreiben dürfen. Das entspricht nahezu einer Ausführung außerhalb der Sandbox; solange dies aktiviert ist, werden Terminalbefehle daher nie automatisch genehmigt: Jeder fragt zuerst nach.\nStandard: false"

msgctxt "settings schema"
msgid "Whether sticky scroll is enabled.\n\nDefault: false"
msgstr "Legt fest, ob der fixierte Bildlauf aktiviert ist.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the Agent is enabled.\n\nDefault: true"
msgstr "Legt fest, ob der Agent aktiviert ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the Copilot Next Edit Suggestions feature is enabled.\n\nDefault: true"
msgstr "Legt fest, ob die Copilot-Funktion Next Edit Suggestions aktiviert ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the Jupyter feature is enabled.\n\nDefault: true"
msgstr "Legt fest, ob die Jupyter-Funktion aktiviert ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the agent panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Legt fest, ob das Agent-Panel beim Start geöffnet wird, auch wenn sein Dock zuletzt geschlossen war.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the agent panel should use flexible (proportional) sizing when docked to the\nleft or right.\n\nWhen enabled, `default_width` does not control the panel width, and resetting the panel\nrestores the default proportion.\n\nDefault: true"
msgstr "Legt fest, ob das Agent-Panel bei Andocken links oder rechts eine flexible (proportionale) Größe verwendet.\n\nWenn aktiviert, steuert `default_width` die Panelbreite nicht, und das Zurücksetzen des Panels stellt das Standardverhältnis wieder her.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the breakpoints should be reused across Zed sessions.\n\nDefault: true"
msgstr "Legt fest, ob Haltepunkte über ForgeKairos-Sitzungen hinweg wiederverwendet werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the browser panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Legt fest, ob das Browser-Panel beim Start geöffnet wird, auch wenn sein Dock zuletzt geschlossen war.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the built-in browser goes through the egress allowlist proxy.\n\nThe browser is human-driven, so like the terminal it is outside egress\ncontrol by default.\n\nDefault: false"
msgstr "Legt fest, ob der integrierte Browser über den Proxy der Zulassungsliste für ausgehende Verbindungen läuft.\n\nDer Browser wird von Personen bedient und liegt daher wie das Terminal standardmäßig außerhalb der Kontrolle ausgehender Verbindungen.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the context server is enabled."
msgstr "Gibt an, ob der Kontextserver aktiviert ist."

msgctxt "settings schema"
msgid "Whether the cursor blinks in the editor.\n\nDefault: true"
msgstr "Legt fest, ob der Cursor im Editor blinkt.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the editor search results will loop\n\nDefault: true"
msgstr "Legt fest, ob die Suchergebnisse im Editor in einer Schleife durchlaufen werden\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the editor will scroll beyond the last line.\n\nDefault: one_page"
msgstr "Legt fest, ob der Editor über die letzte Zeile hinaus scrollt.\n\nStandard: one_page"

msgctxt "settings schema"
msgid "Whether the focused panel follows the mouse location\nDefault: false"
msgstr "Legt fest, ob das fokussierte Panel der Mausposition folgt\nStandard: false"

msgctxt "settings schema"
msgid "Whether the folders of the macro picker start collapsed when it opens.\n\nDefault: false"
msgstr "Legt fest, ob die Ordner der Makroauswahl beim Öffnen zugeklappt sind.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the git panel should open on startup.\n\nDefault: false"
msgstr "Legt fest, ob das Git-Panel beim Start geöffnet wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the hover popover sticks when the mouse moves toward it,\nallowing interaction with its contents before it disappears.\n\nDefault: true"
msgstr "Legt fest, ob das Hover-Popup erhalten bleibt, wenn sich die Maus darauf zubewegt, sodass mit seinem Inhalt interagiert werden kann, bevor es verschwindet.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the line numbers on editors gutter are relative or not.\nWhen \"enabled\" shows relative number of buffer lines, when \"wrapped\" shows\nrelative number of display lines.\n\nDefault: \"disabled\""
msgstr "Legt fest, ob die Zeilennummern in der Randleiste des Editors relativ sind.\nBei \"enabled\" werden relative Nummern der Pufferzeilen angezeigt, bei \"wrapped\" relative Nummern der Anzeigezeilen.\n\nStandard: \"disabled\""

msgctxt "settings schema"
msgid "Whether the microphone should be muted when joining a channel or a call.\n\nDefault: false"
msgstr "Legt fest, ob das Mikrofon beim Beitritt zu einem Kanal oder Anruf stummgeschaltet ist.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the model emits reasoning/thinking content."
msgstr "Gibt an, ob das Modell Reasoning-/Denkinhalte ausgibt."

msgctxt "settings schema"
msgid "Whether the model emits thinking (reasoning) content."
msgstr "Legt fest, ob das Modell Denkinhalte (Reasoning) ausgibt."

msgctxt "settings schema"
msgid "Whether the model supports tools"
msgstr "Gibt an, ob das Modell Tools unterstützt"

msgctxt "settings schema"
msgid "Whether the model supports tools."
msgstr "Gibt an, ob das Modell Tools unterstützt."

msgctxt "settings schema"
msgid "Whether the model supports vision"
msgstr "Gibt an, ob das Modell Vision unterstützt"

msgctxt "settings schema"
msgid "Whether the model supports vision."
msgstr "Gibt an, ob das Modell Vision unterstützt."

msgctxt "settings schema"
msgid "Whether the panel follows the cursor, making the function under it the\nroot whenever the cursor moves. When off, the root changes only when\nasked for.\n\nDefault: false"
msgstr "Legt fest, ob das Panel dem Cursor folgt und bei jeder Cursorbewegung die Funktion darunter zur Wurzel macht. Wenn deaktiviert, ändert sich die Wurzel nur auf Anforderung.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether the project panel should open on startup.\n\nDefault: true"
msgstr "Legt fest, ob das Projektpanel beim Start geöffnet wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the regex is case-sensitive.\nDefault: false (case-insensitive)"
msgstr "Legt fest, ob der Regex-Ausdruck die Groß-/Kleinschreibung beachtet.\nStandard: false (ohne Beachtung der Groß-/Kleinschreibung)"

msgctxt "settings schema"
msgid "Whether the remote host should make its outgoing HTTP(S) requests —\nlanguage server and node downloads, extension archives, agent binaries\n— through this machine instead of its own network.\n\nThis is what makes a remote host that has no internet access able to\ninstall language servers at all, and it puts those downloads under this\nmachine's network allowlist, consent prompts and proxy. Turn it off to\nhave the remote host connect out on its own.\n\nDefault: true"
msgstr "Legt fest, ob der Remote-Host seine ausgehenden HTTP(S)-Anfragen — Downloads von Sprachservern und Node, Erweiterungsarchive, Agent-Binärdateien — über diesen Computer statt über sein eigenes Netzwerk stellt.\n\nDadurch kann ein Remote-Host ohne Internetzugang überhaupt erst Sprachserver installieren, und diese Downloads unterliegen der Netzwerk-Zulassungsliste, den Zustimmungsabfragen und dem Proxy dieses Computers. Deaktivieren Sie dies, damit sich der Remote-Host selbst nach außen verbindet.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the terminal panel should open on startup.\n\nDefault: true"
msgstr "Legt fest, ob das Terminal-Panel beim Start geöffnet wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the terminal panel should use flexible (proportional) sizing.\n\nDefault: true"
msgstr "Legt fest, ob das Terminal-Panel eine flexible (proportionale) Größe verwendet.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the text selection should have rounded corners.\n\nDefault: true"
msgstr "Legt fest, ob die Textauswahl abgerundete Ecken hat.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether the window-wide threads sidebar is available at all.\n\nDefault: false"
msgstr "Legt fest, ob die fensterweite Thread-Seitenleiste überhaupt verfügbar ist.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether this agent always launches outside the sandbox, without asking.\n\nOutside, writes are not restricted, and network restrictions only apply\nto programs that read the proxy settings. Can only be set in the user\nsettings, not in a project's settings (`.zed/settings.json`).\n\nDefault: false"
msgstr "Legt fest, ob dieser Agent immer ohne Rückfrage außerhalb der Sandbox startet.\n\nAußerhalb sind Schreibzugriffe nicht eingeschränkt, und Netzwerkeinschränkungen gelten nur für Programme, die die Proxy-Einstellungen lesen. Kann nur in den Benutzereinstellungen gesetzt werden, nicht in den Einstellungen eines Projekts (`.zed/settings.json`).\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether this agent may offer signing in with a subscription (an\nauthentication method such as `/login`).\n\nWhen `false`, the agent's sign-in disappears from the authentication card\nand is refused when it is requested another way. Using an API key works\nregardless of this setting.\n\nDefault: true"
msgstr "Legt fest, ob dieser Agent die Anmeldung mit einem Abonnement anbieten darf (eine Authentifizierungsmethode wie `/login`).\n\nBei `false` verschwindet die Anmeldung des Agenten von der Authentifizierungskarte und wird abgelehnt, wenn sie auf anderem Weg angefordert wird. Die Verwendung eines API-Schlüssels funktioniert unabhängig von dieser Einstellung.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether this custom Mantle model supports OpenAI reasoning effort parameters."
msgstr "Legt fest, ob dieses benutzerdefinierte Mantle-Modell OpenAI-Parameter für den Denkaufwand unterstützt."

msgctxt "settings schema"
msgid "Whether to align detail text in code completions context menus left or right.\n\nDefault: left"
msgstr "Legt fest, ob Detailtext in Kontextmenüs der Codevervollständigung links- oder rechtsbündig ausgerichtet wird.\n\nStandard: left"

msgctxt "settings schema"
msgid "Whether to allow drag and drop text selection in buffer."
msgstr "Gibt an, ob das Auswählen von Text per Drag & Drop im Puffer erlaubt ist."

msgctxt "settings schema"
msgid "Whether to allow horizontal scrolling in the project panel.\nWhen false, the view is locked to the leftmost position and\nlong file names are clipped.\n\nDefault: true"
msgstr "Legt fest, ob horizontales Scrollen im Projektpanel erlaubt ist.\nBei false ist die Ansicht ganz links fixiert, und lange Dateinamen werden abgeschnitten.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to allow windows to tab together based on the user's tabbing preference (macOS only).\n\nDefault: false"
msgstr "Legt fest, ob Fenster gemäß der Tab-Einstellung des Benutzers als Tabs zusammengefasst werden dürfen (nur macOS).\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to always show the close button on tabs.\n\nDefault: false"
msgstr "Legt fest, ob die Schließen-Schaltfläche auf Tabs immer angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to always use cmd-enter (or ctrl-enter on Linux or Windows) to send messages in the agent panel.\n\nDefault: false"
msgstr "Legt fest, ob Nachrichten im Agent-Panel immer mit cmd-enter (bzw. ctrl-enter unter Linux oder Windows) gesendet werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to attempt to restore previous file's state when opening it again.\nThe state is stored per pane.\nWhen disabled, defaults are applied instead of the state restoration.\n\nE.g. for editors, selections, folds and scroll positions are restored, if the same file is closed and, later, opened again in the same pane.\nWhen disabled, a single selection in the very beginning of the file, zero scroll position and no folds state is used as a default.\n\nDefault: true"
msgstr "Legt fest, ob beim erneuten Öffnen einer Datei versucht wird, ihren vorherigen Zustand wiederherzustellen.\nDer Zustand wird pro Bereich gespeichert.\nWenn deaktiviert, werden statt der Wiederherstellung Standardwerte angewendet.\n\nZ. B. werden bei Editoren Auswahlen, Faltungen und Scrollpositionen wiederhergestellt, wenn dieselbe Datei geschlossen und später im selben Bereich wieder geöffnet wird.\nWenn deaktiviert, werden standardmäßig eine einzelne Auswahl ganz am Anfang der Datei, Scrollposition null und keine Faltungen verwendet.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to automatically attach the active editor to every message that\nis sent: the selected lines when there is a selection, otherwise the\nwhole file. A file that is already mentioned by hand is not attached\ntwice.\n\nDefault: false"
msgstr "Legt fest, ob der aktive Editor automatisch an jede gesendete Nachricht angehängt wird: bei einer Auswahl die ausgewählten Zeilen, sonst die ganze Datei. Eine bereits von Hand erwähnte Datei wird nicht doppelt angehängt.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to automatically close JSX tags."
msgstr "Legt fest, ob JSX-Tags automatisch geschlossen werden."

msgctxt "settings schema"
msgid "Whether to automatically close files that have been deleted on disk.\n\nDefault: false"
msgstr "Legt fest, ob Dateien, die auf dem Datenträger gelöscht wurden, automatisch geschlossen werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to automatically compact the agent's context when it grows too\nlarge, summarizing earlier messages to free up room in the model's\ncontext window.\n\nDefault: true"
msgstr "Legt fest, ob der Kontext des Agenten automatisch komprimiert wird, wenn er zu groß wird, indem frühere Nachrichten zusammengefasst werden, um im Kontextfenster des Modells Platz zu schaffen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to automatically detect the language of an untitled buffer from its contents.\nLanguages explicitly selected from the language selector are not changed.\n\nDefault: true"
msgstr "Legt fest, ob die Sprache eines unbenannten Puffers automatisch anhand seines Inhalts erkannt wird.\nAusdrücklich in der Sprachauswahl gewählte Sprachen werden nicht geändert.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to automatically discover models served by the llama.cpp server.\nDefaults to true."
msgstr "Legt fest, ob vom llama.cpp-Server bereitgestellte Modelle automatisch erkannt werden.\nStandardmäßig true."

msgctxt "settings schema"
msgid "Whether to automatically open Markdown files in the preview.\n\nDefault: false"
msgstr "Legt fest, ob Markdown-Dateien automatisch in der Vorschau geöffnet werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to automatically open files after pasting or duplicating them.\n\nDefault: true"
msgstr "Legt fest, ob Dateien nach dem Einfügen oder Duplizieren automatisch geöffnet werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to automatically open files dropped from external sources.\n\nDefault: true"
msgstr "Legt fest, ob aus externen Quellen abgelegte Dateien automatisch geöffnet werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to automatically open newly created files in the editor.\n\nDefault: true"
msgstr "Legt fest, ob neu erstellte Dateien automatisch im Editor geöffnet werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to automatically open the menus in the title bar on hover.\n\nDefault: false"
msgstr "Legt fest, ob die Menüs in der Titelleiste automatisch geöffnet werden, wenn Sie mit der Maus darauf zeigen.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to automatically show a signature help pop-up or not.\n\nDefault: false"
msgstr "Legt fest, ob automatisch ein Popup mit Signaturhilfe angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to automatically surround text with characters for you. For example,\nwhen you select text and type '(', Zed will automatically surround text with ().\n\nDefault: true"
msgstr "Legt fest, ob Text automatisch mit Zeichen umschlossen wird. Wenn Sie beispielsweise Text auswählen und '(' eingeben, umschließt ForgeKairos den Text automatisch mit ().\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to automatically type closing characters for you. For example,\nwhen you type '(', Zed will automatically add a closing ')' at the correct position.\n\nDefault: true"
msgstr "Legt fest, ob schließende Zeichen automatisch eingefügt werden. Wenn Sie beispielsweise '(' eingeben, fügt ForgeKairos automatisch ein schließendes ')' an der richtigen Stelle hinzu.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to build dev container images with BuildKit.\n\nWhen unset, Zed auto-detects BuildKit by probing for the `buildx` CLI\nplugin. Set to `false` to force the classic Docker builder, which is\nrequired for Docker-compatible engines that lack an integrated BuildKit\n(e.g. Apple Container via a Docker-API bridge), where BuildKit builds\ncannot resolve locally-built images.\n\nDefault: null (auto-detect)"
msgstr "Legt fest, ob Dev-Container-Images mit BuildKit erstellt werden.\n\nWenn nicht gesetzt, erkennt ForgeKairos BuildKit automatisch, indem nach dem CLI-Plug-in `buildx` gesucht wird. Setzen Sie `false`, um den klassischen Docker-Builder zu erzwingen; das ist bei Docker-kompatiblen Engines ohne integriertes BuildKit erforderlich (z. B. Apple Container über eine Docker-API-Brücke), bei denen BuildKit-Builds lokal erstellte Images nicht auflösen können.\n\nStandard: null (auto-detect)"

msgctxt "settings schema"
msgid "Whether to center the cursor on each search match when navigating."
msgstr "Legt fest, ob der Cursor beim Navigieren auf jedem Suchtreffer zentriert wird."

msgctxt "settings schema"
msgid "Whether to close the window when using 'close active item' on a workspace with no tabs\n\nDefault: auto (\"on\" on macOS, \"off\" otherwise)"
msgstr "Legt fest, ob das Fenster geschlossen wird, wenn 'aktives Element schließen' in einem Arbeitsbereich ohne Tabs verwendet wird\n\nStandard: auto (\"on\" unter macOS, sonst \"off\")"

msgctxt "settings schema"
msgid "Whether to collapse untracked files in the diff panel.\n\nDefault: false"
msgstr "Legt fest, ob nicht verfolgte Dateien im Diff-Panel zugeklappt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to collect timing data for foreground and background executor\ntasks. Enabling this may lead to increased memory usage, hence it's\ndisabled by default for regular builds.\n\nDefault: false"
msgstr "Legt fest, ob Zeitdaten für Executor-Aufgaben im Vorder- und Hintergrund gesammelt werden. Die Aktivierung kann den Speicherverbrauch erhöhen, daher ist sie bei regulären Builds standardmäßig deaktiviert.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to continue markdown lists when pressing enter.\n\nDefault: true"
msgstr "Legt fest, ob Markdown-Listen beim Drücken von Enter fortgesetzt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to disable all AI features in Zed.\n\nDefault: false"
msgstr "Legt fest, ob alle KI-Funktionen in ForgeKairos deaktiviert werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to display Agent review buttons in the editor toolbar.\nOnly applicable while reviewing a file edited by the Agent.\n\nDefault: true"
msgstr "Legt fest, ob Review-Schaltflächen des Agenten in der Editor-Symbolleiste angezeigt werden.\nGilt nur beim Review einer vom Agenten bearbeiteten Datei.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to display agent edits in single-file editors in addition to the review multibuffer pane.\n\nDefault: false"
msgstr "Legt fest, ob Bearbeitungen des Agenten zusätzlich zum Review-Multibuffer-Bereich auch in Einzeldatei-Editoren angezeigt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to display breadcrumbs in the editor toolbar.\n\nDefault: true"
msgstr "Legt fest, ob Breadcrumbs in der Editor-Symbolleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to display code action buttons in the editor toolbar.\n\nDefault: false"
msgstr "Legt fest, ob Schaltflächen für Codeaktionen in der Editor-Symbolleiste angezeigt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to display code lenses from language servers above code elements."
msgstr "Legt fest, ob CodeLens von Sprachservern oberhalb von Codeelementen angezeigt werden."

msgctxt "settings schema"
msgid "Whether to display indent guides in the editor.\n\nDefault: true"
msgstr "Legt fest, ob Einzugsführungslinien im Editor angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to display inline and alongside documentation for items in the\ncompletions menu.\n\nDefault: true"
msgstr "Legt fest, ob für Elemente im Vervollständigungsmenü Dokumentation inline und daneben angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to display quick action buttons in the editor toolbar.\n\nDefault: true"
msgstr "Legt fest, ob Schnellaktions-Schaltflächen in der Editor-Symbolleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to display the Markdown formatting row below the editor toolbar\nwhile a Markdown file is open.\n\nDefault: true"
msgstr "Legt fest, ob die Markdown-Formatleiste unter der Editor-Symbolleiste angezeigt wird, während eine Markdown-Datei geöffnet ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to display the active language button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche der aktiven Sprache in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to display the terminal title in breadcrumbs inside the terminal pane.\nOnly shown if the terminal title is not empty.\n\nThe shell running in the terminal needs to be configured to emit the title.\nExample: `echo -e \"\\e]2;New Title\\007\";`\n\nDefault: true"
msgstr "Legt fest, ob der Terminaltitel in den Breadcrumbs im Terminalbereich angezeigt wird.\nWird nur angezeigt, wenn der Terminaltitel nicht leer ist.\n\nDie im Terminal laufende Shell muss so konfiguriert sein, dass sie den Titel ausgibt.\nBeispiel: `echo -e \"\\e]2;New Title\\007\";`\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to enable drag-and-drop operations in the project panel.\n\nDefault: true"
msgstr "Legt fest, ob Drag & Drop im Projektpanel aktiviert ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to enable middle-click paste on Linux\n\nDefault: true"
msgstr "Legt fest, ob das Einfügen per Mittelklick unter Linux aktiviert ist\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to enable think mode"
msgstr "Legt fest, ob der Denkmodus aktiviert wird"

msgctxt "settings schema"
msgid "Whether to enable word diff highlighting in the editor.\n\nWhen enabled, changed words within modified lines are highlighted\nto show exactly what changed.\n\nDefault: true"
msgstr "Legt fest, ob die wortweise Diff-Hervorhebung im Editor aktiviert ist.\n\nWenn aktiviert, werden geänderte Wörter in geänderten Zeilen hervorgehoben, um genau zu zeigen, was sich geändert hat.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to expose this window over the loopback IDE server, so that\nexternal agents such as the Claude Code CLI can read the open editors,\nthe selection and the diagnostics, and show diffs inside Zed.\n\nDefault: false"
msgstr "Legt fest, ob dieses Fenster über den Loopback-IDE-Server bereitgestellt wird, sodass externe Agenten wie die Claude Code CLI die geöffneten Editoren, die Auswahl und die Diagnosen lesen und Diffs in ForgeKairos anzeigen können.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to fetch LSP completions or not.\n\nDefault: true"
msgstr "Legt fest, ob LSP-Vervollständigungen abgerufen werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to filter ANSI/VT escape sequences so the log reads as plain\ntext, the way TeraTerm's text log does.\n\nDefault: true"
msgstr "Legt fest, ob ANSI-/VT-Escape-Sequenzen herausgefiltert werden, damit sich das Protokoll wie das Textprotokoll von TeraTerm als reiner Text liest.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to fold directories automatically\nwhen directory has only one directory inside.\n\nDefault: true"
msgstr "Legt fest, ob Verzeichnisse automatisch zusammengefasst werden, wenn ein Verzeichnis nur ein einziges Verzeichnis enthält.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to follow-up empty go to definition responses from the language server or not.\n`FindAllReferences` allows to look up references of the same symbol instead.\n`None` disables the fallback.\n\nDefault: FindAllReferences"
msgstr "Legt fest, ob auf leere Antworten des Sprachservers bei „Zur Definition wechseln“ eine Folgeaktion erfolgt.\n`FindAllReferences` sucht stattdessen nach Referenzen desselben Symbols.\n`None` deaktiviert den Ersatz.\n\nStandard: FindAllReferences"

msgctxt "settings schema"
msgid "Whether to format dap messages in when adding them to debug adapter logger\n\nDefault: true"
msgstr "Legt fest, ob DAP-Nachrichten beim Hinzufügen zum Debugadapter-Logger formatiert werden\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to give agents Zed's IDE tools (the `zed` MCP server: highlights,\nannotations, code tours, hover, definitions, references and symbol\nsearch), in the Claude Code CLI tabs and in external agents' sessions\nalike. Independent of `enabled`: the server starts for them on demand\nand writes no lock file unless `enabled` is on.\n\nDefault: true"
msgstr "Legt fest, ob Agenten die IDE-Tools von ForgeKairos erhalten (der MCP-Server `zed`: Hervorhebungen, Anmerkungen, Code-Touren, Hover, Definitionen, Referenzen und Symbolsuche), sowohl in den Tabs der Claude Code CLI als auch in Sitzungen externer Agenten. Unabhängig von `enabled`: Der Server startet für sie bei Bedarf und schreibt keine Sperrdatei, solange `enabled` nicht aktiviert ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to have edit cards in the agent panel expanded, showing a preview of the full diff.\n\nDefault: true"
msgstr "Legt fest, ob Bearbeitungskarten im Agent-Panel aufgeklappt sind und eine Vorschau des vollständigen Diffs zeigen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to have terminal cards in the agent panel expanded, showing the whole command output.\n\nDefault: true"
msgstr "Legt fest, ob Terminalkarten im Agent-Panel aufgeklappt sind und die gesamte Befehlsausgabe zeigen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to hide gitignore files in the project panel.\n\nDefault: false"
msgstr "Legt fest, ob von Git ignorierte Dateien im Projektpanel ausgeblendet werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to hide symbols, excerpts and search matches in the outline panel\nwhen a multi-buffer view (e.g. a diff or search results) is active,\nshowing only files and directories.\nDoes not affect single-file views.\n\nDefault: false"
msgstr "Legt fest, ob Symbole, Auszüge und Suchtreffer im Gliederungspanel ausgeblendet werden, wenn eine Multibuffer-Ansicht (z. B. ein Diff oder Suchergebnisse) aktiv ist, sodass nur Dateien und Verzeichnisse angezeigt werden.\nBetrifft keine Einzeldateiansichten.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to hide the hidden entries in the project panel.\n\nDefault: false"
msgstr "Legt fest, ob versteckte Einträge im Projektpanel ausgeblendet werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to hide the root entry when only one folder is open in the window.\n\nDefault: false"
msgstr "Legt fest, ob der Stammeintrag ausgeblendet wird, wenn nur ein Ordner im Fenster geöffnet ist.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to highlight all occurrences of the selected text in an editor.\n\nDefault: true"
msgstr "Legt fest, ob alle Vorkommen des ausgewählten Texts in einem Editor hervorgehoben werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to include gitignored files in search results."
msgstr "Legt fest, ob per .gitignore ignorierte Dateien in Suchergebnisse einbezogen werden."

msgctxt "settings schema"
msgid "Whether to include project rules files (AGENTS.md, CLAUDE.md, .rules, etc.)\nin the prompt when generating git commit messages.\n\nDefault: true"
msgstr "Legt fest, ob Projektregeldateien (AGENTS.md, CLAUDE.md, .rules usw.) beim Generieren von Git-Commit-Nachrichten in den Prompt aufgenommen werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to include text channels in file finder results.\n\nDefault: false"
msgstr "Legt fest, ob Textkanäle in die Ergebnisse der Dateisuche aufgenommen werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to indent lines using tab characters, as opposed to multiple\nspaces.\n\nDefault: false"
msgstr "Legt fest, ob Zeilen mit Tabulatorzeichen statt mit mehreren Leerzeichen eingerückt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to indent list items when pressing tab after a list marker.\n\nDefault: true"
msgstr "Legt fest, ob Listenelemente eingerückt werden, wenn nach einer Listenmarkierung Tab gedrückt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to index files that `.gitignore` excludes (only the ones the\nproject panel has loaded: ignored folders are read when expanded).\n\nDefault: false"
msgstr "Legt fest, ob von `.gitignore` ausgeschlossene Dateien indiziert werden (nur die vom Projektpanel geladenen: Ignorierte Ordner werden beim Aufklappen gelesen).\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to interpret the search query as a regular expression."
msgstr "Legt fest, ob die Suchanfrage als regulärer Ausdruck interpretiert wird."

msgctxt "settings schema"
msgid "Whether to keep tabs in preview mode when code navigation is used to navigate away from them.\nIf `enable_preview_file_from_code_navigation` or `enable_preview_multibuffer_from_code_navigation` is also true, the new tab may replace the existing one.\n\nDefault: false"
msgstr "Legt fest, ob Tabs im Vorschaumodus bleiben, wenn per Codenavigation von ihnen weg navigiert wird.\nIst auch `enable_preview_file_from_code_navigation` oder `enable_preview_multibuffer_from_code_navigation` true, kann der neue Tab den vorhandenen ersetzen.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to keep the system awake while agent threads are running.\n\nDefault: true"
msgstr "Legt fest, ob das System wach gehalten wird, während Agent-Threads laufen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to keep the text selection after copying it to the clipboard.\n\nDefault: true"
msgstr "Legt fest, ob die Textauswahl nach dem Kopieren in die Zwischenablage erhalten bleibt.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to limit the content width in the agent panel. When enabled,\ncontent will be constrained to `max_content_width` and centered when\nthe panel is wider than that value, for optimal readability.\n\nDefault: false"
msgstr "Legt fest, ob die Inhaltsbreite im Agent-Panel begrenzt wird. Wenn aktiviert, wird der Inhalt für optimale Lesbarkeit auf `max_content_width` begrenzt und zentriert, wenn das Panel breiter als dieser Wert ist.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to limit the width of the rendered markdown content. When\nenabled, content is constrained to `max_width` and centered\nhorizontally within the preview pane, for optimal readability.\n\nDefault: false"
msgstr "Legt fest, ob die Breite des gerenderten Markdown-Inhalts begrenzt wird. Wenn aktiviert, wird der Inhalt für optimale Lesbarkeit auf `max_width` begrenzt und im Vorschaubereich horizontal zentriert.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to log messages between active debug adapters and Zed\n\nDefault: true"
msgstr "Legt fest, ob Nachrichten zwischen aktiven Debugadaptern und ForgeKairos protokolliert werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to match case sensitively."
msgstr "Legt fest, ob die Groß-/Kleinschreibung bei der Suche beachtet wird."

msgctxt "settings schema"
msgid "Whether to only match on whole words."
msgstr "Legt fest, ob nur ganze Wörter gefunden werden."

msgctxt "settings schema"
msgid "Whether to only show the inline blame information\nafter a delay once the cursor stops moving.\n\nDefault: 0"
msgstr "Legt fest, ob die Inline-Blame-Informationen erst nach einer Verzögerung angezeigt werden, sobald der Cursor stillsteht.\n\nStandard: 0"

msgctxt "settings schema"
msgid "Whether to only show the inline diagnostics after a delay after the\nlast editor event.\n\nDefault: 150"
msgstr "Legt fest, ob die Inline-Diagnosen erst nach einer Verzögerung nach dem letzten Editorereignis angezeigt werden.\n\nStandard: 150"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a multibuffer.\n\nDefault: false"
msgstr "Legt fest, ob Tabs im Vorschaumodus geöffnet werden, wenn ein Multibuffer über die Codenavigation geöffnet wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a single file.\n\nDefault: true"
msgstr "Legt fest, ob Tabs im Vorschaumodus geöffnet werden, wenn eine einzelne Datei über die Codenavigation geöffnet wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from a multibuffer.\n\nDefault: true"
msgstr "Legt fest, ob Tabs im Vorschaumodus geöffnet werden, wenn sie aus einem Multibuffer geöffnet werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from the project panel\nwith a single click or the `project_panel::Open` action.\n\nDefault: true"
msgstr "Legt fest, ob Tabs im Vorschaumodus geöffnet werden, wenn sie aus dem Projektpanel per einfachem Klick oder mit der Aktion `project_panel::Open` geöffnet werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when selected from the file finder.\n\nDefault: false"
msgstr "Legt fest, ob Tabs im Vorschaumodus geöffnet werden, wenn sie in der Dateisuche ausgewählt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to open tabular files such as CSV and TSV as a table (grid). When\noff, they open in the text editor.\n\nDefault: true"
msgstr "Legt fest, ob Tabellendateien wie CSV und TSV als Tabelle (Raster) geöffnet werden. Wenn ausgeschaltet, werden sie im Texteditor geöffnet.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to optimize Zed's interface for assistive technology such as\nscreen readers.\n\nDefault: false"
msgstr "Legt fest, ob die Oberfläche von ForgeKairos für Hilfstechnologien wie Sprachausgaben optimiert wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to perform linked edits of associated ranges, if the language server supports it.\nFor example, when editing opening <html> tag, the contents of the closing </html> tag will be edited as well.\n\nDefault: true"
msgstr "Legt fest, ob verknüpfte Bearbeitungen zusammengehöriger Bereiche ausgeführt werden, sofern der Sprachserver dies unterstützt.\nBeispiel: Beim Bearbeiten des öffnenden <html>-Tags wird auch der Inhalt des schließenden </html>-Tags bearbeitet.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to point out missing development tools in a notification and offer\nto install them from it. While connected to a remote host, the host is\nchecked and the tools are installed there.\n\nDefault: true"
msgstr "Legt fest, ob fehlende Entwicklungstools in einer Benachrichtigung gemeldet werden und deren Installation direkt daraus angeboten wird. Bei einer Verbindung mit einem Remote-Host wird der Host geprüft und die Tools werden dort installiert.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to pop the completions menu while typing in an editor without\nexplicitly requesting it.\n\nDefault: true"
msgstr "Legt fest, ob das Vervollständigungsmenü beim Tippen im Editor automatisch eingeblendet wird, ohne es ausdrücklich anzufordern.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to prefix each logged line with `[YYYY-MM-DD HH:MM:SS] `.\n\nDefault: false"
msgstr "Legt fest, ob jeder protokollierten Zeile `[YYYY-MM-DD HH:MM:SS] ` vorangestellt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to prevent this project from being shared in public channels.\n\nDefault: false"
msgstr "Legt fest, ob verhindert wird, dass dieses Projekt in öffentlichen Kanälen freigegeben wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to pull for diagnostics or not.\n\nDefault: true"
msgstr "Legt fest, ob Diagnosen per Pull abgerufen werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to query and display LSP `textDocument/documentLink` links in the editor.\n\nDefault: true"
msgstr "Legt fest, ob LSP-Links (`textDocument/documentLink`) abgefragt und im Editor angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to reduce non-essential motion in the UI, such as loading\nspinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Legt fest, ob nicht notwendige Bewegungen in der Oberfläche, etwa Ladeanimationen und pulsierende Beschriftungen, reduziert werden, indem sie statisch dargestellt werden.\n\nStandard: off"

msgctxt "settings schema"
msgid "Whether to resize all the panels in a dock when resizing the dock.\n\nDefault: [\"left\"]"
msgstr "Legt fest, ob beim Ändern der Größe eines Docks alle Panels darin mit angepasst werden.\n\nStandard: [\"left\"]"

msgctxt "settings schema"
msgid "Whether to reveal an already open file in an existing pane instead of opening it in the active pane.\n\nDefault: false"
msgstr "Legt fest, ob eine bereits geöffnete Datei in einem vorhandenen Bereich angezeigt wird, statt sie im aktiven Bereich zu öffnen.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to reveal it in the outline panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Legt fest, ob der Eintrag automatisch im Gliederungspanel angezeigt wird, wenn ein zugehöriger Projekteintrag aktiv wird.\nVon Git ignorierte Einträge werden nie automatisch angezeigt.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to reveal it in the project panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Legt fest, ob der Eintrag automatisch im Projektpanel angezeigt wird, wenn ein zugehöriger Projekteintrag aktiv wird.\nVon Git ignorierte Einträge werden nie automatisch angezeigt.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to run agent terminal commands outside the OS sandbox, with\nZed's own permissions (the inverse of the settings UI's \"enable sandbox\"\nswitch). When true, the sandboxed terminal tool is not exposed and the\nsystem prompt omits the sandbox section, so the model uses the plain\n`terminal` tool; on Windows, WSL sandbox setup is skipped. Such commands\nare never auto-approved: each one asks first. Only the user sets this;\nthe agent has no way to ask for a command to run outside the sandbox.\nDefault: false"
msgstr "Legt fest, ob Terminalbefehle des Agenten außerhalb der Betriebssystem-Sandbox mit den eigenen Berechtigungen von ForgeKairos ausgeführt werden (das Gegenteil des Schalters „Sandbox aktivieren“ in der Einstellungsoberfläche). Bei true wird das Sandbox-Terminaltool nicht bereitgestellt und der Systemprompt lässt den Sandbox-Abschnitt weg, sodass das Modell das normale Tool `terminal` verwendet; unter Windows wird die Einrichtung der WSL-Sandbox übersprungen. Solche Befehle werden nie automatisch genehmigt: Für jeden wird zuerst nachgefragt. Nur der Benutzer legt dies fest; der Agent hat keine Möglichkeit, die Ausführung eines Befehls außerhalb der Sandbox anzufordern.\nStandard: false"

msgctxt "settings schema"
msgid "Whether to run the context server on the remote server when using remote development.\n\nIf this is false, the context server will always run on the local machine.\n\nDefault: false"
msgstr "Legt fest, ob der Kontextserver bei der Remoteentwicklung auf dem Remote-Server ausgeführt wird.\n\nBei false wird der Kontextserver immer auf dem lokalen Computer ausgeführt.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to scroll when clicking near the edge of the visible text area.\n\nDefault: false"
msgstr "Legt fest, ob beim Klicken nahe dem Rand des sichtbaren Textbereichs gescrollt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to send explicit `cache_control` breakpoints for prompt caching.\nLeave disabled if the provider rejects requests containing them."
msgstr "Legt fest, ob explizite `cache_control`-Haltepunkte für das Prompt-Caching gesendet werden.\nLassen Sie dies deaktiviert, wenn der Anbieter Anfragen ablehnt, die sie enthalten."

msgctxt "settings schema"
msgid "Whether to show OpenCode Go models. Defaults to true."
msgstr "Legt fest, ob OpenCode-Go-Modelle angezeigt werden. Standardmäßig aktiviert."

msgctxt "settings schema"
msgid "Whether to show OpenCode Zen models. Defaults to true."
msgstr "Legt fest, ob OpenCode-Zen-Modelle angezeigt werden. Standardmäßig aktiviert."

msgctxt "settings schema"
msgid "Whether to show a background for inlay hints.\n\nIf set to `true`, the background will use the `hint.background` color\nfrom the current theme.\n\nDefault: false"
msgstr "Legt fest, ob für Inlay-Hinweise ein Hintergrund angezeigt wird.\n\nBei `true` verwendet der Hintergrund die Farbe `hint.background` des aktuellen Designs.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show a badge on the git panel icon with the count of uncommitted changes.\n\nDefault: false"
msgstr "Legt fest, ob auf dem Symbol des Git-Panels ein Badge mit der Anzahl der nicht committeten Änderungen angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show a badge on the terminal panel icon with the count of open terminals.\n\nDefault: false"
msgstr "Legt fest, ob auf dem Symbol des Terminal-Panels ein Badge mit der Anzahl der geöffneten Terminals angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show a git status indicator next to file names in the project panel.\n\nDefault: false"
msgstr "Legt fest, ob im Projektpanel neben Dateinamen eine Git-Statusanzeige angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show a single line break as a line break. When off, it is one\nspace as CommonMark specifies, and only two trailing spaces, `\\` or `<br>`\nbreak the line. Exporting to PDF follows the same setting.\n\nDefault: true"
msgstr "Legt fest, ob ein einzelner Zeilenumbruch als Zeilenumbruch angezeigt wird. Wenn ausgeschaltet, ist er gemäß CommonMark ein Leerzeichen, und nur zwei Leerzeichen am Zeilenende, `\\` oder `<br>` brechen die Zeile um. Der Export als PDF folgt derselben Einstellung.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show active line endings button in the status bar.\n\nDefault: false"
msgstr "Legt fest, ob die Schaltfläche für das aktive Zeilenende in der Statusleiste angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show an indicator while multi-stroke input is pending.\nIf the input has a timeout, a countdown is shown and hovering the indicator pauses it.\nIts binding preview popover is disabled when the which-key popup is enabled.\n\nDefault: true"
msgstr "Legt fest, ob eine Anzeige eingeblendet wird, solange eine Eingabe aus mehreren Tastenanschlägen aussteht.\nHat die Eingabe ein Zeitlimit, wird ein Countdown angezeigt, und wenn Sie mit der Maus auf die Anzeige zeigen, wird er angehalten.\nDas Vorschau-Popup der Tastenkombinationen ist deaktiviert, wenn das Which-Key-Popup aktiviert ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show author name as part of the commit information.\n\nDefault: false"
msgstr "Legt fest, ob der Name des Autors als Teil der Commit-Informationen angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show bookmarks in the gutter.\n\nDefault: true"
msgstr "Legt fest, ob Lesezeichen in der Randleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show breakpoints in the gutter.\n\nDefault: true"
msgstr "Legt fest, ob Haltepunkte in der Randleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show buffer search result indicators in the scrollbar.\n\nDefault: true"
msgstr "Legt fest, ob Markierungen für Suchergebnisse im Puffer in der Scrollleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show cells that contain line breaks in full, making the row\ntaller. When off, they are cut to one line.\n\nDefault: true"
msgstr "Legt fest, ob Zellen mit Zeilenumbrüchen vollständig angezeigt werden, wodurch die Zeile höher wird. Wenn ausgeschaltet, werden sie auf eine Zeile gekürzt.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show code action button at start of buffer line.\n\nDefault: true"
msgstr "Legt fest, ob die Codeaktions-Schaltfläche am Anfang der Pufferzeile angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show commit summary as part of the inline blame.\n\nDefault: false"
msgstr "Legt fest, ob die Commit-Zusammenfassung als Teil des Inline-Blame angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show cursor positions in the scrollbar.\n\nDefault: true"
msgstr "Legt fest, ob Cursorpositionen in der Scrollleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show entries with tree or flat view in the panel\n\nDefault: false"
msgstr "Legt fest, ob Einträge im Panel als Baum oder als flache Liste angezeigt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show error and warning count badges next to file names in the project panel.\n\nDefault: false"
msgstr "Legt fest, ob im Projektpanel neben Dateinamen Badges mit der Anzahl der Fehler und Warnungen angezeigt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show file icons in the file finder.\n\nDefault: true"
msgstr "Legt fest, ob Dateisymbole in der Dateisuche angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show file icons in the git panel.\n\nDefault: false"
msgstr "Legt fest, ob Dateisymbole im Git-Panel angezeigt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show file icons in the outline panel.\n\nDefault: true"
msgstr "Legt fest, ob Dateisymbole im Gliederungspanel angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show file icons in the project panel.\n\nDefault: true"
msgstr "Legt fest, ob Dateisymbole im Projektpanel angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show fold buttons in the gutter.\n\nDefault: true"
msgstr "Legt fest, ob Faltschaltflächen in der Randleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show folder names with bold text in the project panel.\n\nDefault: false"
msgstr "Legt fest, ob Ordnernamen im Projektpanel fett angezeigt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show git diff indicators in the scrollbar.\n\nDefault: true"
msgstr "Legt fest, ob Git-Diff-Markierungen in der Scrollleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show git status indicators on the branch icon in the title bar.\nWhen enabled, the branch icon changes to reflect the current repository\nstatus (e.g. modified, added, deleted, or conflict).\n\nDefault: false"
msgstr "Legt fest, ob auf dem Branch-Symbol in der Titelleiste Git-Statusanzeigen angezeigt werden.\nWenn aktiviert, ändert sich das Branch-Symbol entsprechend dem aktuellen Status des Repositorys (z. B. geändert, hinzugefügt, gelöscht oder Konflikt).\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show line numbers in the gutter.\n\nDefault: true"
msgstr "Legt fest, ob Zeilennummern in der Randleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show onboarding banners in the title bar.\n\nDefault: true"
msgstr "Legt fest, ob Einführungsbanner in der Titelleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show opened editors as preview tabs.\nPreview tabs do not stay open, are reused until explicitly set to be kept open opened (via double-click or editing) and show file names in italic.\n\nDefault: true"
msgstr "Legt fest, ob geöffnete Editoren als Vorschau-Tabs angezeigt werden.\nVorschau-Tabs bleiben nicht geöffnet, werden wiederverwendet, bis sie ausdrücklich zum Offenhalten markiert werden (per Doppelklick oder Bearbeitung), und zeigen Dateinamen kursiv an.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show padding for zoomed panels.\nWhen enabled, zoomed bottom panels will have some top padding,\nwhile zoomed left/right panels will have padding to the right/left (respectively).\n\nDefault: true"
msgstr "Legt fest, ob für gezoomte Panels ein Abstand angezeigt wird.\nWenn aktiviert, erhalten gezoomte untere Panels einen Abstand oben, gezoomte linke/rechte Panels einen Abstand rechts/links.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show runnable buttons in the gutter.\n\nDefault: true"
msgstr "Legt fest, ob Ausführen-Schaltflächen in der Randleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show selected symbol occurrences in the scrollbar.\n\nDefault: true"
msgstr "Legt fest, ob Vorkommen des ausgewählten Symbols in der Scrollleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show selected text occurrences in the scrollbar.\n\nDefault: true"
msgstr "Legt fest, ob Vorkommen des ausgewählten Texts in der Scrollleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show small single-line outputs inline instead of in a block.\n\nDefault: true"
msgstr "Legt fest, ob kleine einzeilige Ausgaben inline statt in einem Block angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show tabs and spaces in the editor."
msgstr "Legt fest, ob Tabulatoren und Leerzeichen im Editor angezeigt werden."

msgctxt "settings schema"
msgid "Whether to show the AI browser panel button in the status bar while AI\ncontrol of the built-in browser is on.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des KI-Browser-Panels in der Statusleiste angezeigt wird, solange die KI-Steuerung des integrierten Browsers eingeschaltet ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the Git file status on a tab item.\n\nDefault: false"
msgstr "Legt fest, ob der Git-Dateistatus auf einem Tab angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show the LSP servers button in the status bar.\n\nDefault: `true`"
msgstr "Legt fest, ob die Schaltfläche für LSP-Server in der Statusleiste angezeigt wird.\n\nStandard: `true`"

msgctxt "settings schema"
msgid "Whether to show the active encoding button in the status bar.\n\nDefault: non_utf8"
msgstr "Legt fest, ob die Schaltfläche für die aktive Codierung in der Statusleiste angezeigt wird.\n\nStandard: non_utf8"

msgctxt "settings schema"
msgid "Whether to show the addition/deletion change count next to each file in the Git panel.\n\nDefault: true"
msgstr "Legt fest, ob im Git-Panel neben jeder Datei die Anzahl der hinzugefügten/gelöschten Zeilen angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the agent panel button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des Agent-Panels in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the avatar of the author of the commit.\n\nDefault: true"
msgstr "Legt fest, ob der Avatar des Commit-Autors angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the branch name button in the titlebar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche mit dem Branch-Namen in der Titelleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the browser panel button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des Browser-Panels in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the call graph panel button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des Aufrufgraph-Panels in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the cursor position button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche für die Cursorposition in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the debug button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Debug-Schaltfläche in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the file icon for a tab.\n\nDefault: false"
msgstr "Legt fest, ob das Dateisymbol für einen Tab angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show the git status in the outline panel.\n\nDefault: true"
msgstr "Legt fest, ob der Git-Status im Gliederungspanel angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the git status in the project panel.\n\nDefault: true"
msgstr "Legt fest, ob der Git-Status im Projektpanel angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the informational hover box when moving the mouse\nover symbols in the editor.\n\nDefault: true"
msgstr "Legt fest, ob das Hover-Popup mit Informationen angezeigt wird, wenn Sie mit der Maus auf Symbole im Editor zeigen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the menus in the title bar.\n\nDefault: false"
msgstr "Legt fest, ob die Menüs in der Titelleiste angezeigt werden.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show the merge conflict indicator in the status bar\nthat offers to resolve conflicts using the agent.\n\nDefault: true"
msgstr "Legt fest, ob in der Statusleiste die Merge-Konflikt-Anzeige eingeblendet wird, die anbietet, Konflikte mit dem Agenten aufzulösen.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the name of the active file in the status bar.\n\nDefault: false"
msgstr "Legt fest, ob der Name der aktiven Datei in der Statusleiste angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show the outline panel button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des Gliederungspanels in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the panel button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des Panels in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the project diagnostics button in the status bar."
msgstr "Legt fest, ob die Schaltfläche für Projektdiagnosen in der Statusleiste angezeigt wird."

msgctxt "settings schema"
msgid "Whether to show the project host and name in the titlebar.\n\nDefault: true"
msgstr "Legt fest, ob Host und Name des Projekts in der Titelleiste angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the project panel button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des Projektpanels in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the project search button in the status bar."
msgstr "Legt fest, ob die Schaltfläche für die Projektsuche in der Statusleiste angezeigt wird."

msgctxt "settings schema"
msgid "Whether to show the selections menu in the editor toolbar.\n\nDefault: true"
msgstr "Legt fest, ob das Auswahlmenü in der Symbolleiste des Editors angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the sign in button in the title bar.\n\nDefault: true"
msgstr "Legt fest, ob die Anmelden-Schaltfläche in der Titelleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the signature help pop-up after completions or bracket pairs inserted.\n\nDefault: false"
msgstr "Legt fest, ob das Popup der Signaturhilfe nach dem Einfügen von Vervollständigungen oder Klammerpaaren angezeigt wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show the stage and restore buttons on diff hunks.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltflächen zum Stagen und Wiederherstellen an Diff-Hunks angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the terminal button in the status bar.\n\nDefault: true"
msgstr "Legt fest, ob die Terminal-Schaltfläche in der Statusleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the user menu button in the title bar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche des Benutzermenüs in der Titelleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show the which-key popup when holding down key combinations.\nWhen enabled, the pending keystrokes indicator remains visible, but its binding preview\npopover is disabled.\n\nDefault: false"
msgstr "Legt fest, ob das Which-Key-Popup angezeigt wird, wenn Tastenkombinationen gedrückt gehalten werden.\nWenn aktiviert, bleibt die Anzeige ausstehender Tastenanschläge sichtbar, ihr Vorschau-Popup der Tastenkombinationen ist jedoch deaktiviert.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show the worktree name button in the titlebar.\n\nDefault: true"
msgstr "Legt fest, ob die Schaltfläche mit dem Worktree-Namen in der Titelleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show thumb buttons for feedback in the agent panel.\n\nDefault: true"
msgstr "Legt fest, ob im Agent-Panel Daumen-Schaltflächen für Feedback angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show turn statistics (elapsed time during generation, final turn duration).\n\nDefault: false"
msgstr "Legt fest, ob Statistiken zum Durchgang angezeigt werden (verstrichene Zeit während der Generierung, endgültige Dauer des Durchgangs).\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to show user avatar in the title bar.\n\nDefault: true"
msgstr "Legt fest, ob der Benutzeravatar in der Titelleiste angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to show wrap guides in the editor. Setting this to true will\nshow a guide at the 'preferred_line_length' value if softwrap is set to\n'preferred_line_length', and will show any additional guides as specified\nby the 'wrap_guides' setting.\n\nDefault: true"
msgstr "Legt fest, ob Umbruchführungslinien im Editor angezeigt werden. Bei true wird eine Führungslinie beim Wert von 'preferred_line_length' angezeigt, wenn softwrap auf 'preferred_line_length' gesetzt ist, sowie alle weiteren Führungslinien, die in der Einstellung 'wrap_guides' angegeben sind.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to sort file and folder names case-sensitively in the project panel.\nThis works in combination with `sort_mode`. `sort_mode` controls how files and\ndirectories are grouped, while this setting controls how names are compared.\n\nDefault: default"
msgstr "Legt fest, ob Datei- und Ordnernamen im Projektpanel unter Beachtung der Groß-/Kleinschreibung sortiert werden.\nDies wirkt zusammen mit `sort_mode`: `sort_mode` steuert, wie Dateien und Verzeichnisse gruppiert werden, während diese Einstellung steuert, wie Namen verglichen werden.\n\nStandard: default"

msgctxt "settings schema"
msgid "Whether to split the thread history into the agent panel itself,\nas a list to the left of the current thread.\n\nDefault: true"
msgstr "Legt fest, ob der Thread-Verlauf als Liste links neben dem aktuellen Thread direkt im Agent-Panel angezeigt wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to start a new line with a comment when a previous line is a comment as well.\n\nDefault: true"
msgstr "Legt fest, ob eine neue Zeile mit einem Kommentar beginnt, wenn die vorherige Zeile ebenfalls ein Kommentar ist.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to stick parent directories at top of the project panel.\n\nDefault: true"
msgstr "Legt fest, ob übergeordnete Verzeichnisse oben im Projektpanel fixiert werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to tell a connected Claude Code CLI which file is open when\nnothing is selected (the CLI shows it as \"In <file>\" and attaches the\nfile to the next message). When off, only a selection of one or more\nlines is sent.\n\nDefault: true"
msgstr "Legt fest, ob einer verbundenen Claude Code CLI mitgeteilt wird, welche Datei geöffnet ist, wenn nichts ausgewählt ist (die CLI zeigt sie als \"In <file>\" an und hängt die Datei an die nächste Nachricht an). Wenn ausgeschaltet, wird nur eine Auswahl von einer oder mehreren Zeilen gesendet.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to use additional LSP queries to format (and amend) the code after\nevery \"trigger\" symbol input, defined by LSP server capabilities.\n\nDefault: true"
msgstr "Legt fest, ob nach jeder Eingabe eines „Trigger“-Zeichens, das durch die Fähigkeiten des LSP-Servers definiert ist, zusätzliche LSP-Abfragen verwendet werden, um den Code zu formatieren (und zu korrigieren).\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to use command history ranking for sorting in the command palette.\n\nDefault: true"
msgstr "Legt fest, ob die Rangfolge des Befehlsverlaufs zum Sortieren in der Befehlspalette verwendet wird.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to use gitignored files when searching.\nOnly the file Zed had indexed will be used, not necessary all the gitignored files.\n\nDefault: Smart"
msgstr "Legt fest, ob bei der Suche von Git ignorierte Dateien verwendet werden.\nEs werden nur die Dateien verwendet, die ForgeKairos indiziert hat, nicht unbedingt alle ignorierten Dateien.\n\nStandard: Smart"

msgctxt "settings schema"
msgid "Whether to use language servers to provide code intelligence.\n\nDefault: true"
msgstr "Legt fest, ob Sprachserver für Code-Intelligenz verwendet werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to use the system provided dialogs for Open and Save As.\nWhen set to false, Zed will use the built-in keyboard-first pickers.\n\nDefault: true"
msgstr "Legt fest, ob für „Öffnen“ und „Speichern unter“ die Dialoge des Systems verwendet werden.\nBei false verwendet ForgeKairos die integrierten, tastaturorientierten Auswahldialoge.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to use the system provided prompts.\nWhen set to false, Zed will use the built-in prompts.\nNote that this setting has no effect on Linux, where Zed will always\nuse the built-in prompts.\n\nDefault: true"
msgstr "Legt fest, ob die Abfragedialoge des Systems verwendet werden.\nBei false verwendet ForgeKairos die integrierten Abfragedialoge.\nUnter Linux hat diese Einstellung keine Wirkung; dort verwendet ForgeKairos immer die integrierten Abfragedialoge.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether to use tree-sitter bracket queries to detect and colorize the brackets in the editor.\n\nDefault: false"
msgstr "Legt fest, ob Tree-sitter-Klammerabfragen verwendet werden, um Klammern im Editor zu erkennen und einzufärben.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether to warn (Windows/WSL only) when a sandbox grant targets a file on\na Windows-hosted (DrvFs) filesystem. Such grants are enforced inside WSL\nvia a translated path, and their sandbox-integrity guarantees are weaker\nthan a distro-native filesystem. When enabled, such grants show a warning\nthat must be acknowledged before the command runs.\nDefault: true"
msgstr "Legt fest, ob gewarnt wird (nur Windows/WSL), wenn eine Sandbox-Berechtigung eine Datei auf einem von Windows bereitgestellten Dateisystem (DrvFs) betrifft. Solche Berechtigungen werden innerhalb von WSL über einen übersetzten Pfad durchgesetzt, und ihre Garantien für die Integrität der Sandbox sind schwächer als bei einem distributionseigenen Dateisystem. Wenn aktiviert, zeigen solche Berechtigungen eine Warnung an, der vor der Ausführung des Befehls zugestimmt werden muss.\nStandard: true"

msgctxt "settings schema"
msgid "Whether to warn when a sandbox escalation prompt requests a domain or\nwrite path that contains potentially confusable Unicode characters\n(homoglyphs, invisible characters, or bidirectional overrides). When\nenabled, such prompts show a warning that must be acknowledged before\nthe request can be allowed.\nDefault: true"
msgstr "Legt fest, ob gewarnt wird, wenn eine Abfrage zur Rechteerweiterung der Sandbox eine Domain oder einen Schreibpfad anfordert, der möglicherweise verwechselbare Unicode-Zeichen enthält (Homoglyphen, unsichtbare Zeichen oder bidirektionale Überschreibungen). Wenn aktiviert, zeigen solche Abfragen eine Warnung an, der zugestimmt werden muss, bevor die Anfrage zugelassen werden kann.\nStandard: true"

msgctxt "settings schema"
msgid "Whether to zoom the editor font size with the mouse wheel\nwhile holding the primary modifier key (Cmd on macOS, Ctrl on other platforms).\n\nDefault: false"
msgstr "Legt fest, ob die Schriftgröße des Editors mit dem Mausrad gezoomt wird, während die primäre Zusatztaste gedrückt gehalten wird (Cmd unter macOS, Ctrl auf anderen Plattformen).\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether type hints should be shown.\n\nDefault: true"
msgstr "Legt fest, ob Typhinweise angezeigt werden.\n\nStandard: true"

msgctxt "settings schema"
msgid "Whether update checks also consider pre-releases. By default only releases are considered.\n\nDefault: false"
msgstr "Legt fest, ob die Suche nach Updates auch Vorabversionen berücksichtigt. Standardmäßig werden nur Releases berücksichtigt.\n\nStandard: false"

msgctxt "settings schema"
msgid "Whether your current project should be shared when joining an empty channel.\n\nDefault: false"
msgstr "Legt fest, ob Ihr aktuelles Projekt beim Beitreten zu einem leeren Kanal freigegeben wird.\n\nStandard: false"

msgctxt "settings schema"
msgid "Which base git features (gutter, file colors, git::Diff) diff against.\n\nDefault: head"
msgstr "Die Basis, gegen die Git-Funktionen (Randleiste, Dateifarben, git::Diff) den Diff bilden.\n\nStandard: head"

msgctxt "settings schema"
msgid "Which code actions to run on save before the formatter.\nThese are not run if formatting is off.\n\nDefault: {} (or {\"source.organizeImports\": true} for Go)."
msgstr "Die Codeaktionen, die beim Speichern vor dem Formatierer ausgeführt werden.\nSie werden nicht ausgeführt, wenn die Formatierung ausgeschaltet ist.\n\nStandard: {} (bzw. {\"source.organizeImports\": true} für Go)."

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar.\n\nDefault: all"
msgstr "Die Diagnosemarkierungen, die in der Scrollleiste angezeigt werden.\n\nStandard: all"

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar:\n\nDefault: all"
msgstr "Die Diagnosemarkierungen, die in der Scrollleiste angezeigt werden:\n\nStandard: all"

msgctxt "settings schema"
msgid "Which dock gets a pair of panels arranged in it the first time a project\nis opened. The dock itself is not opened for it; each panel's\n`starts_open` decides that. Once a project has a saved dock layout, that\nlayout is restored instead and this setting no longer applies to it.\n\nDefault: right"
msgstr "Das Dock, in dem beim ersten Öffnen eines Projekts ein Paar von Panels angeordnet wird. Das Dock selbst wird dafür nicht geöffnet; das entscheidet `starts_open` des jeweiligen Panels. Sobald ein Projekt ein gespeichertes Dock-Layout hat, wird stattdessen dieses Layout wiederhergestellt und diese Einstellung gilt nicht mehr dafür.\n\nStandard: right"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the project panel.\n\nDefault: all"
msgstr "Welche Dateien mit Diagnosefehlern/-warnungen im Projektpanel markiert werden.\n\nStandard: all"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the tabs.\nThis setting can take the following three values:\n\nDefault: off"
msgstr "Welche Dateien mit Diagnosefehlern/-warnungen in den Tabs markiert werden.\nDiese Einstellung kann die folgenden drei Werte annehmen:\n\nStandard: off"

msgctxt "settings schema"
msgid "Which fullscreen mode the `zed::ToggleFullScreen` action enters (macOS only).\n\nDefault: native"
msgstr "Der Vollbildmodus, in den die Aktion `zed::ToggleFullScreen` wechselt (nur macOS).\n\nStandard: native"

msgctxt "settings schema"
msgid "Which information to show in the branch picker.\n\nDefault: on"
msgstr "Die Informationen, die in der Branch-Auswahl angezeigt werden.\n\nStandard: on"

msgctxt "settings schema"
msgid "Which level to use to filter out diagnostics displayed in the editor.\n\nAffects the editor rendering only, and does not interrupt\nthe functionality of diagnostics fetching and project diagnostics editor.\nWhich files containing diagnostic errors/warnings to mark in the tabs.\nDiagnostics are only shown when file icons are also active.\n\nShows all diagnostics if not specified.\n\nDefault: warning"
msgstr "Die Stufe, nach der die im Editor angezeigten Diagnosen gefiltert werden.\n\nBetrifft nur die Darstellung im Editor und beeinträchtigt weder das Abrufen der Diagnosen noch den Projektdiagnose-Editor.\nWelche Dateien mit Diagnosefehlern/-warnungen in den Tabs markiert werden.\nDiagnosen werden nur angezeigt, wenn auch Dateisymbole aktiv sind.\n\nOhne Angabe werden alle Diagnosen angezeigt.\n\nStandard: warning"

msgctxt "settings schema"
msgid "Which sources the panel lists calls from: the language server, which\nis exact, the symbol index of C and C++ files, which matches names, or\nboth.\n\nDefault: all"
msgstr "Die Quellen, aus denen das Panel Aufrufe auflistet: der Sprachserver, der exakt ist, der Symbolindex von C- und C++-Dateien, der Namen abgleicht, oder beide.\n\nStandard: all"

msgctxt "settings schema"
msgid "Which untracked files `git status` reports.\n\n`all` lists every file inside an untracked directory, which is what\ncolours individual entries in the project panel. `normal` only lists the\nuntracked directory itself, and `no` skips untracked files entirely;\nboth make `git status` markedly cheaper on very large trees.\n\nDefault: all"
msgstr "Welche nicht verfolgten Dateien `git status` meldet.\n\n`all` listet jede Datei in einem nicht verfolgten Verzeichnis auf; dadurch werden einzelne Einträge im Projektpanel eingefärbt. `normal` listet nur das nicht verfolgte Verzeichnis selbst auf, und `no` überspringt nicht verfolgte Dateien vollständig; beide machen `git status` bei sehr großen Verzeichnisbäumen deutlich günstiger.\n\nStandard: all"

msgctxt "settings schema"
msgid "White ANSI terminal color."
msgstr "Weiße ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Width scales automatically with the buffer font size."
msgstr "Die Breite wird automatisch an die Pufferschriftgröße angepasst."

msgctxt "settings schema"
msgid "Window title template.\n\nAvailable variables are `${projectName}`, `${fileName}`,\n`${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`,\n`${remoteHost}`, `${appName}`, `${branch}`,\nand `${separator}`.\n`${separator}` is omitted when adjacent variables are empty,\nbut literal text is preserved.\nThe collaboration indicator, when present, is appended after the\nrendered template.\nIf the template renders to nothing, the default template is used instead.\n\nDefault: `${projectName}${separator}${fileName}`"
msgstr "Vorlage für den Fenstertitel.\n\nVerfügbare Variablen sind `${projectName}`, `${fileName}`, `${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`, `${remoteHost}`, `${appName}`, `${branch}` und `${separator}`.\n`${separator}` wird weggelassen, wenn angrenzende Variablen leer sind, wörtlicher Text bleibt jedoch erhalten.\nDie Anzeige für Zusammenarbeit wird, falls vorhanden, nach der gerenderten Vorlage angehängt.\nWenn die Vorlage leer gerendert wird, wird stattdessen die Standardvorlage verwendet.\n\nStandard: `${projectName}${separator}${fileName}`"

msgctxt "settings schema"
msgid "Yellow ANSI terminal color."
msgstr "Gelbe ANSI-Terminalfarbe."

msgctxt "settings schema"
msgid "Zed draws its own window decorations/titlebar (client-side decoration)."
msgstr "ForgeKairos zeichnet eigene Fensterdekorationen/Titelleiste (clientseitige Dekoration)."

msgctxt "settings schema"
msgid "Zed's Prettier integration settings.\nAllows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\n\nDefault: off"
msgstr "Einstellungen für die Prettier-Integration von ForgeKairos.\nErmöglicht es, die Formatierung mit Prettier zu aktivieren/deaktivieren und das Standard-Prettier zu konfigurieren, das verwendet wird, wenn keine Prettier-Installation auf Projektebene gefunden wird.\n\nStandard: off"

msgctxt "settings schema"
msgid "clangd's memory use: its index mode, worker count and a limit at which it\nis restarted."
msgstr "Speichernutzung von clangd: Indexmodus, Anzahl der Worker und ein Grenzwert, bei dem clangd neu gestartet wird."
