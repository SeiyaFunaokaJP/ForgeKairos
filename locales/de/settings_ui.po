msgid "\"Sandbox\" on the \"AI\" page is a separate setting that isolates the commands agents run (restricting which domains they can reach and where they can write). However, domains allowed there take effect only within this list. Think of the sandbox as narrowing this scope further rather than widening what is allowed."
msgstr "„Sandbox“ auf der Seite „KI“ ist eine separate Einstellung, die die von Agenten ausgeführten Befehle isoliert (sie beschränkt, welche Domains erreichbar sind und wohin geschrieben werden darf). Dort zugelassene Domains wirken jedoch nur innerhalb dieser Liste. Die Sandbox schränkt diesen Bereich also weiter ein, statt das Zugelassene zu erweitern."

msgid "\"{label}\": \"{name}\" in `{key}` must be a string."
msgstr "„{label}“: „{name}“ in `{key}` muss eine Zeichenfolge sein."

msgid "\"{label}\": `args` must be an array of strings."
msgstr "„{label}“: `args` muss ein Array von Zeichenfolgen sein."

msgid "\"{label}\": `command.path` must be a string."
msgstr "„{label}“: `command.path` muss eine Zeichenfolge sein."

msgid "\"{label}\": `command` is empty."
msgstr "„{label}“: `command` ist leer."

msgid "\"{label}\": `command` must be a string."
msgstr "„{label}“: `command` muss eine Zeichenfolge sein."

msgid "\"{label}\": `enabled` must be true or false."
msgstr "„{label}“: `enabled` muss true oder false sein."

msgid "\"{label}\": `oauth` must look like {{ \"client_id\": \"…\" }}."
msgstr "„{label}“: `oauth` muss die Form {{ \"client_id\": \"…\" }} haben."

msgid "\"{label}\": `remote` must be true or false."
msgstr "„{label}“: `remote` muss true oder false sein."

msgid "\"{label}\": `timeout` must be a positive whole number of seconds."
msgstr "„{label}“: `timeout` muss eine positive ganze Zahl von Sekunden sein."

msgid "\"{label}\": `type` \"{kind}\" is not supported. Use `stdio`, `http`, or `sse`."
msgstr "„{label}“: `type` „{kind}“ wird nicht unterstützt. Verwenden Sie `stdio`, `http` oder `sse`."

msgid "\"{label}\": `type` must be a string."
msgstr "„{label}“: `type` muss eine Zeichenfolge sein."

msgid "\"{label}\": `url` is not set."
msgstr "„{label}“: `url` ist nicht festgelegt."

msgid "\"{label}\": `{key}` must be a URL string."
msgstr "„{label}“: `{key}` muss eine URL-Zeichenfolge sein."

msgid "\"{label}\": `{key}` must be an object ({{ … }})."
msgstr "„{label}“: `{key}` muss ein Objekt sein ({{ … }})."

