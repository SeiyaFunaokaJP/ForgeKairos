msgid "[directory{}]filename.ext"
msgstr "[Verzeichnis{}]Dateiname.ext"

msgid "go to parent directory"
msgstr "zum übergeordneten Verzeichnis wechseln"

msgid "go to parent directory ({parent})"
msgstr "zum übergeordneten Verzeichnis wechseln ({parent})"

msgid "open this directory"
msgstr "dieses Verzeichnis öffnen"

