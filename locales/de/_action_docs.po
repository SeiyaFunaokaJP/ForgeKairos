msgctxt "action documentation"
msgid "editor::NewlineAbove"
msgstr "Fügt eine neue Zeile oberhalb der aktuellen Zeile ein."

#. Inserts a new line below the current line.
msgctxt "action documentation"
msgid "editor::NewlineBelow"
msgstr "Fügt eine neue Zeile unterhalb der aktuellen Zeile ein."

