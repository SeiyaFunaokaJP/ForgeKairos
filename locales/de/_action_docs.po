msgid "editor::SelectToEndOfLine"
msgstr "Wählt vom Cursor bis zum Ende der aktuellen Zeile aus."

#. Selects to the end of the paragraph.
msgctxt "action documentation"
msgid "editor::SelectToEndOfParagraph"
msgstr "Erweitert die Auswahl bis zum Ende des Absatzes."

#. Selects to the end of the previous excerpt.
msgctxt "action documentation"
msgid "editor::SelectToEndOfPreviousExcerpt"
msgstr "Erweitert die Auswahl bis zum Ende des vorherigen Auszugs."

#. Selects to the end of the next subword.
msgctxt "action documentation"
msgid "editor::SelectToNextSubwordEnd"
msgstr "Erweitert die Auswahl bis zum Ende des nächsten Teilworts."

#. Selects to the end of the next word.
msgctxt "action documentation"
msgid "editor::SelectToNextWordEnd"
msgstr "Erweitert die Auswahl bis zum Ende des nächsten Worts."

#. Selects to the start of the previous subword.
msgctxt "action documentation"
msgid "editor::SelectToPreviousSubwordStart"
msgstr "Erweitert die Auswahl bis zum Anfang des vorherigen Teilworts."

#. Selects to the start of the previous word.
msgctxt "action documentation"
msgid "editor::SelectToPreviousWordStart"
msgstr "Erweitert die Auswahl bis zum Anfang des vorherigen Worts."

#. Selects to the start of the current excerpt.
msgctxt "action documentation"
msgid "editor::SelectToStartOfExcerpt"
msgstr "Erweitert die Auswahl bis zum Anfang des aktuellen Auszugs."

#. Selects to the start of the next larger syntax node.
msgctxt "action documentation"
msgid "editor::SelectToStartOfLargerSyntaxNode"
msgstr "Erweitert die Auswahl bis zum Anfang des nächstgrößeren Syntaxknotens."

#. Selects to the start of the next excerpt.
msgctxt "action documentation"
msgid "editor::SelectToStartOfNextExcerpt"
msgstr "Erweitert die Auswahl bis zum Anfang des nächsten Auszugs."

#. Selects to the start of the paragraph.
msgctxt "action documentation"
msgid "editor::SelectToStartOfParagraph"
msgstr "Erweitert die Auswahl bis zum Anfang des Absatzes."

#. Extends selection up.
msgctxt "action documentation"
msgid "editor::SelectUp"
msgstr "Erweitert die Auswahl nach oben."

#. Extends selection up by a specified number of lines.
msgctxt "action documentation"
msgid "editor::SelectUpByLines"
msgstr "Erweitert die Auswahl um eine angegebene Anzahl von Zeilen nach oben."

#. Sends all stored review comments to the Agent panel.
msgctxt "action documentation"
msgid "editor::SendReviewToAgent"
msgstr "Sendet alle gespeicherten Review-Kommentare an das Agent-Panel."

#. Sets a mark at the current position.
msgctxt "action documentation"
msgid "editor::SetMark"
msgstr "Setzt eine Markierung an der aktuellen Position."

#. Shows the system character palette.
msgctxt "action documentation"
msgid "editor::ShowCharacterPalette"
msgstr "Zeigt die Systemzeichenpalette an."

#. Shows code completion suggestions at the cursor position.
msgctxt "action documentation"
msgid "editor::ShowCompletions"
msgstr "Zeigt Code-Vervollständigungsvorschläge an der Cursorposition an."

#. Shows edit prediction at cursor.
msgctxt "action documentation"
msgid "editor::ShowEditPrediction"
msgstr "Zeigt die Bearbeitungsvorhersage am Cursor an."

#. Shows signature help for the current function.
msgctxt "action documentation"
msgid "editor::ShowSignatureHelp"
msgstr "Zeigt die Signaturhilfe für die aktuelle Funktion an."

#. Shows word completions.
msgctxt "action documentation"
msgid "editor::ShowWordCompletions"
msgstr "Zeigt Wortvervollständigungen an."

#. Randomly shuffles selected lines.
msgctxt "action documentation"
msgid "editor::ShuffleLines"
msgstr "Mischt die ausgewählten Zeilen zufällig durch."

#. Navigates to the next signature in the signature help popup.
msgctxt "action documentation"
msgid "editor::SignatureHelpNext"
msgstr "Navigiert zur nächsten Signatur im Signaturhilfe-Popup."

#. Navigates to the previous signature in the signature help popup.
msgctxt "action documentation"
msgid "editor::SignatureHelpPrevious"
msgstr "Navigiert zur vorherigen Signatur im Signaturhilfe-Popup."

#. Sorts selected lines by length.
msgctxt "action documentation"
msgid "editor::SortLinesByLength"
msgstr "Sortiert ausgewählte Zeilen nach Länge."

#. Sorts selected lines case-insensitively.
msgctxt "action documentation"
msgid "editor::SortLinesCaseInsensitive"
msgstr "Sortiert ausgewählte Zeilen ohne Berücksichtigung der Groß-/Kleinschreibung."

#. Sorts selected lines case-sensitively.
msgctxt "action documentation"
msgid "editor::SortLinesCaseSensitive"
msgstr "Sortiert ausgewählte Zeilen unter Berücksichtigung der Groß-/Kleinschreibung."

#. Spawns the nearest available task from the current cursor position.
msgctxt "action documentation"
msgid "editor::SpawnNearestTask"
msgstr "Startet die nächstgelegene verfügbare Aufgabe von der aktuellen Cursorposition."

#. Splits selection into individual lines.
msgctxt "action documentation"
msgid "editor::SplitSelectionIntoLines"
msgstr "Teilt die Auswahl in einzelne Zeilen auf."

#. Stops the language server for the current file.
msgctxt "action documentation"
msgid "editor::StopLanguageServer"
msgstr "Beendet den Sprachserver für die aktuelle Datei."

#. Stores the diff review comment locally (for later batch submission).
msgctxt "action documentation"
msgid "editor::SubmitDiffReviewComment"
msgstr "Speichert den Diff-Prüfungskommentar lokal (für spätere Stapelübermittlung)."

