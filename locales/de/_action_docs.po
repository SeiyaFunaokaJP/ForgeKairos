msgid "editor::SelectToEnd"
msgstr "Erweitert die Auswahl bis zum Ende des Dokuments."

#. Selects to the end of the current excerpt.
msgctxt "action documentation"
msgid "editor::SelectToEndOfExcerpt"
msgstr "Erweitert die Auswahl bis zum Ende des aktuellen Auszugs."

#. Selects to the end of the next larger syntax node.
msgctxt "action documentation"
msgid "editor::SelectToEndOfLargerSyntaxNode"
msgstr "Erweitert die Auswahl bis zum Ende des nächstgrößeren Syntaxknotens."

#. Selects from the cursor to the end of the current line.
