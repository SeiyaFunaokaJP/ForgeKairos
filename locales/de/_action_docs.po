msgctxt "action documentation"
msgid "call_graph_panel::InspectCursor"
msgstr "Macht die Funktion unter dem Cursor des Editors zum Ausgangspunkt."

#. Goes forward to the next root.
msgctxt "action documentation"
msgid "call_graph_panel::NextRoot"
msgstr "Wechselt vorwärts zum nächsten Ausgangspunkt."

