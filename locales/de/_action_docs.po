msgid "editor::SelectPrevious"
msgstr "Wählt das vorherige Vorkommen der aktuellen Auswahl aus."

#. Selects the previous syntax node sibling.
msgctxt "action documentation"
msgid "editor::SelectPreviousSyntaxNode"
msgstr "Wählt den vorherigen Geschwisterknoten im Syntaxbaum aus."

#. Extends selection right.
msgctxt "action documentation"
msgid "editor::SelectRight"
msgstr "Erweitert die Auswahl nach rechts."

#. Selects the next smaller syntax node.
msgctxt "action documentation"
msgid "editor::SelectSmallerSyntaxNode"
msgstr "Wählt den nächstkleineren Syntaxknoten aus."

