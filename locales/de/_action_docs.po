msgctxt "action documentation"
msgid "browser_panel::SplitPanelRight"
msgstr "Verschiebt den aktuellen Tab nach rechts und teilt das Browser-Panel in zwei Bereiche."

#. Stops AI control of the current AI tab: the running command is cancelled and further commands are refused until it is resumed.
msgctxt "action documentation"
msgid "browser_panel::StopAiControl"
msgstr "Beendet die KI-Steuerung des aktuellen KI-Tabs: Der laufende Befehl wird abgebrochen und weitere Befehle werden abgelehnt, bis die Steuerung fortgesetzt wird."

#. Opens the URL or the search terms typed in the address bar.
msgctxt "action documentation"
msgid "browser_panel::SubmitAddress"
msgstr "Öffnet die URL oder die Suchbegriffe, die in die Adressleiste eingegeben wurden."

#. Toggles the built-in browser panel.
msgctxt "action documentation"
msgid "browser_panel::Toggle"
msgstr "Blendet das integrierte Browser-Panel ein oder aus."

#. Shows or hides the list of bookmarks.
msgctxt "action documentation"
msgid "browser_panel::ToggleBookmarks"
msgstr "Blendet die Liste der Lesezeichen ein oder aus."

#. Toggles focus on the built-in browser panel.
msgctxt "action documentation"
msgid "browser_panel::ToggleFocus"
msgstr "Schaltet den Fokus auf das integrierte Browser-Panel um."

#. Opens the buffer search interface with the specified configuration.
msgctxt "action documentation"
msgid "buffer_search::Deploy"
msgstr "Öffnet die Puffersuchoberfläche mit der angegebenen Konfiguration."

#. Deploys the search and replace interface.
msgctxt "action documentation"
msgid "buffer_search::DeployReplace"
msgstr "Öffnet die Suchen-und-Ersetzen-Oberfläche."

#. Dismisses the search bar.
msgctxt "action documentation"
msgid "buffer_search::Dismiss"
msgstr "Schließt die Suchleiste."

#. Focuses back on the editor.
msgctxt "action documentation"
msgid "buffer_search::FocusEditor"
msgstr "Setzt den Fokus zurück auf den Editor."

#. Sets the search query from the selection or word under cursor.
msgctxt "action documentation"
msgid "buffer_search::UseSelectionForFind"
msgstr "Legt die Suchanfrage aus der Auswahl oder dem Wort unter dem Cursor fest."

#. Collapses every function under the root.
msgctxt "action documentation"
msgid "call_graph_panel::CollapseAll"
msgstr "Klappt jede Funktion unterhalb des Ausgangspunkts zu."

#. Collapses the selected function, or moves to its parent.
msgctxt "action documentation"
msgid "call_graph_panel::CollapseSelected"
msgstr "Klappt die ausgewählte Funktion zu oder wechselt zu ihrem übergeordneten Element."

#. Copies the name of the selected function.
msgctxt "action documentation"
msgid "call_graph_panel::CopySymbolName"
msgstr "Kopiert den Namen der ausgewählten Funktion."

#. Expands the selected function, or moves into its first child.
msgctxt "action documentation"
msgid "call_graph_panel::ExpandSelected"
msgstr "Klappt die ausgewählte Funktion auf oder wechselt zu ihrem ersten untergeordneten Element."

