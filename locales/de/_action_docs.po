msgctxt "action documentation"
msgid "browser_panel::OpenDeveloperTools"
msgstr "Öffnet die Entwicklertools des aktuellen Browser-Tabs."

#. Moves the page open in the browser panel to a tab in the editor area.
msgctxt "action documentation"
msgid "browser_panel::OpenInCenter"
msgstr "Verschiebt die im Browser-Panel geöffnete Seite in einen Tab im Editorbereich."

#. Opens the current page in the system's default browser.
msgctxt "action documentation"
msgid "browser_panel::OpenInExternalBrowser"
msgstr "Öffnet die aktuelle Seite im Standardbrowser des Systems."

