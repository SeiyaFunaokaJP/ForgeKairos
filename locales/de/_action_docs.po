msgctxt "action documentation"
msgid "repl::RunInPlace"
msgstr "Führt die aktuelle Zelle aus, ohne zur nächsten Zelle zu wechseln."

#. Opens the REPL sessions panel.
msgctxt "action documentation"
msgid "repl::Sessions"
msgstr "Öffnet das REPL-Sitzungspanel."

#. Shuts down the current kernel.
msgctxt "action documentation"
msgid "repl::Shutdown"
msgstr "Fährt den aktuellen Kernel herunter."

#. Cycles through search modes.
msgctxt "action documentation"
msgid "search::CycleMode"
msgstr "Durchläuft die Suchmodi."

#. Focuses on the search input field.
msgctxt "action documentation"
msgid "search::FocusSearch"
msgstr "Fokussiert das Sucheingabefeld."

#. Navigates to the next query in search history.
msgctxt "action documentation"
msgid "search::NextHistoryQuery"
msgstr "Navigiert zur nächsten Abfrage im Suchverlauf."

#. Navigates to the previous query in search history.
msgctxt "action documentation"
msgid "search::PreviousHistoryQuery"
msgstr "Navigiert zur vorherigen Abfrage im Suchverlauf."

#. Replaces all matches.
msgctxt "action documentation"
msgid "search::ReplaceAll"
msgstr "Ersetzt alle Treffer."

#. Replaces the next match.
msgctxt "action documentation"
msgid "search::ReplaceNext"
msgstr "Ersetzt den nächsten Treffer."

#. Selects all search matches.
msgctxt "action documentation"
msgid "search::SelectAllMatches"
msgstr "Wählt alle Suchtreffer aus."

#. Selects the next search match.
msgctxt "action documentation"
msgid "search::SelectNextMatch"
msgstr "Wählt den nächsten Suchtreffer aus."

#. Selects the previous search match.
msgctxt "action documentation"
msgid "search::SelectPreviousMatch"
msgstr "Wählt den vorherigen Suchtreffer aus."

#. Toggles case-sensitive search.
msgctxt "action documentation"
msgid "search::ToggleCaseSensitive"
msgstr "Schaltet die Berücksichtigung der Groß-/Kleinschreibung bei der Suche um."

#. Toggles searching in ignored files.
msgctxt "action documentation"
msgid "search::ToggleIncludeIgnored"
msgstr "Schaltet die Suche in ignorierten Dateien um."

#. Toggles regular expression mode.
msgctxt "action documentation"
msgid "search::ToggleRegex"
msgstr "Schaltet den Modus für reguläre Ausdrücke um."

#. Toggles the replace interface.
msgctxt "action documentation"
msgid "search::ToggleReplace"
msgstr "Schaltet die Ersetzen-Oberfläche um."

#. Toggles searching within selection only.
msgctxt "action documentation"
msgid "search::ToggleSelection"
msgstr "Schaltet die Suche nur innerhalb der Auswahl ein oder aus."

#. Toggles whole word matching.
msgctxt "action documentation"
msgid "search::ToggleWholeWord"
msgstr "Schaltet die Ganzwort-Übereinstimmung um."

#. Collapses the navigation entry.
msgctxt "action documentation"
msgid "settings_editor::CollapseNavEntry"
msgstr "Klappt den Navigationseintrag zu."

#. Expands the navigation entry.
msgctxt "action documentation"
msgid "settings_editor::ExpandNavEntry"
msgstr "Klappt den Navigationseintrag auf."

#. Focuses the first navigation entry.
msgctxt "action documentation"
msgid "settings_editor::FocusFirstNavEntry"
msgstr "Fokussiert den ersten Navigationseintrag."

#. Focuses the last navigation entry.
msgctxt "action documentation"
msgid "settings_editor::FocusLastNavEntry"
msgstr "Fokussiert den letzten Navigationseintrag."

#. Focuses the next file in the file list.
msgctxt "action documentation"
msgid "settings_editor::FocusNextFile"
msgstr "Fokussiert die nächste Datei in der Dateiliste."

#. Focuses and opens the next navigation entry without moving focus to content.
msgctxt "action documentation"
msgid "settings_editor::FocusNextNavEntry"
msgstr "Fokussiert und öffnet den nächsten Navigationseintrag, ohne den Fokus auf den Inhalt zu verschieben."

#. Focuses the next root navigation entry.
msgctxt "action documentation"
msgid "settings_editor::FocusNextRootNavEntry"
msgstr "Fokussiert den nächsten Stamm-Navigationseintrag."

#. Focuses the previous file in the file list.
msgctxt "action documentation"
msgid "settings_editor::FocusPreviousFile"
msgstr "Fokussiert die vorherige Datei in der Dateiliste."

#. Focuses and opens the previous navigation entry without moving focus to content.
msgctxt "action documentation"
msgid "settings_editor::FocusPreviousNavEntry"
msgstr "Fokussiert und öffnet den vorherigen Navigationseintrag, ohne den Fokus auf den Inhalt zu verschieben."

#. Focuses the previous root navigation entry.
msgctxt "action documentation"
msgid "settings_editor::FocusPreviousRootNavEntry"
msgstr "Fokussiert den vorherigen Stamm-Navigationseintrag."

#. Minimizes the settings UI window.
msgctxt "action documentation"
msgid "settings_editor::Minimize"
msgstr "Minimiert das Einstellungsfenster."

#. Opens an editor for the current file
msgctxt "action documentation"
msgid "settings_editor::OpenCurrentFile"
msgstr "Öffnet einen Editor für die aktuelle Datei"

#. Toggles focus between the navbar and the main content.
msgctxt "action documentation"
msgid "settings_editor::ToggleFocusNav"
msgstr "Schaltet den Fokus zwischen der Navigationsleiste und dem Hauptinhalt um."

#. Opens the snippets configuration file.
msgctxt "action documentation"
msgid "snippets::ConfigureSnippets"
msgstr "Öffnet die Snippet-Konfigurationsdatei."

#. Opens the snippets folder in the file manager.
msgctxt "action documentation"
msgid "snippets::OpenFolder"
msgstr "Öffnet den Snippet-Ordner im Dateimanager."

#. Drop the selected stash entry.
msgctxt "action documentation"
msgid "stash_picker::DropStashItem"
msgstr "Verwirft den ausgewählten Stash-Eintrag."

#. Show the diff view of the selected stash entry.
msgctxt "action documentation"
msgid "stash_picker::ShowStashItem"
msgstr "Zeigt die Diff-Ansicht des ausgewählten Stash-Eintrags an."

#. Opens a following SVG preview that syncs with the editor.
msgctxt "action documentation"
msgid "svg::OpenFollowingPreview"
msgstr "Öffnet eine mitlaufende SVG-Vorschau, die mit dem Editor synchronisiert wird."

#. Opens an SVG preview for the current file.
msgctxt "action documentation"
msgid "svg::OpenPreview"
msgstr "Öffnet eine SVG-Vorschau für die aktuelle Datei."

#. Opens an SVG preview in a split pane.
msgctxt "action documentation"
msgid "svg::OpenPreviewToTheSide"
msgstr "Öffnet eine SVG-Vorschau in einem geteilten Bereich."

#. Update the syntax tree view to show the last focused file.
msgctxt "action documentation"
msgid "syntax_tree_view::UseActiveEditor"
msgstr "Aktualisiert die Syntaxbaumansicht, um die zuletzt fokussierte Datei anzuzeigen."

#. Closes the selected item in the tab switcher.
msgctxt "action documentation"
msgid "tab_switcher::CloseSelectedItem"
msgstr "Schließt das ausgewählte Element im Tab-Wechsler."

#. Toggles the tab switcher showing all tabs across all panes, deduplicated by path.
#. Opens selected items in the active pane.
msgctxt "action documentation"
msgid "tab_switcher::OpenInActivePane"
msgstr "Schaltet die Anzeige aller Tabs über alle Bereiche hinweg im Tab-Wechsler um, dedupliziert nach Pfad.\nÖffnet ausgewählte Elemente im aktiven Bereich."

#. Toggles the tab switcher interface.
msgctxt "action documentation"
msgid "tab_switcher::Toggle"
msgstr "Schaltet die Tab-Wechsler-Oberfläche um."

#. Toggles between showing all tabs or just the current pane's tabs.
msgctxt "action documentation"
msgid "tab_switcher::ToggleAll"
msgstr "Schaltet zwischen der Anzeige aller Tabs und nur der Tabs des aktuellen Bereichs um."

#. Adds an empty column at the right end of the table.
msgctxt "action documentation"
msgid "tabular_data::AppendColumn"
msgstr "Fügt am rechten Ende der Tabelle eine leere Spalte hinzu."

#. Adds an empty row at the end of the table.
msgctxt "action documentation"
msgid "tabular_data::AppendRow"
msgstr "Fügt am Ende der Tabelle eine leere Zeile hinzu."

#. Clears the filters of every column of the table.
msgctxt "action documentation"
msgid "tabular_data::ClearAllFilters"
msgstr "Entfernt die Filter aller Spalten der Tabelle."

#. Removes the fill and text colors of the selection.
msgctxt "action documentation"
msgid "tabular_data::ClearCellColors"
msgstr "Entfernt die Füll- und Textfarben der Auswahl."

#. Copies the first row of the selection to the whole selection.
msgctxt "action documentation"
msgid "tabular_data::FillDown"
msgstr "Kopiert die erste Zeile der Auswahl in die gesamte Auswahl."

#. Copies the first column of the selection to the whole selection.
msgctxt "action documentation"
msgid "tabular_data::FillRight"
msgstr "Kopiert die erste Spalte der Auswahl in die gesamte Auswahl."

#. Opens the same file as text, in the next pane by default. With `in_same_pane`,
#. the text replaces the grid in its tab.
msgctxt "action documentation"
msgid "tabular_data::OpenAsText"
msgstr "Öffnet dieselbe Datei als Text, standardmäßig im nächsten Bereich. Mit `in_same_pane` ersetzt der Text das Raster in dessen Tab."

#. Fills the selection with the given color.
msgctxt "action documentation"
msgid "tabular_data::SetFillColor"
msgstr "Füllt die Auswahl mit der angegebenen Farbe."

#. Changes the text color of the selection.
msgctxt "action documentation"
msgid "tabular_data::SetTextColor"
msgstr "Ändert die Textfarbe der Auswahl."

#. Opens the filter menu of the selected cell's column.
msgctxt "action documentation"
msgid "tabular_data::ToggleFilterMenu"
msgstr "Öffnet das Filtermenü der Spalte der ausgewählten Zelle."

#. Reruns the last task.
msgctxt "action documentation"
msgid "task::Rerun"
msgstr "Führt die letzte Aufgabe erneut aus."

#. Spawns a task with name or opens tasks modal.
msgctxt "action documentation"
msgid "task::Spawn"
msgstr "Startet eine Aufgabe mit dem angegebenen Namen oder öffnet das Aufgaben-Dialogfeld."

#. Stops the running macro.
msgctxt "action documentation"
msgid "terminal::CancelMacro"
msgstr "Stoppt das laufende Makro."

#. Clears the terminal screen.
msgctxt "action documentation"
msgid "terminal::Clear"
msgstr "Löscht den Terminalbildschirm."

#. Copies selected text to the clipboard.
msgctxt "action documentation"
msgid "terminal::Copy"
msgstr "Kopiert den ausgewählten Text in die Zwischenablage."

#. Edits the list of macros.
msgctxt "action documentation"
msgid "terminal::EditMacros"
msgstr "Bearbeitet die Liste der Makros."

#. Installs the Claude Code CLI by running its official install command in the integrated terminal.
msgctxt "action documentation"
msgid "terminal::InstallClaudeCode"
msgstr "Installiert die Claude Code CLI, indem deren offizieller Installationsbefehl im integrierten Terminal ausgeführt wird."

#. Launches the Claude Code CLI in a tab of the agent panel (in a terminal when there is no panel).
#. In a local project on Windows it runs inside the sandbox (WSL), in a Linux project over SSH
#. inside the remote host's sandbox, and elsewhere outside the sandbox after asking each time.
#. With "always launch outside the sandbox" set in the settings, it launches outside without asking.
msgctxt "action documentation"
msgid "terminal::LaunchClaudeCode"
msgstr "Startet die Claude Code CLI in einem Tab des Agent-Panels (in einem Terminal, wenn es kein Panel gibt).\nIn einem lokalen Projekt unter Windows läuft sie in der Sandbox (WSL), in einem Linux-Projekt über SSH in der Sandbox des Remote-Hosts und andernfalls außerhalb der Sandbox, nachdem jedes Mal nachgefragt wurde.\nIst in den Einstellungen „immer außerhalb der Sandbox starten“ festgelegt, wird sie ohne Nachfrage außerhalb gestartet."

#. Launches the Claude Code CLI outside the sandbox (with Zed's own permissions; over SSH, with
#. those of the remote user). Asks each time, unless "always launch outside the sandbox" is set
#. in the settings.
msgctxt "action documentation"
msgid "terminal::LaunchClaudeCodeOutsideSandbox"
msgstr "Startet die Claude Code CLI außerhalb der Sandbox (mit den eigenen Berechtigungen von ForgeKairos; über SSH mit denen des Remote-Benutzers). Fragt jedes Mal nach, sofern in den Einstellungen nicht „immer außerhalb der Sandbox starten“ festgelegt ist."

#. Opens a two-pane view for exchanging files with a remote host over SFTP, SCP or FTP.
msgctxt "action documentation"
msgid "terminal::OpenFileTransfer"
msgstr "Öffnet eine Ansicht mit zwei Bereichen zum Austausch von Dateien mit einem Remote-Host über SFTP, SCP oder FTP."

#. Reveals the log file being recorded in the file manager.
msgctxt "action documentation"
msgid "terminal::OpenSessionLog"
msgstr "Zeigt die aufgezeichnete Protokolldatei im Dateimanager an."

#. Pastes from the clipboard.
msgctxt "action documentation"
msgid "terminal::Paste"
msgstr "Fügt aus der Zwischenablage ein."

#. Pastes the text from the clipboard.
msgctxt "action documentation"
msgid "terminal::PasteText"
msgstr "Fügt den Text aus der Zwischenablage ein."

#. Opens a terminal connected to an SSH or Telnet host.
msgctxt "action documentation"
msgid "terminal::QuickConnect"
msgstr "Öffnet ein Terminal, das mit einem SSH- oder Telnet-Host verbunden ist."

#. Renames the terminal tab.
msgctxt "action documentation"
msgid "terminal::RenameTerminal"
msgstr "Benennt den Terminal-Tab um."

#. Reruns the last executed task in the terminal.
msgctxt "action documentation"
msgid "terminal::RerunTask"
msgstr "Führt die zuletzt ausgeführte Aufgabe im Terminal erneut aus."

#. Restarts an exited shell in the same working directory.
msgctxt "action documentation"
msgid "terminal::RestartTerminal"
msgstr "Startet eine beendete Shell im selben Arbeitsverzeichnis neu."

#. Chooses a saved macro and runs it in the active terminal.
msgctxt "action documentation"
msgid "terminal::RunMacro"
msgstr "Wählt ein gespeichertes Makro aus und führt es im aktiven Terminal aus."

#. Scrolls down by half a page.
msgctxt "action documentation"
msgid "terminal::ScrollHalfPageDown"
msgstr "Scrollt um eine halbe Seite nach unten."

#. Scrolls up by half a page.
msgctxt "action documentation"
msgid "terminal::ScrollHalfPageUp"
msgstr "Scrollt um eine halbe Seite nach oben."

#. Scrolls down by one line.
msgctxt "action documentation"
msgid "terminal::ScrollLineDown"
msgstr "Scrollt um eine Zeile nach unten."

#. Scrolls up by one line.
msgctxt "action documentation"
msgid "terminal::ScrollLineUp"
msgstr "Scrollt um eine Zeile nach oben."

#. Scrolls down by one page.
msgctxt "action documentation"
msgid "terminal::ScrollPageDown"
msgstr "Scrollt um eine Seite nach unten."

#. Scrolls up by one page.
msgctxt "action documentation"
msgid "terminal::ScrollPageUp"
msgstr "Scrollt um eine Seite nach oben."

#. Scrolls to the bottom of the terminal buffer.
msgctxt "action documentation"
msgid "terminal::ScrollToBottom"
msgstr "Scrollt zum Ende des Terminal-Puffers."

#. Scrolls to the top of the terminal buffer.
msgctxt "action documentation"
msgid "terminal::ScrollToTop"
msgstr "Scrollt zum Anfang des Terminal-Puffers."

#. Searches for text in the terminal.
msgctxt "action documentation"
msgid "terminal::SearchTest"
msgstr "Sucht nach Text im Terminal."

#. Selects all text in the terminal.
msgctxt "action documentation"
msgid "terminal::SelectAll"
msgstr "Wählt den gesamten Text im Terminal aus."

#. Sends a keystroke sequence to the terminal.
msgctxt "action documentation"
msgid "terminal::SendKeystroke"
msgstr "Sendet eine Folge von Tastenanschlägen an das Terminal."

#. Sends the specified text directly to the terminal.
msgctxt "action documentation"
msgid "terminal::SendText"
msgstr "Sendet den angegebenen Text direkt an das Terminal."

#. Shows the character palette for special characters.
msgctxt "action documentation"
msgid "terminal::ShowCharacterPalette"
msgstr "Zeigt die Zeichenpalette für Sonderzeichen an."

#. Splits the active terminal pane into a grid of new shells in one go, instead
#. of repeating Split Right / Split Down by hand.
msgctxt "action documentation"
msgid "terminal::SplitGrid"
msgstr "Teilt den aktiven Terminalbereich in einem Schritt in ein Raster neuer Shells, statt „Nach rechts teilen“ / „Nach unten teilen“ manuell zu wiederholen."

#. Starts recording the terminal's output to a file (asks where to save it).
msgctxt "action documentation"
msgid "terminal::StartSessionLog"
msgstr "Beginnt, die Ausgabe des Terminals in einer Datei aufzuzeichnen (fragt nach dem Speicherort)."

#. Stops recording the terminal's output.
msgctxt "action documentation"
msgid "terminal::StopSessionLog"
msgstr "Beendet die Aufzeichnung der Ausgabe des Terminals."

#. Opens the log file being recorded in the editor and follows its end.
msgctxt "action documentation"
msgid "terminal::TailSessionLog"
msgstr "Öffnet die aufgezeichnete Protokolldatei im Editor und folgt ihrem Ende."

#. Toggles typing into every pane of the same terminal panel at once.
msgctxt "action documentation"
msgid "terminal::ToggleBroadcastInput"
msgstr "Schaltet die gleichzeitige Eingabe in alle Bereiche desselben Terminal-Panels ein oder aus."

#. Starts or stops recording the terminal's output to the configured location.
msgctxt "action documentation"
msgid "terminal::ToggleSessionLog"
msgstr "Startet oder beendet die Aufzeichnung der Ausgabe des Terminals am konfigurierten Speicherort."

#. Toggles vi mode in the terminal.
msgctxt "action documentation"
msgid "terminal::ToggleViMode"
msgstr "Schaltet den Vi-Modus im Terminal um."

#. Toggles the terminal panel.
msgctxt "action documentation"
msgid "terminal_panel::Toggle"
msgstr "Blendet das Terminal-Panel ein oder aus."

#. Toggles focus on the terminal panel.
msgctxt "action documentation"
msgid "terminal_panel::ToggleFocus"
msgstr "Schaltet den Fokus auf das Terminal-Panel um."

#. Opens the Project Search Picker.
msgctxt "action documentation"
msgid "text_finder::Toggle"
msgstr "Öffnet die Projektsuchauswahl."

#. Reloads all themes from disk.
msgctxt "action documentation"
msgid "theme_selector::Reload"
msgstr "Lädt alle Designs von der Festplatte neu."

#. Toggles the theme selector interface.
msgctxt "action documentation"
msgid "theme_selector::Toggle"
msgstr "Öffnet oder schließt die Design-Auswahl."

#. Runs the action associated with a toast notification.
msgctxt "action documentation"
msgid "toast::RunAction"
msgstr "Führt die Aktion aus, die einer Toast-Benachrichtigung zugeordnet ist."

#. Adds a new toolchain for the current project.
msgctxt "action documentation"
msgid "toolchain::AddToolchain"
msgstr "Fügt eine neue Toolchain zum aktuellen Projekt hinzu."

#. Selects a toolchain for the current project.
msgctxt "action documentation"
msgid "toolchain::Select"
msgstr "Wählt eine Toolchain für das aktuelle Projekt aus."

#. Adds the selected variable to the watch list.
msgctxt "action documentation"
msgid "variable_list::AddWatch"
msgstr "Fügt die ausgewählte Variable zur Überwachungsliste hinzu."

#. Collapses the selected variable entry to hide its children.
msgctxt "action documentation"
msgid "variable_list::CollapseSelectedEntry"
msgstr "Klappt den ausgewählten Variableneintrag zu und blendet seine untergeordneten Elemente aus."

#. Copies the variable name to the clipboard.
msgctxt "action documentation"
msgid "variable_list::CopyVariableName"
msgstr "Kopiert den Variablennamen in die Zwischenablage."

#. Copies the variable value to the clipboard.
msgctxt "action documentation"
msgid "variable_list::CopyVariableValue"
msgstr "Kopiert den Variablenwert in die Zwischenablage."

#. Edits the value of the selected variable.
msgctxt "action documentation"
msgid "variable_list::EditVariable"
msgstr "Bearbeitet den Wert der ausgewählten Variable."

#. Expands the selected variable entry to show its children.
msgctxt "action documentation"
msgid "variable_list::ExpandSelectedEntry"
msgstr "Klappt den ausgewählten Variableneintrag auf, um seine untergeordneten Elemente anzuzeigen."

#. Jump to variable's memory location.
msgctxt "action documentation"
msgid "variable_list::GoToMemory"
msgstr "Springt zur Speicheradresse der Variable."

#. Removes the selected variable from the watch list.
msgctxt "action documentation"
msgid "variable_list::RemoveWatch"
msgstr "Entfernt die ausgewählte Variable aus der Überwachungsliste."

#. Operates on text within or around angle brackets `<>`.
msgctxt "action documentation"
msgid "vim::AngleBrackets"
msgstr "Führt Operationen auf Text innerhalb spitzer Klammern `<>` oder einschließlich der Klammern selbst aus."

#. Selects text within any type of brackets.
msgctxt "action documentation"
msgid "vim::AnyBrackets"
msgstr "Wählt Text innerhalb beliebiger Klammern aus."

#. Selects text within the closest surrounding pair of any type
#. (brackets, quotes, backticks, or vertical bars), based on the
#. language's bracket queries, like Helix's `m` text object.
msgctxt "action documentation"
msgid "vim::AnyPair"
msgstr "Wählt Text innerhalb des nächstgelegenen umschließenden Paares eines beliebigen Typs\n(Klammern, Anführungszeichen, Backticks oder vertikale Balken) aus, basierend auf den\nKlammerabfragen der Sprache, wie dem `m`-Textobjekt von Helix."

#. Selects text within any type of quotes.
msgctxt "action documentation"
msgid "vim::AnyQuotes"
msgstr "Wählt Text innerhalb beliebiger Anführungszeichen aus."

#. Selects a function argument.
msgctxt "action documentation"
msgid "vim::Argument"
msgstr "Wählt ein Funktionsargument aus."

#. Indicates that an argument is required for the command.
msgctxt "action documentation"
msgid "vim::ArgumentRequired"
msgstr "Zeigt an, dass für den Befehl ein Argument erforderlich ist."

#. Automatically adjusts indentation based on syntax.
msgctxt "action documentation"
msgid "vim::AutoIndent"
msgstr "Passt die Einrückung automatisch anhand der Syntax an."

#. Selects text within backticks.
msgctxt "action documentation"
msgid "vim::BackQuotes"
msgstr "Wählt Text innerhalb von Backticks aus."

#. Toggles the case of selected text.
msgctxt "action documentation"
msgid "vim::ChangeCase"
msgstr "Wechselt die Groß-/Kleinschreibung des ausgewählten Textes."

#. Navigates to a newer position in the change list.
msgctxt "action documentation"
msgid "vim::ChangeListNewer"
msgstr "Navigiert zu einer neueren Position in der Änderungsliste."

#. Navigates to an older position in the change list.
msgctxt "action documentation"
msgid "vim::ChangeListOlder"
msgstr "Navigiert zu einer älteren Position in der Änderungsliste."

#. Changes from cursor to end of line.
msgctxt "action documentation"
msgid "vim::ChangeToEndOfLine"
msgstr "Ändert den Text vom Cursor bis zum Zeilenende."

#. Selects a class definition.
msgctxt "action documentation"
msgid "vim::Class"
msgstr "Wählt eine Klassendefinition aus."

#. Clears the exchange register.
msgctxt "action documentation"
msgid "vim::ClearExchange"
msgstr "Löscht das Austauschregister."

#. Clears any pending operators.
msgctxt "action documentation"
msgid "vim::ClearOperators"
msgstr "Löscht alle ausstehenden Operatoren."

#. Scrolls left by one column.
msgctxt "action documentation"
msgid "vim::ColumnLeft"
msgstr "Scrollt um eine Spalte nach links."

#. Scrolls right by one column.
msgctxt "action documentation"
msgid "vim::ColumnRight"
msgstr "Scrollt um eine Spalte nach rechts."

#. Selects a comment block.
msgctxt "action documentation"
msgid "vim::Comment"
msgstr "Wählt einen Kommentarblock aus."

#. Converts selected text to lowercase.
msgctxt "action documentation"
msgid "vim::ConvertToLowerCase"
msgstr "Konvertiert den ausgewählten Text in Kleinbuchstaben."

#. Applies ROT13 cipher to selected text.
msgctxt "action documentation"
msgid "vim::ConvertToRot13"
msgstr "Wendet die ROT13-Verschlüsselung auf den ausgewählten Text an."

#. Applies ROT47 cipher to selected text.
msgctxt "action documentation"
msgid "vim::ConvertToRot47"
msgstr "Wendet die ROT47-Verschlüsselung auf den ausgewählten Text an."

#. Converts selected text to uppercase.
msgctxt "action documentation"
msgid "vim::ConvertToUpperCase"
msgstr "Konvertiert den ausgewählten Text in Großbuchstaben."

#. Executes a command with a count prefix.
msgctxt "action documentation"
msgid "vim::CountCommand"
msgstr "Führt einen Befehl mit Zählpräfix aus."

#. Operates on text within or around curly brackets `{}`.
msgctxt "action documentation"
msgid "vim::CurlyBrackets"
msgstr "Führt Operationen auf Text innerhalb geschweifter Klammern `{}` oder einschließlich der Klammern selbst aus."

#. Selects the current line.
msgctxt "action documentation"
msgid "vim::CurrentLine"
msgstr "Wählt die aktuelle Zeile aus."

#. Decrements the number under the cursor or toggles boolean values.
msgctxt "action documentation"
msgid "vim::Decrement"
msgstr "Verringert die Zahl unter dem Cursor oder schaltet boolesche Werte um."

#. Deletes character to the left.
msgctxt "action documentation"
msgid "vim::DeleteLeft"
msgstr "Löscht das Zeichen links vom Cursor."

#. Deletes character to the right.
msgctxt "action documentation"
msgid "vim::DeleteRight"
msgstr "Löscht das Zeichen rechts vom Cursor."

#. Deletes from cursor to end of line.
msgctxt "action documentation"
msgid "vim::DeleteToEndOfLine"
msgstr "Löscht vom Cursor bis zum Zeilenende."

#. Selects text within double quotes.
msgctxt "action documentation"
msgid "vim::DoubleQuotes"
msgstr "Wählt Text innerhalb doppelter Anführungszeichen aus."

#. Moves cursor down by the specified number of lines.
msgctxt "action documentation"
msgid "vim::Down"
msgstr "Bewegt den Cursor um die angegebene Anzahl von Zeilen nach unten."

#. Moves to the end of the document.
msgctxt "action documentation"
msgid "vim::EndOfDocument"
msgstr "Springt zum Ende des Dokuments."

#. Moves to the end of the current line.
msgctxt "action documentation"
msgid "vim::EndOfLine"
msgstr "Springt zum Ende der aktuellen Zeile."

#. Moves to the end of a line downward.
msgctxt "action documentation"
msgid "vim::EndOfLineDownward"
msgstr "Springt zum Ende einer Zeile abwärts."

#. Moves to the end of the paragraph.
msgctxt "action documentation"
msgid "vim::EndOfParagraph"
msgstr "Springt zum Ende des Absatzes."

#. Ends the repeat recording.
msgctxt "action documentation"
msgid "vim::EndRepeat"
msgstr "Beendet die Wiederholungsaufzeichnung."

#. Inserts a newline.
msgctxt "action documentation"
msgid "vim::Enter"
msgstr "Fügt einen Zeilenumbruch ein."

#. Selects the entire file.
msgctxt "action documentation"
msgid "vim::EntireFile"
msgstr "Wählt die gesamte Datei aus."

#. Exchanges text regions.
msgctxt "action documentation"
msgid "vim::Exchange"
msgstr "Tauscht Textbereiche aus."

#. Executes a find command to search for patterns in the buffer.
msgctxt "action documentation"
msgid "vim::FindCommand"
msgstr "Führt einen Suchbefehl aus, um Muster im Puffer zu finden."

#. Moves to the first non-whitespace character on the current line.
msgctxt "action documentation"
msgid "vim::FirstNonWhitespace"
msgstr "Springt zum ersten Zeichen der aktuellen Zeile, das kein Leerraum ist."

#. Goes to a specific column number.
msgctxt "action documentation"
msgid "vim::GoToColumn"
msgstr "Wechselt zu einer bestimmten Spaltennummer."

#. Goes to the next reference to the symbol under the cursor.
msgctxt "action documentation"
msgid "vim::GoToNextReference"
msgstr "Wechselt zur nächsten Referenz des Symbols unter dem Cursor."

#. Goes to a percentage position in the file.
msgctxt "action documentation"
msgid "vim::GoToPercentage"
msgstr "Wechselt zu einer prozentualen Position in der Datei."

#. Goes to the previous reference to the symbol under the cursor.
msgctxt "action documentation"
msgid "vim::GoToPreviousReference"
msgstr "Wechselt zur vorherigen Referenz des Symbols unter dem Cursor."

#. Go to previous tab page (with count support).
msgctxt "action documentation"
msgid "vim::GoToPreviousTab"
msgstr "Wechselt zur vorherigen Tab-Seite (mit Unterstützung für Count)."

#. Go to tab page (with count support).
msgctxt "action documentation"
msgid "vim::GoToTab"
msgstr "Wechselt zur Tab-Seite (mit Unterstützung für Count)."

#. Scrolls left by half a page's width.
msgctxt "action documentation"
msgid "vim::HalfPageLeft"
msgstr "Scrollt um eine halbe Seitenbreite nach links."

#. Scrolls right by half a page's width.
msgctxt "action documentation"
msgid "vim::HalfPageRight"
msgstr "Scrollt um eine halbe Seitenbreite nach rechts."

#. Appends at the end of the selection.
msgctxt "action documentation"
msgid "vim::HelixAppend"
msgstr "Fügt am Ende der Auswahl ein."

#. Collapse the current selection
msgctxt "action documentation"
msgid "vim::HelixCollapseSelection"
msgstr "Reduziert die aktuelle Auswahl"

#. Deletes using Helix-style behavior.
msgctxt "action documentation"
msgid "vim::HelixDelete"
msgstr "Löscht im Helix-Stil."

#. Copies all selections above.
msgctxt "action documentation"
msgid "vim::HelixDuplicateAbove"
msgstr "Kopiert alle Auswahlen nach oben."

#. Copies all selections below.
msgctxt "action documentation"
msgid "vim::HelixDuplicateBelow"
msgstr "Kopiert alle Auswahlen nach unten."

#. Goes to the location of the last modification.
msgctxt "action documentation"
msgid "vim::HelixGotoLastModification"
msgstr "Wechselt zur Position der letzten Änderung."

#. Goes to the line specified by the count.
msgctxt "action documentation"
msgid "vim::HelixGotoLine"
msgstr "Wechselt zu der durch den Count angegebenen Zeile."

#. Inserts at the beginning of the selection.
msgctxt "action documentation"
msgid "vim::HelixInsert"
msgstr "Fügt am Anfang der Auswahl ein."

#. Inserts at the end of the current Helix cursor line.
msgctxt "action documentation"
msgid "vim::HelixInsertEndOfLine"
msgstr "Fügt am Ende der aktuellen Helix-Cursorzeile ein."

#. Activate Helix-style word jump labels.
msgctxt "action documentation"
msgid "vim::HelixJumpToWord"
msgstr "Aktiviert Helix-artige Wortsprungmarkierungen."

#. Removes all but the one selection that was created last.
#. `Newest` can eventually be `Primary`.
msgctxt "action documentation"
msgid "vim::HelixKeepNewestSelection"
msgstr "Entfernt alle Auswahlen außer der zuletzt erstellten.\n`Newest` kann schließlich `Primary` werden."

#. Pastes text from the specified register at the cursor position.
msgctxt "action documentation"
msgid "vim::HelixPaste"
msgstr "Fügt Text aus dem angegebenen Register an der Cursorposition ein."

#. Select entire line or multiple lines, extending downwards.
msgctxt "action documentation"
msgid "vim::HelixSelectLine"
msgstr "Wählt die gesamte Zeile oder mehrere Zeilen aus und erweitert die Auswahl nach unten."

#. Select the next match for the current search query.
msgctxt "action documentation"
msgid "vim::HelixSelectNext"
msgstr "Wählt den nächsten Treffer für die aktuelle Suchanfrage aus."

#. Select the previous match for the current search query.
msgctxt "action documentation"
msgid "vim::HelixSelectPrevious"
msgstr "Wählt den vorherigen Treffer für die aktuelle Suchanfrage aus."

#. Select all matches of a given pattern within the current selection.
msgctxt "action documentation"
msgid "vim::HelixSelectRegex"
msgstr "Wählt alle Treffer eines bestimmten Musters innerhalb der aktuellen Auswahl aus."

#. Delete the selection and enter edit mode.
msgctxt "action documentation"
msgid "vim::HelixSubstitute"
msgstr "Löscht die Auswahl und wechselt in den Bearbeitungsmodus."

#. Delete the selection and enter edit mode, without yanking the selection.
msgctxt "action documentation"
msgid "vim::HelixSubstituteNoYank"
msgstr "Löscht die Auswahl und wechselt in den Bearbeitungsmodus, ohne die Auswahl in den Zwischenspeicher zu kopieren."

#. Trim leading and trailing whitespace from each selection.
#. Originally-empty selections (cursors) are dropped before trimming.
msgctxt "action documentation"
msgid "vim::HelixTrimSelections"
msgstr "Entfernt führenden und nachfolgenden Leerraum aus jeder Auswahl.\nUrsprünglich leere Auswahlen (Cursor) werden vor dem Kürzen verworfen."

#. Yanks the current selection or character if no selection.
msgctxt "action documentation"
msgid "vim::HelixYank"
msgstr "Kopiert die aktuelle Auswahl oder das Zeichen, wenn keine Auswahl vorhanden ist."

#. Increments the number under the cursor or toggles boolean values.
msgctxt "action documentation"
msgid "vim::Increment"
msgstr "Erhöht die Zahl unter dem Cursor oder schaltet boolesche Werte um."

#. Increases indentation of selected lines.
msgctxt "action documentation"
msgid "vim::Indent"
msgstr "Erhöht die Einrückung der ausgewählten Zeilen."

#. Selects text at the same indentation level.
msgctxt "action documentation"
msgid "vim::IndentObj"
msgstr "Wählt Text auf derselben Einrückungsebene aus."

#. Selects inner text object.
msgctxt "action documentation"
msgid "vim::InnerObject"
msgstr "Wählt ein inneres Textobjekt aus."

#. Inserts text after the cursor.
msgctxt "action documentation"
msgid "vim::InsertAfter"
msgstr "Fügt Text nach dem Cursor ein."

#. Inserts at the previous insert position.
msgctxt "action documentation"
msgid "vim::InsertAtPrevious"
msgstr "Fügt an der vorherigen Einfügeposition ein."

#. Inserts text before the cursor.
msgctxt "action documentation"
msgid "vim::InsertBefore"
msgstr "Fügt Text vor dem Cursor ein."

#. Inserts an empty line above without entering insert mode.
msgctxt "action documentation"
msgid "vim::InsertEmptyLineAbove"
msgstr "Fügt eine leere Zeile oberhalb ein, ohne in den Einfügemodus zu wechseln."

#. Inserts an empty line below without entering insert mode.
msgctxt "action documentation"
msgid "vim::InsertEmptyLineBelow"
msgstr "Fügt eine leere Zeile unterhalb ein, ohne in den Einfügemodus zu wechseln."

#. Inserts at the end of the line.
msgctxt "action documentation"
msgid "vim::InsertEndOfLine"
msgstr "Fügt am Ende der Zeile ein."

#. Inserts at the first non-whitespace character.
msgctxt "action documentation"
msgid "vim::InsertFirstNonWhitespace"
msgstr "Fügt beim ersten Zeichen ein, das kein Leerraum ist."

#. Inserts the next character from the line above into the current line.
msgctxt "action documentation"
msgid "vim::InsertFromAbove"
msgstr "Fügt das nächste Zeichen aus der Zeile darüber in die aktuelle Zeile ein."

#. Inserts the next character from the line below into the current line.
msgctxt "action documentation"
msgid "vim::InsertFromBelow"
msgstr "Fügt das nächste Zeichen aus der Zeile darunter in die aktuelle Zeile ein."

#. Inserts a new line above the current line.
msgctxt "action documentation"
msgid "vim::InsertLineAbove"
msgstr "Fügt eine neue Zeile oberhalb der aktuellen Zeile ein."

#. Inserts a new line below the current line.
msgctxt "action documentation"
msgid "vim::InsertLineBelow"
msgstr "Fügt eine neue Zeile unterhalb der aktuellen Zeile ein."

#. Joins the current line with the next line.
msgctxt "action documentation"
msgid "vim::JoinLines"
msgstr "Verbindet die aktuelle Zeile mit der nächsten Zeile."

#. Joins lines without adding whitespace.
msgctxt "action documentation"
msgid "vim::JoinLinesNoWhitespace"
msgstr "Verbindet Zeilen, ohne Leerraum hinzuzufügen."

#. Moves cursor left one character.
msgctxt "action documentation"
msgid "vim::Left"
msgstr "Bewegt den Cursor um ein Zeichen nach links."

#. Scrolls down by one line.
msgctxt "action documentation"
msgid "vim::LineDown"
msgstr "Scrollt um eine Zeile nach unten."

#. Scrolls up by one line.
msgctxt "action documentation"
msgid "vim::LineUp"
msgstr "Scrollt um eine Zeile nach oben."

#. Moves to the matching bracket or delimiter.
msgctxt "action documentation"
msgid "vim::Matching"
msgstr "Springt zur passenden Klammer oder zum Trennzeichen."

#. Maximizes the current pane.
msgctxt "action documentation"
msgid "vim::MaximizePane"
msgstr "Maximiert den aktuellen Bereich."

#. Selects (count) next menu item
msgctxt "action documentation"
msgid "vim::MenuSelectNext"
msgstr "Wählt entsprechend dem Count das nächste Menüelement aus"

#. Selects (count) previous menu item
msgctxt "action documentation"
msgid "vim::MenuSelectPrevious"
msgstr "Wählt entsprechend dem Count das vorherige Menüelement aus"

#. Selects a method or function.
msgctxt "action documentation"
msgid "vim::Method"
msgstr "Wählt eine Methode oder Funktion aus."

#. Moves to the middle of the current line.
msgctxt "action documentation"
msgid "vim::MiddleOfLine"
msgstr "Springt zur Mitte der aktuellen Zeile."

#. Selects text within the nearest brackets.
msgctxt "action documentation"
msgid "vim::MiniBrackets"
msgstr "Wählt Text innerhalb der nächstgelegenen Klammern aus."

#. Selects text within the nearest quotes (single or double).
msgctxt "action documentation"
msgid "vim::MiniQuotes"
msgstr "Wählt Text innerhalb der nächstgelegenen Anführungszeichen (einfach oder doppelt) aus."

#. Moves to the next search match.
msgctxt "action documentation"
msgid "vim::MoveToNext"
msgstr "Springt zum nächsten Suchtreffer."

#. Moves to the next search match.
msgctxt "action documentation"
msgid "vim::MoveToNextMatch"
msgstr "Springt zum nächsten Suchtreffer."

#. Moves to the previous search match.
msgctxt "action documentation"
msgid "vim::MoveToPrevious"
msgstr "Springt zum vorherigen Suchtreffer."

#. Moves to the previous search match.
msgctxt "action documentation"
msgid "vim::MoveToPreviousMatch"
msgstr "Springt zum vorherigen Suchtreffer."

#. Moves to the next comment.
msgctxt "action documentation"
msgid "vim::NextComment"
msgstr "Springt zum nächsten Kommentar."

#. Moves to the next line with greater indentation.
msgctxt "action documentation"
msgid "vim::NextGreaterIndent"
msgstr "Springt zur nächsten Zeile mit größerer Einrückung."

#. Moves to the next line with lesser indentation.
msgctxt "action documentation"
msgid "vim::NextLesserIndent"
msgstr "Springt zur nächsten Zeile mit kleinerer Einrückung."

#. Moves to the start of the next line.
msgctxt "action documentation"
msgid "vim::NextLineStart"
msgstr "Bewegt den Cursor zum Anfang der nächsten Zeile."

#. Moves to the end of the next method.
msgctxt "action documentation"
msgid "vim::NextMethodEnd"
msgstr "Springt zum Ende der nächsten Methode."

#. Moves to the start of the next method.
msgctxt "action documentation"
msgid "vim::NextMethodStart"
msgstr "Bewegt den Cursor zum Anfang der nächsten Methode."

#. Moves to the next line with the same indentation.
msgctxt "action documentation"
msgid "vim::NextSameIndent"
msgstr "Springt zur nächsten Zeile mit derselben Einrückung."

#. Moves to the end of the next section.
msgctxt "action documentation"
msgid "vim::NextSectionEnd"
msgstr "Springt zum Ende des nächsten Abschnitts."

#. Moves to the start of the next section.
msgctxt "action documentation"
msgid "vim::NextSectionStart"
msgstr "Bewegt den Cursor zum Anfang des nächsten Abschnitts."

#. Moves to the end of the next subword.
msgctxt "action documentation"
msgid "vim::NextSubwordEnd"
msgstr "Springt zum Ende des nächsten Teilworts."

#. Moves to the start of the next subword.
msgctxt "action documentation"
msgid "vim::NextSubwordStart"
msgstr "Bewegt den Cursor zum Anfang des nächsten Teilworts."

#. Moves to the end of the next word.
msgctxt "action documentation"
msgid "vim::NextWordEnd"
msgstr "Springt zum Ende des nächsten Worts."

#. Moves to the start of the next word.
msgctxt "action documentation"
msgid "vim::NextWordStart"
msgstr "Bewegt den Cursor zum Anfang des nächsten Worts."

#. Switches to normal mode with cursor positioned before the current character.
msgctxt "action documentation"
msgid "vim::NormalBefore"
msgstr "Wechselt in den Normalmodus mit dem Cursor vor dem aktuellen Zeichen."

#. Number is used to manage vim's count. Pushing a digit
#. multiplies the current value by 10 and adds the digit.
msgctxt "action documentation"
msgid "vim::Number"
msgstr "Eine Zahl wird verwendet, um den Count von Vim zu verwalten. Das Drücken einer Ziffer\nmultipliziert den aktuellen Wert mit 10 und addiert die Ziffer."

#. Opens the default keymap file.
msgctxt "action documentation"
msgid "vim::OpenDefaultKeymap"
msgstr "Öffnet die Standard-Keymap-Datei."

#. Moves cursor to the other end of the selection.
msgctxt "action documentation"
msgid "vim::OtherEnd"
msgstr "Bewegt den Cursor zum anderen Ende der Auswahl."

#. Moves cursor to the other end of the selection (row-aware).
msgctxt "action documentation"
msgid "vim::OtherEndRowAware"
msgstr "Bewegt den Cursor zum anderen Ende der Auswahl (zeilenbewusst)."

#. Decreases indentation of selected lines.
msgctxt "action documentation"
msgid "vim::Outdent"
msgstr "Verringert die Einrückung der ausgewählten Zeilen."

#. Scrolls down by one page.
msgctxt "action documentation"
msgid "vim::PageDown"
msgstr "Scrollt um eine Seite nach unten."

#. Scrolls up by one page.
msgctxt "action documentation"
msgid "vim::PageUp"
msgstr "Scrollt um eine Seite nach oben."

#. Selects a paragraph text object.
msgctxt "action documentation"
msgid "vim::Paragraph"
msgstr "Wählt ein Absatz-Textobjekt aus."

#. Operates on text within or around parentheses `()`.
msgctxt "action documentation"
msgid "vim::Parentheses"
msgstr "Führt Operationen auf Text innerhalb runder Klammern `()` oder einschließlich der Klammern selbst aus."

#. Pastes text from the specified register at the cursor position.
msgctxt "action documentation"
msgid "vim::Paste"
msgstr "Fügt Text aus dem angegebenen Register an der Cursorposition ein."

#. Moves to the previous comment.
msgctxt "action documentation"
msgid "vim::PreviousComment"
msgstr "Springt zum vorherigen Kommentar."

#. Moves to the previous line with greater indentation.
msgctxt "action documentation"
msgid "vim::PreviousGreaterIndent"
msgstr "Springt zur vorherigen Zeile mit größerer Einrückung."

#. Moves to the previous line with lesser indentation.
msgctxt "action documentation"
msgid "vim::PreviousLesserIndent"
msgstr "Springt zur vorherigen Zeile mit kleinerer Einrückung."

#. Moves to the start of the previous line.
msgctxt "action documentation"
msgid "vim::PreviousLineStart"
msgstr "Bewegt den Cursor zum Anfang der vorherigen Zeile."

#. Moves to the end of the previous method.
msgctxt "action documentation"
msgid "vim::PreviousMethodEnd"
msgstr "Springt zum Ende der vorherigen Methode."

#. Moves to the start of the previous method.
msgctxt "action documentation"
msgid "vim::PreviousMethodStart"
msgstr "Bewegt den Cursor zum Anfang der vorherigen Methode."

#. Moves to the previous line with the same indentation.
msgctxt "action documentation"
msgid "vim::PreviousSameIndent"
msgstr "Springt zur vorherigen Zeile mit derselben Einrückung."

#. Moves to the end of the previous section.
msgctxt "action documentation"
msgid "vim::PreviousSectionEnd"
msgstr "Springt zum Ende des vorherigen Abschnitts."

#. Moves to the start of the previous section.
msgctxt "action documentation"
msgid "vim::PreviousSectionStart"
msgstr "Bewegt den Cursor zum Anfang des vorherigen Abschnitts."

#. Moves to the end of the previous subword.
msgctxt "action documentation"
msgid "vim::PreviousSubwordEnd"
msgstr "Springt zum Ende des vorherigen Teilworts."

#. Moves to the start of the previous subword.
msgctxt "action documentation"
msgid "vim::PreviousSubwordStart"
msgstr "Bewegt den Cursor zum Anfang des vorherigen Teilworts."

#. Moves to the end of the previous word.
msgctxt "action documentation"
msgid "vim::PreviousWordEnd"
msgstr "Springt zum Ende des vorherigen Worts."

#. Moves to the start of the previous word.
msgctxt "action documentation"
msgid "vim::PreviousWordStart"
msgstr "Bewegt den Cursor zum Anfang des vorherigen Worts."

#. Starts an auto-indent operation.
msgctxt "action documentation"
msgid "vim::PushAutoIndent"
msgstr "Startet einen Vorgang zur automatischen Einrückung."

#. Starts a change operation.
msgctxt "action documentation"
msgid "vim::PushChange"
msgstr "Startet einen Änderungsvorgang."

#. Starts a delete operation.
msgctxt "action documentation"
msgid "vim::PushDelete"
msgstr "Startet einen Löschvorgang."

#. Deletes surrounding characters.
msgctxt "action documentation"
msgid "vim::PushDeleteSurrounds"
msgstr "Löscht umgebende Zeichen."

#. Starts a forced motion.
msgctxt "action documentation"
msgid "vim::PushForcedMotion"
msgstr "Startet eine erzwungene Bewegung."

#. Starts a match operation.
msgctxt "action documentation"
msgid "vim::PushHelixMatch"
msgstr "Startet einen Abgleichvorgang."

#. Selects the next object.
msgctxt "action documentation"
msgid "vim::PushHelixNext"
msgstr "Wählt das nächste Objekt aus."

#. Selects the previous object.
msgctxt "action documentation"
msgid "vim::PushHelixPrevious"
msgstr "Wählt das vorherige Objekt aus."

#. Adds surrounding characters in Helix mode.
msgctxt "action documentation"
msgid "vim::PushHelixSurroundAdd"
msgstr "Fügt umgebende Zeichen im Helix-Modus hinzu."

#. Deletes surrounding characters in Helix mode.
msgctxt "action documentation"
msgid "vim::PushHelixSurroundDelete"
msgstr "Löscht umgebende Zeichen im Helix-Modus."

#. Replaces surrounding characters in Helix mode.
msgctxt "action documentation"
msgid "vim::PushHelixSurroundReplace"
msgstr "Ersetzt umgebende Zeichen im Helix-Modus."

#. Starts an indent operation.
msgctxt "action documentation"
msgid "vim::PushIndent"
msgstr "Startet einen Vorgang zum Vergrößern des Einzugs."

#. Converts to lowercase.
msgctxt "action documentation"
msgid "vim::PushLowercase"
msgstr "Konvertiert in Kleinbuchstaben."

#. Sets a mark at the current position.
msgctxt "action documentation"
msgid "vim::PushMark"
msgstr "Setzt eine Markierung an der aktuellen Position."

#. Toggles case.
msgctxt "action documentation"
msgid "vim::PushOppositeCase"
msgstr "Schaltet die Groß-/Kleinschreibung um."

#. Starts an outdent operation.
msgctxt "action documentation"
msgid "vim::PushOutdent"
msgstr "Startet einen Vorgang zum Verkleinern des Einzugs."

#. Starts recording to a register.
msgctxt "action documentation"
msgid "vim::PushRecordRegister"
msgstr "Startet die Aufzeichnung in ein Register."

#. Selects a register.
msgctxt "action documentation"
msgid "vim::PushRegister"
msgstr "Wählt ein Register aus."

#. Starts a replace operation.
msgctxt "action documentation"
msgid "vim::PushReplace"
msgstr "Startet einen Ersetzungsvorgang."

#. Replaces with register contents.
msgctxt "action documentation"
msgid "vim::PushReplaceWithRegister"
msgstr "Ersetzt durch den Registerinhalt."

#. Replays a register.
msgctxt "action documentation"
msgid "vim::PushReplayRegister"
msgstr "Spielt ein Register ab."

#. Starts a rewrap operation.
msgctxt "action documentation"
msgid "vim::PushRewrap"
msgstr "Startet einen Umbruchvorgang."

#. Applies ROT13 encoding.
msgctxt "action documentation"
msgid "vim::PushRot13"
msgstr "Wendet die ROT13-Codierung an."

#. Applies ROT47 encoding.
msgctxt "action documentation"
msgid "vim::PushRot47"
msgstr "Wendet die ROT47-Codierung an."

#. Starts a shell command operation.
msgctxt "action documentation"
msgid "vim::PushShellCommand"
msgstr "Startet einen Shell-Befehlsvorgang."

#. Toggles block comments.
msgctxt "action documentation"
msgid "vim::PushToggleBlockComments"
msgstr "Schaltet Blockkommentare um."

#. Toggles comments.
msgctxt "action documentation"
msgid "vim::PushToggleComments"
msgstr "Schaltet Kommentare um."

#. Converts to uppercase.
msgctxt "action documentation"
msgid "vim::PushUppercase"
msgstr "Konvertiert in Großbuchstaben."

#. Starts a yank operation.
msgctxt "action documentation"
msgid "vim::PushYank"
msgstr "Startet einen Yank-Vorgang."

#. Selects text within single quotes.
msgctxt "action documentation"
msgid "vim::Quotes"
msgstr "Wählt Text innerhalb einfacher Anführungszeichen aus."

#. Redoes the last undone change.
msgctxt "action documentation"
msgid "vim::Redo"
msgstr "Wiederholt die zuletzt rückgängig gemachte Änderung."

#. Repeats the last change.
msgctxt "action documentation"
msgid "vim::Repeat"
msgstr "Wiederholt die letzte Änderung."

#. Repeats the last character find.
msgctxt "action documentation"
msgid "vim::RepeatFind"
msgstr "Wiederholt die letzte Zeichensuche."

#. Repeats the last character find in reverse.
msgctxt "action documentation"
msgid "vim::RepeatFindReversed"
msgstr "Wiederholt die letzte Zeichensuche in umgekehrter Richtung."

#. Replays the last recorded macro.
msgctxt "action documentation"
msgid "vim::ReplayLastRecording"
msgstr "Spielt das zuletzt aufgezeichnete Makro ab."

#. Resets all pane sizes to default.
msgctxt "action documentation"
msgid "vim::ResetPaneSizes"
msgstr "Setzt alle Bereichsgrößen auf die Standardwerte zurück."

#. Resizes the pane downward.
msgctxt "action documentation"
msgid "vim::ResizePaneDown"
msgstr "Verkleinert den Bereich nach unten."

#. Resizes the pane to the left.
msgctxt "action documentation"
msgid "vim::ResizePaneLeft"
msgstr "Verkleinert den Bereich nach links."

#. Resizes the pane to the right.
msgctxt "action documentation"
msgid "vim::ResizePaneRight"
msgstr "Vergrößert den Bereich nach rechts."

#. Resizes the pane upward.
msgctxt "action documentation"
msgid "vim::ResizePaneUp"
msgstr "Vergrößert den Bereich nach oben."

#. Restores the previous visual selection.
msgctxt "action documentation"
msgid "vim::RestoreVisualSelection"
msgstr "Stellt die vorherige visuelle Auswahl wieder her."

#. Rewraps the selected text to fit within the line width.
msgctxt "action documentation"
msgid "vim::Rewrap"
msgstr "Bricht den ausgewählten Text auf die Zeilenbreite um."

#. Moves cursor right one character.
msgctxt "action documentation"
msgid "vim::Right"
msgstr "Bewegt den Cursor um ein Zeichen nach rechts."

#. Scrolls down by half a page.
msgctxt "action documentation"
msgid "vim::ScrollDown"
msgstr "Scrollt um eine halbe Seite nach unten."

#. Scrolls up by half a page.
msgctxt "action documentation"
msgid "vim::ScrollUp"
msgstr "Scrollt um eine halbe Seite nach oben."

#. Initiates a search operation with the specified parameters.
msgctxt "action documentation"
msgid "vim::Search"
msgstr "Startet einen Suchvorgang mit den angegebenen Parametern."

#. Submits the current search query.
msgctxt "action documentation"
msgid "vim::SearchSubmit"
msgstr "Übermittelt die aktuelle Suchanfrage."

#. Searches for the word under the cursor without moving.
msgctxt "action documentation"
msgid "vim::SearchUnderCursor"
msgstr "Sucht nach dem Wort unter dem Cursor, ohne den Cursor zu bewegen."

#. Searches for the word under the cursor without moving (backwards).
msgctxt "action documentation"
msgid "vim::SearchUnderCursorPrevious"
msgstr "Sucht rückwärts nach dem Wort unter dem Cursor, ohne den Cursor zu bewegen."

#. Selects the next larger syntax node.
msgctxt "action documentation"
msgid "vim::SelectLargerSyntaxNode"
msgstr "Wählt den nächstgrößeren Syntaxknoten aus."

#. Selects the next occurrence of the current selection.
msgctxt "action documentation"
msgid "vim::SelectNext"
msgstr "Wählt das nächste Vorkommen der aktuellen Auswahl aus."

#. Selects the next match of the current selection.
msgctxt "action documentation"
msgid "vim::SelectNextMatch"
msgstr "Wählt den nächsten Treffer der aktuellen Auswahl aus."

#. Selects the next syntax node sibling.
msgctxt "action documentation"
msgid "vim::SelectNextSyntaxNode"
msgstr "Wählt den nächsten Geschwisterknoten im Syntaxbaum aus."

#. Selects the previous occurrence of the current selection.
msgctxt "action documentation"
msgid "vim::SelectPrevious"
msgstr "Wählt das vorherige Vorkommen der aktuellen Auswahl aus."

#. Selects the previous match of the current selection.
msgctxt "action documentation"
msgid "vim::SelectPreviousMatch"
msgstr "Wählt den vorherigen Treffer der aktuellen Auswahl aus."

#. Selects the previous syntax node sibling.
msgctxt "action documentation"
msgid "vim::SelectPreviousSyntaxNode"
msgstr "Wählt den vorherigen Geschwisterknoten im Syntaxbaum aus."

#. Selects the next smaller syntax node.
msgctxt "action documentation"
msgid "vim::SelectSmallerSyntaxNode"
msgstr "Wählt den nächstkleineren Syntaxknoten aus."

#. Selects a sentence text object.
msgctxt "action documentation"
msgid "vim::Sentence"
msgstr "Wählt ein Satz-Textobjekt aus."

#. Moves to the start of the previous sentence.
msgctxt "action documentation"
msgid "vim::SentenceBackward"
msgstr "Bewegt den Cursor zum Anfang des vorherigen Satzes."

#. Moves to the start of the next sentence.
msgctxt "action documentation"
msgid "vim::SentenceForward"
msgstr "Bewegt den Cursor zum Anfang des nächsten Satzes."

#. Executes a shell command.
msgctxt "action documentation"
msgid "vim::ShellCommand"
msgstr "Führt einen Shell-Befehl aus."

#. Shows the current location in the file.
msgctxt "action documentation"
msgid "vim::ShowLocation"
msgstr "Zeigt die aktuelle Position in der Datei an."

#. Operates on text within or around square brackets `[]`.
msgctxt "action documentation"
msgid "vim::SquareBrackets"
msgstr "Führt Operationen auf Text innerhalb eckiger Klammern `[]` oder einschließlich der Klammern selbst aus."

#. Moves to the start of the document.
msgctxt "action documentation"
msgid "vim::StartOfDocument"
msgstr "Bewegt den Cursor zum Anfang des Dokuments."

#. Moves to the start of the current line.
msgctxt "action documentation"
msgid "vim::StartOfLine"
msgstr "Bewegt den Cursor zum Anfang der aktuellen Zeile."

#. Moves to the start of a line downward.
msgctxt "action documentation"
msgid "vim::StartOfLineDownward"
msgstr "Bewegt den Cursor zum Anfang einer Zeile nach unten."

#. Moves to the start of the paragraph.
msgctxt "action documentation"
msgid "vim::StartOfParagraph"
msgstr "Bewegt den Cursor zum Anfang des Absatzes."

#. Substitutes characters in the current selection.
msgctxt "action documentation"
msgid "vim::Substitute"
msgstr "Ersetzt Zeichen in der aktuellen Auswahl."

#. Substitutes the entire line.
msgctxt "action documentation"
msgid "vim::SubstituteLine"
msgstr "Ersetzt die gesamte Zeile."

#. Selects a subword text object.
msgctxt "action documentation"
msgid "vim::Subword"
msgstr "Wählt ein Teilwort-Textobjekt aus."

#. Switches to Helix-style normal mode.
msgctxt "action documentation"
msgid "vim::SwitchToHelixNormalMode"
msgstr "Wechselt in den Normalmodus im Helix-Stil."

#. Switches to insert mode.
msgctxt "action documentation"
msgid "vim::SwitchToInsertMode"
msgstr "Wechselt in den Einfügemodus."

#. Switches to normal mode.
msgctxt "action documentation"
msgid "vim::SwitchToNormalMode"
msgstr "Wechselt in den Normalmodus."

#. Switches to replace mode.
msgctxt "action documentation"
msgid "vim::SwitchToReplaceMode"
msgstr "Wechselt in den Ersetzungsmodus."

#. Switches to visual block mode.
msgctxt "action documentation"
msgid "vim::SwitchToVisualBlockMode"
msgstr "Wechselt in den visuellen Blockmodus."

#. Switches to visual line mode.
msgctxt "action documentation"
msgid "vim::SwitchToVisualLineMode"
msgstr "Wechselt in den visuellen Zeilenmodus."

#. Switches to visual mode.
msgctxt "action documentation"
msgid "vim::SwitchToVisualMode"
msgstr "Wechselt in den visuellen Modus."

#. Inserts a tab character.
msgctxt "action documentation"
msgid "vim::Tab"
msgstr "Fügt ein Tabulatorzeichen ein."

#. Selects an HTML/XML tag.
msgctxt "action documentation"
msgid "vim::Tag"
msgstr "Wählt ein HTML/XML-Tag aus."

#. Temporarily switches to normal mode for one command.
msgctxt "action documentation"
msgid "vim::TemporaryNormal"
msgstr "Wechselt vorübergehend in den Normalmodus für einen Befehl."

#. Toggles block comments for selected lines.
msgctxt "action documentation"
msgid "vim::ToggleBlockComments"
msgstr "Schaltet Blockkommentare für ausgewählte Zeilen um."

#. Toggles comments for selected lines.
msgctxt "action documentation"
msgid "vim::ToggleComments"
msgstr "Schaltet Kommentare für ausgewählte Zeilen um."

#. Toggles the marks view.
msgctxt "action documentation"
msgid "vim::ToggleMarksView"
msgstr "Schaltet die Marken-Ansicht um."

#. Clears count or toggles project panel focus
msgctxt "action documentation"
msgid "vim::ToggleProjectPanelFocus"
msgstr "Setzt den Count zurück oder schaltet den Fokus des Projektpanels um"

#. Toggles macro recording.
msgctxt "action documentation"
msgid "vim::ToggleRecord"
msgstr "Schaltet die Makroaufzeichnung um."

#. Toggles the registers view.
msgctxt "action documentation"
msgid "vim::ToggleRegistersView"
msgstr "Schaltet die Register-Ansicht um."

#. Toggles replace mode.
msgctxt "action documentation"
msgid "vim::ToggleReplace"
msgstr "Schaltet den Ersetzungsmodus um."

#. Toggles visual mode.
msgctxt "action documentation"
msgid "vim::ToggleVisual"
msgstr "Schaltet den visuellen Modus um."

#. Toggles visual block mode.
msgctxt "action documentation"
msgid "vim::ToggleVisualBlock"
msgstr "Schaltet den visuellen Blockmodus um."

#. Toggles visual line mode.
msgctxt "action documentation"
msgid "vim::ToggleVisualLine"
msgstr "Schaltet den visuellen Zeilenmodus um."

#. Undoes the last change.
msgctxt "action documentation"
msgid "vim::Undo"
msgstr "Macht die letzte Änderung rückgängig."

#. Undoes all changes to the most recently changed line.
msgctxt "action documentation"
msgid "vim::UndoLastLine"
msgstr "Macht alle Änderungen an der zuletzt geänderten Zeile rückgängig."

#. Undoes the last replacement.
msgctxt "action documentation"
msgid "vim::UndoReplace"
msgstr "Macht die letzte Ersetzung rückgängig."

#. Finds the previous unmatched bracket or delimiter.
msgctxt "action documentation"
msgid "vim::UnmatchedBackward"
msgstr "Sucht die vorherige ungepaarte Klammer oder das vorherige ungepaarte Trennzeichen."

#. Finds the next unmatched bracket or delimiter.
msgctxt "action documentation"
msgid "vim::UnmatchedForward"
msgstr "Sucht die nächste ungepaarte Klammer oder das nächste ungepaarte Trennzeichen."

#. Moves cursor up by the specified number of lines.
msgctxt "action documentation"
msgid "vim::Up"
msgstr "Bewegt den Cursor um die angegebene Anzahl von Zeilen nach oben."

#. Selects text within vertical bars (pipes).
msgctxt "action documentation"
msgid "vim::VerticalBars"
msgstr "Wählt Text innerhalb vertikaler Balken (Pipes) aus."

#. Executes a command in visual mode.
msgctxt "action documentation"
msgid "vim::VisualCommand"
msgstr "Führt einen Befehl im visuellen Modus aus."

#. Deletes the visual selection.
msgctxt "action documentation"
msgid "vim::VisualDelete"
msgstr "Löscht die visuelle Auswahl."

#. Deletes entire lines in visual selection.
msgctxt "action documentation"
msgid "vim::VisualDeleteLine"
msgstr "Löscht ganze Zeilen in der visuellen Auswahl."

#. Inserts at the end of each line in visual selection.
msgctxt "action documentation"
msgid "vim::VisualInsertEndOfLine"
msgstr "Fügt am Ende jeder Zeile in der visuellen Auswahl ein."

#. Inserts at the first non-whitespace character of each line.
msgctxt "action documentation"
msgid "vim::VisualInsertFirstNonWhiteSpace"
msgstr "Fügt in jeder Zeile beim ersten Zeichen ein, das kein Leerraum ist."

#. Yanks (copies) the visual selection.
msgctxt "action documentation"
msgid "vim::VisualYank"
msgstr "Kopiert die visuelle Auswahl (Yank)."

#. Yanks entire lines in visual selection.
msgctxt "action documentation"
msgid "vim::VisualYankLine"
msgstr "Kopiert ganze Zeilen in der visuellen Auswahl (Yank)."

#. Moves to the bottom of the window.
msgctxt "action documentation"
msgid "vim::WindowBottom"
msgstr "Springt zum Ende des Fensters."

#. Moves to the middle of the window.
msgctxt "action documentation"
msgid "vim::WindowMiddle"
msgstr "Springt zur Mitte des Fensters."

#. Moves to the top of the window.
msgctxt "action documentation"
msgid "vim::WindowTop"
msgstr "Springt zum Anfang des Fensters."

#. Selects a word text object.
msgctxt "action documentation"
msgid "vim::Word"
msgstr "Wählt ein Wort-Textobjekt aus."

#. Moves cursor left one character, wrapping to previous line.
msgctxt "action documentation"
msgid "vim::WrappingLeft"
msgstr "Bewegt den Cursor um ein Zeichen nach links und wechselt dabei in die vorherige Zeile."

#. Moves cursor right one character, wrapping to next line.
msgctxt "action documentation"
msgid "vim::WrappingRight"
msgstr "Bewegt den Cursor um ein Zeichen nach rechts und wechselt dabei in die nächste Zeile."

#. Yanks (copies) the selected text.
msgctxt "action documentation"
msgid "vim::Yank"
msgstr "Kopiert den ausgewählten Text (Yank)."

#. Yanks the entire line.
msgctxt "action documentation"
msgid "vim::YankLine"
msgstr "Kopiert die gesamte Zeile (Yank)."

#. Yanks from cursor to end of line.
msgctxt "action documentation"
msgid "vim::YankToEndOfLine"
msgstr "Kopiert vom Cursor bis zum Zeilenende (Yank)."

#. Activates the last pane in the workspace.
msgctxt "action documentation"
msgid "workspace::ActivateLastPane"
msgstr "Aktiviert den letzten Bereich im Arbeitsbereich."

#. Activates the next pane in the workspace.
msgctxt "action documentation"
msgid "workspace::ActivateNextPane"
msgstr "Aktiviert den nächsten Bereich im Arbeitsbereich."

#. Switches to the next window.
msgctxt "action documentation"
msgid "workspace::ActivateNextWindow"
msgstr "Wechselt zum nächsten Fenster."

#. Activates a specific pane by its index.
msgctxt "action documentation"
msgid "workspace::ActivatePane"
msgstr "Aktiviert einen bestimmten Bereich anhand seines Index."

#. Activates the pane below.
msgctxt "action documentation"
msgid "workspace::ActivatePaneDown"
msgstr "Aktiviert den Bereich darunter."

#. Activates the pane to the left.
msgctxt "action documentation"
msgid "workspace::ActivatePaneLeft"
msgstr "Aktiviert den Bereich links."

#. Activates the pane to the right.
msgctxt "action documentation"
msgid "workspace::ActivatePaneRight"
msgstr "Aktiviert den Bereich rechts."

#. Activates the pane above.
msgctxt "action documentation"
msgid "workspace::ActivatePaneUp"
msgstr "Aktiviert den Bereich darüber."

#. Activates the previous pane in the workspace.
msgctxt "action documentation"
msgid "workspace::ActivatePreviousPane"
msgstr "Aktiviert den vorherigen Bereich im Arbeitsbereich."

#. Switches to the previous window.
msgctxt "action documentation"
msgid "workspace::ActivatePreviousWindow"
msgstr "Wechselt zum vorherigen Fenster."

#. Adds a folder to the current project.
msgctxt "action documentation"
msgid "workspace::AddFolderToProject"
msgstr "Fügt einen Ordner zum aktuellen Projekt hinzu."

#. Replaces the project's open folder with a different one, adding the
#. new worktree before closing the previous one so a remote connection
#. does not need to be re-established.
msgctxt "action documentation"
msgid "workspace::ChangeProjectFolder"
msgstr "Ersetzt den geöffneten Ordner des Projekts durch einen anderen. Der neue Worktree wird hinzugefügt, bevor der vorherige geschlossen wird, sodass eine Remote-Verbindung nicht neu aufgebaut werden muss."

#. Clears all notifications.
msgctxt "action documentation"
msgid "workspace::ClearAllNotifications"
msgstr "Löscht alle Benachrichtigungen."

#. Clears all bookmarks in the project.
msgctxt "action documentation"
msgid "workspace::ClearBookmarks"
msgstr "Löscht alle Lesezeichen im Projekt."

#. Clears all navigation history, including forward/backward navigation, recently opened files, and recently closed tabs. **This action is irreversible**.
msgctxt "action documentation"
msgid "workspace::ClearNavigationHistory"
msgstr "Löscht den gesamten Navigationsverlauf, einschließlich Vorwärts-/Rückwärtsnavigation, zuletzt geöffneter Dateien und zuletzt geschlossener Tabs. **Diese Aktion ist unwiderruflich**."

#. Clears all trusted worktrees, placing them in restricted mode on next open.
#. Requires restart to take effect on already opened projects.
msgctxt "action documentation"
msgid "workspace::ClearTrustedWorktrees"
msgstr "Hebt die Vertrauensstellung aller vertrauenswürdigen Worktrees auf und versetzt sie beim nächsten Öffnen in den eingeschränkten Modus.\nErfordert einen Neustart, um bei bereits geöffneten Projekten wirksam zu werden."

#. Closes the active dock.
msgctxt "action documentation"
msgid "workspace::CloseActiveDock"
msgstr "Schließt das aktive Dock."

#. Closes all docks.
msgctxt "action documentation"
msgid "workspace::CloseAllDocks"
msgstr "Schließt alle Docks."

#. Closes all items and panes in the workspace.
msgctxt "action documentation"
msgid "workspace::CloseAllItemsAndPanes"
msgstr "Schließt alle Elemente und Bereiche im Arbeitsbereich."

#. Closes all inactive tabs and panes in the workspace.
msgctxt "action documentation"
msgid "workspace::CloseInactiveTabsAndPanes"
msgstr "Schließt alle inaktiven Tabs und Bereiche im Arbeitsbereich."

#. Closes the active item across all panes.
msgctxt "action documentation"
msgid "workspace::CloseItemInAllPanes"
msgstr "Schließt das aktive Element in allen Bereichen."

#. Closes the current project.
msgctxt "action documentation"
msgid "workspace::CloseProject"
msgstr "Schließt das aktuelle Projekt."

#. Closes the current window.
msgctxt "action documentation"
msgid "workspace::CloseWindow"
msgstr "Schließt das aktuelle Fenster."

#. Decreases size of a currently focused dock by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::DecreaseActiveDockSize"
msgstr "Verringert die Größe des aktuell fokussierten Docks um die angegebene Pixelanzahl."

#. Decreases size of all currently visible docks uniformly, by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::DecreaseOpenDocksSize"
msgstr "Verringert die Größe aller aktuell sichtbaren Docks gleichmäßig um die angegebene Pixelanzahl."

#. Opens the feedback dialog.
msgctxt "action documentation"
msgid "workspace::Feedback"
msgstr "Öffnet den Feedback-Dialog."

#. Moves Focus to the central panes in the workspace.
msgctxt "action documentation"
msgid "workspace::FocusCenterPane"
msgstr "Verschiebt den Fokus auf die zentralen Bereiche des Arbeitsbereichs."

#. Moves focus to the next major region of the window (editor, open
#. panels, status bar), cycling and wrapping around. Intended as a
#. discoverable, screen-reader-friendly way to navigate the window.
msgctxt "action documentation"
msgid "workspace::FocusNextPart"
msgstr "Verschiebt den Fokus zum nächsten Hauptbereich des Fensters (Editor, geöffnete\nPanels, Statusleiste) und springt dabei zyklisch weiter. Dient als\nleicht auffindbare, für Screenreader geeignete Möglichkeit zur Fensternavigation."

#. Moves focus to the previous major region of the window. See
#. [`FocusNextPart`].
msgctxt "action documentation"
msgid "workspace::FocusPreviousPart"
msgstr "Verschiebt den Fokus zum vorherigen Hauptbereich des Fensters. Siehe\n[`FocusNextPart`]."

#. Follows the next collaborator in the session.
msgctxt "action documentation"
msgid "workspace::FollowNextCollaborator"
msgstr "Folgt der nächsten mitwirkenden Person in der Sitzung."

#. Formats and saves the current file, regardless of the format_on_save setting.
msgctxt "action documentation"
msgid "workspace::FormatAndSave"
msgstr "Formatiert und speichert die aktuelle Datei, unabhängig von der Einstellung format_on_save."

#. Increases size of a currently focused dock by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::IncreaseActiveDockSize"
msgstr "Erhöht die Größe des aktuell fokussierten Docks um die angegebene Pixelanzahl."

#. Increases size of all currently visible docks uniformly, by a given amount of pixels.
msgctxt "action documentation"
msgid "workspace::IncreaseOpenDocksSize"
msgstr "Erhöht die Größe aller aktuell sichtbaren Docks gleichmäßig um die angegebene Pixelanzahl."

#. Moves the focused panel to the next position.
msgctxt "action documentation"
msgid "workspace::MoveFocusedPanelToNextPosition"
msgstr "Verschiebt das fokussierte Panel zur nächsten Position."

#. Moves the active tab into a new window of its own.
msgctxt "action documentation"
msgid "workspace::MoveItemToNewWindow"
msgstr "Verschiebt den aktiven Tab in ein eigenes neues Fenster."

#. Moves an item to a specific pane by index.
msgctxt "action documentation"
msgid "workspace::MoveItemToPane"
msgstr "Verschiebt ein Element in den Bereich mit dem angegebenen Index."

#. Moves an item to a pane in the specified direction.
msgctxt "action documentation"
msgid "workspace::MoveItemToPaneInDirection"
msgstr "Verschiebt ein Element in einen Bereich in der angegebenen Richtung."

#. Move the current pane to be at the very bottom.
msgctxt "action documentation"
msgid "workspace::MovePaneDown"
msgstr "Verschiebt den aktuellen Bereich ganz nach unten."

#. Move the current pane to be at the far left.
msgctxt "action documentation"
msgid "workspace::MovePaneLeft"
msgstr "Verschiebt den aktuellen Bereich ganz nach links."

#. Move the current pane to be at the far right.
msgctxt "action documentation"
msgid "workspace::MovePaneRight"
msgstr "Verschiebt den aktuellen Bereich ganz nach rechts."

#. Move the current pane to be at the very top.
msgctxt "action documentation"
msgid "workspace::MovePaneUp"
msgstr "Verschiebt den aktuellen Bereich ganz nach oben."

#. Opens a new terminal in the center.
msgctxt "action documentation"
msgid "workspace::NewCenterTerminal"
msgstr "Öffnet ein neues Terminal in der Mitte."

#. Creates a new file.
msgctxt "action documentation"
msgid "workspace::NewFile"
msgstr "Erstellt eine neue Datei."

#. Creates a new file in a split of the desired direction.
msgctxt "action documentation"
msgid "workspace::NewFileSplit"
msgstr "Erstellt eine neue Datei in einer Teilung der gewünschten Richtung."

#. Creates a new file in a horizontal split.
msgctxt "action documentation"
msgid "workspace::NewFileSplitHorizontal"
msgstr "Erstellt eine neue Datei in einer horizontalen Teilung."

#. Creates a new file in a vertical split.
msgctxt "action documentation"
msgid "workspace::NewFileSplitVertical"
msgstr "Erstellt eine neue Datei in einer vertikalen Teilung."

#. Opens a new search.
msgctxt "action documentation"
msgid "workspace::NewSearch"
msgstr "Öffnet eine neue Suche."

#. Opens a new terminal.
msgctxt "action documentation"
msgid "workspace::NewTerminal"
msgstr "Öffnet ein neues Terminal."

#. Opens a new window.
msgctxt "action documentation"
msgid "workspace::NewWindow"
msgstr "Öffnet ein neues Fenster."

#. Opens a file or directory.
msgctxt "action documentation"
msgid "workspace::Open"
msgstr "Öffnet eine Datei oder ein Verzeichnis."

#. Opens the component preview.
msgctxt "action documentation"
msgid "workspace::OpenComponentPreview"
msgstr "Öffnet die Komponentenvorschau."

#. Opens multiple files.
msgctxt "action documentation"
msgid "workspace::OpenFiles"
msgstr "Öffnet mehrere Dateien."

#. Opens the current location in terminal.
msgctxt "action documentation"
msgid "workspace::OpenInTerminal"
msgstr "Öffnet den aktuellen Speicherort im Terminal."

#. Opens a new terminal with the specified working directory.
msgctxt "action documentation"
msgid "workspace::OpenTerminal"
msgstr "Öffnet ein neues Terminal mit dem angegebenen Arbeitsverzeichnis."

#. Opens the selected file with the system's default application.
msgctxt "action documentation"
msgid "workspace::OpenWithSystem"
msgstr "Öffnet die ausgewählte Datei mit der Standardanwendung des Systems."

#. Reloads the application
msgctxt "action documentation"
msgid "workspace::Reload"
msgstr "Lädt die Anwendung neu"

#. Reloads the active item.
msgctxt "action documentation"
msgid "workspace::ReloadActiveItem"
msgstr "Lädt das aktive Element neu."

#. Reopens the most recently dismissed picker in the current window.
msgctxt "action documentation"
msgid "workspace::ReopenLastPicker"
msgstr "Öffnet die zuletzt geschlossene Auswahl im aktuellen Fenster erneut."

#. Resets the active dock to its default size.
msgctxt "action documentation"
msgid "workspace::ResetActiveDockSize"
msgstr "Setzt das aktive Dock auf seine Standardgröße zurück."

#. Resets all open docks to their default sizes.
msgctxt "action documentation"
msgid "workspace::ResetOpenDocksSize"
msgstr "Setzt alle geöffneten Docks auf ihre Standardgrößen zurück."

#. Resets all panes in the center group to equal sizes, preserving the split layout.
msgctxt "action documentation"
msgid "workspace::ResetPaneSizes"
msgstr "Setzt alle Bereiche in der mittleren Gruppe auf gleiche Größen zurück und behält dabei das geteilte Layout bei."

#. Restores the banner.
msgctxt "action documentation"
msgid "workspace::RestoreBanner"
msgstr "Stellt das Banner wieder her."

#. Saves the current file with the specified options.
msgctxt "action documentation"
msgid "workspace::Save"
msgstr "Speichert die aktuelle Datei mit den angegebenen Optionen."

#. Saves all open files in the workspace.
msgctxt "action documentation"
msgid "workspace::SaveAll"
msgstr "Speichert alle geöffneten Dateien im Arbeitsbereich."

#. Saves the current file with a new name.
msgctxt "action documentation"
msgid "workspace::SaveAs"
msgstr "Speichert die aktuelle Datei unter einem neuen Namen."

#. Saves without formatting.
msgctxt "action documentation"
msgid "workspace::SaveWithoutFormat"
msgstr "Speichert ohne Formatierung."

#. Sends a sequence of keystrokes to the active element.
msgctxt "action documentation"
msgid "workspace::SendKeystrokes"
msgstr "Sendet eine Folge von Tastenanschlägen an das aktive Element."

#. Shuts down all debug adapters.
msgctxt "action documentation"
msgid "workspace::ShutdownDebugAdapters"
msgstr "Fährt alle Debugadapter herunter."

#. Suppresses the current notification.
msgctxt "action documentation"
msgid "workspace::SuppressNotification"
msgstr "Unterdrückt die aktuelle Benachrichtigung."

#. Swaps the current pane with the one below.
msgctxt "action documentation"
msgid "workspace::SwapPaneDown"
msgstr "Tauscht den aktuellen Bereich mit dem Bereich darunter aus."

#. Swaps the current pane with the one to the left.
msgctxt "action documentation"
msgid "workspace::SwapPaneLeft"
msgstr "Tauscht den aktuellen Bereich mit dem Bereich links aus."

#. Swaps the current pane with the one to the right.
msgctxt "action documentation"
msgid "workspace::SwapPaneRight"
msgstr "Tauscht den aktuellen Bereich mit dem Bereich rechts aus."

#. Swaps the current pane with the one above.
msgctxt "action documentation"
msgid "workspace::SwapPaneUp"
msgstr "Tauscht den aktuellen Bereich mit dem Bereich darüber aus."

#. Toggles all docks.
msgctxt "action documentation"
msgid "workspace::ToggleAllDocks"
msgstr "Blendet alle Docks ein oder aus."

#. Toggles the bottom dock.
msgctxt "action documentation"
msgid "workspace::ToggleBottomDock"
msgstr "Blendet das untere Dock ein oder aus."

#. Toggles centered layout mode.
msgctxt "action documentation"
msgid "workspace::ToggleCenteredLayout"
msgstr "Schaltet den zentrierten Layoutmodus um."

#. Toggles edit prediction feature globally for all files.
msgctxt "action documentation"
msgid "workspace::ToggleEditPrediction"
msgstr "Schaltet die Bearbeitungsvorhersage global für alle Dateien um."

#. Toggles maximizing the active editor pane within the center area,
#. hiding other split panes but leaving docks/panels unaffected.
msgctxt "action documentation"
msgid "workspace::ToggleEditorZoom"
msgstr "Maximiert den aktiven Editor-Bereich im Zentrum oder stellt ihn wieder her,\nwobei andere geteilte Bereiche ausgeblendet werden, Docks und Panels jedoch unbeeinflusst bleiben."

#. Toggles expansion of the selected item.
msgctxt "action documentation"
msgid "workspace::ToggleExpandItem"
msgstr "Schaltet das Aufklappen des ausgewählten Elements um."

#. Toggles Helix mode on or off.
msgctxt "action documentation"
msgid "workspace::ToggleHelixMode"
msgstr "Schaltet den Helix-Modus ein oder aus."

#. Toggles the left dock.
msgctxt "action documentation"
msgid "workspace::ToggleLeftDock"
msgstr "Blendet das linke Dock ein oder aus."

#. Toggles read-only mode for the active item (if supported by that item).
msgctxt "action documentation"
msgid "workspace::ToggleReadOnlyFile"
msgstr "Schaltet den Nur-Lese-Modus des aktiven Elements um (sofern vom Element unterstützt)."

#. Toggles the right dock.
msgctxt "action documentation"
msgid "workspace::ToggleRightDock"
msgstr "Blendet das rechte Dock ein oder aus."

#. Toggles Vim mode on or off.
msgctxt "action documentation"
msgid "workspace::ToggleVimMode"
msgstr "Schaltet den Vim-Modus ein oder aus."

#. If any worktrees are in restricted mode, shows a modal with possible actions.
#. If the modal is shown already, closes it without trusting any worktree.
msgctxt "action documentation"
msgid "workspace::ToggleWorktreeSecurity"
msgstr "Zeigt einen Dialog mit möglichen Aktionen an, wenn sich Worktrees im eingeschränkten Modus befinden.\nWenn der Dialog bereits angezeigt wird, wird er geschlossen, ohne einem Worktree zu vertrauen."

#. Toggles zoom on the active pane.
msgctxt "action documentation"
msgid "workspace::ToggleZoom"
msgstr "Schaltet den Zoom im aktiven Bereich um."

#. Stops following a collaborator.
msgctxt "action documentation"
msgid "workspace::Unfollow"
msgstr "Folgt einer mitwirkenden Person nicht mehr."

#. Switches to the agentic panel layout.
msgctxt "action documentation"
msgid "workspace::UseAgenticLayout"
msgstr "Wechselt zum agentischen Panel-Layout."

#. Switches to the classic, editor-focused panel layout.
msgctxt "action documentation"
msgid "workspace::UseClassicLayout"
msgstr "Wechselt zum klassischen, auf den Editor ausgerichteten Panel-Layout."

#. Zooms in on the active pane.
msgctxt "action documentation"
msgid "workspace::ZoomIn"
msgstr "Vergrößert den aktiven Bereich."

#. Zooms out of the active pane.
msgctxt "action documentation"
msgid "workspace::ZoomOut"
msgstr "Verkleinert den aktiven Bereich."

#. Deletes the selected git worktree.
msgctxt "action documentation"
msgid "worktree_picker::DeleteWorktree"
msgstr "Löscht den ausgewählten Git-Worktree."

#. Force deletes the selected git worktree.
msgctxt "action documentation"
msgid "worktree_picker::ForceDeleteWorktree"
msgstr "Erzwingt das Löschen des ausgewählten Git-Worktrees."

#. Shows information about Zed.
msgctxt "action documentation"
msgid "zed::About"
msgstr "Zeigt Informationen über ForgeKairos an."

#. Opens the ACP registry.
msgctxt "action documentation"
msgid "zed::AcpRegistry"
msgstr "Öffnet die ACP-Registry."

#. Cancels an in-progress ETW trace without saving.
msgctxt "action documentation"
msgid "zed::CancelEtwTrace"
msgstr "Bricht eine laufende ETW-Ablaufverfolgung ohne Speichern ab."

#. Copies installed extensions to the clipboard for bug reports.
msgctxt "action documentation"
msgid "zed::CopyInstalledExtensionsIntoClipboard"
msgstr "Kopiert installierte Erweiterungen für Fehlerberichte in die Zwischenablage."

#. Copies system specifications to the clipboard for bug reports.
msgctxt "action documentation"
msgid "zed::CopySystemSpecsIntoClipboard"
msgstr "Kopiert Systemspezifikationen für Fehlerberichte in die Zwischenablage."

#. Opens the element inspector for debugging UI.
msgctxt "action documentation"
msgid "zed::DebugElements"
msgstr "Öffnet den Elementinspektor zur Fehlersuche in der Benutzeroberfläche."

#. Decreases the font size in the editor buffer.
msgctxt "action documentation"
msgid "zed::DecreaseBufferFontSize"
msgstr "Verringert die Schriftgröße im Editor-Puffer."

#. Decreases the font size of the user interface.
msgctxt "action documentation"
msgid "zed::DecreaseUiFontSize"
msgstr "Verringert die Schriftgröße der Benutzeroberfläche."

#. Opens the extensions management interface.
msgctxt "action documentation"
msgid "zed::Extensions"
msgstr "Öffnet die Erweiterungsverwaltungsoberfläche."

#. Opens the Zed merch store.
msgctxt "action documentation"
msgid "zed::GetMerch"
msgstr "Öffnet den Zed-Merch-Store."

#. Hides the application window.
msgctxt "action documentation"
msgid "zed::Hide"
msgstr "Blendet das Anwendungsfenster aus."

#. Hides all other application windows.
msgctxt "action documentation"
msgid "zed::HideOthers"
msgstr "Blendet alle anderen Anwendungsfenster aus."

#. Imports settings from Cursor editor.
msgctxt "action documentation"
msgid "zed::ImportCursorSettings"
msgstr "Importiert Einstellungen aus dem Cursor-Editor."

#. Imports settings from Visual Studio Code.
msgctxt "action documentation"
msgid "zed::ImportVsCodeSettings"
msgstr "Importiert Einstellungen aus Visual Studio Code."

#. Increases the font size in the editor buffer.
msgctxt "action documentation"
msgid "zed::IncreaseBufferFontSize"
msgstr "Erhöht die Schriftgröße im Editor-Puffer."

#. Increases the font size of the user interface.
msgctxt "action documentation"
msgid "zed::IncreaseUiFontSize"
msgstr "Erhöht die Schriftgröße der Benutzeroberfläche."

#. Installs an extension from a local directory for development.
msgctxt "action documentation"
msgid "zed::InstallDevExtension"
msgstr "Installiert eine Erweiterung aus einem lokalen Verzeichnis zur Entwicklung."

#. Minimizes the current window.
msgctxt "action documentation"
msgid "zed::Minimize"
msgstr "Minimiert das aktuelle Fenster."

#. Action with special handling which unbinds the keybinding this is associated with,
#. if it is the highest precedence match.
msgctxt "action documentation"
msgid "zed::NoAction"
msgstr "Aktion mit spezieller Behandlung, die die zugehörige Tastenkombination aufhebt,\nwenn die Tastenkombination die höchste Priorität hat."

#. Opens account settings.
msgctxt "action documentation"
msgid "zed::OpenAccountSettings"
msgstr "Öffnet die Kontoeinstellungen."

#. Opens a URL in the system's default web browser.
msgctxt "action documentation"
msgid "zed::OpenBrowser"
msgstr "Öffnet eine URL im Standard-Webbrowser des Systems."

#. Opens debug tasks configuration.
msgctxt "action documentation"
msgid "zed::OpenDebugTasks"
msgstr "Öffnet die Konfiguration der Debug-Aufgaben."

#. Opens the default keymap file.
msgctxt "action documentation"
msgid "zed::OpenDefaultKeymap"
msgstr "Öffnet die Standard-Keymap-Datei."

#. Opens the default settings file.
msgctxt "action documentation"
msgid "zed::OpenDefaultSettings"
msgstr "Öffnet die Standard-Einstellungsdatei."

#. Opens the documentation website.
msgctxt "action documentation"
msgid "zed::OpenDocs"
msgstr "Öffnet die Dokumentationswebsite."

#. Opens the keymap editor.
msgctxt "action documentation"
msgid "zed::OpenKeymap"
msgstr "Öffnet den Keymap-Editor."

#. Opens the user keymap file.
msgctxt "action documentation"
msgid "zed::OpenKeymapFile"
msgstr "Öffnet die Benutzer-Keymap-Datei."

#. Views open source licenses.
msgctxt "action documentation"
msgid "zed::OpenLicenses"
msgstr "Zeigt Open-Source-Lizenzen an."

#. Opens the Zed log file.
msgctxt "action documentation"
msgid "zed::OpenLog"
msgstr "Öffnet die ForgeKairos-Protokolldatei."

#. Opens the onboarding view.
msgctxt "action documentation"
msgid "zed::OpenOnboarding"
msgstr "Öffnet die Einführungsansicht."

#. Opens the performance profiler.
msgctxt "action documentation"
msgid "zed::OpenPerformanceProfiler"
msgstr "Öffnet den Leistungsprofiler."

#. Opens project-specific settings.
msgctxt "action documentation"
msgid "zed::OpenProjectSettings"
msgstr "Öffnet die projektspezifischen Einstellungen."

#. Opens project-specific settings file.
msgctxt "action documentation"
msgid "zed::OpenProjectSettingsFile"
msgstr "Öffnet die projektspezifische Einstellungsdatei."

#. Opens the project tasks configuration.
msgctxt "action documentation"
msgid "zed::OpenProjectTasks"
msgstr "Öffnet die Konfiguration der Projektaufgaben."

#. Opens server settings.
msgctxt "action documentation"
msgid "zed::OpenServerSettings"
msgstr "Öffnet die Servereinstellungen."

#. Opens the settings editor.
msgctxt "action documentation"
msgid "zed::OpenSettings"
msgstr "Öffnet den Einstellungseditor."

#. Opens the settings editor at a specific path.
msgctxt "action documentation"
msgid "zed::OpenSettingsAt"
msgstr "Öffnet den Einstellungseditor an einem bestimmten Pfad."

#. Opens the settings JSON file.
msgctxt "action documentation"
msgid "zed::OpenSettingsFile"
msgstr "Öffnet die Einstellungs-JSON-Datei."

#. Opens the Zed status page.
msgctxt "action documentation"
msgid "zed::OpenStatusPage"
msgstr "Öffnet die Zed-Statusseite."

#. Opens the tasks panel.
msgctxt "action documentation"
msgid "zed::OpenTasks"
msgstr "Öffnet das Aufgabenpanel."

#. Opens the telemetry log.
msgctxt "action documentation"
msgid "zed::OpenTelemetryLog"
msgstr "Öffnet das Telemetrieprotokoll."

#. Opens the project tasks configuration with worktree setup guidance.
msgctxt "action documentation"
msgid "zed::OpenWorktreeSetupTasks"
msgstr "Öffnet die Konfiguration der Projektaufgaben mit Hinweisen zur Worktree-Einrichtung."

#. Opens the Zed repository on GitHub.
msgctxt "action documentation"
msgid "zed::OpenZedRepo"
msgstr "Öffnet das Zed-Repository auf GitHub."

#. Opens a zed:// URL within the application.
msgctxt "action documentation"
msgid "zed::OpenZedUrl"
msgstr "Öffnet eine zed://-URL innerhalb der Anwendung."

#. Quits the application.
msgctxt "action documentation"
msgid "zed::Quit"
msgstr "Beendet die Anwendung."

#. Rebuilds an installed dev extension.
msgctxt "action documentation"
msgid "zed::RebuildDevExtension"
msgstr "Erstellt eine installierte Entwicklungserweiterung neu."

#. Starts recording an ETW (Event Tracing for Windows) trace.
msgctxt "action documentation"
msgid "zed::RecordEtwTrace"
msgstr "Startet die Aufzeichnung einer ETW-Ablaufverfolgung (Event Tracing for Windows)."

#. Starts recording an ETW (Event Tracing for Windows) trace with heap tracing.
msgctxt "action documentation"
msgid "zed::RecordEtwTraceWithHeapTracing"
msgstr "Startet die Aufzeichnung einer ETW-Ablaufverfolgung (Event Tracing for Windows) mit Heap-Ablaufverfolgung."

#. Reloads all installed extensions.
msgctxt "action documentation"
msgid "zed::ReloadExtensions"
msgstr "Lädt alle installierten Erweiterungen neu."

#. Resets all zoom levels (UI and buffer font sizes, including in the agent panel) to their default values.
msgctxt "action documentation"
msgid "zed::ResetAllZoom"
msgstr "Setzt alle Zoomstufen (Schriftgrößen von UI und Puffer, einschließlich im Agent-Panel) auf ihre Standardwerte zurück."

#. Resets the buffer font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetBufferFontSize"
msgstr "Setzt die Schriftgröße des Puffers auf den Standardwert zurück."

#. Resets the application database.
msgctxt "action documentation"
msgid "zed::ResetDatabase"
msgstr "Setzt die Anwendungsdatenbank zurück."

#. Resets the UI font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetUiFontSize"
msgstr "Setzt die UI-Schriftgröße auf den Standardwert zurück."

#. Reveals the Zed log file in the system file manager.
msgctxt "action documentation"
msgid "zed::RevealLogInFileManager"
msgstr "Zeigt die ForgeKairos-Protokolldatei im Systemdateimanager an."

#. Saves an in-progress ETW trace to disk.
msgctxt "action documentation"
msgid "zed::SaveEtwTrace"
msgstr "Speichert eine laufende ETW-Ablaufverfolgung auf dem Datenträger."

#. Shows all hidden windows.
msgctxt "action documentation"
msgid "zed::ShowAll"
msgstr "Zeigt alle ausgeblendeten Fenster an."

#. Shows the default semantic token rules (read-only).
msgctxt "action documentation"
msgid "zed::ShowDefaultSemanticTokenRules"
msgstr "Zeigt die standardmäßigen semantischen Token-Regeln an (schreibgeschützt)."

#. Shows the auto-update notification for testing.
msgctxt "action documentation"
msgid "zed::ShowUpdateNotification"
msgstr "Zeigt die Benachrichtigung für automatische Updates zu Testzwecken an."

#. Show the Zed welcome screen
msgctxt "action documentation"
msgid "zed::ShowWelcome"
msgstr "Zeigt den ForgeKairos-Willkommensbildschirm an"

#. Triggers a hard crash for debugging.
msgctxt "action documentation"
msgid "zed::TestCrash"
msgstr "Löst einen harten Absturz zum Debuggen aus."

#. Triggers a test panic for debugging.
msgctxt "action documentation"
msgid "zed::TestPanic"
msgstr "Löst eine Test-Panic zum Debuggen aus."

#. Toggles the base keymap selector modal.
msgctxt "action documentation"
msgid "zed::ToggleBaseKeymapSelector"
msgstr "Öffnet oder schließt das Auswahlfenster für die Basis-Keymap."

#. Toggles fullscreen mode.
msgctxt "action documentation"
msgid "zed::ToggleFullScreen"
msgstr "Schaltet den Vollbildmodus um."

#. Action with special handling which unbinds later bindings for the same keystrokes when they
#. dispatch the named action, regardless of that action's context.
#.
#. In keymap JSON this is written as:
#.
#. `["zed::Unbind", "editor::NewLine"]`
msgctxt "action documentation"
msgid "zed::Unbind"
msgstr "Aktion mit Sonderbehandlung, die spätere Tastenkombinationen für dieselben Tastenanschläge aufhebt, wenn sie die angegebene Aktion auslösen, unabhängig vom Kontext dieser Aktion.\n\nIm Keymap-JSON wird dies so geschrieben:\n\n`[\"zed::Unbind\", \"editor::NewLine\"]`"

#. Zooms the window.
msgctxt "action documentation"
msgid "zed::Zoom"
msgstr "Vergrößert das Fenster."

#. Opens the Zed Predict onboarding modal.
msgctxt "action documentation"
msgid "zed_predict_onboarding::OpenZedPredictOnboarding"
msgstr "Öffnet den Einführungsdialog für Zed Predict."

#. Focuses on the completions list.
msgctxt "action documentation"
msgid "zeta::FocusPredictions"
msgstr "Fokussiert die Vervollständigungsliste."

#. Navigates to the next edit in the completion history.
msgctxt "action documentation"
msgid "zeta::NextEdit"
msgstr "Navigiert zur nächsten Bearbeitung im Vervollständigungsverlauf."

#. Previews the selected completion.
msgctxt "action documentation"
msgid "zeta::PreviewPrediction"
msgstr "Zeigt die ausgewählte Vervollständigung in der Vorschau an."

#. Navigates to the previous edit in the completion history.
msgctxt "action documentation"
msgid "zeta::PreviousEdit"
msgstr "Navigiert zur vorherigen Bearbeitung im Vervollständigungsverlauf."

#. Rates the active completion with a thumbs down.
msgctxt "action documentation"
msgid "zeta::ThumbsDownActivePrediction"
msgstr "Bewertet die aktive Vervollständigung mit „Daumen runter“."

#. Rates the active completion with a thumbs up.
msgctxt "action documentation"
msgid "zeta::ThumbsUpActivePrediction"
msgstr "Bewertet die aktive Vervollständigung mit „Daumen hoch“."
