msgid "editor::NextSnippetTabstop"
msgstr "Wechselt zum nächsten Snippet-Tabstopp, falls vorhanden."

#. Opens the context menu at cursor position.
msgctxt "action documentation"
msgid "editor::OpenContextMenu"
msgstr "Öffnet das Kontextmenü an der Cursorposition."

#. Opens documentation for the symbol at cursor.
msgctxt "action documentation"
msgid "editor::OpenDocs"
msgstr "Öffnet die Dokumentation für das Symbol an der Cursorposition."

#. Opens excerpts from the current file.
msgctxt "action documentation"
msgid "editor::OpenExcerpts"
msgstr "Öffnet Auszüge aus der aktuellen Datei."

#. Opens excerpts in a split pane.
msgctxt "action documentation"
msgid "editor::OpenExcerptsSplit"
msgstr "Öffnet Auszüge in einem geteilten Bereich."

#. Opens the git commit for the blame at cursor.
msgctxt "action documentation"
msgid "editor::OpenGitBlameCommit"
msgstr "Öffnet den Git-Commit für die Blame-Anzeige an der Cursorposition."

#. Opens a permalink to the current line or selection.
msgctxt "action documentation"
msgid "editor::OpenPermalinkToLine"
msgstr "Öffnet einen Permalink zur aktuellen Zeile oder Auswahl."

#. Opens the proposed changes editor.
msgctxt "action documentation"
msgid "editor::OpenProposedChangesEditor"
msgstr "Öffnet den Editor für vorgeschlagene Änderungen."

#. Opens the file whose name is selected in the editor.
msgctxt "action documentation"
msgid "editor::OpenSelectedFilename"
msgstr "Öffnet die Datei, deren Name im Editor ausgewählt ist."

#. Opens all selections in a multibuffer.
msgctxt "action documentation"
msgid "editor::OpenSelectionsInMultibuffer"
msgstr "Öffnet alle Auswahlen in einem Multibuffer."

#. Opens the URL at cursor position.
msgctxt "action documentation"
msgid "editor::OpenUrl"
msgstr "Öffnet die URL an der Cursorposition."

#. Organizes import statements.
msgctxt "action documentation"
msgid "editor::OrganizeImports"
msgstr "Organisiert Import-Anweisungen."

#. Decreases indentation of selected lines.
msgctxt "action documentation"
msgid "editor::Outdent"
msgstr "Verringert die Einrückung der ausgewählten Zeilen."

#. Scrolls down by one page.
msgctxt "action documentation"
msgid "editor::PageDown"
msgstr "Scrollt um eine Seite nach unten."

#. Scrolls up by one page.
msgctxt "action documentation"
msgid "editor::PageUp"
msgstr "Scrollt um eine Seite nach oben."

#. Pastes from clipboard.
msgctxt "action documentation"
msgid "editor::Paste"
msgstr "Fügt aus der Zwischenablage ein."

#. Navigates to the previous edit prediction.
msgctxt "action documentation"
msgid "editor::PreviousEditPrediction"
msgstr "Navigiert zur vorherigen Bearbeitungsvorhersage."

#. Goes to the previous snippet tabstop if one exists.
msgctxt "action documentation"
msgid "editor::PreviousSnippetTabstop"
msgstr "Wechselt zum vorherigen Snippet-Tabstopp, falls vorhanden."

#. Redoes the last undone edit.
msgctxt "action documentation"
msgid "editor::Redo"
msgstr "Wiederholt die zuletzt rückgängig gemachte Bearbeitung."

#. Redoes the last selection change.
msgctxt "action documentation"
msgid "editor::RedoSelection"
msgstr "Wiederholt die letzte Auswahländerung."

#. Reloads the file from disk.
msgctxt "action documentation"
msgid "editor::ReloadFile"
msgstr "Lädt die Datei von der Festplatte neu."

#. Renames the symbol at cursor.
msgctxt "action documentation"
msgid "editor::Rename"
msgstr "Benennt das Symbol an der Cursorposition um."

#. Restarts the language server for the current file.
msgctxt "action documentation"
msgid "editor::RestartLanguageServer"
msgstr "Startet den Sprachserver für die aktuelle Datei neu."

#. Reveals the current file in the system file manager.
msgctxt "action documentation"
msgid "editor::RevealInFileManager"
msgstr "Zeigt die aktuelle Datei im Systemdateimanager an."

#. Reverses the order of selected lines.
msgctxt "action documentation"
msgid "editor::ReverseLines"
msgstr "Kehrt die Reihenfolge der ausgewählten Zeilen um."

#. Rewraps text to fit within the preferred line length.
msgctxt "action documentation"
msgid "editor::Rewrap"
msgstr "Bricht Text auf die bevorzugte Zeilenlänge um."

#. Rotates selections or lines backward.
msgctxt "action documentation"
msgid "editor::RotateSelectionsBackward"
msgstr "Dreht Auswahlen oder Zeilen rückwärts."

#. Rotates selections or lines forward.
msgctxt "action documentation"
msgid "editor::RotateSelectionsForward"
msgstr "Dreht Auswahlen oder Zeilen vorwärts."

#. Runs flycheck diagnostics.
msgctxt "action documentation"
msgid "editor::RunFlycheck"
msgstr "Führt Flycheck-Diagnosen aus."

#. Saves the current location to navigation history.
msgctxt "action documentation"
msgid "editor::SaveLocation"
msgstr "Speichert die aktuelle Position im Navigationsverlauf."

#. Scrolls the cursor to the bottom of the viewport.
msgctxt "action documentation"
msgid "editor::ScrollCursorBottom"
msgstr "Scrollt den Cursor an den unteren Rand des Anzeigebereichs."

#. Scrolls the cursor to the center of the viewport.
msgctxt "action documentation"
msgid "editor::ScrollCursorCenter"
msgstr "Scrollt den Cursor in die Mitte des Anzeigebereichs."

#. Cycles cursor position between center, top, and bottom.
msgctxt "action documentation"
msgid "editor::ScrollCursorCenterTopBottom"
msgstr "Wechselt die Cursorposition zwischen Mitte, oben und unten."

#. Scrolls the cursor to the top of the viewport.
msgctxt "action documentation"
msgid "editor::ScrollCursorTop"
msgstr "Scrollt den Cursor an den oberen Rand des Anzeigebereichs."

#. Selects all text in the editor.
msgctxt "action documentation"
msgid "editor::SelectAll"
msgstr "Wählt den gesamten Text im Editor aus."

#. Selects all matches of the current selection.
msgctxt "action documentation"
msgid "editor::SelectAllMatches"
msgstr "Wählt alle Treffer der aktuellen Auswahl aus."

#. Selects the nearest enclosing delimiters (brackets, braces,
#. parentheses, or quotes) together with the content between them.
#. Repeating the action expands the selection to the next enclosing
#. pair.
msgctxt "action documentation"
msgid "editor::SelectAroundDelimiters"
msgstr "Wählt die nächstgelegenen umschließenden Begrenzungszeichen (eckige Klammern, geschweifte Klammern,\nrunde Klammern oder Anführungszeichen) zusammen mit dem dazwischenliegenden Inhalt aus.\nDurch erneutes Ausführen der Aktion wird die Auswahl auf das nächste umschließende\nPaar erweitert."

#. Extends selection down.
msgctxt "action documentation"
msgid "editor::SelectDown"
msgstr "Erweitert die Auswahl nach unten."

#. Extends selection down by a specified number of lines.
msgctxt "action documentation"
msgid "editor::SelectDownByLines"
msgstr "Erweitert die Auswahl um eine bestimmte Anzahl von Zeilen nach unten."

#. Selects the enclosing symbol.
msgctxt "action documentation"
msgid "editor::SelectEnclosingSymbol"
msgstr "Wählt das umschließende Symbol aus."

#. Selects the content within the nearest enclosing delimiters
#. (brackets, braces, parentheses, or quotes), excluding the
#. delimiters.
#. Repeating the action expands the selection to the next enclosing
#. pair.
msgctxt "action documentation"
msgid "editor::SelectInsideDelimiters"
msgstr "Wählt den Inhalt innerhalb der nächstgelegenen umschließenden Begrenzungszeichen\n(eckige Klammern, geschweifte Klammern, runde Klammern oder Anführungszeichen) aus, ohne die\nBegrenzungszeichen.\nDurch erneutes Ausführen der Aktion wird die Auswahl auf das nächste umschließende\nPaar erweitert."

#. Selects the next larger syntax node.
msgctxt "action documentation"
msgid "editor::SelectLargerSyntaxNode"
msgstr "Wählt den nächstgrößeren Syntaxknoten aus."

#. Extends selection left.
msgctxt "action documentation"
msgid "editor::SelectLeft"
msgstr "Erweitert die Auswahl nach links."

#. Selects the current line.
msgctxt "action documentation"
msgid "editor::SelectLine"
msgstr "Wählt die aktuelle Zeile aus."

#. Selects the next occurrence of the current selection.
msgctxt "action documentation"
msgid "editor::SelectNext"
msgstr "Wählt das nächste Vorkommen der aktuellen Auswahl aus."

#. Selects the next syntax node sibling.
msgctxt "action documentation"
msgid "editor::SelectNextSyntaxNode"
msgstr "Wählt den nächsten Geschwisterknoten im Syntaxbaum aus."

#. Extends selection down by one page.
msgctxt "action documentation"
msgid "editor::SelectPageDown"
msgstr "Erweitert die Auswahl um eine Seite nach unten."

#. Extends selection up by one page.
msgctxt "action documentation"
msgid "editor::SelectPageUp"
msgstr "Erweitert die Auswahl um eine Seite nach oben."

#. Selects the previous occurrence of the current selection.
