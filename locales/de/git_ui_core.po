msgstr "Einrichtung automatisieren"

msgid "Automate Worktree Setup"
msgstr "Worktree-Einrichtung automatisieren"

msgid "Cancel"
msgstr "Abbrechen"

msgid "Cannot create a named worktree in a project with multiple repositories"
msgstr "In einem Projekt mit mehreren Repositorys kann kein benannter Worktree erstellt werden"

msgid "Create"
msgstr "Erstellen"

msgid "Create \"{name}\" based on {branch_label}"
msgstr "„{name}“ basierend auf {branch_label} erstellen"

msgid "Create new worktree based on {branch_label}"
msgstr "Neuen Worktree auf Basis von {branch_label} erstellen"

msgid "Delete"
msgstr "Löschen"

msgid "Delete Worktree"
msgstr "Worktree löschen"

msgid "Deleting…"
msgstr "Wird gelöscht…"

msgid "Failed to connect"
msgstr "Verbindung konnte nicht hergestellt werden"

msgid "Force Delete"
msgstr "Löschen erzwingen"

msgid "Force Delete Worktree"
msgstr "Löschen des Worktrees erzwingen"

msgid "Hold {} to force delete"
msgstr "{} gedrückt halten, um das Löschen zu erzwingen"

msgid "Learn more"
msgstr "Mehr erfahren"

msgid "Open"
msgstr "Öffnen"

msgid "Open in New Window"
msgstr "In neuem Fenster öffnen"

msgid "Output from git {operation}"
msgstr "Ausgabe von git {operation}"

msgid "Remove Worktree from Window"
msgstr "Worktree aus dem Fenster entfernen"

