msgid "This Window"
msgstr "Dieses Fenster"

msgid "Use local {}"
msgstr "Lokale Version von {} verwenden"

msgid "View Log"
msgstr "Protokoll anzeigen"

msgid "Worktree \"{display_name}\" contains modified or untracked files. Force delete it?"
msgstr "Worktree „{display_name}“ enthält geänderte oder nicht verfolgte Dateien. Löschen erzwingen?"

msgid "Worktree creation is not supported in collaborative projects"
msgstr "Das Erstellen von Worktrees wird in kollaborativen Projekten nicht unterstützt"

msgid "You may need to configure git for Github."
msgstr "Möglicherweise müssen Sie Git für GitHub konfigurieren."

msgid "current branches"
msgstr "aktuelle Branches"

msgid "git fetch failed for {}"
msgstr "git fetch für {} fehlgeschlagen"

msgid "git {} failed"
msgstr "git {} ist fehlgeschlagen"
