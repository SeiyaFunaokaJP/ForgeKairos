msgid "Accepts this key and continues connecting (the key is recorded in known_hosts)"
msgstr "Akzeptiert diesen Schlüssel und setzt die Verbindung fort (der Schlüssel wird in known_hosts gespeichert)"

msgid "Authentication was canceled."
msgstr "Die Authentifizierung wurde abgebrochen."

msgid "Brings the items selected on the remote side to the local side"
msgstr "Überträgt die auf der Remote-Seite ausgewählten Elemente auf die lokale Seite"

msgid "Cancel"
msgstr "Abbrechen"

