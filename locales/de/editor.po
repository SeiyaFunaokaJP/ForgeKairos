msgid "requirementDiagram\n    %% requirement declares a requirement; element declares what satisfies it. Connect them with - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Users can log in\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Screen\"\n    }}\n    login_page - satisfies -> login"
msgstr "requirementDiagram\n    %% requirement deklariert eine Anforderung; element deklariert, was sie erfüllt. Verbinden Sie beide mit - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Benutzer können sich anmelden\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Bildschirm\"\n    }}\n    login_page - satisfies -> login"

msgid "sankey-beta\n    %% Each line is source,target,amount. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"
msgstr "sankey-beta\n    %% Jede Zeile ist Quelle,Ziel,Menge. Schreiben Sie Namen nur mit ASCII-Buchstaben und -Ziffern (Mermaid kann keine Nicht-ASCII-Namen lesen)\n    Strom,Haushalt,30\n    Strom,Fabrik,50\n    Gas,Haushalt,20\n    Gas,Fabrik,10"

msgid "sequenceDiagram\n    %% ->> is a call and -->> a reply\n    participant User as User\n    participant App as App\n    User->>App: Request\n    App-->>User: Response\n    Note over App: Note"
msgstr "sequenceDiagram\n    %% ->> ist ein Aufruf und -->> eine Antwort\n    participant User as Benutzer\n    participant App as App\n    User->>App: Anfrage\n    App-->>User: Antwort\n    Note over App: Notiz"

msgid "stateDiagram-v2\n    %% [*] is the start and the end. The text after : on an arrow is the event name\n    [*] --> Idle\n    Idle --> Running: Start\n    Running --> Idle: Finish\n    Running --> [*]: Abort"
msgstr "stateDiagram-v2\n    %% [*] ist Start und Ende. Der Text nach : an einem Pfeil ist der Name des Ereignisses\n    [*] --> Idle\n    Idle --> Running: Start\n    Running --> Idle: Fertig\n    Running --> [*]: Abbruch"

msgid "the latest version"
msgstr "die neueste Version"

msgid "timeline\n    title History\n    2024 : Planning\n    2025 : Development : Release\n    2026 : Operation"
msgstr "timeline\n    title Verlauf\n    2024 : Planung\n    2025 : Entwicklung : Veröffentlichung\n    2026 : Betrieb"

msgid "treeView-beta\n    %% Indentation shows the hierarchy\n    \"Project\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""
msgstr "treeView-beta\n    %% Die Einrückung zeigt die Hierarchie\n    \"Projekt\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""

msgid "treemap-beta\n    %% Indentation nests items. Give each leaf a value after :\n    \"Development\"\n        \"Design\": 30\n        \"Implementation\": 50\n    \"Operations\"\n        \"Maintenance\": 15\n        \"Monitoring\": 5"
msgstr "treemap-beta\n    %% Einrückung verschachtelt Elemente. Geben Sie jedem Blatt nach : einen Wert\n    \"Entwicklung\"\n        \"Entwurf\": 30\n        \"Implementierung\": 50\n    \"Betrieb\"\n        \"Wartung\": 15\n        \"Überwachung\": 5"

msgid "type named by the language server"
msgstr "Typ vom Sprachserver benannt"

msgid "venn-beta\n    %% set defines a set and union names an overlap\n    title Overlapping Responsibilities\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"
msgstr "venn-beta\n    %% set definiert eine Menge und union benennt eine Überschneidung\n    title Überschneidende Zuständigkeiten\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"

msgid "xychart-beta\n    %% bar draws bars and line a line. Give as many values as the x-axis has items\n    title \"Monthly Sales\"\n    x-axis [\"Jan\", \"Feb\", \"Mar\", \"Apr\"]\n    y-axis \"Sales (USD thousands)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"
msgstr "xychart-beta\n    %% bar zeichnet Balken und line eine Linie. Geben Sie so viele Werte an, wie die x-Achse Einträge hat\n    title \"Monatlicher Umsatz\"\n    x-axis [\"Jan\", \"Feb\", \"Mär\", \"Apr\"]\n    y-axis \"Umsatz (Tsd. USD)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"

