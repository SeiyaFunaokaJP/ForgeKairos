msgid "eventmodeling\n    %% tf number type name. ui is a screen, cmd a command, evt an event and rmo a read model. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"
msgstr "eventmodeling\n    %% tf Nummer Typ Name. ui ist ein Bildschirm, cmd ein Befehl, evt ein Ereignis und rmo ein Lesemodell. Schreiben Sie Namen nur mit ASCII-Buchstaben und -Ziffern (Mermaid kann keine Nicht-ASCII-Namen lesen)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"

msgid "flowchart TD\n    %% [] is a step and {{}} a decision. |label| annotates a branch\n    start[Start] --> condition{{Condition}}\n    condition -->|Yes| work[Process]\n    condition -->|No| finish[End]\n    work --> finish"
msgstr "flowchart TD\n    %% [] ist ein Schritt und {{}} eine Entscheidung. |Beschriftung| beschriftet einen Zweig\n    start[Start] --> condition{{Bedingung}}\n    condition -->|Ja| work[Verarbeitung]\n    condition -->|Nein| finish[Ende]\n    work --> finish"

