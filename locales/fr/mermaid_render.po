msgstr "Autre : {name}"

msgid "Otherwise (else)"
msgstr "Sinon (else)"

msgid "Overlapping parallel (par_over)"
msgstr "Parallèle superposé (par_over)"

msgid "Parallel (par)"
msgstr "Parallèle (par)"

