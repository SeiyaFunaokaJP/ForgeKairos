msgstr "le nom de branche `{name}` ne peut pas être réécrit"

msgid "the branch name is missing"
msgstr "le nom de branche est manquant"

msgid "the first section"
msgstr "la première section"

msgid "the order `{value}` is not a whole number"
msgstr "l'ordre `{value}` n'est pas un nombre entier"

msgid "the quotes are not closed"
msgstr "les guillemets ne sont pas fermés"

msgid "the space"
msgstr "espace"

msgid "the type `{value}` is not one of NORMAL / REVERSE / HIGHLIGHT"
msgstr "le type `{value}` n'est pas l'un de NORMAL / REVERSE / HIGHLIGHT"

msgid "there is no `:` after `{key}`"
msgstr "il n'y a pas de `:` après `{key}`"

msgid "{error} Edit it as text."
msgstr "{error} Modifiez-le sous forme de texte."

msgid "{name}: `{value}` cannot be written. {number_rule}"
msgstr "{name} : impossible d'écrire `{value}`. {number_rule}"

msgid "{problem} Edit it as text."
msgstr "{problem} Modifiez-le sous forme de texte."

