# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: fr\n"
"X-Language-Name: Français\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "A Note has no target."
msgstr "Une Note n'a pas de cible."

msgid "A `%%{{` directive is on the same line as a statement or a comment (Mermaid cuts out only the directive and reads the rest as a statement). Write the directive on a line of its own, or edit it as text."
msgstr "Une directive `%%{{` se trouve sur la même ligne qu'une instruction ou un commentaire (Mermaid n'extrait que la directive et lit le reste comme une instruction). Écrivez la directive sur une ligne distincte, ou modifiez-la sous forme de texte."

msgid "A `%%{{` inside a comment runs on to the next line ({line}). Mermaid does not read the lines in between, so the structured editor cannot handle it."
msgstr "Un `%%{{` dans un commentaire se poursuit sur la ligne suivante ({line}). Mermaid ne lit pas les lignes intermédiaires : l'éditeur structuré ne peut donc pas le traiter."

msgid "A `block` group is not closed with `end`. Edit it as text."
msgstr "Un groupe `block` n'est pas fermé par `end`. Modifiez-le sous forme de texte."

msgid "A `section` without a name is not supported by the structured editor ({statement}). Give it a name, or edit it as text."
msgstr "Une `section` sans nom n'est pas prise en charge par l'éditeur structuré ({statement}). Donnez-lui un nom, ou modifiez-la sous forme de texte."

msgid "A `section` without a name is not supported by the structured editor ({trimmed}). Give it a name, or edit it as text."
msgstr "Une `section` sans nom n'est pas prise en charge par l'éditeur structuré ({trimmed}). Donnez-lui un nom, ou modifiez-la sous forme de texte."

msgid "A comment (`%%`) on a line of data `{name}` is lost in the structured editor. Move the comment to a line of its own outside the block, then open it again."
msgstr "Un commentaire (`%%`) sur une ligne de données `{name}` est perdu dans l'éditeur structuré. Déplacez le commentaire sur une ligne distincte en dehors du bloc, puis rouvrez-le."

msgid "A comment at the end of a frame line is lost in the structured editor ({line}). Move the comment to a line of its own, then open it again."
msgstr "Un commentaire à la fin d'une ligne de cadre est perdu dans l'éditeur structuré ({line}). Déplacez le commentaire sur une ligne distincte, puis rouvrez-le."

msgid "A comment in the middle or at the end of a statement is lost in the structured editor ({trimmed}). Move the comment to a line of its own, or edit it as text."
msgstr "Un commentaire au milieu ou à la fin d'une instruction est perdu dans l'éditeur structuré ({trimmed}). Déplacez le commentaire sur une ligne distincte, ou modifiez-le sous forme de texte."

msgid "A comment inside a `curve` that spans several lines is lost in the structured editor ({trimmed}). Move the comment outside, or edit it as text."
msgstr "Un commentaire à l'intérieur d'une `curve` répartie sur plusieurs lignes est perdu dans l'éditeur structuré ({trimmed}). Déplacez le commentaire à l'extérieur, ou modifiez-le sous forme de texte."

msgid "A comment inside a statement that spans several lines is lost in the structured editor ({trimmed}). Move the comment outside the statement, or edit it as text."
msgstr "Un commentaire à l'intérieur d'une instruction répartie sur plusieurs lignes est perdu dans l'éditeur structuré ({trimmed}). Déplacez le commentaire en dehors de l'instruction, ou modifiez-la sous forme de texte."

msgid "A comment must be a single line that starts with `%%`."
msgstr "Un commentaire doit être une seule ligne commençant par `%%`."

msgid "A date cannot be written into `{other}` of `dateFormat`"
msgstr "Impossible d'écrire une date dans `{other}` de `dateFormat`"

msgid "A deactivate has no target."
msgstr "Un deactivate n'a pas de cible."

msgid "A field of 0 bits cannot be written ({statement})."
msgstr "Impossible d'écrire un champ de 0 bit ({statement})."

msgid "A frame whose name contains %% cannot be handled by the structured editor ({line})."
msgstr "Un cadre dont le nom contient %% ne peut pas être traité par l'éditeur structuré ({line})."

msgid "A group without an ID cannot have a label or a width. Give it an ID."
msgstr "Un groupe sans ID ne peut pas avoir de libellé ni de largeur. Donnez-lui un ID."

msgid "A line of the Sankey diagram has a fourth column ({}). Write only the three columns `source,target,value`."
msgstr "Une ligne du diagramme de Sankey comporte une quatrième colonne ({}). N'écrivez que les trois colonnes `source,target,value`."

msgid "A line that contains `end note` cannot be written in the text of a note ({trimmed}). Edit it as text."
msgstr "Une ligne contenant `end note` ne peut pas être écrite dans le texte d'une note ({trimmed}). Modifiez-la sous forme de texte."

msgid "A multi-line `@{{` is supported only when its first line ends with `@{{` and the lines after it are written as `key: value`."
msgstr "Un `@{{` sur plusieurs lignes n'est pris en charge que si sa première ligne se termine par `@{{` et que les lignes suivantes sont écrites sous la forme `key: value`."

msgid "A node label cannot contain line breaks."
msgstr "Le libellé d'un nœud ne peut pas contenir de sauts de ligne."

msgid "A node name cannot contain line breaks."
msgstr "Le nom d'un nœud ne peut pas contenir de sauts de ligne."

msgid "A space is needed after `:` ({trimmed})."
msgstr "Un espace est nécessaire après `:` ({trimmed})."

msgid "A statement follows `%%{{…}}%%` on the same line (line {}). Put the directive on its own line, then open it."
msgstr "Une instruction suit `%%{{…}}%%` sur la même ligne (ligne {}). Placez la directive sur une ligne distincte, puis ouvrez-le."

msgid "A statement follows `%%{{…}}%%` on the same line ({}). Put the directive and the statement on separate lines, then open the editor."
msgstr "Une instruction suit `%%{{…}}%%` sur la même ligne ({}). Placez la directive et l'instruction sur des lignes distinctes, puis ouvrez l'éditeur."

msgid "A {what} has an empty ID."
msgstr "Un élément ({what}) a un ID vide."

msgid "Aggregation (left is whole)"
msgstr "Agrégation (la gauche est le tout)"

msgid "Aggregation (right is whole)"
msgstr "Agrégation (la droite est le tout)"

msgid "Alternative (alt)"
msgstr "Alternative (alt)"

msgid "An `accTitle` after `title` becomes the diagram's title, so `title` is not used."
msgstr "Un `accTitle` placé après `title` devient le titre du diagramme : `title` n'est donc pas utilisé."

msgid "An activate has no target."
msgstr "Un activate n'a pas de cible."

msgid "An arrow has no receiver."
msgstr "Une flèche n'a pas de destinataire."

msgid "An arrow has no sender."
msgstr "Une flèche n'a pas d'expéditeur."

msgid "An empty `\"\"` after `-->` is not supported by the structured editor. Remove it, or edit it as text."
msgstr "Un `\"\"` vide après `-->` n'est pas pris en charge par l'éditeur structuré. Supprimez-le, ou modifiez-le sous forme de texte."

msgid "An empty label `[\"\"]` is not supported by the structured editor ({line}). Write a label or remove `[\"\"]`, then open it again."
msgstr "Un libellé vide `[\"\"]` n'est pas pris en charge par l'éditeur structuré ({line}). Écrivez un libellé ou supprimez `[\"\"]`, puis rouvrez-le."

msgid "An item outside any group is indented. Use “Move into the Group Above” to put it into a group."
msgstr "Un élément situé en dehors de tout groupe est indenté. Utilisez \"Déplacer dans le groupe au-dessus\" pour le placer dans un groupe."

msgid "Arrow"
msgstr "Flèche"

msgid "Association (line only)"
msgstr "Association (ligne seule)"

msgid "Association (pointing left)"
msgstr "Association (vers la gauche)"

msgid "Association (pointing right)"
msgstr "Association (vers la droite)"

msgid "At the same time (and)"
msgstr "En même temps (and)"

msgid "Automation (pcr)"
msgstr "Automatisation (pcr)"

msgid "Background (rect)"
msgstr "Arrière-plan (rect)"

msgid "Bang )) (("
msgstr "Explosion )) (("

msgid "Because of how `%%{{…}}%%` or similar is written, what the structured editor reads does not match the diagram Mermaid draws. Edit it as text."
msgstr "En raison de la façon dont `%%{{…}}%%` ou un élément similaire est écrit, ce que lit l'éditeur structuré ne correspond pas au diagramme dessiné par Mermaid. Modifiez-le sous forme de texte."

msgid "Both inline data and a data reference are written ({line}). Keep only one, then open it again."
msgstr "Des données en ligne et une référence de données sont toutes deux écrites ({line}). N'en gardez qu'une, puis rouvrez-le."

msgid "Bottom to top (BT)"
msgstr "De bas en haut (BT)"

msgid "Box (participant)"
msgstr "Boîte (participant)"

msgid "Branch `{name}` is referenced by operation {list}. Delete it first, or point it at another branch."
msgid_plural "Branch `{name}` is referenced by operations {list}. Delete them first, or point them at another branch."
msgstr[0] "La branche `{name}` est référencée par l'opération {list}. Supprimez-la d'abord, ou faites-la pointer vers une autre branche."
msgstr[1] "La branche `{name}` est référencée par les opérations {list}. Supprimez-les d'abord, ou faites-les pointer vers une autre branche."

msgid "Break (break)"
msgstr "Interruption (break)"

msgid "Cannot delete {what}, because the dates of the tasks that refer to it cannot be calculated."
msgstr "Impossible de supprimer {what}, car les dates des tâches qui y font référence ne peuvent pas être calculées."

msgid "Cannot delete {what}, because the dates of the tasks that refer to it cannot be calculated. The diagram cannot be drawn with its current content ({error}). Fix the fields outlined in red first."
msgstr "Impossible de supprimer {what}, car les dates des tâches qui y font référence ne peuvent pas être calculées. Le diagramme ne peut pas être dessiné avec son contenu actuel ({error}). Corrigez d'abord les champs encadrés en rouge."

msgid "Cannot delete {what}."
msgstr "Impossible de supprimer {what}."

msgid "Cannot delete {what}: the end of task `{task}`, which refers to it, would change. First rewrite the `after` / `until` of `{task}` as a date."
msgstr "Impossible de supprimer {what} : la fin de la tâche `{task}`, qui y fait référence, changerait. Réécrivez d'abord le `after` / `until` de `{task}` sous forme de date."

msgid "Cannot delete {what}: the end of task `{}` would have to be written as a date, which is not possible ({error})."
msgstr "Impossible de supprimer {what} : la fin de la tâche `{}` devrait être écrite sous forme de date, ce qui n'est pas possible ({error})."

msgid "Cannot delete {what}: the start of task `{task}`, which refers to it, would change. First rewrite the `after` / `until` of `{task}` as a date."
msgstr "Impossible de supprimer {what} : le début de la tâche `{task}`, qui y fait référence, changerait. Réécrivez d'abord le `after` / `until` de `{task}` sous forme de date."

msgid "Cannot delete {what}: the start of task `{}` would have to be written as a date, which is not possible ({error})."
msgstr "Impossible de supprimer {what} : le début de la tâche `{}` devrait être écrit sous forme de date, ce qui n'est pas possible ({error})."

msgid "Central connections written with `()` are not supported by the structured editor. Edit it as text."
msgstr "Les connexions centrales écrites avec `()` ne sont pas prises en charge par l'éditeur structuré. Modifiez-le sous forme de texte."

msgid "Choice (option)"
msgstr "Choix (option)"

msgid "Choice <<choice>>"
msgstr "Choix <<choice>>"

msgid "Choose the commit to cherry-pick."
msgstr "Choisissez la validation à appliquer (cherry-pick)."

msgid "Circle (( ))"
msgstr "Cercle (( ))"

msgid "Circle ((point))"
msgstr "Cercle ((point))"

msgid "Circle end"
msgstr "Extrémité en cercle"

msgid "Close a one-line `namespace` with `}}` on the same line ({statement}). Split it into several lines, or edit it as text."
msgstr "Fermez un `namespace` d'une seule ligne avec `}}` sur la même ligne ({statement}). Répartissez-le sur plusieurs lignes, ou modifiez-le sous forme de texte."

msgid "Close the arrow block in `{line}` with `]>`."
msgstr "Fermez le bloc flèche dans `{line}` avec `]>`."

msgid "Close the arrow direction in `{line}` with `)`."
msgstr "Fermez la direction de la flèche dans `{line}` avec `)`."

msgid "Cloud"
msgstr "Cloud"

msgid "Cloud ) ("
msgstr "Nuage ) ("

msgid "Command (cmd)"
msgstr "Commande (cmd)"

msgid "Comments at the end of a statement (from `#` or `%%` onward) would be lost in the structured editor ({}). Move the comment to its own line, or enclose values that contain `#` in `\"`."
msgstr "Les commentaires en fin d'instruction (à partir de `#` ou `%%`) seraient perdus dans l'éditeur structuré ({}). Déplacez le commentaire sur une ligne distincte, ou entourez de `\"` les valeurs contenant `#`."

msgid "Comments inside an attribute block would be lost in the structured editor ({statement}). Move the comment out of the block, or edit it as text."
msgstr "Les commentaires à l'intérieur d'un bloc d'attributs seraient perdus dans l'éditeur structuré ({statement}). Déplacez le commentaire hors du bloc, ou modifiez-le sous forme de texte."

msgid "Commit `{id}` is referenced by the cherry-pick at operation {list}. Delete it first."
msgid_plural "Commit `{id}` is referenced by the cherry-picks at operations {list}. Delete them first."
msgstr[0] "La validation `{id}` est référencée par le cherry-pick de l'opération {list}. Supprimez-le d'abord."
msgstr[1] "La validation `{id}` est référencée par les cherry-picks des opérations {list}. Supprimez-les d'abord."

msgid "Component diagram"
msgstr "Diagramme de composants"

msgid "Composite states are nested too deeply. Edit it as text."
msgstr "Les états composites sont imbriqués trop profondément. Modifiez-le sous forme de texte."

msgid "Composition (left is whole)"
msgstr "Composition (la gauche est le tout)"

msgid "Composition (right is whole)"
msgstr "Composition (la droite est le tout)"

msgid "Container diagram"
msgstr "Diagramme de conteneurs"

msgid "Contains (contains)"
msgstr "Contient (contains)"

msgid "Context diagram"
msgstr "Diagramme de contexte"

msgid "Copies (copies)"
msgstr "Copie (copies)"

msgid "Could not determine which item the end-of-line comment ({comment}) belongs to. Move the comment to its own line, or edit it as text."
msgstr "Impossible de déterminer à quel élément appartient le commentaire de fin de ligne ({comment}). Déplacez le commentaire sur une ligne distincte, ou modifiez-le sous forme de texte."

msgid "Could not find the details of participant `{model_id}`."
msgstr "Impossible de trouver les détails du participant `{model_id}`."

msgid "Could not find the entity on the left side of a relationship."
msgstr "Impossible de trouver l'entité du côté gauche d'une relation."

msgid "Could not find the entity on the right side of a relationship."
msgstr "Impossible de trouver l'entité du côté droit d'une relation."

msgid "Could not read `{other}` as a requirement field."
msgstr "Impossible de lire `{other}` comme champ d'exigence."

msgid "Could not read `{other}` as an element field."
msgstr "Impossible de lire `{other}` comme champ d'élément."

msgid "Could not read `{rest}` after the `)` of `{statement}`."
msgstr "Impossible de lire `{rest}` après la `)` de `{statement}`."

msgid "Could not read `{rest}` after the `class` statement ({statement})."
msgstr "Impossible de lire `{rest}` après l'instruction `class` ({statement})."

msgid "Could not read `{rest}` after the relation ({statement})."
msgstr "Impossible de lire `{rest}` après la relation ({statement})."

msgid "Could not read `{statement}` as a C4 diagram statement. Edit it as text."
msgstr "Impossible de lire `{statement}` comme instruction de diagramme C4. Modifiez-le sous forme de texte."

msgid "Could not read `{statement}` as a class assignment."
msgstr "Impossible de lire `{statement}` comme affectation de classe."

msgid "Could not read `{statement}` as a relationship."
msgstr "Impossible de lire `{statement}` comme relation."

msgid "Could not read `{statement}` as a requirement diagram statement. Edit it as text."
msgstr "Impossible de lire `{statement}` comme instruction de diagramme d'exigences. Modifiez-le sous forme de texte."

msgid "Could not read `{statement}` as an item of a block (`{opening}`)."
msgstr "Impossible de lire `{statement}` comme élément d'un bloc (`{opening}`)."

msgid "Could not read `{statement}`. A class diagram statement is one of `class A`, `A : member`, `A --> B`, `<<annotation>> A` and `note for A \"…\"`."
msgstr "Impossible de lire `{statement}`. Une instruction de diagramme de classes est l'une des suivantes : `class A`, `A : member`, `A --> B`, `<<annotation>> A` et `note for A \"…\"`."

msgid "Could not read `{trailing}` after the `\"` of `{input}`."
msgstr "Impossible de lire `{trailing}` après le `\"` de `{input}`."

msgid "Could not read `{value}` of `{name}` ({line}). {number_rule}"
msgstr "Impossible de lire `{value}` de `{name}` ({line}). {number_rule}"

msgid "Could not read `{}` after `<<annotation>> ClassName` ({statement})."
msgstr "Impossible de lire `{}` après `<<annotation>> ClassName` ({statement})."

msgid "Could not read `{}` after `]` ({statement})."
msgstr "Impossible de lire `{}` après `]` ({statement})."

msgid "Could not read `{}` after axis `{id}` ({line})."
msgstr "Impossible de lire `{}` après l'axe `{id}` ({line})."

msgid "Could not read `{}` after the note ({statement})."
msgstr "Impossible de lire `{}` après la note ({statement})."

msgid "Could not read `{}` after the quotes ({statement})."
msgstr "Impossible de lire `{}` après les guillemets ({statement})."

msgid "Could not read `{}` after the range ({statement})."
msgstr "Impossible de lire `{}` après la plage ({statement})."

msgid "Could not read `{}` as a risk."
msgstr "Impossible de lire `{}` comme risque."

msgid "Could not read `{}` as a verification method."
msgstr "Impossible de lire `{}` comme méthode de vérification."

msgid "Could not read `{}` in `{statement}`."
msgstr "Impossible de lire `{}` dans `{statement}`."

msgid "Could not read `{}` the way Mermaid does. Edit it as text."
msgstr "Impossible de lire `{}` de la même manière que Mermaid. Modifiez-le sous forme de texte."

msgid "Could not read both ends of `{statement}`."
msgstr "Impossible de lire les deux extrémités de `{statement}`."

msgid "Could not read both ends of `{}`."
msgstr "Impossible de lire les deux extrémités de `{}`."

msgid "Could not read the ID of an edge end ({statement})."
msgstr "Impossible de lire l'ID d'une extrémité d'arête ({statement})."

msgid "Could not read the ID of the junction ({statement})."
msgstr "Impossible de lire l'ID de la jonction ({statement})."

msgid "Could not read the ID of the service ({statement})."
msgstr "Impossible de lire l'ID du service ({statement})."

msgid "Could not read the alias of `{text}` (write the alias as the first argument, without `$…=`)."
msgstr "Impossible de lire l'alias de `{text}` (écrivez l'alias comme premier argument, sans `$…=`)."

msgid "Could not read the axis ID ({line})."
msgstr "Impossible de lire l'ID de l'axe ({line})."

msgid "Could not read the class name ({statement})."
msgstr "Impossible de lire le nom de classe ({statement})."

msgid "Could not read the class name `{keyword}` applies to ({statement}). Names enclosed in `` ` `` are not supported by the structured editor. Edit it as text."
msgstr "Impossible de lire le nom de classe auquel `{keyword}` s'applique ({statement}). Les noms entourés de `` ` `` ne sont pas pris en charge par l'éditeur structuré. Modifiez-le sous forme de texte."

msgid "Could not read the curve ID ({line})."
msgstr "Impossible de lire l'ID de la courbe ({line})."

msgid "Could not read the date and time"
msgstr "Impossible de lire la date et l'heure"

msgid "Could not read the end `{end}` ({statement})."
msgstr "Impossible de lire la fin `{end}` ({statement})."

msgid "Could not read the group ID ({statement})."
msgstr "Impossible de lire l'ID du groupe ({statement})."

msgid "Could not read the group ID after `in` ({statement})."
msgstr "Impossible de lire l'ID du groupe après `in` ({statement})."

msgid "Could not read the one-line `namespace` ({statement})."
msgstr "Impossible de lire le `namespace` d'une seule ligne ({statement})."

msgid "Could not read the position of a Note."
msgstr "Impossible de lire la position d'une Note."

msgid "Could not read the range `{min} --> {max}` as numbers ({statement})."
msgstr "Impossible de lire la plage `{min} --> {max}` comme des nombres ({statement})."

msgid "Could not read the start `{text}` ({statement})."
msgstr "Impossible de lire le début `{text}` ({statement})."

msgid "Could not read the target of the style assignment ({text})."
msgstr "Impossible de lire la cible de l'affectation de style ({text})."

msgid "Could not read the targets `{}` of `{keyword}`. Write IDs made of ASCII letters, digits, `_` and `-`, separated by spaces."
msgstr "Impossible de lire les cibles `{}` de `{keyword}`. Écrivez des ID composés de lettres ASCII, de chiffres, de `_` et de `-`, séparés par des espaces."

msgid "Could not read the task fields `{}` ({statement}). Of `tags, ID, start, end`, write 1 to 3 fields, not counting the tags."
msgstr "Impossible de lire les champs de tâche `{}` ({statement}). Parmi `tags, ID, start, end`, écrivez de 1 à 3 champs, sans compter les étiquettes."

msgid "Could not read the value `{entry}` of curve `{curve}` ({line}). {number_rule}"
msgstr "Impossible de lire la valeur `{entry}` de la courbe `{curve}` ({line}). {number_rule}"

msgid "Could not read the x-axis ticks ({statement})."
msgstr "Impossible de lire les graduations de l'axe X ({statement})."

msgid "Could not read the y-axis range ({statement}). Write it as `0 --> 100`."
msgstr "Impossible de lire la plage de l'axe Y ({statement}). Écrivez-la sous la forme `0 --> 100`."

msgid "Could not read this as a Gantt chart line ({statement}). Write it as `task name :start, end`."
msgstr "Impossible de lire ceci comme une ligne de diagramme de Gantt ({statement}). Écrivez-la sous la forme `task name :start, end`."

msgid "Could not read this as a kanban node ({node_part}). Edit it as text."
msgstr "Impossible de lire ceci comme un nœud kanban ({node_part}). Modifiez-le sous forme de texte."

msgid "Could not read this as a radar chart statement ({trimmed}). Edit it as text."
msgstr "Impossible de lire ceci comme une instruction de graphique radar ({trimmed}). Modifiez-le sous forme de texte."

msgid "Could not read this as a style assignment ({text})."
msgstr "Impossible de lire ceci comme une affectation de style ({text})."

msgid "Could not read this as an XY chart statement ({statement}). Edit it as text."
msgstr "Impossible de lire ceci comme une instruction de graphique XY ({statement}). Modifiez-le sous forme de texte."

msgid "Cross end"
msgstr "Extrémité en croix"

msgid "Curve `{id}` mixes values with and without axis names ({line})."
msgstr "La courbe `{id}` mélange des valeurs avec et sans noms d'axes ({line})."

msgid "Curve `{}` has a value for `{axis}`, but there is no such axis ({line}). Mermaid does not draw this value, so remove it or add the axis, then open it again."
msgstr "La courbe `{}` a une valeur pour `{axis}`, mais cet axe n'existe pas ({line}). Mermaid ne dessine pas cette valeur : supprimez-la ou ajoutez l'axe, puis rouvrez-le."

msgid "Curve `{}` has no value for axis `{}` ({line})."
msgstr "La courbe `{}` n'a pas de valeur pour l'axe `{}` ({line})."

msgid "Curve `{}` has no values. Write at least one value (Mermaid does not accept an empty curve)."
msgstr "La courbe `{}` n'a aucune valeur. Écrivez au moins une valeur (Mermaid n'accepte pas de courbe vide)."

msgid "Curve `{}` has two values for axis `{axis}` ({line}). Mermaid draws only the first one, so keep one, then open it again."
msgstr "La courbe `{}` a deux valeurs pour l'axe `{axis}` ({line}). Mermaid ne dessine que la première : n'en gardez qu'une, puis rouvrez-le."

msgid "Curve `{}` writes its values with axis names, but there are no axes."
msgstr "La courbe `{}` écrit ses valeurs avec des noms d'axes, mais il n'y a aucun axe."

msgid "Curve `{}` writes its values with axis names, so every axis needs a value."
msgstr "La courbe `{}` écrit ses valeurs avec des noms d'axes : chaque axe doit donc avoir une valeur."

msgid "Curve `{}`: value {} is empty. Values in the middle cannot be empty (empty cells at the end count as no value)."
msgstr "Courbe `{}` : la valeur {} est vide. Les valeurs intermédiaires ne peuvent pas être vides (les cellules vides à la fin comptent comme absence de valeur)."

msgid "Cylinder [( )]"
msgstr "Cylindre [( )]"

msgid "Dashed (line only)"
msgstr "Tirets (ligne seule)"

msgid "Data `{name}` cannot be handled by the structured editor. Start it with the line `data {name} {{` and end it with a line that is only `}}` at the start (Mermaid does not accept a one-line block)."
msgstr "Les données `{name}` ne peuvent pas être traitées par l'éditeur structuré. Commencez-les par la ligne `data {name} {{` et terminez-les par une ligne ne contenant que `}}` en début de ligne (Mermaid n'accepte pas de bloc d'une seule ligne)."

msgid "Data `{name}` has no contents."
msgstr "Les données `{name}` n'ont aucun contenu."

msgid "Database"
msgstr "Base de données"

msgid "Database [(store)]"
msgstr "Base de données [(stockage)]"

msgid "Dependency (pointing left)"
msgstr "Dépendance (vers la gauche)"

msgid "Dependency (pointing right)"
