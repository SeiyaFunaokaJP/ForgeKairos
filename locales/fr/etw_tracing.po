msgid "Cancelling ETW recording..."
msgstr "Annulation de l'enregistrement ETW..."

msgid "ETW recording cancelled"
msgstr "Enregistrement ETW annulé"

msgid "ETW recording ended unexpectedly"
msgstr "L'enregistrement ETW s'est arrêté de manière inattendue"

msgid "ETW recording failed: {message}"
msgstr "Échec de l'enregistrement ETW : {message}"

msgid "ETW recording is already in progress"
