msgstr "\"{label}\" : le `type` \"{kind}\" n'est pas pris en charge. Utilisez `stdio`, `http` ou `sse`."

msgid "\"{label}\": `type` must be a string."
msgstr "\"{label}\" : `type` doit être une chaîne."

msgid "\"{label}\": `url` is not set."
msgstr "\"{label}\" : `url` n'est pas défini."

msgid "\"{label}\": `{key}` must be a URL string."
msgstr "\"{label}\" : `{key}` doit être une chaîne d'URL."

