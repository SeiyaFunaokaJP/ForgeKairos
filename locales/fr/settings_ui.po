msgstr "\"{label}\" : `command` est vide."

msgid "\"{label}\": `command` must be a string."
msgstr "\"{label}\" : `command` doit être une chaîne."

msgid "\"{label}\": `enabled` must be true or false."
msgstr "\"{label}\" : `enabled` doit valoir true ou false."

msgid "\"{label}\": `oauth` must look like {{ \"client_id\": \"…\" }}."
msgstr "\"{label}\" : `oauth` doit avoir la forme {{ \"client_id\": \"…\" }}."

msgid "\"{label}\": `remote` must be true or false."
msgstr "\"{label}\" : `remote` doit valoir true ou false."

msgid "\"{label}\": `timeout` must be a positive whole number of seconds."
msgstr "\"{label}\" : `timeout` doit être un nombre entier positif de secondes."

