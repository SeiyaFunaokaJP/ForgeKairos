msgid ""
msgstr ""
"Language: fr\n"
"X-Language-Name: Français\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Auto-updates disabled for non-bundled app."
msgstr "Mises à jour automatiques désactivées pour une application non empaquetée."

msgid "Could not auto-update because the required rsync utility was not found."
msgstr "Impossible d'effectuer la mise à jour automatique, car l'utilitaire rsync requis est introuvable."

msgid "Could not check for updates"
msgstr "Impossible de rechercher des mises à jour"

msgid "Couldn't add the hosts to the allowlist: {error}"
msgstr "Impossible d'ajouter les hôtes à la liste d'autorisation : {error}"

msgid "Couldn't check for updates: GitHub answered with HTTP status {status}."
msgstr "Impossible de rechercher des mises à jour : GitHub a répondu avec le statut HTTP {status}."

msgid "Couldn't check for updates: GitHub could not be reached ({error})."
msgstr "Impossible de rechercher des mises à jour : GitHub est injoignable ({error})."

msgid "Couldn't check for updates: GitHub has no release list for {repository}. The repository may be private or not published yet."
msgstr "Impossible de rechercher des mises à jour : GitHub ne dispose d'aucune liste de versions pour {repository}. Le dépôt est peut-être privé ou pas encore publié."

msgid "Couldn't check for updates: GitHub's limit for requests without signing in was reached. Try again in {count} minute."
msgid_plural "Couldn't check for updates: GitHub's limit for requests without signing in was reached. Try again in {count} minutes."
msgstr[0] "Impossible de rechercher des mises à jour : la limite de GitHub pour les requêtes sans connexion a été atteinte. Réessayez dans {count} minute."
msgstr[1] "Impossible de rechercher des mises à jour : la limite de GitHub pour les requêtes sans connexion a été atteinte. Réessayez dans {count} minutes."

msgid "Couldn't check for updates: GitHub's limit for requests without signing in was reached. Try again later."
msgstr "Impossible de rechercher des mises à jour : la limite de GitHub pour les requêtes sans connexion a été atteinte. Réessayez plus tard."

msgid "Couldn't check for updates: GitHub's release list was not in the expected format."
msgstr "Impossible de rechercher des mises à jour : la liste des versions de GitHub n'était pas au format attendu."

msgid "Downloading remote server"
msgstr "Téléchargement du serveur distant"

msgid "Fetching remote server release"
msgstr "Récupération de la version du serveur distant"

msgid "Install it with: sudo apt install rsync"
msgstr "Installez-le avec : sudo apt install rsync"

msgid "Install it with: sudo dnf install rsync"
msgstr "Installez-le avec : sudo dnf install rsync"

msgid "Install it with: sudo pacman -S rsync"
msgstr "Installez-le avec : sudo pacman -S rsync"

msgid "Install pkgs.rsync from nixpkgs"
msgstr "Installez pkgs.rsync depuis nixpkgs"

msgid "Please install rsync using your package manager"
msgstr "Installez rsync avec votre gestionnaire de paquets"

msgid "Zed was installed via a package manager."
msgstr "ForgeKairos a été installé via un gestionnaire de paquets."

msgid "rsync is required for auto-updates but is not installed. {install_hint}"
msgstr "rsync est nécessaire aux mises à jour automatiques, mais n'est pas installé. {install_hint}"
