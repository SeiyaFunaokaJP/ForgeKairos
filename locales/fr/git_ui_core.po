msgstr "L'arborescence de travail \"{display_name}\" contient des fichiers modifiés ou non suivis. Forcer sa suppression ?"

msgid "Worktree creation is not supported in collaborative projects"
msgstr "La création d'arborescences de travail n'est pas prise en charge dans les projets collaboratifs"

msgid "You may need to configure git for Github."
msgstr "Vous devrez peut-être configurer git pour GitHub."

msgid "current branches"
msgstr "branches actuelles"

msgid "git fetch failed for {}"
msgstr "Échec de git fetch pour {}"

msgid "git {} failed"
msgstr "Échec de git {}"
