msgid "Create"
msgstr "Créer"

msgid "Create \"{name}\" based on {branch_label}"
msgstr "Créer \"{name}\" à partir de {branch_label}"

msgid "Create new worktree based on {branch_label}"
msgstr "Créer une nouvelle arborescence de travail basée sur {branch_label}"

msgid "Delete"
msgstr "Supprimer"

msgid "Delete Worktree"
msgstr "Supprimer l'arborescence de travail"

msgid "Deleting…"
msgstr "Suppression…"

msgid "Failed to connect"
msgstr "Échec de la connexion"

msgid "Force Delete"
msgstr "Forcer la suppression"

msgid "Force Delete Worktree"
msgstr "Forcer la suppression de l'arborescence de travail"

msgid "Hold {} to force delete"
msgstr "Maintenez {} pour forcer la suppression"

msgid "Learn more"
msgstr "En savoir plus"

msgid "Open"
msgstr "Ouvrir"

msgid "Open in New Window"
msgstr "Ouvrir dans une nouvelle fenêtre"

