msgid "block-beta\n    %% columns sets the number of columns, space is an empty cell and --> an arrow\n    columns 3\n    input[\"Input\"] process[\"Process\"] output[\"Output\"]\n    space log[\"Log\"] space\n    input --> process\n    process --> output\n    process --> log"
msgstr "block-beta\n    %% columns définit le nombre de colonnes, space est une cellule vide et --> une flèche\n    columns 3\n    input[\"Entrée\"] process[\"Traitement\"] output[\"Sortie\"]\n    space log[\"Journal\"] space\n    input --> process\n    process --> output\n    process --> log"

msgid "classDiagram\n    %% <|-- is inheritance, *-- composition and o-- aggregation\n    class Base {{\n        +field: Type\n        +method()\n    }}\n    class Derived {{\n        +extra()\n    }}\n    Base <|-- Derived"
