msgid "packet-beta\n    %% start bit-end bit: \"Field name\"\n    title UDP Header\n    0-15: \"Source Port\"\n    16-31: \"Destination Port\"\n    32-47: \"Length\"\n    48-63: \"Checksum\"\n    64-95: \"Data (variable length)\""
msgstr "packet-beta\n    %% bit de début-bit de fin: \"Nom du champ\"\n    title En-tête UDP\n    0-15: \"Port source\"\n    16-31: \"Port de destination\"\n    32-47: \"Longueur\"\n    48-63: \"Somme de contrôle\"\n    64-95: \"Données (longueur variable)\""

