msgid "journey\n    %% Task : Satisfaction (1 to 5) : People involved\n    title Path to Purchase\n    section Find\n      Search for a product: 4: Customer\n      Compare: 3: Customer\n    section Buy\n      Add to cart: 5: Customer\n      Pay: 2: Customer, Store"
msgstr "journey\n    %% Tâche : Satisfaction (1 à 5) : Personnes concernées\n    title Parcours d'achat\n    section Trouver\n      Rechercher un produit: 4: Client\n      Comparer: 3: Client\n    section Acheter\n      Ajouter au panier: 5: Client\n      Payer: 2: Client, Boutique"

msgid "kanban\n    %% Less indented lines are columns and more indented lines cards\n    todo[To Do]\n        spec[Write the spec]\n        screen[Build the screen]\n    doing[In Progress]\n        api[Build the API]\n    done[Done]\n        setup[Set up the environment]"
msgstr "kanban\n    %% Les lignes moins indentées sont des colonnes et les plus indentées des cartes\n    todo[À faire]\n        spec[Rédiger la spécification]\n        screen[Créer les écrans]\n    doing[En cours]\n        api[Créer les API]\n    done[Terminé]\n        setup[Préparer le poste de travail]"

