msgstr "récursif"

msgid "requirementDiagram\n    %% requirement declares a requirement; element declares what satisfies it. Connect them with - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Users can log in\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Screen\"\n    }}\n    login_page - satisfies -> login"
msgstr "requirementDiagram\n    %% requirement déclare une exigence ; element déclare ce qui la satisfait. Reliez-les avec - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Les utilisateurs peuvent se connecter\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Écran\"\n    }}\n    login_page - satisfies -> login"

msgid "sankey-beta\n    %% Each line is source,target,amount. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"
msgstr "sankey-beta\n    %% Chaque ligne s'écrit source,cible,quantité. Écrivez les noms en lettres et chiffres ASCII (Mermaid ne sait pas lire les noms non ASCII)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"

msgid "sequenceDiagram\n    %% ->> is a call and -->> a reply\n    participant User as User\n    participant App as App\n    User->>App: Request\n    App-->>User: Response\n    Note over App: Note"
msgstr "sequenceDiagram\n    %% ->> est un appel et -->> une réponse\n    participant User as Utilisateur\n    participant App as Application\n    User->>App: Requête\n    App-->>User: Réponse\n    Note over App: Remarque"

msgid "stateDiagram-v2\n    %% [*] is the start and the end. The text after : on an arrow is the event name\n    [*] --> Idle\n    Idle --> Running: Start\n    Running --> Idle: Finish\n    Running --> [*]: Abort"
msgstr "stateDiagram-v2\n    %% [*] est le début et la fin. Le texte après : sur une flèche est le nom de l'événement\n    [*] --> Idle\n    Idle --> Running: Démarrer\n    Running --> Idle: Terminer\n    Running --> [*]: Abandonner"

msgid "the latest version"
msgstr "la dernière version"

msgid "timeline\n    title History\n    2024 : Planning\n    2025 : Development : Release\n    2026 : Operation"
msgstr "timeline\n    title Historique\n    2024 : Planification\n    2025 : Développement : Publication\n    2026 : Exploitation"

msgid "treeView-beta\n    %% Indentation shows the hierarchy\n    \"Project\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""
msgstr "treeView-beta\n    %% L'indentation indique la hiérarchie\n    \"Projet\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""

msgid "treemap-beta\n    %% Indentation nests items. Give each leaf a value after :\n    \"Development\"\n        \"Design\": 30\n        \"Implementation\": 50\n    \"Operations\"\n        \"Maintenance\": 15\n        \"Monitoring\": 5"
msgstr "treemap-beta\n    %% L'indentation imbrique les éléments. Donnez une valeur à chaque feuille après :\n    \"Développement\"\n        \"Conception\": 30\n        \"Implémentation\": 50\n    \"Exploitation\"\n        \"Maintenance\": 15\n        \"Surveillance\": 5"

msgid "type named by the language server"
msgstr "type nommé par le serveur de langage"

msgid "venn-beta\n    %% set defines a set and union names an overlap\n    title Overlapping Responsibilities\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"
msgstr "venn-beta\n    %% set définit un ensemble et union nomme un chevauchement\n    title Responsabilités qui se chevauchent\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"

msgid "xychart-beta\n    %% bar draws bars and line a line. Give as many values as the x-axis has items\n    title \"Monthly Sales\"\n    x-axis [\"Jan\", \"Feb\", \"Mar\", \"Apr\"]\n    y-axis \"Sales (USD thousands)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"
msgstr "xychart-beta\n    %% bar dessine des barres et line une ligne. Donnez autant de valeurs que l'axe x compte d'éléments\n    title \"Ventes mensuelles\"\n    x-axis [\"janv.\", \"févr.\", \"mars\", \"avr.\"]\n    y-axis \"Ventes (milliers USD)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"

