msgid "quadrantChart\n    %% A point is Name: [x, y], both from 0 to 1\n    title Initiative Priorities\n    x-axis Low Effort --> High Effort\n    y-axis Low Impact --> High Impact\n    quadrant-1 Plan and Do\n    quadrant-2 Do Now\n    quadrant-3 Do Later\n    quadrant-4 Reconsider\n    Initiative A: [0.3, 0.8]\n    Initiative B: [0.7, 0.6]\n    Initiative C: [0.2, 0.3]"
msgstr "quadrantChart\n    %% Un point s'écrit Nom: [x, y], les deux entre 0 et 1\n    title Priorités des initiatives\n    x-axis Effort faible --> Effort élevé\n    y-axis Impact faible --> Impact élevé\n    quadrant-1 Planifier et faire\n    quadrant-2 Faire maintenant\n    quadrant-3 Faire plus tard\n    quadrant-4 Reconsidérer\n    Initiative A: [0.3, 0.8]\n    Initiative B: [0.7, 0.6]\n    Initiative C: [0.2, 0.3]"

msgid "radar-beta\n    %% axis defines the axes and curve a series. List the values in the order of the axes\n    title Skill Comparison\n    axis design[\"Design\"], build[\"Implementation\"], test[\"Testing\"], ops[\"Operations\"]\n    curve a[\"Person A\"]{{4, 3, 5, 2}}\n    curve b[\"Person B\"]{{2, 5, 3, 4}}\n    max 5"
msgstr "radar-beta\n    %% axis définit les axes et curve une série. Listez les valeurs dans l'ordre des axes\n    title Comparaison des compétences\n    axis design[\"Conception\"], build[\"Implémentation\"], test[\"Tests\"], ops[\"Exploitation\"]\n    curve a[\"Personne A\"]{{4, 3, 5, 2}}\n    curve b[\"Personne B\"]{{2, 5, 3, 4}}\n    max 5"

