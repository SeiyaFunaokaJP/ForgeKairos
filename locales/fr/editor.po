msgid "eventmodeling\n    %% tf number type name. ui is a screen, cmd a command, evt an event and rmo a read model. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"
msgstr "eventmodeling\n    %% tf numéro type nom. ui est un écran, cmd une commande, evt un événement et rmo un modèle de lecture. Écrivez les noms en lettres et chiffres ASCII (Mermaid ne sait pas lire les noms non ASCII)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"

msgid "flowchart TD\n    %% [] is a step and {{}} a decision. |label| annotates a branch\n    start[Start] --> condition{{Condition}}\n    condition -->|Yes| work[Process]\n    condition -->|No| finish[End]\n    work --> finish"
msgstr "flowchart TD\n    %% [] est une étape et {{}} une décision. |libellé| annote une branche\n    start[Début] --> condition{{Condition}}\n    condition -->|Oui| work[Traitement]\n    condition -->|Non| finish[Fin]\n    work --> finish"

