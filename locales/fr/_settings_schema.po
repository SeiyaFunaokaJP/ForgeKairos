# The descriptions of the settings file's JSON schema, keyed by their English text.
#
# Entries that zed-i18n also translates started from its fr-FR translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: fr\n"
"X-Language-Name: Français\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgctxt "settings schema"
msgid "A block that surrounds the following character"
msgstr "Un bloc entourant le caractère suivant"

msgctxt "settings schema"
msgid "A box drawn around the following character"
msgstr "Un rectangle dessiné autour du caractère suivant"

msgctxt "settings schema"
msgid "A capability for an extension."
msgstr "Une capacité accordée à une extension."

msgctxt "settings schema"
msgid "A custom Git hosting provider."
msgstr "Un fournisseur d'hébergement Git personnalisé."

msgctxt "settings schema"
msgid "A custom line height, where 1.0 is the font's height. Must be at least 1.0."
msgstr "Une hauteur de ligne personnalisée, où 1.0 correspond à la hauteur de la police. Doit être au moins 1.0."

msgctxt "settings schema"
msgid "A custom offset in milliseconds for the tooltip show delay."
msgstr "Un délai personnalisé en millisecondes avant l'affichage de l'info-bulle."

msgctxt "settings schema"
msgid "A denser UI with tighter spacing and smaller elements."
msgstr "Une interface plus dense avec un espacement réduit et des éléments plus petits."

msgctxt "settings schema"
msgid "A dynamic icon theme selection, which can change based on the [`ThemeMode`]."
msgstr "Une sélection de thème d'icônes dynamique, susceptible de changer en fonction du [`ThemeMode`]."

msgctxt "settings schema"
msgid "A dynamic theme selection, which can change based the [ThemeMode]."
msgstr "Une sélection de thème dynamique, susceptible de changer en fonction du [ThemeMode]."

msgctxt "settings schema"
msgid "A fixed pixel width for the git diff indicators."
msgstr "Une largeur fixe en pixels pour les indicateurs de différences Git."

msgctxt "settings schema"
msgid "A font size value in pixels, wrapping around `f32` for custom settings UI rendering."
msgstr "Une valeur de taille de police en pixels, encapsulant `f32` pour le rendu de l'interface des paramètres personnalisés."

msgctxt "settings schema"
msgid "A git account a repository can commit and push as."
msgstr "Un compte Git avec lequel un dépôt peut valider et envoyer."

msgctxt "settings schema"
msgid "A less dense line height."
msgstr "Une hauteur de ligne moins dense."

msgctxt "settings schema"
msgid "A looser UI with more spacing and larger elements."
msgstr "Une interface plus aérée avec davantage d'espacement et des éléments plus grands."

msgctxt "settings schema"
msgid "A map of log scopes to the desired log level.\nUseful for filtering out noisy logs or enabling more verbose logging.\n\nExample: {\"log\": {\"client\": \"warn\"}}"
msgstr "Une table associant des portées de journalisation au niveau de journalisation souhaité. Utile pour filtrer les journaux trop bavards ou activer une journalisation plus détaillée.\n\nExemple : {\"log\": {\"client\": \"warn\"}}"

msgctxt "settings schema"
msgid "A model `name` to substitute when calling tools, in case the primary model doesn't support tool calling."
msgstr "Nom `name` d'un modèle de substitution lors des appels d'outils, au cas où le modèle principal ne prendrait pas en charge les appels d'outils."

msgctxt "settings schema"
msgid "A named settings profile that can temporarily override settings."
msgstr "Un profil de paramètres nommé permettant de remplacer temporairement les paramètres."

msgctxt "settings schema"
msgid "A non-negative size in pixels.\n\nValid range: 0.0 and up"
msgstr "Une taille positive ou nulle en pixels.\n\nPlage valide : 0.0 et plus"

msgctxt "settings schema"
msgid "A panel the default dock layout can name."
msgstr "Un panneau que la disposition par défaut des docks peut désigner."

msgctxt "settings schema"
msgid "A static icon theme selection, represented by a single icon theme name."
msgstr "Une sélection de thème d'icônes statique, représentée par un seul nom de thème d'icônes."

msgctxt "settings schema"
msgid "A static theme selection, represented by a single theme name."
msgstr "Une sélection de thème statique, représentée par un seul nom de thème."

msgctxt "settings schema"
msgid "A value of `ui_language`, its own type so the settings UI can offer the\nlanguages found at run time instead of a text field."
msgstr "Une valeur de `ui_language`, de type propre afin que l'interface des paramètres puisse proposer les langues trouvées à l'exécution au lieu d'un champ de texte."

msgctxt "settings schema"
msgid "A vertical bar"
msgstr "Une barre verticale"

msgctxt "settings schema"
msgid "AI providers whose \"your input may be retained and used for training\"\nwarning the user has explicitly acknowledged. The settings UI refuses to\ntake an API key for, or sign in to, an external provider that is not\nlisted here.\n\nEntries are provider ids. Agent (LLM) providers use their own ids\n(`anthropic`, `openai`, `zed.dev`, ...);\nedit prediction providers are prefixed to keep the two surfaces\nindependent (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nDefault: []"
msgstr "Les fournisseurs d'IA dont l'utilisateur a explicitement accepté l'avertissement \"vos saisies peuvent être conservées et utilisées pour l'entraînement\". L'interface des paramètres refuse d'accepter une clé API ou une connexion pour un fournisseur externe qui ne figure pas ici.\n\nLes entrées sont des ID de fournisseurs. Les fournisseurs d'agent (LLM) utilisent leurs propres ID (`anthropic`, `openai`, `zed.dev`, ...) ; les fournisseurs de prédiction de modification ont un préfixe pour que les deux surfaces restent indépendantes (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Activates the python virtual environment, if one is found, in the\nterminal's working directory (as resolved by the working_directory\nsetting). Set this to \"off\" to disable this behavior.\n\nDefault: on"
msgstr "Active l'environnement virtuel Python, s'il en existe un, dans le répertoire de travail du terminal (tel que résolu par le paramètre working_directory). Définissez cette valeur sur \"off\" pour désactiver ce comportement.\n\nValeur par défaut : on"

msgctxt "settings schema"
msgid "Active pane styling settings."
msgstr "Paramètres de style du volet actif."

msgctxt "settings schema"
msgid "Added version control color."
msgstr "Couleur de contrôle de version pour les ajouts."

msgctxt "settings schema"
msgid "Additional environment variables to pass to the agent.\n\nDefault: {}"
msgstr "Variables d'environnement supplémentaires à transmettre à l'agent.\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "Additional models with which to generate alternatives when performing inline assists."
msgstr "Modèles supplémentaires utilisés pour générer des variantes lors des assistances inline."

msgctxt "settings schema"
msgid "Additional parameters for language model requests. When making a request\nto a model, parameters will be taken from the last entry in this list\nthat matches the model's provider and name. In each entry, both provider\nand model are optional, so that you can specify parameters for either\none.\n\nDefault: []"
msgstr "Paramètres supplémentaires pour les requêtes aux modèles de langage. Lors d'une requête à un modèle, les paramètres sont pris dans la dernière entrée de cette liste qui correspond au fournisseur et au nom du modèle. Dans chaque entrée, le fournisseur et le modèle sont tous deux facultatifs, ce qui permet de spécifier des paramètres pour l'un ou l'autre.\n\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Adjusts indentation based on syntax context when typing.\nUses tree-sitter to analyze code structure and indent accordingly."
msgstr "Ajuste l'indentation selon le contexte syntaxique pendant la saisie. Utilise tree-sitter pour analyser la structure du code et indenter en conséquence."

msgctxt "settings schema"
msgid "Aliases for the command palette. When you type a key in this map,\nit will be assumed to equal the value.\n\nDefault: {}"
msgstr "Alias pour la palette de commandes. Lorsque vous saisissez une clé de cette table, elle est considérée comme égale à sa valeur.\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "Allow Zed to collect training data from open-source projects."
msgstr "Autoriser Zed à collecter des données d'entraînement depuis des projets open source."

msgctxt "settings schema"
msgid "Allow rewrapping anywhere."
msgstr "Autorise le renvoi à la ligne n'importe où."

msgctxt "settings schema"
msgid "Allow sending requests to Anthropic models that cannot be offered with\nZero Data Retention.\n\nDefault: false"
msgstr "Autorise l'envoi de requêtes aux modèles Anthropic qui ne peuvent pas être proposés avec Zero Data Retention.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Allows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\nPrettier formatting is disabled by default."
msgstr "Permet d'activer ou de désactiver la mise en forme avec Prettier et de configurer le Prettier par défaut, utilisé lorsqu'aucune installation de Prettier n'est trouvée au niveau du projet. La mise en forme avec Prettier est désactivée par défaut."

msgctxt "settings schema"
msgid "Always blink the cursor, ignoring the terminal mode."
msgstr "Fait toujours clignoter le curseur, quel que soit le mode du terminal."

msgctxt "settings schema"
msgid "Always fetch document's words for completions along with LSP completions."
msgstr "Récupère toujours les mots du document pour les complétions, en plus des complétions LSP."

msgctxt "settings schema"
msgid "Always index the worktree."
msgstr "Indexe toujours l'arborescence de travail."

msgctxt "settings schema"
msgid "Always populate the search query with the word under the cursor."
msgstr "Renseigne toujours la requête de recherche avec le mot sous le curseur."

msgctxt "settings schema"
msgid "Always prompt for confirmation (default behavior)."
msgstr "Toujours demander une confirmation (comportement par défaut)."

msgctxt "settings schema"
msgid "Always reduce motion"
msgstr "Réduit toujours les animations"

msgctxt "settings schema"
msgid "Always scan symlinked directories"
msgstr "Analyse toujours les répertoires liés symboliquement"

msgctxt "settings schema"
msgid "Always show the minimap thumb."
msgstr "Affiche toujours le curseur de la minicarte."

msgctxt "settings schema"
msgid "Always show the minimap."
msgstr "Affiche toujours la minicarte."

msgctxt "settings schema"
msgid "Always show the scrollbar."
msgstr "Affiche toujours la barre de défilement."

msgctxt "settings schema"
msgid "Always show the sidebar on the left side."
msgstr "Affiche toujours la barre latérale à gauche."

msgctxt "settings schema"
msgid "Always show the sidebar on the right side."
msgstr "Affiche toujours la barre latérale à droite."

msgctxt "settings schema"
msgid "Always start with an empty editor tab"
msgstr "Démarre toujours avec un onglet d'éditeur vide"

msgctxt "settings schema"
msgid "Always use a specific directory. This value will be shell expanded.\nIf this path is not a valid directory the terminal will default to\nthis platform's home directory  (if it can be found)."
msgstr "Utilise toujours un répertoire précis. Cette valeur est développée par le shell. Si ce chemin n'est pas un répertoire valide, le terminal utilise par défaut le répertoire personnel de la plateforme (s'il est trouvé)."

msgctxt "settings schema"
msgid "Always use this platform's home directory (if it can be found)."
msgstr "Utilise toujours le répertoire personnel de cette plateforme (s'il peut être trouvé)."

msgctxt "settings schema"
msgid "Amount of indentation (in pixels) for nested items.\n\nDefault: 20"
msgstr "Taille de l'indentation (en pixels) des éléments imbriqués.\n\nValeur par défaut : 20"

msgctxt "settings schema"
msgid "An optional string to override the title of the terminal tab"
msgstr "Une chaîne optionnelle pour remplacer le titre de l'onglet du terminal"

msgctxt "settings schema"
msgid "An underline that runs along the following character"
msgstr "Un soulignement qui s'étend le long du caractère suivant"

msgctxt "settings schema"
msgid "Any extra beta headers to provide when using the model."
msgstr "En-têtes bêta supplémentaires à fournir lors de l'utilisation du modèle."

msgctxt "settings schema"
msgid "Any key-value pairs added to this list will be added to the terminal's\nenvironment. Use `:` to separate multiple values.\n\nDefault: {}"
msgstr "Toutes les paires clé-valeur ajoutées à cette liste sont ajoutées à l'environnement du terminal. Utilisez `:` pour séparer plusieurs valeurs.\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"\""
msgstr "URL de l'API à utiliser pour les complétions.\n\nValeur par défaut : \"\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"http://localhost:11434\""
msgstr "URL de l'API à utiliser pour les complétions.\n\nValeur par défaut : \"http://localhost:11434\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"https://codestral.mistral.ai\""
msgstr "URL de l'API à utiliser pour les complétions.\n\nValeur par défaut : \"https://codestral.mistral.ai\""

msgctxt "settings schema"
msgid "Apply profile settings on top of Zed's default settings, ignoring user customizations."
msgstr "Applique les paramètres du profil par-dessus les paramètres par défaut de ForgeKairos, en ignorant les personnalisations de l'utilisateur."

msgctxt "settings schema"
msgid "Apply profile settings on top of the user's current settings."
msgstr "Applique les paramètres du profil par-dessus les paramètres actuels de l'utilisateur."

msgctxt "settings schema"
msgid "Ask a separate, cheap language model whether the operation is dangerous,\nand auto-approve it only when that model answers that it is safe.\nEvery rule that outranks the default — the built-in security\nrules and the user's `always_deny`/`always_confirm`/`always_allow`\npatterns — is applied first, so this only replaces the \"ask every time\"\nstep."
msgstr "Demande à un modèle de langage distinct et peu coûteux si l'opération est dangereuse, et ne l'approuve automatiquement que lorsque ce modèle répond qu'elle est sûre. Toutes les règles prioritaires sur la valeur par défaut (les règles de sécurité intégrées et les motifs `always_deny`/`always_confirm`/`always_allow` de l'utilisateur) sont appliquées en premier ; cette option ne remplace donc que l'étape \"demander à chaque fois\"."

msgctxt "settings schema"
msgid "Auto-approve without prompting."
msgstr "Approuver automatiquement sans demande de confirmation."

msgctxt "settings schema"
msgid "Auto-reject with an error."
msgstr "Rejeter automatiquement avec une erreur."

msgctxt "settings schema"
msgid "Automatically detect the conda manager"
msgstr "Détecter automatiquement le gestionnaire conda"

msgctxt "settings schema"
msgid "Autosave when focus changes."
msgstr "Enregistrement automatique lors du changement de focus."

msgctxt "settings schema"
msgid "Autosave when the active window changes."
msgstr "Enregistrement automatique lors du changement de fenêtre active."

msgctxt "settings schema"
msgid "Background Color. Used for grounded surfaces like a panel or tab."
msgstr "Couleur d'arrière-plan. Utilisée pour les surfaces de base comme un panneau ou un onglet."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of a ghost element that should have the same background as the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état actif d'un élément fantôme qui doit avoir le même arrière-plan que la surface sur laquelle il se trouve.\n\nL'état actif est déclenché lorsque le bouton de la souris est enfoncé sur un élément, ou lorsque la touche Return ou un autre activateur est pressé."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of an element that should have a different background than the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état actif d'un élément qui doit avoir un arrière-plan différent de celui de la surface sur laquelle il se trouve.\n\nL'état actif est déclenché lorsque le bouton de la souris est enfoncé sur un élément, ou lorsque la touche Return ou un autre activateur est pressé."

msgctxt "settings schema"
msgid "Background Color. Used for the app background and blank panels or windows."
msgstr "Couleur d'arrière-plan. Utilisée pour l'arrière-plan de l'application et les panneaux ou fenêtres vides."

msgctxt "settings schema"
msgid "Background Color. Used for the area that shows where a dragged element will be dropped."
msgstr "Couleur d'arrière-plan. Utilisée pour la zone indiquant où un élément glissé sera déposé."

msgctxt "settings schema"
msgid "Background Color. Used for the background of an element that should have a different background than the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have the same background as the surface it's on, use `ghost_element_background`."
msgstr "Couleur d'arrière-plan. Utilisée pour l'arrière-plan d'un élément qui doit avoir un arrière-plan différent de celui de la surface sur laquelle il se trouve.\n\nLes éléments peuvent être : boutons, champs de saisie, cases à cocher, boutons radio...\n\nPour un élément qui doit avoir le même arrière-plan que la surface sur laquelle il se trouve, utilisez `ghost_element_background`."

msgctxt "settings schema"
msgid "Background Color. Used for the background of selections in a UI element."
msgstr "Couleur d'arrière-plan. Utilisée pour l'arrière-plan des sélections dans un élément d'interface."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of a ghost element that should have the same background as the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état désactivé d'un élément fantôme qui doit avoir le même arrière-plan que la surface sur laquelle il se trouve.\n\nL'état désactivé est affiché lorsque l'utilisateur ne peut pas interagir avec un élément, comme un bouton ou un champ de saisie désactivé."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of an element that should have a different background than the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état désactivé d'un élément qui doit avoir un arrière-plan différent de celui de la surface sur laquelle il se trouve.\n\nL'état désactivé est affiché lorsque l'utilisateur ne peut pas interagir avec un élément, comme un bouton ou un champ de saisie désactivé."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of a ghost element that should have the same background as the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état de survol d'un élément fantôme qui doit avoir le même arrière-plan que la surface sur laquelle il se trouve.\n\nL'état de survol est déclenché lorsque la souris entre dans un élément, ou lorsqu'un doigt touche un élément sur un écran tactile."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of an element that should have a different background than the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état de survol d'un élément qui doit avoir un arrière-plan différent de celui de la surface sur laquelle il se trouve.\n\nL'état de survol est déclenché lorsque la souris entre dans un élément, ou lorsqu'un doigt touche un élément sur un écran tactile."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of a ghost element that should have the same background as the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état sélectionné d'un élément fantôme qui doit avoir le même arrière-plan que la surface sur laquelle il se trouve.\n\nL'état sélectionné est déclenché lorsque l'utilisateur sélectionne (ou \"active\") l'élément.\n\nCela peut inclure une case cochée, un bouton bascule activé, etc."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of an element that should have a different background than the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Couleur d'arrière-plan. Utilisée pour l'état sélectionné d'un élément qui doit avoir un arrière-plan différent de celui de la surface sur laquelle il se trouve.\n\nL'état sélectionné est déclenché lorsque l'utilisateur sélectionne (ou \"active\") l'élément.\n\nCela peut inclure une case cochée, un bouton bascule activé, etc."

msgctxt "settings schema"
msgid "Background color for Vim Helix Normal mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Normal de Vim Helix."

msgctxt "settings schema"
msgid "Background color for Vim Helix Select mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Sélection de Vim Helix."

msgctxt "settings schema"
msgid "Background color for Vim Insert mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Insertion de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Normal mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Normal de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Replace mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Remplacement de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual Block mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Bloc Visuel de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual Line mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Ligne Visuelle de Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual mode indicator."
msgstr "Couleur d'arrière-plan pour l'indicateur du mode Visuel de Vim."

msgctxt "settings schema"
msgid "Background color for Vim yank highlight."
msgstr "Couleur d'arrière-plan pour la mise en surbrillance du yank de Vim."

msgctxt "settings schema"
msgid "Background color for row highlights of \"ours\" regions in merge conflicts."
msgstr "Couleur d'arrière-plan pour les surbrillances de lignes des régions \"ours\" dans les conflits de fusion."

msgctxt "settings schema"
msgid "Background color for row highlights of \"theirs\" regions in merge conflicts."
msgstr "Couleur d'arrière-plan pour les surbrillances de lignes des régions \"theirs\" dans les conflits de fusion."

msgctxt "settings schema"
msgid "Background color. Used for elevated surfaces, like a context menu, popup, or dialog."
msgstr "Couleur d'arrière-plan. Utilisée pour les surfaces en relief, comme un menu contextuel, une fenêtre contextuelle ou une boîte de dialogue."

msgctxt "settings schema"
msgid "Background of active line of debugger"
msgstr "Arrière-plan de la ligne active du débogueur"

msgctxt "settings schema"
msgid "Base key bindings scheme. Base keymaps can be overridden with user keymaps.\n\nDefault: Zed"
msgstr "Schéma de combinaisons de touches de base. Les raccourcis de base peuvent être remplacés par les raccourcis clavier de l'utilisateur.\n\nValeur par défaut : Zed"

msgctxt "settings schema"
msgid "Be smart and search for ignored when called from a gitignored worktree"
msgstr "Rechercher intelligemment les fichiers ignorés lorsque la recherche est lancée depuis une arborescence de travail ignorée par Git"

msgctxt "settings schema"
msgid "Behave as a regular buffer and select the whole word."
msgstr "Se comporte comme un tampon ordinaire et sélectionne le mot entier."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text after the cursor is a suffix of the completion, and like\n`\"insert\"` otherwise."
msgstr "Se comporte comme `\"replace\"` si le texte après le curseur est un suffixe de la complétion, et comme `\"insert\"` sinon."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text that would be replaced is a subsequence of the completion text,\nand like `\"insert\"` otherwise."
msgstr "Se comporte comme `\"replace\"` si le texte qui serait remplacé est une sous-séquence du texte de la complétion, et comme `\"insert\"` sinon."

msgctxt "settings schema"
msgid "Black ANSI terminal color."
msgstr "Couleur ANSI noire du terminal."

msgctxt "settings schema"
msgid "Block cursor that surrounds the character."
msgstr "Curseur bloc entourant le caractère."

msgctxt "settings schema"
msgid "Blue ANSI terminal color."
msgstr "Couleur de terminal ANSI bleue."

msgctxt "settings schema"
msgid "Border Color. Used for the border that shows where a dragged element will be dropped."
msgstr "Couleur de bordure. Utilisée pour la bordure indiquant où un élément glissé sera déposé."

msgctxt "settings schema"
msgid "Border color. Used for deemphasized borders, like a visual divider between two sections"
msgstr "Couleur de bordure. Utilisée pour les bordures discrètes, comme un séparateur visuel entre deux sections."

msgctxt "settings schema"
msgid "Border color. Used for disabled elements, like a disabled input or button."
msgstr "Couleur de bordure. Utilisée pour les éléments désactivés, comme un champ ou un bouton désactivé."

msgctxt "settings schema"
msgid "Border color. Used for focused elements, like keyboard focused list item."
msgstr "Couleur de bordure. Utilisée pour les éléments ayant le focus, comme un élément de liste ayant le focus au clavier."

msgctxt "settings schema"
msgid "Border color. Used for most borders, is usually a high contrast color."
msgstr "Couleur de bordure. Utilisée pour la plupart des bordures, généralement une couleur à contraste élevé."

msgctxt "settings schema"
msgid "Border color. Used for selected elements, like an active search filter or selected checkbox."
msgstr "Couleur de bordure. Utilisée pour les éléments sélectionnés, comme un filtre de recherche actif ou une case cochée."

msgctxt "settings schema"
msgid "Border color. Used for transparent borders. Used for placeholder borders when an element gains a border on state change."
msgstr "Couleur de bordure. Utilisée pour les bordures transparentes. Utilisée comme bordure provisoire lorsqu'un élément acquiert une bordure lors d'un changement d'état."

msgctxt "settings schema"
msgid "Bright black ANSI terminal color."
msgstr "Couleur de terminal ANSI noir vif."

msgctxt "settings schema"
msgid "Bright blue ANSI terminal color."
msgstr "Couleur de terminal ANSI bleu vif."

msgctxt "settings schema"
msgid "Bright cyan ANSI terminal color."
msgstr "Couleur de terminal ANSI cyan vif."

msgctxt "settings schema"
msgid "Bright green ANSI terminal color."
msgstr "Couleur de terminal ANSI vert vif."

msgctxt "settings schema"
msgid "Bright magenta ANSI terminal color."
msgstr "Couleur de terminal ANSI magenta vif."

msgctxt "settings schema"
msgid "Bright red ANSI terminal color."
msgstr "Couleur de terminal ANSI rouge vif."

msgctxt "settings schema"
msgid "Bright terminal foreground color."
msgstr "Couleur de premier plan vive du terminal."

msgctxt "settings schema"
msgid "Bright white ANSI terminal color."
msgstr "Couleur de terminal ANSI blanc vif."

msgctxt "settings schema"
msgid "Bright yellow ANSI terminal color."
msgstr "Couleur de terminal ANSI jaune vif."

msgctxt "settings schema"
msgid "Byte budget for a repository map prepended to the agent's system prompt,\nright after the list of project root directories. `0` disables it.\nValues above 32768 are clamped to 32768.\n\nDefault: 0"
msgstr "Budget en octets d'une carte du dépôt ajoutée au prompt système de l'agent, juste après la liste des répertoires racines du projet. `0` la désactive. Les valeurs supérieures à 32768 sont ramenées à 32768.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "Callees left out of the list of a function's callees, such as logging\nand assertion macros. A row at the end counts them and shows them on\nrequest.\n\nDefault: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"
msgstr "Appelés exclus de la liste des appelés d'une fonction, comme les macros de journalisation et d'assertion. Une ligne à la fin les compte et les affiche sur demande.\n\nValeur par défaut : [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"

msgctxt "settings schema"
msgid "Case-insensitive natural sort with lowercase preferred in ties.\nNumbers in file names are compared by value (e.g., `file2` before `file10`)."
msgstr "Tri naturel insensible à la casse, les minuscules passant en premier en cas d'égalité. Les nombres dans les noms de fichiers sont comparés par valeur (p. ex. `file2` avant `file10`)."

msgctxt "settings schema"
msgid "Centered layout related setting (left/right)."
msgstr "Paramètre lié à la disposition centrée (gauche/droite)."

msgctxt "settings schema"
msgid "Centered layout related settings."
msgstr "Paramètres liés à la disposition centrée."

msgctxt "settings schema"
msgid "Character counts at which to show wrap guides in the editor.\n\nDefault: []"
msgstr "Nombres de caractères auxquels afficher des guides de retour à la ligne dans l'éditeur.\n\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Close the window when there are no tabs"
msgstr "Ferme la fenêtre quand il n'y a plus d'onglets"

msgctxt "settings schema"
msgid "Color for added words in word diffs."
msgstr "Couleur des mots ajoutés dans les différences de mots."

msgctxt "settings schema"
msgid "Color for deleted words in word diffs."
msgstr "Couleur des mots supprimés dans les différences de mots."

msgctxt "settings schema"
msgid "Color used to accent some of the debuggers elements\nOnly accent breakpoint & breakpoint related symbols right now"
msgstr "Couleur utilisée pour accentuer certains éléments du débogueur.\nN'accentue pour l'instant que les points d'arrêt et les symboles liés aux points d'arrêt."

msgctxt "settings schema"
msgid "Comfortable spacing of entries."
msgstr "Espacement confortable des entrées."

msgctxt "settings schema"
msgid "Command to automatically run when Zed creates a Terminal Thread shell in the agent panel.\nThe command is sent to the shell as if typed, so it is interpreted by your\nconfigured shell (including on Windows and remote/WSL projects).\nAn empty string disables this behavior.\n\nDefault: \"\""
msgstr "Commande à exécuter automatiquement lorsque ForgeKairos crée le shell d'une conversation de terminal dans le panneau de l'agent. La commande est envoyée au shell comme si elle était saisie ; elle est donc interprétée par le shell configuré (y compris sous Windows et dans les projets distants/WSL). Une chaîne vide désactive ce comportement.\n\nValeur par défaut : \"\""

msgctxt "settings schema"
msgid "Common language server settings."
msgstr "Paramètres communs du serveur de langage."

msgctxt "settings schema"
msgid "Configuration for Debugger-related features"
msgstr "Configuration des fonctionnalités liées au débogueur"

msgctxt "settings schema"
msgid "Configuration for Diagnostics-related features."
msgstr "Configuration des fonctionnalités liées aux diagnostics."

msgctxt "settings schema"
msgid "Configuration for Git-related features"
msgstr "Configuration des fonctionnalités liées à Git"

msgctxt "settings schema"
msgid "Configuration for Node-related features"
msgstr "Configuration des fonctionnalités liées à Node"

msgctxt "settings schema"
msgid "Configuration for caching language model messages."
msgstr "Configuration de la mise en cache des messages du modèle de langage."

msgctxt "settings schema"
msgid "Configuration for developer-oriented instrumentation tools that collect\ndiagnostic data about a running Zed instance."
msgstr "Configuration des outils d'instrumentation destinés aux développeurs, qui collectent des données de diagnostic sur une instance ForgeKairos en cours d'exécution."

msgctxt "settings schema"
msgid "Configuration for how direnv configuration should be loaded"
msgstr "Configuration du chargement de la configuration direnv"

msgctxt "settings schema"
msgid "Configuration for language servers.\n\nThe following settings can be overridden for specific language servers:\n- initialization_options\n\nTo override settings for a language, add an entry for that language server's\nname to the lsp value.\nDefault: null"
msgstr "Configuration des serveurs de langage.\n\nLes paramètres suivants peuvent être remplacés pour des serveurs de langage précis :\n- initialization_options\n\nPour remplacer les paramètres d'un langage, ajoutez à la valeur lsp une entrée portant le nom du serveur de langage.\nValeur par défaut : null"

msgctxt "settings schema"
msgid "Configuration for session-related features"
msgstr "Configuration des fonctionnalités liées à la session"

msgctxt "settings schema"
msgid "Configuration for the collab panel visual settings."
msgstr "Configuration des paramètres visuels du panneau de collaboration."

msgctxt "settings schema"
msgid "Configuration for the performance profiler which collects timing data\nfor foreground and background executor tasks."
msgstr "Configuration du profileur de performances, qui collecte des données de durée pour les tâches des exécuteurs de premier plan et d'arrière-plan."

msgctxt "settings schema"
msgid "Configuration for the performance profiler, accessed via the\n`zed: open performance profiler` action."
msgstr "Configuration du profileur de performances, accessible via l'action `zed: open performance profiler`."

msgctxt "settings schema"
msgid "Configuration of Anthropic's caching API."
msgstr "Configuration de l'API de mise en cache d'Anthropic."

msgctxt "settings schema"
msgid "Configuration of audio in Zed."
msgstr "Configuration de l'audio dans ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of the terminal in Zed."
msgstr "Configuration du terminal dans ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of voice calls in Zed."
msgstr "Configuration des appels vocaux dans ForgeKairos."

msgctxt "settings schema"
msgid "Configures what draws Zed's window decorations on Linux.\nThis setting has no effect on other platforms."
msgstr "Configure ce qui dessine les décorations de fenêtre de ForgeKairos sous Linux. Ce paramètre n'a aucun effet sur les autres plateformes."

msgctxt "settings schema"
msgid "Conflict version control color."
msgstr "Couleur de contrôle de version pour les conflits."

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `Authorization` header is sent and the\nprovider counts as configured without a keychain entry.\n\nDefault: false"
msgstr "Se connecte sans aucun identifiant, pour les serveurs qui ne nécessitent pas d'authentification. Si cette option est définie, aucun en-tête `Authorization` n'est envoyé et le fournisseur est considéré comme configuré sans entrée dans le trousseau.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `x-api-key` header is sent and the provider\ncounts as configured without a keychain entry.\n\nDefault: false"
msgstr "Se connecte sans aucun identifiant, pour les serveurs qui ne nécessitent pas d'authentification. Si cette option est définie, aucun en-tête `x-api-key` n'est envoyé et le fournisseur est considéré comme configuré sans entrée dans le trousseau.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Contained between the left and right docks"
msgstr "Contenu entre les docks gauche et droit"

msgctxt "settings schema"
msgid "Continuation lines get 1 extra indent level beyond the original."
msgstr "Les lignes de continuation reçoivent 1 niveau d'indentation de plus que la ligne d'origine."

msgctxt "settings schema"
msgid "Continuation lines get 2 extra indent levels beyond the original."
msgstr "Les lignes de continuation reçoivent 2 niveaux d'indentation de plus que la ligne d'origine."

msgctxt "settings schema"
msgid "Continuation lines match the original line's indentation."
msgstr "Les lignes de continuation reprennent l'indentation de la ligne d'origine."

msgctxt "settings schema"
msgid "Continuation lines start at column 0."
msgstr "Les lignes de continuation commencent à la colonne 0."

msgctxt "settings schema"
msgid "Control what info is collected by Zed."
msgstr "Contrôle les informations collectées par Zed."

msgctxt "settings schema"
msgid "Controls automatic indentation behavior when typing.\n\n- \"syntax_aware\": Adjusts indentation based on syntax context (default)\n- \"preserve_indent\": Preserves current line's indentation on new lines\n- \"none\": No automatic indentation\n\nDefault: syntax_aware"
msgstr "Contrôle le comportement de l'indentation automatique pendant la saisie.\n\n- \"syntax_aware\" : ajuste l'indentation selon le contexte syntaxique (par défaut)\n- \"preserve_indent\" : conserve l'indentation de la ligne actuelle sur les nouvelles lignes\n- \"none\" : aucune indentation automatique\n\nValeur par défaut : syntax_aware"

msgctxt "settings schema"
msgid "Controls how LSP completions are inserted.\n\nDefault: \"replace_suffix\""
msgstr "Contrôle la manière dont les complétions LSP sont insérées.\n\nValeur par défaut : \"replace_suffix\""

msgctxt "settings schema"
msgid "Controls how completions are processed for this language."
msgstr "Contrôle la façon dont les complétions sont traitées pour ce langage."

msgctxt "settings schema"
msgid "Controls how document's words are completed."
msgstr "Contrôle la façon dont les mots du document sont complétés."

msgctxt "settings schema"
msgid "Controls how line endings are normalized when a buffer is saved."
msgstr "Contrôle la façon dont les fins de ligne sont normalisées lors de l'enregistrement d'un tampon."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting."
msgstr "Contrôle la façon dont les jetons sémantiques des serveurs de langage sont utilisés pour la coloration syntaxique."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting.\n\nOptions:\n- \"off\": Do not request semantic tokens from language servers.\n- \"combined\": Use LSP semantic tokens together with tree-sitter highlighting.\n- \"full\": Use LSP semantic tokens exclusively, replacing tree-sitter highlighting.\n\nDefault: \"off\""
msgstr "Contrôle la manière dont les jetons sémantiques des serveurs de langage sont utilisés pour la coloration syntaxique.\n\nOptions :\n- \"off\" : ne demande pas de jetons sémantiques aux serveurs de langage.\n- \"combined\" : utilise les jetons sémantiques LSP avec la coloration tree-sitter.\n- \"full\" : utilise exclusivement les jetons sémantiques LSP, à la place de la coloration tree-sitter.\n\nValeur par défaut : \"off\""

msgctxt "settings schema"
msgid "Controls how the editor handles the autoclosed characters.\nWhen set to `false`(default), skipping over and auto-removing of the closing characters\nhappen only for auto-inserted characters.\nOtherwise(when `true`), the closing characters are always skipped over and auto-removed\nno matter how they were inserted.\n\nDefault: false"
msgstr "Contrôle la manière dont l'éditeur gère les caractères fermés automatiquement. Avec `false` (par défaut), le saut et la suppression automatique des caractères fermants ne s'appliquent qu'aux caractères insérés automatiquement. Sinon (avec `true`), les caractères fermants sont toujours sautés et supprimés automatiquement, quelle que soit la manière dont ils ont été insérés.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Controls how whitespace should be displayedin the editor."
msgstr "Contrôle la façon dont les espaces blancs doivent être affichés dans l'éditeur."

msgctxt "settings schema"
msgid "Controls how words are completed.\nFor large documents, not all words may be fetched for completion.\n\nDefault: `fallback`"
msgstr "Contrôle la manière dont les mots sont complétés. Pour les documents volumineux, tous les mots ne sont pas forcément récupérés pour la complétion.\n\nValeur par défaut : `fallback`"

msgctxt "settings schema"
msgid "Controls previous session restoration in freshly launched Zed instance.\nValues: empty_tab, last_workspace, last_session, launchpad\nDefault: last_session"
msgstr "Contrôle la restauration de la session précédente dans une instance de ForgeKairos fraîchement lancée.\nValeurs : empty_tab, last_workspace, last_session, launchpad\nValeur par défaut : last_session"

msgctxt "settings schema"
msgid "Controls the soft-wrapping behavior in the editor."
msgstr "Contrôle le comportement du retour à la ligne automatique dans l'éditeur."

msgctxt "settings schema"
msgid "Controls the source of document symbols used for outlines and breadcrumbs.\n\nOptions:\n- \"off\": Use tree-sitter queries to compute document symbols (default).\n- \"on\": Use the language server's `textDocument/documentSymbol` LSP response. When enabled, tree-sitter is not used for document symbols.\n\nDefault: \"off\""
msgstr "Contrôle la source des symboles de document utilisés pour la structure et le fil d'Ariane.\n\nOptions :\n- \"off\" : utilise des requêtes tree-sitter pour calculer les symboles de document (par défaut).\n- \"on\" : utilise la réponse LSP `textDocument/documentSymbol` du serveur de langage. Si cette option est activée, tree-sitter n'est pas utilisé pour les symboles de document.\n\nValeur par défaut : \"off\""

msgctxt "settings schema"
msgid "Controls the width of the git diff hunk indicators in the gutter."
msgstr "Contrôle la largeur des indicateurs de blocs de modifications Git dans la gouttière."

msgctxt "settings schema"
msgid "Controls when to use system clipboard."
msgstr "Contrôle le moment où le presse-papiers système est utilisé."

msgctxt "settings schema"
msgid "Controls where the `editor::Rewrap` action is allowed for this language.\n\nNote: This setting has no effect in Vim mode, as rewrap is already\nallowed everywhere.\n\nDefault: \"in_comments\""
msgstr "Contrôle où l'action `editor::Rewrap` est autorisée pour ce langage.\n\nRemarque : ce paramètre n'a aucun effet en mode Vim, où le reformatage est déjà autorisé partout.\n\nValeur par défaut : \"in_comments\""

msgctxt "settings schema"
msgid "Controls whether Zed collects training data when using Zed's Edit Predictions."
msgstr "Contrôle si Zed collecte des données d'entraînement lors de l'utilisation des prédictions de modification de Zed."

msgctxt "settings schema"
msgid "Controls whether Zed may collect training data when using Zed's Edit Predictions.\nData is only ever captured for files in projects that are detected as open source.\n\n- `\"default\"`: use the preference previously set via the status-bar toggle,\n  or false if no preference has been stored.\n- `\"yes\"`: allow data collection for files in open-source projects.\n- `\"no\"`: never allow data collection."
msgstr "Contrôle si Zed peut collecter des données d'entraînement lors de l'utilisation des prédictions de modification de Zed. Les données ne sont collectées que pour les fichiers des projets détectés comme open source.\n\n- `\"default\"` : utilise la préférence définie précédemment via le bouton de la barre d'état, ou false si aucune préférence n'a été enregistrée.\n- `\"yes\"` : autorise la collecte de données pour les fichiers des projets open source.\n- `\"no\"` : n'autorise jamais la collecte de données."

msgctxt "settings schema"
msgid "Controls whether Zed or the window manager or compositor draws window decorations on Linux.\n\nDefault: client"
msgstr "Contrôle si ForgeKairos, le gestionnaire de fenêtres ou le compositeur dessine les décorations de fenêtre sous Linux.\n\nValeur par défaut : client"

msgctxt "settings schema"
msgid "Controls whether edit predictions are shown immediately (true)\nor manually by triggering `editor::ShowEditPrediction` (false).\n\nDefault: true"
msgstr "Contrôle si les prédictions de modification sont affichées immédiatement (true) ou manuellement en déclenchant `editor::ShowEditPrediction` (false).\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Controls whether folding ranges from language servers are used instead of\ntree-sitter and indent-based folding.\n\nOptions:\n- \"off\": Use tree-sitter and indent-based folding (default).\n- \"on\": Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server.\n\nDefault: \"off\""
msgstr "Contrôle si les plages de repli des serveurs de langage sont utilisées à la place du repli tree-sitter et basé sur l'indentation.\n\nOptions :\n- \"off\" : utilise le repli tree-sitter et basé sur l'indentation (par défaut).\n- \"on\" : utilise le repli LSP dans la mesure du possible, avec repli sur tree-sitter et l'indentation lorsque le serveur ne renvoie aucun résultat.\n\nValeur par défaut : \"off\""

msgctxt "settings schema"
msgid "Controls which formatter should be used when formatting code. If there are multiple formatters, they are executed in the order of declaration."
msgstr "Contrôle le formateur à utiliser lors de la mise en forme du code. Si plusieurs formateurs sont définis, ils sont exécutés dans l'ordre de déclaration."

msgctxt "settings schema"
msgid "Controls which formatters should be used when formatting code."
msgstr "Contrôle les formateurs à utiliser lors de la mise en forme du code."

msgctxt "settings schema"
msgid "Cursor is a block like `█`."
msgstr "Le curseur est un bloc comme `█`."

msgctxt "settings schema"
msgid "Cursor is a hollow box like `▯`."
msgstr "Le curseur est un cadre vide comme `▯`."

msgctxt "settings schema"
msgid "Cursor is a vertical bar like `⎸`."
msgstr "Le curseur est une barre verticale comme `⎸`."

msgctxt "settings schema"
msgid "Cursor is an underscore like `_`."
msgstr "Le curseur est un trait de soulignement comme `_`."

msgctxt "settings schema"
msgid "Cursor movement animation settings."
msgstr "Paramètres d'animation du déplacement du curseur."

msgctxt "settings schema"
msgid "Cursor shape configuration for insert mode in Vim."
msgstr "Configuration de la forme du curseur pour le mode insertion dans Vim."

msgctxt "settings schema"
msgid "Cursor shape for the default editor.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: bar"
msgstr "Forme du curseur de l'éditeur par défaut. Peut être \"bar\", \"block\", \"underline\" ou \"hollow\".\n\nValeur par défaut : bar"

msgctxt "settings schema"
msgid "Cursor shape for the insert mode.\n\nThe default value follows the primary cursor_shape."
msgstr "Forme du curseur en mode insertion.\n\nLa valeur par défaut suit le paramètre principal cursor_shape."

msgctxt "settings schema"
msgid "Cursor shape for the normal mode.\n\nDefault: block"
msgstr "Forme du curseur en mode normal.\n\nValeur par défaut : block"

msgctxt "settings schema"
msgid "Cursor shape for the replace mode.\n\nDefault: underline"
msgstr "Forme du curseur en mode remplacement.\n\nValeur par défaut : underline"

msgctxt "settings schema"
msgid "Cursor shape for the visual mode.\n\nDefault: block"
msgstr "Forme du curseur en mode visuel.\n\nValeur par défaut : block"

msgctxt "settings schema"
msgid "Custom Model API URL to use for this model."
msgstr "URL d'API de modèle personnalisée à utiliser pour ce modèle."

msgctxt "settings schema"
msgid "Custom instructions to include in the prompt when generating git commit messages.\nApplied in addition to any project rules files (such as `.rules` or `AGENTS.md`)."
msgstr "Instructions personnalisées à inclure dans le prompt lors de la génération des messages de validation Git. Appliquées en plus des fichiers de règles du projet (comme `.rules` ou `AGENTS.md`)."

msgctxt "settings schema"
msgid "Custom models served through the `bedrock-mantle` endpoint's\nOpenAI-compatible APIs, in addition to the built-in Mantle models\n(GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."
msgstr "Modèles personnalisés servis via les API compatibles OpenAI du point de terminaison `bedrock-mantle`, en plus des modèles Mantle intégrés (GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."

msgctxt "settings schema"
msgid "Custom rules for rendering LSP semantic tokens."
msgstr "Règles personnalisées pour le rendu des jetons sémantiques LSP."

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by outline panel\n\nDefault: 240"
msgstr "Personnalise la largeur par défaut (en pixels) occupée par le panneau de structure\n\nValeur par défaut : 240"

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by project panel\n\nDefault: 240"
msgstr "Personnalise la largeur par défaut (en pixels) occupée par le panneau de projet\n\nValeur par défaut : 240"

msgctxt "settings schema"
msgid "Cyan ANSI terminal color."
msgstr "Couleur de terminal ANSI cyan."

msgctxt "settings schema"
msgid "Default action when clicking a changed file in the Git panel.\n\nDefault: project_diff"
msgstr "Action par défaut lors d'un clic sur un fichier modifié dans le panneau Git.\n\nValeur par défaut : project_diff"

msgctxt "settings schema"
msgid "Default cursor shape for the terminal.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: \"block\""
msgstr "Forme de curseur par défaut du terminal. Peut être \"bar\", \"block\", \"underline\" ou \"hollow\".\n\nValeur par défaut : \"block\""

msgctxt "settings schema"
msgid "Default depth to expand outline items in the current file.\nThe default depth to which outline entries are expanded on reveal.\n- Set to 0 to collapse all items that have children\n- Set to 1 or higher to collapse items at that depth or deeper\n\nDefault: 100"
msgstr "Profondeur par défaut de développement des éléments de structure du fichier actuel.\nProfondeur jusqu'à laquelle les entrées de la structure sont développées à l'affichage.\n- Définissez 0 pour réduire tous les éléments qui ont des enfants\n- Définissez 1 ou plus pour réduire les éléments à cette profondeur ou plus profonds\n\nValeur par défaut : 100"

msgctxt "settings schema"
msgid "Default directories to search for virtual environments, relative\nto the current working directory. We recommend overriding this\nin your project's settings, rather than globally."
msgstr "Répertoires par défaut dans lesquels rechercher des environnements virtuels, relatifs au répertoire de travail actuel. Nous recommandons de remplacer cette valeur dans les paramètres de votre projet plutôt que globalement."

msgctxt "settings schema"
msgid "Default fixed width in pixels when the agent panel is docked to the left or right and\n`flexible` is false.\n\nDefault: 640"
msgstr "Largeur fixe par défaut en pixels lorsque le panneau de l'agent est ancré à gauche ou à droite et que `flexible` vaut false.\n\nValeur par défaut : 640"

msgctxt "settings schema"
msgid "Default height in pixels when the AI browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Hauteur par défaut en pixels lorsque le panneau Navigateur IA est ancré en bas.\n\nValeur par défaut : 320"

msgctxt "settings schema"
msgid "Default height in pixels when the agent panel is docked to the bottom.\n\nDefault: 320"
msgstr "Hauteur par défaut en pixels lorsque le panneau de l'agent est ancré en bas.\n\nValeur par défaut : 320"

msgctxt "settings schema"
msgid "Default height in pixels when the browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Hauteur par défaut en pixels lorsque le panneau Navigateur est ancré en bas.\n\nValeur par défaut : 320"

msgctxt "settings schema"
msgid "Default height when the terminal is docked to the bottom.\n\nDefault: 320"
msgstr "Hauteur par défaut lorsque le terminal est ancré en bas.\n\nValeur par défaut : 320"

msgctxt "settings schema"
msgid "Default is 1500ms."
msgstr "La valeur par défaut est 1500 ms."

msgctxt "settings schema"
msgid "Default kernels to select for each language.\n\nDefault: `{}`"
msgstr "Noyaux à sélectionner par défaut pour chaque langage.\n\nValeur par défaut : `{}`"

msgctxt "settings schema"
msgid "Default mode when no regex rules match.\nWhen unset, inherits from the global `tool_permissions.default`."
msgstr "Mode par défaut lorsqu'aucune règle d'expression régulière ne correspond. S'il n'est pas défini, il hérite du paramètre global `tool_permissions.default`."

msgctxt "settings schema"
msgid "Default options for buffer and project search items."
msgstr "Options par défaut pour les éléments de recherche dans le tampon et le projet."

msgctxt "settings schema"
msgid "Default the cursor blink to off, but allow the terminal to\nset blinking."
msgstr "Désactive par défaut le clignotement du curseur, mais permet au terminal d'activer le clignotement."

msgctxt "settings schema"
msgid "Default timeout in seconds for context server tool calls.\nCan be overridden per-server in context_servers configuration.\n\nDefault: 60"
msgstr "Délai d'expiration par défaut, en secondes, des appels d'outils des serveurs de contexte. Peut être remplacé par serveur dans la configuration context_servers.\n\nValeur par défaut : 60"

msgctxt "settings schema"
msgid "Default values for session config options.\n\nThis is a map from config option ID to the default value for that option.\n\nDefault: {}"
msgstr "Valeurs par défaut des options de configuration de session.\n\nIl s'agit d'une table associant l'ID d'une option de configuration à sa valeur par défaut.\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "Default width in pixels when the AI browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Largeur par défaut en pixels lorsque le panneau Navigateur IA est ancré à gauche ou à droite.\n\nValeur par défaut : 480"

msgctxt "settings schema"
msgid "Default width in pixels when the browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Largeur par défaut en pixels lorsque le panneau Navigateur est ancré à gauche ou à droite.\n\nValeur par défaut : 480"

msgctxt "settings schema"
msgid "Default width of the call graph panel in pixels.\n\nDefault: 320"
msgstr "Largeur par défaut du panneau du graphe des appels en pixels.\n\nValeur par défaut : 320"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 240"
msgstr "Largeur par défaut du panneau en pixels.\n\nValeur par défaut : 240"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 360"
msgstr "Largeur par défaut du panneau en pixels.\n\nValeur par défaut : 360"

msgctxt "settings schema"
msgid "Default width of the threads sidebar in pixels.\n\nValues range from 200 to 800, matching the widths the sidebar can be\ndragged to. Values outside that range are clamped into it.\n\nDefault: 300"
msgstr "Largeur par défaut de la barre latérale des conversations en pixels.\n\nLes valeurs vont de 200 à 800, ce qui correspond aux largeurs auxquelles la barre latérale peut être redimensionnée. Les valeurs hors de cette plage y sont ramenées.\n\nValeur par défaut : 300"

msgctxt "settings schema"
msgid "Default width when the terminal is docked to the left or right.\n\nDefault: 640"
msgstr "Largeur par défaut lorsque le terminal est ancré à gauche ou à droite.\n\nValeur par défaut : 640"

msgctxt "settings schema"
msgid "Default: 0.2"
msgstr "Valeur par défaut : 0.2"

msgctxt "settings schema"
msgid "Default: {}"
msgstr "Valeur par défaut : {}"

msgctxt "settings schema"
msgid "Defaults to use when opening a new buffer and project search items.\n\nDefault: nothing is enabled"
msgstr "Valeurs par défaut à utiliser à l'ouverture d'un nouveau tampon et des éléments de recherche dans le projet.\n\nValeur par défaut : rien n'est activé"

msgctxt "settings schema"
msgid "Defines the border style for the minimap's scrollbar thumb.\n\nDefault: left_open"
msgstr "Définit le style de bordure du curseur de défilement de la minicarte.\n\nValeur par défaut : left_open"

msgctxt "settings schema"
msgid "Delay in milliseconds before showing the which-key popup.\n\nDefault: 1000"
msgstr "Délai en millisecondes avant l'affichage de la fenêtre which-key.\n\nValeur par défaut : 1000"

msgctxt "settings schema"
msgid "Deleted version control color."
msgstr "Couleur de contrôle de version pour les suppressions."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_ours`."
msgstr "Obsolète au profit de `version_control_conflict_marker_ours`."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_theirs`."
msgstr "Obsolète au profit de `version_control_conflict_marker_theirs`."

msgctxt "settings schema"
msgid "Deprecated: use None instead. Left to avoid breaking existing users' configs.\nPrefer a single line generally, unless an overly long line is encountered."
msgstr "Obsolète : utilisez None à la place. Conservé pour ne pas casser les configurations existantes des utilisateurs. Préfère en général une seule ligne, sauf en cas de ligne trop longue."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored."
msgstr "Détermine la couleur de fond des guides d'indentation."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored.\n\nDefault: Disabled"
msgstr "Détermine la manière dont les arrière-plans des guides d'indentation sont colorés.\n\nValeur par défaut : Disabled"

msgctxt "settings schema"
msgid "Determines how indent guides are colored."
msgstr "Détermine la couleur des guides d'indentation."

msgctxt "settings schema"
msgid "Determines how indent guides are colored.\n\nDefault: Fixed"
msgstr "Détermine la manière dont les guides d'indentation sont colorés.\n\nValeur par défaut : Fixed"

msgctxt "settings schema"
msgid "Determines how much space the call hierarchy picker can take up in relation to the available window width.\n\nDefault: medium"
msgstr "Détermine l'espace que peut occuper le sélecteur de hiérarchie des appels par rapport à la largeur disponible de la fenêtre.\n\nValeur par défaut : medium"

msgctxt "settings schema"
msgid "Determines how much space the file finder can take up in relation to the available window width.\n\nDefault: small"
msgstr "Détermine l'espace que peut occuper la recherche de fichiers par rapport à la largeur disponible de la fenêtre.\n\nValeur par défaut : small"

msgctxt "settings schema"
msgid "Determines how snippets are sorted relative to other completion items.\n\nDefault: inline"
msgstr "Détermine la manière dont les extraits de code sont triés par rapport aux autres éléments de complétion.\n\nValeur par défaut : inline"

msgctxt "settings schema"
msgid "Determines the modifier to be used to add multiple cursors with the mouse. The open hover link mouse gestures will adapt such that it do not conflict with the multicursor modifier.\n\nDefault: alt"
msgstr "Détermine le modificateur à utiliser pour ajouter des curseurs multiples avec la souris. Les gestes de souris d'ouverture de lien au survol s'adaptent pour ne pas entrer en conflit avec le modificateur des curseurs multiples.\n\nValeur par défaut : alt"

msgctxt "settings schema"
msgid "Determines the stepping granularity.\n\nDefault: line"
msgstr "Détermine la granularité du pas à pas.\n\nValeur par défaut : line"

msgctxt "settings schema"
msgid "Determines what settings a profile starts from before applying its overrides."
msgstr "Détermine les paramètres de départ d'un profil avant l'application de ses remplacements."

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to\nkeyboard input. Applies globally across all input surfaces (editors,\nterminals, palettes, etc.).\n\nDefault: on_typing_and_action"
msgstr "Détermine quand le curseur de la souris doit être masqué en réponse à une saisie au clavier. S'applique globalement à toutes les surfaces de saisie (éditeurs, terminaux, palettes, etc.).\n\nValeur par défaut : on_typing_and_action"

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to keyboard\ninput.\n\nDefault: on_typing_and_action"
msgstr "Détermine quand le curseur de la souris doit être masqué en réponse à une saisie au clavier.\n\nValeur par défaut : on_typing_and_action"

msgctxt "settings schema"
msgid "Determines whether the file finder should skip focus for the active file in search results.\n\nDefault: true"
msgstr "Détermine si la recherche de fichiers doit ignorer le focus sur le fichier actif dans les résultats de recherche.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Determines whether to reduce non-essential motion in the UI, such as\nloading spinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Détermine s'il faut réduire les animations non essentielles de l'interface, comme les indicateurs de chargement et les libellés pulsants, en les affichant de façon statique.\n\nValeur par défaut : off"

msgctxt "settings schema"
msgid "Determines which edit prediction provider to use."
msgstr "Détermine le fournisseur de prédiction de modification à utiliser."

msgctxt "settings schema"
msgid "Diff against HEAD: show working (uncommitted) changes."
msgstr "Calcule les différences par rapport à HEAD : affiche les modifications non validées."

msgctxt "settings schema"
msgid "Diff against the merge base between HEAD and the repository's\ndefault branch: show all changes on the branch.\n\nRepositories where no default branch can be resolved fall back\nto `head` behavior."
msgstr "Compare avec la base de fusion entre HEAD et la branche par défaut du dépôt : affiche toutes les modifications de la branche.\n\nLes dépôts pour lesquels aucune branche par défaut ne peut être résolue reviennent au comportement `head`."

msgctxt "settings schema"
msgid "Dim black ANSI terminal color."
msgstr "Couleur ANSI noir atténué pour le terminal."

msgctxt "settings schema"
msgid "Dim blue ANSI terminal color."
msgstr "Couleur ANSI bleu atténué pour le terminal."

msgctxt "settings schema"
msgid "Dim cyan ANSI terminal color."
msgstr "Couleur ANSI cyan atténué pour le terminal."

msgctxt "settings schema"
msgid "Dim green ANSI terminal color."
msgstr "Couleur ANSI vert atténué pour le terminal."

msgctxt "settings schema"
msgid "Dim magenta ANSI terminal color."
msgstr "Couleur ANSI magenta atténué pour le terminal."

msgctxt "settings schema"
msgid "Dim red ANSI terminal color."
msgstr "Couleur ANSI rouge atténué pour le terminal."

msgctxt "settings schema"
msgid "Dim terminal foreground color."
msgstr "Couleur de premier plan atténuée du terminal."

msgctxt "settings schema"
msgid "Dim white ANSI terminal color."
msgstr "Couleur ANSI blanche atténuée du terminal."

msgctxt "settings schema"
msgid "Dim yellow ANSI terminal color."
msgstr "Couleur ANSI jaune atténuée du terminal."

msgctxt "settings schema"
msgid "Direction to split horizontally.\n\nDefault: \"up\""
msgstr "Direction du fractionnement horizontal.\n\nValeur par défaut : \"up\""

msgctxt "settings schema"
msgid "Direction to split vertically.\n\nDefault: \"left\""
msgstr "Direction du fractionnement vertical.\n\nValeur par défaut : \"left\""

msgctxt "settings schema"
msgid "Directory subtrees that sandboxed terminal commands may always write\nto without prompting. Each entry is either a bare path string or an\nobject `{requested, resolved}`; Zed writes objects (the canonical,\nsymlink-resolved target established at approval time), while\nhand-authored entries may be bare path strings. Paths written by Zed\nare absolute.\nDefault: []"
msgstr "Sous-arborescences de répertoires dans lesquelles les commandes de terminal en bac à sable peuvent toujours écrire sans demande. Chaque entrée est soit une simple chaîne de chemin, soit un objet `{requested, resolved}` ; ForgeKairos écrit des objets (la cible canonique, liens symboliques résolus, établie au moment de l'approbation), tandis que les entrées écrites à la main peuvent être de simples chaînes de chemin. Les chemins écrits par ForgeKairos sont absolus.\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Directory the log files are written to. `~` is expanded.\nWhen empty, logs go to Zed's log directory under `terminal-sessions`.\n\nDefault: \"\""
msgstr "Répertoire dans lequel les fichiers journaux sont écrits. `~` est développé. S'il est vide, les journaux vont dans le répertoire des journaux de ForgeKairos, sous `terminal-sessions`.\n\nValeur par défaut : \"\""

msgctxt "settings schema"
msgid "Directory where git worktrees are created, relative to the repository\nworking directory.\n\nWhen the resolved directory is outside the project root, the\nproject's directory name is automatically appended so that\nsibling repos don't collide. For example, with the default\n`\"../worktrees\"` and a project at `~/code/zed`, worktrees are\ncreated under `~/code/worktrees/zed/`.\n\nWhen the resolved directory is inside the project root, no\nextra component is added (it's already project-scoped).\n\nExamples:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (default)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nTrailing slashes are ignored.\n\nDefault: ../worktrees"
msgstr "Répertoire dans lequel les arborescences de travail Git sont créées, relatif au répertoire de travail du dépôt.\n\nLorsque le répertoire résolu est hors de la racine du projet, le nom du répertoire du projet est ajouté automatiquement pour que des dépôts voisins n'entrent pas en collision. Par exemple, avec la valeur par défaut `\"../worktrees\"` et un projet dans `~/code/zed`, les arborescences de travail sont créées sous `~/code/worktrees/zed/`.\n\nLorsque le répertoire résolu est dans la racine du projet, aucun composant supplémentaire n'est ajouté (il est déjà propre au projet).\n\nExemples :\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (par défaut)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nLes barres obliques finales sont ignorées.\n\nValeur par défaut : ../worktrees"

msgctxt "settings schema"
msgid "Disable autosave."
msgstr "Désactive l'enregistrement automatique."

msgctxt "settings schema"
msgid "Disable certificate verification for the proxy (not recommended).\n\nDefault: false"
msgstr "Désactive la vérification des certificats pour le proxy (non recommandé).\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Disable edit predictions for files matching these glob patterns.\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged.\n\nRelative patterns are matched against paths relative to the worktree root.\nAbsolute patterns are matched against absolute paths. A leading `~` is\nexpanded to your home folder."
msgstr "Désactive les prédictions de modification pour les fichiers correspondant à ces motifs glob.\n\nUtilisez `\"...\"` pour ajouter des motifs sans répéter les valeurs par défaut de ForgeKairos. Dans les paramètres du projet, cela étend la valeur de la configuration utilisateur ou parente. Omettez `\"...\"` pour remplacer la liste héritée.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nLes motifs hérités sont insérés à la place de `\"...\"`, et les doublons conservent leur première occurrence.\n\nDéfinissez `[]` pour vider la liste héritée. Omettez ce paramètre pour en hériter sans modification.\n\nLes motifs relatifs sont comparés aux chemins relatifs à la racine de l'arborescence de travail. Les motifs absolus sont comparés aux chemins absolus. Un `~` initial est développé en votre dossier personnel."

msgctxt "settings schema"
msgid "Disable edit predictions in these language scopes, such as \"comment\" and\n\"string\".\n\nDefault:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` to add scopes without repeating the inherited list. In project\nsettings, it extends the user or parent configuration value. In\nlanguage-specific settings, it extends the scopes inherited by that\nlanguage. Omit `\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nInherited scopes are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged."
msgstr "Désactive les prédictions de modification dans ces portées syntaxiques, comme \"comment\" et \"string\".\n\nValeur par défaut :\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUtilisez `\"...\"` pour ajouter des portées sans répéter la liste héritée. Dans les paramètres du projet, cela étend la valeur de la configuration utilisateur ou parente. Dans les paramètres propres à un langage, cela étend les portées héritées par ce langage. Omettez `\"...\"` pour remplacer la liste héritée.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nLes portées héritées sont insérées à la place de `\"...\"`, et les doublons conservent leur première occurrence.\n\nDéfinissez `[]` pour vider la liste héritée. Omettez ce paramètre pour en hériter sans modification."

msgctxt "settings schema"
msgid "Disables the fallback."
msgstr "Désactive le mécanisme de secours."

msgctxt "settings schema"
msgid "Disables the tooltip"
msgstr "Désactive l'info-bulle"

msgctxt "settings schema"
msgid "Discards the changes."
msgstr "Abandonne les modifications."

msgctxt "settings schema"
msgid "Display code lenses from language servers above code elements."
msgstr "Affiche les CodeLens des serveurs de langage au-dessus des éléments de code."

msgctxt "settings schema"
msgid "Display code lenses in the code action menu."
msgstr "Affiche les CodeLens dans le menu d'actions de code."

msgctxt "settings schema"
msgid "Display inline when there are no language server completions available."
msgstr "Affiche la prédiction en ligne lorsqu'aucune complétion de serveur de langage n'est disponible."

msgctxt "settings schema"
msgid "Displays a border on all sides except the left side of the thumb."
msgstr "Affiche une bordure sur tous les côtés sauf le côté gauche du curseur."

msgctxt "settings schema"
msgid "Displays a border on all sides except the right side of the thumb."
msgstr "Affiche une bordure sur tous les côtés sauf le côté droit du curseur."

msgctxt "settings schema"
msgid "Displays a border on all sides of the thumb."
msgstr "Affiche une bordure sur tous les côtés du curseur."

msgctxt "settings schema"
msgid "Displays a border only on the left side of the thumb."
msgstr "Affiche une bordure uniquement sur le côté gauche du curseur."

msgctxt "settings schema"
msgid "Displays file size in binary units (e.g., KiB, MiB)."
msgstr "Affiche la taille des fichiers en unités binaires (p. ex. Kio, Mio)."

msgctxt "settings schema"
msgid "Displays file size in decimal units (e.g., KB, MB)."
msgstr "Affiche la taille des fichiers en unités décimales (p. ex. Ko, Mo)."

msgctxt "settings schema"
msgid "Displays the thumb without any border."
msgstr "Affiche le curseur sans aucune bordure."

msgctxt "settings schema"
msgid "Do not draw any tabs or spaces."
msgstr "Ne dessine aucune tabulation ni espace."

msgctxt "settings schema"
msgid "Do not format code."
msgstr "Ne met pas en forme le code."

msgctxt "settings schema"
msgid "Do not load direnv configuration"
msgstr "Ne charge pas la configuration direnv"

msgctxt "settings schema"
msgid "Do not play any sound."
msgstr "Ne joue aucun son."

msgctxt "settings schema"
msgid "Do not query and display code lenses."
msgstr "N'interroge pas et n'affiche pas les CodeLens."

msgctxt "settings schema"
msgid "Do not query and render document colors."
msgstr "N'interroge pas et n'affiche pas les couleurs du document."

msgctxt "settings schema"
msgid "Do not render any background for indent guides."
msgstr "N'affiche pas d'arrière-plan pour les guides d'indentation."

msgctxt "settings schema"
msgid "Do not render any lines for indent guides."
msgstr "N'affiche pas de lignes pour les guides d'indentation."

msgctxt "settings schema"
msgid "Do not request folding ranges from language servers; use tree-sitter and indent-based folding."
msgstr "Ne demande pas les plages de repli aux serveurs de langage ; utilise le repli basé sur tree-sitter et l'indentation."

msgctxt "settings schema"
msgid "Do not request semantic tokens from language servers."
msgstr "Ne demande pas les jetons sémantiques aux serveurs de langage."

msgctxt "settings schema"
msgid "Do not show diagnostics."
msgstr "N'affiche pas les diagnostics."

msgctxt "settings schema"
msgid "Do not show snippets in the completion list"
msgstr "N'affiche pas les extraits de code dans la liste de complétion"

msgctxt "settings schema"
msgid "Don't list untracked files at all."
msgstr "Ne liste pas du tout les fichiers non suivis."

msgctxt "settings schema"
msgid "Don't use system clipboard."
msgstr "N'utilise pas le presse-papiers système."

msgctxt "settings schema"
msgid "Drag and drop related settings"
msgstr "Paramètres liés au glisser-déposer"

msgctxt "settings schema"
msgid "Draw a background behind the color text."
msgstr "Dessine un arrière-plan derrière le texte représentant la couleur."

msgctxt "settings schema"
msgid "Draw a border around the color text."
msgstr "Dessine une bordure autour du texte représentant la couleur."

msgctxt "settings schema"
msgid "Draw all invisible symbols."
msgstr "Affiche tous les symboles invisibles."

msgctxt "settings schema"
msgid "Draw whitespace only for the selected text."
msgstr "Affiche les espaces blancs uniquement pour le texte sélectionné."

msgctxt "settings schema"
msgid "Draw whitespaces at boundaries only.\n\nFor a whitespace to be on a boundary, any of the following conditions need to be met:\n- It is a tab\n- It is adjacent to an edge (start or end)\n- It is adjacent to a whitespace (left or right)"
msgstr "Dessine les espaces blancs uniquement aux limites.\n\nPour qu'un espace blanc soit à une limite, l'une des conditions suivantes doit être remplie :\n- C'est une tabulation\n- Il est adjacent à un bord (début ou fin)\n- Il est adjacent à un espace blanc (à gauche ou à droite)"

msgctxt "settings schema"
msgid "Draw whitespaces only after non-whitespace characters."
msgstr "Affiche les espaces blancs uniquement après les caractères autres que des espaces blancs."

msgctxt "settings schema"
msgid "EXPERIMENTAL: Overrides for the current theme.\n\nThese values will override the ones on the current theme specified in `theme`."
msgstr "EXPÉRIMENTAL : remplacements pour le thème actuel.\n\nCes valeurs remplacent celles du thème actuel spécifié dans `theme`."

msgctxt "settings schema"
msgid "Enables or disables auto-closing of JSX tags."
msgstr "Active ou désactive la fermeture automatique des balises JSX."

msgctxt "settings schema"
msgid "Enables or disables formatting with Prettier for a given language."
msgstr "Active ou désactive la mise en forme avec Prettier pour un langage donné."

msgctxt "settings schema"
msgid "Enterprise URI for Copilot.\n\nDefault: none"
msgstr "URI Enterprise pour Copilot.\n\nValeur par défaut : none"

msgctxt "settings schema"
msgid "Exclude files matching these glob patterns from file scans, file searches,\nand the project file tree. Takes precedence over `file_scan_inclusions`.\n\nDefault:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Exclut les fichiers correspondant à ces motifs glob des analyses de fichiers, des recherches de fichiers et de l'arborescence des fichiers du projet. Prioritaire sur `file_scan_inclusions`.\n\nValeur par défaut :\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUtilisez `\"...\"` pour ajouter des motifs sans répéter les valeurs par défaut de ForgeKairos. Dans les paramètres du projet, cela étend la valeur de la configuration utilisateur ou parente. Omettez `\"...\"` pour remplacer la liste héritée.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nLes motifs hérités sont insérés à la place de `\"...\"`, et les doublons conservent leur première occurrence."

msgctxt "settings schema"
msgid "Extends under the left dock while snapping to the right dock"
msgstr "S'étend sous le dock gauche en s'accrochant au dock droit"

msgctxt "settings schema"
msgid "Extends under the right dock while snapping to the left dock"
msgstr "S'étend sous le dock droit en s'accrochant au dock gauche"

msgctxt "settings schema"
msgid "Extra task variables to set for a particular language."
msgstr "Définit des variables de tâche supplémentaires pour un langage particulier."

msgctxt "settings schema"
msgid "Favorite models to show at the top of the model selector."
msgstr "Modèles favoris à afficher en haut du sélecteur de modèles."

msgctxt "settings schema"
msgid "Favorited values for session config options.\n\nThis is a map from config option ID to a list of favorited value IDs.\n\nDefault: {}"
msgstr "Valeurs favorites des options de configuration de session.\n\nIl s'agit d'une table associant l'ID d'une option de configuration à une liste d'ID de valeurs favorites.\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "File diff settings."
msgstr "Paramètres des différences du fichier."

msgctxt "settings schema"
msgid "File name for a new log. Supports the placeholders `{date}`, `{time}`,\n`{title}`, `{host}` and `{pid}`.\n\nDefault: \"{date}_{time}_{title}.log\""
msgstr "Nom de fichier d'un nouveau journal. Prend en charge les espaces réservés `{date}`, `{time}`, `{title}`, `{host}` et `{pid}`.\n\nValeur par défaut : \"{date}_{time}_{title}.log\""

msgctxt "settings schema"
msgid "Files larger than this many bytes are attached as an outline (their\nsymbols with line numbers) instead of their full content.\n\nDefault: 16384"
msgstr "Les fichiers dépassant ce nombre d'octets sont joints sous forme de structure (leurs symboles avec les numéros de ligne) au lieu de leur contenu complet.\n\nValeur par défaut : 16384"

msgctxt "settings schema"
msgid "Files should be formatted on save."
msgstr "Les fichiers doivent être mis en forme à l'enregistrement."

msgctxt "settings schema"
msgid "Files should be formatted using a code action executed by language servers."
msgstr "Les fichiers doivent être mis en forme à l'aide d'une action de code exécutée par les serveurs de langage."

msgctxt "settings schema"
msgid "Files should not be formatted on save."
msgstr "Les fichiers ne doivent pas être mis en forme à l'enregistrement."

msgctxt "settings schema"
msgid "Fill Color. Used for the accent fill color of an icon.\n\nThis might be used to show when a toggleable icon button is selected."
msgstr "Couleur de remplissage. Utilisée pour la couleur de remplissage d'accentuation d'une icône.\n\nPeut servir à indiquer qu'un bouton d'icône bascule est sélectionné."

msgctxt "settings schema"
msgid "Fill Color. Used for the default fill color of an icon."
msgstr "Couleur de remplissage. Utilisée pour la couleur de remplissage par défaut d'une icône."

msgctxt "settings schema"
msgid "Fill Color. Used for the disabled fill color of an icon.\n\nDisabled states are shown when a user cannot interact with an element, like a icon button."
msgstr "Couleur de remplissage. Utilisée pour la couleur de remplissage désactivée d'une icône.\n\nL'état désactivé est affiché lorsque l'utilisateur ne peut pas interagir avec un élément, comme un bouton d'icône."

msgctxt "settings schema"
msgid "Fill Color. Used for the muted or deemphasized fill color of an icon.\n\nThis might be used to show an icon in an inactive pane, or to deemphasize a series of icons to give them less visual weight."
msgstr "Couleur de remplissage. Utilisée pour la couleur de remplissage atténuée d'une icône.\n\nPeut servir à afficher une icône dans un volet inactif, ou à atténuer une série d'icônes pour leur donner moins de poids visuel."

msgctxt "settings schema"
msgid "Fill Color. Used for the placeholder fill color of an icon.\n\nThis might be used to show an icon in an input that disappears when the user enters text."
msgstr "Couleur de remplissage. Utilisée pour la couleur de remplissage d'une icône servant d'espace réservé.\n\nPeut servir à afficher dans un champ de saisie une icône qui disparaît lorsque l'utilisateur saisit du texte."

msgctxt "settings schema"
msgid "Filled background color for added diff hunk row highlights in the editor."
msgstr "Couleur d'arrière-plan pleine pour les surbrillances de lignes des blocs de modifications ajoutés dans l'éditeur."

msgctxt "settings schema"
msgid "Filled background color for deleted diff hunk row highlights in the editor."
msgstr "Couleur d'arrière-plan pleine pour les surbrillances de lignes des blocs de modifications supprimés dans l'éditeur."

msgctxt "settings schema"
msgid "Follow the visibility of the scrollbar."
msgstr "Suit la visibilité de la barre de défilement."

msgctxt "settings schema"
msgid "Font family name."
msgstr "Nom de la famille de polices."

msgctxt "settings schema"
msgid "Font weight value between 100 (thin) and 900 (black)"
msgstr "Valeur d'épaisseur de police entre 100 (fine) et 900 (noire)"

msgctxt "settings schema"
msgid "Forcefully enable or disable the scrollbar for each axis"
msgstr "Active ou désactive de force la barre de défilement pour chaque axe"

msgctxt "settings schema"
msgid "Forces Prettier integration to use a specific parser name when formatting files with the language."
msgstr "Force l'intégration Prettier à utiliser un nom d'analyseur spécifique lors de la mise en forme des fichiers de ce langage."

msgctxt "settings schema"
msgid "Forces Prettier integration to use specific plugins when formatting files with the language.\nThe default Prettier will be installed with these plugins."
msgstr "Force l'intégration de Prettier à utiliser des plug-ins précis lors de la mise en forme des fichiers de ce langage. Le Prettier par défaut est installé avec ces plug-ins."

msgctxt "settings schema"
msgid "Foreground color for Helix jump labels."
msgstr "Couleur de premier plan pour les étiquettes de saut Helix."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Normal mode indicator."
msgstr "Couleur de premier plan pour l'indicateur du mode Normal Helix de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Select mode indicator."
msgstr "Couleur de premier plan pour l'indicateur du mode Sélection Helix de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Insert mode indicator."
msgstr "Couleur de premier plan pour l'indicateur du mode Insertion de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Replace mode indicator."
msgstr "Couleur de premier plan pour l'indicateur du mode Remplacement de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Block mode indicator."
msgstr "Couleur de premier plan pour l'indicateur du mode Bloc Visuel de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Line mode indicator."
msgstr "Couleur de premier plan pour l'indicateur du mode Ligne Visuelle de Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual mode indicator."
msgstr "Couleur de premier plan pour l'indicateur du mode Visuel de Vim."

msgctxt "settings schema"
msgid "Format code using Zed's Prettier integration."
msgstr "Met en forme le code à l'aide de l'intégration Prettier de ForgeKairos."

msgctxt "settings schema"
msgid "Format code using a language server."
msgstr "Met en forme le code à l'aide d'un serveur de langage."

msgctxt "settings schema"
msgid "Format code using a specific language server."
msgstr "Met en forme le code à l'aide d'un serveur de langage spécifique."

msgctxt "settings schema"
msgid "Format code using an external command."
msgstr "Met en forme le code à l'aide d'une commande externe."

msgctxt "settings schema"
msgid "Format code using the current language server."
msgstr "Met en forme le code à l'aide du serveur de langage actuel."

msgctxt "settings schema"
msgid "Format files using Zed's Prettier integration (if applicable),\nor falling back to formatting via language server."
msgstr "Met en forme les fichiers avec l'intégration Prettier de ForgeKairos (le cas échéant), ou à défaut via le serveur de langage."

msgctxt "settings schema"
msgid "Git accounts a repository can commit and push as. Which one a repository\nuses is picked in the git panel and kept in `project_accounts`. An\naccount's token is kept in the operating system's credential store, never\nin this file.\n\nDefault: []"
msgstr "Comptes Git avec lesquels un dépôt peut valider et envoyer. Le compte utilisé par un dépôt est choisi dans le panneau Git et conservé dans `project_accounts`. Le jeton d'un compte est conservé dans le magasin d'identifiants du système d'exploitation, jamais dans ce fichier.\n\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Git blame settings."
msgstr "Paramètres du blame Git."

msgctxt "settings schema"
msgid "Global default permission when no tool-specific rules match.\nIndividual tools can override this with their own default.\nDefault: confirm"
msgstr "Autorisation globale par défaut lorsqu'aucune règle propre à un outil ne correspond. Chaque outil peut la remplacer par sa propre valeur par défaut.\nValeur par défaut : confirm"

msgctxt "settings schema"
msgid "Global switch to toggle hints on and off.\n\nDefault: false"
msgstr "Commutateur global pour activer ou désactiver les indications.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Global switch to toggle inline values on and off when debugging.\n\nDefault: true"
msgstr "Commutateur global pour activer ou désactiver les valeurs en ligne pendant le débogage.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Green ANSI terminal color."
msgstr "Couleur ANSI verte du terminal."

msgctxt "settings schema"
msgid "Gutter related settings"
msgstr "Paramètres liés à la gouttière"

msgctxt "settings schema"
msgid "HTTP/HTTPS proxy to use for Copilot.\n\nDefault: none"
msgstr "Proxy HTTP/HTTPS à utiliser pour Copilot.\n\nValeur par défaut : none"

msgctxt "settings schema"
msgid "Hide git gutter"
msgstr "Masque la gouttière Git"

msgctxt "settings schema"
msgid "Hide on typing and on key bindings that resolve to an action"
msgstr "Masque lors de la saisie et des combinaisons de touches associées à une action"

msgctxt "settings schema"
msgid "Hide only when typing"
msgstr "Masque uniquement lors de la saisie"

msgctxt "settings schema"
msgid "Hide the tab bar while the in-panel thread history is showing and the\npanel holds a single pane: the history lists the open tabs too, so the\nhorizontal row would say the same thing twice. Split the panel or close\nthe history and the tab bar comes back."
msgstr "Masque la barre d'onglets lorsque l'historique des conversations du panneau est affiché et que le panneau ne contient qu'un seul volet : l'historique liste aussi les onglets ouverts, et la rangée horizontale dirait deux fois la même chose. Fractionnez le panneau ou fermez l'historique pour que la barre d'onglets réapparaisse."

msgctxt "settings schema"
msgid "Hide the values of variables in `private` files, as defined by the\nprivate_files setting. This only changes the visual representation,\nthe values are still present in the file and can be selected / copied / pasted\n\nDefault: false"
msgstr "Masque les valeurs des variables dans les fichiers `private`, tels que définis par le paramètre private_files. Cela ne modifie que la représentation visuelle ; les valeurs restent présentes dans le fichier et peuvent être sélectionnées / copiées / collées\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Highlighted brackets background color.\n\nMatching brackets in the cursor scope are highlighted with this background color."
msgstr "Couleur d'arrière-plan des crochets mis en surbrillance.\n\nLes crochets correspondants dans la portée du curseur sont mis en surbrillance avec cette couleur d'arrière-plan."

msgctxt "settings schema"
msgid "Hollow background color for added diff hunk row highlights in the editor."
msgstr "Couleur d'arrière-plan creuse pour les surbrillances de lignes des blocs de modifications ajoutés dans l'éditeur."

msgctxt "settings schema"
msgid "Hollow background color for deleted diff hunk row highlights in the editor."
msgstr "Couleur d'arrière-plan creuse pour les surbrillances de lignes des blocs de modifications supprimés dans l'éditeur."

msgctxt "settings schema"
msgid "Hollow border color for added diff hunk row highlights in the editor."
msgstr "Couleur de bordure creuse pour les surbrillances de lignes des blocs de modifications ajoutés dans l'éditeur."

msgctxt "settings schema"
msgid "Hollow border color for deleted diff hunk row highlights in the editor."
msgstr "Couleur de bordure creuse pour les surbrillances de lignes des blocs de modifications supprimés dans l'éditeur."

msgctxt "settings schema"
msgid "Hollow box cursor."
msgstr "Curseur en rectangle creux."

msgctxt "settings schema"
msgid "Hosts that sandboxed terminal commands may always reach over the\nnetwork without prompting. Each entry is an exact hostname\n(`github.com`) or a leading-`*.` subdomain wildcard (`*.npmjs.org`).\nDefault: []"
msgstr "Hôtes que les commandes de terminal en bac à sable peuvent toujours joindre sur le réseau sans demande. Chaque entrée est un nom d'hôte exact (`github.com`) ou un caractère générique de sous-domaine commençant par `*.` (`*.npmjs.org`).\nValeur par défaut : []"

msgctxt "settings schema"
msgid "How and when the scrollbar should be displayed.\n\nDefault: inherits editor scrollbar settings"
msgstr "Comment et quand la barre de défilement doit être affichée.\n\nValeur par défaut : hérite des paramètres de barre de défilement de l'éditeur"

msgctxt "settings schema"
msgid "How entry statuses are displayed.\n\nDefault: icon"
msgstr "Manière dont les états des entrées sont affichés.\n\nValeur par défaut : icon"

msgctxt "settings schema"
msgid "How file paths are displayed in the git gutter.\n\nDefault: file_name_first"
msgstr "Manière dont les chemins de fichiers sont affichés dans la gouttière Git.\n\nValeur par défaut : file_name_first"

msgctxt "settings schema"
msgid "How hunks are displayed visually in the editor.\n\nDefault: staged_hollow"
msgstr "Manière dont les blocs de modifications sont affichés dans l'éditeur.\n\nValeur par défaut : staged_hollow"

msgctxt "settings schema"
msgid "How line endings should be handled for new files and during format and\nsave operations.\n\n- `detect`: Detect existing line endings and otherwise use the platform\n  default (`lf` on Unix, `crlf` on Windows).\n- `prefer_lf`: Prefer LF for new files and files with no existing line\n  ending.\n- `prefer_crlf`: Prefer CRLF for new files and files with no existing\n  line ending.\n- `enforce_lf`: Enforce LF during format and save.\n- `enforce_crlf`: Enforce CRLF during format and save.\n\nThe EditorConfig `end_of_line` property overrides this setting and\nbehaves like `enforce_lf` or `enforce_crlf`.\n\nDefault: detect"
msgstr "Manière dont les fins de ligne doivent être gérées pour les nouveaux fichiers et lors des opérations de mise en forme et d'enregistrement.\n\n- `detect` : détecte les fins de ligne existantes et utilise sinon la valeur par défaut de la plateforme (`lf` sous Unix, `crlf` sous Windows).\n- `prefer_lf` : préfère LF pour les nouveaux fichiers et les fichiers sans fin de ligne existante.\n- `prefer_crlf` : préfère CRLF pour les nouveaux fichiers et les fichiers sans fin de ligne existante.\n- `enforce_lf` : impose LF lors de la mise en forme et de l'enregistrement.\n- `enforce_crlf` : impose CRLF lors de la mise en forme et de l'enregistrement.\n\nLa propriété EditorConfig `end_of_line` remplace ce paramètre et se comporte comme `enforce_lf` ou `enforce_crlf`.\n\nValeur par défaut : detect"

msgctxt "settings schema"
msgid "How long \"go to definition\" waits for the language server before it\nalso offers the index's name matches, in milliseconds, from 100 to\n10000.\n\nDefault: 1500"
msgstr "Durée pendant laquelle \"atteindre la définition\" attend le serveur de langage avant de proposer aussi les correspondances de nom de l'index, en millisecondes, de 100 à 10000.\n\nValeur par défaut : 1500"

msgctxt "settings schema"
msgid "How many callers or callees of one function to list before a\n\"Show more\" row.\n\nDefault: 200"
msgstr "Nombre d'appelants ou d'appelés d'une fonction à lister avant une ligne \"Afficher plus\".\n\nValeur par défaut : 200"

msgctxt "settings schema"
msgid "How many characters has to be in the completions query to automatically show the words-based completions.\nBefore that value, it's still possible to trigger the words-based completion manually with the corresponding editor command.\n\nDefault: 3"
msgstr "Nombre de caractères que doit contenir la requête de complétion pour afficher automatiquement les complétions basées sur les mots. En deçà, il reste possible de déclencher manuellement la complétion basée sur les mots avec la commande d'éditeur correspondante.\n\nValeur par défaut : 3"

msgctxt "settings schema"
msgid "How many columns a tab should occupy.\n\nDefault: 4"
msgstr "Nombre de colonnes qu'une tabulation doit occuper.\n\nValeur par défaut : 4"

msgctxt "settings schema"
msgid "How many hours a session stays alive on the host with no terminal\nattached to it before its shell is ended. 0 keeps it forever.\n\nDefault: 24"
msgstr "Nombre d'heures pendant lesquelles une session reste active sur l'hôte sans terminal attaché avant que son shell soit terminé. 0 la conserve indéfiniment.\n\nValeur par défaut : 24"

msgctxt "settings schema"
msgid "How many lines of context to provide in multibuffer excerpts by default\n\nDefault: 2"
msgstr "Nombre de lignes de contexte à fournir par défaut dans les extraits du multi-tampon\n\nValeur par défaut : 2"

msgctxt "settings schema"
msgid "How many lines to expand the multibuffer excerpts by default\n\nDefault: 3"
msgstr "Nombre de lignes dont développer par défaut les extraits du multi-tampon\n\nValeur par défaut : 3"

msgctxt "settings schema"
msgid "How many minutes an external agent's connection is kept once no thread\nof that agent is open any more. The agent (and the sandbox it runs in)\nis stopped after that, and opening one of its threads again connects\nanew. `0` keeps every connection until the window closes.\n\nDefault: 5"
msgstr "Nombre de minutes pendant lesquelles la connexion d'un agent externe est conservée lorsqu'aucune conversation de cet agent n'est plus ouverte. L'agent (et le bac à sable dans lequel il s'exécute) est ensuite arrêté, et rouvrir l'une de ses conversations établit une nouvelle connexion. `0` conserve chaque connexion jusqu'à la fermeture de la fenêtre.\n\nValeur par défaut : 5"

msgctxt "settings schema"
msgid "How many threads clangd uses to build and index files (`-j`). Unset\nleaves clangd's own default. Values over 256 are treated as 256.\nIgnored when `lsp.clangd.binary.arguments` already has `-j`. Read from\nthe user's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Nombre de threads utilisés par clangd pour compiler et indexer les fichiers (`-j`). Non défini, la valeur par défaut de clangd est conservée. Les valeurs supérieures à 256 sont traitées comme 256. Ignoré lorsque `lsp.clangd.binary.arguments` contient déjà `-j`. Lu uniquement dans les paramètres de l'utilisateur, pas dans le `.zed/settings.json` d'un projet.\n\nValeur par défaut : null"

msgctxt "settings schema"
msgid "How much memory clangd, the C and C++ language server, may use."
msgstr "Quantité de mémoire que clangd, le serveur de langage C et C++, peut utiliser."

msgctxt "settings schema"
msgid "How much to fade out unused code."
msgstr "Niveau de fondu du code inutilisé."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel."
msgstr "Détermine l'affichage par défaut des blocs de réflexion dans le panneau de l'agent."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel.\n\nDefault: automatic"
msgstr "Manière dont les blocs de réflexion doivent être affichés par défaut dans le panneau de l'agent.\n\nValeur par défaut : automatic"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: split"
msgstr "Manière d'afficher les différences dans l'éditeur.\n\nValeur par défaut : split"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: unified"
msgstr "Manière d'afficher les différences dans l'éditeur.\n\nValeur par défaut : unified"

msgctxt "settings schema"
msgid "How to display the LSP item kind (function, method, variable, etc.)\nof each entry in the completions menu.\n\n- \"off\": do not display item kinds (default).\n- \"symbol\": display a single-letter badge, colorized based on the\n  active syntax theme.\n\nDefault: off"
msgstr "Manière d'afficher le type d'élément LSP (fonction, méthode, variable, etc.) de chaque entrée du menu de complétion.\n\n- \"off\" : n'affiche pas les types d'éléments (par défaut).\n- \"symbol\" : affiche un badge d'une lettre, coloré selon le thème syntaxique actif.\n\nValeur par défaut : off"

msgctxt "settings schema"
msgid "How to group entries in the git panel.\n\nDefault: status"
msgstr "Manière de regrouper les entrées dans le panneau Git.\n\nValeur par défaut : status"

msgctxt "settings schema"
msgid "How to highlight the current line in the editor.\n\nDefault: all"
msgstr "Manière de mettre en surbrillance la ligne actuelle dans l'éditeur.\n\nValeur par défaut : all"

msgctxt "settings schema"
msgid "How to highlight the current line in the minimap.\n\nDefault: inherits editor line highlights setting"
msgstr "Manière de mettre en surbrillance la ligne actuelle dans la minicarte.\n\nValeur par défaut : hérite du paramètre de surbrillance des lignes de l'éditeur"

msgctxt "settings schema"
msgid "How to indent soft-wrapped continuation lines.\n\nDefault: same"
msgstr "Détermine l'indentation des lignes de continuation du retour à la ligne automatique.\n\nValeur par défaut : same"

msgctxt "settings schema"
msgid "How to order sibling entries in the project panel.\n\nDefault: directories_first"
msgstr "Manière d'ordonner les entrées voisines dans le panneau de projet.\n\nValeur par défaut : directories_first"

msgctxt "settings schema"
msgid "How to perform a buffer format.\n\nDefault: auto"
msgstr "Manière d'effectuer la mise en forme d'un tampon.\n\nValeur par défaut : auto"

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor."
msgstr "Détermine le rendu des couleurs LSP `textDocument/documentColor` dans l'éditeur."

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor.\n\nDefault: [`DocumentColorsRenderMode::Inlay`]"
msgstr "Manière d'afficher les couleurs LSP `textDocument/documentColor` dans l'éditeur.\n\nValeur par défaut : [`DocumentColorsRenderMode::Inlay`]"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference\n(e.g. Go to Definition, Go to Type Definition, Find All References).\n\nDefault: center"
msgstr "Manière de faire défiler la cible dans la vue lors de la navigation vers une définition ou une référence (p. ex. Atteindre la définition, Atteindre la définition de type, Rechercher toutes les références).\n\nValeur par défaut : center"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference.\n\nDefault: center"
msgstr "Manière de faire défiler la cible dans la vue lors de la navigation vers une définition ou une référence.\n\nValeur par défaut : center"

msgctxt "settings schema"
msgid "How to soft-wrap long lines of text.\n\nDefault: none"
msgstr "Manière d'appliquer le retour à la ligne automatique aux longues lignes de texte.\n\nValeur par défaut : none"

msgctxt "settings schema"
msgid "How to sort entries in the git panel.\n\nDefault: path"
msgstr "Manière de trier les entrées dans le panneau Git.\n\nValeur par défaut : path"

msgctxt "settings schema"
msgid "IDs of the tools not to suggest (`clangd`, `clang-format`, `ruff` and so\non). \"Don't show again\" in the notification adds a tool here.\n\nDefault: []"
msgstr "ID des outils à ne pas suggérer (`clangd`, `clang-format`, `ruff`, etc.). Le bouton \"Ne plus afficher\" de la notification ajoute un outil ici.\n\nValeur par défaut : []"

msgctxt "settings schema"
msgid "IMDSv2, PodIdentity, env vars, etc."
msgstr "IMDSv2, PodIdentity, variables d'environnement, etc."

msgctxt "settings schema"
msgid "Icon Theme Name"
msgstr "Nom du thème d'icônes"

msgctxt "settings schema"
msgid "If enabled, Zed will download its own copy of Node."
msgstr "Si cette option est activée, ForgeKairos télécharge sa propre copie de Node."

msgctxt "settings schema"
msgid "If provider supports it, display inline when holding modifier key (e.g., alt).\nOtherwise, eager preview is used."
msgstr "Si le fournisseur le prend en charge, affiche en ligne lorsque la touche de modification est maintenue (p. ex. alt). Sinon, l'aperçu immédiat est utilisé."

msgctxt "settings schema"
msgid "If the server supports sending tasks over LSP extensions,\nthis setting can be used to enable or disable them in Zed.\nDefault: true"
msgstr "Si le serveur prend en charge l'envoi de tâches via des extensions LSP, ce paramètre permet de les activer ou de les désactiver dans ForgeKairos.\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Ignored version control color."
msgstr "Couleur de contrôle de version pour les éléments ignorés."

msgctxt "settings schema"
msgid "Include files matching these glob patterns when scanning, even if ignored\nby Git. Note that broad patterns can slow file scanning.\n`file_scan_exclusions` takes precedence.\n\nDefault:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Inclut lors de l'analyse les fichiers correspondant à ces motifs glob, même s'ils sont ignorés par Git. Notez que des motifs larges peuvent ralentir l'analyse des fichiers. `file_scan_exclusions` est prioritaire.\n\nValeur par défaut :\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUtilisez `\"...\"` pour ajouter des motifs sans répéter les valeurs par défaut de ForgeKairos. Dans les paramètres du projet, cela étend la valeur de la configuration utilisateur ou parente. Omettez `\"...\"` pour remplacer la liste héritée.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nLes motifs hérités sont insérés à la place de `\"...\"`, et les doublons conservent leur première occurrence."

msgctxt "settings schema"
msgid "Indent guide related settings."
msgstr "Paramètres relatifs aux guides d'indentation."

msgctxt "settings schema"
msgid "Index a worktree once it has C or C++ files."
msgstr "Indexe une arborescence de travail dès qu'elle contient des fichiers C ou C++."

msgctxt "settings schema"
msgid "Index only the open files."
msgstr "Indexe uniquement les fichiers ouverts."

msgctxt "settings schema"
msgid "Index the whole project in the background (clangd's default)."
msgstr "Indexe tout le projet en arrière-plan (comportement par défaut de clangd)."

msgctxt "settings schema"
msgid "Indicates a changed or altered status, like a file that has been edited."
msgstr "Indique un état modifié ou altéré, comme un fichier qui a été édité."

msgctxt "settings schema"
msgid "Indicates a hint or some kind of additional information."
msgstr "Signale une indication ou des informations supplémentaires."

msgctxt "settings schema"
msgid "Indicates a successful operation or task completion."
msgstr "Indique une opération réussie ou l'achèvement d'une tâche."

msgctxt "settings schema"
msgid "Indicates a system error, a failed operation or a diagnostic error."
msgstr "Indique une erreur système, une opération échouée ou une erreur de diagnostic."

msgctxt "settings schema"
msgid "Indicates some kind of conflict, like a file changed on disk while it was open, or\nmerge conflicts in a Git repository."
msgstr "Indique un conflit, comme un fichier modifié sur le disque alors qu'il était ouvert, ou des conflits de fusion dans un dépôt Git."

msgctxt "settings schema"
msgid "Indicates some kind of unreachable status, like a block of code that can never be reached."
msgstr "Indique un type d'état inaccessible, comme un bloc de code qui ne peut jamais être atteint."

msgctxt "settings schema"
msgid "Indicates something new, like a new file added to a Git repository."
msgstr "Indique quelque chose de nouveau, comme un nouveau fichier ajouté à un dépôt Git."

msgctxt "settings schema"
msgid "Indicates something that is predicted, like automatic code completion, or generated code."
msgstr "Indique quelque chose de prédit, comme la complétion automatique de code ou le code généré."

msgctxt "settings schema"
msgid "Indicates that something is deliberately ignored, such as a file or operation ignored by Git."
msgstr "Indique que quelque chose est délibérément ignoré, comme un fichier ou une opération ignorés par Git."

msgctxt "settings schema"
msgid "Indicates that something no longer exists, like a deleted file."
msgstr "Indique que quelque chose n'existe plus, comme un fichier supprimé."

msgctxt "settings schema"
msgid "Indicates whether this custom model supports caching."
msgstr "Indique si ce modèle personnalisé prend en charge la mise en cache."

msgctxt "settings schema"
msgid "Inherit cursor shape from the editor's base cursor_shape setting."
msgstr "Hérite de la forme du curseur depuis le paramètre cursor_shape de base de l'éditeur."

msgctxt "settings schema"
msgid "Inlay hint related settings."
msgstr "Paramètres relatifs aux indications intégrées."

msgctxt "settings schema"
msgid "Jupyter REPL settings."
msgstr "Paramètres du REPL Jupyter."

msgctxt "settings schema"
msgid "Keep model alive for N seconds"
msgstr "Maintient le modèle actif pendant N secondes"

msgctxt "settings schema"
msgid "Keep model alive for a fixed duration. Accepts durations like \"5m\", \"10m\", \"1h\", \"1d\", etc."
msgstr "Maintient le modèle actif pendant une durée fixe. Accepte des durées telles que \"5m\", \"10m\", \"1h\", \"1d\", etc."

msgctxt "settings schema"
msgid "Keep the tab bar hidden, leaving the in-panel thread history as the way\nto the open tabs. A panel too narrow to show that list, or the strip\nthat brings it back, still gets the tab bar: otherwise nothing would\nreach the tabs that are not in front."
msgstr "Garde la barre d'onglets masquée, l'historique des conversations du panneau restant le moyen d'accéder aux onglets ouverts. Un panneau trop étroit pour afficher cette liste, ou la bande qui la fait revenir, obtient quand même la barre d'onglets : sinon, rien ne permettrait d'atteindre les onglets qui ne sont pas au premier plan."

msgctxt "settings schema"
msgid "Keeps the changes in the working tree, unstaged."
msgstr "Conserve les modifications dans la copie de travail, non indexées."

msgctxt "settings schema"
msgid "Keeps the changes staged."
msgstr "Conserve les modifications indexées."

msgctxt "settings schema"
msgid "Language server settings.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Paramètres du serveur de langage.\n\nRéf. : https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsultez la documentation du serveur de langage concerné pour connaître les paramètres pris en charge."

msgctxt "settings schema"
msgid "Language servers from extensions that keep running while their\nworktree's code is paused, by name (for example `\"gopls\"`). Other\nextensions' servers stop until the worktree is resumed. Read from the\nuser settings file only.\n\nDefault: []"
msgstr "Serveurs de langage d'extensions qui continuent de s'exécuter pendant que le code de leur arborescence de travail est en pause, par nom (p. ex. `\"gopls\"`). Les serveurs des autres extensions s'arrêtent jusqu'à la reprise de l'arborescence de travail. Lu uniquement dans le fichier de paramètres utilisateur.\n\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Largest outline sent for one file, in bytes. Deeper symbols are\ndropped first when an outline does not fit.\n\nDefault: 8192"
msgstr "Plus grande structure envoyée pour un fichier, en octets. Les symboles les plus profonds sont abandonnés en premier lorsqu'une structure ne tient pas.\n\nValeur par défaut : 8192"

msgctxt "settings schema"
msgid "Largest part of a fetched web page that is attached, in bytes.\n\nDefault: 32768"
msgstr "Plus grande partie d'une page Web récupérée qui est jointe, en octets.\n\nValeur par défaut : 32768"

msgctxt "settings schema"
msgid "Layout mode for the bottom dock\n\nDefault: contained"
msgstr "Mode de disposition du dock inférieur\n\nValeur par défaut : contained"

msgctxt "settings schema"
msgid "Leave the slot empty: the dock shows a single panel, as upstream Zed\ndoes, or none at all."
msgstr "Laisse l'emplacement vide : le dock affiche un seul panneau, comme Zed en amont, ou aucun."

msgctxt "settings schema"
msgid "Leave the window open when there are no tabs"
msgstr "Laisse la fenêtre ouverte quand il n'y a plus d'onglets"

msgctxt "settings schema"
msgid "Limits on how much of an attachment (a file, a directory, a selection,\na fetched page, diagnostics or a branch diff) is sent to the agent.\nAnything over these limits is sent as an outline or a reference the\nagent can follow up on instead of in full."
msgstr "Limites de la quantité d'une pièce jointe (un fichier, un répertoire, une sélection, une page récupérée, des diagnostics ou les différences d'une branche) envoyée à l'agent. Tout ce qui dépasse ces limites est envoyé sous forme de structure ou de référence que l'agent peut consulter ensuite, plutôt qu'en entier."

msgctxt "settings schema"
msgid "List every file inside untracked directories."
msgstr "Liste tous les fichiers des répertoires non suivis."

msgctxt "settings schema"
msgid "List untracked directories, but not the files inside them."
msgstr "Liste les répertoires non suivis, mais pas les fichiers qu'ils contiennent."

msgctxt "settings schema"
msgid "Load direnv configuration directly using `direnv export json`"
msgstr "Charge la configuration direnv directement avec `direnv export json`"

msgctxt "settings schema"
msgid "Load direnv configuration through a shell hook"
msgstr "Charge la configuration direnv via un hook de shell"

msgctxt "settings schema"
msgid "Local overrides for feature flags, keyed by flag name."
msgstr "Remplacements locaux des indicateurs de fonctionnalité, indexés par nom d'indicateur."

msgctxt "settings schema"
msgid "Looks up references of the same symbol instead."
msgstr "Recherche plutôt les références du même symbole."

msgctxt "settings schema"
msgid "Lowercase names are grouped before uppercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Les noms en minuscules sont regroupés avant les noms en majuscules, avec un tri naturel insensible à la casse dans chaque groupe. Les noms commençant par un point sont triés avant les deux groupes."

msgctxt "settings schema"
msgid "Magenta ANSI terminal color."
msgstr "Couleur magenta ANSI du terminal."

msgctxt "settings schema"
msgid "Map from language name to file patterns."
msgstr "Table de correspondance entre le nom du langage et les motifs de fichiers."

msgctxt "settings schema"
msgid "Map from language name to settings."
msgstr "Table de correspondance entre le nom du langage et les paramètres."

msgctxt "settings schema"
msgid "Match platform conventions by default, so \"on\" on macOS and \"off\" everywhere else"
msgstr "Respecte les conventions de la plateforme par défaut, donc \"on\" sur macOS et \"off\" partout ailleurs"

msgctxt "settings schema"
msgid "Match platform conventions by default, so don't quit on macOS, and quit on other platforms"
msgstr "Respecte les conventions de la plateforme par défaut, donc ne quitte pas sur macOS et quitte sur les autres plateformes"

msgctxt "settings schema"
msgid "Match the system's configured behavior."
msgstr "Suit le comportement configuré du système."

msgctxt "settings schema"
msgid "Maximum content width in pixels for the agent panel. Content will be\ncentered when the panel is wider than this value.\n\nDefault: 850"
msgstr "Largeur maximale du contenu en pixels pour le panneau de l'agent. Le contenu est centré lorsque le panneau est plus large que cette valeur.\n\nValeur par défaut : 850"

msgctxt "settings schema"
msgid "Maximum directory depth to eagerly index outside of git repositories;\ncontents of directories at this depth or deeper are indexed on demand.\nRepositories rooted shallower than this depth are always indexed fully.\nIn projects that are not rooted at a git repository, repositories directly\ninside a root folder activate their git features immediately; deeper ones\nactivate on first use.\n`0` means no limit and activates all git repositories immediately.\n\nDefault: 5"
msgstr "Profondeur maximale de répertoire à indexer immédiatement hors des dépôts Git ; le contenu des répertoires à cette profondeur ou plus profonds est indexé à la demande. Les dépôts dont la racine est moins profonde que cette valeur sont toujours entièrement indexés. Dans les projets dont la racine n'est pas un dépôt Git, les dépôts situés directement dans un dossier racine activent immédiatement leurs fonctionnalités Git ; les plus profonds les activent à la première utilisation. `0` signifie aucune limite et active immédiatement tous les dépôts Git.\n\nValeur par défaut : 5"

msgctxt "settings schema"
msgid "Maximum length of the commit message title before a warning is shown.\nSet to 0 to disable.\n\nDefault: 0"
msgstr "Longueur maximale du titre du message de validation avant l'affichage d'un avertissement. Définissez 0 pour désactiver.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "Maximum number of characters for an output to be shown inline.\nOnly applies when `inline_output` is true.\n\nDefault: 50"
msgstr "Nombre maximal de caractères pour qu'une sortie soit affichée en ligne. Ne s'applique que lorsque `inline_output` vaut true.\n\nValeur par défaut : 50"

msgctxt "settings schema"
msgid "Maximum number of columns to display in the minimap.\n\nDefault: 80"
msgstr "Nombre maximal de colonnes à afficher dans la minicarte.\n\nValeur par défaut : 80"

msgctxt "settings schema"
msgid "Maximum number of columns to keep in REPL's scrollback buffer.\nClamped with [20, 512] range.\n\nDefault: 128"
msgstr "Nombre maximal de colonnes à conserver dans le tampon d'historique du REPL. Limité à la plage [20, 512].\n\nValeur par défaut : 128"

msgctxt "settings schema"
msgid "Maximum number of idle threads with loadable sessions to retain in the\nagent panel. Set to 0 to unload every eligible idle thread when it is\nno longer active.\n\nDefault: 5"
msgstr "Le nombre maximal de conversations inactives aux sessions rechargeables à conserver dans le panneau de l'agent. Avec 0, chaque conversation inactive concernée est déchargée dès qu'elle n'est plus active.\n\nValeur par défaut : 5"

msgctxt "settings schema"
msgid "Maximum number of lines of output to display before scrolling.\nSet to 0 to disable output height limits.\n\nDefault: 0"
msgstr "Nombre maximal de lignes de sortie à afficher avant le défilement. Définissez 0 pour désactiver les limites de hauteur de la sortie.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "Maximum number of lines to keep in REPL's scrollback buffer.\nClamped with [4, 256] range.\n\nDefault: 32"
msgstr "Nombre maximal de lignes à conserver dans le tampon d'historique du REPL. Limité à la plage [4, 256].\n\nValeur par défaut : 32"

msgctxt "settings schema"
msgid "Maximum open tabs in a pane. Will not close an unsaved\ntab. Set to `None` for unlimited tabs.\n\nDefault: none"
msgstr "Nombre maximal d'onglets ouverts dans un volet. Un onglet non enregistré n'est jamais fermé. Définissez `None` pour un nombre illimité d'onglets.\n\nValeur par défaut : none"

msgctxt "settings schema"
msgid "Maximum tokens to generate for FIM models and self-hosted Sweep rewrite responses.\n\nDefault: 256"
msgstr "Nombre maximal de jetons à générer pour les modèles FIM et les réponses de réécriture de Sweep auto-hébergé.\n\nValeur par défaut : 256"

msgctxt "settings schema"
msgid "Maximum tokens to generate.\n\nDefault: 150"
msgstr "Nombre maximal de jetons à générer.\n\nValeur par défaut : 150"

msgctxt "settings schema"
msgid "Minimap related settings"
msgstr "Paramètres relatifs à la minicarte"

msgctxt "settings schema"
msgid "Minimum APCA perceptual contrast for text over highlight backgrounds.\n\nValid range: 0.0 to 106.0\nDefault: 45.0"
msgstr "Contraste perceptuel APCA minimal du texte sur les arrière-plans en surbrillance.\n\nPlage valide : 0.0 à 106.0\nValeur par défaut : 45.0"

msgctxt "settings schema"
msgid "Minimum number of characters to reserve space for in the gutter.\n\nDefault: 4"
msgstr "Nombre minimal de caractères pour lesquels réserver de l'espace dans la gouttière.\n\nValeur par défaut : 4"

msgctxt "settings schema"
msgid "Minimum number of lines of height the agent message editor should have.\n\nDefault: 4"
msgstr "Hauteur minimale, en lignes, de l'éditeur de messages de l'agent.\n\nValeur par défaut : 4"

msgctxt "settings schema"
msgid "Minimum time to wait before pulling diagnostics from the language server(s).\n0 turns the debounce off.\n\nDefault: 50"
msgstr "Délai minimal avant de récupérer les diagnostics du ou des serveurs de langage. 0 désactive l'anti-rebond.\n\nValeur par défaut : 50"

msgctxt "settings schema"
msgid "Mix directories and files together"
msgstr "Mélange les répertoires et les fichiers"

msgctxt "settings schema"
msgid "Model that judges whether a tool action is dangerous when the tool\npermission mode is `auto`. Defaults to the fast model, then to\ndefault_model, when not specified."
msgstr "Modèle qui juge si une action d'outil est dangereuse lorsque le mode d'autorisation des outils est `auto`. Utilise par défaut le modèle rapide, puis default_model, s'il n'est pas spécifié."

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: \"codestral-latest\""
msgstr "Modèle à utiliser pour les complétions.\n\nValeur par défaut : \"codestral-latest\""

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: none"
msgstr "Modèle à utiliser pour les complétions.\n\nValeur par défaut : none"

msgctxt "settings schema"
msgid "Model to use for context compaction (`/compact` and auto-compaction).\nFalls back to the thread's currently selected model when not specified.\nIf the configured model is unavailable (provider not registered, model\nnot found), the thread's current model is used instead."
msgstr "Modèle à utiliser pour le compactage du contexte (`/compact` et compactage automatique). À défaut, le modèle actuellement sélectionné de la conversation est utilisé. Si le modèle configuré n'est pas disponible (fournisseur non enregistré, modèle introuvable), le modèle actuel de la conversation est utilisé à la place."

msgctxt "settings schema"
msgid "Model to use for generating git commit messages. Defaults to default_model when not specified."
msgstr "Modèle à utiliser pour générer les messages de validation Git. Par défaut, utilise default_model lorsque non spécifié."

msgctxt "settings schema"
msgid "Model to use for generating thread summaries. Defaults to default_model when not specified."
msgstr "Modèle à utiliser pour générer les résumés de conversation. Utilise default_model si non spécifié."

msgctxt "settings schema"
msgid "Model to use for the inline assistant when streaming tools are enabled.\n\nDefault: true"
msgstr "Modèle à utiliser pour l'assistant en ligne lorsque les outils en streaming sont activés.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Model to use for the inline assistant. Defaults to default_model when not specified."
msgstr "Modèle à utiliser pour l'assistant en ligne. Utilise default_model si non spécifié."

msgctxt "settings schema"
msgid "Modified version control color."
msgstr "Couleur de contrôle de version pour les éléments modifiés."

msgctxt "settings schema"
msgid "Most files whose diagnostics are attached with a diagnostics mention.\n\nDefault: 50"
msgstr "Nombre maximal de fichiers dont les diagnostics sont joints avec une mention de diagnostics.\n\nValeur par défaut : 50"

msgctxt "settings schema"
msgid "Name to use for this server in UI."
msgstr "Nom à afficher pour ce serveur dans l'interface."

msgctxt "settings schema"
msgid "Never allow training data collection."
msgstr "N'autorise jamais la collecte de données d'entraînement."

msgctxt "settings schema"
msgid "Never blink the cursor, ignoring the terminal mode."
msgstr "Ne fait jamais clignoter le curseur, quel que soit le mode du terminal."

msgctxt "settings schema"
msgid "Never fetch or complete document's words for completions.\n(Word-based completions can still be queried via a separate action)"
msgstr "Ne récupère ni ne complète jamais les mots du document pour les complétions. (Les complétions basées sur les mots peuvent toujours être demandées via une action distincte)"

msgctxt "settings schema"
msgid "Never hide the mouse cursor"
msgstr "Ne masque jamais le curseur de la souris"

msgctxt "settings schema"
msgid "Never index the worktree."
msgstr "N'indexe jamais l'arborescence de travail."

msgctxt "settings schema"
msgid "Never populate the search query"
msgstr "Ne remplit jamais la requête de recherche"

msgctxt "settings schema"
msgid "Never reduce motion"
msgstr "Ne réduit jamais les animations"

msgctxt "settings schema"
msgid "Never show the minimap."
msgstr "N'affiche jamais la minicarte."

msgctxt "settings schema"
msgid "Never show the scrollbar."
msgstr "N'affiche jamais la barre de défilement."

msgctxt "settings schema"
msgid "No automatic indentation. New lines start at column 0."
msgstr "Aucune indentation automatique. Les nouvelles lignes commencent à la colonne 0."

msgctxt "settings schema"
msgid "Normalize line endings to CRLF (`\\r\\n`) during format and save."
msgstr "Normalise les fins de ligne en CRLF (`\\r\\n`) lors de la mise en forme et de l'enregistrement."

msgctxt "settings schema"
msgid "Normalize line endings to LF (`\\n`) during format and save."
msgstr "Normalise les fins de ligne en LF (`\\n`) lors de la mise en forme et de l'enregistrement."

msgctxt "settings schema"
msgid "Number of lines to search for modelines at the beginning and end of files.\nModelines contain editor directives (e.g., vim/emacs settings) that configure\nthe editor behavior for specific files.\n\nDefault: 5"
msgstr "Nombre de lignes dans lesquelles rechercher des lignes de mode au début et à la fin des fichiers. Les lignes de mode contiennent des directives d'éditeur (p. ex. paramètres vim/emacs) qui configurent le comportement de l'éditeur pour des fichiers précis.\n\nValeur par défaut : 5"

msgctxt "settings schema"
msgid "Ollama model name for edit predictions."
msgstr "Nom du modèle Ollama pour les prédictions de modification."

msgctxt "settings schema"
msgid "One of `sftp`, `scp`, `ftp` or `ftps`. Any other value means SFTP."
msgstr "L'un de `sftp`, `scp`, `ftp` ou `ftps`. Toute autre valeur signifie SFTP."

msgctxt "settings schema"
msgid "Only if LSP response errors or times out,\nuse document's words to show completions."
msgstr "Uniquement si la réponse LSP échoue ou expire, utilise les mots du document pour afficher des complétions."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nIf no git diff is available (e.g., when source control is\nunavailable) or if the LSP doesn't support range formatting,\nfalls back to formatting the whole file."
msgstr "Seules les lignes comportant des modifications non indexées sont mises en forme à l'enregistrement. Si aucun diff Git n'est disponible (p. ex. lorsque le contrôle de code source n'est pas disponible) ou si le LSP ne prend pas en charge la mise en forme de plages, le fichier entier est mis en forme."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nRequires source control and LSP range formatting support.\nIf no git diff is available or if the LSP doesn't support\nrange formatting, formatting is skipped."
msgstr "Seules les lignes comportant des modifications non indexées sont mises en forme à l'enregistrement. Nécessite le contrôle de code source et la prise en charge de la mise en forme de plages par le LSP. Si aucun diff Git n'est disponible ou si le LSP ne prend pas en charge la mise en forme de plages, la mise en forme est ignorée."

msgctxt "settings schema"
msgid "Only populate the search query when there is text selected."
msgstr "Remplit la requête de recherche uniquement lorsqu'un texte est sélectionné."

msgctxt "settings schema"
msgid "Only rewrap within comments."
msgstr "Effectue le renvoi à la ligne uniquement dans les commentaires."

msgctxt "settings schema"
msgid "Only rewrap within the current selection(s)."
msgstr "Effectue le renvoi à la ligne uniquement dans la sélection en cours."

msgctxt "settings schema"
msgid "Only scan symlinked directories when they've been expanded in the workspace"
msgstr "Analyse les répertoires liés symboliquement uniquement lorsqu'ils ont été développés dans l'espace de travail"

msgctxt "settings schema"
msgid "Only the language server."
msgstr "Uniquement le serveur de langage."

msgctxt "settings schema"
msgid "Only the symbol index's name matches."
msgstr "Uniquement les correspondances de nom de l'index des symboles."

msgctxt "settings schema"
msgid "Opacity of inactive panels.\nWhen set to 1.0, the inactive panes have the same opacity as the active one.\nIf set to 0, the inactive panes content will not be visible at all.\nValues are clamped to the [0.0, 1.0] range.\n\nDefault: `1.0`"
msgstr "Opacité des panneaux inactifs. Avec 1.0, les volets inactifs ont la même opacité que le volet actif. Avec 0, le contenu des volets inactifs n'est pas visible du tout. Les valeurs sont limitées à la plage [0.0, 1.0].\n\nValeur par défaut : `1.0`"

msgctxt "settings schema"
msgid "Opacity of the inactive panes. 0 means transparent, 1 means opaque.\n\nValid range: 0.0 to 1.0\nDefault: 1.0"
msgstr "Opacité des volets inactifs. 0 signifie transparent, 1 signifie opaque.\n\nPlage valide : 0.0 à 1.0\nValeur par défaut : 1.0"

msgctxt "settings schema"
msgid "Open a single-file diff view."
msgstr "Ouvre une vue des différences pour un seul fichier."

msgctxt "settings schema"
msgid "Open directories as a new workspace in the current Zed window's sidebar."
msgstr "Ouvre les répertoires comme un nouvel espace de travail dans la barre latérale de la fenêtre ForgeKairos active."

msgctxt "settings schema"
msgid "Open paths in a new window unless they are subpaths of an existing project."
msgstr "Ouvre les chemins d'accès dans une nouvelle fenêtre, sauf s'ils sont des sous-chemins d'un projet existant."

msgctxt "settings schema"
msgid "Open projects in a new window."
msgstr "Ouvre les projets dans une nouvelle fenêtre."

msgctxt "settings schema"
msgid "Open projects in the current Zed window."
msgstr "Ouvre les projets dans la fenêtre ForgeKairos actuelle."

msgctxt "settings schema"
msgid "Open the excerpt clicked as a new buffer in the new tab, if no `alt` modifier was pressed during double click.\nOtherwise, behave as a regular buffer and select the whole word."
msgstr "Ouvre l'extrait cliqué en tant que nouveau tampon dans le nouvel onglet, si aucun modificateur `alt` n'a été pressé pendant le double-clic. Sinon, se comporte comme un tampon normal et sélectionne le mot entier."

msgctxt "settings schema"
msgid "Open the file in the editor without a diff view."
msgstr "Ouvre le fichier dans l'éditeur sans vue des différences."

msgctxt "settings schema"
msgid "Open the project diff, showing all changed files."
msgstr "Ouvre les différences du projet, affichant tous les fichiers modifiés."

msgctxt "settings schema"
msgid "Open the results in a filterable picker."
msgstr "Ouvre les résultats dans un sélecteur filtrable."

msgctxt "settings schema"
msgid "Open the results in a multibuffer."
msgstr "Ouvre les résultats dans un multi-tampon."

msgctxt "settings schema"
msgid "Optional headers to send."
msgstr "En-têtes optionnels à envoyer."

msgctxt "settings schema"
msgid "Options passed to the language server at startup.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Options transmises au serveur de langage au démarrage.\n\nRéf. : https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsultez la documentation du serveur de langage concerné pour connaître les paramètres pris en charge."

msgctxt "settings schema"
msgid "Override this model with a different Anthropic model for tool calls."
msgstr "Remplace ce modèle par un autre modèle Anthropic pour les appels d'outils."

msgctxt "settings schema"
msgid "Overrides per theme\n\nThese values will override the ones on the specified theme"
msgstr "Remplacements par thème\n\nCes valeurs remplacent celles du thème spécifié"

msgctxt "settings schema"
msgid "Overrides the context length reported for every llama.cpp model."
msgstr "Pour chaque modèle llama.cpp, remplace la longueur de contexte signalée."

msgctxt "settings schema"
msgid "Panel stacked beside it, or `none` for a single panel as upstream Zed\nshows.\n\nDefault: browser"
msgstr "Panneau empilé à côté, ou `none` pour un seul panneau comme dans Zed en amont.\n\nValeur par défaut : browser"

msgctxt "settings schema"
msgid "Panel that fills that dock, or `none` to leave the dock as it was.\n\nDefault: agent"
msgstr "Panneau qui remplit ce dock, ou `none` pour laisser le dock tel quel.\n\nValeur par défaut : agent"

msgctxt "settings schema"
msgid "Per-tool permission rules for granular control over which tool actions\nrequire confirmation.\n\nThe global `default` applies when no tool-specific rules match.\nFor external agent servers (e.g. Claude Agent) that define their own\npermission modes, \"deny\" and \"confirm\" still take precedence — the\nexternal agent's permission system is only used when Zed would allow\nthe action. Per-tool regex patterns (`always_allow`, `always_deny`,\n`always_confirm`) match against the tool's text input (command, path,\nURL, etc.)."
msgstr "Règles d'autorisation par outil, pour contrôler finement quelles actions d'outils nécessitent une confirmation.\n\nLe `default` global s'applique lorsqu'aucune règle propre à un outil ne correspond. Pour les serveurs d'agents externes (p. ex. Claude Agent) qui définissent leurs propres modes d'autorisation, \"deny\" et \"confirm\" restent prioritaires : le système d'autorisation de l'agent externe n'est utilisé que lorsque ForgeKairos autoriserait l'action. Les motifs d'expression régulière par outil (`always_allow`, `always_deny`, `always_confirm`) sont comparés à l'entrée textuelle de l'outil (commande, chemin, URL, etc.)."

msgctxt "settings schema"
msgid "Per-tool permission rules.\nKeys are tool names (e.g. terminal, edit_file, fetch) including MCP\ntools (e.g. mcp:server_name:tool_name). Any tool name is accepted;\neven tools without meaningful text input can have a `default` set."
msgstr "Règles d'autorisation par outil. Les clés sont des noms d'outils (p. ex. terminal, edit_file, fetch), y compris les outils MCP (p. ex. mcp:server_name:tool_name). Tout nom d'outil est accepté ; même les outils sans entrée textuelle significative peuvent avoir un `default` défini."

msgctxt "settings schema"
msgid "Persistent sandbox permission grants for agent-run terminal commands.\nThese are populated when choosing \"Allow always\" from a sandbox\nescalation prompt."
msgstr "Autorisations persistantes du bac à sable pour les commandes de terminal exécutées par l'agent. Elles sont ajoutées lorsque vous choisissez \"Toujours autoriser\" dans une demande d'élévation du bac à sable."

msgctxt "settings schema"
msgid "Place snippets at the bottom of the completion list"
msgstr "Place les extraits de code en bas de la liste de complétion"

msgctxt "settings schema"
msgid "Place snippets at the top of the completion list"
msgstr "Place les extraits de code en haut de la liste de complétion"

msgctxt "settings schema"
msgid "Play an OS-specific alert sound."
msgstr "Joue un son d'alerte propre au système d'exploitation."

msgctxt "settings schema"
msgid "Position of the close button in a tab.\n\nDefault: right"
msgstr "Position du bouton de fermeture dans un onglet.\n\nValeur par défaut : right"

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for MCP servers that don't support\nDynamic Client Registration."
msgstr "Identifiants de client OAuth préenregistrés pour les serveurs MCP qui ne prennent pas en charge l'enregistrement dynamique de client (Dynamic Client Registration)."

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for authorization servers that\nrequire out-of-band client registration."
msgstr "Identifiants de client OAuth préenregistrés pour les serveurs d'autorisation qui exigent un enregistrement de client hors bande."

msgctxt "settings schema"
msgid "Prefer a single line generally, unless an overly long line is encountered."
msgstr "Préfère une seule ligne en général, sauf si une ligne trop longue est rencontrée."

msgctxt "settings schema"
msgid "Preferred Conda manager to use when activating Conda environments.\n\nDefault: auto"
msgstr "Gestionnaire Conda préféré à utiliser lors de l'activation des environnements Conda.\n\nValeur par défaut : auto"

msgctxt "settings schema"
msgid "Preferred debuggers for this language.\n\nDefault: []"
msgstr "Débogueurs préférés pour ce langage.\n\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Preserve the cursor's vertical position within the viewport, falling\nback to centering when the cursor is offscreen."
msgstr "Conserve la position verticale du curseur dans la fenêtre d'affichage, avec centrage à défaut lorsque le curseur est hors de l'écran."

msgctxt "settings schema"
msgid "Preserve the existing line endings of the file. New files use the\nplatform default line ending."
msgstr "Conserve les fins de ligne existantes du fichier. Les nouveaux fichiers utilisent la fin de ligne par défaut de la plateforme."

msgctxt "settings schema"
msgid "Preserve the indentation of the current line when creating new lines,\nbut don't adjust based on syntax context."
msgstr "Conserve l'indentation de la ligne actuelle lors de la création de nouvelles lignes, sans l'ajuster selon le contexte syntaxique."

msgctxt "settings schema"
msgid "Pure Unicode codepoint comparison. No case folding, no natural number sorting.\nUppercase ASCII sorts before lowercase. Accented characters sort after ASCII."
msgstr "Comparaison pure des points de code Unicode. Pas d'insensibilité à la casse, pas de tri naturel des nombres. Les majuscules ASCII sont triées avant les minuscules. Les caractères accentués sont triés après l'ASCII."

msgctxt "settings schema"
msgid "Quit the application the last window is closed"
msgstr "Quitte l'application à la fermeture de la dernière fenêtre"

msgctxt "settings schema"
msgid "Read-access of a symbol, like reading a variable.\n\nA document highlight is a range inside a text document which deserves\nspecial attention. Usually a document highlight is visualized by changing\nthe background color of its range."
msgstr "Accès en lecture à un symbole, comme la lecture d'une variable.\n\nUne surbrillance de document est une plage d'un document texte qui mérite une attention particulière. Elle est généralement visualisée en changeant la couleur d'arrière-plan de sa plage."

msgctxt "settings schema"
msgid "Red ANSI terminal color."
msgstr "Couleur de terminal ANSI rouge."

msgctxt "settings schema"
msgid "Regexes for inputs that must always prompt.\nTakes precedence over always_allow but not always_deny.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Expressions régulières des entrées qui doivent toujours donner lieu à une demande. Prioritaires sur always_allow mais pas sur always_deny. Pour `copy_path` et `move_path`, les motifs sont comparés indépendamment à chaque chemin (source et destination). Les motifs s'accumulent d'une couche de paramètres à l'autre (utilisateur, projet, profil) et ne peuvent pas être supprimés par une couche de priorité supérieure ; seuls de nouveaux motifs peuvent être ajoutés.\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-approve.\nFor terminal: matches command. For file tools: matches path. For fetch: matches URL.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Expressions régulières des entrées à approuver automatiquement. Pour le terminal : comparées à la commande. Pour les outils de fichiers : comparées au chemin. Pour fetch : comparées à l'URL. Pour `copy_path` et `move_path`, les motifs sont comparés indépendamment à chaque chemin (source et destination). Les motifs s'accumulent d'une couche de paramètres à l'autre (utilisateur, projet, profil) et ne peuvent pas être supprimés par une couche de priorité supérieure ; seuls de nouveaux motifs peuvent être ajoutés.\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-reject.\n**SECURITY**: These take precedence over ALL other rules, across ALL settings layers.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Expressions régulières des entrées à rejeter automatiquement. **SÉCURITÉ** : elles sont prioritaires sur TOUTES les autres règles, dans TOUTES les couches de paramètres. Pour `copy_path` et `move_path`, les motifs sont comparés indépendamment à chaque chemin (source et destination). Les motifs s'accumulent d'une couche de paramètres à l'autre (utilisateur, projet, profil) et ne peuvent pas être supprimés par une couche de priorité supérieure ; seuls de nouveaux motifs peuvent être ajoutés.\nValeur par défaut : []"

msgctxt "settings schema"
msgid "Regexes used to identify paths for hyperlink navigation.\n\nDefault:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUse `\"...\"` to add regexes without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list. Set `[]` to clear it. Omitting this\nsetting keeps the inherited list.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nInherited regexes are inserted at `\"...\"`, and duplicates keep their first\noccurrence. Regexes are duplicates when their text is identical after\njoining multiline entries with newlines.\n\nEach regex can be a single string or an array of strings joined with\nnewlines. The marker is recognized only as a top-level string. To use\n`...` as a regex matching three characters, write `[\"...\"]` as an entry.\nA `\"...\"` line inside a multiline entry is always regex text.\n\nThe optional named capture `path` selects the hyperlink target. Without\nit, the entire match is the target. With `path`, `line` and `column`\nspecify the position. Without a captured `line`, built-in suffix\nprocessing parses `line:column` and `(line,column)` variants. The optional\n`link` capture selects the clickable text, otherwise the entire match is\nclickable.\n\nProcessing stops at the first regex that matches the terminal line, even\nif the cursor is outside its clickable text. Put more specific regexes\nbefore broader ones. Regexes use Rust's `regex` syntax. Invalid regexes\nare logged and ignored. The `path_hyperlink_timeout_ms` setting controls\nthe discovery timeout. Setting it to `0` disables path hyperlinks."
msgstr "Expressions régulières utilisées pour identifier les chemins pour la navigation par lien hypertexte.\n\nValeur par défaut :\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUtilisez `\"...\"` pour ajouter des expressions régulières sans répéter les valeurs par défaut de ForgeKairos. Dans les paramètres du projet, cela étend la valeur de la configuration utilisateur ou parente. Omettez `\"...\"` pour remplacer la liste héritée. Définissez `[]` pour la vider. Omettre ce paramètre conserve la liste héritée.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nLes expressions régulières héritées sont insérées à la place de `\"...\"`, et les doublons conservent leur première occurrence. Des expressions régulières sont des doublons lorsque leur texte est identique après la jonction des entrées multilignes par des sauts de ligne.\n\nChaque expression régulière peut être une seule chaîne ou un tableau de chaînes jointes par des sauts de ligne. Le marqueur n'est reconnu que comme chaîne de premier niveau. Pour utiliser `...` comme expression régulière correspondant à trois caractères, écrivez `[\"...\"]` comme entrée. Une ligne `\"...\"` dans une entrée multiligne est toujours du texte d'expression régulière.\n\nLa capture nommée facultative `path` sélectionne la cible du lien hypertexte. Sans elle, toute la correspondance est la cible. Avec `path`, `line` et `column` précisent la position. Sans `line` capturé, le traitement intégré des suffixes analyse les variantes `line:column` et `(line,column)`. La capture facultative `link` sélectionne le texte cliquable ; sinon, toute la correspondance est cliquable.\n\nLe traitement s'arrête à la première expression régulière qui correspond à la ligne du terminal, même si le curseur est hors de son texte cliquable. Placez les expressions régulières les plus spécifiques avant les plus larges. Les expressions régulières utilisent la syntaxe `regex` de Rust. Les expressions régulières non valides sont journalisées et ignorées. Le paramètre `path_hyperlink_timeout_ms` contrôle le délai d'expiration de la détection. Le définir sur `0` désactive les liens hypertexte de chemins."

msgctxt "settings schema"
msgid "Renamed version control color."
msgstr "Couleur de contrôle de version pour les éléments renommés."

msgctxt "settings schema"
msgid "Render document colors as inlay hints near the color text."
msgstr "Affiche les couleurs du document sous forme d'indications intégrées à proximité du texte représentant la couleur."

msgctxt "settings schema"
msgid "Replaces text before and after the cursor, using the `replace` range described in the LSP specification."
msgstr "Remplace le texte avant et après le curseur, en utilisant la plage `replace` décrite dans la spécification LSP."

msgctxt "settings schema"
msgid "Replaces text before the cursor, using the `insert` range described in the LSP specification."
msgstr "Remplace le texte avant le curseur, en utilisant la plage `insert` décrite dans la spécification LSP."

msgctxt "settings schema"
msgid "Replaces the grid with the text in the same tab."
msgstr "Remplace la grille par le texte dans le même onglet."

msgctxt "settings schema"
msgid "Represents a hidden status, such as a file being hidden in a file tree."
msgstr "Représente un état masqué, par exemple un fichier caché dans une arborescence de fichiers."

msgctxt "settings schema"
msgid "Represents a renamed status, such as a file that has been renamed."
msgstr "Représente un état renommé, par exemple un fichier qui a été renommé."

msgctxt "settings schema"
msgid "Represents a warning status, like an operation that is about to fail."
msgstr "Représente un état d'avertissement, par exemple une opération sur le point d'échouer."

msgctxt "settings schema"
msgid "Represents informational status updates or messages."
msgstr "Représente des mises à jour d'état ou des messages d'information."

msgctxt "settings schema"
msgid "Represents the selection of a theme, which can be either static or dynamic."
msgstr "Représente la sélection d'un thème, qui peut être statique ou dynamique."

msgctxt "settings schema"
msgid "Represents the selection of an icon theme, which can be either static or dynamic."
msgstr "Représente la sélection d'un thème d'icônes, qui peut être statique ou dynamique."

msgctxt "settings schema"
msgid "Resize the window to cover the entire screen, including the menu bar and,\non notched displays, the area around the notch."
msgstr "Redimensionne la fenêtre pour couvrir tout l'écran, y compris la barre de menus et, sur les écrans à encoche, la zone autour de l'encoche."

msgctxt "settings schema"
msgid "Restart clangd when its resident memory, measured every 30 seconds,\ngoes over this many megabytes. At most one restart every 10 minutes;\nafter that, a notification only. Unset never restarts. Read from the\nuser's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Redémarre clangd lorsque sa mémoire résidente, mesurée toutes les 30 secondes, dépasse ce nombre de mégaoctets. Au plus un redémarrage toutes les 10 minutes ; au-delà, seulement une notification. Non défini, il ne redémarre jamais. Lu uniquement dans les paramètres de l'utilisateur, pas dans le `.zed/settings.json` d'un projet.\n\nValeur par défaut : null"

msgctxt "settings schema"
msgid "Restore all workspaces that were open when quitting Zed."
msgstr "Restaure tous les espaces de travail qui étaient ouverts lors de la fermeture de ForgeKairos."

msgctxt "settings schema"
msgid "Restore the workspace that was closed last."
msgstr "Restaure l'espace de travail fermé en dernier."

msgctxt "settings schema"
msgid "Rules for rendering LSP semantic tokens."
msgstr "Règles de rendu des jetons sémantiques LSP."

msgctxt "settings schema"
msgid "Save after inactivity period of `milliseconds`."
msgstr "Enregistre après une période d'inactivité de `milliseconds`."

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier for fast scrolling. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling. Fast scrolling\nhappens when a user holds the alt or option key while scrolling.\n\nDefault: 4.0"
msgstr "Multiplicateur de sensibilité du défilement rapide. Ce multiplicateur s'applique aux valeurs de déplacement horizontal et vertical pendant le défilement. Le défilement rapide a lieu lorsque l'utilisateur maintient la touche alt ou option pendant le défilement.\n\nValeur par défaut : 4.0"

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling.\n\nDefault: 1.0"
msgstr "Multiplicateur de sensibilité du défilement. Ce multiplicateur s'applique aux valeurs de déplacement horizontal et vertical pendant le défilement.\n\nValeur par défaut : 1.0"

msgctxt "settings schema"
msgid "Scroll so the target appears near the top of the viewport."
msgstr "Fait défiler la vue de sorte que la cible apparaisse près du haut de la fenêtre d'affichage."

msgctxt "settings schema"
msgid "Scroll the minimum amount needed to make the target visible."
msgstr "Fait défiler le minimum nécessaire pour rendre la cible visible."

msgctxt "settings schema"
msgid "Scrollbar related settings"
msgstr "Paramètres relatifs à la barre de défilement"

msgctxt "settings schema"
msgid "Scrollbar-related settings"
msgstr "Paramètres relatifs à la barre de défilement"

msgctxt "settings schema"
msgid "Select specific input audio device."
msgstr "Sélectionne le périphérique audio d'entrée spécifique."

msgctxt "settings schema"
msgid "Select specific output audio device."
msgstr "Sélectionne le périphérique audio de sortie spécifique."

msgctxt "settings schema"
msgid "Send anonymized usage data like what languages you're using Zed with.\n\nDefault: true"
msgstr "Envoie des données d'utilisation anonymisées, comme les langages avec lesquels vous utilisez ForgeKairos.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Send debug info like crash reports.\n\nDefault: true"
msgstr "Envoie des informations de débogage, comme les rapports de plantage.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Session log (TeraTerm-style output recording) settings."
msgstr "Paramètres du journal de session (enregistrement de la sortie à la manière de TeraTerm)."

msgctxt "settings schema"
msgid "Sets the cursor blinking behavior in the terminal.\n\nDefault: terminal_controlled"
msgstr "Définit le comportement de clignotement du curseur dans le terminal.\n\nValeur par défaut : terminal_controlled"

msgctxt "settings schema"
msgid "Sets the debounce threshold (in milliseconds) after which changes are reflected in the git gutter.\n\nDefault: 0"
msgstr "Définit le seuil d'anti-rebond (en millisecondes) après lequel les modifications sont reflétées dans la gouttière Git.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "Sets the terminal's font fallbacks.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font fallbacks."
msgstr "Définit les polices de secours du terminal.\n\nSi cette option n'est pas incluse, le terminal utilise par défaut les polices de secours du tampon."

msgctxt "settings schema"
msgid "Sets the terminal's font family.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font family."
msgstr "Définit la famille de polices du terminal.\n\nSi cette option n'est pas incluse, le terminal utilise par défaut la famille de polices du tampon."

msgctxt "settings schema"
msgid "Sets the terminal's font size.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font size."
msgstr "Définit la taille de police du terminal.\n\nSi cette option n'est pas incluse, le terminal utilise par défaut la taille de police du tampon."

msgctxt "settings schema"
msgid "Sets the terminal's font weight in CSS weight units 0-900."
msgstr "Définit la graisse de police du terminal en unités CSS de 0 à 900."

msgctxt "settings schema"
msgid "Sets the terminal's line height.\n\nDefault: comfortable"
msgstr "Définit la hauteur de ligne du terminal.\n\nValeur par défaut : comfortable"

msgctxt "settings schema"
msgid "Sets whether Alternate Scroll mode (code: ?1007) is active by default.\nAlternate Scroll mode converts mouse scroll events into up / down key\npresses when in the alternate screen (e.g. when running applications\nlike vim or  less). The terminal can still set and unset this mode.\n\nDefault: on"
msgstr "Définit si le mode Alternate Scroll (code : ?1007) est actif par défaut. Ce mode convertit les événements de défilement de la souris en appuis sur les touches haut / bas dans l'écran alternatif (p. ex. lors de l'exécution d'applications comme vim ou less). Le terminal peut toujours activer et désactiver ce mode.\n\nValeur par défaut : on"

msgctxt "settings schema"
msgid "Sets whether the option key behaves as the meta key.\n\nDefault: false"
msgstr "Définit si la touche option se comporte comme la touche meta.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Settings for associating file extensions and filenames\nwith languages."
msgstr "Paramètres d'association des extensions et des noms de fichiers à des langages."

msgctxt "settings schema"
msgid "Settings for automatic agent context compaction, which summarizes\nearlier messages to free up room in the model's context window once the\ncontext grows too large."
msgstr "Paramètres du compactage automatique du contexte de l'agent, qui résume les messages antérieurs pour libérer de la place dans la fenêtre de contexte du modèle lorsque le contexte devient trop grand."

msgctxt "settings schema"
msgid "Settings for automatically opening files."
msgstr "Paramètres d'ouverture automatique des fichiers."

msgctxt "settings schema"
msgid "Settings for configuring REPL display and behavior."
msgstr "Paramètres de configuration de l'affichage et du comportement du REPL."

msgctxt "settings schema"
msgid "Settings for configuring the which-key popup behaviour."
msgstr "Paramètres de configuration du comportement de la fenêtre contextuelle which-key."

msgctxt "settings schema"
msgid "Settings for context servers used for AI-related features."
msgstr "Paramètres des serveurs de contexte utilisés pour les fonctionnalités liées à l'IA."

msgctxt "settings schema"
msgid "Settings for developer-oriented instrumentation tools (profilers,\ntracers, etc.) that can be toggled at runtime."
msgstr "Paramètres des outils d'instrumentation destinés aux développeurs (profileurs, traceurs, etc.) qui peuvent être activés ou désactivés à l'exécution."

msgctxt "settings schema"
msgid "Settings for language server notifications"
msgstr "Paramètres des notifications du serveur de langage"

msgctxt "settings schema"
msgid "Settings for showing inline diagnostics."
msgstr "Paramètres d'affichage des diagnostics en ligne."

msgctxt "settings schema"
msgid "Settings for sticking scopes to the top of the editor.\n\nDefault: sticky scroll is disabled"
msgstr "Paramètres pour fixer les portées en haut de l'éditeur.\n\nValeur par défaut : le défilement fixe est désactivé"

msgctxt "settings schema"
msgid "Settings for tabular files such as CSV and TSV."
msgstr "Paramètres des fichiers tabulaires comme CSV et TSV."

msgctxt "settings schema"
msgid "Settings for the built-in IDE server.\n\nThe server binds a random port on `127.0.0.1` only and never talks to the\nnetwork, so it is outside the scope of the egress allowlist."
msgstr "Paramètres du serveur IDE intégré.\n\nLe serveur écoute sur un port aléatoire de `127.0.0.1` uniquement et ne communique jamais avec le réseau ; il est donc hors du champ de la liste d'autorisation des connexions sortantes."

msgctxt "settings schema"
msgid "Settings for the built-in browser panel."
msgstr "Paramètres du panneau Navigateur intégré."

msgctxt "settings schema"
msgid "Settings for the built-in loopback IDE server."
msgstr "Paramètres du serveur IDE intégré sur l'adresse de bouclage."

msgctxt "settings schema"
msgid "Settings for the machine a remote project runs on, as opposed to the\nlists of connections next to them. Written under `\"remote\"` in\n`settings.json`, and carried to the remote host with the rest of the user\nsettings, which is where they take effect."
msgstr "Paramètres de la machine sur laquelle s'exécute un projet distant, par opposition aux listes de connexions qui les accompagnent. Écrits sous `\"remote\"` dans `settings.json`, et transmis à l'hôte distant avec le reste des paramètres utilisateur ; c'est là qu'ils prennent effet."

msgctxt "settings schema"
msgid "Settings for the threads sidebar."
msgstr "Paramètres de la barre latérale des conversations."

msgctxt "settings schema"
msgid "Settings for the which-key popup."
msgstr "Paramètres de la fenêtre contextuelle which-key."

msgctxt "settings schema"
msgid "Settings for using LSP pull diagnostics mechanism in Zed."
msgstr "Paramètres de récupération des diagnostics LSP dans ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to Vim mode in Zed."
msgstr "Paramètres relatifs au mode Vim dans ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to indent guides in the outline panel."
msgstr "Paramètres relatifs aux guides d'indentation dans le panneau de structure."

msgctxt "settings schema"
msgid "Settings related to indent guides in the project panel."
msgstr "Paramètres relatifs aux guides d'indentation dans le panneau de projet."

msgctxt "settings schema"
msgid "Settings related to the command palette."
msgstr "Paramètres relatifs à la palette de commandes."

msgctxt "settings schema"
msgid "Settings related to the file finder."
msgstr "Paramètres relatifs à la recherche de fichiers."

msgctxt "settings schema"
msgid "Settings specific to Codestral."
msgstr "Paramètres spécifiques à Codestral."

msgctxt "settings schema"
msgid "Settings specific to GitHub Copilot."
msgstr "Paramètres spécifiques à GitHub Copilot."

msgctxt "settings schema"
msgid "Settings specific to Ollama."
msgstr "Paramètres spécifiques à Ollama."

msgctxt "settings schema"
msgid "Settings specific to Zed's Edit Predictions provider."
msgstr "Paramètres spécifiques au fournisseur de prédictions de modification de Zed."

msgctxt "settings schema"
msgid "Settings specific to journaling"
msgstr "Paramètres spécifiques à la tenue du journal"

msgctxt "settings schema"
msgid "Settings specific to the Mercury Edit Predictions provider."
msgstr "Paramètres spécifiques au fournisseur de prédictions de modification Mercury."

msgctxt "settings schema"
msgid "Settings specific to using custom OpenAI-compatible servers for edit prediction."
msgstr "Paramètres spécifiques à l'utilisation de serveurs compatibles OpenAI personnalisés pour la prédiction de modification."

msgctxt "settings schema"
msgid "Settings that apply to the host a remote project runs on."
msgstr "Paramètres qui s'appliquent à l'hôte sur lequel s'exécute un projet distant."

msgctxt "settings schema"
msgid "Settings-layer–free model mode enum.\n\nMirrors the shape of `settings_content::ModelMode` but lives here so that\ncrates below the settings layer can reference it."
msgstr "Énumération du mode de modèle indépendante de la couche des paramètres.\n\nReproduit la forme de `settings_content::ModelMode`, mais se trouve ici afin que les crates situées sous la couche des paramètres puissent y faire référence."

msgctxt "settings schema"
msgid "Settings-layer–free reasoning-effort enum.\n\nMirrors the shape of `settings_content::OpenAiReasoningEffort` but lives\nhere so that crates below the settings layer can reference it."
msgstr "Énumération du niveau de réflexion indépendante de la couche des paramètres.\n\nReproduit la forme de `settings_content::OpenAiReasoningEffort`, mais se trouve ici afin que les crates situées sous la couche des paramètres puissent y faire référence."

msgctxt "settings schema"
msgid "Shell configuration to open the terminal with."
msgstr "Configuration du shell à utiliser pour ouvrir le terminal."

msgctxt "settings schema"
msgid "Show a disclosure chevron followed by a folder icon."
msgstr "Affiche un chevron de développement suivi d'une icône de dossier."

msgctxt "settings schema"
msgid "Show a disclosure chevron."
msgstr "Affiche un chevron de développement."

msgctxt "settings schema"
msgid "Show a folder icon."
msgstr "Affiche une icône de dossier."

msgctxt "settings schema"
msgid "Show all diagnostic levels: hint, information, warnings, error."
msgstr "Affiche tous les niveaux de diagnostic : indication, information, avertissements, erreur."

msgctxt "settings schema"
msgid "Show an empty untitled buffer when opening a new window"
msgstr "Affiche un tampon vide sans titre à l'ouverture d'une nouvelle fenêtre"

msgctxt "settings schema"
msgid "Show diffs in a single unified view."
msgstr "Affiche les différences dans une vue unifiée."

msgctxt "settings schema"
msgid "Show diffs in a split view."
msgstr "Affiche les différences dans une vue côte à côte."

msgctxt "settings schema"
msgid "Show directories first, then files"
msgstr "Affiche d'abord les répertoires, puis les fichiers"

msgctxt "settings schema"
msgid "Show file name first, then path"
msgstr "Affiche le nom du fichier en premier, puis le chemin d'accès"

msgctxt "settings schema"
msgid "Show files first, then directories"
msgstr "Affiche d'abord les fichiers, puis les répertoires"

msgctxt "settings schema"
msgid "Show full path first"
msgstr "Affiche d'abord le chemin d'accès complet"

msgctxt "settings schema"
msgid "Show git blame in the status bar at the bottom of the window."
msgstr "Affiche le blame Git dans la barre d'état en bas de la fenêtre."

msgctxt "settings schema"
msgid "Show git blame inline at the current line."
msgstr "Affiche le blame Git en ligne sur la ligne actuelle."

msgctxt "settings schema"
msgid "Show git gutter in tracked files."
msgstr "Affiche la gouttière Git dans les fichiers suivis."

msgctxt "settings schema"
msgid "Show on all open editors."
msgstr "Affiche dans tous les éditeurs ouverts."

msgctxt "settings schema"
msgid "Show only the following diagnostic level: error."
msgstr "Affiche uniquement le niveau de diagnostic suivant : erreur."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: information, warning, error."
msgstr "Affiche uniquement les niveaux de diagnostic suivants : information, avertissement, erreur."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: warning, error."
msgstr "Affiche uniquement les niveaux de diagnostic suivants : avertissement, erreur."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects (no tabs)."
msgstr "Affiche le Launchpad avec les projets récents (sans onglets)."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects when opening a new window"
msgstr "Affiche le Launchpad avec les projets récents à l'ouverture d'une nouvelle fenêtre"

msgctxt "settings schema"
msgid "Show the minimap on the active editor only."
msgstr "Affiche la minicarte uniquement sur l'éditeur actif."

msgctxt "settings schema"
msgid "Show the minimap thumb only when the mouse is hovering over the minimap."
msgstr "Affiche le curseur de la minicarte uniquement lorsque la souris survole la minicarte."

msgctxt "settings schema"
msgid "Show the scrollbar if there's important information or\nfollow the system's configured behavior."
msgstr "Affiche la barre de défilement s'il y a des informations importantes, ou suit le comportement configuré du système."

msgctxt "settings schema"
msgid "Show unstaged hunks hollow and staged hunks with a filled background."
msgstr "Affiche les blocs non indexés en creux et les blocs indexés avec un fond plein."

msgctxt "settings schema"
msgid "Show unstaged hunks with a filled background and staged hunks hollow."
msgstr "Affiche les blocs non indexés avec un fond plein et les blocs indexés en creux."

msgctxt "settings schema"
msgid "Size of the border surrounding the active pane.\nWhen set to 0, the active pane doesn't have any border.\nThe border is drawn inset.\n\nDefault: `0.0`"
msgstr "Taille de la bordure entourant le volet actif. Avec 0, le volet actif n'a aucune bordure. La bordure est dessinée vers l'intérieur.\n\nValeur par défaut : `0.0`"

msgctxt "settings schema"
msgid "Soft wrap line at the preferred line length or the editor width (whichever is smaller)."
msgstr "Effectue un retour à la ligne automatique à la longueur de ligne préférée ou à la largeur de l'éditeur (selon la valeur la plus petite)."

msgctxt "settings schema"
msgid "Soft wrap lines that exceed the editor width."
msgstr "Effectue un retour à la ligne automatique pour les lignes dépassant la largeur de l'éditeur."

msgctxt "settings schema"
msgid "Sort snippets normally using the default comparison logic"
msgstr "Trie les extraits de code normalement en utilisant la logique de comparaison par défaut"

msgctxt "settings schema"
msgid "Spacing between worktree entries in the project panel.\n\nDefault: comfortable"
msgstr "Espacement entre les entrées de l'arborescence de travail dans le panneau de projet.\n\nValeur par défaut : comfortable"

msgctxt "settings schema"
msgid "Specifies the density of the UI.\nNote: This setting is still experimental. See [this tracking issue](https://github.com/zed-industries/zed/issues/18078)"
msgstr "Spécifie la densité de l'interface.\nRemarque : ce paramètre est encore expérimental. Consultez [ce ticket de suivi](https://github.com/zed-industries/zed/issues/18078)"

msgctxt "settings schema"
msgid "Start searching as you type in project search, without pressing Enter."
msgstr "Lance la recherche dans le projet dès la saisie, sans avoir à appuyer sur Enter."

msgctxt "settings schema"
msgid "Sticky scroll related settings"
msgstr "Paramètres liés au défilement fixe"

msgctxt "settings schema"
msgid "String substituted for `${separator}` in the window title format.\nInclude any surrounding whitespace in the value.\n\nDefault: ` — `"
msgstr "Chaîne substituée à `${separator}` dans le format du titre de la fenêtre. Incluez dans la valeur les espaces qui doivent l'entourer.\n\nValeur par défaut : ` — `"

msgctxt "settings schema"
msgid "Suggesting and installing missing development tools."
msgstr "Suggestion et installation des outils de développement manquants."

msgctxt "settings schema"
msgid "Suggestions of the development tools (language servers, formatters) that\nthe language of an opened file needs, when they are missing."
msgstr "Suggestions des outils de développement (serveurs de langage, formateurs) dont le langage d'un fichier ouvert a besoin, lorsqu'ils sont manquants."

msgctxt "settings schema"
msgid "Supported reasoning effort levels, for example `[\"low\", \"medium\", \"high\"]."
msgstr "Niveaux de réflexion pris en charge, par exemple `[\"low\", \"medium\", \"high\"]."

msgctxt "settings schema"
msgid "TODO: this should just be a bool\nControls the behavior of formatting files when they are saved."
msgstr "TODO : devrait être un simple booléen\nContrôle le comportement de mise en forme des fichiers lors de leur enregistrement."

msgctxt "settings schema"
msgid "Takes up the full width of the window"
msgstr "Occupe toute la largeur de la fenêtre"

msgctxt "settings schema"
msgid "Task configuration for this language.\n\nDefault: {}"
msgstr "Configuration des tâches pour ce langage.\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "Terminal ANSI background color."
msgstr "Couleur d'arrière-plan ANSI du terminal."

msgctxt "settings schema"
msgid "Terminal background color."
msgstr "Couleur d'arrière-plan du terminal."

msgctxt "settings schema"
msgid "Terminal foreground color."
msgstr "Couleur de premier plan du terminal."

msgctxt "settings schema"
msgid "Text Color. Color of muted or deemphasized text. It is a subdued version of the standard text color."
msgstr "Couleur du texte. Couleur du texte atténué ou désaccentué. Il s'agit d'une version apaisée de la couleur de texte standard."

msgctxt "settings schema"
msgid "Text Color. Color of the placeholder text typically shown in input fields to guide the user to enter valid data."
msgstr "Couleur du texte. Couleur du texte d'espace réservé généralement affiché dans les champs de saisie pour guider l'utilisateur."

msgctxt "settings schema"
msgid "Text Color. Color used for emphasis or highlighting certain text, like an active filter or a matched character in a search."
msgstr "Couleur du texte. Couleur utilisée pour mettre en évidence certains textes, comme un filtre actif ou un caractère correspondant dans une recherche."

msgctxt "settings schema"
msgid "Text Color. Color used for text denoting disabled elements. Typically, the color is faded or grayed out to emphasize the disabled state."
msgstr "Couleur du texte. Couleur utilisée pour le texte indiquant des éléments désactivés. En général, la couleur est estompée ou grisée pour souligner l'état désactivé."

msgctxt "settings schema"
msgid "Text Color. Default text color used for most text."
msgstr "Couleur du texte. Couleur de texte par défaut utilisée pour la plupart des textes."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is highlighted."
msgstr "Couleur du texte. Utilisée pour le numéro de ligne dans la gouttière de l'éditeur lorsque la ligne est mise en surbrillance."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is hovered over."
msgstr "Couleur du texte. Utilisée pour le numéro de ligne dans la gouttière de l'éditeur lorsque la ligne est survolée."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter."
msgstr "Couleur du texte. Utilisée pour le numéro de ligne dans la gouttière de l'éditeur."

msgctxt "settings schema"
msgid "Text Color. Used to mark invisible characters in the editor.\n\nExample: spaces, tabs, carriage returns, etc."
msgstr "Couleur du texte. Utilisée pour marquer les caractères invisibles dans l'éditeur.\n\nExemple : espaces, tabulations, retours chariot, etc."

msgctxt "settings schema"
msgid "Text color used for CodeLens items in the editor."
msgstr "Couleur du texte utilisée pour les éléments CodeLens dans l'éditeur."

msgctxt "settings schema"
msgid "The AI browser panel, which holds the AI tabs that AI agents drive."
msgstr "Le panneau Navigateur IA, qui contient les onglets IA que pilotent les agents IA."

msgctxt "settings schema"
msgid "The API protocol to use for this model: \"anthropic\", \"openai_responses\", \"openai_chat\", or \"google\". Defaults to \"openai_chat\"."
msgstr "Le protocole API à utiliser pour ce modèle : \"anthropic\", \"openai_responses\", \"openai_chat\" ou \"google\". Valeur par défaut : \"openai_chat\"."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka n_ctx)."
msgstr "Le paramètre de longueur de contexte du modèle (aussi appelé n_ctx)."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka num_ctx or n_ctx)"
msgstr "Le paramètre de longueur de contexte du modèle (aussi appelé num_ctx ou n_ctx)"

msgctxt "settings schema"
msgid "The HTTPS host the account's token signs in to, such as `github.com`.\nWithout one, pushing and pulling sign in as git is configured to."
msgstr "L'hôte HTTPS auprès duquel le jeton du compte se connecte, comme `github.com`. Sans hôte, l'envoi (push) et le tirage (pull) se connectent comme Git est configuré pour le faire."

msgctxt "settings schema"
msgid "The OAuth client ID obtained from out-of-band registration with the\nauthorization server."
msgstr "L'ID de client OAuth obtenu par un enregistrement hors bande auprès du serveur d'autorisation."

msgctxt "settings schema"
msgid "The OAuth client secret, if this is a confidential client. For security,\nprefer providing this interactively; we will prompt and store it in\nthe system keychain."
msgstr "Le secret client OAuth, s'il s'agit d'un client confidentiel. Pour des raisons de sécurité, préférez le fournir de manière interactive ; il vous sera demandé et sera stocké dans le trousseau du système."

msgctxt "settings schema"
msgid "The OpenAI Chat Completions API (`/chat/completions`)."
msgstr "L'API OpenAI Chat Completions (`/chat/completions`)."

msgctxt "settings schema"
msgid "The OpenAI Responses API (`/responses`)."
msgstr "L'API OpenAI Responses (`/responses`)."

msgctxt "settings schema"
msgid "The OpenAI-compatible API this model must be called through."
msgstr "L'API compatible OpenAI via laquelle ce modèle doit être appelé."

msgctxt "settings schema"
msgid "The OpenType features to enable for rendering in text buffers."
msgstr "Les fonctionnalités OpenType à activer pour le rendu dans les tampons de texte."

msgctxt "settings schema"
msgid "The OpenType features to enable for text in the UI."
msgstr "Les fonctionnalités OpenType à activer pour le texte de l'interface."

msgctxt "settings schema"
msgid "The SHA of the commit to apply."
msgstr "Le SHA de la validation à appliquer."

msgctxt "settings schema"
msgid "The SHA of the commit to check out."
msgstr "Le SHA de la validation à extraire."

msgctxt "settings schema"
msgid "The SHA of the commit to put the changes into."
msgstr "Le SHA de la validation dans laquelle intégrer les modifications."

msgctxt "settings schema"
msgid "The SHA of the commit to remove."
msgstr "Le SHA de la validation à supprimer."

msgctxt "settings schema"
msgid "The SHA of the commit to reset to."
msgstr "Le SHA de la validation à laquelle réinitialiser."

msgctxt "settings schema"
msgid "The SHA of the commit to start the branch from."
msgstr "Le SHA de la validation à partir de laquelle créer la branche."

msgctxt "settings schema"
msgid "The SHA of the commit to tag."
msgstr "Le SHA de la validation à étiqueter."

msgctxt "settings schema"
msgid "The SHA of the commit to undo."
msgstr "Le SHA de la validation à inverser."

msgctxt "settings schema"
msgid "The SHA of the commit whose message to rewrite."
msgstr "Le SHA de la validation dont le message doit être reformulé."

msgctxt "settings schema"
msgid "The SHA of the commit."
msgstr "Le SHA de la validation."

msgctxt "settings schema"
msgid "The URL of the Zed server to connect to."
msgstr "L'URL du serveur Zed auquel se connecter."

msgctxt "settings schema"
msgid "The URL of the remote context server."
msgstr "L'URL du serveur de contexte distant."

msgctxt "settings schema"
msgid "The URL template used by `browser_panel::AskCopilot`. `{query}` is\nreplaced with the percent-encoded query when present; without the\nplaceholder the page is opened as-is and the query is put on the\nclipboard instead.\n\nDefault: https://github.com/copilot"
msgstr "Le modèle d'URL utilisé par `browser_panel::AskCopilot`. `{query}` est remplacé par la requête encodée en pourcentage lorsqu'il est présent ; sans cet espace réservé, la page est ouverte telle quelle et la requête est placée dans le presse-papiers.\n\nValeur par défaut : https://github.com/copilot"

msgctxt "settings schema"
msgid "The URL template used when the address bar input is not a URL, and for\n`browser_panel::SearchSelection`. `{query}` is replaced with the\npercent-encoded query.\n\nDefault: https://www.google.com/search?q={query}"
msgstr "Le modèle d'URL utilisé lorsque la saisie de la barre d'adresse n'est pas une URL, et pour `browser_panel::SearchSelection`. `{query}` est remplacé par la requête encodée en pourcentage.\n\nValeur par défaut : https://www.google.com/search?q={query}"

msgctxt "settings schema"
msgid "The URL used as the key for credential storage.\n\nWhen set, credentials are stored under this URL instead of `server_url`.\nThis allows running multiple Zed instances side by side without them\noverwriting each other's keychain entries."
msgstr "L'URL utilisée comme clé pour le stockage des identifiants.\n\nSi elle est définie, les identifiants sont stockés sous cette URL au lieu de `server_url`. Cela permet d'exécuter plusieurs instances de ForgeKairos côte à côte sans qu'elles écrasent mutuellement leurs entrées du trousseau."

msgctxt "settings schema"
msgid "The account each repository commits and pushes as, by the absolute path of\nthe repository's working directory. A repository not listed here uses git's\nown configuration. Only read from the user settings file.\n\nDefault: {}"
msgstr "Le compte avec lequel chaque dépôt valide et envoie, par chemin absolu du répertoire de travail du dépôt. Un dépôt qui ne figure pas ici utilise la configuration propre de Git. Lu uniquement dans le fichier de paramètres utilisateur.\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "The alt key\nSometimes also known as the 'meta' key"
msgstr "La touche alt\nParfois aussi appelée touche 'meta'"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline blame in units of columns.\n\nDefault: 7"
msgstr "La marge entre la fin de la ligne source et le début du blame en ligne, en nombre de colonnes.\n\nValeur par défaut : 7"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline diagnostic in units of columns.\n\nDefault: 4"
msgstr "La marge entre la fin de la ligne source et le début du diagnostic en ligne, en nombre de colonnes.\n\nValeur par défaut : 4"

msgctxt "settings schema"
msgid "The arguments to pass to the command. Use `*` for a single wildcard argument.\nIf the last element is `**`, then any trailing arguments are allowed."
msgstr "Les arguments à passer à la commande. Utilisez `*` pour un seul argument générique. Si le dernier élément est `**`, tous les arguments suivants sont autorisés."

msgctxt "settings schema"
msgid "The arguments to pass to the program."
msgstr "Les arguments à passer au programme."

msgctxt "settings schema"
msgid "The arguments to pass to the program.\n\nSupported placeholders:\n\n- `{buffer_path}`: the path of the buffer being formatted, or\n  `Untitled` when it has never been saved.\n- `{start_line}` and `{end_line}`: the first and last line of a\n  selected range, 1-based and inclusive. An argument naming either\n  of them is repeated once per selected range when formatting\n  selections (e.g. `\"--lines={start_line}:{end_line}\"` for\n  clang-format), and is dropped when formatting the whole buffer.\n  Naming them is also what marks the command as able to format\n  selections at all."
msgstr "Les arguments à passer au programme.\n\nEspaces réservés pris en charge :\n\n- `{buffer_path}` : le chemin du tampon mis en forme, ou `Untitled` s'il n'a jamais été enregistré.\n- `{start_line}` et `{end_line}` : la première et la dernière ligne d'une plage sélectionnée, numérotées à partir de 1 et incluses. Un argument qui nomme l'un d'eux est répété une fois par plage sélectionnée lors de la mise en forme de sélections (p. ex. `\"--lines={start_line}:{end_line}\"` pour clang-format), et il est omis lors de la mise en forme du tampon entier. C'est aussi le fait de les nommer qui indique que la commande sait mettre en forme des sélections."

msgctxt "settings schema"
msgid "The author and committer email (`user.email`)."
msgstr "L'adresse e-mail de l'auteur et du validateur (`user.email`)."

msgctxt "settings schema"
msgid "The author and committer name (`user.name`)."
msgstr "Le nom de l'auteur et du validateur (`user.name`)."

msgctxt "settings schema"
msgid "The available agent profiles."
msgstr "Les profils d'agent disponibles."

msgctxt "settings schema"
msgid "The background appearance of the window."
msgstr "L'apparence de l'arrière-plan de la fenêtre."

msgctxt "settings schema"
msgid "The background color of the scrollbar track."
msgstr "La couleur d'arrière-plan du rail de la barre de défilement."

msgctxt "settings schema"
msgid "The base URL for the provider (e.g., \"https://code.corp.big.com\")."
msgstr "L'URL de base du fournisseur (p. ex. \"https://code.corp.big.com\")."

msgctxt "settings schema"
msgid "The behavior of `editor::Rewrap`."
msgstr "Le comportement de `editor::Rewrap`."

msgctxt "settings schema"
msgid "The border color of the minimap thumb."
msgstr "La couleur de la bordure du curseur de la minicarte."

msgctxt "settings schema"
msgid "The border color of the scrollbar thumb."
msgstr "La couleur de la bordure du curseur de la barre de défilement."

msgctxt "settings schema"
msgid "The border color of the scrollbar track."
msgstr "La couleur de la bordure du rail de la barre de défilement."

msgctxt "settings schema"
msgid "The buffer's line height."
msgstr "La hauteur de ligne du tampon."

msgctxt "settings schema"
msgid "The capabilities granted to extensions."
msgstr "Les capacités accordées aux extensions."

msgctxt "settings schema"
msgid "The color of the minimap thumb when hovered over."
msgstr "La couleur du curseur de la minicarte au survol."

msgctxt "settings schema"
msgid "The color of the minimap thumb whilst being actively dragged."
msgstr "La couleur du curseur de la minicarte lors d'un glissement actif."

msgctxt "settings schema"
msgid "The color of the minimap thumb."
msgstr "La couleur du curseur de la minicarte."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb when hovered over."
msgstr "La couleur du curseur de la barre de défilement au survol."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb whilst being actively dragged."
msgstr "La couleur du curseur de la barre de défilement lors d'un glissement actif."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb."
msgstr "La couleur du curseur de la barre de défilement."

msgctxt "settings schema"
msgid "The column at which to soft-wrap lines, for buffers where soft-wrap\nis enabled.\n\nDefault: 80"
msgstr "La colonne à laquelle appliquer le retour à la ligne automatique, pour les tampons où il est activé.\n\nValeur par défaut : 80"

msgctxt "settings schema"
msgid "The command key, on macos\nthe windows key, on windows\nthe super key, on linux"
msgstr "La touche Commande sous macOS\nla touche Windows sous Windows\nla touche Super sous Linux"

msgctxt "settings schema"
msgid "The command to execute."
msgstr "La commande à exécuter."

msgctxt "settings schema"
msgid "The content of a serialized theme."
msgstr "Le contenu d'un thème sérialisé."

msgctxt "settings schema"
msgid "The contents of the edit prediction settings."
msgstr "Le contenu des paramètres de prédiction de modification."

msgctxt "settings schema"
msgid "The control key"
msgstr "La touche Ctrl"

msgctxt "settings schema"
msgid "The debounce delay before querying highlights from the language\nserver based on the current cursor location.\n\nDefault: 75"
msgstr "Le délai d'anti-rebond avant de demander au serveur de langage les surbrillances liées à la position actuelle du curseur.\n\nValeur par défaut : 75"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 0"
msgstr "Le délai d'anti-rebond, en millisecondes, avant de demander automatiquement une prédiction après l'arrêt de la saisie. Définissez 0 pour demander les prédictions immédiatement.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 150"
msgstr "Le délai d'anti-rebond, en millisecondes, avant de demander automatiquement une prédiction après l'arrêt de la saisie. Définissez 0 pour demander les prédictions immédiatement.\n\nValeur par défaut : 150"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 75"
msgstr "Le délai d'anti-rebond, en millisecondes, avant de demander automatiquement une prédiction après l'arrêt de la saisie. Définissez 0 pour demander les prédictions immédiatement.\n\nValeur par défaut : 75"

msgctxt "settings schema"
msgid "The default UI density."
msgstr "La densité d'interface par défaut."

msgctxt "settings schema"
msgid "The default behavior when opening paths from the CLI without\nan explicit `-e` or `-n` flag.\n\nDefault: existing_window"
msgstr "Le comportement par défaut lors de l'ouverture de chemins depuis la CLI sans indicateur `-e` ou `-n` explicite.\n\nValeur par défaut : existing_window"

msgctxt "settings schema"
msgid "The default behavior when opening projects from the UI.\n\nDefault: existing_window"
msgstr "Le comportement par défaut lors de l'ouverture de projets depuis l'interface.\n\nValeur par défaut : existing_window"

msgctxt "settings schema"
msgid "The default font size for rendering in text buffers."
msgstr "La taille de police par défaut pour le rendu dans les tampons de texte."

msgctxt "settings schema"
msgid "The default font size for text in the UI."
msgstr "La taille de police par défaut pour le texte de l'interface."

msgctxt "settings schema"
msgid "The default language model selected when using this profile."
msgstr "Le modèle de langage par défaut sélectionné lors de l'utilisation de ce profil."

msgctxt "settings schema"
msgid "The default line height."
msgstr "La hauteur de ligne par défaut."

msgctxt "settings schema"
msgid "The default mode to use for this agent.\n\nNote: Not only all agents support modes.\n\nDefault: None"
msgstr "Le mode par défaut à utiliser pour cet agent.\n\nRemarque : tous les agents ne prennent pas en charge les modes.\n\nValeur par défaut : None"

msgctxt "settings schema"
msgid "The default model to use when creating new chats and for other features when a specific model is not specified."
msgstr "Le modèle par défaut à utiliser lors de la création de nouvelles conversations et pour les autres fonctionnalités lorsqu'aucun modèle spécifique n'est précisé."

msgctxt "settings schema"
msgid "The default profile to use in the Agent.\n\nDefault: write"
msgstr "Le profil par défaut à utiliser dans l'agent.\n\nValeur par défaut : write"

msgctxt "settings schema"
msgid "The default temperature to use for this model."
msgstr "La température par défaut à utiliser pour ce modèle."

msgctxt "settings schema"
msgid "The delay in milliseconds that must elapse before drag and drop is allowed. Otherwise, a new text selection is created.\n\nDefault: 300"
msgstr "Le délai en millisecondes qui doit s'écouler avant que le glisser-déposer soit autorisé. Sinon, une nouvelle sélection de texte est créée.\n\nValeur par défaut : 300"

msgctxt "settings schema"
msgid "The display name for the provider (e.g., \"BigCorp GitHub\")."
msgstr "Le nom d'affichage du fournisseur (p. ex. \"BigCorp GitHub\")."

msgctxt "settings schema"
msgid "The dock position of the debug panel\n\nDefault: Bottom"
msgstr "La position du panneau de débogage dans le dock\n\nValeur par défaut : Bottom"

msgctxt "settings schema"
msgid "The edit prediction settings."
msgstr "Les paramètres de prédiction de modification."

msgctxt "settings schema"
msgid "The editor will not scroll beyond the last line."
msgstr "L'éditeur ne défilera pas au-delà de la dernière ligne."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by one page."
msgstr "L'éditeur défilera au-delà de la dernière ligne d'une page."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by the same number of lines as vertical_scroll_margin."
msgstr "L'éditeur défilera au-delà de la dernière ligne du nombre de lignes défini par vertical_scroll_margin."

msgctxt "settings schema"
msgid "The extensions that should be automatically installed by Zed.\n\nThis is used to make functionality provided by extensions (e.g., language support)\navailable out-of-the-box.\n\nDefault: {}"
msgstr "Les extensions que ForgeKairos doit installer automatiquement.\n\nCela permet de rendre disponibles d'emblée des fonctionnalités fournies par des extensions (p. ex. la prise en charge d'un langage).\n\nValeur par défaut : {}"

msgctxt "settings schema"
msgid "The external program to run."
msgstr "Le programme externe à exécuter."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in text buffers."
msgstr "Les polices de secours à utiliser pour le rendu dans les tampons de texte."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in the UI."
msgstr "Les polices de secours à utiliser pour le rendu dans l'interface."

msgctxt "settings schema"
msgid "The font size for agent responses in the agent panel. Falls back to the UI font size if unset."
msgstr "La taille de police pour les réponses de l'agent dans le panneau de l'agent. Utilise la taille de police de l'interface si non définie."

msgctxt "settings schema"
msgid "The font size for user messages in the agent panel."
msgstr "La taille de police pour les messages utilisateur dans le panneau de l'agent."

msgctxt "settings schema"
msgid "The font size to use for rendering in the markdown preview.\nFalls back to the UI font size if unset."
msgstr "La taille de police à utiliser pour le rendu de l'aperçu Markdown. Utilise la taille de police de l'interface si elle n'est pas définie."

msgctxt "settings schema"
msgid "The function key"
msgstr "La touche Fn"

msgctxt "settings schema"
msgid "The granularity of one 'step' in the stepping requests `next`, `stepIn`, `stepOut`, and `stepBack`."
msgstr "La granularité d'un \"pas\" dans les requêtes d'exécution pas à pas `next`, `stepIn`, `stepOut` et `stepBack`."

msgctxt "settings schema"
msgid "The guardrail identifier (ARN or ID) to apply to Bedrock API requests."
msgstr "Identifiant du garde-fou (ARN ou ID) à appliquer aux requêtes API Bedrock."

msgctxt "settings schema"
msgid "The guardrail version to use. Defaults to \"DRAFT\" if not specified."
msgstr "Version du garde-fou à utiliser. Par défaut, utilise \"DRAFT\" si elle n'est pas spécifiée."

msgctxt "settings schema"
msgid "The icon theme to use for dark mode."
msgstr "Le thème d'icônes à utiliser pour le mode sombre."

msgctxt "settings schema"
msgid "The icon theme to use for light mode."
msgstr "Le thème d'icônes à utiliser pour le mode clair."

msgctxt "settings schema"
msgid "The key commits are signed with (`user.signingkey`), when signing is on."
msgstr "La clé avec laquelle les validations sont signées (`user.signingkey`), lorsque la signature est activée."

msgctxt "settings schema"
msgid "The key to use for adding multiple cursors\n\nDefault: alt"
msgstr "La touche à utiliser pour ajouter des curseurs multiples\n\nValeur par défaut : alt"

msgctxt "settings schema"
msgid "The language of the UI: \"system\" to follow the operating system, or a BCP 47\ntag such as \"en\", \"ja\" or \"pt-BR\".\n\nDefault: \"system\""
msgstr "La langue de l'interface : \"system\" pour suivre le système d'exploitation, ou une étiquette BCP 47 comme \"en\", \"ja\" ou \"pt-BR\".\n\nValeur par défaut : \"system\""

msgctxt "settings schema"
msgid "The language server and, in C and C++, the symbol index."
msgstr "Le serveur de langage et, en C et C++, l'index des symboles."

msgctxt "settings schema"
msgid "The layout of window control buttons as represented by user settings.\n\nCustom layout strings use the GNOME `button-layout` format (e.g.\n`\"close:minimize,maximize\"`)."
msgstr "La disposition des boutons de contrôle de la fenêtre telle que représentée par les paramètres utilisateur.\n\nLes chaînes de disposition personnalisées utilisent le format GNOME `button-layout` (p. ex. `\"close:minimize,maximize\"`)."

msgctxt "settings schema"
msgid "The layout of window control buttons in the title bar (Linux only).\n\nThis can be set to \"platform_default\" to follow the system configuration, or\n\"standard\" to use Zed's built-in layout. For custom layouts, use a\nGNOME-style layout string like \"close:minimize,maximize\".\n\nDefault: \"platform_default\""
msgstr "La disposition des boutons de contrôle de la fenêtre dans la barre de titre (Linux uniquement).\n\nPeut être définie sur \"platform_default\" pour suivre la configuration du système, ou sur \"standard\" pour utiliser la disposition intégrée de ForgeKairos. Pour une disposition personnalisée, utilisez une chaîne de disposition de style GNOME comme \"close:minimize,maximize\".\n\nValeur par défaut : \"platform_default\""

msgctxt "settings schema"
msgid "The list of custom Git hosting providers."
msgstr "La liste des fournisseurs d'hébergement Git personnalisés."

msgctxt "settings schema"
msgid "The list of language servers to use (or disable) for this language.\n\nThis array should consist of language server IDs, as well as the following\nspecial tokens:\n- `\"!<language_server_id>\"` - A language server ID prefixed with a `!` will be disabled.\n- `\"...\"` - A placeholder to refer to the **rest** of the registered language servers for this language.\n\nDefault: [\"...\"]"
msgstr "La liste des serveurs de langage à utiliser (ou à désactiver) pour ce langage.\n\nCe tableau doit contenir des ID de serveurs de langage, ainsi que les jetons spéciaux suivants :\n- `\"!<language_server_id>\"` - Un ID de serveur de langage précédé de `!` est désactivé.\n- `\"...\"` - Un espace réservé désignant le **reste** des serveurs de langage enregistrés pour ce langage.\n\nValeur par défaut : [\"...\"]"

msgctxt "settings schema"
msgid "The maximum amount of time to wait for responses from language servers, in seconds.\nA value of `0` will result in no timeout being applied (causing all LSP responses to wait indefinitely until completed).\n\nDefault: `120`"
msgstr "La durée maximale d'attente des réponses des serveurs de langage, en secondes. Une valeur de `0` n'applique aucun délai d'expiration (toutes les réponses LSP sont alors attendues indéfiniment jusqu'à leur achèvement).\n\nValeur par défaut : `120`"

msgctxt "settings schema"
msgid "The maximum line length a buffer may contain before language server features are disabled for the entire buffer.\n\nDefault: `20000`"
msgstr "La longueur de ligne maximale qu'un tampon peut contenir avant que les fonctionnalités du serveur de langage soient désactivées pour tout le tampon.\n\nValeur par défaut : `20000`"

msgctxt "settings schema"
msgid "The maximum number of completion tokens allowed by the model (o1-* only)"
msgstr "Le nombre maximal de jetons de génération autorisé par le modèle (o1-* uniquement)"

msgctxt "settings schema"
msgid "The maximum number of lines to keep in the scrollback history.\nMaximum allowed value is 100_000, all values above that will be treated as 100_000.\n0 disables the scrolling.\nExisting terminals will not pick up this change until they are recreated.\nSee <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">Alacritty documentation</a> for more information.\n\nDefault: 10_000"
msgstr "Le nombre maximal de lignes à conserver dans l'historique de défilement. La valeur maximale autorisée est 100_000 ; toutes les valeurs supérieures sont traitées comme 100_000. 0 désactive le défilement. Les terminaux existants ne prennent pas en compte cette modification tant qu'ils ne sont pas recréés. Consultez la <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">documentation d'Alacritty</a> pour plus d'informations.\n\nValeur par défaut : 10_000"

msgctxt "settings schema"
msgid "The maximum number of output tokens allowed by the model."
msgstr "Le nombre maximal de jetons de sortie autorisé par le modèle."

msgctxt "settings schema"
msgid "The maximum width, in pixels, of the rendered markdown content when\n`limit_content_width` is enabled.\n\nDefault: 800"
msgstr "La largeur maximale, en pixels, du contenu Markdown rendu lorsque `limit_content_width` est activé.\n\nValeur par défaut : 800"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast between foreground and background colors.\n\nAPCA (Accessible Perceptual Contrast Algorithm) is more accurate than WCAG 2.x,\nespecially for dark mode. Values range from 0 to 106.\n\nBased on APCA Readability Criterion (ARC) Bronze Simple Mode:\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: No contrast adjustment\n- 45: Minimum for large fluent text (36px+)\n- 60: Minimum for other content text\n- 75: Minimum for body text\n- 90: Preferred for body text\n\nDefault: 45"
msgstr "Le contraste perceptuel APCA minimal entre les couleurs de premier plan et d'arrière-plan.\n\nAPCA (Accessible Perceptual Contrast Algorithm) est plus précis que WCAG 2.x, en particulier pour le mode sombre. Les valeurs vont de 0 à 106.\n\nBasé sur le mode simple Bronze du critère de lisibilité APCA (ARC) :\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0 : aucun ajustement du contraste\n- 45 : minimum pour un grand texte fluide (36px+)\n- 60 : minimum pour les autres textes de contenu\n- 75 : minimum pour le corps de texte\n- 90 : recommandé pour le corps de texte\n\nValeur par défaut : 45"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast to maintain when\nrendering text over highlight backgrounds in the editor.\n\nValues range from 0 to 106. Set to 0 to disable adjustments.\nDefault: 45"
msgstr "Le contraste perceptuel APCA minimal à maintenir lors du rendu du texte sur les arrière-plans en surbrillance dans l'éditeur.\n\nLes valeurs vont de 0 à 106. Définissez 0 pour désactiver les ajustements.\nValeur par défaut : 45"

msgctxt "settings schema"
msgid "The minimum column number to show the inline blame information at\n\nDefault: 0"
msgstr "Le numéro de colonne minimal auquel afficher les informations de blame en ligne\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "The minimum column to display inline diagnostics. This setting can be\nused to horizontally align inline diagnostics at some position. Lines\nlonger than this value will still push diagnostics further to the right.\n\nDefault: 0"
msgstr "La colonne minimale à laquelle afficher les diagnostics en ligne. Ce paramètre permet d'aligner horizontalement les diagnostics en ligne à une certaine position. Les lignes plus longues que cette valeur repoussent quand même les diagnostics plus à droite.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "The minimum width (in em-widths) at which the split diff view is used.\nWhen the editor is narrower than this, the diff view automatically\nswitches to unified mode and switches back when the editor is wide\nenough. Set to 0 to disable automatic switching.\n\nDefault: 100"
msgstr "La largeur minimale (en largeurs d'em) à partir de laquelle la vue des différences côte à côte est utilisée. Lorsque l'éditeur est plus étroit, la vue des différences passe automatiquement en mode unifié, puis revient lorsque l'éditeur est assez large. Définissez 0 pour désactiver le basculement automatique.\n\nValeur par défaut : 100"

msgctxt "settings schema"
msgid "The mode in which edit predictions should be displayed."
msgstr "Le mode dans lequel les prédictions de modification doivent être affichées."

msgctxt "settings schema"
msgid "The mode use to select a theme.\n\n`Light` and `Dark` will select their respective themes.\n\n`System` will select the theme based on the system's appearance."
msgstr "Le mode utilisé pour sélectionner un thème.\n\n`Light` et `Dark` sélectionnent leurs thèmes respectifs.\n\n`System` sélectionne le thème selon l'apparence du système."

msgctxt "settings schema"
msgid "The mode used to determine which theme to use."
msgstr "Le mode utilisé pour déterminer quel thème utiliser."

msgctxt "settings schema"
msgid "The mode used to display edit predictions in the buffer.\nProvider support required."
msgstr "Le mode d'affichage des prédictions de modification dans le tampon. Nécessite la prise en charge par le fournisseur."

msgctxt "settings schema"
msgid "The model id as expected in Bedrock Mantle request bodies, e.g. `openai.gpt-5.5`."
msgstr "L'identifiant du modèle tel qu'attendu dans le corps des requêtes Bedrock Mantle, par exemple `openai.gpt-5.5`."

msgctxt "settings schema"
msgid "The model id reported by the llama.cpp server (its `--alias` or the model file path)."
msgstr "L'ID du modèle signalé par le serveur llama.cpp (son `--alias` ou le chemin d'accès au fichier du modèle)."

msgctxt "settings schema"
msgid "The model name in the Ollama API (e.g. \"llama3.2:latest\")"
msgstr "Le nom du modèle dans l'API Ollama (p. ex. \"llama3.2:latest\")"

msgctxt "settings schema"
msgid "The model to use for subagents spawned via the `spawn_agent` tool. Defaults to the parent agent's model when not specified."
msgstr "Le modèle à utiliser pour les sous-agents créés via l'outil `spawn_agent`. Utilise par défaut le modèle de l'agent parent si non spécifié."

msgctxt "settings schema"
msgid "The model's context window size."
msgstr "La taille de la fenêtre de contexte du modèle."

msgctxt "settings schema"
msgid "The model's mode (e.g. thinking)"
msgstr "Le mode du modèle (p. ex. thinking)"

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the agent panel."
msgstr "Le nom du modèle dans l'interface de ForgeKairos, tel que dans le menu déroulant de sélection de modèle du panneau de l'agent."

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the assistant panel."
msgstr "Nom du modèle dans l'interface de ForgeKairos, par exemple dans le menu déroulant de sélection du modèle du panneau de l'assistant."

msgctxt "settings schema"
msgid "The model's name in the Anthropic API. e.g. claude-3-5-sonnet-latest, claude-3-opus-20240229, etc"
msgstr "Le nom du modèle dans l'API Anthropic. P. ex. claude-3-5-sonnet-latest, claude-3-opus-20240229, etc."

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-20240620"
msgstr "Le nom du modèle dans l'API du fournisseur. P. ex. claude-3-5-sonnet-20240620"

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-latest"
msgstr "Nom du modèle dans l'API du fournisseur, p. ex. claude-3-5-sonnet-latest"

msgctxt "settings schema"
msgid "The multiplier for scrolling with the mouse wheel.\n\nDefault: 1.0"
msgstr "Le multiplicateur du défilement avec la molette de la souris.\n\nValeur par défaut : 1.0"

msgctxt "settings schema"
msgid "The name displayed in the UI, such as in the agent panel model dropdown menu."
msgstr "Le nom affiché dans l'interface, tel que dans le menu déroulant de modèle du panneau de l'agent."

msgctxt "settings schema"
msgid "The name of a font to use for agent responses in the agent panel. Falls back to the UI font if unset."
msgstr "Le nom d'une police à utiliser pour les réponses de l'agent dans le panneau de l'agent. Utilise la police d'interface si non définie."

msgctxt "settings schema"
msgid "The name of a font to use for code (code blocks and inline code) in the\nmarkdown preview. Falls back to the buffer font if unset."
msgstr "Le nom d'une police à utiliser pour le code (blocs de code et code en ligne) dans l'aperçu Markdown. Utilise la police du tampon si elle n'est pas définie."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in text buffers."
msgstr "Le nom d'une police à utiliser pour le rendu dans les tampons de texte."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the UI."
msgstr "Le nom d'une police à utiliser pour le rendu dans l'interface."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the markdown preview.\nFalls back to the UI font if unset."
msgstr "Le nom d'une police à utiliser pour le rendu de l'aperçu Markdown. Utilise la police de l'interface si elle n'est pas définie."

msgctxt "settings schema"
msgid "The name of a font to use for user messages in the agent panel. Falls back to the buffer font if unset."
msgstr "Le nom d'une police à utiliser pour les messages de l'utilisateur dans le panneau de l'agent. Utilise la police du tampon si non définie."

msgctxt "settings schema"
msgid "The name of the Zed theme to use."
msgstr "Le nom du thème ForgeKairos à utiliser."

msgctxt "settings schema"
msgid "The name of the icon theme to use."
msgstr "Le nom du thème d'icônes à utiliser."

msgctxt "settings schema"
msgid "The name of the language server to format with"
msgstr "Le nom du serveur de langage à utiliser pour la mise en forme"

msgctxt "settings schema"
msgid "The name of the model.\n\nDefault: \"\""
msgstr "Le nom du modèle.\n\nValeur par défaut : \"\""

msgctxt "settings schema"
msgid "The name the account is picked by, unique among the accounts."
msgstr "Le nom par lequel le compte est choisi, unique parmi les comptes."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files, which answers\nproject-wide symbol search, \"go to definition\" when the language server has\nno answer, and callers and callees, without compilation information."
msgstr "L'index des symboles par nom des fichiers C et C++, qui répond à la recherche de symboles dans tout le projet, à \"atteindre la définition\" lorsque le serveur de langage n'a pas de réponse, et aux appelants et appelés, sans informations de compilation."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files."
msgstr "L'index des symboles par nom des fichiers C et C++."

msgctxt "settings schema"
msgid "The number of characters to keep on either side when scrolling with the mouse.\n\nDefault: 5."
msgstr "Le nombre de caractères à conserver de part et d'autre lors du défilement avec la souris.\n\nValeur par défaut : 5."

msgctxt "settings schema"
msgid "The number of lines to keep above/below the cursor when auto-scrolling.\n\nDefault: 3."
msgstr "Le nombre de lignes à conserver au-dessus/en dessous du curseur lors du défilement automatique.\n\nValeur par défaut : 3."

msgctxt "settings schema"
msgid "The number of seconds to keep the connection open after the last request"
msgstr "Le nombre de secondes pendant lesquelles maintenir la connexion ouverte après la dernière requête"

msgctxt "settings schema"
msgid "The page opened when a built-in browser panel or tab first loads.\n\nDefault: https://m365.cloud.microsoft/chat"
msgstr "La page ouverte au premier chargement d'un panneau ou d'un onglet du navigateur intégré.\n\nValeur par défaut : https://m365.cloud.microsoft/chat"

msgctxt "settings schema"
msgid "The path of the directory where journal entries are stored.\n\nDefault: `~`"
msgstr "Le chemin du répertoire dans lequel les entrées du journal sont stockées.\n\nValeur par défaut : `~`"

msgctxt "settings schema"
msgid "The path to the Node binary."
msgstr "Le chemin d'accès au binaire Node."

msgctxt "settings schema"
msgid "The path to the npm binary Zed should use (defaults to `.path/../npm`)."
msgstr "Le chemin d'accès au binaire npm que ForgeKairos doit utiliser (par défaut `.path/../npm`)."

msgctxt "settings schema"
msgid "The position of outline panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "La position du panneau de structure\n\nValeur par défaut : right (disposition Agentic), left (disposition Classic)"

msgctxt "settings schema"
msgid "The position of project panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "La position du panneau de projet\n\nValeur par défaut : right (disposition Agentic), left (disposition Classic)"

msgctxt "settings schema"
msgid "The private key file (an absolute path, or one starting with `~`) that pushing, pulling\nand fetching reach SSH remotes with, offered alone (`IdentitiesOnly`). Local projects\nonly. Not used when `GIT_SSH_COMMAND`, `GIT_SSH` or `core.sshCommand` is set."
msgstr "Le fichier de clé privée (un chemin absolu, ou commençant par `~`) avec lequel l'envoi (push), le tirage (pull) et la récupération (fetch) joignent les dépôts distants SSH, proposé seul (`IdentitiesOnly`). Projets locaux uniquement. Non utilisé lorsque `GIT_SSH_COMMAND`, `GIT_SSH` ou `core.sshCommand` est défini."

msgctxt "settings schema"
msgid "The program to run."
msgstr "Le programme à exécuter."

msgctxt "settings schema"
msgid "The prompt format to use for completions. Set to `\"\"` to have the format be derived from the model name.\n\nDefault: \"\""
msgstr "Le format de prompt à utiliser pour les complétions. Définissez `\"\"` pour que le format soit déduit du nom du modèle.\n\nValeur par défaut : \"\""

msgctxt "settings schema"
msgid "The provider of the language model."
msgstr "Le fournisseur du modèle de langage."

msgctxt "settings schema"
msgid "The provider that supplies edit predictions."
msgstr "Le fournisseur de prédictions de modification."

msgctxt "settings schema"
msgid "The regex pattern to match."
msgstr "Le motif d'expression régulière à faire correspondre."

msgctxt "settings schema"
msgid "The relative width of the left padding of the central pane from the\nworkspace when the centered layout is used.\n\nDefault: 0.2"
msgstr "La largeur relative de la marge gauche du volet central par rapport à l'espace de travail lorsque la disposition centrée est utilisée.\n\nValeur par défaut : 0.2"

msgctxt "settings schema"
msgid "The settings for a particular language."
msgstr "Les paramètres pour un langage particulier."

msgctxt "settings schema"
msgid "The settings for cursor shape."
msgstr "Les paramètres de forme du curseur."

msgctxt "settings schema"
msgid "The settings for indent guides."
msgstr "Les paramètres des guides d'indentation."

msgctxt "settings schema"
msgid "The settings for individual languages."
msgstr "Les paramètres des langages individuels."

msgctxt "settings schema"
msgid "The settings for inlay hints."
msgstr "Les paramètres des indications intégrées."

msgctxt "settings schema"
msgid "The settings for the image viewer."
msgstr "Les paramètres de la visionneuse d'images."

msgctxt "settings schema"
msgid "The settings for the markdown preview."
msgstr "Les paramètres de l'aperçu Markdown."

msgctxt "settings schema"
msgid "The settings for this context server specified by the extension.\n\nConsult the documentation for the context server to see what settings\nare supported."
msgstr "Les paramètres de ce serveur de contexte spécifiés par l'extension.\n\nConsultez la documentation du serveur de contexte pour connaître les paramètres pris en charge."

msgctxt "settings schema"
msgid "The settings overrides for this profile."
msgstr "Les remplacements de paramètres pour ce profil."

msgctxt "settings schema"
msgid "The shape of a selection cursor."
msgstr "La forme du curseur de sélection."

msgctxt "settings schema"
msgid "The shift key"
msgstr "La touche Shift"

msgctxt "settings schema"
msgid "The size of the context window, indicating the maximum number of tokens the model can process."
msgstr "La taille de la fenêtre de contexte, indiquant le nombre maximal de jetons que le modèle peut traiter."

msgctxt "settings schema"
msgid "The size of the workspace split drop targets on the outer edges.\nGiven as a fraction that will be multiplied by the smaller dimension of the workspace.\n\nDefault: `0.2` (20% of the smaller dimension of the workspace)"
msgstr "La taille des zones de dépôt de fractionnement de l'espace de travail sur les bords extérieurs. Exprimée sous forme de fraction multipliée par la plus petite dimension de l'espace de travail.\n\nValeur par défaut : `0.2` (20 % de la plus petite dimension de l'espace de travail)"

msgctxt "settings schema"
msgid "The smallest model context window (in tokens) for which auto-compaction\nstill runs. Models below this are left uncompacted and the UI warns\nabout the token limit instead. Lower this to make auto-compaction work\nwith local models that have a small context window. Values below 8000\nare clamped to 8000.\n\nDefault: 80000"
msgstr "La plus petite fenêtre de contexte de modèle (en jetons) pour laquelle le compactage automatique s'exécute encore. Les modèles en dessous ne sont pas compactés et l'interface avertit plutôt de la limite de jetons. Abaissez cette valeur pour que le compactage automatique fonctionne avec les modèles locaux à petite fenêtre de contexte. Les valeurs inférieures à 8000 sont ramenées à 8000.\n\nValeur par défaut : 80000"

msgctxt "settings schema"
msgid "The standard spacing of entries."
msgstr "L'espacement standard des entrées."

msgctxt "settings schema"
msgid "The state of the modifier keys at some point in time"
msgstr "L'état des touches de modification à un instant donné"

msgctxt "settings schema"
msgid "The step should allow one instruction to execute (e.g. one x86 instruction)."
msgstr "Le pas doit permettre l'exécution d'une instruction (par exemple, une instruction x86)."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current source line has executed."
msgstr "Le pas doit permettre au programme de s'exécuter jusqu'à ce que la ligne source courante ait été exécutée."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current statement has finished executing.\nThe meaning of a statement is determined by the adapter and it may be considered equivalent to a line.\nFor example 'for(int i = 0; i < 10; i++)' could be considered to have 3 statements 'int i = 0', 'i < 10', and 'i++'."
msgstr "Le pas doit permettre au programme de s'exécuter jusqu'à la fin de l'exécution de l'instruction actuelle. La signification d'une instruction est déterminée par l'adaptateur et peut être considérée comme équivalente à une ligne. Par exemple, 'for(int i = 0; i < 10; i++)' peut être considéré comme contenant 3 instructions : 'int i = 0', 'i < 10' et 'i++'."

msgctxt "settings schema"
msgid "The styles for syntax nodes."
msgstr "Les styles pour les nœuds syntaxiques."

msgctxt "settings schema"
msgid "The subscription for this model: \"zen\" or \"go\". Defaults to Zen."
msgstr "L'abonnement pour ce modèle : \"zen\" ou \"go\". Par défaut : Zen."

msgctxt "settings schema"
msgid "The task settings for a particular language."
msgstr "Les paramètres de tâche pour un langage particulier."

msgctxt "settings schema"
msgid "The text rendering mode to use.\n\nDefault: platform_default"
msgstr "Le mode de rendu du texte à utiliser.\n\nValeur par défaut : platform_default"

msgctxt "settings schema"
msgid "The theme to use for dark mode."
msgstr "Le thème à utiliser pour le mode sombre."

msgctxt "settings schema"
msgid "The theme to use for light mode."
msgstr "Le thème à utiliser pour le mode clair."

msgctxt "settings schema"
msgid "The theme to use for the markdown preview.\nFalls back to the main editor theme if unset."
msgstr "Le thème à utiliser pour l'aperçu Markdown. Utilise le thème principal de l'éditeur s'il n'est pas défini."

msgctxt "settings schema"
msgid "The threshold at which auto-compaction runs. This is one of:\n\n- A percentage string ending in `%`, e.g. `\"90%\"`, measured against the\n  model's context window. `\"90%\"` compacts once the context is 90% full.\n- A positive integer: compaction runs once that many tokens have been\n  used. For example, `100000` compacts after 100,000 tokens are used.\n- A negative integer: compaction runs once that many tokens remain in\n  the context window. For example, `-20000` compacts once there are\n  fewer than 20,000 tokens of headroom left in the context window.\n\n`0` is not a valid threshold.\n\nDefault: \"90%\""
msgstr "Le seuil à partir duquel le compactage automatique s'exécute. Il s'agit de l'un des éléments suivants :\n\n- Une chaîne de pourcentage se terminant par `%`, p. ex. `\"90%\"`, mesurée par rapport à la fenêtre de contexte du modèle. `\"90%\"` compacte dès que le contexte est plein à 90 %.\n- Un entier positif : le compactage s'exécute dès que ce nombre de jetons a été utilisé. Par exemple, `100000` compacte après l'utilisation de 100,000 jetons.\n- Un entier négatif : le compactage s'exécute dès qu'il reste ce nombre de jetons dans la fenêtre de contexte. Par exemple, `-20000` compacte dès qu'il reste moins de 20,000 jetons de marge dans la fenêtre de contexte.\n\n`0` n'est pas un seuil valide.\n\nValeur par défaut : \"90%\""

msgctxt "settings schema"
msgid "The topic whose entries to show first, such as \"merge_request\". Without it, the usual order."
msgstr "Le sujet dont les entrées doivent être affichées en premier, comme \"merge_request\". Sans lui, l'ordre habituel."

msgctxt "settings schema"
msgid "The type of the provider.\n\nMust be one of `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut`, or `tangled`."
msgstr "Le type du fournisseur.\n\nDoit être l'un de `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut` ou `tangled`."

msgctxt "settings schema"
msgid "The unit to use for displaying image file sizes.\n\nDefault: \"binary\""
msgstr "L'unité à utiliser pour afficher la taille des fichiers image.\n\nValeur par défaut : \"binary\""

msgctxt "settings schema"
msgid "The user name on `host` that goes with the token."
msgstr "Le nom d'utilisateur sur `host` associé au jeton."

msgctxt "settings schema"
msgid "The value to pass to the CLI's `--effort`, such as `low`, `medium` or `high`. Without it, the CLI uses its default."
msgstr "La valeur à passer à l'option `--effort` de la CLI, comme `low`, `medium` ou `high`. Sans elle, la CLI utilise sa valeur par défaut."

msgctxt "settings schema"
msgid "The weight of the UI font in CSS units from 100 to 900."
msgstr "La graisse de la police de l'interface en unités CSS de 100 à 900."

msgctxt "settings schema"
msgid "The weight of the editor font in CSS units from 100 to 900."
msgstr "La graisse de la police de l'éditeur en unités CSS de 100 à 900."

msgctxt "settings schema"
msgid "The width of the active indent guide in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "La largeur du guide d'indentation actif en pixels, entre 1 et 10.\n\nValeur par défaut : 1"

msgctxt "settings schema"
msgid "The width of the git diff hunk indicators in the gutter.\nUse \"default\" to scale with the buffer font size, or {\"custom\": <pixels>} for a fixed width.\n\nDefault: \"default\""
msgstr "La largeur des indicateurs de blocs de modifications Git dans la gouttière. Utilisez \"default\" pour suivre la taille de police du tampon, ou {\"custom\": <pixels>} pour une largeur fixe.\n\nValeur par défaut : \"default\""

msgctxt "settings schema"
msgid "The width of the indent guides in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "La largeur des guides d'indentation en pixels, entre 1 et 10.\n\nValeur par défaut : 1"

msgctxt "settings schema"
msgid "The window manager or compositor draws the server-side window\ndecorations (not supported by GNOME Wayland)."
msgstr "Le gestionnaire de fenêtres ou le compositeur dessine les décorations de fenêtre côté serveur (non pris en charge par GNOME Wayland)."

msgctxt "settings schema"
msgid "Theme name."
msgstr "Nom du thème."

msgctxt "settings schema"
msgid "Thinking blocks are always collapsed by default."
msgstr "Les blocs de réflexion sont toujours réduits par défaut."

msgctxt "settings schema"
msgid "Thinking blocks are always fully expanded by default (no height constraint)."
msgstr "Les blocs de réflexion sont toujours entièrement développés par défaut (sans contrainte de hauteur)."

msgctxt "settings schema"
msgid "Thinking blocks auto-expand with a height constraint during streaming,\nthen remain in their constrained state when complete. Users can click\nto fully expand or collapse."
msgstr "Les blocs de réflexion se développent automatiquement avec une hauteur limitée pendant le streaming, puis restent dans cet état limité une fois terminés. Les utilisateurs peuvent cliquer pour les développer entièrement ou les réduire."

msgctxt "settings schema"
msgid "Thinking blocks fully expand during streaming, then auto-collapse\nwhen the model finishes thinking. Users can re-expand after collapse."
msgstr "Les blocs de réflexion se développent entièrement pendant le streaming, puis se réduisent automatiquement lorsque le modèle a fini de réfléchir. Les utilisateurs peuvent les développer à nouveau après la réduction."

msgctxt "settings schema"
msgid "Thinking effort levels this model accepts in Ollama's `think` parameter,\nfor example `[\"low\", \"medium\", \"high\"]`. Only some models (e.g. `gpt-oss`)\naccept a level instead of a plain on/off; leave unset for those that don't."
msgstr "Niveaux de réflexion que ce modèle accepte dans le paramètre `think` d'Ollama, par exemple `[\"low\", \"medium\", \"high\"]`. Seuls certains modèles (p. ex. `gpt-oss`) acceptent un niveau au lieu d'un simple activé/désactivé ; laissez ce paramètre non défini pour les autres."

msgctxt "settings schema"
msgid "This base keymap settings adjusts the default keybindings in Zed to be similar\nto other common code editors. By default, Zed's keymap closely follows VSCode's\nkeymap, with minor adjustments, this corresponds to the \"VSCode\" setting.\n\nDefault: VSCode"
msgstr "Ce paramètre de raccourcis de base ajuste les combinaisons de touches par défaut de ForgeKairos pour qu'elles ressemblent à celles d'autres éditeurs de code courants. Par défaut, les raccourcis clavier de ForgeKairos suivent de près ceux de VSCode, avec de légers ajustements ; cela correspond au paramètre \"VSCode\".\n\nValeur par défaut : VSCode"

msgctxt "settings schema"
msgid "Time in milliseconds until timeout error when connecting to a TCP debug adapter\n\nDefault: 2000ms"
msgstr "Délai en millisecondes avant une erreur d'expiration lors de la connexion à un adaptateur de débogage TCP\n\nValeur par défaut : 2000ms"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before hiding the hover popover\nafter the mouse moves away from the hover target.\nOnly applies when `hover_popover_sticky` is enabled.\n\nDefault: 300"
msgstr "Délai d'attente en millisecondes avant de masquer la fenêtre de survol après que la souris s'est éloignée de la cible du survol. Ne s'applique que lorsque `hover_popover_sticky` est activé.\n\nValeur par défaut : 300"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before showing the informational hover box.\nThis delay also applies to auto signature help when `auto_signature_help` is enabled.\n\nDefault: 300"
msgstr "Délai d'attente en millisecondes avant d'afficher la fenêtre d'informations au survol. Ce délai s'applique aussi à l'aide à la signature automatique lorsque `auto_signature_help` est activé.\n\nValeur par défaut : 300"

msgctxt "settings schema"
msgid "Timeout for hover and Cmd-click path hyperlink discovery in milliseconds.\n\nDefault: 1"
msgstr "Délai d'expiration, en millisecondes, de la détection des liens hypertexte de chemins au survol et au Cmd-clic.\n\nValeur par défaut : 1"

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to 60 if not specified."
msgstr "Délai d'expiration des appels d'outils en secondes. La valeur par défaut est 60 si elle n'est pas spécifiée."

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to global context_server_timeout if not specified."
msgstr "Délai d'expiration des appels d'outils, en secondes. La valeur globale de context_server_timeout est utilisée par défaut si aucune valeur n'est spécifiée."

msgctxt "settings schema"
msgid "Timeout in milliseconds for automatically dismissing language server notifications.\nSet to 0 to disable auto-dismiss.\n\nDefault: 5000"
msgstr "Délai en millisecondes avant la fermeture automatique des notifications des serveurs de langage. Définissez 0 pour désactiver la fermeture automatique.\n\nValeur par défaut : 5000"

msgctxt "settings schema"
msgid "Timeout in seconds for SSH connection and downloading the remote server binary.\nDefaults to 10 seconds if not specified."
msgstr "Délai d'expiration en secondes pour la connexion SSH et le téléchargement du binaire du serveur distant. 10 secondes par défaut s'il n'est pas spécifié."

msgctxt "settings schema"
msgid "Toggles inlay hints (hides or shows) when the user presses the modifiers specified.\nIf only a subset of the modifiers specified is pressed, hints are not toggled.\nIf no modifiers are specified, this is equivalent to `null`.\n\nDefault: null"
msgstr "Affiche ou masque les indications intégrées lorsque l'utilisateur appuie sur les modificateurs spécifiés. Si seule une partie des modificateurs spécifiés est enfoncée, les indications ne basculent pas. Si aucun modificateur n'est spécifié, cela équivaut à `null`.\n\nValeur par défaut : null"

msgctxt "settings schema"
msgid "Toolbar related settings"
msgstr "Paramètres relatifs à la barre d'outils"

msgctxt "settings schema"
msgid "Treat files and folders matching these glob patterns as hidden, including\nfiles inside matching folders. To hide these entries, run\n`project panel: toggle hide hidden` from the command palette or set\n`project_panel.hide_hidden` to `true`.\n\nDefault:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Traite les fichiers et dossiers correspondant à ces motifs glob comme masqués, y compris les fichiers des dossiers correspondants. Pour masquer ces entrées, exécutez `project panel: toggle hide hidden` depuis la palette de commandes ou définissez `project_panel.hide_hidden` sur `true`.\n\nValeur par défaut :\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUtilisez `\"...\"` pour ajouter des motifs sans répéter les valeurs par défaut de ForgeKairos. Dans les paramètres du projet, cela étend la valeur de la configuration utilisateur ou parente. Omettez `\"...\"` pour remplacer la liste héritée.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nLes motifs hérités sont insérés à la place de `\"...\"`, et les doublons conservent leur première occurrence."

msgctxt "settings schema"
msgid "Treat files matching these glob patterns as read-only when opened. You can\nview but not edit them, which is useful for build outputs, external\ndependencies, or generated files.\n\nDefault:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Traite les fichiers correspondant à ces motifs glob comme étant en lecture seule à l'ouverture. Vous pouvez les afficher mais pas les modifier, ce qui est utile pour les sorties de compilation, les dépendances externes ou les fichiers générés.\n\nValeur par défaut :\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUtilisez `\"...\"` pour ajouter des motifs sans répéter les valeurs par défaut de ForgeKairos. Dans les paramètres du projet, cela étend la valeur de la configuration utilisateur ou parente. Omettez `\"...\"` pour remplacer la liste héritée.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nLes motifs hérités sont insérés à la place de `\"...\"`, et les doublons conservent leur première occurrence."

msgctxt "settings schema"
msgid "Treat the files matching these globs as `.env` files.\nDefault: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"
msgstr "Traite les fichiers correspondant à ces globs comme des fichiers `.env`.\nValeur par défaut : [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"

msgctxt "settings schema"
msgid "UNSTABLE: Expect many elements to be broken."
msgstr "INSTABLE : de nombreux éléments peuvent ne pas fonctionner correctement."

msgctxt "settings schema"
msgid "Underline cursor."
msgstr "Curseur souligné."

msgctxt "settings schema"
msgid "Uppercase names are grouped before lowercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Les noms en majuscules sont regroupés avant les noms en minuscules, avec un tri naturel insensible à la casse dans chaque groupe. Les noms commençant par un point sont triés avant les deux groupes."

msgctxt "settings schema"
msgid "Use CRLF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "Utilise CRLF pour les nouveaux fichiers et les fichiers sans convention de fin de ligne existante, tout en conservant les fichiers LF ou CRLF existants."

msgctxt "settings schema"
msgid "Use LF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "Utilise LF pour les nouveaux fichiers et les fichiers sans convention de fin de ligne existante, tout en conservant les fichiers LF ou CRLF existants."

msgctxt "settings schema"
msgid "Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server."
msgstr "Utilise le repli LSP autant que possible, en recourant au repli tree-sitter et basé sur l'indentation si le serveur ne renvoie aucun résultat."

msgctxt "settings schema"
msgid "Use LSP semantic tokens exclusively, replacing tree-sitter highlighting."
msgstr "Utilise exclusivement les jetons sémantiques LSP, en remplacement de la coloration tree-sitter."

msgctxt "settings schema"
msgid "Use LSP semantic tokens together with tree-sitter highlighting."
msgstr "Utilise les jetons sémantiques LSP conjointement avec la coloration tree-sitter."

msgctxt "settings schema"
msgid "Use LSP tasks over Zed language extension ones.\nIf no LSP tasks are returned due to error/timeout or regular execution,\nZed language extension tasks will be used instead.\n\nOther Zed tasks will still be shown:\n* Zed task from either of the task config file\n* Zed task from history (e.g. one-off task was spawned before)"
msgstr "Utilise les tâches LSP plutôt que celles des extensions de langage de ForgeKairos. Si aucune tâche LSP n'est renvoyée, en raison d'une erreur, d'une expiration ou d'une exécution normale, les tâches des extensions de langage de ForgeKairos sont utilisées à la place.\n\nLes autres tâches de ForgeKairos restent affichées :\n* Tâche ForgeKairos de l'un ou l'autre des fichiers de configuration des tâches\n* Tâche ForgeKairos de l'historique (p. ex. une tâche ponctuelle exécutée auparavant)"

msgctxt "settings schema"
msgid "Use a custom line height."
msgstr "Utilise une hauteur de ligne personnalisée."

msgctxt "settings schema"
msgid "Use a different color for each indentation level."
msgstr "Utilise une couleur différente pour chaque niveau d'indentation."

msgctxt "settings schema"
msgid "Use a line height that's comfortable for reading, 1.618"
msgstr "Utilise une hauteur de ligne confortable pour la lecture, 1.618"

msgctxt "settings schema"
msgid "Use a specific program with arguments."
msgstr "Utilise un programme spécifique avec des arguments."

msgctxt "settings schema"
msgid "Use a specific program with no arguments."
msgstr "Utilise un programme spécifique sans arguments."

msgctxt "settings schema"
msgid "Use a standard line height, 1.3. This option is useful for TUIs,\nparticularly if they use box characters"
msgstr "Utilise une hauteur de ligne standard, 1.3. Cette option est utile pour les TUI, en particulier si elles utilisent des caractères de dessin de boîtes"

msgctxt "settings schema"
msgid "Use all gitignored files"
msgstr "Utilise tous les fichiers ignorés par Git"

msgctxt "settings schema"
msgid "Use conda"
msgstr "Utilise conda"

msgctxt "settings schema"
msgid "Use grayscale text rendering."
msgstr "Utilise le rendu de texte en niveaux de gris."

msgctxt "settings schema"
msgid "Use macOS's native fullscreen, which moves the window into its own\nMission Control space."
msgstr "Utilise le plein écran natif de macOS, qui place la fenêtre dans son propre espace Mission Control."

msgctxt "settings schema"
msgid "Use mamba"
msgstr "Utilise mamba"

msgctxt "settings schema"
msgid "Use micromamba"
msgstr "Utilise micromamba"

msgctxt "settings schema"
msgid "Use only the files Zed had indexed"
msgstr "Utilise uniquement les fichiers indexés par ForgeKairos"

msgctxt "settings schema"
msgid "Use platform default behavior."
msgstr "Utilise le comportement par défaut de la plateforme."

msgctxt "settings schema"
msgid "Use subpixel (ClearType-style) text rendering."
msgstr "Utilise le rendu de texte sous-pixel (style ClearType)."

msgctxt "settings schema"
msgid "Use system clipboard for yank operations."
msgstr "Utilise le presse-papiers système pour les opérations de copie (yank)."

msgctxt "settings schema"
msgid "Use system clipboard."
msgstr "Utilise le presse-papiers système."

msgctxt "settings schema"
msgid "Use the current file's directory, falling back to the project directory,\nthen the first project in the workspace."
msgstr "Utilise le répertoire du fichier actuel, à défaut le répertoire du projet, puis le premier projet de l'espace de travail."

msgctxt "settings schema"
msgid "Use the current file's project directory. Fallback to the\nfirst project directory strategy if unsuccessful."
msgstr "Utilise le répertoire du projet du fichier actuel. En cas d'échec, revient à la stratégie du premier répertoire de projet."

msgctxt "settings schema"
msgid "Use the first project in this workspace's directory. Fallback to using\nthis platform's home directory."
msgstr "Utilise le répertoire du premier projet de cet espace de travail. À défaut, utilise le répertoire personnel de la plateforme."

msgctxt "settings schema"
msgid "Use the language server's `textDocument/documentSymbol` LSP response for outlines and\nbreadcrumbs. When enabled, tree-sitter is not used for document symbols."
msgstr "Utilise la réponse LSP `textDocument/documentSymbol` du serveur de langage pour la structure et le fil d'Ariane. Si cette option est activée, tree-sitter n'est pas utilisé pour les symboles de document."

msgctxt "settings schema"
msgid "Use the preference previously set via the status-bar toggle, or false\nif no preference has been stored."
msgstr "Utilise la préférence définie précédemment via le bouton de la barre d'état, ou false si aucune préférence n'a été enregistrée."

msgctxt "settings schema"
msgid "Use the same color for all indentation levels."
msgstr "Utilise la même couleur pour tous les niveaux d'indentation."

msgctxt "settings schema"
msgid "Use the specified `dark` theme."
msgstr "Utilise le thème `dark` spécifié."

msgctxt "settings schema"
msgid "Use the specified `light` theme."
msgstr "Utilise le thème `light` spécifié."

msgctxt "settings schema"
msgid "Use the system's default terminal configuration in /etc/passwd"
msgstr "Utilise la configuration de terminal par défaut du système dans /etc/passwd"

msgctxt "settings schema"
msgid "Use the theme based on the system's appearance."
msgstr "Utilise le thème en fonction de l'apparence du système."

msgctxt "settings schema"
msgid "Use tree-sitter queries to compute document symbols for outlines and breadcrumbs (default)."
msgstr "Utilise les requêtes tree-sitter pour calculer les symboles de document pour la structure et le fil d'Ariane (par défaut)."

msgctxt "settings schema"
msgid "Used for the background of a ghost element that should have the same background as the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have a different background than the surface it's on, use `element_background`."
msgstr "Utilisée pour l'arrière-plan d'un élément fantôme qui doit avoir le même arrière-plan que la surface sur laquelle il se trouve.\n\nLes éléments peuvent être : boutons, champs de saisie, cases à cocher, boutons radio...\n\nPour un élément qui doit avoir un arrière-plan différent de celui de la surface sur laquelle il se trouve, utilisez `element_background`."

msgctxt "settings schema"
msgid "Vertical bar cursor."
msgstr "Curseur en forme de barre verticale."

msgctxt "settings schema"
msgid "Vertically center the target in the viewport."
msgstr "Centre verticalement la cible dans la fenêtre d'affichage."

msgctxt "settings schema"
msgid "Visible characters used to render whitespace when show_whitespaces is enabled.\n\nDefault: \"•\" for spaces, \"→\" for tabs."
msgstr "Caractères visibles utilisés pour afficher les espaces blancs lorsque show_whitespaces est activé.\n\nValeur par défaut : \"•\" pour les espaces, \"→\" pour les tabulations."

msgctxt "settings schema"
msgid "What `git reset` keeps of the changes."
msgstr "Ce que `git reset` conserve des modifications."

msgctxt "settings schema"
msgid "What a new agent thread starts with in a project, keyed by the absolute\npath of the project's folder (for a project on a remote host, the\nhost's connection, `#`, then the path there). The chat input's buttons\ncan still change it for one thread; that change is not saved. Only read\nfrom the user settings file.\n\nDefault: {}"
msgstr "Comment une nouvelle conversation d'agent démarre dans un projet, indexé par le chemin absolu du dossier du projet (pour un projet sur un hôte distant : la connexion de l'hôte, `#`, puis le chemin sur cet hôte). Les boutons de la zone de saisie du chat peuvent toujours le modifier pour une conversation ; cette modification n'est pas enregistrée. Lu uniquement depuis le fichier de paramètres utilisateur.\n\nPar défaut : {}"

msgctxt "settings schema"
msgid "What base settings to start from before applying this profile's overrides.\n\n- `user`: Apply on top of user's settings (default)\n- `default`: Apply on top of Zed's default settings, ignoring user customizations"
msgstr "Paramètres de base à partir desquels appliquer les remplacements de ce profil.\n\n- `user` : s'applique par-dessus les paramètres de l'utilisateur (par défaut)\n- `default` : s'applique par-dessus les paramètres par défaut de ForgeKairos, en ignorant les personnalisations de l'utilisateur"

msgctxt "settings schema"
msgid "What format to display the hours in.\n\nDefault: hour12"
msgstr "Format d'affichage des heures.\n\nValeur par défaut : hour12"

msgctxt "settings schema"
msgid "What shell to use when opening a terminal.\n\nDefault: system"
msgstr "Shell à utiliser à l'ouverture d'un terminal.\n\nValeur par défaut : system"

msgctxt "settings schema"
msgid "What the default branch name should be when\n`init.defaultBranch` is not set in git\n\nDefault: main"
msgstr "Nom de la branche par défaut lorsque `init.defaultBranch` n'est pas défini dans Git\n\nValeur par défaut : main"

msgctxt "settings schema"
msgid "What to do after closing the current tab.\n\nDefault: history"
msgstr "Action à effectuer après la fermeture de l'onglet actuel.\n\nValeur par défaut : history"

msgctxt "settings schema"
msgid "What to do when go to definition yields no results."
msgstr "Action à effectuer lorsque l'accès à la définition ne renvoie aucun résultat."

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts\n(parts of singleton buffers).\n\nDefault: select"
msgstr "Action à effectuer lors d'un double-clic dans l'un des extraits d'un multi-tampon (parties de tampons uniques).\n\nValeur par défaut : select"

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts (parts of singleton buffers)."
msgstr "Action à effectuer lors d'un double-clic sur certains extraits du multi-tampon (parties de tampons uniques)."

msgctxt "settings schema"
msgid "What to do when the `BEL` character (`\\a`) is printed to terminal.\n\nDefault: \"system\""
msgstr "Action à effectuer lorsque le caractère `BEL` (`\\a`) est affiché dans le terminal.\n\nValeur par défaut : \"system\""

msgctxt "settings schema"
msgid "What to do when the last window is closed\n\nDefault: auto (nothing on macOS, \"app quit\" otherwise)"
msgstr "Action à effectuer lorsque la dernière fenêtre est fermée\n\nValeur par défaut : auto (rien sous macOS, \"app quit\" ailleurs)"

msgctxt "settings schema"
msgid "What to show for directories in the git panel.\n\nDefault: icon"
msgstr "Ce qu'il faut afficher pour les répertoires dans le panneau Git.\n\nValeur par défaut : icon"

msgctxt "settings schema"
msgid "What to show for directories in the outline panel.\n\nDefault: icon"
msgstr "Ce qu'il faut afficher pour les répertoires dans le panneau de structure.\n\nValeur par défaut : icon"

msgctxt "settings schema"
msgid "What to show for directories in the project panel.\n\nDefault: icon"
msgstr "Ce qu'il faut afficher pour les répertoires dans le panneau de projet.\n\nValeur par défaut : icon"

msgctxt "settings schema"
msgid "What to show when opening a new window.\nValues: empty_tab, launchpad\nDefault: launchpad"
msgstr "Ce qu'il faut afficher à l'ouverture d'une nouvelle fenêtre.\nValeurs : empty_tab, launchpad\nValeur par défaut : launchpad"

msgctxt "settings schema"
msgid "What working directory to use when launching the terminal\n\nDefault: current_project_directory"
msgstr "Répertoire de travail à utiliser au lancement du terminal\n\nValeur par défaut : current_project_directory"

msgctxt "settings schema"
msgid "When enabled, edit predictions are shown in Vim normal mode.\nBy default, edit predictions are only shown in insert and replace modes."
msgstr "Si cette option est activée, les prédictions de modification sont affichées en mode normal de Vim. Par défaut, les prédictions de modification ne sont affichées qu'en modes insertion et remplacement."

msgctxt "settings schema"
msgid "When enabled, the `:substitute` command replaces all matches in a line\nby default. The 'g' flag then toggles this behavior.,"
msgstr "Si cette option est activée, la commande `:substitute` remplace par défaut toutes les correspondances d'une ligne. L'indicateur 'g' inverse alors ce comportement."

msgctxt "settings schema"
msgid "When false, forcefully disables the horizontal scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Avec false, désactive de force la barre de défilement horizontale. Sinon, respecte les autres paramètres.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "When false, forcefully disables the vertical scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Avec false, désactive de force la barre de défilement verticale. Sinon, respecte les autres paramètres.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "When fetching LSP completions, determines how long to wait for a response of a particular server.\nWhen set to 0, waits indefinitely.\n\nDefault: 0"
msgstr "Lors de la récupération des complétions LSP, détermine combien de temps attendre la réponse d'un serveur donné. Avec 0, attend indéfiniment.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane."
msgstr "Quand le panneau de l'agent affiche la barre d'onglets de son propre volet."

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane.\n\nDefault: auto"
msgstr "Quand le panneau de l'agent affiche la barre d'onglets de son propre volet.\n\nValeur par défaut : auto"

msgctxt "settings schema"
msgid "When the attachments of one message add up to more than this many\nbytes, the largest ones are sent as an outline or a reference until the\nmessage fits. Attachments set to be sent in full are never reduced.\n\nDefault: 65536"
msgstr "Lorsque les pièces jointes d'un message dépassent ce nombre total d'octets, les plus volumineuses sont envoyées sous forme de structure ou de référence jusqu'à ce que le message tienne. Les pièces jointes configurées pour être envoyées en entier ne sont jamais réduites.\n\nValeur par défaut : 65536"

msgctxt "settings schema"
msgid "When to automatically save edited buffers.\n\nDefault: off"
msgstr "Quand enregistrer automatiquement les tampons modifiés.\n\nValeur par défaut : off"

msgctxt "settings schema"
msgid "When to index the worktree's C and C++ files.\n\nDefault: auto"
msgstr "Quand indexer les fichiers C et C++ de l'arborescence de travail.\n\nValeur par défaut : auto"

msgctxt "settings schema"
msgid "When to play a sound when the agent has either completed its response, or needs user input.\n\nDefault: never"
msgstr "Quand émettre un son lorsque l'agent a terminé sa réponse ou a besoin d'une saisie de l'utilisateur.\n\nValeur par défaut : never"

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor."
msgstr "Quand préremplir la requête d'une nouvelle recherche à partir du texte sous le curseur."

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor.\n\nDefault: always"
msgstr "Quand préremplir la requête d'une nouvelle recherche à partir du texte sous le curseur.\n\nValeur par défaut : always"

msgctxt "settings schema"
msgid "When to scan content of linked directories."
msgstr "Indique quand analyser le contenu des répertoires liés."

msgctxt "settings schema"
msgid "When to scan content of linked directories.\n\nDefault: expanded"
msgstr "Quand analyser le contenu des répertoires liés.\n\nValeur par défaut : expanded"

msgctxt "settings schema"
msgid "When to show the minimap in the editor.\n\nDefault: never"
msgstr "Quand afficher la minicarte dans l'éditeur.\n\nValeur par défaut : never"

msgctxt "settings schema"
msgid "When to show the minimap thumb.\n\nDefault: always"
msgstr "Quand afficher le curseur de défilement de la minicarte.\n\nValeur par défaut : always"

msgctxt "settings schema"
msgid "When to show the scrollbar in the completion menu.\nThis setting can take four values:\n\n1. Show the scrollbar if there's important information or\n   follow the system's configured behavior\n  \"auto\"\n2. Match the system's configured behavior:\n   \"system\"\n3. Always show the scrollbar:\n   \"always\"\n4. Never show the scrollbar:\n   \"never\" (default)"
msgstr "Quand afficher la barre de défilement dans le menu de complétion. Ce paramètre accepte quatre valeurs :\n\n1. Afficher la barre de défilement s'il y a des informations importantes, ou suivre le comportement configuré du système\n  \"auto\"\n2. Suivre le comportement configuré du système :\n   \"system\"\n3. Toujours afficher la barre de défilement :\n   \"always\"\n4. Ne jamais afficher la barre de défilement :\n   \"never\" (par défaut)"

msgctxt "settings schema"
msgid "When to show the scrollbar in the editor.\n\nDefault: auto"
msgstr "Quand afficher la barre de défilement dans l'éditeur.\n\nValeur par défaut : auto"

msgctxt "settings schema"
msgid "When to show the scrollbar in the outline panel."
msgstr "Quand afficher la barre de défilement dans le panneau de structure."

msgctxt "settings schema"
msgid "When to show the scrollbar in the project panel.\n\nDefault: inherits editor scrollbar settings"
msgstr "Quand afficher la barre de défilement dans le panneau de projet.\n\nValeur par défaut : hérite des paramètres de barre de défilement de l'éditeur"

msgctxt "settings schema"
msgid "When to show the scrollbar in the terminal.\n\nDefault: inherits editor scrollbar settings"
msgstr "Quand afficher la barre de défilement dans le terminal.\n\nValeur par défaut : hérite des paramètres de barre de défilement de l'éditeur"

msgctxt "settings schema"
msgid "When to show the scrollbar.\n\nDefault: auto"
msgstr "Quand afficher la barre de défilement.\n\nValeur par défaut : auto"

msgctxt "settings schema"
msgid "When true, enables drag and drop text selection in buffer.\n\nDefault: true"
msgstr "Avec true, active le glisser-déposer de la sélection de texte dans le tampon.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "When using OpenAiChat protocol, whether thinking tokens are sent as a dedicated `reasoning_content` field or inline in message text."
msgstr "Lors de l'utilisation du protocole OpenAiChat, indique si les jetons de raisonnement sont envoyés en tant que champ dédié `reasoning_content` ou en ligne dans le texte du message."

msgctxt "settings schema"
msgid "Where to dock the AI browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Où ancrer le panneau Navigateur IA. Peut être 'left', 'right' ou 'bottom'.\n\nValeur par défaut : right"

msgctxt "settings schema"
msgid "Where to dock the agent panel.\n\nDefault: left (Agentic layout), right (Classic layout)"
msgstr "Où ancrer le panneau de l'agent.\n\nValeur par défaut : left (disposition Agentic), right (disposition Classic)"

msgctxt "settings schema"
msgid "Where to dock the browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Où ancrer le panneau Navigateur. Peut être 'left', 'right' ou 'bottom'.\n\nValeur par défaut : right"

msgctxt "settings schema"
msgid "Where to dock the call graph panel.\n\nDefault: right"
msgstr "Où ancrer le panneau du graphe des appels.\n\nValeur par défaut : right"

msgctxt "settings schema"
msgid "Where to dock the panel.\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "Où ancrer le panneau.\n\nValeur par défaut : right (disposition Agentic), left (disposition Classic)"

msgctxt "settings schema"
msgid "Where to keep the changes."
msgstr "Où conserver les modifications."

msgctxt "settings schema"
msgid "Where to position the threads sidebar."
msgstr "Où positionner la barre latérale des conversations."

msgctxt "settings schema"
msgid "Where to position the threads sidebar.\n\nDefault: left"
msgstr "Où placer la barre latérale des conversations.\n\nValeur par défaut : left"

msgctxt "settings schema"
msgid "Where to render the blame information when enabled.\n\nDefault: inline"
msgstr "Où afficher les informations de blame lorsqu'elles sont activées.\n\nValeur par défaut : inline"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations\n(Go to Definition, Go to Implementation, Find All References). A single\nresult always opens directly. Individual actions can override this with\ntheir `open_results_in` argument.\n\nDefault: multi_buffer"
msgstr "Où afficher les résultats LSP pouvant contenir plusieurs emplacements (Atteindre la définition, Atteindre l'implémentation, Rechercher toutes les références). Un résultat unique s'ouvre toujours directement. Chaque action peut remplacer ce comportement avec son argument `open_results_in`.\n\nValeur par défaut : multi_buffer"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations."
msgstr "Indique où afficher les résultats LSP pouvant contenir plusieurs emplacements."

msgctxt "settings schema"
msgid "Where to show a popup notification when the agent is waiting for user input.\n\nDefault: \"primary_screen\""
msgstr "Où afficher une notification contextuelle lorsque l'agent attend une saisie de l'utilisateur.\n\nValeur par défaut : \"primary_screen\""

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: [`DisplayIn::ActiveEditor`]"
msgstr "Où afficher la minicarte dans l'éditeur.\n\nValeur par défaut : [`DisplayIn::ActiveEditor`]"

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: all_editors"
msgstr "Où afficher la minicarte dans l'éditeur.\n\nValeur par défaut : all_editors"

msgctxt "settings schema"
msgid "Whether \"Launch Claude Code\" always launches outside the sandbox, without\nasking. Outside, writes are not restricted, and network restrictions only\napply to programs that read the proxy settings (and not at all on SSH\nhosts). Can only be set in the user settings, not in a project's settings.\n\nDefault: false"
msgstr "Indique si \"Lancer Claude Code\" lance toujours hors du bac à sable, sans demander. Hors du bac à sable, les écritures ne sont pas restreintes, et les restrictions réseau ne s'appliquent qu'aux programmes qui lisent les paramètres de proxy (et pas du tout sur les hôtes SSH). Ne peut être défini que dans les paramètres utilisateur, pas dans les paramètres d'un projet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether AI agents (the built-in agent and MCP clients) may drive the\nbuilt-in browser's AI tabs, for debugging web apps.\n\nAI tabs use their own browser profile and always go through the egress\nallowlist proxy, whatever `use_egress_proxy` says.\n\nDefault: false"
msgstr "Indique si les agents IA (l'agent intégré et les clients MCP) peuvent piloter les onglets IA du navigateur intégré, pour déboguer des applications Web.\n\nLes onglets IA utilisent leur propre profil de navigateur et passent toujours par le proxy de la liste d'autorisation des connexions sortantes, quelle que soit la valeur de `use_egress_proxy`.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether Anthropic's fast mode is available for this model."
msgstr "Indique si le mode rapide d'Anthropic est disponible pour ce modèle."

msgctxt "settings schema"
msgid "Whether SSH terminals keep their shell running on the remote host\nacross disconnects, and for how long."
msgstr "Indique si les terminaux SSH laissent leur shell s'exécuter sur l'hôte distant malgré les déconnexions, et pendant combien de temps."

msgctxt "settings schema"
msgid "Whether a new agent thread starts with Git operations turned on: the\nagent gets the `git` tool, which runs git (with every hook turned off)\nafter each call is approved. The chat input's Git button turns it on\nor off for one thread.\n\nDefault: true"
msgstr "Indique si une nouvelle conversation de l'agent démarre avec les opérations Git activées : l'agent obtient l'outil `git`, qui exécute git (avec tous les hooks désactivés) après l'approbation de chaque appel. Le bouton Git de la zone de saisie du chat l'active ou le désactive pour une conversation.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether a terminal opened over SSH runs its shell inside a session the\nremote server keeps alive, so that a dropped connection neither stops\nrunning commands nor loses the output: reconnecting shows everything\nagain and continues. Only for SSH hosts that are not Windows.\n\nDefault: true"
msgstr "Indique si un terminal ouvert via SSH exécute son shell dans une session que le serveur distant maintient active, afin qu'une connexion perdue n'arrête pas les commandes en cours ni ne perde la sortie : la reconnexion réaffiche tout et reprend. Uniquement pour les hôtes SSH qui ne sont pas sous Windows.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether a worktree an agent wrote into stops running its own code\n(project language server modes, formatters, the project's prettier)\nuntil the user reviews the changes and resumes it. Read from the user\nsettings file only: project and server settings cannot turn it off.\n\nDefault: true"
msgstr "Indique si une arborescence de travail dans laquelle un agent a écrit cesse d'exécuter son propre code (modes de serveur de langage du projet, formateurs, prettier du projet) jusqu'à ce que l'utilisateur examine les modifications et la relance. Lu uniquement dans le fichier de paramètres utilisateur : les paramètres du projet et du serveur ne peuvent pas le désactiver.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether agents connected over the IDE server may read the output of the\nlast task that failed in this window (the `getLastTaskOutput` tool, at\nmost the last 4 KB of the task's terminal).\n\nDefault: true"
msgstr "Indique si les agents connectés via le serveur IDE peuvent lire la sortie de la dernière tâche ayant échoué dans cette fenêtre (l'outil `getLastTaskOutput`, au plus les 4 derniers Ko du terminal de la tâche).\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether all context servers are enabled by default."
msgstr "Indique si tous les serveurs de contexte sont activés par défaut."

msgctxt "settings schema"
msgid "Whether and how to display code lenses from language servers.\n\nDefault: \"off\""
msgstr "Indique si et comment afficher les CodeLens des serveurs de langage.\n\nValeur par défaut : \"off\""

msgctxt "settings schema"
msgid "Whether anything the agent features start may run outside the sandbox\nat all. While this is off, every new way out is refused without asking:\nagent terminal commands that cannot run in the sandbox (and\n`allow_unsandboxed`, which is then ignored), external agents and Claude\nCode started outside it (the one-time starts and the \"always outside\"\nsettings, which are then ignored), and threads resumed outside it. A\nconnection already running outside the sandbox keeps running, and MCP\nservers (context servers) are not covered. While it is on, each of\nthose asks or follows its own setting as before. Only the user settings\nfile is read: neither a project's settings nor an agent can turn it on.\nDefault: false"
msgstr "Indique si quoi que ce soit lancé par les fonctionnalités de l'agent peut s'exécuter hors du bac à sable. Tant que cette option est désactivée, toute nouvelle sortie est refusée sans demande : les commandes de terminal de l'agent qui ne peuvent pas s'exécuter dans le bac à sable (et `allow_unsandboxed`, alors ignoré), les agents externes et Claude Code lancés hors du bac à sable (les lancements ponctuels et les paramètres \"toujours hors du bac à sable\", alors ignorés), et les conversations reprises hors du bac à sable. Une connexion déjà en cours d'exécution hors du bac à sable continue de s'exécuter, et les serveurs MCP (serveurs de contexte) ne sont pas concernés. Lorsque cette option est activée, chacun de ces éléments demande ou suit son propre paramètre comme avant. Seul le fichier de paramètres utilisateur est lu : ni les paramètres d'un projet ni un agent ne peuvent l'activer.\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether clangd indexes the whole project in the background. `light`\nskips that index (`--background-index=false`), which saves the most\nmemory: references, call hierarchy and renames then only cover the\nfiles that are open. Ignored when `lsp.clangd.binary.arguments`\nalready has `--background-index`.\n\nDefault: full"
msgstr "Indique si clangd indexe tout le projet en arrière-plan. `light` ignore cet index (`--background-index=false`), ce qui économise le plus de mémoire : les références, la hiérarchie des appels et les renommages ne couvrent alors que les fichiers ouverts. Ignoré lorsque `lsp.clangd.binary.arguments` contient déjà `--background-index`.\n\nValeur par défaut : full"

msgctxt "settings schema"
msgid "Whether clicking the stop button on a running terminal tool should also cancel the agent's generation.\nNote that this only applies to the stop button, not to ctrl+c inside the terminal.\n\nDefault: true"
msgstr "Indique si un clic sur le bouton d'arrêt d'un outil de terminal en cours d'exécution doit aussi annuler la génération de l'agent. Notez que cela ne s'applique qu'au bouton d'arrêt, pas à ctrl+c dans le terminal.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether cmd-click (ctrl-click on Linux and Windows) opens hyperlinks even\nwhen the terminal application has enabled mouse reporting (e.g. vim with\nmouse=a, htop). When false, these clicks are forwarded to the application\ninstead, and hyperlinks can still be opened with shift-cmd-click\n(shift-ctrl-click).\n\nDefault: true"
msgstr "Indique si cmd-clic (ctrl-clic sous Linux et Windows) ouvre les liens hypertexte même lorsque l'application du terminal a activé le signalement de la souris (p. ex. vim avec mouse=a, htop). Avec false, ces clics sont transmis à l'application, et les liens hypertexte peuvent toujours être ouverts avec shift-cmd-clic (shift-ctrl-clic).\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether cursor movement animation is enabled.\n\nDefault: false"
msgstr "Indique si l'animation du déplacement du curseur est activée.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether every new terminal starts recording its output automatically.\n\nDefault: false"
msgstr "Indique si chaque nouveau terminal commence automatiquement à enregistrer sa sortie.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether hovering a name in C and C++ also shows what its type holds\n(members, enumerators, a macro's definition), found by name in the\nindex.\n\nDefault: true"
msgstr "Indique si le survol d'un nom en C et C++ affiche aussi le contenu de son type (membres, énumérateurs, définition d'une macro), trouvé par nom dans l'index.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether indentation of pasted content should be adjusted based on the context.\n\nDefault: true"
msgstr "Indique si l'indentation du contenu collé doit être ajustée selon le contexte.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether invoking a panel's `ToggleFocus` action while the panel is\nalready focused closes the panel, instead of just moving focus back\nto the editor. This only applies to a panel's focus-toggle action, not\nto its regular visibility-toggle action.\n\nDefault: false"
msgstr "Indique si l'appel de l'action `ToggleFocus` d'un panneau alors que ce panneau a déjà le focus ferme le panneau, au lieu de simplement redonner le focus à l'éditeur. Cela ne s'applique qu'à l'action de bascule du focus d'un panneau, pas à son action habituelle d'affichage/masquage.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether newly opened file diffs show the full file instead of changes only.\n\nDefault: true"
msgstr "Indique si les différences de fichier nouvellement ouvertes affichent le fichier complet au lieu des seules modifications.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether opening a folder in an existing window automatically opens the\nThreads Sidebar. Applies when `default_open_behavior` or\n`cli_default_open_behavior` is set to `existing_window`.\n\nDefault: true"
msgstr "Indique si l'ouverture d'un dossier dans une fenêtre existante ouvre automatiquement la barre latérale des conversations. S'applique lorsque `default_open_behavior` ou `cli_default_open_behavior` est défini sur `existing_window`.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not selecting text in the terminal will automatically\ncopy to the system clipboard.\n\nDefault: false"
msgstr "Indique si la sélection de texte dans le terminal est automatiquement copiée dans le presse-papiers du système.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether or not to automatically check for updates.\n\nDefault: false"
msgstr "Indique s'il faut rechercher automatiquement les mises à jour.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer edits.\n\nSet to 0 to disable debouncing.\n\nDefault: 700"
msgstr "Indique s'il faut appliquer un anti-rebond aux mises à jour des indications intégrées après les modifications du tampon.\n\nDéfinissez 0 pour désactiver l'anti-rebond.\n\nValeur par défaut : 700"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer scrolls.\n\nSet to 0 to disable debouncing.\n\nDefault: 50"
msgstr "Indique s'il faut appliquer un anti-rebond aux mises à jour des indications intégrées après le défilement du tampon.\n\nDéfinissez 0 pour désactiver l'anti-rebond.\n\nValeur par défaut : 50"

msgctxt "settings schema"
msgid "Whether or not to enable Helix mode.\n\nDefault: false"
msgstr "Indique s'il faut activer le mode Helix.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether or not to enable Vim mode.\n\nDefault: false"
msgstr "Indique s'il faut activer le mode Vim.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether or not to ensure there's a single newline at the end of a buffer\nwhen saving it.\n\nDefault: true"
msgstr "Indique s'il faut garantir un seul saut de ligne à la fin d'un tampon lors de son enregistrement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to include warning diagnostics.\n\nDefault: true"
msgstr "Indique s'il faut inclure les diagnostics d'avertissement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to keep the tab bar buttons on panes that are not active.\nWhen disabled, only the focused pane shows them, so a split leaves the\nother panes without a new / split / zoom button.\n\nDefault: true"
msgstr "Indique s'il faut conserver les boutons de la barre d'onglets sur les volets inactifs. Si cette option est désactivée, seul le volet qui a le focus les affiche ; un fractionnement laisse donc les autres volets sans bouton nouveau / fractionner / zoom.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to perform a buffer format before saving.\n\nDefault: on"
msgstr "Indique s'il faut mettre en forme le tampon avant l'enregistrement.\n\nValeur par défaut : on"

msgctxt "settings schema"
msgid "Whether or not to prompt the user to confirm before closing the application.\n\nDefault: false"
msgstr "Indique s'il faut demander une confirmation à l'utilisateur avant de fermer l'application.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether or not to remove any trailing whitespace from lines of a buffer\nbefore saving it.\n\nDefault: true"
msgstr "Indique s'il faut supprimer les espaces blancs de fin de ligne d'un tampon avant de l'enregistrer.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to restore unsaved buffers on restart.\n\nIf this is true, user won't be prompted whether to save/discard\ndirty files when closing the application.\n\nDefault: true"
msgstr "Indique s'il faut restaurer les tampons non enregistrés au redémarrage.\n\nAvec true, l'utilisateur n'est pas invité à enregistrer ou abandonner les fichiers modifiés lors de la fermeture de l'application.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: on"
msgstr "Indique s'il faut afficher en ligne les données de blame Git sur la ligne qui a actuellement le focus.\n\nValeur par défaut : on"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: true"
msgstr "Indique s'il faut afficher en ligne les données de blame Git sur la ligne qui a actuellement le focus.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to show inline diagnostics\n\nDefault: false"
msgstr "Indique s'il faut afficher les diagnostics en ligne\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether or not to show pinned tabs in a separate row.\nWhen enabled, pinned tabs appear in a top row and unpinned tabs in a bottom row.\n\nDefault: false"
msgstr "Indique s'il faut afficher les onglets épinglés sur une rangée distincte. Si cette option est activée, les onglets épinglés apparaissent sur une rangée supérieure et les onglets non épinglés sur une rangée inférieure.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether or not to show the call status icon in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher l'icône d'état d'appel dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to show the git gutter.\n\nDefault: tracked_files"
msgstr "Indique s'il faut afficher la gouttière Git.\n\nValeur par défaut : tracked_files"

msgctxt "settings schema"
msgid "Whether or not to show the navigation history buttons in the tab bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons d'historique de navigation dans la barre d'onglets.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar buttons.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons de la barre d'onglets.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar in the editor.\n\nDefault: true"
msgstr "Indique s'il faut afficher la barre d'onglets dans l'éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether or not to skip worktree trust checks.\nWhen trusted, project settings are synchronized automatically,\nlanguage and MCP servers are downloaded and started automatically.\n\nDefault: false"
msgstr "Indique s'il faut ignorer les vérifications de confiance des arborescences de travail. En cas de confiance, les paramètres du projet sont synchronisés automatiquement, et les serveurs de langage et MCP sont téléchargés et démarrés automatiquement.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether other hints should be shown.\n\nDefault: true"
msgstr "Indique si les autres indications doivent être affichées.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether parameter hints should be shown.\n\nDefault: true"
msgstr "Indique si les indications de paramètres doivent être affichées.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether pressing enter should first append two spaces to the current line,\nwhich is how Markdown spells a hard line break. Lines where the break would\nbe dropped (headings, tables, list items, code fences, blank lines, and lines\nthat already end in a break) are left alone.\n\nDefault: false"
msgstr "Indique si l'appui sur Enter doit d'abord ajouter deux espaces à la ligne actuelle, ce qui correspond à un saut de ligne forcé en Markdown. Les lignes où le saut serait ignoré (titres, tableaux, éléments de liste, délimiteurs de code, lignes vides et lignes se terminant déjà par un saut) ne sont pas modifiées.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may always reach any host over the\nnetwork without prompting.\nDefault: false"
msgstr "Indique si les commandes de terminal en bac à sable peuvent toujours joindre n'importe quel hôte sur le réseau sans demande.\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may write anywhere on the\nfilesystem except protected paths. That is nearly the same as running\noutside the sandbox, so while this is on terminal commands are never\nauto-approved: each one asks first.\nDefault: false"
msgstr "Indique si les commandes de terminal en bac à sable peuvent écrire n'importe où dans le système de fichiers, sauf dans les chemins protégés. Cela revient presque à s'exécuter hors du bac à sable ; tant que cette option est activée, les commandes de terminal ne sont donc jamais approuvées automatiquement : chacune demande d'abord.\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether sticky scroll is enabled.\n\nDefault: false"
msgstr "Indique si le défilement fixe est activé.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the Agent is enabled.\n\nDefault: true"
msgstr "Indique si l'agent est activé.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the Copilot Next Edit Suggestions feature is enabled.\n\nDefault: true"
msgstr "Indique si la fonctionnalité Copilot Next Edit Suggestions est activée.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the Jupyter feature is enabled.\n\nDefault: true"
msgstr "Indique si la fonctionnalité Jupyter est activée.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the agent panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Indique si le panneau de l'agent doit s'ouvrir au démarrage, même si son dock était fermé la dernière fois.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the agent panel should use flexible (proportional) sizing when docked to the\nleft or right.\n\nWhen enabled, `default_width` does not control the panel width, and resetting the panel\nrestores the default proportion.\n\nDefault: true"
msgstr "Indique si le panneau de l'agent doit utiliser un dimensionnement flexible (proportionnel) lorsqu'il est ancré à gauche ou à droite.\n\nSi cette option est activée, `default_width` ne contrôle pas la largeur du panneau, et la réinitialisation du panneau rétablit la proportion par défaut.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the agent's terminal commands run in the sandbox. `false` runs\nthem outside it, which needs `sandbox_permissions.allow_outside_sandbox`;\nexternal agents then start outside it without asking."
msgstr "Si les commandes du terminal de l'agent s'exécutent dans le bac à sable. `false` les exécute hors de celui-ci, ce qui nécessite `sandbox_permissions.allow_outside_sandbox` ; les agents externes démarrent alors hors du bac à sable sans demander."

msgctxt "settings schema"
msgid "Whether the breakpoints should be reused across Zed sessions.\n\nDefault: true"
msgstr "Indique si les points d'arrêt doivent être réutilisés d'une session de ForgeKairos à l'autre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the browser panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Indique si le panneau Navigateur doit s'ouvrir au démarrage, même si son dock était fermé la dernière fois.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the built-in browser goes through the egress allowlist proxy.\n\nThe browser is human-driven, so like the terminal it is outside egress\ncontrol by default.\n\nDefault: false"
msgstr "Indique si le navigateur intégré passe par le proxy de la liste d'autorisation des connexions sortantes.\n\nLe navigateur est piloté par une personne ; comme le terminal, il est donc par défaut hors du contrôle des connexions sortantes.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the context server is enabled."
msgstr "Indique si le serveur de contexte est activé."

msgctxt "settings schema"
msgid "Whether the cursor blinks in the editor.\n\nDefault: true"
msgstr "Indique si le curseur clignote dans l'éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the editor search results will loop\n\nDefault: true"
msgstr "Indique si les résultats de recherche de l'éditeur bouclent\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the editor will scroll beyond the last line.\n\nDefault: one_page"
msgstr "Indique si l'éditeur défile au-delà de la dernière ligne.\n\nValeur par défaut : one_page"

msgctxt "settings schema"
msgid "Whether the focused panel follows the mouse location\nDefault: false"
msgstr "Indique si le panneau qui a le focus suit la position de la souris\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the folders of the macro picker start collapsed when it opens.\n\nDefault: false"
msgstr "Indique si les dossiers du sélecteur de macros sont réduits à son ouverture.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the git panel should open on startup.\n\nDefault: false"
msgstr "Indique si le panneau Git doit s'ouvrir au démarrage.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the hover popover sticks when the mouse moves toward it,\nallowing interaction with its contents before it disappears.\n\nDefault: true"
msgstr "Indique si la fenêtre de survol reste affichée lorsque la souris se dirige vers elle, ce qui permet d'interagir avec son contenu avant qu'elle disparaisse.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the line numbers on editors gutter are relative or not.\nWhen \"enabled\" shows relative number of buffer lines, when \"wrapped\" shows\nrelative number of display lines.\n\nDefault: \"disabled\""
msgstr "Indique si les numéros de ligne de la gouttière des éditeurs sont relatifs ou non. Avec \"enabled\", affiche le numéro relatif des lignes du tampon ; avec \"wrapped\", le numéro relatif des lignes affichées.\n\nValeur par défaut : \"disabled\""

msgctxt "settings schema"
msgid "Whether the microphone should be muted when joining a channel or a call.\n\nDefault: false"
msgstr "Indique si le microphone doit être coupé lorsque vous rejoignez un canal ou un appel.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the model emits reasoning/thinking content."
msgstr "Indique si le modèle émet du contenu de raisonnement/réflexion."

msgctxt "settings schema"
msgid "Whether the model emits thinking (reasoning) content."
msgstr "Indique si le modèle produit un contenu de réflexion (raisonnement)."

msgctxt "settings schema"
msgid "Whether the model supports tools"
msgstr "Indique si le modèle prend en charge les outils"

msgctxt "settings schema"
msgid "Whether the model supports tools."
msgstr "Indique si le modèle prend en charge les outils."

msgctxt "settings schema"
msgid "Whether the model supports vision"
msgstr "Indique si le modèle prend en charge la vision"

msgctxt "settings schema"
msgid "Whether the model supports vision."
msgstr "Indique si le modèle prend en charge la vision."

msgctxt "settings schema"
msgid "Whether the panel follows the cursor, making the function under it the\nroot whenever the cursor moves. When off, the root changes only when\nasked for.\n\nDefault: false"
msgstr "Indique si le panneau suit le curseur, en faisant de la fonction sous le curseur la racine chaque fois que celui-ci se déplace. Si cette option est désactivée, la racine ne change que sur demande.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether the project panel should open on startup.\n\nDefault: true"
msgstr "Indique si le panneau de projet doit s'ouvrir au démarrage.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the regex is case-sensitive.\nDefault: false (case-insensitive)"
msgstr "Indique si l'expression régulière respecte la casse.\nValeur par défaut : false (insensible à la casse)"

msgctxt "settings schema"
msgid "Whether the remote host should make its outgoing HTTP(S) requests —\nlanguage server and node downloads, extension archives, agent binaries\n— through this machine instead of its own network.\n\nThis is what makes a remote host that has no internet access able to\ninstall language servers at all, and it puts those downloads under this\nmachine's network allowlist, consent prompts and proxy. Turn it off to\nhave the remote host connect out on its own.\n\nDefault: true"
msgstr "Indique si l'hôte distant doit effectuer ses requêtes HTTP(S) sortantes (téléchargements de serveurs de langage et de node, archives d'extensions, binaires d'agents) via cette machine plutôt que via son propre réseau.\n\nC'est ce qui permet à un hôte distant sans accès à Internet d'installer des serveurs de langage, et cela soumet ces téléchargements à la liste d'autorisation réseau, aux demandes de consentement et au proxy de cette machine. Désactivez cette option pour que l'hôte distant se connecte lui-même à l'extérieur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the terminal panel should open on startup.\n\nDefault: true"
msgstr "Indique si le panneau du terminal doit s'ouvrir au démarrage.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the terminal panel should use flexible (proportional) sizing.\n\nDefault: true"
msgstr "Indique si le panneau du terminal doit utiliser un dimensionnement flexible (proportionnel).\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the text selection should have rounded corners.\n\nDefault: true"
msgstr "Indique si la sélection de texte doit avoir des coins arrondis.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether the window-wide threads sidebar is available at all.\n\nDefault: false"
msgstr "Indique si la barre latérale des conversations à l'échelle de la fenêtre est disponible.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether this agent always launches outside the sandbox, without asking.\n\nOutside, writes are not restricted, and network restrictions only apply\nto programs that read the proxy settings. Can only be set in the user\nsettings, not in a project's settings (`.zed/settings.json`).\n\nDefault: false"
msgstr "Indique si cet agent est toujours lancé hors du bac à sable, sans demander.\n\nHors du bac à sable, les écritures ne sont pas restreintes, et les restrictions réseau ne s'appliquent qu'aux programmes qui lisent les paramètres de proxy. Ne peut être défini que dans les paramètres utilisateur, pas dans les paramètres d'un projet (`.zed/settings.json`).\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether this agent may offer signing in with a subscription (an\nauthentication method such as `/login`).\n\nWhen `false`, the agent's sign-in disappears from the authentication card\nand is refused when it is requested another way. Using an API key works\nregardless of this setting.\n\nDefault: true"
msgstr "Indique si cet agent peut proposer la connexion avec un abonnement (une méthode d'authentification comme `/login`).\n\nAvec `false`, la connexion de l'agent disparaît de la carte d'authentification et est refusée lorsqu'elle est demandée autrement. L'utilisation d'une clé API fonctionne quelle que soit la valeur de ce paramètre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether this custom Mantle model supports OpenAI reasoning effort parameters."
msgstr "Indique si ce modèle Mantle personnalisé prend en charge les paramètres de niveau de réflexion d'OpenAI."

msgctxt "settings schema"
msgid "Whether to align detail text in code completions context menus left or right.\n\nDefault: left"
msgstr "Indique s'il faut aligner à gauche ou à droite le texte de détail dans les menus contextuels de complétion de code.\n\nValeur par défaut : left"

msgctxt "settings schema"
msgid "Whether to allow drag and drop text selection in buffer."
msgstr "Indique si la sélection de texte par glisser-déposer doit être autorisée dans le tampon."

msgctxt "settings schema"
msgid "Whether to allow horizontal scrolling in the project panel.\nWhen false, the view is locked to the leftmost position and\nlong file names are clipped.\n\nDefault: true"
msgstr "Indique s'il faut autoriser le défilement horizontal dans le panneau de projet. Avec false, la vue est verrouillée sur la position la plus à gauche et les noms de fichiers longs sont tronqués.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to allow windows to tab together based on the user's tabbing preference (macOS only).\n\nDefault: false"
msgstr "Indique s'il faut autoriser les fenêtres à se regrouper en onglets selon la préférence d'onglets de l'utilisateur (macOS uniquement).\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to always show the close button on tabs.\n\nDefault: false"
msgstr "Indique s'il faut toujours afficher le bouton de fermeture sur les onglets.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to always use cmd-enter (or ctrl-enter on Linux or Windows) to send messages in the agent panel.\n\nDefault: false"
msgstr "Indique s'il faut toujours utiliser cmd-enter (ou ctrl-enter sous Linux ou Windows) pour envoyer des messages dans le panneau de l'agent.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to attempt to restore previous file's state when opening it again.\nThe state is stored per pane.\nWhen disabled, defaults are applied instead of the state restoration.\n\nE.g. for editors, selections, folds and scroll positions are restored, if the same file is closed and, later, opened again in the same pane.\nWhen disabled, a single selection in the very beginning of the file, zero scroll position and no folds state is used as a default.\n\nDefault: true"
msgstr "Indique s'il faut tenter de restaurer l'état précédent d'un fichier lors de sa réouverture. L'état est stocké par volet. Si cette option est désactivée, les valeurs par défaut sont appliquées au lieu de la restauration de l'état.\n\nP. ex. pour les éditeurs, les sélections, les replis et les positions de défilement sont restaurés si le même fichier est fermé puis rouvert plus tard dans le même volet. Si cette option est désactivée, une seule sélection tout au début du fichier, une position de défilement nulle et aucun repli sont utilisés par défaut.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to automatically attach the active editor to every message that\nis sent: the selected lines when there is a selection, otherwise the\nwhole file. A file that is already mentioned by hand is not attached\ntwice.\n\nDefault: false"
msgstr "Indique s'il faut joindre automatiquement l'éditeur actif à chaque message envoyé : les lignes sélectionnées s'il y a une sélection, sinon le fichier entier. Un fichier déjà mentionné manuellement n'est pas joint deux fois.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to automatically close JSX tags."
msgstr "Indique si les balises JSX doivent être fermées automatiquement."

msgctxt "settings schema"
msgid "Whether to automatically close files that have been deleted on disk.\n\nDefault: false"
msgstr "Indique s'il faut fermer automatiquement les fichiers supprimés sur le disque.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to automatically compact the agent's context when it grows too\nlarge, summarizing earlier messages to free up room in the model's\ncontext window.\n\nDefault: true"
msgstr "Indique s'il faut compacter automatiquement le contexte de l'agent lorsqu'il devient trop grand, en résumant les messages antérieurs pour libérer de la place dans la fenêtre de contexte du modèle.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to automatically detect the language of an untitled buffer from its contents.\nLanguages explicitly selected from the language selector are not changed.\n\nDefault: true"
msgstr "Indique s'il faut détecter automatiquement le langage d'un tampon sans titre à partir de son contenu. Les langages explicitement choisis dans le sélecteur de langage ne sont pas modifiés.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to automatically discover models served by the llama.cpp server.\nDefaults to true."
msgstr "Indique s'il faut découvrir automatiquement les modèles servis par le serveur llama.cpp. Valeur par défaut : true."

msgctxt "settings schema"
msgid "Whether to automatically open Markdown files in the preview.\n\nDefault: false"
msgstr "Indique s'il faut ouvrir automatiquement les fichiers Markdown dans l'aperçu.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to automatically open files after pasting or duplicating them.\n\nDefault: true"
msgstr "Indique s'il faut ouvrir automatiquement les fichiers après les avoir collés ou dupliqués.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to automatically open files dropped from external sources.\n\nDefault: true"
msgstr "Indique s'il faut ouvrir automatiquement les fichiers déposés depuis des sources externes.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to automatically open newly created files in the editor.\n\nDefault: true"
msgstr "Indique s'il faut ouvrir automatiquement dans l'éditeur les fichiers nouvellement créés.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to automatically open the menus in the title bar on hover.\n\nDefault: false"
msgstr "Indique s'il faut ouvrir automatiquement les menus de la barre de titre au survol.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to automatically show a signature help pop-up or not.\n\nDefault: false"
msgstr "Indique s'il faut afficher automatiquement une fenêtre d'aide à la signature.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to automatically surround text with characters for you. For example,\nwhen you select text and type '(', Zed will automatically surround text with ().\n\nDefault: true"
msgstr "Indique s'il faut entourer automatiquement le texte de caractères. Par exemple, lorsque vous sélectionnez du texte et tapez '(', ForgeKairos entoure automatiquement le texte de ().\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to automatically type closing characters for you. For example,\nwhen you type '(', Zed will automatically add a closing ')' at the correct position.\n\nDefault: true"
msgstr "Indique s'il faut taper automatiquement les caractères fermants. Par exemple, lorsque vous tapez '(', ForgeKairos ajoute automatiquement un ')' fermant à la bonne position.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to build dev container images with BuildKit.\n\nWhen unset, Zed auto-detects BuildKit by probing for the `buildx` CLI\nplugin. Set to `false` to force the classic Docker builder, which is\nrequired for Docker-compatible engines that lack an integrated BuildKit\n(e.g. Apple Container via a Docker-API bridge), where BuildKit builds\ncannot resolve locally-built images.\n\nDefault: null (auto-detect)"
msgstr "Indique s'il faut construire les images de conteneurs de développement avec BuildKit.\n\nSi ce paramètre n'est pas défini, ForgeKairos détecte automatiquement BuildKit en recherchant le plug-in CLI `buildx`. Définissez `false` pour forcer le constructeur Docker classique, nécessaire pour les moteurs compatibles Docker dépourvus de BuildKit intégré (p. ex. Apple Container via une passerelle d'API Docker), où les constructions BuildKit ne peuvent pas résoudre les images construites localement.\n\nValeur par défaut : null (détection automatique)"

msgctxt "settings schema"
msgid "Whether to center the cursor on each search match when navigating."
msgstr "Indique si le curseur doit être centré sur chaque correspondance de recherche lors de la navigation."

msgctxt "settings schema"
msgid "Whether to close the window when using 'close active item' on a workspace with no tabs\n\nDefault: auto (\"on\" on macOS, \"off\" otherwise)"
msgstr "Indique s'il faut fermer la fenêtre lors de l'utilisation de 'close active item' sur un espace de travail sans onglets\n\nValeur par défaut : auto (\"on\" sous macOS, \"off\" ailleurs)"

msgctxt "settings schema"
msgid "Whether to collapse untracked files in the diff panel.\n\nDefault: false"
msgstr "Indique s'il faut réduire les fichiers non suivis dans le panneau des différences.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to collect timing data for foreground and background executor\ntasks. Enabling this may lead to increased memory usage, hence it's\ndisabled by default for regular builds.\n\nDefault: false"
msgstr "Indique s'il faut collecter des données de durée pour les tâches des exécuteurs de premier plan et d'arrière-plan. L'activer peut augmenter l'utilisation de la mémoire ; c'est pourquoi c'est désactivé par défaut pour les versions ordinaires.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to continue markdown lists when pressing enter.\n\nDefault: true"
msgstr "Indique s'il faut poursuivre les listes Markdown lors de l'appui sur Enter.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to disable all AI features in Zed.\n\nDefault: false"
msgstr "Indique s'il faut désactiver toutes les fonctionnalités d'IA de ForgeKairos.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to display Agent review buttons in the editor toolbar.\nOnly applicable while reviewing a file edited by the Agent.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons de révision de l'agent dans la barre d'outils de l'éditeur. Ne s'applique que lors de la révision d'un fichier modifié par l'agent.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to display agent edits in single-file editors in addition to the review multibuffer pane.\n\nDefault: false"
msgstr "Indique s'il faut afficher les modifications de l'agent dans les éditeurs de fichier unique en plus du volet multi-tampon de révision.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to display breadcrumbs in the editor toolbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le fil d'Ariane dans la barre d'outils de l'éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to display code action buttons in the editor toolbar.\n\nDefault: false"
msgstr "Indique s'il faut afficher les boutons d'actions de code dans la barre d'outils de l'éditeur.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to display code lenses from language servers above code elements."
msgstr "Indique si les CodeLens provenant des serveurs de langage doivent être affichés au-dessus des éléments de code."

msgctxt "settings schema"
msgid "Whether to display indent guides in the editor.\n\nDefault: true"
msgstr "Indique s'il faut afficher les guides d'indentation dans l'éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to display inline and alongside documentation for items in the\ncompletions menu.\n\nDefault: true"
msgstr "Indique s'il faut afficher la documentation en ligne et à côté des éléments du menu de complétion.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to display quick action buttons in the editor toolbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons d'actions rapides dans la barre d'outils de l'éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to display the Markdown formatting row below the editor toolbar\nwhile a Markdown file is open.\n\nDefault: true"
msgstr "Indique s'il faut afficher la rangée de mise en forme Markdown sous la barre d'outils de l'éditeur lorsqu'un fichier Markdown est ouvert.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to display the active language button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du langage actif dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to display the terminal title in breadcrumbs inside the terminal pane.\nOnly shown if the terminal title is not empty.\n\nThe shell running in the terminal needs to be configured to emit the title.\nExample: `echo -e \"\\e]2;New Title\\007\";`\n\nDefault: true"
msgstr "Indique s'il faut afficher le titre du terminal dans le fil d'Ariane du volet du terminal. Affiché uniquement si le titre du terminal n'est pas vide.\n\nLe shell exécuté dans le terminal doit être configuré pour émettre le titre.\nExemple : `echo -e \"\\e]2;New Title\\007\";`\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to enable drag-and-drop operations in the project panel.\n\nDefault: true"
msgstr "Indique s'il faut activer le glisser-déposer dans le panneau de projet.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to enable middle-click paste on Linux\n\nDefault: true"
msgstr "Indique s'il faut activer le collage par clic du milieu sous Linux\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to enable think mode"
msgstr "Indique si le mode réflexion doit être activé"

msgctxt "settings schema"
msgid "Whether to enable word diff highlighting in the editor.\n\nWhen enabled, changed words within modified lines are highlighted\nto show exactly what changed.\n\nDefault: true"
msgstr "Indique s'il faut activer la surbrillance des différences par mot dans l'éditeur.\n\nSi cette option est activée, les mots changés dans les lignes modifiées sont mis en surbrillance pour montrer exactement ce qui a changé.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to expose this window over the loopback IDE server, so that\nexternal agents such as the Claude Code CLI can read the open editors,\nthe selection and the diagnostics, and show diffs inside Zed.\n\nDefault: false"
msgstr "Indique s'il faut exposer cette fenêtre via le serveur IDE sur l'adresse de bouclage, afin que des agents externes comme la CLI Claude Code puissent lire les éditeurs ouverts, la sélection et les diagnostics, et afficher des différences dans ForgeKairos.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to fetch LSP completions or not.\n\nDefault: true"
msgstr "Indique s'il faut récupérer les complétions LSP.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to filter ANSI/VT escape sequences so the log reads as plain\ntext, the way TeraTerm's text log does.\n\nDefault: true"
msgstr "Indique s'il faut filtrer les séquences d'échappement ANSI/VT pour que le journal se lise comme du texte brut, à la manière du journal texte de TeraTerm.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to fold directories automatically\nwhen directory has only one directory inside.\n\nDefault: true"
msgstr "Indique s'il faut replier automatiquement les répertoires lorsqu'un répertoire ne contient qu'un seul répertoire.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to follow-up empty go to definition responses from the language server or not.\n`FindAllReferences` allows to look up references of the same symbol instead.\n`None` disables the fallback.\n\nDefault: FindAllReferences"
msgstr "Indique s'il faut donner suite aux réponses vides du serveur de langage pour atteindre la définition. `FindAllReferences` permet de rechercher plutôt les références du même symbole. `None` désactive ce repli.\n\nValeur par défaut : FindAllReferences"

msgctxt "settings schema"
msgid "Whether to format dap messages in when adding them to debug adapter logger\n\nDefault: true"
msgstr "Indique s'il faut mettre en forme les messages DAP lors de leur ajout au journal de l'adaptateur de débogage\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to give agents Zed's IDE tools (the `zed` MCP server: highlights,\nannotations, code tours, hover, definitions, references and symbol\nsearch), in the Claude Code CLI tabs and in external agents' sessions\nalike. Independent of `enabled`: the server starts for them on demand\nand writes no lock file unless `enabled` is on.\n\nDefault: true"
msgstr "Indique s'il faut fournir aux agents les outils IDE de ForgeKairos (le serveur MCP `zed` : surbrillances, annotations, visites guidées du code, survol, définitions, références et recherche de symboles), aussi bien dans les onglets de la CLI Claude Code que dans les sessions des agents externes. Indépendant de `enabled` : le serveur démarre pour eux à la demande et n'écrit aucun fichier de verrouillage sauf si `enabled` est activé.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to have edit cards in the agent panel expanded, showing a preview of the full diff.\n\nDefault: true"
msgstr "Indique s'il faut développer les cartes de modification dans le panneau de l'agent, avec un aperçu des différences complètes.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to have terminal cards in the agent panel expanded, showing the whole command output.\n\nDefault: true"
msgstr "Indique s'il faut développer les cartes de terminal dans le panneau de l'agent, avec toute la sortie de la commande.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to hide gitignore files in the project panel.\n\nDefault: false"
msgstr "Indique s'il faut masquer les fichiers ignorés par gitignore dans le panneau de projet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to hide symbols, excerpts and search matches in the outline panel\nwhen a multi-buffer view (e.g. a diff or search results) is active,\nshowing only files and directories.\nDoes not affect single-file views.\n\nDefault: false"
msgstr "Indique s'il faut masquer les symboles, les extraits et les correspondances de recherche dans le panneau de structure lorsqu'une vue multi-tampon (p. ex. des différences ou des résultats de recherche) est active, pour n'afficher que les fichiers et les répertoires. N'affecte pas les vues de fichier unique.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to hide the hidden entries in the project panel.\n\nDefault: false"
msgstr "Indique s'il faut masquer les entrées cachées dans le panneau de projet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to hide the root entry when only one folder is open in the window.\n\nDefault: false"
msgstr "Indique s'il faut masquer l'entrée racine lorsqu'un seul dossier est ouvert dans la fenêtre.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to highlight all occurrences of the selected text in an editor.\n\nDefault: true"
msgstr "Indique s'il faut mettre en surbrillance toutes les occurrences du texte sélectionné dans un éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to include gitignored files in search results."
msgstr "Indique si les fichiers ignorés par Git doivent être inclus dans les résultats de recherche."

msgctxt "settings schema"
msgid "Whether to include project rules files (AGENTS.md, CLAUDE.md, .rules, etc.)\nin the prompt when generating git commit messages.\n\nDefault: true"
msgstr "Indique s'il faut inclure les fichiers de règles du projet (AGENTS.md, CLAUDE.md, .rules, etc.) dans le prompt lors de la génération des messages de validation Git.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to include text channels in file finder results.\n\nDefault: false"
msgstr "Indique s'il faut inclure les canaux textuels dans les résultats de la recherche de fichiers.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to indent lines using tab characters, as opposed to multiple\nspaces.\n\nDefault: false"
msgstr "Indique s'il faut indenter les lignes avec des caractères de tabulation plutôt qu'avec plusieurs espaces.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to indent list items when pressing tab after a list marker.\n\nDefault: true"
msgstr "Indique s'il faut indenter les éléments de liste lors de l'appui sur Tab après un marqueur de liste.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to index files that `.gitignore` excludes (only the ones the\nproject panel has loaded: ignored folders are read when expanded).\n\nDefault: false"
msgstr "Indique s'il faut indexer les fichiers exclus par `.gitignore` (uniquement ceux que le panneau de projet a chargés : les dossiers ignorés sont lus lorsqu'ils sont développés).\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to interpret the search query as a regular expression."
msgstr "Indique si la requête de recherche doit être interprétée comme une expression régulière."

msgctxt "settings schema"
msgid "Whether to keep tabs in preview mode when code navigation is used to navigate away from them.\nIf `enable_preview_file_from_code_navigation` or `enable_preview_multibuffer_from_code_navigation` is also true, the new tab may replace the existing one.\n\nDefault: false"
msgstr "Indique s'il faut conserver les onglets en mode aperçu lorsque la navigation dans le code est utilisée pour les quitter. Si `enable_preview_file_from_code_navigation` ou `enable_preview_multibuffer_from_code_navigation` vaut aussi true, le nouvel onglet peut remplacer l'onglet existant.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to keep the system awake while agent threads are running.\n\nDefault: true"
msgstr "Indique s'il faut empêcher la mise en veille du système pendant l'exécution des conversations de l'agent.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to keep the text selection after copying it to the clipboard.\n\nDefault: true"
msgstr "Indique s'il faut conserver la sélection de texte après l'avoir copiée dans le presse-papiers.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to limit the content width in the agent panel. When enabled,\ncontent will be constrained to `max_content_width` and centered when\nthe panel is wider than that value, for optimal readability.\n\nDefault: false"
msgstr "Indique s'il faut limiter la largeur du contenu dans le panneau de l'agent. Si cette option est activée, le contenu est limité à `max_content_width` et centré lorsque le panneau est plus large que cette valeur, pour une lisibilité optimale.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to limit the width of the rendered markdown content. When\nenabled, content is constrained to `max_width` and centered\nhorizontally within the preview pane, for optimal readability.\n\nDefault: false"
msgstr "Indique s'il faut limiter la largeur du contenu Markdown rendu. Si cette option est activée, le contenu est limité à `max_width` et centré horizontalement dans le volet d'aperçu, pour une lisibilité optimale.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to log messages between active debug adapters and Zed\n\nDefault: true"
msgstr "Indique s'il faut journaliser les messages échangés entre les adaptateurs de débogage actifs et ForgeKairos\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to match case sensitively."
msgstr "Indique si la correspondance doit être sensible à la casse."

msgctxt "settings schema"
msgid "Whether to only match on whole words."
msgstr "Indique si la correspondance doit se faire sur des mots entiers uniquement."

msgctxt "settings schema"
msgid "Whether to only show the inline blame information\nafter a delay once the cursor stops moving.\n\nDefault: 0"
msgstr "Indique s'il faut n'afficher les informations de blame en ligne qu'après un délai, une fois que le curseur s'arrête.\n\nValeur par défaut : 0"

msgctxt "settings schema"
msgid "Whether to only show the inline diagnostics after a delay after the\nlast editor event.\n\nDefault: 150"
msgstr "Indique s'il faut n'afficher les diagnostics en ligne qu'après un délai suivant le dernier événement de l'éditeur.\n\nValeur par défaut : 150"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a multibuffer.\n\nDefault: false"
msgstr "Indique s'il faut ouvrir les onglets en mode aperçu lorsque la navigation dans le code est utilisée pour ouvrir un multi-tampon.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a single file.\n\nDefault: true"
msgstr "Indique s'il faut ouvrir les onglets en mode aperçu lorsque la navigation dans le code ouvre un seul fichier.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from a multibuffer.\n\nDefault: true"
msgstr "Indique s'il faut ouvrir les onglets en mode aperçu lorsqu'ils sont ouverts depuis un multi-tampon.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from the project panel\nwith a single click or the `project_panel::Open` action.\n\nDefault: true"
msgstr "Indique s'il faut ouvrir les onglets en mode aperçu lorsqu'ils sont ouverts depuis le panneau de projet par un simple clic ou par l'action `project_panel::Open`.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when selected from the file finder.\n\nDefault: false"
msgstr "Indique s'il faut ouvrir les onglets en mode aperçu lorsqu'ils sont sélectionnés depuis la recherche de fichiers.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to open tabular files such as CSV and TSV as a table (grid). When\noff, they open in the text editor.\n\nDefault: true"
msgstr "Indique s'il faut ouvrir les fichiers tabulaires, comme CSV et TSV, sous forme de tableau (grille). Si cette option est désactivée, ils s'ouvrent dans l'éditeur de texte.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to optimize Zed's interface for assistive technology such as\nscreen readers.\n\nDefault: false"
msgstr "Indique s'il faut optimiser l'interface de ForgeKairos pour les technologies d'assistance, comme les lecteurs d'écran.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to perform linked edits of associated ranges, if the language server supports it.\nFor example, when editing opening <html> tag, the contents of the closing </html> tag will be edited as well.\n\nDefault: true"
msgstr "Indique s'il faut effectuer des modifications liées sur les plages associées, si le serveur de langage le prend en charge.\nPar exemple, lorsque vous modifiez la balise ouvrante <html>, le contenu de la balise fermante </html> est également modifié.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to point out missing development tools in a notification and offer\nto install them from it. While connected to a remote host, the host is\nchecked and the tools are installed there.\n\nDefault: true"
msgstr "Indique s'il faut signaler les outils de développement manquants dans une notification et proposer de les installer depuis celle-ci. Lorsque vous êtes connecté à un hôte distant, c'est cet hôte qui est vérifié et les outils y sont installés.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to pop the completions menu while typing in an editor without\nexplicitly requesting it.\n\nDefault: true"
msgstr "Indique s'il faut afficher le menu des complétions pendant la saisie dans un éditeur, sans demande explicite.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to prefix each logged line with `[YYYY-MM-DD HH:MM:SS] `.\n\nDefault: false"
msgstr "Indique s'il faut préfixer chaque ligne journalisée par `[YYYY-MM-DD HH:MM:SS] `.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to prevent this project from being shared in public channels.\n\nDefault: false"
msgstr "Indique s'il faut empêcher le partage de ce projet dans les canaux publics.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to pull for diagnostics or not.\n\nDefault: true"
msgstr "Indique s'il faut récupérer les diagnostics par requête (pull).\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to query and display LSP `textDocument/documentLink` links in the editor.\n\nDefault: true"
msgstr "Indique s'il faut demander et afficher dans l'éditeur les liens LSP `textDocument/documentLink`.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to reduce non-essential motion in the UI, such as loading\nspinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Indique s'il faut réduire les animations non essentielles de l'interface, comme les indicateurs de chargement et les libellés clignotants, en les affichant de manière statique.\n\nValeur par défaut : off"

msgctxt "settings schema"
msgid "Whether to resize all the panels in a dock when resizing the dock.\n\nDefault: [\"left\"]"
msgstr "Indique s'il faut redimensionner tous les panneaux d'un dock lors du redimensionnement du dock.\n\nValeur par défaut : [\"left\"]"

msgctxt "settings schema"
msgid "Whether to reveal an already open file in an existing pane instead of opening it in the active pane.\n\nDefault: false"
msgstr "Indique s'il faut afficher un fichier déjà ouvert dans le volet existant au lieu de l'ouvrir dans le volet actif.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to reveal it in the outline panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Indique s'il faut l'afficher automatiquement dans le panneau de structure lorsque l'entrée de projet correspondante devient active.\nLes entrées ignorées par Git ne sont jamais affichées automatiquement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to reveal it in the project panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Indique s'il faut l'afficher automatiquement dans le panneau de projet lorsque l'entrée de projet correspondante devient active.\nLes entrées ignorées par Git ne sont jamais affichées automatiquement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to run agent terminal commands outside the OS sandbox, with\nZed's own permissions (the inverse of the settings UI's \"enable sandbox\"\nswitch). When true, the sandboxed terminal tool is not exposed and the\nsystem prompt omits the sandbox section, so the model uses the plain\n`terminal` tool; on Windows, WSL sandbox setup is skipped. Such commands\nare never auto-approved: each one asks first. Only the user sets this;\nthe agent has no way to ask for a command to run outside the sandbox.\nDefault: false"
msgstr "Indique s'il faut exécuter les commandes de terminal de l'agent hors du bac à sable du système d'exploitation, avec les propres autorisations de ForgeKairos (l'inverse de l'interrupteur \"activer le bac à sable\" de l'interface des paramètres). Si la valeur est true, l'outil de terminal en bac à sable n'est pas proposé et le prompt système omet la section sur le bac à sable : le modèle utilise donc l'outil `terminal` ordinaire ; sous Windows, la préparation du bac à sable WSL est ignorée. Ces commandes ne sont jamais approuvées automatiquement : chacune demande d'abord une confirmation. Seul l'utilisateur peut définir ce paramètre ; l'agent n'a aucun moyen de demander l'exécution d'une commande hors du bac à sable.\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to run the context server on the remote server when using remote development.\n\nIf this is false, the context server will always run on the local machine.\n\nDefault: false"
msgstr "Indique s'il faut exécuter le serveur de contexte sur le serveur distant lors du développement à distance.\n\nSi la valeur est false, le serveur de contexte s'exécute toujours sur la machine locale.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to scroll when clicking near the edge of the visible text area.\n\nDefault: false"
msgstr "Indique s'il faut faire défiler la vue lors d'un clic près du bord de la zone de texte visible.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to send explicit `cache_control` breakpoints for prompt caching.\nLeave disabled if the provider rejects requests containing them."
msgstr "Indique s'il faut envoyer des points d'arrêt `cache_control` explicites pour la mise en cache des prompts.\nLaissez cette option désactivée si le fournisseur rejette les requêtes qui en contiennent."

msgctxt "settings schema"
msgid "Whether to show OpenCode Go models. Defaults to true."
msgstr "Indique s'il faut afficher les modèles OpenCode Go. Valeur par défaut : true."

msgctxt "settings schema"
msgid "Whether to show OpenCode Zen models. Defaults to true."
msgstr "Indique s'il faut afficher les modèles OpenCode Zen. Valeur par défaut : true."

msgctxt "settings schema"
msgid "Whether to show a background for inlay hints.\n\nIf set to `true`, the background will use the `hint.background` color\nfrom the current theme.\n\nDefault: false"
msgstr "Indique s'il faut afficher un arrière-plan pour les indications intégrées.\n\nSi la valeur est `true`, l'arrière-plan utilise la couleur `hint.background` du thème actuel.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show a badge on the git panel icon with the count of uncommitted changes.\n\nDefault: false"
msgstr "Indique s'il faut afficher sur l'icône du panneau Git un badge indiquant le nombre de modifications non validées.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show a badge on the terminal panel icon with the count of open terminals.\n\nDefault: false"
msgstr "Indique s'il faut afficher sur l'icône du panneau de terminal un badge indiquant le nombre de terminaux ouverts.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show a git status indicator next to file names in the project panel.\n\nDefault: false"
msgstr "Indique s'il faut afficher un indicateur d'état Git à côté des noms de fichiers dans le panneau de projet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show a single line break as a line break. When off, it is one\nspace as CommonMark specifies, and only two trailing spaces, `\\` or `<br>`\nbreak the line. Exporting to PDF follows the same setting.\n\nDefault: true"
msgstr "Indique s'il faut afficher un saut de ligne simple comme un saut de ligne. Si cette option est désactivée, il équivaut à une espace, comme le prévoit CommonMark, et seuls deux espaces en fin de ligne, `\\` ou `<br>` provoquent un saut de ligne. L'exportation au format PDF suit le même paramètre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show active line endings button in the status bar.\n\nDefault: false"
msgstr "Indique s'il faut afficher le bouton de fin de ligne active dans la barre d'état.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show an indicator while multi-stroke input is pending.\nIf the input has a timeout, a countdown is shown and hovering the indicator pauses it.\nIts binding preview popover is disabled when the which-key popup is enabled.\n\nDefault: true"
msgstr "Indique s'il faut afficher un indicateur pendant qu'une saisie à plusieurs frappes est en attente.\nSi la saisie a un délai d'expiration, un compte à rebours s'affiche et le survol de l'indicateur le met en pause.\nSa fenêtre contextuelle d'aperçu des combinaisons de touches est désactivée lorsque la fenêtre which-key est activée.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show author name as part of the commit information.\n\nDefault: false"
msgstr "Indique s'il faut afficher le nom de l'auteur dans les informations de validation.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show bookmarks in the gutter.\n\nDefault: true"
msgstr "Indique s'il faut afficher les signets dans la gouttière.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show breakpoints in the gutter.\n\nDefault: true"
msgstr "Indique s'il faut afficher les points d'arrêt dans la gouttière.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show buffer search result indicators in the scrollbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les indicateurs de résultats de recherche du tampon dans la barre de défilement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show cells that contain line breaks in full, making the row\ntaller. When off, they are cut to one line.\n\nDefault: true"
msgstr "Indique s'il faut afficher en entier les cellules qui contiennent des sauts de ligne, en agrandissant la hauteur de la ligne. Si cette option est désactivée, elles sont tronquées à une ligne.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show code action button at start of buffer line.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton d'action de code au début de la ligne du tampon.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show commit summary as part of the inline blame.\n\nDefault: false"
msgstr "Indique s'il faut afficher le résumé de la validation dans le blame en ligne.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show cursor positions in the scrollbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les positions du curseur dans la barre de défilement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show entries with tree or flat view in the panel\n\nDefault: false"
msgstr "Indique s'il faut afficher les entrées du panneau en arborescence ou en liste plate\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show error and warning count badges next to file names in the project panel.\n\nDefault: false"
msgstr "Indique s'il faut afficher des badges indiquant le nombre d'erreurs et d'avertissements à côté des noms de fichiers dans le panneau de projet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show file icons in the file finder.\n\nDefault: true"
msgstr "Indique s'il faut afficher les icônes de fichiers dans la recherche de fichiers.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show file icons in the git panel.\n\nDefault: false"
msgstr "Indique s'il faut afficher les icônes de fichiers dans le panneau Git.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show file icons in the outline panel.\n\nDefault: true"
msgstr "Indique s'il faut afficher les icônes de fichiers dans le panneau de structure.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show file icons in the project panel.\n\nDefault: true"
msgstr "Indique s'il faut afficher les icônes de fichiers dans le panneau de projet.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show fold buttons in the gutter.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons de repliement dans la gouttière.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show folder names with bold text in the project panel.\n\nDefault: false"
msgstr "Indique s'il faut afficher les noms de dossiers en gras dans le panneau de projet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show git diff indicators in the scrollbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les indicateurs de différences Git dans la barre de défilement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show git status indicators on the branch icon in the title bar.\nWhen enabled, the branch icon changes to reflect the current repository\nstatus (e.g. modified, added, deleted, or conflict).\n\nDefault: false"
msgstr "Indique s'il faut afficher les indicateurs d'état Git sur l'icône de branche de la barre de titre.\nSi cette option est activée, l'icône de branche change pour refléter l'état actuel du dépôt (p. ex. modifié, ajouté, supprimé ou en conflit).\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show line numbers in the gutter.\n\nDefault: true"
msgstr "Indique s'il faut afficher les numéros de ligne dans la gouttière.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show onboarding banners in the title bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les bannières de prise en main dans la barre de titre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show opened editors as preview tabs.\nPreview tabs do not stay open, are reused until explicitly set to be kept open opened (via double-click or editing) and show file names in italic.\n\nDefault: true"
msgstr "Indique s'il faut afficher les éditeurs ouverts sous forme d'onglets d'aperçu.\nLes onglets d'aperçu ne restent pas ouverts : ils sont réutilisés jusqu'à ce qu'ils soient explicitement conservés (par un double-clic ou une modification) et affichent les noms de fichiers en italique.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show padding for zoomed panels.\nWhen enabled, zoomed bottom panels will have some top padding,\nwhile zoomed left/right panels will have padding to the right/left (respectively).\n\nDefault: true"
msgstr "Indique s'il faut afficher une marge intérieure pour les panneaux agrandis.\nSi cette option est activée, les panneaux inférieurs agrandis ont une marge intérieure en haut, et les panneaux gauche/droit agrandis ont une marge intérieure à droite/à gauche (respectivement).\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show runnable buttons in the gutter.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons d'exécution dans la gouttière.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show selected symbol occurrences in the scrollbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les occurrences du symbole sélectionné dans la barre de défilement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show selected text occurrences in the scrollbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher les occurrences du texte sélectionné dans la barre de défilement.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show small single-line outputs inline instead of in a block.\n\nDefault: true"
msgstr "Indique s'il faut afficher les petites sorties d'une seule ligne en ligne plutôt que dans un bloc.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show tabs and spaces in the editor."
msgstr "Indique s'il faut afficher les tabulations et les espaces dans l'éditeur."

msgctxt "settings schema"
msgid "Whether to show the AI browser panel button in the status bar while AI\ncontrol of the built-in browser is on.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du panneau Navigateur IA dans la barre d'état lorsque le contrôle du navigateur intégré par l'IA est activé.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the Git file status on a tab item.\n\nDefault: false"
msgstr "Indique s'il faut afficher l'état Git du fichier sur un onglet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show the LSP servers button in the status bar.\n\nDefault: `true`"
msgstr "Indique s'il faut afficher le bouton des serveurs LSP dans la barre d'état.\n\nValeur par défaut : `true`"

msgctxt "settings schema"
msgid "Whether to show the active encoding button in the status bar.\n\nDefault: non_utf8"
msgstr "Indique s'il faut afficher le bouton de l'encodage actif dans la barre d'état.\n\nValeur par défaut : non_utf8"

msgctxt "settings schema"
msgid "Whether to show the addition/deletion change count next to each file in the Git panel.\n\nDefault: true"
msgstr "Indique s'il faut afficher le nombre d'ajouts/suppressions à côté de chaque fichier dans le panneau Git.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the agent panel button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du panneau de l'agent dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the avatar of the author of the commit.\n\nDefault: true"
msgstr "Indique s'il faut afficher l'avatar de l'auteur de la validation.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the branch name button in the titlebar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du nom de branche dans la barre de titre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the browser panel button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du panneau Navigateur dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the call graph panel button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du panneau du graphe des appels dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the cursor position button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton de position du curseur dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the debug button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton de débogage dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the file icon for a tab.\n\nDefault: false"
msgstr "Indique s'il faut afficher l'icône de fichier sur un onglet.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show the git status in the outline panel.\n\nDefault: true"
msgstr "Indique s'il faut afficher l'état Git dans le panneau de structure.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the git status in the project panel.\n\nDefault: true"
msgstr "Indique s'il faut afficher l'état Git dans le panneau de projet.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the informational hover box when moving the mouse\nover symbols in the editor.\n\nDefault: true"
msgstr "Indique s'il faut afficher la fenêtre de survol informative lorsque la souris passe sur des symboles dans l'éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the menus in the title bar.\n\nDefault: false"
msgstr "Indique s'il faut afficher les menus dans la barre de titre.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show the merge conflict indicator in the status bar\nthat offers to resolve conflicts using the agent.\n\nDefault: true"
msgstr "Indique s'il faut afficher dans la barre d'état l'indicateur de conflit de fusion, qui propose de résoudre les conflits à l'aide de l'agent.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the name of the active file in the status bar.\n\nDefault: false"
msgstr "Indique s'il faut afficher le nom du fichier actif dans la barre d'état.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show the outline panel button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du panneau de structure dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the panel button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du panneau dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the project diagnostics button in the status bar."
msgstr "Indique s'il faut afficher le bouton de diagnostics du projet dans la barre d'état."

msgctxt "settings schema"
msgid "Whether to show the project host and name in the titlebar.\n\nDefault: true"
msgstr "Indique s'il faut afficher l'hôte et le nom du projet dans la barre de titre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the project panel button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du panneau de projet dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the project search button in the status bar."
msgstr "Indique s'il faut afficher le bouton de recherche dans le projet dans la barre d'état."

msgctxt "settings schema"
msgid "Whether to show the selections menu in the editor toolbar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le menu des sélections dans la barre d'outils de l'éditeur.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the sign in button in the title bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton de connexion dans la barre de titre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the signature help pop-up after completions or bracket pairs inserted.\n\nDefault: false"
msgstr "Indique s'il faut afficher la fenêtre d'aide à la signature après l'insertion de complétions ou de paires de crochets.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show the stage and restore buttons on diff hunks.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons d'indexation et de restauration sur les blocs de modifications.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the terminal button in the status bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du terminal dans la barre d'état.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the user menu button in the title bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du menu utilisateur dans la barre de titre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show the which-key popup when holding down key combinations.\nWhen enabled, the pending keystrokes indicator remains visible, but its binding preview\npopover is disabled.\n\nDefault: false"
msgstr "Indique s'il faut afficher la fenêtre which-key lorsque vous maintenez des combinaisons de touches.\nSi cette option est activée, l'indicateur des frappes en attente reste visible, mais sa fenêtre contextuelle d'aperçu des combinaisons de touches est désactivée.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show the worktree name button in the titlebar.\n\nDefault: true"
msgstr "Indique s'il faut afficher le bouton du nom de l'arborescence de travail dans la barre de titre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show thumb buttons for feedback in the agent panel.\n\nDefault: true"
msgstr "Indique s'il faut afficher les boutons pouce levé/baissé pour les commentaires dans le panneau de l'agent.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show turn statistics (elapsed time during generation, final turn duration).\n\nDefault: false"
msgstr "Indique s'il faut afficher les statistiques des tours (temps écoulé pendant la génération, durée finale du tour).\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to show user avatar in the title bar.\n\nDefault: true"
msgstr "Indique s'il faut afficher l'avatar de l'utilisateur dans la barre de titre.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to show wrap guides in the editor. Setting this to true will\nshow a guide at the 'preferred_line_length' value if softwrap is set to\n'preferred_line_length', and will show any additional guides as specified\nby the 'wrap_guides' setting.\n\nDefault: true"
msgstr "Indique s'il faut afficher les guides de retour à la ligne dans l'éditeur. Si la valeur est true, un guide est affiché à la valeur 'preferred_line_length' lorsque softwrap vaut 'preferred_line_length', ainsi que les guides supplémentaires indiqués par le paramètre 'wrap_guides'.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to sort file and folder names case-sensitively in the project panel.\nThis works in combination with `sort_mode`. `sort_mode` controls how files and\ndirectories are grouped, while this setting controls how names are compared.\n\nDefault: default"
msgstr "Indique s'il faut trier les noms de fichiers et de dossiers en respectant la casse dans le panneau de projet.\nCe paramètre fonctionne en combinaison avec `sort_mode` : `sort_mode` contrôle le regroupement des fichiers et des répertoires, tandis que ce paramètre contrôle la comparaison des noms.\n\nValeur par défaut : default"

msgctxt "settings schema"
msgid "Whether to split the thread history into the agent panel itself,\nas a list to the left of the current thread.\n\nDefault: true"
msgstr "Indique s'il faut intégrer l'historique des conversations au panneau de l'agent lui-même, sous forme de liste à gauche de la conversation actuelle.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to start a new line with a comment when a previous line is a comment as well.\n\nDefault: true"
msgstr "Indique s'il faut commencer une nouvelle ligne par un commentaire lorsque la ligne précédente est elle aussi un commentaire.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to stick parent directories at top of the project panel.\n\nDefault: true"
msgstr "Indique s'il faut fixer les répertoires parents en haut du panneau de projet.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to tell a connected Claude Code CLI which file is open when\nnothing is selected (the CLI shows it as \"In <file>\" and attaches the\nfile to the next message). When off, only a selection of one or more\nlines is sent.\n\nDefault: true"
msgstr "Indique s'il faut indiquer à une CLI Claude Code connectée quel fichier est ouvert lorsque rien n'est sélectionné (la CLI l'affiche sous la forme \"In <file>\" et joint le fichier au message suivant). Si cette option est désactivée, seule une sélection d'une ou plusieurs lignes est envoyée.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to use additional LSP queries to format (and amend) the code after\nevery \"trigger\" symbol input, defined by LSP server capabilities.\n\nDefault: true"
msgstr "Indique s'il faut utiliser des requêtes LSP supplémentaires pour mettre en forme (et corriger) le code après chaque saisie d'un symbole \"déclencheur\", défini par les capacités du serveur LSP.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to use command history ranking for sorting in the command palette.\n\nDefault: true"
msgstr "Indique s'il faut utiliser le classement de l'historique des commandes pour le tri dans la palette de commandes.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to use gitignored files when searching.\nOnly the file Zed had indexed will be used, not necessary all the gitignored files.\n\nDefault: Smart"
msgstr "Indique s'il faut utiliser les fichiers ignorés par Git lors de la recherche.\nSeuls les fichiers indexés par ForgeKairos sont utilisés, pas nécessairement tous les fichiers ignorés par Git.\n\nValeur par défaut : Smart"

msgctxt "settings schema"
msgid "Whether to use language servers to provide code intelligence.\n\nDefault: true"
msgstr "Indique s'il faut utiliser des serveurs de langage pour fournir l'intelligence du code.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to use the system provided dialogs for Open and Save As.\nWhen set to false, Zed will use the built-in keyboard-first pickers.\n\nDefault: true"
msgstr "Indique s'il faut utiliser les boîtes de dialogue du système pour Ouvrir et Enregistrer sous.\nSi la valeur est false, ForgeKairos utilise ses sélecteurs intégrés, pensés pour le clavier.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to use the system provided prompts.\nWhen set to false, Zed will use the built-in prompts.\nNote that this setting has no effect on Linux, where Zed will always\nuse the built-in prompts.\n\nDefault: true"
msgstr "Indique s'il faut utiliser les boîtes de dialogue du système.\nSi la valeur est false, ForgeKairos utilise ses boîtes de dialogue intégrées.\nCe paramètre n'a aucun effet sous Linux, où ForgeKairos utilise toujours les boîtes de dialogue intégrées.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to use tree-sitter bracket queries to detect and colorize the brackets in the editor.\n\nDefault: false"
msgstr "Indique s'il faut utiliser les requêtes de crochets tree-sitter pour détecter et colorer les crochets dans l'éditeur.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether to warn (Windows/WSL only) when a sandbox grant targets a file on\na Windows-hosted (DrvFs) filesystem. Such grants are enforced inside WSL\nvia a translated path, and their sandbox-integrity guarantees are weaker\nthan a distro-native filesystem. When enabled, such grants show a warning\nthat must be acknowledged before the command runs.\nDefault: true"
msgstr "Indique s'il faut avertir (Windows/WSL uniquement) lorsqu'une autorisation du bac à sable cible un fichier situé sur un système de fichiers hébergé par Windows (DrvFs). Ces autorisations sont appliquées dans WSL via un chemin traduit, et leurs garanties d'intégrité du bac à sable sont plus faibles que celles d'un système de fichiers natif de la distribution. Si cette option est activée, ces autorisations affichent un avertissement qui doit être accepté avant l'exécution de la commande.\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to warn when a sandbox escalation prompt requests a domain or\nwrite path that contains potentially confusable Unicode characters\n(homoglyphs, invisible characters, or bidirectional overrides). When\nenabled, such prompts show a warning that must be acknowledged before\nthe request can be allowed.\nDefault: true"
msgstr "Indique s'il faut avertir lorsqu'une demande d'élévation du bac à sable porte sur un domaine ou un chemin d'écriture contenant des caractères Unicode potentiellement trompeurs (homoglyphes, caractères invisibles ou remplacements bidirectionnels). Si cette option est activée, ces demandes affichent un avertissement qui doit être accepté avant que la requête puisse être autorisée.\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether to zoom the editor font size with the mouse wheel\nwhile holding the primary modifier key (Cmd on macOS, Ctrl on other platforms).\n\nDefault: false"
msgstr "Indique s'il faut modifier la taille de police de l'éditeur avec la molette de la souris en maintenant la touche de modification principale (Cmd sous macOS, Ctrl sur les autres plateformes).\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether type hints should be shown.\n\nDefault: true"
msgstr "Indique si les indications de type doivent être affichées.\n\nValeur par défaut : true"

msgctxt "settings schema"
msgid "Whether update checks also consider pre-releases. By default only releases are considered.\n\nDefault: false"
msgstr "Indique si la recherche de mises à jour prend aussi en compte les préversions. Par défaut, seules les versions publiées sont prises en compte.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Whether your current project should be shared when joining an empty channel.\n\nDefault: false"
msgstr "Indique si votre projet actuel doit être partagé lorsque vous rejoignez un canal vide.\n\nValeur par défaut : false"

msgctxt "settings schema"
msgid "Which base git features (gutter, file colors, git::Diff) diff against.\n\nDefault: head"
msgstr "La base par rapport à laquelle les fonctionnalités Git (gouttière, couleurs des fichiers, git::Diff) calculent les différences.\n\nValeur par défaut : head"

msgctxt "settings schema"
msgid "Which code actions to run on save before the formatter.\nThese are not run if formatting is off.\n\nDefault: {} (or {\"source.organizeImports\": true} for Go)."
msgstr "Les actions de code à exécuter à l'enregistrement, avant le formateur.\nElles ne sont pas exécutées si la mise en forme est désactivée.\n\nValeur par défaut : {} (ou {\"source.organizeImports\": true} pour Go)."

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar.\n\nDefault: all"
msgstr "Les indicateurs de diagnostic à afficher dans la barre de défilement.\n\nValeur par défaut : all"

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar:\n\nDefault: all"
msgstr "Les indicateurs de diagnostic à afficher dans la barre de défilement :\n\nValeur par défaut : all"

msgctxt "settings schema"
msgid "Which dock gets a pair of panels arranged in it the first time a project\nis opened. The dock itself is not opened for it; each panel's\n`starts_open` decides that. Once a project has a saved dock layout, that\nlayout is restored instead and this setting no longer applies to it.\n\nDefault: right"
msgstr "Le dock dans lequel deux panneaux sont disposés la première fois qu'un projet est ouvert. Le dock lui-même n'est pas ouvert pour autant : c'est le paramètre `starts_open` de chaque panneau qui en décide. Une fois qu'un projet a une disposition de docks enregistrée, c'est cette disposition qui est restaurée et ce paramètre ne s'applique plus.\n\nValeur par défaut : right"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the project panel.\n\nDefault: all"
msgstr "Les fichiers contenant des erreurs/avertissements de diagnostic à signaler dans le panneau de projet.\n\nValeur par défaut : all"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the tabs.\nThis setting can take the following three values:\n\nDefault: off"
msgstr "Les fichiers contenant des erreurs/avertissements de diagnostic à signaler dans les onglets.\nCe paramètre peut prendre les trois valeurs suivantes :\n\nValeur par défaut : off"

msgctxt "settings schema"
msgid "Which fullscreen mode the `zed::ToggleFullScreen` action enters (macOS only).\n\nDefault: native"
msgstr "Le mode plein écran utilisé par l'action `zed::ToggleFullScreen` (macOS uniquement).\n\nValeur par défaut : native"

msgctxt "settings schema"
msgid "Which information to show in the branch picker.\n\nDefault: on"
msgstr "Les informations à afficher dans le sélecteur de branche.\n\nValeur par défaut : on"

msgctxt "settings schema"
msgid "Which level to use to filter out diagnostics displayed in the editor.\n\nAffects the editor rendering only, and does not interrupt\nthe functionality of diagnostics fetching and project diagnostics editor.\nWhich files containing diagnostic errors/warnings to mark in the tabs.\nDiagnostics are only shown when file icons are also active.\n\nShows all diagnostics if not specified.\n\nDefault: warning"
msgstr "Le niveau utilisé pour filtrer les diagnostics affichés dans l'éditeur.\n\nN'affecte que le rendu de l'éditeur et n'interrompt pas la récupération des diagnostics ni l'éditeur des diagnostics du projet.\nLes fichiers contenant des erreurs/avertissements de diagnostic à signaler dans les onglets.\nLes diagnostics ne sont affichés que si les icônes de fichiers sont également activées.\n\nTous les diagnostics sont affichés si aucune valeur n'est indiquée.\n\nValeur par défaut : warning"

msgctxt "settings schema"
msgid "Which sources the panel lists calls from: the language server, which\nis exact, the symbol index of C and C++ files, which matches names, or\nboth.\n\nDefault: all"
msgstr "Les sources à partir desquelles le panneau liste les appels : le serveur de langage, qui est exact, l'index des symboles des fichiers C et C++, qui fait correspondre les noms, ou les deux.\n\nValeur par défaut : all"

msgctxt "settings schema"
msgid "Which untracked files `git status` reports.\n\n`all` lists every file inside an untracked directory, which is what\ncolours individual entries in the project panel. `normal` only lists the\nuntracked directory itself, and `no` skips untracked files entirely;\nboth make `git status` markedly cheaper on very large trees.\n\nDefault: all"
msgstr "Les fichiers non suivis signalés par `git status`.\n\n`all` liste chaque fichier d'un répertoire non suivi, ce qui permet de colorer chaque entrée dans le panneau de projet. `normal` ne liste que le répertoire non suivi lui-même, et `no` ignore entièrement les fichiers non suivis ; ces deux valeurs rendent `git status` nettement moins coûteux sur les très grandes arborescences.\n\nValeur par défaut : all"

msgctxt "settings schema"
msgid "White ANSI terminal color."
msgstr "Couleur de terminal ANSI blanche."

msgctxt "settings schema"
msgid "Width scales automatically with the buffer font size."
msgstr "La largeur s'adapte automatiquement à la taille de la police du tampon."

msgctxt "settings schema"
msgid "Window title template.\n\nAvailable variables are `${projectName}`, `${fileName}`,\n`${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`,\n`${remoteHost}`, `${appName}`, `${branch}`,\nand `${separator}`.\n`${separator}` is omitted when adjacent variables are empty,\nbut literal text is preserved.\nThe collaboration indicator, when present, is appended after the\nrendered template.\nIf the template renders to nothing, the default template is used instead.\n\nDefault: `${projectName}${separator}${fileName}`"
msgstr "Modèle du titre de la fenêtre.\n\nLes variables disponibles sont `${projectName}`, `${fileName}`, `${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`, `${remoteHost}`, `${appName}`, `${branch}` et `${separator}`.\n`${separator}` est omis lorsque les variables adjacentes sont vides, mais le texte littéral est conservé.\nL'indicateur de collaboration, s'il est présent, est ajouté après le modèle rendu.\nSi le rendu du modèle est vide, le modèle par défaut est utilisé à la place.\n\nValeur par défaut : `${projectName}${separator}${fileName}`"

msgctxt "settings schema"
msgid "Yellow ANSI terminal color."
msgstr "Couleur de terminal ANSI jaune."

msgctxt "settings schema"
msgid "Zed draws its own window decorations/titlebar (client-side decoration)."
msgstr "ForgeKairos dessine ses propres décorations de fenêtre et sa barre de titre (décoration côté client)."

msgctxt "settings schema"
msgid "Zed's Prettier integration settings.\nAllows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\n\nDefault: off"
msgstr "Paramètres de l'intégration de Prettier dans ForgeKairos.\nPermet d'activer/désactiver la mise en forme avec Prettier et de configurer le Prettier par défaut, utilisé lorsqu'aucune installation de Prettier n'est trouvée au niveau du projet.\n\nValeur par défaut : off"

msgctxt "settings schema"
msgid "clangd's memory use: its index mode, worker count and a limit at which it\nis restarted."
msgstr "Utilisation de la mémoire par clangd : son mode d'indexation, le nombre de workers et une limite à partir de laquelle il est redémarré."
