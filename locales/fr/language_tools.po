msgstr "En attente de saisie supplémentaire : {}"

msgid "Waiting for the remote server to respond."
msgstr "En attente de la réponse du serveur distant."

msgid "Warning"
msgstr "Avertissement"

msgid "You can't resume until the agent's response ends. If it doesn't end, stop the agent."
msgstr "Vous ne pouvez pas reprendre tant que la réponse de l'agent n'est pas terminée. Si elle ne se termine pas, arrêtez l'agent."

msgid "You can't resume until the running sessions and commands end."
msgstr "Vous ne pouvez pas reprendre tant que les sessions et commandes en cours ne sont pas terminées."

msgid "clangd is using {used} of memory, over its limit of {limit}. It was restarted less than 10 minutes ago, so it is left running."
msgstr "clangd utilise {used} de mémoire, au-delà de sa limite de {limit}. Il a été redémarré il y a moins de 10 minutes : il reste donc en cours d'exécution."

msgid "clangd was using {used} of memory, over its limit of {limit}, and was restarted."
msgstr "clangd utilisait {used} de mémoire, au-delà de sa limite de {limit}, et a été redémarré."

msgid "process with an unreadable command name"
msgstr "processus dont le nom de commande est illisible"

