msgstr "Délai d'attente en millisecondes avant d'afficher la fenêtre de survol informative."

msgctxt "settings"
msgid "Timeout"
msgstr "Délai d'expiration"

msgctxt "settings"
msgid "Timestamp Each Line"
msgstr "Horodater chaque ligne"

msgctxt "settings"
msgid "Title Bar"
msgstr "Barre de titre"

msgctxt "settings"
msgid "Title Format"
msgstr "Format du titre"

msgctxt "settings"
msgid "Title Override"
msgstr "Titre personnalisé"

msgctxt "settings"
