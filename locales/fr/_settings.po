msgid "Use System Clipboard"
msgstr "Utiliser le presse-papiers système"

msgctxt "settings"
msgid "Use System Path Prompts"
msgstr "Utiliser les boîtes de dialogue système pour les chemins d'accès"

msgctxt "settings"
msgid "Use System Prompts"
msgstr "Utiliser les boîtes de dialogue système"

msgctxt "settings"
msgid "Use System Window Tabs"
msgstr "Utiliser les onglets de fenêtre système"

msgctxt "settings"
msgid "Use gitignored files when searching."
msgstr "Inclut les fichiers ignorés par Git lors de la recherche."

msgctxt "settings"
msgid "Use native OS dialogs for 'Open' and 'Save As'."
msgstr "Utilise les boîtes de dialogue natives du système d'exploitation pour 'Ouvrir' et 'Enregistrer sous'."

msgctxt "settings"
