msgstr "Utilise les boîtes de dialogue natives du système pour les confirmations."

msgctxt "settings"
msgid "Use regex search by default in Vim search."
msgstr "Utilise la recherche par expression régulière par défaut dans la recherche Vim."

msgctxt "settings"
msgid "Use regex search by default."
msgstr "Utilise la recherche par expression régulière par défaut."

