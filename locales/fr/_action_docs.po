#. Selects the next object.
msgctxt "action documentation"
msgid "vim::PushHelixNext"
msgstr "Sélectionne l'objet suivant."

#. Selects the previous object.
msgctxt "action documentation"
msgid "vim::PushHelixPrevious"
msgstr "Sélectionne l'objet précédent."

#. Adds surrounding characters in Helix mode.
msgctxt "action documentation"
msgid "vim::PushHelixSurroundAdd"
msgstr "Ajoute des caractères englobants en mode Helix."

#. Deletes surrounding characters in Helix mode.
msgctxt "action documentation"
msgid "vim::PushHelixSurroundDelete"
msgstr "Supprime les caractères englobants en mode Helix."

#. Replaces surrounding characters in Helix mode.
msgctxt "action documentation"
msgid "vim::PushHelixSurroundReplace"
msgstr "Remplace les caractères englobants en mode Helix."

#. Starts an indent operation.
msgctxt "action documentation"
msgid "vim::PushIndent"
msgstr "Lance une opération d'indentation."

#. Converts to lowercase.
msgctxt "action documentation"
msgid "vim::PushLowercase"
msgstr "Convertit en minuscules."

#. Sets a mark at the current position.
msgctxt "action documentation"
msgid "vim::PushMark"
msgstr "Définit un repère à la position actuelle."

#. Toggles case.
msgctxt "action documentation"
msgid "vim::PushOppositeCase"
msgstr "Bascule la casse."

#. Starts an outdent operation.
msgctxt "action documentation"
msgid "vim::PushOutdent"
msgstr "Lance une opération de désindentation."

#. Starts recording to a register.
msgctxt "action documentation"
msgid "vim::PushRecordRegister"
msgstr "Lance l'enregistrement dans un registre."

#. Selects a register.
msgctxt "action documentation"
msgid "vim::PushRegister"
msgstr "Sélectionne un registre."

#. Starts a replace operation.
msgctxt "action documentation"
msgid "vim::PushReplace"
msgstr "Lance une opération de remplacement."

#. Replaces with register contents.
msgctxt "action documentation"
msgid "vim::PushReplaceWithRegister"
msgstr "Remplace par le contenu du registre."

#. Replays a register.
msgctxt "action documentation"
