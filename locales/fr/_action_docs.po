msgstr "Ouvre le site de documentation."

#. Opens the keymap editor.
msgctxt "action documentation"
msgid "zed::OpenKeymap"
msgstr "Ouvre l'éditeur de raccourcis clavier."

#. Opens the user keymap file.
msgctxt "action documentation"
msgid "zed::OpenKeymapFile"
msgstr "Ouvre le fichier de raccourcis clavier de l'utilisateur."

#. Views open source licenses.
msgctxt "action documentation"
msgid "zed::OpenLicenses"
msgstr "Affiche les licences open source."

#. Opens the Zed log file.
msgctxt "action documentation"
msgid "zed::OpenLog"
msgstr "Ouvre le fichier journal de ForgeKairos."

#. Opens the onboarding view.
msgctxt "action documentation"
msgid "zed::OpenOnboarding"
msgstr "Ouvre la vue de prise en main."

#. Opens the performance profiler.
msgctxt "action documentation"
msgid "zed::OpenPerformanceProfiler"
msgstr "Ouvre le profileur de performances."

#. Opens project-specific settings.
msgctxt "action documentation"
msgid "zed::OpenProjectSettings"
msgstr "Ouvre les paramètres spécifiques au projet."

#. Opens project-specific settings file.
msgctxt "action documentation"
msgid "zed::OpenProjectSettingsFile"
msgstr "Ouvre le fichier de paramètres spécifique au projet."

#. Opens the project tasks configuration.
msgctxt "action documentation"
msgid "zed::OpenProjectTasks"
msgstr "Ouvre la configuration des tâches du projet."

#. Opens server settings.
msgctxt "action documentation"
msgid "zed::OpenServerSettings"
msgstr "Ouvre les paramètres du serveur."

#. Opens the settings editor.
msgctxt "action documentation"
msgid "zed::OpenSettings"
msgstr "Ouvre l'éditeur de paramètres."

#. Opens the settings editor at a specific path.
msgctxt "action documentation"
msgid "zed::OpenSettingsAt"
msgstr "Ouvre l'éditeur de paramètres sur un paramètre spécifique."

#. Opens the settings JSON file.
msgctxt "action documentation"
msgid "zed::OpenSettingsFile"
msgstr "Ouvre le fichier JSON des paramètres."

#. Opens the Zed status page.
msgctxt "action documentation"
msgid "zed::OpenStatusPage"
msgstr "Ouvre la page d'état de Zed."

#. Opens the tasks panel.
msgctxt "action documentation"
msgid "zed::OpenTasks"
msgstr "Ouvre le panneau des tâches."

#. Opens the telemetry log.
msgctxt "action documentation"
msgid "zed::OpenTelemetryLog"
msgstr "Ouvre le journal de télémétrie."

#. Opens the project tasks configuration with worktree setup guidance.
msgctxt "action documentation"
msgid "zed::OpenWorktreeSetupTasks"
msgstr "Ouvre la configuration des tâches du projet avec des instructions pour la configuration de l'arborescence de travail."

#. Opens the Zed repository on GitHub.
msgctxt "action documentation"
msgid "zed::OpenZedRepo"
msgstr "Ouvre le dépôt Zed sur GitHub."

#. Opens a zed:// URL within the application.
msgctxt "action documentation"
msgid "zed::OpenZedUrl"
msgstr "Ouvre une URL zed:// dans l'application."

#. Quits the application.
msgctxt "action documentation"
msgid "zed::Quit"
msgstr "Quitte l'application."

#. Rebuilds an installed dev extension.
msgctxt "action documentation"
msgid "zed::RebuildDevExtension"
msgstr "Recompile une extension de développement installée."

#. Starts recording an ETW (Event Tracing for Windows) trace.
msgctxt "action documentation"
msgid "zed::RecordEtwTrace"
msgstr "Lance l'enregistrement d'une trace ETW (Event Tracing for Windows)."

#. Starts recording an ETW (Event Tracing for Windows) trace with heap tracing.
msgctxt "action documentation"
msgid "zed::RecordEtwTraceWithHeapTracing"
msgstr "Lance l'enregistrement d'une trace ETW (Event Tracing for Windows) avec traçage du tas."

#. Reloads all installed extensions.
msgctxt "action documentation"
msgid "zed::ReloadExtensions"
msgstr "Recharge toutes les extensions installées."

#. Resets all zoom levels (UI and buffer font sizes, including in the agent panel) to their default values.
msgctxt "action documentation"
msgid "zed::ResetAllZoom"
msgstr "Réinitialise tous les niveaux de zoom (tailles de police de l'interface et des tampons, y compris dans le panneau de l'agent) à leurs valeurs par défaut."

#. Resets the buffer font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetBufferFontSize"
msgstr "Réinitialise la taille de police du tampon à la valeur par défaut."

#. Resets the application database.
msgctxt "action documentation"
msgid "zed::ResetDatabase"
msgstr "Réinitialise la base de données de l'application."

#. Resets the UI font size to the default value.
msgctxt "action documentation"
msgid "zed::ResetUiFontSize"
msgstr "Réinitialise la taille de police de l'interface à la valeur par défaut."

#. Reveals the Zed log file in the system file manager.
msgctxt "action documentation"
msgid "zed::RevealLogInFileManager"
msgstr "Affiche le fichier journal de ForgeKairos dans le gestionnaire de fichiers du système."

#. Saves an in-progress ETW trace to disk.
msgctxt "action documentation"
msgid "zed::SaveEtwTrace"
msgstr "Enregistre une trace ETW en cours sur le disque."

#. Shows all hidden windows.
msgctxt "action documentation"
msgid "zed::ShowAll"
msgstr "Affiche toutes les fenêtres masquées."

#. Shows the default semantic token rules (read-only).
msgctxt "action documentation"
msgid "zed::ShowDefaultSemanticTokenRules"
msgstr "Affiche les règles de jetons sémantiques par défaut (lecture seule)."

#. Shows the auto-update notification for testing.
msgctxt "action documentation"
msgid "zed::ShowUpdateNotification"
msgstr "Affiche la notification de mise à jour automatique pour les tests."

#. Show the Zed welcome screen
msgctxt "action documentation"
msgid "zed::ShowWelcome"
msgstr "Affiche l'écran d'accueil de ForgeKairos"

#. Triggers a hard crash for debugging.
msgctxt "action documentation"
msgid "zed::TestCrash"
msgstr "Déclenche un plantage brutal à des fins de débogage."

#. Triggers a test panic for debugging.
msgctxt "action documentation"
msgid "zed::TestPanic"
msgstr "Déclenche une panique de test à des fins de débogage."

#. Toggles the base keymap selector modal.
msgctxt "action documentation"
msgid "zed::ToggleBaseKeymapSelector"
msgstr "Ouvre ou ferme la fenêtre modale de sélection des raccourcis de base."

#. Toggles fullscreen mode.
msgctxt "action documentation"
msgid "zed::ToggleFullScreen"
msgstr "Active ou désactive le mode plein écran."

#. Action with special handling which unbinds later bindings for the same keystrokes when they
#. dispatch the named action, regardless of that action's context.
#.
#. In keymap JSON this is written as:
#.
#. `["zed::Unbind", "editor::NewLine"]`
msgctxt "action documentation"
msgid "zed::Unbind"
msgstr "Action à traitement spécial qui annule les combinaisons de touches ultérieures pour les mêmes frappes lorsqu'elles déclenchent l'action nommée, quel que soit le contexte de cette action.\n\nDans le JSON des raccourcis clavier, elle s'écrit ainsi :\n\n`[\"zed::Unbind\", \"editor::NewLine\"]`"

#. Zooms the window.
msgctxt "action documentation"
msgid "zed::Zoom"
msgstr "Effectue un zoom sur la fenêtre."

#. Opens the Zed Predict onboarding modal.
msgctxt "action documentation"
msgid "zed_predict_onboarding::OpenZedPredictOnboarding"
msgstr "Ouvre la fenêtre modale de prise en main de Zed Predict."

#. Focuses on the completions list.
msgctxt "action documentation"
msgid "zeta::FocusPredictions"
msgstr "Donne le focus à la liste des complétions."

#. Navigates to the next edit in the completion history.
msgctxt "action documentation"
msgid "zeta::NextEdit"
msgstr "Navigue vers la modification suivante dans l'historique des complétions."

#. Previews the selected completion.
msgctxt "action documentation"
msgid "zeta::PreviewPrediction"
msgstr "Affiche un aperçu de la complétion sélectionnée."

#. Navigates to the previous edit in the completion history.
msgctxt "action documentation"
msgid "zeta::PreviousEdit"
msgstr "Navigue vers la modification précédente dans l'historique des complétions."

#. Rates the active completion with a thumbs down.
msgctxt "action documentation"
msgid "zeta::ThumbsDownActivePrediction"
msgstr "Évalue la complétion active avec un pouce vers le bas."

#. Rates the active completion with a thumbs up.
msgctxt "action documentation"
msgid "zeta::ThumbsUpActivePrediction"
msgstr "Évalue la complétion active avec un pouce vers le haut."
