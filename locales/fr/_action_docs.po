msgid "image_viewer::ZoomIn"
msgstr "Effectue un zoom avant sur l'image."

#. Zoom out the image.
msgctxt "action documentation"
msgid "image_viewer::ZoomOut"
msgstr "Effectue un zoom arrière sur l'image."

#. Zoom to actual size (100%).
msgctxt "action documentation"
msgid "image_viewer::ZoomToActualSize"
msgstr "Affiche l'image à sa taille réelle (100 %)."

#. Creates a new journal entry for today.
msgctxt "action documentation"
msgid "journal::NewJournalEntry"
msgstr "Crée une nouvelle entrée de journal pour aujourd'hui."

#. Copies the action name to clipboard.
msgctxt "action documentation"
msgid "keymap_editor::CopyAction"
msgstr "Copie le nom de l'action dans le presse-papiers."

#. Copies the context predicate to clipboard.
msgctxt "action documentation"
msgid "keymap_editor::CopyContext"
msgstr "Copie le prédicat de contexte dans le presse-papiers."

#. Creates a new key binding for the selected action.
msgctxt "action documentation"
msgid "keymap_editor::CreateBinding"
msgstr "Crée une nouvelle combinaison de touches pour l'action sélectionnée."

#. Deletes the selected key binding.
msgctxt "action documentation"
msgid "keymap_editor::DeleteBinding"
msgstr "Supprime la combinaison de touches sélectionnée."

#. Edits the selected key binding.
msgctxt "action documentation"
msgid "keymap_editor::EditBinding"
msgstr "Modifie la combinaison de touches sélectionnée."

#. Creates a new key binding from scratch, prompting for the action.
msgctxt "action documentation"
msgid "keymap_editor::OpenCreateKeybindingModal"
msgstr "Crée une nouvelle combinaison de touches à partir de zéro, en demandant l'action."

#. Shows matching keystrokes for the currently selected binding
msgctxt "action documentation"
msgid "keymap_editor::ShowMatchingKeybinds"
msgstr "Affiche les frappes correspondantes pour la combinaison de touches actuellement sélectionnée"

#. Toggles Conflict Filtering
msgctxt "action documentation"
msgid "keymap_editor::ToggleConflictFilter"
msgstr "Active ou désactive le filtrage des conflits"

#. Toggles exact matching for keystroke search
msgctxt "action documentation"
msgid "keymap_editor::ToggleExactKeystrokeMatching"
msgstr "Active ou désactive la correspondance exacte pour la recherche par frappe"

#. Toggle Keystroke search
msgctxt "action documentation"
msgid "keymap_editor::ToggleKeystrokeSearch"
msgstr "Active ou désactive la recherche par frappe"

#. Toggles whether NoAction bindings are shown
msgctxt "action documentation"
msgid "keymap_editor::ToggleNoActionBindings"
msgstr "Active ou désactive l'affichage des combinaisons de touches NoAction"

#. Clears the recorded keystrokes
msgctxt "action documentation"
msgid "keystroke_input::ClearKeystrokes"
msgstr "Efface les frappes enregistrées"

#. Starts recording keystrokes
msgctxt "action documentation"
msgid "keystroke_input::StartRecording"
msgstr "Lance l'enregistrement des frappes clavier"

#. Stops recording keystrokes
msgctxt "action documentation"
msgid "keystroke_input::StopRecording"
msgstr "Arrête l'enregistrement des frappes clavier"

#. Toggles the language selector modal.
msgctxt "action documentation"
msgid "language_selector::Toggle"
msgstr "Ouvre ou ferme la fenêtre modale de sélection du langage."

#. Toggles the line ending selector modal.
msgctxt "action documentation"
msgid "line_ending_selector::Toggle"
msgstr "Ouvre ou ferme la fenêtre modale de sélection des fins de ligne."

#. Shows what the project's folders do not run after an agent wrote
#. into them, with a way to review the changes and resume.
msgctxt "action documentation"
msgid "lsp_tool::ReviewPausedWorktreeCode"
msgstr "Affiche ce que les dossiers du projet n'exécutent pas après qu'un agent y a écrit, avec un moyen d'examiner les modifications et de reprendre."

#. Toggles the language server tool menu.
msgctxt "action documentation"
msgid "lsp_tool::ToggleMenu"
msgstr "Ouvre ou ferme le menu d'outils du serveur de langage."

#. Closes the markdown preview and returns focus to the source editor.
msgctxt "action documentation"
msgid "markdown::CloseAndReturnToEditor"
msgstr "Ferme l'aperçu Markdown et redonne le focus à l'éditeur source."

#. Copies the selected text to the clipboard.
msgctxt "action documentation"
msgid "markdown::Copy"
msgstr "Copie le texte sélectionné dans le presse-papiers."

#. Copies the selected text as markdown to the clipboard.
msgctxt "action documentation"
msgid "markdown::CopyAsMarkdown"
msgstr "Copie le texte sélectionné au format Markdown dans le presse-papiers."

#. Opens the structured editor on the Mermaid flowchart the
#. cursor is inside.
msgctxt "action documentation"
msgid "markdown::EditMermaid"
msgstr "Ouvre l'éditeur structuré sur l'organigramme Mermaid dans lequel se trouve le curseur."

#. Opens the table editor on the pipe table under the cursor, or
#. on a blank table when the cursor is not inside one.
msgctxt "action documentation"
msgid "markdown::EditTable"
msgstr "Ouvre l'éditeur de tableau sur le tableau à barres verticales situé sous le curseur, ou sur un tableau vide si le curseur n'est dans aucun tableau."

#. Exports the active Markdown file to a PDF next to it.
msgctxt "action documentation"
msgid "markdown::ExportToPdf"
msgstr "Exporte le fichier Markdown actif au format PDF, à côté de celui-ci."

#. Folds the body of every Markdown heading, at every level.
msgctxt "action documentation"
msgid "markdown::FoldAllHeadings"
msgstr "Replie le corps de chaque titre Markdown, à tous les niveaux."

#. Folds the body of every Markdown heading of the given level (1 to 6),
#. leaving the heading lines themselves visible.
msgctxt "action documentation"
msgid "markdown::FoldHeadings"
msgstr "Replie le corps de chaque titre Markdown du niveau indiqué (1 à 6), en laissant visibles les lignes de titre elles-mêmes."

#. Picks the heading level to fold, since `markdown::FoldHeadings`
#. always carries one and so cannot be built from the palette.
msgctxt "action documentation"
msgid "markdown::FoldHeadingsPicker"
msgstr "Choisit le niveau de titre à replier, car `markdown::FoldHeadings` en porte toujours un et ne peut donc pas être créé depuis la palette."

#. Inserts a `<details>` disclosure holding a fenced code block, with the
#. selected lines as its body, while in Markdown files.
msgctxt "action documentation"
msgid "markdown::InsertDetails"
msgstr "Insère un bloc dépliable `<details>` contenant un bloc de code délimité, avec les lignes sélectionnées comme corps, dans les fichiers Markdown."

#. Inserts a horizontal rule (`---`) as its own block while in Markdown files.
msgctxt "action documentation"
msgid "markdown::InsertHorizontalRule"
msgstr "Insère une ligne horizontale (`---`) comme bloc distinct dans les fichiers Markdown."

#. Opens the image dialog: inserts an image at the cursor, or edits the
#. image the cursor is on.
msgctxt "action documentation"
msgid "markdown::InsertImage"
msgstr "Ouvre la boîte de dialogue d'image : insère une image au curseur ou modifie l'image sur laquelle se trouve le curseur."

#. Inserts a Markdown link around the selection, or an empty one at the cursor.
msgctxt "action documentation"
msgid "markdown::InsertLink"
msgstr "Insère un lien Markdown autour de la sélection, ou un lien vide au curseur."

#. Inserts a fenced Mermaid diagram template while in Markdown files.
msgctxt "action documentation"
msgid "markdown::InsertMermaidDiagram"
msgstr "Insère un modèle de diagramme Mermaid dans un bloc délimité, dans les fichiers Markdown."

#. Picks the Mermaid diagram type to insert at the cursor, since
#. `markdown::InsertMermaidDiagram` can only carry one type at a time.
msgctxt "action documentation"
msgid "markdown::InsertMermaidDiagramPicker"
msgstr "Choisit le type de diagramme Mermaid à insérer au curseur, car `markdown::InsertMermaidDiagram` ne peut porter qu'un seul type à la fois."

#. Inserts a newline with the opposite hard break behavior of `editor::Newline`:
#. it adds the two trailing spaces when `hard_break_on_newline` is off, and
#. leaves them out when it is on.
msgctxt "action documentation"
msgid "markdown::NewlineInvertHardBreak"
msgstr "Insère un saut de ligne avec le comportement de saut de ligne forcé inverse de celui de `editor::Newline` : ajoute les deux espaces de fin quand `hard_break_on_newline` est désactivé, et les omet quand il est activé."

#. Opens a following markdown preview that syncs with the editor.
msgctxt "action documentation"
msgid "markdown::OpenFollowingPreview"
msgstr "Ouvre un aperçu Markdown en suivi synchronisé avec l'éditeur."

#. Opens a markdown preview for the current file.
msgctxt "action documentation"
msgid "markdown::OpenPreview"
msgstr "Ouvre un aperçu Markdown pour le fichier actif."

#. Opens a markdown preview in a split pane.
msgctxt "action documentation"
msgid "markdown::OpenPreviewToTheSide"
msgstr "Ouvre un aperçu Markdown dans un volet fractionné."

#. Removes the marker from the selected text while in Markdown files.
msgctxt "action documentation"
msgid "markdown::RemoveMarker"
msgstr "Retire le surlignage du texte sélectionné, dans les fichiers Markdown."

#. Removes the text color from the selected text while in Markdown files.
msgctxt "action documentation"
msgid "markdown::RemoveTextColor"
msgstr "Retire la couleur du texte sélectionné, dans les fichiers Markdown."

#. Returns the paragraphs the selection touches to the normal text size
#. while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ResetTextSize"
msgstr "Rétablit la taille de texte normale des paragraphes touchés par la sélection, dans les fichiers Markdown."

#. Scrolls down by approximately one visual line.
msgctxt "action documentation"
msgid "markdown::ScrollDown"
msgstr "Fait défiler vers le bas d'environ une ligne visuelle."

#. Scrolls down by one markdown element in the markdown preview
msgctxt "action documentation"
msgid "markdown::ScrollDownByItem"
msgstr "Fait défiler vers le bas d'un élément Markdown dans l'aperçu Markdown"

#. Scrolls down by one page in the markdown preview.
msgctxt "action documentation"
msgid "markdown::ScrollPageDown"
msgstr "Fait défiler vers le bas d'une page dans l'aperçu Markdown."

#. Scrolls up by one page in the markdown preview.
msgctxt "action documentation"
msgid "markdown::ScrollPageUp"
msgstr "Fait défiler vers le haut d'une page dans l'aperçu Markdown."

#. Scrolls to the bottom of the markdown preview.
msgctxt "action documentation"
msgid "markdown::ScrollToBottom"
msgstr "Fait défiler jusqu'en bas de l'aperçu Markdown."

#. Scrolls to the top of the markdown preview.
msgctxt "action documentation"
msgid "markdown::ScrollToTop"
msgstr "Fait défiler jusqu'en haut de l'aperçu Markdown."

#. Scrolls up by approximately one visual line.
msgctxt "action documentation"
msgid "markdown::ScrollUp"
msgstr "Fait défiler vers le haut d'environ une ligne visuelle."

#. Scrolls up by one markdown element in the markdown preview
msgctxt "action documentation"
msgid "markdown::ScrollUpByItem"
msgstr "Fait défiler vers le haut d'un élément Markdown dans l'aperçu Markdown"

#. Highlights the selected text with a marker, written as `<mark>`, while in
#. Markdown files. Inside a marker the marker's color is replaced instead of
#. nesting another one.
msgctxt "action documentation"
msgid "markdown::SetMarker"
msgstr "Surligne le texte sélectionné, écrit sous la forme `<mark>`, dans les fichiers Markdown. À l'intérieur d'un surlignage, sa couleur est remplacée au lieu d'en imbriquer un autre."

#. Colors the selected text with a preset color, written as
#. `<span style="color: …">`, while in Markdown files. Inside a colored span
#. the span's color is replaced instead of nesting another one.
msgctxt "action documentation"
msgid "markdown::SetTextColor"
msgstr "Colore le texte sélectionné avec une couleur prédéfinie, écrite sous la forme `<span style=\"color: …\">`, dans les fichiers Markdown. À l'intérieur d'un span coloré, la couleur du span est remplacée au lieu d'en imbriquer un autre."

#. Sets the text size of every paragraph the selection touches, written as a
#. `<span style="font-size: …">` around the paragraph's text, while in
#. Markdown files. Headings, code blocks, tables and HTML blocks are left alone.
msgctxt "action documentation"
msgid "markdown::SetTextSize"
msgstr "Définit la taille de texte de chaque paragraphe touché par la sélection, écrite sous la forme d'un `<span style=\"font-size: …\">` autour du texte du paragraphe, dans les fichiers Markdown. Les titres, blocs de code, tableaux et blocs HTML ne sont pas modifiés."

#. Toggles a block quote (`> `) prefix on the selected lines (or the
#. current line) while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleBlockQuote"
msgstr "Active ou désactive un préfixe de citation (`> `) sur les lignes sélectionnées (ou la\nligne actuelle) dans les fichiers Markdown."

#. Toggles bold (`**`) around the selection while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleBold"
msgstr "Active ou désactive le gras (`**`) autour de la sélection, dans les fichiers Markdown."

#. Toggles a bullet list (`- `) on the selected lines while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleBulletList"
msgstr "Active ou désactive une liste à puces (`- `) sur les lignes sélectionnées, dans les fichiers Markdown."

#. Toggles a level 1 heading on the selected lines while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleHeading1"
msgstr "Active ou désactive un titre de niveau 1 sur les lignes sélectionnées, dans les fichiers Markdown."

#. Toggles a level 2 heading on the selected lines while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleHeading2"
msgstr "Active ou désactive un titre de niveau 2 sur les lignes sélectionnées, dans les fichiers Markdown."

#. Toggles a level 3 heading on the selected lines while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleHeading3"
msgstr "Active ou désactive un titre de niveau 3 sur les lignes sélectionnées, dans les fichiers Markdown."

#. Toggles inline code (`` ` ``) around the selection while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleInlineCode"
msgstr "Active ou désactive le code en ligne (`` ` ``) autour de la sélection, dans les fichiers Markdown."

#. Toggles italic (`*`) around the selection while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleItalic"
msgstr "Active ou désactive l'italique (`*`) autour de la sélection, dans les fichiers Markdown."

#. Toggles a yellow marker (`<mark>`) on the selected text while in
#. Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleMarker"
msgstr "Active ou désactive un surlignage jaune (`<mark>`) sur le texte sélectionné, dans les fichiers Markdown."

#. Toggles a numbered list (`1. `) on the selected lines while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleNumberedList"
msgstr "Active ou désactive une liste numérotée (`1. `) sur les lignes sélectionnées, dans les fichiers Markdown."

#. Toggles strikethrough (`~~`) around the selection while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleStrikethrough"
msgstr "Active ou désactive le texte barré (`~~`) autour de la sélection, dans les fichiers Markdown."

#. Toggles a task list (`- [ ] `) on the selected lines while in Markdown files.
msgctxt "action documentation"
msgid "markdown::ToggleTaskList"
msgstr "Active ou désactive une liste de tâches (`- [ ] `) sur les lignes sélectionnées, dans les fichiers Markdown."

#. Unfolds everything that was folded in the Markdown file.
msgctxt "action documentation"
msgid "markdown::UnfoldAllHeadings"
msgstr "Déplie tout ce qui a été replié dans le fichier Markdown."

#. Wraps the selected lines in a fenced code block while in Markdown files.
msgctxt "action documentation"
msgid "markdown::WrapInCodeBlock"
msgstr "Entoure les lignes sélectionnées d'un bloc de code délimité, dans les fichiers Markdown."

#. Cancels the current menu operation.
msgctxt "action documentation"
msgid "menu::Cancel"
msgstr "Annule l'opération de menu en cours."

#. Confirms the selected menu item.
msgctxt "action documentation"
msgid "menu::Confirm"
msgstr "Confirme l'élément de menu sélectionné."

#. Restarts the menu from the beginning.
msgctxt "action documentation"
msgid "menu::Restart"
msgstr "Redémarre le menu depuis le début."

#. Performs secondary confirmation action.
msgctxt "action documentation"
msgid "menu::SecondaryConfirm"
msgstr "Effectue l'action de confirmation secondaire."

#. Enters a submenu (navigates to child menu).
msgctxt "action documentation"
msgid "menu::SelectChild"
msgstr "Entre dans un sous-menu (navigue vers le menu enfant)."

#. Selects the first item in the menu.
msgctxt "action documentation"
msgid "menu::SelectFirst"
msgstr "Sélectionne le premier élément du menu."

#. Selects the last item in the menu.
msgctxt "action documentation"
msgid "menu::SelectLast"
msgstr "Sélectionne le dernier élément du menu."

#. Selects the next item in the menu.
msgctxt "action documentation"
msgid "menu::SelectNext"
msgstr "Sélectionne l'élément suivant dans le menu."

#. Exits a submenu (navigates to parent menu).
msgctxt "action documentation"
msgid "menu::SelectParent"
msgstr "Quitte un sous-menu (navigue vers le menu parent)."

#. Selects the previous item in the menu.
msgctxt "action documentation"
msgid "menu::SelectPrevious"
msgstr "Sélectionne l'élément précédent dans le menu."

#. Closes the workspace sidebar.
msgctxt "action documentation"
msgid "multi_workspace::CloseWorkspaceSidebar"
msgstr "Ferme la barre latérale de l'espace de travail."

#. Moves focus to or from the workspace sidebar without closing it.
msgctxt "action documentation"
msgid "multi_workspace::FocusWorkspaceSidebar"
msgstr "Déplace le focus vers la barre latérale de l'espace de travail ou en dehors de celle-ci, sans la fermer."

#. Moves the active project down in the sidebar.
msgctxt "action documentation"
msgid "multi_workspace::MoveProjectDown"
msgstr "Déplace le projet actif vers le bas dans la barre latérale."

#. Moves the active project to a new window.
msgctxt "action documentation"
msgid "multi_workspace::MoveProjectToNewWindow"
msgstr "Déplace le projet actif vers une nouvelle fenêtre."

#. Moves the active project up in the sidebar.
msgctxt "action documentation"
msgid "multi_workspace::MoveProjectUp"
msgstr "Déplace le projet actif vers le haut dans la barre latérale."

#. Creates a new thread in the current workspace.
msgctxt "action documentation"
msgid "multi_workspace::NewThread"
msgstr "Crée une nouvelle conversation dans l'espace de travail actuel."

#. Activates the next project in the sidebar.
msgctxt "action documentation"
msgid "multi_workspace::NextProject"
msgstr "Active le projet suivant dans la barre latérale."

#. Activates the next thread in sidebar order.
msgctxt "action documentation"
msgid "multi_workspace::NextThread"
msgstr "Active la conversation suivante dans l'ordre de la barre latérale."

#. Activates the previous project in the sidebar.
msgctxt "action documentation"
msgid "multi_workspace::PreviousProject"
msgstr "Active le projet précédent dans la barre latérale."

#. Activates the previous thread in sidebar order.
msgctxt "action documentation"
msgid "multi_workspace::PreviousThread"
msgstr "Active la conversation précédente dans l'ordre de la barre latérale."

#. Toggles the workspace switcher sidebar.
msgctxt "action documentation"
msgid "multi_workspace::ToggleWorkspaceSidebar"
msgstr "Affiche ou masque la barre latérale de changement d'espace de travail."

#. Adds a new code cell.
msgctxt "action documentation"
msgid "notebook::AddCodeBlock"
msgstr "Ajoute une nouvelle cellule de code."

#. Adds a new markdown cell.
msgctxt "action documentation"
msgid "notebook::AddMarkdownBlock"
msgstr "Ajoute une nouvelle cellule Markdown."

#. Clears all cell outputs.
msgctxt "action documentation"
msgid "notebook::ClearOutputs"
msgstr "Efface toutes les sorties des cellules."

#. Deletes the current cell.
msgctxt "action documentation"
msgid "notebook::DeleteCell"
msgstr "Supprime la cellule actuelle."

#. Exits the cell editor and returns to cell command mode.
msgctxt "action documentation"
msgid "notebook::EnterCommandMode"
msgstr "Quitte l'éditeur de cellule et retourne au mode commande."

#. Enters the current cell's editor (edit mode).
msgctxt "action documentation"
msgid "notebook::EnterEditMode"
msgstr "Entre dans l'éditeur de la cellule active (mode édition)."

#. Interrupts the current execution.
msgctxt "action documentation"
msgid "notebook::InterruptKernel"
msgstr "Interrompt l'exécution en cours."

#. Moves the current cell down.
msgctxt "action documentation"
msgid "notebook::MoveCellDown"
msgstr "Déplace la cellule actuelle vers le bas."

#. Moves the current cell up.
msgctxt "action documentation"
msgid "notebook::MoveCellUp"
msgstr "Déplace la cellule actuelle vers le haut."

#. Move down in cells.
msgctxt "action documentation"
msgid "notebook::NotebookMoveDown"
msgstr "Se déplace vers le bas dans les cellules."

#. Move up in cells.
msgctxt "action documentation"
msgid "notebook::NotebookMoveUp"
msgstr "Se déplace vers le haut dans les cellules."

#. Opens a Jupyter notebook file.
msgctxt "action documentation"
msgid "notebook::OpenNotebook"
msgstr "Ouvre un fichier de notebook Jupyter."

#. Restarts the kernel.
msgctxt "action documentation"
msgid "notebook::RestartKernel"
msgstr "Redémarre le noyau."

#. Runs the current cell and stays on it.
msgctxt "action documentation"
msgid "notebook::Run"
msgstr "Exécute la cellule actuelle sans avancer."

#. Runs all cells in the notebook.
msgctxt "action documentation"
msgid "notebook::RunAll"
msgstr "Exécute toutes les cellules du notebook."

#. Runs the current cell and advances to the next cell.
msgctxt "action documentation"
msgid "notebook::RunAndAdvance"
msgstr "Exécute la cellule actuelle et passe à la cellule suivante."

#. Finish the onboarding process.
msgctxt "action documentation"
msgid "onboarding::Finish"
msgstr "Termine le processus de prise en main."

#. Open the user account in zed.dev while in the onboarding flow.
msgctxt "action documentation"
msgid "onboarding::OpenAccount"
msgstr "Ouvre le compte utilisateur sur zed.dev pendant le processus de prise en main."

#. Resets the welcome screen hints to their initial state.
msgctxt "action documentation"
msgid "onboarding::ResetHints"
msgstr "Réinitialise les conseils de l'écran d'accueil à leur état initial."

#. Sign in while in the onboarding flow.
msgctxt "action documentation"
msgid "onboarding::SignIn"
msgstr "Se connecte pendant le processus de prise en main."

#. Collapses all entries in the outline tree.
msgctxt "action documentation"
msgid "outline_panel::CollapseAllEntries"
msgstr "Réduit toutes les entrées de l'arborescence de structure."

#. Collapses the currently selected entry.
msgctxt "action documentation"
msgid "outline_panel::CollapseSelectedEntry"
msgstr "Réduit l'entrée sélectionnée."

#. Expands all entries in the outline tree.
msgctxt "action documentation"
msgid "outline_panel::ExpandAllEntries"
msgstr "Développe toutes les entrées dans l'arborescence de structure."

#. Expands the currently selected entry.
