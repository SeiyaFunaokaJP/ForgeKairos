# The descriptions of actions (their doc comments), keyed by the action name.
# The #. comments of an entry are the English it translates, one per line.
#
# Entries that zed-i18n also translates started from its fr-FR translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: fr\n"
"X-Language-Name: Français\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#. Runs a sequence of actions.
#.
#. NOTE: This does **not** wait for asynchronous actions to complete before running the next action.
msgctxt "action documentation"
msgid "action::Sequence"
msgstr "Exécute une séquence d'actions.\n\nREMARQUE : n'attend **pas** la fin des actions asynchrones avant d'exécuter l'action suivante."

#. Displays error messages from language servers in the status bar.
msgctxt "action documentation"
msgid "activity_indicator::ShowErrorMessage"
msgstr "Affiche les messages d'erreur des serveurs de langage dans la barre d'état."

#. Add the current selection as context for threads in the agent panel.
msgctxt "action documentation"
msgid "agent::AddSelectionToThread"
msgstr "Ajoute la sélection actuelle comme contexte pour les conversations dans le panneau de l'agent."

#. Allow this operation and remember the choice.
msgctxt "action documentation"
msgid "agent::AllowAlways"
msgstr "Autorise cette opération et mémorise le choix."

#. Allow this operation only this time.
msgctxt "action documentation"
msgid "agent::AllowOnce"
msgstr "Autorise cette opération uniquement cette fois."

#. Archives the currently selected thread.
msgctxt "action documentation"
msgid "agent::ArchiveSelectedThread"
msgstr "Archive la conversation actuellement sélectionnée."

#. Action to authorize a tool call with a specific permission option.
#. This is used by the permission granularity dropdown to authorize tool calls.
msgctxt "action documentation"
msgid "agent::AuthorizeToolCall"
msgstr "Action pour autoriser un appel d'outil avec une option d'autorisation spécifique.\nCeci est utilisé par la liste déroulante de granularité des autorisations pour autoriser les appels d'outils."

#. Starts a chat conversation with the agent.
msgctxt "action documentation"
msgid "agent::Chat"
msgstr "Lance une conversation avec l'agent."

#. Starts a chat conversation with follow-up enabled.
msgctxt "action documentation"
msgid "agent::ChatWithFollow"
msgstr "Lance une conversation avec suivi activé."

#. Clears all messages from the queue.
msgctxt "action documentation"
msgid "agent::ClearMessageQueue"
msgstr "Efface tous les messages de la file d'attente."

#. Copies the current thread to the clipboard as JSON for debugging.
msgctxt "action documentation"
msgid "agent::CopyThreadToClipboard"
msgstr "Copie la conversation courante dans le presse-papiers au format JSON à des fins de débogage."

#. Opens the skill creator window to import a skill from a GitHub URL.
msgctxt "action documentation"
msgid "agent::CreateSkillFromUrl"
msgstr "Ouvre la fenêtre de création de compétences pour importer une compétence depuis une URL GitHub."

#. Cycles through favorited models in the ACP model selector.
msgctxt "action documentation"
msgid "agent::CycleFavoriteModels"
msgstr "Parcourt les modèles favoris dans le sélecteur de modèles ACP."

#. Cycles through available session modes.
msgctxt "action documentation"
msgid "agent::CycleModeSelector"
msgstr "Parcourt les modes de session disponibles."

#. Cycles to the next inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CycleNextInlineAssist"
msgstr "Passe à la suggestion d'assistance inline suivante."

#. Cycles to the previous inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CyclePreviousInlineAssist"
msgstr "Passe à la suggestion d'assistance inline précédente."

#. Cycles through available thinking effort levels for the current model.
msgctxt "action documentation"
msgid "agent::CycleThinkingEffort"
msgstr "Parcourt les niveaux d'effort de réflexion disponibles pour le modèle actuel."

#. Closes the thread search bar.
msgctxt "action documentation"
msgid "agent::DismissThreadSearch"
msgstr "Ferme la barre de recherche de la conversation."

#. Edits the first message in the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::EditFirstQueuedMessage"
msgstr "Modifie le premier message de la file d'attente (le prochain à envoyer)."

#. Expands the message editor to full size.
msgctxt "action documentation"
msgid "agent::ExpandMessageEditor"
msgstr "Développe l'éditeur de messages à sa taille maximale."

#. Moves focus down in the interface.
msgctxt "action documentation"
msgid "agent::FocusDown"
msgstr "Déplace le focus vers le bas dans l'interface."

#. Moves focus left in the interface.
msgctxt "action documentation"
msgid "agent::FocusLeft"
msgstr "Déplace le focus vers la gauche dans l'interface."

#. Moves focus right in the interface.
msgctxt "action documentation"
msgid "agent::FocusRight"
msgstr "Déplace le focus vers la droite dans l'interface."

#. Moves focus up in the interface.
msgctxt "action documentation"
msgid "agent::FocusUp"
msgstr "Déplace le focus vers le haut dans l'interface."

#. Follows the agent's suggestions.
msgctxt "action documentation"
msgid "agent::Follow"
msgstr "Suit les suggestions de l'agent."

#. Import agent threads from other Zed release channels (e.g. Preview, Nightly).
msgctxt "action documentation"
msgid "agent::ImportThreadsFromOtherChannels"
msgstr "Importe les conversations d'agent depuis d'autres canaux de publication de ForgeKairos (p. ex. Preview, Nightly)."

#. Keeps the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Keep"
msgstr "Conserve la suggestion ou la modification actuelle."

#. Keeps all suggestions or changes.
msgctxt "action documentation"
msgid "agent::KeepAll"
msgstr "Conserve toutes les suggestions ou modifications."

#. Loads a thread from the clipboard JSON for debugging.
msgctxt "action documentation"
msgid "agent::LoadThreadFromClipboard"
msgstr "Charge une conversation depuis le JSON du presse-papiers à des fins de débogage."

#. Logs out of the current external agent
msgctxt "action documentation"
msgid "agent::LogoutAgent"
msgstr "Se déconnecte de l'agent externe actuel"

#. Opens the profile management interface for configuring agent tools and settings.
msgctxt "action documentation"
msgid "agent::ManageProfiles"
msgstr "Ouvre l'interface de gestion des profils pour configurer les outils et paramètres de l'agent."

#. Opens the skills manager in the settings window.
msgctxt "action documentation"
msgid "agent::ManageSkills"
msgstr "Ouvre le gestionnaire de compétences dans la fenêtre des paramètres."

#. Moves the thread open in a tab back to the agent panel.
msgctxt "action documentation"
msgid "agent::MoveThreadToPanel"
msgstr "Replace dans le panneau de l'agent la conversation ouverte dans un onglet."

#. Creates a new external agent conversation thread.
msgctxt "action documentation"
msgid "agent::NewExternalAgentThread"
msgstr "Crée une nouvelle conversation avec un agent externe."

#. Starts a new terminal thread.
msgctxt "action documentation"
msgid "agent::NewTerminalThread"
msgstr "Démarre une nouvelle conversation de terminal."

#. Creates a new conversation thread, optionally based on an existing thread.
msgctxt "action documentation"
msgid "agent::NewThread"
msgstr "Crée une nouvelle conversation, éventuellement à partir d'une conversation existante."

#. Starts a new thread of the built-in agent on a model of the given
#. language model provider.
msgctxt "action documentation"
msgid "agent::NewThreadWithLanguageModelProvider"
msgstr "Démarre une nouvelle conversation de l'agent intégré avec un modèle du fournisseur de LLM indiqué."

#. Opens the active thread as a markdown file.
msgctxt "action documentation"
msgid "agent::OpenActiveThreadAsMarkdown"
msgstr "Ouvre la conversation active sous forme de fichier Markdown."

#. Opens the "Add Context" menu in the message editor.
msgctxt "action documentation"
msgid "agent::OpenAddContextMenu"
msgstr "Ouvre le menu \"Ajouter du contexte\" dans l'éditeur de message."

#. Opens the agent diff view to review changes.
msgctxt "action documentation"
msgid "agent::OpenAgentDiff"
msgstr "Ouvre la vue des différences de l'agent pour examiner les modifications."

#. Opens the user-global AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenGlobalAGENTS.mdRules"
msgstr "Ouvre le fichier de règles AGENTS.md global de l'utilisateur."

#. Opens the agent onboarding modal.
msgctxt "action documentation"
msgid "agent::OpenOnboardingModal"
msgstr "Ouvre la fenêtre modale de prise en main de l'agent."

#. Opens the permission granularity dropdown for the current tool call.
msgctxt "action documentation"
msgid "agent::OpenPermissionDropdown"
msgstr "Ouvre le menu déroulant de granularité des autorisations pour l'appel d'outil en cours."

#. Opens the project AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenProjectAGENTS.mdRules"
msgstr "Ouvre le fichier de règles AGENTS.md du projet."

#. Opens the agent settings UI.
msgctxt "action documentation"
msgid "agent::OpenSettings"
msgstr "Ouvre l'interface des paramètres de l'agent."

#. Opens the skill creator window for creating a new skill.
msgctxt "action documentation"
msgid "agent::OpenSkillCreator"
msgstr "Ouvre la fenêtre de création de compétences pour créer une nouvelle compétence."

#. Opens the current thread as a tab in a pane split to the right.
msgctxt "action documentation"
msgid "agent::OpenThreadInSplit"
msgstr "Ouvre la conversation actuelle dans un onglet d'un volet fractionné à droite."

#. Opens the current thread as a tab in the workspace. The panel goes back
#. to a new draft.
msgctxt "action documentation"
msgid "agent::OpenThreadInTab"
msgstr "Ouvre la conversation actuelle dans un onglet de l'espace de travail. Le panneau revient à un nouveau brouillon."

#. Pastes clipboard content without any formatting.
msgctxt "action documentation"
msgid "agent::PasteRaw"
msgstr "Colle le contenu du presse-papiers sans mise en forme."

#. Triggers re-authentication on Gemini
msgctxt "action documentation"
msgid "agent::ReauthenticateAgent"
msgstr "Déclenche une réauthentification sur Gemini"

#. Reconnects to an agent that was stopped while unused, without sending anything.
msgctxt "action documentation"
msgid "agent::ReconnectParkedAgent"
msgstr "Se reconnecte à un agent arrêté faute d'utilisation, sans rien envoyer."

#. Rejects the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Reject"
msgstr "Rejette la suggestion ou la modification actuelle."

#. Rejects all suggestions or changes.
msgctxt "action documentation"
msgid "agent::RejectAll"
msgstr "Rejette toutes les suggestions ou modifications."

#. Reject this operation only this time.
msgctxt "action documentation"
msgid "agent::RejectOnce"
msgstr "Rejette cette opération uniquement cette fois."

#. Removes the first message from the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::RemoveFirstQueuedMessage"
msgstr "Supprime le premier message de la file d'attente (le prochain à envoyer)."

#. Removes the currently selected thread.
msgctxt "action documentation"
msgid "agent::RemoveSelectedThread"
msgstr "Supprime la conversation actuellement sélectionnée."

#. Renames the currently selected thread.
msgctxt "action documentation"
msgid "agent::RenameSelectedThread"
msgstr "Renomme la conversation actuellement sélectionnée."

#. Reruns the rules-to-skills migration.
msgctxt "action documentation"
msgid "agent::RerunRulesToSkillsMigration"
msgstr "Relance la migration des règles vers les compétences."

#. Resets the agent panel zoom levels (agent UI and buffer font sizes).
msgctxt "action documentation"
msgid "agent::ResetAgentZoom"
msgstr "Réinitialise les niveaux de zoom du panneau de l'agent (tailles de police de l'interface de l'agent et des tampons)."

#. Re-enables the fast mode warning for every provider and model.
msgctxt "action documentation"
msgid "agent::ResetFastModeWarnings"
msgstr "Réactive l'avertissement du mode rapide pour chaque fournisseur et modèle."

#. Resets the agent onboarding state.
msgctxt "action documentation"
msgid "agent::ResetOnboarding"
msgstr "Réinitialise l'état de prise en main de l'agent."

#. Resets the trial end upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialEndUpsell"
msgstr "Réinitialise la notification de promotion de fin d'essai."

#. Resets the trial upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialUpsell"
msgstr "Réinitialise la notification de promotion de l'essai."

#. Opens a new agent thread to resolve merge conflicts in the given file paths.
msgctxt "action documentation"
msgid "agent::ResolveConflictedFilesWithAgent"
msgstr "Ouvre une nouvelle conversation d'agent pour résoudre les conflits de fusion dans les chemins de fichiers spécifiés."

#. Opens a new agent thread to resolve specific merge conflicts.
msgctxt "action documentation"
msgid "agent::ResolveConflictsWithAgent"
msgstr "Ouvre une nouvelle conversation d'agent pour résoudre des conflits de fusion spécifiques."

#. Opens a new agent thread with the provided branch diff for review.
msgctxt "action documentation"
msgid "agent::ReviewBranchDiff"
msgstr "Ouvre une nouvelle conversation d'agent avec les différences de branche fournies pour révision."

#. Takes back every start of an agent outside its sandbox that was
#. confirmed for a thread, so that each thread asks again.
msgctxt "action documentation"
msgid "agent::RevokeOutsideSandboxConsents"
msgstr "Retire tous les consentements donnés par conversation pour démarrer un agent hors de son bac à sable, afin que chaque conversation redemande."

#. Scroll the output down by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineDown"
msgstr "Fait défiler la sortie de trois lignes vers le bas."

#. Scroll the output up by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineUp"
msgstr "Fait défiler la sortie de trois lignes vers le haut."

#. Scroll the output by one page down.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageDown"
msgstr "Fait défiler la sortie d'une page vers le bas."

#. Scroll the output by one page up.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageUp"
msgstr "Fait défiler la sortie d'une page vers le haut."

#. Scroll the output to the bottom.
msgctxt "action documentation"
msgid "agent::ScrollOutputToBottom"
msgstr "Fait défiler la sortie jusqu'en bas."

#. Scroll the output to the next user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToNextMessage"
msgstr "Fait défiler la sortie jusqu'au message utilisateur suivant."

#. Scroll the output to the previous user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToPreviousMessage"
msgstr "Fait défiler la sortie jusqu'au message utilisateur précédent."

#. Scroll the output to the top.
msgctxt "action documentation"
msgid "agent::ScrollOutputToTop"
msgstr "Fait défiler la sortie jusqu'en haut."

#. Selects the agent used for new threads in the agent panel, without
#. opening the panel. The selected agent is launched the next time the
#. panel is opened.
msgctxt "action documentation"
msgid "agent::SelectAgent"
msgstr "Sélectionne l'agent utilisé pour les nouvelles conversations dans le panneau de l'agent, sans\nouvrir le panneau. L'agent sélectionné est lancé lors de la prochaine ouverture du\npanneau."

#. Selects the next thread search match.
msgctxt "action documentation"
msgid "agent::SelectNextThreadMatch"
msgstr "Sélectionne la correspondance suivante dans la recherche de conversation."

#. Action to select a permission granularity option from the dropdown.
#. This updates the selected granularity without triggering authorization.
msgctxt "action documentation"
msgid "agent::SelectPermissionGranularity"
msgstr "Action pour sélectionner une option de granularité d'autorisation dans la liste déroulante.\nCeci met à jour la granularité sélectionnée sans déclencher d'autorisation."

#. Selects the previous thread search match.
msgctxt "action documentation"
msgid "agent::SelectPreviousThreadMatch"
msgstr "Sélectionne la correspondance précédente dans la recherche de conversation."

#. Interrupts the current generation and sends the message immediately.
msgctxt "action documentation"
msgid "agent::SendImmediately"
msgstr "Interrompt la génération en cours et envoie le message immédiatement."

#. Sends the next queued message immediately.
msgctxt "action documentation"
msgid "agent::SendNextQueuedMessage"
msgstr "Envoie immédiatement le prochain message en file d'attente."

#. Opens a small window over the workspace that sets up a language model
#. provider in place (its consent, key or sign-in), and then starts a
#. thread on it.
msgctxt "action documentation"
msgid "agent::SetUpLanguageModelProvider"
msgstr "Ouvre une petite fenêtre au-dessus de l'espace de travail pour configurer sur place un fournisseur de LLM (consentement, clé ou connexion), puis démarre une conversation avec ce fournisseur."

#. Toggles the agent panel.
msgctxt "action documentation"
msgid "agent::Toggle"
msgstr "Affiche ou masque le panneau de l'agent."

#. Switches `agent.tool_permissions.default` between "confirm" and
#. "allow", so every tool action can be auto-approved without a prompt.
#. From "auto" (the AI judge) it also switches back to "confirm", so
#. the shortcut always leads out of an unattended mode.
msgctxt "action documentation"
msgid "agent::ToggleAutoApproveToolActions"
msgstr "Bascule `agent.tool_permissions.default` entre \"confirm\" et \"allow\", afin que chaque action d'outil puisse être approuvée automatiquement sans demande de confirmation. Depuis \"auto\" (l'IA décide), revient aussi à \"confirm\" : le raccourci fait donc toujours sortir d'un mode sans surveillance."

#. Action to toggle a command pattern checkbox in the permission dropdown.
msgctxt "action documentation"
msgid "agent::ToggleCommandPattern"
msgstr "Action pour cocher ou décocher une case de motif de commande dans le menu déroulant des autorisations."

#. Toggles fast mode for models that support it.
msgctxt "action documentation"
msgid "agent::ToggleFastMode"
msgstr "Active ou désactive le mode rapide pour les modèles qui le prennent en charge."

#. Toggles the language model selector dropdown.
msgctxt "action documentation"
msgid "agent::ToggleModelSelector"
msgstr "Affiche ou masque le menu déroulant de sélection du modèle de langage."

#. Toggles the menu to create new agent threads.
msgctxt "action documentation"
msgid "agent::ToggleNewThreadMenu"
msgstr "Ouvre ou ferme le menu de création de nouvelles conversations de l'agent."

#. Toggles the options menu for agent settings and preferences.
msgctxt "action documentation"
msgid "agent::ToggleOptionsMenu"
msgstr "Ouvre ou ferme le menu d'options des paramètres et préférences de l'agent."

#. Toggles the tab bar of the agent panel's own pane.
msgctxt "action documentation"
msgid "agent::TogglePanelTabBar"
msgstr "Affiche ou masque la barre d'onglets du volet propre au panneau de l'agent."

#. Toggles the thread history list shown inside the agent panel.
msgctxt "action documentation"
msgid "agent::TogglePanelThreadHistory"
msgstr "Affiche ou masque la liste de l'historique des conversations dans le panneau de l'agent."

#. Toggles the profile or mode selector for switching between agent profiles.
msgctxt "action documentation"
msgid "agent::ToggleProfileSelector"
msgstr "Ouvre ou ferme le sélecteur de profil ou de mode permettant de basculer entre les profils de l'agent."

#. Toggles in-thread search over the current agent thread's contents.
msgctxt "action documentation"
msgid "agent::ToggleSearch"
msgstr "Active ou désactive la recherche dans le contenu de la conversation de l'agent en cours."

#. Toggles steering for the first queued message: when on, it interrupts
#. the agent at its next step instead of waiting for it to finish.
msgctxt "action documentation"
msgid "agent::ToggleSteerFirstQueuedMessage"
msgstr "Active ou désactive l'orientation du premier message en file d'attente : lorsqu'elle est activée, elle interrompt\nl'agent à son étape suivante au lieu d'attendre qu'il termine."

#. Toggles the thinking effort selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleThinkingEffortMenu"
msgstr "Ouvre ou ferme le menu de sélection du niveau d'effort de réflexion."

#. Toggles thinking mode for models that support extended thinking.
msgctxt "action documentation"
msgid "agent::ToggleThinkingMode"
msgstr "Active ou désactive le mode réflexion pour les modèles qui prennent en charge la réflexion étendue."

#. Toggles the tool permission mode selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleToolPermissionSelector"
msgstr "Ouvre ou ferme le menu de sélection du mode d'autorisation des outils."

#. Undoes the most recent reject operation, restoring the rejected changes.
msgctxt "action documentation"
msgid "agent::UndoLastReject"
msgstr "Annule la dernière opération de rejet, en restaurant les modifications rejetées."

#. Moves focus to the sidebar's search/filter editor.
msgctxt "action documentation"
msgid "agents_sidebar::FocusSidebarFilter"
msgstr "Déplace le focus vers l'éditeur de recherche/filtre de la barre latérale."

#. Creates a new thread in the currently selected or active project group.
msgctxt "action documentation"
msgid "agents_sidebar::NewThreadInGroup"
msgstr "Crée une nouvelle conversation dans le groupe de projets actuellement sélectionné ou actif."

#. Toggles between the thread list and the thread history.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadHistory"
msgstr "Bascule entre la liste des conversations et l'historique des conversations."

#. Toggles the thread switcher popup when the sidebar is focused.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadSwitcher"
msgstr "Affiche ou masque la fenêtre contextuelle de changement de conversation lorsque la barre latérale a le focus."

#. Toggles the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::Toggle"
msgstr "Affiche ou masque le panneau Navigateur IA, où les agents IA ouvrent les onglets de navigateur qu'ils pilotent."

#. Toggles focus on the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::ToggleFocus"
msgstr "Bascule le focus sur le panneau Navigateur IA, où les agents IA ouvrent les onglets de navigateur qu'ils pilotent."

#. Activates the menu on the left in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuLeft"
msgstr "Active le menu à gauche dans le menu d'application côté client.\n\nNe s'applique pas aux barres de menus de la plateforme (p. ex. sur macOS)."

#. Activates the menu on the right in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuRight"
msgstr "Active le menu à droite dans le menu d'application côté client.\n\nNe s'applique pas aux barres de menus de la plateforme (p. ex. sur macOS)."

#. Opens the named menu in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::OpenApplicationMenu"
msgstr "Ouvre le menu indiqué dans le menu d'application côté client.\n\nNe s'applique pas aux barres de menus de la plateforme (p. ex. sur macOS)."

#. Deploys the assistant interface with the specified configuration.
msgctxt "action documentation"
msgid "assistant::InlineAssist"
msgstr "Ouvre l'interface de l'assistant avec la configuration spécifiée."

#. Checks for available updates.
msgctxt "action documentation"
msgid "auto_update::Check"
msgstr "Recherche les mises à jour disponibles."

#. Dismisses the update error message.
msgctxt "action documentation"
msgid "auto_update::DismissMessage"
msgstr "Ferme le message d'erreur de mise à jour."

#. Opens the release notes for the current version in a browser.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotes"
msgstr "Ouvre les notes de version de la version actuelle dans un navigateur."

#. Opens the release notes for the current version in a new tab.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotesLocally"
msgstr "Ouvre les notes de version de la version actuelle dans un nouvel onglet."

#. Cycle through branch filters.
msgctxt "action documentation"
msgid "branch_picker::CycleBranchFilter"
msgstr "Parcourt les filtres de branche."

#. Deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::DeleteBranch"
msgstr "Supprime la branche Git sélectionnée, qu'elle soit locale ou distante."

#. Force deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::ForceDeleteBranch"
msgstr "Force la suppression de la branche Git sélectionnée, qu'elle soit locale ou distante."

#. Show all branches.
msgctxt "action documentation"
msgid "branch_picker::ShowAllBranches"
msgstr "Affiche toutes les branches."

#. Show only local branches.
msgctxt "action documentation"
msgid "branch_picker::ShowLocalBranches"
msgstr "Affiche uniquement les branches locales."

#. Show only remote branches.
msgctxt "action documentation"
msgid "branch_picker::ShowRemoteBranches"
msgstr "Affiche uniquement les branches distantes."

#. Toggles the branch filter menu.
msgctxt "action documentation"
msgid "branch_picker::ToggleFilterMenu"
msgstr "Ouvre ou ferme le menu des filtres de branches."

#. Adds the current page to the bookmarks.
msgctxt "action documentation"
msgid "browser_panel::AddBookmark"
msgstr "Ajoute la page actuelle aux signets."

#. Asks Copilot about the selected text.
msgctxt "action documentation"
msgid "browser_panel::AskCopilot"
msgstr "Interroge Copilot sur le texte sélectionné."

#. Closes the current tab of the browser panel.
msgctxt "action documentation"
msgid "browser_panel::ClosePanelTab"
msgstr "Ferme l'onglet actuel du panneau Navigateur."

#. Moves focus to the address bar.
msgctxt "action documentation"
msgid "browser_panel::FocusAddressBar"
msgstr "Place le focus sur la barre d'adresse."

#. Moves focus to the next pane of the split browser panel.
msgctxt "action documentation"
msgid "browser_panel::FocusNextPaneGroup"
msgstr "Place le focus sur le volet suivant du panneau Navigateur fractionné."

#. Opens the URL set as the home page.
msgctxt "action documentation"
msgid "browser_panel::GoHome"
msgstr "Ouvre l'URL définie comme page d'accueil."

#. Goes back to the previous page.
msgctxt "action documentation"
msgid "browser_panel::NavigateBack"
msgstr "Revient à la page précédente."

#. Goes forward to the next page.
msgctxt "action documentation"
msgid "browser_panel::NavigateForward"
msgstr "Passe à la page suivante."

#. Opens a new AI tab in the AI browser panel: a tab with its own browser profile that AI agents can drive, with its traffic limited to the network allowlist.
msgctxt "action documentation"
msgid "browser_panel::NewAiTab"
msgstr "Ouvre un nouvel onglet IA dans le panneau Navigateur IA : un onglet doté de son propre profil de navigateur, que les agents IA peuvent piloter, et dont le trafic est limité à la liste d'autorisation réseau."

#. Opens a new browser tab in the editor area.
msgctxt "action documentation"
msgid "browser_panel::NewBrowserTab"
msgstr "Ouvre un nouvel onglet de navigateur dans la zone d'édition."

#. Opens a new tab in the browser panel.
msgctxt "action documentation"
msgid "browser_panel::NewPanelTab"
msgstr "Ouvre un nouvel onglet dans le panneau Navigateur."

#. Opens the developer tools of the current browser tab.
msgctxt "action documentation"
msgid "browser_panel::OpenDeveloperTools"
msgstr "Ouvre les outils de développement de l'onglet de navigateur actuel."

#. Moves the page open in the browser panel to a tab in the editor area.
msgctxt "action documentation"
msgid "browser_panel::OpenInCenter"
msgstr "Déplace la page ouverte dans le panneau Navigateur vers un onglet de la zone d'édition."

#. Opens the current page in the system's default browser.
msgctxt "action documentation"
msgid "browser_panel::OpenInExternalBrowser"
msgstr "Ouvre la page actuelle dans le navigateur par défaut du système."

#. Reloads the current page.
msgctxt "action documentation"
msgid "browser_panel::Reload"
msgstr "Recharge la page actuelle."

#. Lets AI agents drive the current AI tab again after it was stopped.
msgctxt "action documentation"
msgid "browser_panel::ResumeAiControl"
msgstr "Permet de nouveau aux agents IA de piloter l'onglet IA actuel après son arrêt."

#. Searches the web for the selected text.
msgctxt "action documentation"
msgid "browser_panel::SearchSelection"
msgstr "Recherche le texte sélectionné sur le Web."

#. Makes the current page the page opened at startup (browser.home_url).
msgctxt "action documentation"
msgid "browser_panel::SetAsHomePage"
msgstr "Définit la page actuelle comme page ouverte au démarrage (browser.home_url)."

#. Moves the current tab to the right, splitting the browser panel in two.
msgctxt "action documentation"
msgid "browser_panel::SplitPanelRight"
msgstr "Déplace l'onglet actuel vers la droite, en fractionnant le panneau Navigateur en deux."

#. Stops AI control of the current AI tab: the running command is cancelled and further commands are refused until it is resumed.
msgctxt "action documentation"
msgid "browser_panel::StopAiControl"
msgstr "Arrête le pilotage par l'IA de l'onglet IA actuel : la commande en cours est annulée et les commandes suivantes sont refusées jusqu'à la reprise."

#. Opens the URL or the search terms typed in the address bar.
msgctxt "action documentation"
msgid "browser_panel::SubmitAddress"
msgstr "Ouvre l'URL ou les termes de recherche saisis dans la barre d'adresse."

#. Toggles the built-in browser panel.
msgctxt "action documentation"
msgid "browser_panel::Toggle"
msgstr "Affiche ou masque le panneau Navigateur intégré."

#. Shows or hides the list of bookmarks.
msgctxt "action documentation"
msgid "browser_panel::ToggleBookmarks"
msgstr "Affiche ou masque la liste des signets."

#. Toggles focus on the built-in browser panel.
msgctxt "action documentation"
msgid "browser_panel::ToggleFocus"
msgstr "Bascule le focus sur le panneau Navigateur intégré."

#. Opens the buffer search interface with the specified configuration.
msgctxt "action documentation"
msgid "buffer_search::Deploy"
msgstr "Ouvre l'interface de recherche dans le tampon avec la configuration spécifiée."

#. Deploys the search and replace interface.
msgctxt "action documentation"
msgid "buffer_search::DeployReplace"
msgstr "Ouvre l'interface de recherche et de remplacement."

#. Dismisses the search bar.
msgctxt "action documentation"
msgid "buffer_search::Dismiss"
msgstr "Ferme la barre de recherche."

#. Focuses back on the editor.
msgctxt "action documentation"
msgid "buffer_search::FocusEditor"
msgstr "Redonne le focus à l'éditeur."

#. Sets the search query from the selection or word under cursor.
msgctxt "action documentation"
msgid "buffer_search::UseSelectionForFind"
msgstr "Définit la requête de recherche à partir de la sélection ou du mot sous le curseur."

#. Collapses every function under the root.
msgctxt "action documentation"
msgid "call_graph_panel::CollapseAll"
msgstr "Réduit toutes les fonctions sous la racine."

#. Collapses the selected function, or moves to its parent.
msgctxt "action documentation"
msgid "call_graph_panel::CollapseSelected"
msgstr "Réduit la fonction sélectionnée ou passe à son parent."

#. Copies the name of the selected function.
msgctxt "action documentation"
msgid "call_graph_panel::CopySymbolName"
msgstr "Copie le nom de la fonction sélectionnée."

#. Expands the selected function, or moves into its first child.
msgctxt "action documentation"
msgid "call_graph_panel::ExpandSelected"
msgstr "Développe la fonction sélectionnée ou passe à son premier enfant."

#. Makes the function under the editor's cursor the root.
msgctxt "action documentation"
msgid "call_graph_panel::InspectCursor"
msgstr "Définit comme racine la fonction située sous le curseur de l'éditeur."

#. Goes forward to the next root.
msgctxt "action documentation"
msgid "call_graph_panel::NextRoot"
msgstr "Passe à la racine suivante."

#. Opens the selected call in the editor. Repeating it on a row with
#. several calls goes to the next one.
msgctxt "action documentation"
msgid "call_graph_panel::OpenSelected"
msgstr "Ouvre l'appel sélectionné dans l'éditeur. Répéter l'action sur une ligne comportant plusieurs appels passe à l'appel suivant."

#. Shows the selected call in the editor, keeping focus in the panel.
msgctxt "action documentation"
msgid "call_graph_panel::PreviewSelected"
msgstr "Affiche l'appel sélectionné dans l'éditeur en gardant le focus dans le panneau."

#. Goes back to the previous root.
msgctxt "action documentation"
msgid "call_graph_panel::PreviousRoot"
msgstr "Revient à la racine précédente."

#. Asks again for everything shown, keeping the root.
msgctxt "action documentation"
msgid "call_graph_panel::Refresh"
msgstr "Redemande tout le contenu affiché, en conservant la racine."

#. Opens the call graph panel with the callees of the function under the cursor.
msgctxt "action documentation"
msgid "call_graph_panel::ShowCallees"
msgstr "Ouvre le panneau Graphe des appels avec les fonctions appelées par la fonction située sous le curseur."

#. Opens the call graph panel with the callers of the function under the cursor.
msgctxt "action documentation"
msgid "call_graph_panel::ShowCallers"
msgstr "Ouvre le panneau Graphe des appels avec les fonctions qui appellent la fonction située sous le curseur."

#. Toggles the call graph panel.
msgctxt "action documentation"
msgid "call_graph_panel::Toggle"
msgstr "Affiche ou masque le panneau Graphe des appels."

#. Switches between showing callers and callees of the root.
msgctxt "action documentation"
msgid "call_graph_panel::ToggleDirection"
msgstr "Bascule entre l'affichage des appelants et celui des appelés de la racine."

#. Toggles focus on the call graph panel.
msgctxt "action documentation"
msgid "call_graph_panel::ToggleFocus"
msgstr "Bascule le focus sur le panneau Graphe des appels."

#. Toggles whether the root follows the editor's cursor.
msgctxt "action documentation"
msgid "call_graph_panel::ToggleFollowCursor"
msgstr "Active ou désactive le suivi du curseur de l'éditeur par la racine."

#. Registers this application's URL scheme handler.
msgctxt "action documentation"
msgid "cli::RegisterZedScheme"
msgstr "Enregistre le gestionnaire de schéma d'URL de cette application."

#. Reconnects to the collaboration server.
msgctxt "action documentation"
msgid "client::Reconnect"
msgstr "Se reconnecte au serveur de collaboration."

#. Signs in to Zed account.
msgctxt "action documentation"
msgid "client::SignIn"
msgstr "Se connecte au compte Zed."

#. Signs out of Zed account.
msgctxt "action documentation"
msgid "client::SignOut"
msgstr "Se déconnecte du compte Zed."

#. Copies the current room name and session id for debugging purposes.
msgctxt "action documentation"
msgid "collab::CopyRoomId"
msgstr "Copie le nom de la salle et l'identifiant de session à des fins de débogage."

#. Deafens yourself (mute both microphone and speakers).
msgctxt "action documentation"
msgid "collab::Deafen"
msgstr "Vous coupe le son (microphone et haut-parleurs)."

#. Leaves the current call.
msgctxt "action documentation"
msgid "collab::LeaveCall"
msgstr "Quitte l'appel vocal en cours."

#. Mutes your microphone.
msgctxt "action documentation"
msgid "collab::Mute"
msgstr "Coupe votre microphone."

#. Opens the channel notes for the current call.
#.
#. Use `collab_panel::OpenSelectedChannelNotes` to open the channel notes for the selected
#. channel in the collab panel.
#.
#. If you want to open a specific channel, use `zed::OpenZedUrl` with a channel notes URL -
#. can be copied via "Copy link to section" in the context menu of the channel notes
#. buffer. These URLs look like `https://zed.dev/channel/channel-name-CHANNEL_ID/notes`.
msgctxt "action documentation"
msgid "collab::OpenChannelNotes"
msgstr "Ouvre les notes du canal pour l'appel vocal en cours.\n\nUtilisez `collab_panel::OpenSelectedChannelNotes` pour ouvrir les notes du canal sélectionné\ndans le panneau de collaboration.\n\nPour ouvrir un canal spécifique, utilisez `zed::OpenZedUrl` avec une URL de notes de canal -\nqui peut être copiée via \"Copy Link to Section\" dans le menu contextuel du\ntampon des notes du canal. Ces URL ressemblent à `https://zed.dev/channel/channel-name-CHANNEL_ID/notes`."

#. Opens the channel notes for a specific channel by its ID.
msgctxt "action documentation"
msgid "collab::OpenChannelNotesById"
msgstr "Ouvre les notes du canal pour un canal spécifique par son identifiant."

#. Shares your screen with collaborators.
msgctxt "action documentation"
msgid "collab::ScreenShare"
msgstr "Partage votre écran avec les collaborateurs."

#. Shares the current project with collaborators.
msgctxt "action documentation"
msgid "collab::ShareProject"
msgstr "Partage le projet courant avec les collaborateurs."

#. Show call diagnostics and connection quality statistics.
msgctxt "action documentation"
msgid "collab::ShowCallStats"
msgstr "Affiche les diagnostics d'appel vocal et les statistiques de qualité de connexion."

#. A debug action to simulate an update being available to test the update banner UI.
msgctxt "action documentation"
msgid "collab::SimulateUpdateAvailable"
msgstr "Action de débogage permettant de simuler la disponibilité d'une mise à jour pour tester la bannière de mise à jour."

#. Switches to a different git branch.
msgctxt "action documentation"
msgid "collab::SwitchBranch"
msgstr "Passe à une autre branche Git."

#. Toggles the project menu dropdown.
msgctxt "action documentation"
msgid "collab::ToggleProjectMenu"
msgstr "Affiche ou masque le menu déroulant du projet."

#. Toggles the user menu dropdown.
msgctxt "action documentation"
msgid "collab::ToggleUserMenu"
msgstr "Affiche ou masque le menu déroulant de l'utilisateur."

#. Toggles the command palette.
msgctxt "action documentation"
msgid "command_palette::Toggle"
msgstr "Affiche ou masque la palette de commandes."

#. Adds an expression to the watch list.
msgctxt "action documentation"
msgid "console::WatchExpression"
msgstr "Ajoute une expression à la liste des espions."

#. Restarts the context server.
msgctxt "action documentation"
msgid "context_server::Restart"
msgstr "Redémarre le serveur de contexte."

#. Reinstalls the Copilot Edit Predictions language server.
msgctxt "action documentation"
msgid "copilot_edit_predictions::Reinstall"
msgstr "Réinstalle le serveur de langage Copilot Edit Predictions."

#. Toggles the debug panel.
msgctxt "action documentation"
msgid "debug_panel::Toggle"
msgstr "Affiche ou masque le panneau de débogage."

#. Toggles focus on the debug panel.
msgctxt "action documentation"
msgid "debug_panel::ToggleFocus"
msgstr "Bascule le focus sur le panneau de débogage."

#. Clears all breakpoints in the project.
msgctxt "action documentation"
msgid "debugger::ClearAllBreakpoints"
msgstr "Efface tous les points d'arrêt du projet."

#. Continues all threads until the next breakpoint.
msgctxt "action documentation"
msgid "debugger::Continue"
msgstr "Reprend l'exécution de tous les threads jusqu'au prochain point d'arrêt."

#. Continues the selected thread until the next breakpoint.
msgctxt "action documentation"
msgid "debugger::ContinueThread"
msgstr "Reprend l'exécution du thread sélectionné jusqu'au prochain point d'arrêt."

#. Detaches the debugger from the running process.
msgctxt "action documentation"
msgid "debugger::Detach"
msgstr "Détache le débogueur du processus en cours d'exécution."

#. Evaluates the selected text in the debugger context.
msgctxt "action documentation"
msgid "debugger::EvaluateSelectedText"
msgstr "Évalue le texte sélectionné dans le contexte du débogueur."

#. Focuses on the breakpoint list panel.
msgctxt "action documentation"
msgid "debugger::FocusBreakpointList"
msgstr "Donne le focus au panneau de liste des points d'arrêt."

#. Focuses on the debugger console panel.
msgctxt "action documentation"
msgid "debugger::FocusConsole"
msgstr "Donne le focus au panneau de la console du débogueur."

#. Focuses on the call stack frames panel.
msgctxt "action documentation"
msgid "debugger::FocusFrames"
msgstr "Donne le focus au panneau des frames de la pile des appels."

#. Focuses on the loaded sources panel.
msgctxt "action documentation"
msgid "debugger::FocusLoadedSources"
msgstr "Donne le focus au panneau des sources chargées."

#. Focuses on the loaded modules panel.
msgctxt "action documentation"
msgid "debugger::FocusModules"
msgstr "Donne le focus au panneau des modules chargés."

#. Focuses on the terminal panel.
msgctxt "action documentation"
msgid "debugger::FocusTerminal"
msgstr "Donne le focus au panneau du terminal."

#. Focuses on the variables panel.
msgctxt "action documentation"
msgid "debugger::FocusVariables"
msgstr "Donne le focus au panneau des variables."

#. Navigates to the next breakpoint property in the list.
msgctxt "action documentation"
msgid "debugger::NextBreakpointProperty"
msgstr "Navigue vers la propriété de point d'arrêt suivante dans la liste."

#. Opens the project debug tasks configuration.
msgctxt "action documentation"
msgid "debugger::OpenProjectDebugTasks"
msgstr "Ouvre la configuration des tâches de débogage du projet."

#. Pauses the currently running program.
msgctxt "action documentation"
msgid "debugger::Pause"
msgstr "Suspend le programme en cours d'exécution."

#. Navigates to the previous breakpoint property in the list.
msgctxt "action documentation"
msgid "debugger::PreviousBreakpointProperty"
msgstr "Navigue vers la propriété de point d'arrêt précédente dans la liste."

#. Reruns the last debugging session.
msgctxt "action documentation"
msgid "debugger::Rerun"
msgstr "Réexécute la dernière session de débogage."

#. Reruns the current debugging session with the same configuration.
msgctxt "action documentation"
msgid "debugger::RerunSession"
msgstr "Réexécute la session de débogage en cours avec la même configuration."

#. Restarts the current debugging session.
msgctxt "action documentation"
msgid "debugger::Restart"
msgstr "Redémarre la session de débogage en cours."

#. Runs program execution to the current cursor position.
msgctxt "action documentation"
msgid "debugger::RunToCursor"
msgstr "Exécute le programme jusqu'à la position actuelle du curseur."

#. Starts a new debugging session.
msgctxt "action documentation"
msgid "debugger::Start"
msgstr "Lance une nouvelle session de débogage."

#. Steps back to the previous statement.
msgctxt "action documentation"
msgid "debugger::StepBack"
msgstr "Revient à l'instruction précédente."

#. Steps into the next function call.
msgctxt "action documentation"
msgid "debugger::StepInto"
msgstr "Entre dans le prochain appel de fonction."

#. Steps out of the current function.
msgctxt "action documentation"
msgid "debugger::StepOut"
msgstr "Sort de la fonction actuelle."

#. Steps over the current line.
msgctxt "action documentation"
msgid "debugger::StepOver"
msgstr "Exécute la ligne courante sans entrer dans les appels de fonction."

#. Stops the debugging session.
msgctxt "action documentation"
msgid "debugger::Stop"
msgstr "Arrête la session de débogage."

#. Set a data breakpoint on the selected variable or memory region.
msgctxt "action documentation"
msgid "debugger::ToggleDataBreakpoint"
msgstr "Définit un point d'arrêt de données pour la variable ou la région mémoire sélectionnée."

#. Toggles the enabled state of a breakpoint.
msgctxt "action documentation"
msgid "debugger::ToggleEnableBreakpoint"
msgstr "Active ou désactive un point d'arrêt."

#. Toggles expansion of the selected item in the debugger UI.
msgctxt "action documentation"
msgid "debugger::ToggleExpandItem"
msgstr "Développe ou réduit l'élément sélectionné dans l'interface du débogueur."

#. Toggles whether to ignore all breakpoints.
msgctxt "action documentation"
msgid "debugger::ToggleIgnoreBreakpoints"
msgstr "Active ou désactive l'option pour ignorer tous les points d'arrêt."

#. Toggles the session picker dropdown.
msgctxt "action documentation"
msgid "debugger::ToggleSessionPicker"
msgstr "Ouvre ou ferme le menu déroulant de sélection de session."

#. Toggles the thread picker dropdown.
msgctxt "action documentation"
msgid "debugger::ToggleThreadPicker"
msgstr "Ouvre ou ferme le menu déroulant de sélection de thread."

#. Toggle the user frame filter in the stack frame list
#. When toggled on, only frames from the user's code are shown
#. When toggled off, all frames are shown
msgctxt "action documentation"
msgid "debugger::ToggleUserFrames"
msgstr "Active ou désactive le filtre des frames utilisateur dans la liste des frames de pile.\nLorsque cette option est activée, seuls les frames du code utilisateur sont affichés.\nLorsque cette option est désactivée, tous les frames sont affichés."

#. Removes a breakpoint.
msgctxt "action documentation"
msgid "debugger::UnsetBreakpoint"
msgstr "Supprime un point d'arrêt."

#. Copies the current accessibility tree to the clipboard as JSON,
#. without opening a buffer. See [`DumpAccessibilityTree`].
msgctxt "action documentation"
msgid "dev::CopyAccessibilityTree"
msgstr "Copie l'arbre d'accessibilité actuel dans le presse-papiers au format JSON,\nsans ouvrir de tampon. Voir [`DumpAccessibilityTree`]."

#. Copies debug adapter launch arguments to clipboard.
msgctxt "action documentation"
msgid "dev::CopyDebugAdapterArguments"
msgstr "Copie les arguments de lancement de l'adaptateur de débogage dans le presse-papiers."

#. Open an app-wide recording of raw local filesystem watcher events.
msgctxt "action documentation"
msgid "dev::DebugFilesystemWatching"
msgstr "Ouvre un enregistrement, à l'échelle de l'application, des événements bruts de surveillance du système de fichiers local."

#. Dumps the current accessibility tree (the last update sent to the
#. platform adapter) to a new buffer as JSON, for debugging what is
#. exposed to assistive technology.
msgctxt "action documentation"
msgid "dev::DumpAccessibilityTree"
msgstr "Exporte l'arbre d'accessibilité actuel (la dernière mise à jour envoyée à\nl'adaptateur de la plateforme) dans un nouveau tampon au format JSON, pour déboguer ce qui est\nexposé aux technologies d'assistance."

#. Opens a buffer showing the input-to-frame latency histogram for the current window.
msgctxt "action documentation"
msgid "dev::DumpInputLatencyHistogram"
msgstr "Ouvre un tampon affichant l'histogramme de latence d'entrée à l'image pour la fenêtre active."

#. Dumps multi-workspace state (projects, worktrees, active threads) into a new buffer.
msgctxt "action documentation"
msgid "dev::DumpWorkspaceInfo"
msgstr "Exporte l'état multi-espace de travail (projets, arborescences de travail, conversations actives) dans un nouveau tampon."

#. Go to the previous context retrieval run
msgctxt "action documentation"
msgid "dev::EditPredictionContextGoBack"
msgstr "Accède à l'exécution de récupération de contexte précédente."

#. Go to the next context retrieval run
msgctxt "action documentation"
msgid "dev::EditPredictionContextGoForward"
msgstr "Accède à l'exécution de récupération de contexte suivante."

#. Causes a performance hang to test performance monitoring
msgctxt "action documentation"
msgid "dev::HangAction"
msgstr "Provoque un blocage pour tester la surveillance des performances"

#. Causes a performance hang to test performance monitoring
msgctxt "action documentation"
msgid "dev::HangBackground"
msgstr "Provoque un blocage pour tester la surveillance des performances"

#. Causes a performance hang to test performance monitoring
msgctxt "action documentation"
msgid "dev::HangForeground"
msgstr "Provoque un blocage pour tester la surveillance des performances"

#. Opens the debug adapter protocol logs viewer.
msgctxt "action documentation"
msgid "dev::OpenDebugAdapterLogs"
msgstr "Ouvre la visionneuse des journaux du protocole d'adaptateur de débogage."

#. Opens the edit prediction context view.
msgctxt "action documentation"
msgid "dev::OpenEditPredictionContextView"
msgstr "Ouvre la vue de contexte de prédiction de modification."

#. Opens the highlights tree view for the current file.
msgctxt "action documentation"
msgid "dev::OpenHighlightsTreeView"
msgstr "Ouvre la vue arborescente des surbrillances pour le fichier actuel."

#. Opens the key context view for debugging keybindings.
msgctxt "action documentation"
msgid "dev::OpenKeyContextView"
msgstr "Ouvre la vue de contexte des touches pour déboguer les combinaisons de touches."

#. Opens the language server protocol logs viewer.
msgctxt "action documentation"
msgid "dev::OpenLanguageServerLogs"
msgstr "Ouvre la visionneuse des journaux du protocole de serveur de langage."

#. Opens the syntax tree view for the current file.
msgctxt "action documentation"
msgid "dev::OpenSyntaxTreeView"
msgstr "Ouvre la vue arborescente de la syntaxe pour le fichier actuel."

#. Opens the theme preview window.
msgctxt "action documentation"
msgid "dev::OpenThemePreview"
msgstr "Ouvre la fenêtre d'aperçu du thème."

#. Opens a prompt to enter a URL to open.
msgctxt "action documentation"
msgid "dev::OpenUrlPrompt"
msgstr "Ouvre une fenêtre de saisie pour indiquer une URL à ouvrir."

#. Resets the debug frame-time overlay's statistics, except for the
#. total frame count.
msgctxt "action documentation"
msgid "dev::ResetFrameOverlayStats"
msgstr "Réinitialise les statistiques de la superposition de débogage du temps par image, à l'exception du\nnombre total d'images."

#. Shows metadata for all threads in the sidebar.
msgctxt "action documentation"
msgid "dev::ShowAllSidebarThreadMetadata"
msgstr "Affiche les métadonnées de toutes les conversations dans la barre latérale."

#. Shows the current git job queue debug state for the active repository.
msgctxt "action documentation"
msgid "dev::ShowGitJobQueue"
msgstr "Affiche l'état de débogage actuel de la file des tâches Git pour le dépôt actif."

#. Shows metadata for the currently active thread.
msgctxt "action documentation"
msgid "dev::ShowThreadMetadata"
msgstr "Affiche les métadonnées de la conversation actuellement active."

#. Show an error on the workspace level.
msgctxt "action documentation"
msgid "dev::ShowWorkspaceError"
msgstr "Affiche une erreur au niveau de l'espace de travail."

#. Cycles the debug frame-time overlay between hidden, current
#. frame-time, and detailed frame-time statistics.
msgctxt "action documentation"
msgid "dev::ToggleFpsOverlay"
msgstr "Fait alterner la superposition de débogage du temps par image entre l'état masqué, le temps par image\nactuel et les statistiques détaillées du temps par image."

#. Toggles the developer inspector for debugging UI elements.
msgctxt "action documentation"
msgid "dev::ToggleInspector"
msgstr "Active ou désactive l'inspecteur développeur pour le débogage des éléments d'interface."

#. Opens the project diagnostics view.
msgctxt "action documentation"
msgid "diagnostics::Deploy"
msgstr "Ouvre la vue des diagnostics du projet."

#. Opens the project diagnostics view for the currently focused file.
msgctxt "action documentation"
msgid "diagnostics::DeployCurrentFile"
msgstr "Ouvre la vue des diagnostics du projet pour le fichier actif."

#. Toggles automatic refresh of diagnostics.
msgctxt "action documentation"
msgid "diagnostics::ToggleDiagnosticsRefresh"
msgstr "Active ou désactive l'actualisation automatique des diagnostics."

#. Toggles the display of warning-level diagnostics.
msgctxt "action documentation"
msgid "diagnostics::ToggleWarnings"
msgstr "Active ou désactive l'affichage des diagnostics de niveau avertissement."

#. Clears the edit prediction history.
msgctxt "action documentation"
msgid "edit_prediction::ClearHistory"
msgstr "Efface l'historique des prédictions de modification."

#. Opens the rate completions modal.
msgctxt "action documentation"
msgid "edit_prediction::RatePredictions"
msgstr "Ouvre la fenêtre modale d'évaluation des complétions."

#. Resets the edit prediction onboarding state.
msgctxt "action documentation"
msgid "edit_prediction::ResetOnboarding"
msgstr "Réinitialise l'état de prise en main de la prédiction de modification."

#. Toggles the edit prediction menu.
msgctxt "action documentation"
msgid "edit_prediction::ToggleMenu"
msgstr "Ouvre ou ferme le menu de prédiction de modification."

#. Accepts the full edit prediction.
msgctxt "action documentation"
msgid "editor::AcceptEditPrediction"
msgstr "Accepte la prédiction de modification complète."

#. Accepts a partial edit prediction.
msgctxt "action documentation"
msgid "editor::AcceptNextWordEditPrediction"
msgstr "Accepte une prédiction de modification partielle."

#. Adds a cursor above the current selection.
msgctxt "action documentation"
msgid "editor::AddSelectionAbove"
msgstr "Ajoute un curseur au-dessus de la sélection actuelle."

#. Adds a cursor below the current selection.
msgctxt "action documentation"
msgid "editor::AddSelectionBelow"
msgstr "Ajoute un curseur en dessous de la sélection actuelle."

#. Aligns selections from different rows into the same column
msgctxt "action documentation"
msgid "editor::AlignSelections"
msgstr "Aligne les sélections de différentes lignes sur la même colonne"

#. Applies all diff hunks in the editor.
msgctxt "action documentation"
msgid "editor::ApplyAllDiffHunks"
msgstr "Applique tous les blocs de modifications dans l'éditeur."

#. Applies the diff hunk at the current position.
msgctxt "action documentation"
msgid "editor::ApplyDiffHunk"
msgstr "Applique le bloc de modifications à la position actuelle."

#. Automatically adjusts indentation based on context.
msgctxt "action documentation"
msgid "editor::AutoIndent"
msgstr "Ajuste automatiquement l'indentation en fonction du contexte."

#. Deletes the character before the cursor.
msgctxt "action documentation"
msgid "editor::Backspace"
msgstr "Supprime le caractère avant le curseur."

#. Removes a tab character or outdents.
msgctxt "action documentation"
msgid "editor::Backtab"
msgstr "Supprime un caractère de tabulation ou réduit l'indentation."

#. Shows git blame information for the current line.
msgctxt "action documentation"
msgid "editor::BlameHover"
msgstr "Affiche les informations de blame Git pour la ligne actuelle."

#. Opens a blame of the file at the revision preceding the blame entry at cursor.
msgctxt "action documentation"
msgid "editor::BlamePreviousRevision"
msgstr "Ouvre le blame du fichier à la révision précédant l'entrée de blame sous le curseur."

#. Opens a blame of the file at the revision of the blame entry at cursor.
msgctxt "action documentation"
msgid "editor::BlameRevision"
msgstr "Ouvre le blame du fichier à la révision de l'entrée de blame sous le curseur."

#. Cancels the current operation.
msgctxt "action documentation"
msgid "editor::Cancel"
msgstr "Annule l'opération en cours."

#. Cancels an inline edit of a review comment.
msgctxt "action documentation"
msgid "editor::CancelEditReviewComment"
msgstr "Annule une modification en ligne d'un commentaire de revue."

#. Cancels the running flycheck operation.
msgctxt "action documentation"
msgid "editor::CancelFlycheck"
msgstr "Annule l'opération flycheck en cours."

#. Cancels pending language server work.
msgctxt "action documentation"
msgid "editor::CancelLanguageServerWork"
msgstr "Annule le travail en attente du serveur de langage."

#. Clears flycheck results.
msgctxt "action documentation"
msgid "editor::ClearFlycheck"
msgstr "Efface les résultats de flycheck."

#. Collapses all diff hunks in the editor.
msgctxt "action documentation"
msgid "editor::CollapseAllDiffHunks"
msgstr "Réduit tous les blocs de modifications dans l'éditeur."

#. Composes multiple completion suggestions into a single completion.
msgctxt "action documentation"
msgid "editor::ComposeCompletion"
msgstr "Compose plusieurs suggestions de complétion en une seule complétion."

#. Confirms and applies the currently selected code action.
msgctxt "action documentation"
msgid "editor::ConfirmCodeAction"
msgstr "Confirme et applique l'action de code actuellement sélectionnée."

#. Confirms and accepts the currently selected completion suggestion.
msgctxt "action documentation"
msgid "editor::ConfirmCompletion"
msgstr "Confirme et accepte la suggestion de complétion actuellement sélectionnée."

#. Confirms completion by inserting at cursor.
msgctxt "action documentation"
msgid "editor::ConfirmCompletionInsert"
msgstr "Confirme la complétion en l'insérant à la position du curseur."

#. Confirms completion by replacing existing text.
msgctxt "action documentation"
msgid "editor::ConfirmCompletionReplace"
msgstr "Confirme la complétion en remplaçant le texte existant."

#. Confirms an inline edit of a review comment.
msgctxt "action documentation"
msgid "editor::ConfirmEditReviewComment"
msgstr "Confirme une modification en ligne d'un commentaire de revue."

#. Confirms the rename operation.
msgctxt "action documentation"
msgid "editor::ConfirmRename"
msgstr "Confirme l'opération de renommage."

#. Navigates to the first item in the context menu.
msgctxt "action documentation"
msgid "editor::ContextMenuFirst"
msgstr "Navigue vers le premier élément du menu contextuel."

#. Navigates to the last item in the context menu.
msgctxt "action documentation"
msgid "editor::ContextMenuLast"
msgstr "Navigue vers le dernier élément du menu contextuel."

#. Navigates to the next item in the context menu.
msgctxt "action documentation"
msgid "editor::ContextMenuNext"
msgstr "Navigue vers l'élément suivant du menu contextuel."

#. Navigates to the previous item in the context menu.
msgctxt "action documentation"
msgid "editor::ContextMenuPrevious"
msgstr "Navigue vers l'élément précédent du menu contextuel."

#. Base64-decodes the selected text or word under cursor.
msgctxt "action documentation"
msgid "editor::ConvertFromBase64"
msgstr "Décode depuis Base64 le texte sélectionné ou le mot sous le curseur."

#. Converts indentation from tabs to spaces.
msgctxt "action documentation"
msgid "editor::ConvertIndentationToSpaces"
msgstr "Convertit l'indentation des tabulations en espaces."

#. Converts indentation from spaces to tabs.
msgctxt "action documentation"
msgid "editor::ConvertIndentationToTabs"
msgstr "Convertit l'indentation des espaces en tabulations."

#. Base64-encodes the selected text or word under cursor.
msgctxt "action documentation"
msgid "editor::ConvertToBase64"
msgstr "Encode en Base64 le texte sélectionné ou le mot sous le curseur."

#. Converts selected text to kebab-case.
msgctxt "action documentation"
msgid "editor::ConvertToKebabCase"
msgstr "Convertit le texte sélectionné en kebab-case."

#. Converts selected text to lowerCamelCase.
msgctxt "action documentation"
msgid "editor::ConvertToLowerCamelCase"
msgstr "Convertit le texte sélectionné en lowerCamelCase."

#. Converts selected text to lowercase.
msgctxt "action documentation"
msgid "editor::ConvertToLowerCase"
msgstr "Convertit le texte sélectionné en minuscules."

#. Toggles the case of selected text.
msgctxt "action documentation"
msgid "editor::ConvertToOppositeCase"
msgstr "Alterne la casse du texte sélectionné."

#. Applies ROT13 cipher to selected text.
msgctxt "action documentation"
msgid "editor::ConvertToRot13"
msgstr "Applique le chiffrement ROT13 au texte sélectionné."

#. Applies ROT47 cipher to selected text.
msgctxt "action documentation"
msgid "editor::ConvertToRot47"
msgstr "Applique le chiffrement ROT47 au texte sélectionné."

#. Converts selected text to sentence case.
msgctxt "action documentation"
msgid "editor::ConvertToSentenceCase"
msgstr "Convertit le texte sélectionné en casse de phrase."

#. Converts selected text to snake_case.
msgctxt "action documentation"
msgid "editor::ConvertToSnakeCase"
msgstr "Convertit le texte sélectionné en snake_case."

#. Converts selected text to Title Case.
msgctxt "action documentation"
msgid "editor::ConvertToTitleCase"
msgstr "Convertit le texte sélectionné en casse de titre."

#. Converts selected text to UpperCamelCase.
msgctxt "action documentation"
msgid "editor::ConvertToUpperCamelCase"
msgstr "Convertit le texte sélectionné en UpperCamelCase."

#. Converts selected text to UPPERCASE.
msgctxt "action documentation"
msgid "editor::ConvertToUpperCase"
msgstr "Convertit le texte sélectionné en MAJUSCULES."

#. Copies selected text to the clipboard.
msgctxt "action documentation"
msgid "editor::Copy"
msgstr "Copie le texte sélectionné dans le presse-papiers."

#. Copies selected text to the clipboard with leading/trailing whitespace trimmed.
msgctxt "action documentation"
msgid "editor::CopyAndTrim"
msgstr "Copie le texte sélectionné dans le presse-papiers en supprimant les espaces blancs au début et à la fin."

#. Copies the current file location to the clipboard.
msgctxt "action documentation"
msgid "editor::CopyFileLocation"
msgstr "Copie l'emplacement du fichier courant dans le presse-papiers."

#. Copies the current file name to the clipboard.
msgctxt "action documentation"
msgid "editor::CopyFileName"
msgstr "Copie le nom du fichier courant dans le presse-papiers."

#. Copies the file name without extension to the clipboard.
msgctxt "action documentation"
msgid "editor::CopyFileNameWithoutExtension"
msgstr "Copie le nom du fichier sans extension de fichier dans le presse-papiers."

#. Copies the highlighted text as JSON.
msgctxt "action documentation"
msgid "editor::CopyHighlightJson"
msgstr "Copie le texte sélectionné au format JSON."

#. Copies a permalink to the current line or selection.
msgctxt "action documentation"
msgid "editor::CopyPermalinkToLine"
msgstr "Copie un lien permanent vers la ligne actuelle ou la sélection."

#. Cuts selected text to the clipboard.
msgctxt "action documentation"
msgid "editor::Cut"
msgstr "Coupe le texte sélectionné dans le presse-papiers."

#. Cuts from cursor to end of line.
msgctxt "action documentation"
msgid "editor::CutToEndOfLine"
msgstr "Coupe du curseur à la fin de la ligne."

#. Deletes the character after the cursor.
msgctxt "action documentation"
msgid "editor::Delete"
msgstr "Supprime le caractère après le curseur."

#. Deletes the current line.
msgctxt "action documentation"
msgid "editor::DeleteLine"
msgstr "Supprime la ligne courante."

#. Deletes a stored review comment.
msgctxt "action documentation"
msgid "editor::DeleteReviewComment"
msgstr "Supprime un commentaire de revue enregistré."

#. Deletes from the cursor to the beginning of the current line.
msgctxt "action documentation"
msgid "editor::DeleteToBeginningOfLine"
msgstr "Supprime du curseur jusqu'au début de la ligne courante."

#. Deletes from cursor to end of line.
msgctxt "action documentation"
msgid "editor::DeleteToEndOfLine"
msgstr "Supprime du curseur jusqu'à la fin de la ligne."

#. Deletes from the cursor to the end of the next subword.
#. Stops before the end of the next subword, if whitespace sequences of length >= 2 are encountered.
msgctxt "action documentation"
msgid "editor::DeleteToNextSubwordEnd"
msgstr "Supprime du curseur jusqu'à la fin du sous-mot suivant.\nS'arrête avant la fin du prochain sous-mot si des séquences d'espaces blancs de longueur >= 2 sont rencontrées."

#. Deletes from the cursor to the end of the next word.
#. Stops before the end of the next word, if whitespace sequences of length >= 2 are encountered.
msgctxt "action documentation"
msgid "editor::DeleteToNextWordEnd"
msgstr "Supprime du curseur jusqu'à la fin du mot suivant.\nS'arrête avant la fin du prochain mot si des séquences d'espaces blancs de longueur >= 2 sont rencontrées."

#. Deletes from the cursor to the start of the previous subword.
#. Stops before the start of the previous subword, if whitespace sequences of length >= 2 are encountered.
msgctxt "action documentation"
msgid "editor::DeleteToPreviousSubwordStart"
msgstr "Supprime du curseur jusqu'au début du sous-mot précédent.\nS'arrête avant le début du sous-mot précédent si des séquences d'espaces blancs de longueur >= 2 sont rencontrées."

#. Deletes from the cursor to the start of the previous word.
#. Stops before the start of the previous word, if whitespace sequences of length >= 2 are encountered.
msgctxt "action documentation"
msgid "editor::DeleteToPreviousWordStart"
msgstr "Supprime du curseur jusqu'au début du mot précédent.\nS'arrête avant le début du mot précédent si des séquences d'espaces blancs de longueur >= 2 sont rencontrées."

#. Diffs the text stored in the clipboard against the current selection.
msgctxt "action documentation"
msgid "editor::DiffClipboardWithSelection"
msgstr "Compare le texte du presse-papiers avec la sélection courante."

#. Disables the breakpoint at the current line.
msgctxt "action documentation"
msgid "editor::DisableBreakpoint"
msgstr "Désactive le point d'arrêt à la ligne courante."

#. Displays names of all active cursors.
msgctxt "action documentation"
msgid "editor::DisplayCursorNames"
msgstr "Affiche les noms de tous les curseurs actifs."

#. Duplicates the current line below.
msgctxt "action documentation"
msgid "editor::DuplicateLineDown"
msgstr "Duplique la ligne courante en dessous."

#. Duplicates the current line above.
msgctxt "action documentation"
msgid "editor::DuplicateLineUp"
msgstr "Duplique la ligne courante au-dessus."

#. Duplicates the current selection.
msgctxt "action documentation"
msgid "editor::DuplicateSelection"
msgstr "Duplique la sélection courante."

#. Edits the bookmark's label at the current line.
msgctxt "action documentation"
msgid "editor::EditBookmark"
msgstr "Modifie le libellé du signet à la ligne actuelle."

#. Edits the log message for a breakpoint.
msgctxt "action documentation"
msgid "editor::EditLogBreakpoint"
msgstr "Modifie le message du journal pour un point d'arrêt."

#. Edits a stored review comment inline.
msgctxt "action documentation"
msgid "editor::EditReviewComment"
msgstr "Modifie en ligne un commentaire de revue enregistré."

#. Enables the breakpoint at the current line.
msgctxt "action documentation"
msgid "editor::EnableBreakpoint"
msgstr "Active le point d'arrêt à la ligne actuelle."

#. Expands all diff hunks in the editor.
msgctxt "action documentation"
msgid "editor::ExpandAllDiffHunks"
msgstr "Développe tous les blocs de modifications dans l'éditeur."

#. Expands all excerpts with selections.
msgctxt "action documentation"
msgid "editor::ExpandExcerpts"
msgstr "Développe tous les extraits contenant des sélections."

#. Expands excerpts below the current position.
msgctxt "action documentation"
msgid "editor::ExpandExcerptsDown"
msgstr "Développe les extraits en dessous de la position actuelle."

#. Expands excerpts above the current position.
msgctxt "action documentation"
msgid "editor::ExpandExcerptsUp"
msgstr "Développe les extraits au-dessus de la position actuelle."

#. Expands macros recursively at cursor position.
msgctxt "action documentation"
msgid "editor::ExpandMacroRecursively"
msgstr "Développe les macros de manière récursive à la position du curseur."

#. Finds all references to the symbol at cursor.
msgctxt "action documentation"
msgid "editor::FindAllReferences"
msgstr "Recherche toutes les références au symbole sous le curseur."

#. Finds the next match in the search.
msgctxt "action documentation"
msgid "editor::FindNextMatch"
msgstr "Va à la correspondance suivante."

#. Finds the previous match in the search.
msgctxt "action documentation"
msgid "editor::FindPreviousMatch"
msgstr "Va à la correspondance précédente."

#. Folds the current code block.
msgctxt "action documentation"
msgid "editor::Fold"
msgstr "Replie le bloc de code actuel."

#. Folds all foldable regions in the editor.
msgctxt "action documentation"
msgid "editor::FoldAll"
msgstr "Replie toutes les régions repliables dans l'éditeur."

#. Folds all code blocks at the specified indentation level.
msgctxt "action documentation"
msgid "editor::FoldAtLevel"
msgstr "Replie tous les blocs de code au niveau d'indentation spécifié."

#. Folds all code blocks at indentation level 1.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_1"
msgstr "Replie tous les blocs de code au niveau d'indentation 1."

#. Folds all code blocks at indentation level 2.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_2"
msgstr "Replie tous les blocs de code au niveau d'indentation 2."

#. Folds all code blocks at indentation level 3.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_3"
msgstr "Replie tous les blocs de code au niveau d'indentation 3."

#. Folds all code blocks at indentation level 4.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_4"
msgstr "Replie tous les blocs de code au niveau d'indentation 4."

#. Folds all code blocks at indentation level 5.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_5"
msgstr "Replie tous les blocs de code au niveau d'indentation 5."

#. Folds all code blocks at indentation level 6.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_6"
msgstr "Replie tous les blocs de code au niveau d'indentation 6."

#. Folds all code blocks at indentation level 7.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_7"
msgstr "Replie tous les blocs de code au niveau d'indentation 7."

#. Folds all code blocks at indentation level 8.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_8"
msgstr "Replie tous les blocs de code au niveau d'indentation 8."

#. Folds all code blocks at indentation level 9.
msgctxt "action documentation"
msgid "editor::FoldAtLevel_9"
msgstr "Replie tous les blocs de code au niveau d'indentation 9."

#. Folds all function bodies in the editor.
msgctxt "action documentation"
msgid "editor::FoldFunctionBodies"
msgstr "Replie tous les corps de fonction dans l'éditeur."

#. Folds the current code block and all its children.
msgctxt "action documentation"
msgid "editor::FoldRecursive"
msgstr "Replie le bloc de code actuel et tous ses enfants."

#. Folds the selected ranges.
msgctxt "action documentation"
msgid "editor::FoldSelectedRanges"
msgstr "Replie les plages sélectionnées."

#. Formats the entire document.
msgctxt "action documentation"
msgid "editor::Format"
msgstr "Met en forme l'intégralité du document."

#. Formats only the selected text.
#.
#. This action is only available when the active formatter can format ranges.
#. When using a language server, this sends an LSP range formatting request for each
#. selection, and is hidden when the selected buffer's configured language server does
#. not advertise range-formatting support. When using Prettier, Prettier's own range
#. formatting is used to format the encompassing range of all selections, and resulting
#. edits outside the selected ranges are discarded. External command formatters do not
#. support range formatting and are skipped.
msgctxt "action documentation"
msgid "editor::FormatSelections"
msgstr "Met en forme uniquement le texte sélectionné.\n\nCette action n'est disponible que lorsque le formateur actif peut mettre en forme des plages.\nAvec un serveur de langage, elle envoie une requête LSP de mise en forme de plage pour chaque\nsélection, et elle est masquée lorsque le serveur de langage configuré pour le tampon sélectionné\nn'annonce pas la prise en charge de la mise en forme de plage. Avec Prettier, la mise en forme de plage propre à Prettier\nest utilisée pour mettre en forme la plage englobant toutes les sélections, et les\nmodifications résultantes en dehors des plages sélectionnées sont abandonnées. Les formateurs de commande externe\nne prennent pas en charge la mise en forme de plage et sont ignorés."

#. Goes to the declaration of the symbol at cursor.
msgctxt "action documentation"
msgid "editor::GoToDeclaration"
msgstr "Se déplace vers la déclaration du symbole sous le curseur."

#. Goes to declaration in a split pane.
msgctxt "action documentation"
msgid "editor::GoToDeclarationSplit"
msgstr "Se déplace vers la déclaration dans un volet fractionné."

#. Goes to the definition of the symbol at cursor.
msgctxt "action documentation"
msgid "editor::GoToDefinition"
msgstr "Se déplace vers la définition du symbole sous le curseur."

#. Goes to definition in a split pane.
msgctxt "action documentation"
msgid "editor::GoToDefinitionSplit"
msgstr "Se déplace vers la définition dans un volet fractionné."

#. Expands the diagnostic under the cursor, if any, in case diagnostics are not
#. yet active. Otherwise, goes to the next diagnostic in the file.
msgctxt "action documentation"
msgid "editor::GoToDiagnostic"
msgstr "Développe le diagnostic sous le curseur, le cas échéant, si les diagnostics ne sont pas\nencore actifs. Sinon, se déplace vers le diagnostic suivant dans le fichier."

#. Goes to the next diff hunk.
msgctxt "action documentation"
msgid "editor::GoToHunk"
msgstr "Se déplace vers le bloc de modifications suivant."

#. Goes to the implementation of the symbol at cursor.
msgctxt "action documentation"
msgid "editor::GoToImplementation"
msgstr "Se déplace vers l'implémentation du symbole sous le curseur."

#. Goes to implementation in a split pane.
msgctxt "action documentation"
msgid "editor::GoToImplementationSplit"
msgstr "Se déplace vers l'implémentation dans un volet fractionné."

#. Goes to the next bookmark in the file.
msgctxt "action documentation"
msgid "editor::GoToNextBookmark"
msgstr "Se déplace vers le signet suivant dans le fichier."

#. Goes to the next change in the file.
msgctxt "action documentation"
msgid "editor::GoToNextChange"
msgstr "Se déplace vers la modification suivante dans le fichier."

#. Goes to the next document highlight.
msgctxt "action documentation"
msgid "editor::GoToNextDocumentHighlight"
msgstr "Se déplace vers la mise en surbrillance suivante dans le document."

#. Goes to the next reference to the symbol under the cursor.
msgctxt "action documentation"
msgid "editor::GoToNextReference"
msgstr "Se déplace vers la référence suivante au symbole sous le curseur."

#. Goes to the next symbol.
msgctxt "action documentation"
msgid "editor::GoToNextSymbol"
msgstr "Se déplace vers le symbole suivant."

#. Goes to the parent module of the current file.
msgctxt "action documentation"
msgid "editor::GoToParentModule"
msgstr "Se déplace vers le module parent du fichier actuel."

#. Goes to the previous bookmark in the file.
msgctxt "action documentation"
msgid "editor::GoToPreviousBookmark"
msgstr "Se déplace vers le signet précédent dans le fichier."

#. Goes to the previous change in the file.
msgctxt "action documentation"
msgid "editor::GoToPreviousChange"
msgstr "Se déplace vers la modification précédente dans le fichier."

#. Expands the diagnostic under the cursor, if any, in case diagnostics are not
#. yet active. Otherwise, goes to the previous diagnostic in the file.
msgctxt "action documentation"
msgid "editor::GoToPreviousDiagnostic"
msgstr "Développe le diagnostic sous le curseur, le cas échéant, si les diagnostics ne sont pas\nencore actifs. Sinon, se déplace vers le diagnostic précédent dans le fichier."

#. Goes to the previous document highlight.
msgctxt "action documentation"
msgid "editor::GoToPreviousDocumentHighlight"
msgstr "Se déplace vers la mise en surbrillance précédente dans le document."

#. Goes to the previous diff hunk.
msgctxt "action documentation"
msgid "editor::GoToPreviousHunk"
msgstr "Se déplace vers le bloc de modifications précédent."

#. Goes to the previous reference to the symbol under the cursor.
msgctxt "action documentation"
msgid "editor::GoToPreviousReference"
msgstr "Se déplace vers la référence précédente au symbole sous le curseur."

#. Goes to the previous symbol.
msgctxt "action documentation"
msgid "editor::GoToPreviousSymbol"
msgstr "Se déplace vers le symbole précédent."

#. Goes to the type definition of the symbol at cursor.
msgctxt "action documentation"
msgid "editor::GoToTypeDefinition"
msgstr "Se déplace vers la définition de type du symbole sous le curseur."

#. Goes to type definition in a split pane.
msgctxt "action documentation"
msgid "editor::GoToTypeDefinitionSplit"
msgstr "Se déplace vers la définition de type dans un volet fractionné."

#. Scrolls down by half a page.
msgctxt "action documentation"
msgid "editor::HalfPageDown"
msgstr "Fait défiler vers le bas d'une demi-page."

#. Scrolls up by half a page.
msgctxt "action documentation"
msgid "editor::HalfPageUp"
msgstr "Fait défiler vers le haut d'une demi-page."

#. Handles text input in the editor.
msgctxt "action documentation"
msgid "editor::HandleInput"
msgstr "Gère la saisie de texte dans l'éditeur."

#. Shows hover information for the symbol at cursor.
msgctxt "action documentation"
msgid "editor::Hover"
msgstr "Affiche les informations de survol pour le symbole sous le curseur."

#. Increases indentation of selected lines.
msgctxt "action documentation"
msgid "editor::Indent"
msgstr "Augmente l'indentation des lignes sélectionnées."

#. Inserts a snippet at the cursor.
msgctxt "action documentation"
msgid "editor::InsertSnippet"
msgstr "Insère un extrait de code à la position du curseur."

#. Inserts a UUID v4 at cursor position.
msgctxt "action documentation"
msgid "editor::InsertUuidV4"
msgstr "Insère un UUID v4 à la position du curseur."

#. Inserts a UUID v7 at cursor position.
msgctxt "action documentation"
msgid "editor::InsertUuidV7"
msgstr "Insère un UUID v7 à la position du curseur."

#. Joins the current line with the next line.
msgctxt "action documentation"
msgid "editor::JoinLines"
msgstr "Joint la ligne actuelle avec la ligne suivante."

#. Cuts to kill ring (Emacs-style).
msgctxt "action documentation"
msgid "editor::KillRingCut"
msgstr "Coupe le texte et le place dans le kill ring (style Emacs)."

#. Yanks from kill ring (Emacs-style).
msgctxt "action documentation"
msgid "editor::KillRingYank"
msgstr "Colle depuis le kill ring (style Emacs)."

#. Replaces the text from the last kill ring yank with the next-older generation
#. (Emacs-style `M-y`). Only has an effect immediately after `KillRingYank` or
#. another `KillRingYankPop`.
msgctxt "action documentation"
msgid "editor::KillRingYankPop"
msgstr "Remplace le texte du dernier collage depuis le kill ring par la génération précédente (`M-y` à la manière d'Emacs). N'a d'effet que juste après `KillRingYank` ou un autre `KillRingYankPop`."

#. Moves cursor down one line.
msgctxt "action documentation"
msgid "editor::LineDown"
msgstr "Déplace le curseur d'une ligne vers le bas."

#. Moves cursor up one line.
msgctxt "action documentation"
msgid "editor::LineUp"
msgstr "Déplace le curseur d'une ligne vers le haut."

#. Moves cursor down.
msgctxt "action documentation"
msgid "editor::MoveDown"
msgstr "Déplace le curseur vers le bas."

#. Moves the cursor down by a specified number of lines.
msgctxt "action documentation"
msgid "editor::MoveDownByLines"
msgstr "Déplace le curseur vers le bas du nombre de lignes spécifié."

#. Moves cursor left.
msgctxt "action documentation"
msgid "editor::MoveLeft"
