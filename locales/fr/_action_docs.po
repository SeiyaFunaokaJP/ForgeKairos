#. Moves to the previous step of the code tour an agent started.
msgctxt "action documentation"
msgid "ide_assist::PreviousTourStep"
msgstr "Passe à l'étape précédente de la visite guidée du code lancée par un agent."

#. Copies the MCP configuration snippet for external agents to the clipboard.
msgctxt "action documentation"
msgid "ide_server::CopyMcpConfiguration"
