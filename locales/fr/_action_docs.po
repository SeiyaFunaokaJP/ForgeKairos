msgctxt "action documentation"
msgid "vim::HelixInsertEndOfLine"
msgstr "Insère à la fin de la ligne du curseur Helix actuel."

#. Activate Helix-style word jump labels.
msgctxt "action documentation"
msgid "vim::HelixJumpToWord"
msgstr "Active les étiquettes de saut de mot de style Helix."

#. Removes all but the one selection that was created last.
#. `Newest` can eventually be `Primary`.
msgctxt "action documentation"
msgid "vim::HelixKeepNewestSelection"
msgstr "Supprime toutes les sélections sauf la dernière créée.\n`Newest` peut finir par devenir `Primary`."

#. Pastes text from the specified register at the cursor position.
msgctxt "action documentation"
msgid "vim::HelixPaste"
msgstr "Colle le texte du registre spécifié à la position du curseur."

#. Select entire line or multiple lines, extending downwards.
msgctxt "action documentation"
msgid "vim::HelixSelectLine"
msgstr "Sélectionne la ligne entière ou plusieurs lignes, en s'étendant vers le bas."

#. Select the next match for the current search query.
msgctxt "action documentation"
msgid "vim::HelixSelectNext"
msgstr "Sélectionne la correspondance suivante pour la requête de recherche en cours."

#. Select the previous match for the current search query.
msgctxt "action documentation"
msgid "vim::HelixSelectPrevious"
msgstr "Sélectionne la correspondance précédente pour la requête de recherche en cours."

#. Select all matches of a given pattern within the current selection.
msgctxt "action documentation"
msgid "vim::HelixSelectRegex"
msgstr "Sélectionne toutes les correspondances d'un motif donné dans la sélection actuelle."

#. Delete the selection and enter edit mode.
msgctxt "action documentation"
msgid "vim::HelixSubstitute"
msgstr "Supprime la sélection et passe en mode édition."

#. Delete the selection and enter edit mode, without yanking the selection.
msgctxt "action documentation"
msgid "vim::HelixSubstituteNoYank"
msgstr "Supprime la sélection et passe en mode édition, sans copier la sélection."

#. Trim leading and trailing whitespace from each selection.
#. Originally-empty selections (cursors) are dropped before trimming.
msgctxt "action documentation"
msgid "vim::HelixTrimSelections"
msgstr "Supprime les espaces en début et en fin de chaque sélection.\nLes sélections initialement vides (curseurs) sont écartées avant la suppression des espaces."

#. Yanks the current selection or character if no selection.
msgctxt "action documentation"
msgid "vim::HelixYank"
msgstr "Copie (yank) la sélection actuelle ou le caractère s'il n'y a pas de sélection."

#. Increments the number under the cursor or toggles boolean values.
msgctxt "action documentation"
msgid "vim::Increment"
msgstr "Incrémente le nombre sous le curseur ou bascule les valeurs booléennes."

#. Increases indentation of selected lines.
msgctxt "action documentation"
msgid "vim::Indent"
msgstr "Augmente l'indentation des lignes sélectionnées."

#. Selects text at the same indentation level.
msgctxt "action documentation"
msgid "vim::IndentObj"
msgstr "Sélectionne le texte au même niveau d'indentation."

#. Selects inner text object.
msgctxt "action documentation"
msgid "vim::InnerObject"
msgstr "Sélectionne un objet texte interne."

#. Inserts text after the cursor.
msgctxt "action documentation"
msgid "vim::InsertAfter"
msgstr "Insère du texte après le curseur."

#. Inserts at the previous insert position.
msgctxt "action documentation"
msgid "vim::InsertAtPrevious"
msgstr "Insère à la position d'insertion précédente."

#. Inserts text before the cursor.
msgctxt "action documentation"
msgid "vim::InsertBefore"
msgstr "Insère du texte avant le curseur."

#. Inserts an empty line above without entering insert mode.
msgctxt "action documentation"
msgid "vim::InsertEmptyLineAbove"
msgstr "Insère une ligne vide au-dessus sans entrer en mode insertion."

#. Inserts an empty line below without entering insert mode.
msgctxt "action documentation"
msgid "vim::InsertEmptyLineBelow"
msgstr "Insère une ligne vide en dessous sans entrer en mode insertion."

#. Inserts at the end of the line.
msgctxt "action documentation"
msgid "vim::InsertEndOfLine"
msgstr "Insère à la fin de la ligne."

#. Inserts at the first non-whitespace character.
msgctxt "action documentation"
msgid "vim::InsertFirstNonWhitespace"
msgstr "Insère au premier caractère non blanc."

#. Inserts the next character from the line above into the current line.
msgctxt "action documentation"
msgid "vim::InsertFromAbove"
msgstr "Insère le caractère suivant de la ligne du dessus dans la ligne actuelle."

#. Inserts the next character from the line below into the current line.
msgctxt "action documentation"
msgid "vim::InsertFromBelow"
msgstr "Insère le caractère suivant de la ligne du dessous dans la ligne actuelle."

#. Inserts a new line above the current line.
msgctxt "action documentation"
msgid "vim::InsertLineAbove"
msgstr "Insère une nouvelle ligne au-dessus de la ligne actuelle."

#. Inserts a new line below the current line.
msgctxt "action documentation"
msgid "vim::InsertLineBelow"
msgstr "Insère une nouvelle ligne en dessous de la ligne actuelle."

#. Joins the current line with the next line.
msgctxt "action documentation"
msgid "vim::JoinLines"
msgstr "Joint la ligne actuelle avec la ligne suivante."

#. Joins lines without adding whitespace.
msgctxt "action documentation"
msgid "vim::JoinLinesNoWhitespace"
msgstr "Joint les lignes sans ajouter d'espace."

#. Moves cursor left one character.
msgctxt "action documentation"
msgid "vim::Left"
msgstr "Déplace le curseur d'un caractère vers la gauche."

#. Scrolls down by one line.
msgctxt "action documentation"
msgid "vim::LineDown"
msgstr "Fait défiler vers le bas d'une ligne."

#. Scrolls up by one line.
msgctxt "action documentation"
msgid "vim::LineUp"
msgstr "Fait défiler vers le haut d'une ligne."

#. Moves to the matching bracket or delimiter.
msgctxt "action documentation"
msgid "vim::Matching"
msgstr "Se déplace jusqu'au crochet ou délimiteur correspondant."

#. Maximizes the current pane.
msgctxt "action documentation"
msgid "vim::MaximizePane"
msgstr "Agrandit le volet actuel."

#. Selects (count) next menu item
msgctxt "action documentation"
msgid "vim::MenuSelectNext"
msgstr "Sélectionne l'élément de menu suivant selon la valeur du compteur"

#. Selects (count) previous menu item
msgctxt "action documentation"
msgid "vim::MenuSelectPrevious"
msgstr "Sélectionne l'élément de menu précédent selon la valeur du compteur"

#. Selects a method or function.
msgctxt "action documentation"
msgid "vim::Method"
msgstr "Sélectionne une méthode ou une fonction."

#. Moves to the middle of the current line.
msgctxt "action documentation"
msgid "vim::MiddleOfLine"
msgstr "Se déplace au milieu de la ligne actuelle."

#. Selects text within the nearest brackets.
msgctxt "action documentation"
msgid "vim::MiniBrackets"
msgstr "Sélectionne le texte à l'intérieur des délimiteurs les plus proches."

#. Selects text within the nearest quotes (single or double).
msgctxt "action documentation"
msgid "vim::MiniQuotes"
msgstr "Sélectionne le texte à l'intérieur des guillemets les plus proches (simples ou doubles)."

#. Moves to the next search match.
msgctxt "action documentation"
msgid "vim::MoveToNext"
msgstr "Se déplace à la correspondance de recherche suivante."

#. Moves to the next search match.
msgctxt "action documentation"
msgid "vim::MoveToNextMatch"
msgstr "Se déplace à la correspondance de recherche suivante."

#. Moves to the previous search match.
msgctxt "action documentation"
msgid "vim::MoveToPrevious"
msgstr "Se déplace à la correspondance de recherche précédente."

#. Moves to the previous search match.
msgctxt "action documentation"
msgid "vim::MoveToPreviousMatch"
msgstr "Se déplace à la correspondance de recherche précédente."

#. Moves to the next comment.
msgctxt "action documentation"
msgid "vim::NextComment"
msgstr "Se déplace au commentaire suivant."

#. Moves to the next line with greater indentation.
msgctxt "action documentation"
msgid "vim::NextGreaterIndent"
msgstr "Se déplace à la prochaine ligne avec une indentation plus grande."

#. Moves to the next line with lesser indentation.
msgctxt "action documentation"
msgid "vim::NextLesserIndent"
msgstr "Se déplace à la prochaine ligne avec une indentation plus petite."

#. Moves to the start of the next line.
msgctxt "action documentation"
msgid "vim::NextLineStart"
msgstr "Se déplace vers le début de la ligne suivante."

#. Moves to the end of the next method.
msgctxt "action documentation"
msgid "vim::NextMethodEnd"
msgstr "Se déplace à la fin de la méthode suivante."

#. Moves to the start of the next method.
msgctxt "action documentation"
msgid "vim::NextMethodStart"
msgstr "Se déplace vers le début de la méthode suivante."

#. Moves to the next line with the same indentation.
msgctxt "action documentation"
msgid "vim::NextSameIndent"
msgstr "Se déplace à la prochaine ligne avec la même indentation."

#. Moves to the end of the next section.
msgctxt "action documentation"
msgid "vim::NextSectionEnd"
msgstr "Se déplace à la fin de la section suivante."

#. Moves to the start of the next section.
msgctxt "action documentation"
msgid "vim::NextSectionStart"
msgstr "Se déplace vers le début de la section suivante."

#. Moves to the end of the next subword.
msgctxt "action documentation"
msgid "vim::NextSubwordEnd"
msgstr "Se déplace à la fin du sous-mot suivant."

#. Moves to the start of the next subword.
msgctxt "action documentation"
msgid "vim::NextSubwordStart"
msgstr "Se déplace vers le début du sous-mot suivant."

#. Moves to the end of the next word.
msgctxt "action documentation"
msgid "vim::NextWordEnd"
msgstr "Se déplace à la fin du mot suivant."

#. Moves to the start of the next word.
msgctxt "action documentation"
msgid "vim::NextWordStart"
msgstr "Se déplace vers le début du mot suivant."

#. Switches to normal mode with cursor positioned before the current character.
msgctxt "action documentation"
msgid "vim::NormalBefore"
msgstr "Bascule vers le mode normal avec le curseur positionné avant le caractère actuel."

#. Number is used to manage vim's count. Pushing a digit
#. multiplies the current value by 10 and adds the digit.
msgctxt "action documentation"
msgid "vim::Number"
msgstr "Number sert à gérer le compteur de vim. Appuyer sur un chiffre\nmultiplie la valeur actuelle par 10 et ajoute le chiffre."

#. Opens the default keymap file.
msgctxt "action documentation"
msgid "vim::OpenDefaultKeymap"
msgstr "Ouvre le fichier de raccourcis clavier par défaut."

#. Moves cursor to the other end of the selection.
msgctxt "action documentation"
msgid "vim::OtherEnd"
msgstr "Déplace le curseur à l'autre extrémité de la sélection."

#. Moves cursor to the other end of the selection (row-aware).
msgctxt "action documentation"
msgid "vim::OtherEndRowAware"
msgstr "Déplace le curseur à l'autre extrémité de la sélection (en tenant compte des lignes)."

#. Decreases indentation of selected lines.
msgctxt "action documentation"
msgid "vim::Outdent"
msgstr "Réduit l'indentation des lignes sélectionnées."

#. Scrolls down by one page.
msgctxt "action documentation"
msgid "vim::PageDown"
msgstr "Fait défiler vers le bas d'une page."

#. Scrolls up by one page.
msgctxt "action documentation"
msgid "vim::PageUp"
msgstr "Fait défiler vers le haut d'une page."

#. Selects a paragraph text object.
msgctxt "action documentation"
msgid "vim::Paragraph"
msgstr "Sélectionne un objet texte de type paragraphe."

#. Operates on text within or around parentheses `()`.
msgctxt "action documentation"
msgid "vim::Parentheses"
msgstr "Opère sur le texte à l'intérieur ou autour des parenthèses `()`."

#. Pastes text from the specified register at the cursor position.
msgctxt "action documentation"
msgid "vim::Paste"
msgstr "Colle le texte du registre spécifié à la position du curseur."

#. Moves to the previous comment.
msgctxt "action documentation"
msgid "vim::PreviousComment"
msgstr "Se déplace au commentaire précédent."

#. Moves to the previous line with greater indentation.
msgctxt "action documentation"
msgid "vim::PreviousGreaterIndent"
msgstr "Se déplace à la ligne précédente avec une indentation plus grande."

#. Moves to the previous line with lesser indentation.
msgctxt "action documentation"
msgid "vim::PreviousLesserIndent"
msgstr "Se déplace à la ligne précédente avec une indentation plus petite."

#. Moves to the start of the previous line.
msgctxt "action documentation"
msgid "vim::PreviousLineStart"
msgstr "Se déplace vers le début de la ligne précédente."

#. Moves to the end of the previous method.
msgctxt "action documentation"
msgid "vim::PreviousMethodEnd"
msgstr "Se déplace à la fin de la méthode précédente."

#. Moves to the start of the previous method.
msgctxt "action documentation"
msgid "vim::PreviousMethodStart"
msgstr "Se déplace vers le début de la méthode précédente."

#. Moves to the previous line with the same indentation.
msgctxt "action documentation"
msgid "vim::PreviousSameIndent"
msgstr "Se déplace à la ligne précédente avec la même indentation."

#. Moves to the end of the previous section.
msgctxt "action documentation"
msgid "vim::PreviousSectionEnd"
msgstr "Se déplace à la fin de la section précédente."

#. Moves to the start of the previous section.
msgctxt "action documentation"
msgid "vim::PreviousSectionStart"
msgstr "Se déplace vers le début de la section précédente."

#. Moves to the end of the previous subword.
msgctxt "action documentation"
msgid "vim::PreviousSubwordEnd"
msgstr "Se déplace à la fin du sous-mot précédent."

#. Moves to the start of the previous subword.
msgctxt "action documentation"
msgid "vim::PreviousSubwordStart"
msgstr "Se déplace vers le début du sous-mot précédent."

#. Moves to the end of the previous word.
msgctxt "action documentation"
msgid "vim::PreviousWordEnd"
msgstr "Se déplace à la fin du mot précédent."

#. Moves to the start of the previous word.
msgctxt "action documentation"
msgid "vim::PreviousWordStart"
msgstr "Se déplace vers le début du mot précédent."

#. Starts an auto-indent operation.
msgctxt "action documentation"
msgid "vim::PushAutoIndent"
msgstr "Lance une opération d'indentation automatique."

#. Starts a change operation.
msgctxt "action documentation"
msgid "vim::PushChange"
msgstr "Lance une opération de modification."

#. Starts a delete operation.
msgctxt "action documentation"
msgid "vim::PushDelete"
msgstr "Lance une opération de suppression."

#. Deletes surrounding characters.
msgctxt "action documentation"
msgid "vim::PushDeleteSurrounds"
msgstr "Supprime les caractères englobants."

#. Starts a forced motion.
msgctxt "action documentation"
msgid "vim::PushForcedMotion"
msgstr "Lance un mouvement forcé."

#. Starts a match operation.
msgctxt "action documentation"
msgid "vim::PushHelixMatch"
