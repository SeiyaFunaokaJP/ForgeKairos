msgid "editor::MovePageDown"
msgstr "Déplace le curseur d'une page vers le bas."

#. Moves the cursor up by one page.
msgctxt "action documentation"
msgid "editor::MovePageUp"
msgstr "Déplace le curseur d'une page vers le haut."

#. Moves cursor right.
msgctxt "action documentation"
msgid "editor::MoveRight"
msgstr "Déplace le curseur vers la droite."

#. Moves cursor to the beginning of the document.
msgctxt "action documentation"
msgid "editor::MoveToBeginning"
msgstr "Déplace le curseur au début du document."

#. Moves the cursor to the beginning of the current line.
msgctxt "action documentation"
msgid "editor::MoveToBeginningOfLine"
msgstr "Déplace le curseur au début de la ligne actuelle."

#. Moves cursor to the enclosing bracket.
