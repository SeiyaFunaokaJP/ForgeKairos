#. from the current selections.
msgctxt "action documentation"
msgid "editor::UnwrapSyntaxNode"
msgstr "Supprime le nœud syntaxique englobant (par exemple les crochets ou les fermetures)\ndes sélections actuelles."

#. Opens a view of all bookmarks in the project.
msgctxt "action documentation"
msgid "editor::ViewBookmarks"
msgstr "Ouvre une vue de tous les signets du projet."

#. Wraps selections in tag specified by language.
msgctxt "action documentation"
msgid "editor::WrapSelectionsInTag"
msgstr "Enveloppe les sélections dans la balise spécifiée par le langage."

#. Wraps selections in an expanded Emmet abbreviation.
msgctxt "action documentation"
msgid "editor::WrapWithAbbreviation"
msgstr "Enveloppe les sélections dans une abréviation Emmet développée."

#. Toggles the encoding selector modal.
msgctxt "action documentation"
msgid "encoding_selector::Toggle"
msgstr "Ouvre ou ferme la fenêtre modale de sélection de l'encodage."

#. Opens email client to send feedback to Zed support.
msgctxt "action documentation"
msgid "feedback::EmailZed"
msgstr "Ouvre le client de messagerie pour envoyer des commentaires à l'assistance Zed."

#. Opens the bug report form.
msgctxt "action documentation"
msgid "feedback::FileBugReport"
msgstr "Ouvre le formulaire de signalement de bogue."

#. Opens the feature request form.
msgctxt "action documentation"
msgid "feedback::RequestFeature"
msgstr "Ouvre le formulaire de demande de fonctionnalité."

#. Opens the selected file in the editor without dismissing the file finder,
#. so additional files can be opened in sequence.
msgctxt "action documentation"
msgid "file_finder::OpenWithoutDismiss"
msgstr "Ouvre le fichier sélectionné dans l'éditeur sans fermer la recherche de fichiers,\nafin que d'autres fichiers puissent être ouverts à la suite."

#. Selects the previous item in the file finder.
msgctxt "action documentation"
msgid "file_finder::SelectPrevious"
msgstr "Sélectionne l'élément précédent dans la recherche de fichiers."

#. Toggles the file finder interface.
msgctxt "action documentation"
msgid "file_finder::Toggle"
msgstr "Affiche ou masque la recherche de fichiers."

#. Moves to the next field.
msgctxt "action documentation"
msgid "file_transfer::FocusNextField"
msgstr "Passe au champ suivant."

#. Moves to the previous field.
msgctxt "action documentation"
msgid "file_transfer::FocusPreviousField"
msgstr "Passe au champ précédent."

#. Adds files to the git staging area.
msgctxt "action documentation"
msgid "git::Add"
msgstr "Indexe des fichiers dans la zone d'indexation Git."

#. Adds a file to the repository's .git/info/exclude.
msgctxt "action documentation"
msgid "git::AddToGitInfoExclude"
msgstr "Ajoute un fichier au fichier .git/info/exclude du dépôt."

#. Adds a file to .gitignore.
msgctxt "action documentation"
msgid "git::AddToGitignore"
msgstr "Ajoute un fichier à .gitignore."

#. Amends the last commit with staged changes.
msgctxt "action documentation"
msgid "git::Amend"
msgstr "Modifie la dernière validation avec les modifications indexées."

#. Applies a patch file to the working tree.
msgctxt "action documentation"
msgid "git::ApplyPatch"
msgstr "Applique un fichier patch à la copie de travail."

#. Shows git blame information for the current file.
msgctxt "action documentation"
msgid "git::Blame"
msgstr "Affiche les informations de blame Git pour le fichier actuel."

#. Opens the git branch selector.
msgctxt "action documentation"
msgid "git::Branch"
msgstr "Ouvre le sélecteur de branche Git."

#. Cancels the current git operation.
msgctxt "action documentation"
msgid "git::Cancel"
msgstr "Annule l'opération Git en cours."

#. Checks out a different git branch.
msgctxt "action documentation"
msgid "git::CheckoutBranch"
msgstr "Extrait une autre branche Git."

#. Checks out the selected commit (in a detached HEAD).
msgctxt "action documentation"
msgid "git::CheckoutCommit"
msgstr "Extrait la validation sélectionnée (en HEAD détaché)."

#. Applies the selected commit to the current branch (cherry-pick).
msgctxt "action documentation"
msgid "git::CherryPickCommit"
msgstr "Applique la validation sélectionnée à la branche actuelle (cherry-pick)."

#. Opens the commit graph to choose the commit that the current changes go into (fixup).
msgctxt "action documentation"
msgid "git::ChooseFixupCommit"
msgstr "Ouvre le graphe des validations pour choisir la validation dans laquelle intégrer les modifications actuelles (fixup)."

#. Clones a repository.
msgctxt "action documentation"
msgid "git::Clone"
msgstr "Clone un dépôt."

#. Creates a new commit with staged changes.
msgctxt "action documentation"
msgid "git::Commit"
msgstr "Crée une nouvelle validation avec les modifications indexées."

#. Compares the contents of two branches or tags.
msgctxt "action documentation"
msgid "git::CompareRefs"
msgstr "Compare le contenu de deux branches ou étiquettes."

#. Compare with a specific branch
msgctxt "action documentation"
msgid "git::CompareWithBranch"
msgstr "Compare avec une branche spécifique"

#. Force-pushes (with a lease) after asking for confirmation.
msgctxt "action documentation"
msgid "git::ConfirmForcePush"
msgstr "Envoie de force (avec bail) après une demande de confirmation."

#. Copies the current branch name to the clipboard.
msgctxt "action documentation"
msgid "git::CopyBranchName"
msgstr "Copie le nom de la branche courante dans le presse-papiers."

#. Copies a permalink for the selected file on its Git hosting provider.
msgctxt "action documentation"
msgid "git::CopyFilePermalink"
msgstr "Copie un lien permanent vers le fichier sélectionné sur son fournisseur d'hébergement Git."

#. Copies the distance from the latest tag (`v1.2.3-5-gabcdef`) to the clipboard.
msgctxt "action documentation"
msgid "git::CopyTagDistance"
msgstr "Copie dans le presse-papiers la distance depuis la dernière étiquette (`v1.2.3-5-gabcdef`)."

#. Creates a new branch from the selected commit.
msgctxt "action documentation"
msgid "git::CreateBranchFrom"
msgstr "Crée une branche à partir de la validation sélectionnée."

#. Creates a patch file from the changes.
msgctxt "action documentation"
msgid "git::CreatePatch"
msgstr "Crée un fichier patch à partir des modifications."

#. Creates a pull request for the current branch.
msgctxt "action documentation"
msgid "git::CreatePullRequest"
msgstr "Crée une pull request pour la branche actuelle."

#. Create a git remote.
msgctxt "action documentation"
msgid "git::CreateRemote"
msgstr "Crée un dépôt distant Git."

#. Tags the selected commit.
msgctxt "action documentation"
msgid "git::CreateTagAt"
msgstr "Ajoute une étiquette à la validation sélectionnée."

#. Creates a new git worktree and switches the workspace to it.
#. Dispatched by the unified worktree picker when the user selects a "Create new worktree" entry.
msgctxt "action documentation"
msgid "git::CreateWorktree"
msgstr "Crée une nouvelle arborescence de travail Git et bascule l'espace de travail vers celle-ci.\nDéclenché par le sélecteur d'arborescence de travail unifié lorsque l'utilisateur sélectionne une entrée \"Créer une nouvelle arborescence de travail\"."

#. Shows the diff against the configured diff base: working changes
#. relative to HEAD, or all branch changes relative to the default
#. branch, following the `git.diff_base` setting.
msgctxt "action documentation"
msgid "git::Diff"
msgstr "Affiche les différences par rapport à la base de comparaison configurée : les modifications non validées\npar rapport à HEAD, ou toutes les modifications de la branche par rapport à la branche\npar défaut, conformément au paramètre `git.diff_base`."

#. Shows the diff between the working directory and your default
#. branch (typically main or master).
msgctxt "action documentation"
msgid "git::DiffBranch"
msgstr "Affiche les différences entre le répertoire de travail et votre\nbranche par défaut (généralement main ou master)."

#. Shows working changes relative to HEAD.
msgctxt "action documentation"
msgid "git::DiffHead"
msgstr "Affiche les modifications non validées par rapport à HEAD."

#. Removes the selected commit from the history (the SHAs of the commits after it change).
msgctxt "action documentation"
msgid "git::DropCommit"
msgstr "Supprime la validation sélectionnée de l'historique (les SHA des validations suivantes changent)."

#. Expands the commit message editor.
msgctxt "action documentation"
msgid "git::ExpandCommitEditor"
msgstr "Développe l'éditeur de messages de validation."

#. Fetches changes from the remote repository.
msgctxt "action documentation"
msgid "git::Fetch"
msgstr "Récupère les modifications depuis le dépôt distant."

#. Fetches changes from a specific remote.
msgctxt "action documentation"
msgid "git::FetchFrom"
msgstr "Récupère les modifications depuis un dépôt distant spécifique."

#. Shows the git history for the selected file, folder, or project.
msgctxt "action documentation"
msgid "git::FileHistory"
msgstr "Affiche l'historique Git du fichier, du dossier ou du projet sélectionné."

#. Filter remotes.
msgctxt "action documentation"
msgid "git::FilterRemotes"
msgstr "Filtre les dépôts distants."

#. Puts the current changes into the selected commit (fixup; the SHAs of the commits after it change).
msgctxt "action documentation"
msgid "git::FixupCommit"
msgstr "Intègre les modifications actuelles dans la validation sélectionnée (fixup ; les SHA des validations suivantes changent)."

#. Force pushes commits to the remote repository.
msgctxt "action documentation"
msgid "git::ForcePush"
msgstr "Envoie de force (force push) les validations vers le dépôt distant."

#. Force-pushes without a lease (this also overwrites commits others have pushed).
msgctxt "action documentation"
msgid "git::ForcePushWithoutLease"
msgstr "Envoie de force sans bail (cela écrase aussi les validations envoyées par d'autres)."

#. Generates a commit message using AI.
msgctxt "action documentation"
msgid "git::GenerateCommitMessage"
msgstr "Génère un message de validation à l'aide de l'IA."

#. Initializes a new git repository.
msgctxt "action documentation"
msgid "git::Init"
msgstr "Initialise un nouveau dépôt Git."

#. Merges the selected branch into the current branch.
msgctxt "action documentation"
msgid "git::Merge"
msgstr "Fusionne la branche sélectionnée dans la branche actuelle."

#. Opens the current file in a solo diff view.
msgctxt "action documentation"
msgid "git::OpenFileDiff"
msgstr "Ouvre le fichier actuel dans une vue des différences pour un seul fichier."

#. Opens a permalink for the selected file on its Git hosting provider.
msgctxt "action documentation"
msgid "git::OpenFilePermalink"
msgstr "Ouvre un lien permanent vers le fichier sélectionné sur son fournisseur d'hébergement Git."

#. Opens the merge request box of the commit graph (and keeps it open if it already is).
msgctxt "action documentation"
msgid "git::OpenMergeRequestBox"
msgstr "Ouvre la boîte MR du graphe des validations (et la laisse ouverte si elle l'est déjà)."

#. Opens all modified files in the editor.
msgctxt "action documentation"
msgid "git::OpenModifiedFiles"
msgstr "Ouvre tous les fichiers modifiés dans l'éditeur."

#. Opens an existing worktree in a new window.
#. Dispatched by the worktree picker's "Open in New Window" button.
msgctxt "action documentation"
msgid "git::OpenWorktreeInNewWindow"
msgstr "Ouvre une arborescence de travail existante dans une nouvelle fenêtre.\nDéclenché par le bouton \"Ouvrir dans une nouvelle fenêtre\" du sélecteur d'arborescence de travail."

#. Packs loose refs into one file, which speeds up repositories with many branches or tags (git pack-refs --all).
msgctxt "action documentation"
msgid "git::PackRefs"
msgstr "Regroupe les références isolées dans un seul fichier, ce qui accélère les dépôts comportant de nombreuses branches ou étiquettes (git pack-refs --all)."

#. Pulls changes from the remote repository.
msgctxt "action documentation"
msgid "git::Pull"
msgstr "Tire (pull) les modifications du dépôt distant."

#. Pulls changes from the remote repository with rebase.
msgctxt "action documentation"
msgid "git::PullRebase"
msgstr "Tire (pull) les modifications du dépôt distant avec rebasage."

#. Pushes commits to the remote repository.
msgctxt "action documentation"
msgid "git::Push"
msgstr "Envoie (push) les validations vers le dépôt distant."

#. Pushes commits to a specific remote branch.
msgctxt "action documentation"
msgid "git::PushTo"
msgstr "Envoie (push) les validations vers une branche distante spécifique."

#. Removes a registered remote repository.
msgctxt "action documentation"
msgid "git::RemoveRemote"
msgstr "Supprime un dépôt distant enregistré."

#. Renames a git branch.
msgctxt "action documentation"
msgid "git::RenameBranch"
msgstr "Renomme une branche Git."

#. Resets the current branch to the selected commit.
msgctxt "action documentation"
msgid "git::ResetToCommit"
msgstr "Réinitialise la branche actuelle à la validation sélectionnée."

#. Fetches, then forces the local branch to match the remote (uncommitted changes are lost).
msgctxt "action documentation"
msgid "git::ResetToRemote"
msgstr "Récupère, puis force la branche locale à correspondre au dépôt distant (les modifications non validées sont perdues)."

#. Restores the selected hunks to their original state.
msgctxt "action documentation"
msgid "git::Restore"
msgstr "Restaure les blocs sélectionnés à leur état d'origine."

#. Restores the selected hunks to their original state and moves to the
#. next one.
msgctxt "action documentation"
msgid "git::RestoreAndNext"
msgstr "Restaure les blocs sélectionnés à leur état d'origine et passe au\nsuivant."

#. Restores a file to its last committed state, discarding local changes.
msgctxt "action documentation"
msgid "git::RestoreFile"
msgstr "Restaure un fichier à son dernier état validé, en abandonnant les modifications locales."

#. Restores all tracked files to their last committed state.
msgctxt "action documentation"
msgid "git::RestoreTrackedFiles"
msgstr "Restaure tous les fichiers suivis à leur dernier état validé."

#. Creates a commit that undoes the selected commit (revert).
msgctxt "action documentation"
msgid "git::RevertCommit"
msgstr "Crée une validation qui annule la validation sélectionnée (revert)."

#. Opens a new agent thread with the branch diff for review.
msgctxt "action documentation"
msgid "git::ReviewDiff"
msgstr "Ouvre une nouvelle conversation d'agent avec les différences de la branche pour révision."

#. Rewrites the message of the selected commit (the SHAs of the commits after it change).
msgctxt "action documentation"
msgid "git::RewordCommit"
msgstr "Réécrit le message de la validation sélectionnée (les SHA des validations suivantes changent)."

#. Selects a different repository.
msgctxt "action documentation"
msgid "git::SelectRepo"
msgstr "Sélectionne un dépôt différent."

#. Opens the Git guide, which lists operations by what you want to do.
msgctxt "action documentation"
msgid "git::ShowGuide"
msgstr "Ouvre le guide Git, qui répertorie les opérations selon ce que vous voulez faire."

#. Enable the --signoff option.
msgctxt "action documentation"
msgid "git::Signoff"
msgstr "Active l'option --signoff."

#. Runs the next commit with `git commit --no-verify`.
msgctxt "action documentation"
msgid "git::SkipHooks"
msgstr "Effectue la prochaine validation avec `git commit --no-verify`."

#. Stages all changes in the repository.
msgctxt "action documentation"
msgid "git::StageAll"
msgstr "Indexe toutes les modifications dans le dépôt."

#. Stages the current hunk and moves to the next one.
msgctxt "action documentation"
msgid "git::StageAndNext"
msgstr "Indexe le bloc actuel et passe au suivant."

#. Stages the current file.
msgctxt "action documentation"
msgid "git::StageFile"
msgstr "Indexe le fichier actuel."

#. Stage status entries between an anchor entry and the cursor.
msgctxt "action documentation"
msgid "git::StageRange"
msgstr "Indexe les entrées d'état entre une entrée d'ancrage et le curseur."

#. Stages every entry in the section containing the selected entry.
msgctxt "action documentation"
msgid "git::StageSection"
msgstr "Indexe chaque entrée de la section contenant l'entrée sélectionnée."

#. Opens the Git panel and starts amending the last commit.
msgctxt "action documentation"
msgid "git::StartAmend"
msgstr "Ouvre le panneau Git et commence la modification de la dernière validation (amend)."

#. Stashes all changes in the repository, including untracked files.
msgctxt "action documentation"
msgid "git::StashAll"
msgstr "Remise toutes les modifications du dépôt, y compris les fichiers non suivis."

#. Apply the most recent stash.
msgctxt "action documentation"
msgid "git::StashApply"
msgstr "Applique la remise la plus récente."

#. Pops the most recent stash.
msgctxt "action documentation"
msgid "git::StashPop"
msgstr "Applique et supprime la remise la plus récente."

#. Stashes staged changes in the repository, leaving unstaged changes in place.
msgctxt "action documentation"
msgid "git::StashStaged"
msgstr "Remise les modifications indexées du dépôt, en laissant les modifications non indexées en place."

#. Stashes tracked changes in the repository, leaving untracked files in place.
msgctxt "action documentation"
msgid "git::StashTracked"
msgstr "Remise les modifications suivies du dépôt, en laissant les fichiers non suivis en place."

#. Switches to a different git branch.
msgctxt "action documentation"
msgid "git::Switch"
msgstr "Passe à une autre branche Git."

#. Switches the workspace to an existing linked worktree.
#. Dispatched by the unified worktree picker when the user selects an existing worktree.
msgctxt "action documentation"
msgid "git::SwitchWorktree"
msgstr "Bascule l'espace de travail vers une arborescence de travail liée existante.\nDéclenché par le sélecteur d'arborescence de travail unifié lorsque l'utilisateur sélectionne une arborescence de travail existante."

#. Toggles the git diff base between HEAD and the default branch.
msgctxt "action documentation"
msgid "git::ToggleDiffBase"
msgstr "Bascule la base de comparaison Git entre HEAD et la branche par défaut."

#. Toggles whether the commit message editor fills all the available
#. vertical space within the git panel.
msgctxt "action documentation"
msgid "git::ToggleFillCommitEditor"
msgstr "Active ou désactive l'option qui fait que l'éditeur de messages de validation\noccupe tout l'espace vertical du panneau Git."

#. Opens or closes the merge request box of the commit graph.
msgctxt "action documentation"
msgid "git::ToggleMergeRequestBox"
msgstr "Ouvre ou ferme la boîte MR du graphe des validations."

#. Toggles the staged state of the hunk or status entry at cursor.
msgctxt "action documentation"
msgid "git::ToggleStaged"
msgstr "Indexe ou désindexe le bloc ou l'entrée d'état sous le curseur."

#. Moves all untracked files to trash.
msgctxt "action documentation"
msgid "git::TrashUntrackedFiles"
msgstr "Déplace tous les fichiers non suivis vers la corbeille."

#. Undoes the last commit, keeping changes in the working directory.
msgctxt "action documentation"
msgid "git::Uncommit"
msgstr "Annule la dernière validation en conservant les modifications dans le répertoire de travail."

#. Unstages all changes in the repository.
msgctxt "action documentation"
msgid "git::UnstageAll"
msgstr "Désindexe toutes les modifications du dépôt."

#. Unstages the current hunk and moves to the next one.
msgctxt "action documentation"
msgid "git::UnstageAndNext"
msgstr "Désindexe le bloc actuel et passe au suivant."

#. Unstages the current file.
msgctxt "action documentation"
msgid "git::UnstageFile"
msgstr "Désindexe le fichier actuel."

#. Unstages every entry in the section containing the selected entry.
msgctxt "action documentation"
msgid "git::UnstageSection"
msgstr "Désindexe chaque entrée de la section contenant l'entrée sélectionnée."

#. Opens the selected file in the editor without a diff view.
msgctxt "action documentation"
msgid "git::ViewFile"
msgstr "Ouvre le fichier sélectionné dans l'éditeur sans vue des différences."

#. Shows staged changes across the project.
msgctxt "action documentation"
msgid "git::ViewStagedChanges"
msgstr "Affiche les modifications indexées dans l'ensemble du projet."

#. Opens the git stash selector.
msgctxt "action documentation"
msgid "git::ViewStash"
msgstr "Ouvre le sélecteur de remises Git."

#. Shows uncommitted changes across the project.
msgctxt "action documentation"
msgid "git::ViewUncommittedChanges"
msgstr "Affiche les modifications non validées dans l'ensemble du projet."

#. Shows unstaged changes across the project.
msgctxt "action documentation"
msgid "git::ViewUnstagedChanges"
msgstr "Affiche les modifications non indexées dans l'ensemble du projet."

#. Opens the git worktree selector.
msgctxt "action documentation"
msgid "git::Worktree"
msgstr "Ouvre le sélecteur d'arborescence de travail Git."

#. Copies the SHA of the selected commit to the clipboard.
msgctxt "action documentation"
msgid "git_graph::CopyCommitSha"
msgstr "Copie le SHA de la validation sélectionnée dans le presse-papiers."

#. Copies a tag from the selected commit to the clipboard.
msgctxt "action documentation"
msgid "git_graph::CopyCommitTag"
msgstr "Copie une étiquette de la validation sélectionnée dans le presse-papiers."

#. Reorders, squashes, rewords or drops the selected commits in one edit.
msgctxt "action documentation"
msgid "git_graph::EditSelectedCommits"
msgstr "Réordonne, combine (squash), reformule ou supprime (drop) les validations sélectionnées en une seule modification."

#. Focuses the next git graph tab stop.
msgctxt "action documentation"
msgid "git_graph::FocusNextTabStop"
msgstr "Déplace le focus vers l'élément focalisable suivant du graphe des validations."

#. Focuses the previous git graph tab stop.
msgctxt "action documentation"
msgid "git_graph::FocusPreviousTabStop"
msgstr "Déplace le focus vers l'élément focalisable précédent du graphe des validations."

#. Focuses the search field.
msgctxt "action documentation"
msgid "git_graph::FocusSearch"
msgstr "Donne le focus au champ de recherche."

#. Opens the Git Graph Tab.
msgctxt "action documentation"
msgid "git_graph::Open"
msgstr "Ouvre l'onglet Graphe des validations."

#. Opens the Git Graph Tab at a specific commit.
msgctxt "action documentation"
msgid "git_graph::OpenAtCommit"
msgstr "Ouvre l'onglet Graphe des validations sur une validation spécifique."

#. Opens the commit view for the selected commit.
msgctxt "action documentation"
msgid "git_graph::OpenCommitView"
msgstr "Ouvre la vue de validation pour la validation sélectionnée."

#. Selects a commit half a page below the current selection.
msgctxt "action documentation"
msgid "git_graph::ScrollDown"
msgstr "Sélectionne une validation une demi-page en dessous de la sélection actuelle."

#. Selects a commit half a page above the current selection.
msgctxt "action documentation"
msgid "git_graph::ScrollUp"
msgstr "Sélectionne une validation une demi-page au-dessus de la sélection actuelle."

#. Toggles the selected commit's changed files between flat and tree views.
msgctxt "action documentation"
msgid "git_graph::ToggleChangedFilesView"
msgstr "Bascule les fichiers modifiés de la validation sélectionnée entre la vue à plat et la vue en arborescence."

#. Opens the git integration onboarding modal.
msgctxt "action documentation"
msgid "git_onboarding::OpenGitIntegrationOnboarding"
msgstr "Ouvre la fenêtre modale de prise en main de l'intégration Git."

#. Activates the Changes tab.
msgctxt "action documentation"
msgid "git_panel::ActivateChangesTab"
msgstr "Active l'onglet Modifications."

#. Activates the History tab.
msgctxt "action documentation"
msgid "git_panel::ActivateHistoryTab"
msgstr "Active l'onglet Historique."

#. Closes the git panel.
msgctxt "action documentation"
msgid "git_panel::Close"
msgstr "Ferme le panneau Git."

#. Collapses the selected entry to hide its children.
msgctxt "action documentation"
msgid "git_panel::CollapseSelectedEntry"
msgstr "Réduit l'entrée sélectionnée pour masquer ses enfants."

#. Expands the selected entry to show its children.
msgctxt "action documentation"
msgid "git_panel::ExpandSelectedEntry"
msgstr "Développe l'entrée sélectionnée pour afficher ses enfants."

#. Select first git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::FirstEntry"
msgstr "Sélectionne le premier élément du menu du panneau Git et l'affiche dans la vue des différences"

#. Focuses on the changes list.
msgctxt "action documentation"
msgid "git_panel::FocusChanges"
msgstr "Donne le focus à la liste des modifications."

#. Focuses on the commit message editor.
msgctxt "action documentation"
msgid "git_panel::FocusEditor"
msgstr "Donne le focus à l'éditeur de message de validation."

#. Select last git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::LastEntry"
msgstr "Sélectionne le dernier élément du menu du panneau Git et l'affiche dans la vue des différences"

#. Select next git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::NextEntry"
msgstr "Sélectionne l'élément suivant du menu du panneau Git et l'affiche dans la vue des différences"

#. Opens the git panel menu.
msgctxt "action documentation"
msgid "git_panel::OpenMenu"
msgstr "Ouvre le menu du panneau Git."

#. Select previous git panel menu item, and show it in the diff view
msgctxt "action documentation"
msgid "git_panel::PreviousEntry"
msgstr "Sélectionne l'élément précédent du menu du panneau Git et l'affiche dans la vue des différences"

#. Disables grouping entries by status.
msgctxt "action documentation"
msgid "git_panel::SetGroupByNone"
msgstr "Désactive le regroupement des entrées par statut."

#. Groups entries by staging state.
msgctxt "action documentation"
msgid "git_panel::SetGroupByStaging"
msgstr "Regroupe les entrées par état d'indexation."

#. Groups entries by status.
msgctxt "action documentation"
msgid "git_panel::SetGroupByStatus"
msgstr "Regroupe les entrées par statut."

#. Sorts entries by name.
msgctxt "action documentation"
msgid "git_panel::SetSortByName"
msgstr "Trie les entrées par nom."

#. Sorts entries by path.
msgctxt "action documentation"
msgid "git_panel::SetSortByPath"
msgstr "Trie les entrées par chemin d'accès."

#. Toggles the git panel.
msgctxt "action documentation"
msgid "git_panel::Toggle"
msgstr "Affiche ou masque le panneau Git."

#. Toggles automatic co-author suggestions.
msgctxt "action documentation"
msgid "git_panel::ToggleFillCoAuthors"
msgstr "Active ou désactive les suggestions automatiques de co-auteurs."

#. Toggles focus on the git panel.
msgctxt "action documentation"
msgid "git_panel::ToggleFocus"
msgstr "Bascule le focus sur le panneau Git."

#. Toggles showing entries in tree vs flat view.
msgctxt "action documentation"
msgid "git_panel::ToggleTreeView"
msgstr "Bascule l'affichage des entrées entre la vue en arborescence et la vue à plat."

