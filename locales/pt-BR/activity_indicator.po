msgstr ""
"Language: pt-BR\n"
"X-Language-Name: Português (Brasil)\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid " + {} more"
msgstr " + mais {}"

msgid "({server_name}) Error: "
msgstr "({server_name}) Erro: "

msgid "({server_name}) Warning: "
msgstr "({server_name}) Aviso: "

msgid "Add to Allowlist and Retry"
msgstr "Adicionar à lista de permissões e tentar novamente"

msgid "Building the symbol index ({done} / {total})"
msgstr "Criando o índice de símbolos ({done} / {total})"

msgid "Cancel {title}"
msgstr "Cancelar {title}"

msgid "Checking for updates to {}..."
msgstr "Verificando atualizações para {}..."

msgid "Couldn't add the hosts to the allowlist: {error}"
msgstr "Não foi possível adicionar os hosts à lista de permissões: {error}"

msgid "Couldn't download the {display_name} language server"
msgstr "Não foi possível baixar o servidor de linguagem {display_name}"

msgid "Couldn't download {}. Click to show error."
msgstr "Não foi possível baixar {}. Clique para mostrar o erro."

msgid "Couldn't install {display_name}: {error}"
msgstr "Não foi possível instalar {display_name}: {error}"

msgid "Debug: {}"
msgstr "Depuração: {}"

msgid "Directories outside of git repositories and deeper than the `file_scan_depth` setting will be indexed on demand."
msgstr "Diretórios fora de repositórios Git e em uma profundidade maior que a definida na configuração `file_scan_depth` serão indexados sob demanda."

msgid "Don't Allow This Time"
msgstr "Não permitir desta vez"

msgid "Don't Show This Again"
msgstr "Não mostrar novamente"

