# The descriptions of the settings file's JSON schema, keyed by their English text.
#
# Entries that zed-i18n also translates started from its pt-BR translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: pt-BR\n"
"X-Language-Name: Português (Brasil)\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgctxt "settings schema"
msgid "A block that surrounds the following character"
msgstr "Um bloco que envolve o caractere seguinte"

msgctxt "settings schema"
msgid "A box drawn around the following character"
msgstr "Um retângulo desenhado ao redor do caractere seguinte"

msgctxt "settings schema"
msgid "A capability for an extension."
msgstr "Uma permissão para uma extensão."

msgctxt "settings schema"
msgid "A custom Git hosting provider."
msgstr "Um provedor personalizado de hospedagem Git."

msgctxt "settings schema"
msgid "A custom line height, where 1.0 is the font's height. Must be at least 1.0."
msgstr "Uma altura de linha personalizada, onde 1.0 equivale à altura da fonte. Deve ser pelo menos 1.0."

msgctxt "settings schema"
msgid "A custom offset in milliseconds for the tooltip show delay."
msgstr "Um atraso personalizado em milissegundos antes da exibição da dica de ferramenta."

msgctxt "settings schema"
msgid "A denser UI with tighter spacing and smaller elements."
msgstr "Uma interface mais densa com espaçamento reduzido e elementos menores."

msgctxt "settings schema"
msgid "A dynamic icon theme selection, which can change based on the [`ThemeMode`]."
msgstr "Uma seleção dinâmica de tema de ícones, que pode mudar com base no [`ThemeMode`]."

msgctxt "settings schema"
msgid "A dynamic theme selection, which can change based the [ThemeMode]."
msgstr "Uma seleção dinâmica de tema, que pode mudar com base no [ThemeMode]."

msgctxt "settings schema"
msgid "A fixed pixel width for the git diff indicators."
msgstr "Uma largura fixa em pixels para os indicadores de diff do Git."

msgctxt "settings schema"
msgid "A font size value in pixels, wrapping around `f32` for custom settings UI rendering."
msgstr "Um valor de tamanho de fonte em pixels, encapsulando `f32` para renderização personalizada na interface de configurações."

msgctxt "settings schema"
msgid "A git account a repository can commit and push as."
msgstr "Uma conta Git com a qual um repositório pode fazer commit e push."

msgctxt "settings schema"
msgid "A less dense line height."
msgstr "Uma altura de linha menos densa."

msgctxt "settings schema"
msgid "A looser UI with more spacing and larger elements."
msgstr "Uma interface menos densa, com mais espaçamento e elementos maiores."

msgctxt "settings schema"
msgid "A map of log scopes to the desired log level.\nUseful for filtering out noisy logs or enabling more verbose logging.\n\nExample: {\"log\": {\"client\": \"warn\"}}"
msgstr "Um mapa de escopos de log para o nível de log desejado.\nÚtil para filtrar logs ruidosos ou habilitar logs mais detalhados.\n\nExemplo: {\"log\": {\"client\": \"warn\"}}"

msgctxt "settings schema"
msgid "A model `name` to substitute when calling tools, in case the primary model doesn't support tool calling."
msgstr "Um `name` de modelo a ser usado em substituição ao chamar ferramentas, caso o modelo principal não suporte chamadas de ferramentas."

msgctxt "settings schema"
msgid "A named settings profile that can temporarily override settings."
msgstr "Um perfil de configurações nomeado que pode substituir temporariamente as configurações."

msgctxt "settings schema"
msgid "A non-negative size in pixels.\n\nValid range: 0.0 and up"
msgstr "Um tamanho não negativo em pixels.\n\nIntervalo válido: 0.0 ou mais"

msgctxt "settings schema"
msgid "A panel the default dock layout can name."
msgstr "Um painel que o layout padrão dos docks pode indicar."

msgctxt "settings schema"
msgid "A static icon theme selection, represented by a single icon theme name."
msgstr "Uma seleção estática de tema de ícones, representada por um único nome de tema de ícones."

msgctxt "settings schema"
msgid "A static theme selection, represented by a single theme name."
msgstr "Uma seleção estática de tema, representada por um único nome de tema."

msgctxt "settings schema"
msgid "A value of `ui_language`, its own type so the settings UI can offer the\nlanguages found at run time instead of a text field."
msgstr "Um valor de `ui_language`, com tipo próprio para que a interface de configurações possa oferecer os idiomas encontrados em tempo de execução em vez de um campo de texto."

msgctxt "settings schema"
msgid "A vertical bar"
msgstr "Uma barra vertical"

msgctxt "settings schema"
msgid "AI providers whose \"your input may be retained and used for training\"\nwarning the user has explicitly acknowledged. The settings UI refuses to\ntake an API key for, or sign in to, an external provider that is not\nlisted here.\n\nEntries are provider ids. Agent (LLM) providers use their own ids\n(`anthropic`, `openai`, `zed.dev`, ...);\nedit prediction providers are prefixed to keep the two surfaces\nindependent (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nDefault: []"
msgstr "Provedores de IA cujo aviso \"sua entrada pode ser retida e usada para treinamento\" o usuário reconheceu explicitamente. A interface de configurações se recusa a aceitar uma chave de API ou a fazer login em um provedor externo que não esteja listado aqui.\n\nAs entradas são IDs de provedores. Os provedores do agente (LLM) usam seus próprios IDs (`anthropic`, `openai`, `zed.dev`, ...); os provedores de previsão de edição recebem um prefixo para manter as duas superfícies independentes (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nPadrão: []"

msgctxt "settings schema"
msgid "Activates the python virtual environment, if one is found, in the\nterminal's working directory (as resolved by the working_directory\nsetting). Set this to \"off\" to disable this behavior.\n\nDefault: on"
msgstr "Ativa o ambiente virtual Python, se um for encontrado, no diretório de trabalho do terminal (conforme resolvido pela configuração working_directory). Defina como \"off\" para desabilitar esse comportamento.\n\nPadrão: on"

msgctxt "settings schema"
msgid "Active pane styling settings."
msgstr "Configurações de estilo do subpainel ativo."

msgctxt "settings schema"
msgid "Added version control color."
msgstr "Cor de controle de versão para itens adicionados."

msgctxt "settings schema"
msgid "Additional environment variables to pass to the agent.\n\nDefault: {}"
msgstr "Variáveis de ambiente adicionais a passar para o agente.\n\nPadrão: {}"

msgctxt "settings schema"
msgid "Additional models with which to generate alternatives when performing inline assists."
msgstr "Modelos adicionais para gerar alternativas ao executar assistências embutidas."

msgctxt "settings schema"
msgid "Additional parameters for language model requests. When making a request\nto a model, parameters will be taken from the last entry in this list\nthat matches the model's provider and name. In each entry, both provider\nand model are optional, so that you can specify parameters for either\none.\n\nDefault: []"
msgstr "Parâmetros adicionais para solicitações a modelos de linguagem. Ao fazer uma solicitação a um modelo, os parâmetros são obtidos da última entrada desta lista que corresponda ao provedor e ao nome do modelo. Em cada entrada, tanto o provedor quanto o modelo são opcionais, para que você possa especificar parâmetros para qualquer um deles.\n\nPadrão: []"

msgctxt "settings schema"
msgid "Adjusts indentation based on syntax context when typing.\nUses tree-sitter to analyze code structure and indent accordingly."
msgstr "Ajusta o recuo com base no contexto da sintaxe ao digitar.\nUsa o Tree-sitter para analisar a estrutura do código e aplicar o recuo de acordo."

msgctxt "settings schema"
msgid "Aliases for the command palette. When you type a key in this map,\nit will be assumed to equal the value.\n\nDefault: {}"
msgstr "Aliases para a paleta de comandos. Quando você digita uma chave deste mapa, ela é considerada igual ao valor.\n\nPadrão: {}"

msgctxt "settings schema"
msgid "Allow Zed to collect training data from open-source projects."
msgstr "Permite que o Zed colete dados de treinamento de projetos de código aberto."

msgctxt "settings schema"
msgid "Allow rewrapping anywhere."
msgstr "Permite refazer a quebra em qualquer lugar."

msgctxt "settings schema"
msgid "Allow sending requests to Anthropic models that cannot be offered with\nZero Data Retention.\n\nDefault: false"
msgstr "Permite enviar solicitações a modelos da Anthropic que não podem ser oferecidos com Zero Data Retention.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Allows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\nPrettier formatting is disabled by default."
msgstr "Permite habilitar/desabilitar a formatação com o Prettier e configurar o Prettier padrão, usado quando nenhuma instalação do Prettier no nível do projeto é encontrada.\nA formatação com o Prettier é desabilitada por padrão."

msgctxt "settings schema"
msgid "Always blink the cursor, ignoring the terminal mode."
msgstr "Sempre pisca o cursor, ignorando o modo do terminal."

msgctxt "settings schema"
msgid "Always fetch document's words for completions along with LSP completions."
msgstr "Sempre busca palavras do documento para preenchimentos automáticos junto com os preenchimentos automáticos do LSP."

msgctxt "settings schema"
msgid "Always index the worktree."
msgstr "Sempre indexa a árvore de trabalho."

msgctxt "settings schema"
msgid "Always populate the search query with the word under the cursor."
msgstr "Sempre preenche a consulta de pesquisa com a palavra sob o cursor."

msgctxt "settings schema"
msgid "Always prompt for confirmation (default behavior)."
msgstr "Sempre solicita confirmação (comportamento padrão)."

msgctxt "settings schema"
msgid "Always reduce motion"
msgstr "Sempre reduzir o movimento"

msgctxt "settings schema"
msgid "Always scan symlinked directories"
msgstr "Sempre varrer diretórios com links simbólicos"

msgctxt "settings schema"
msgid "Always show the minimap thumb."
msgstr "Sempre exibe o controle deslizante do minimapa."

msgctxt "settings schema"
msgid "Always show the minimap."
msgstr "Sempre exibe o minimapa."

msgctxt "settings schema"
msgid "Always show the scrollbar."
msgstr "Sempre exibe a barra de rolagem."

msgctxt "settings schema"
msgid "Always show the sidebar on the left side."
msgstr "Sempre exibe a barra lateral no lado esquerdo."

msgctxt "settings schema"
msgid "Always show the sidebar on the right side."
msgstr "Sempre exibe a barra lateral no lado direito."

msgctxt "settings schema"
msgid "Always start with an empty editor tab"
msgstr "Sempre inicia com uma aba vazia no editor"

msgctxt "settings schema"
msgid "Always use a specific directory. This value will be shell expanded.\nIf this path is not a valid directory the terminal will default to\nthis platform's home directory  (if it can be found)."
msgstr "Sempre usa um diretório específico. Este valor é expandido pelo shell.\nSe este caminho não for um diretório válido, o terminal usará o diretório inicial desta plataforma (se puder ser encontrado)."

msgctxt "settings schema"
msgid "Always use this platform's home directory (if it can be found)."
msgstr "Sempre usa o diretório inicial desta plataforma (se puder ser encontrado)."

msgctxt "settings schema"
msgid "Amount of indentation (in pixels) for nested items.\n\nDefault: 20"
msgstr "Quantidade de recuo (em pixels) para itens aninhados.\n\nPadrão: 20"

msgctxt "settings schema"
msgid "An optional string to override the title of the terminal tab"
msgstr "Uma string opcional para substituir o título da aba do terminal"

msgctxt "settings schema"
msgid "An underline that runs along the following character"
msgstr "Um sublinhado que percorre o caractere seguinte"

msgctxt "settings schema"
msgid "Any extra beta headers to provide when using the model."
msgstr "Cabeçalhos beta extras a fornecer ao usar o modelo."

msgctxt "settings schema"
msgid "Any key-value pairs added to this list will be added to the terminal's\nenvironment. Use `:` to separate multiple values.\n\nDefault: {}"
msgstr "Todos os pares de chave e valor adicionados a esta lista são adicionados ao ambiente do terminal. Use `:` para separar vários valores.\n\nPadrão: {}"

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"\""
msgstr "URL da API a usar para preenchimentos automáticos.\n\nPadrão: \"\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"http://localhost:11434\""
msgstr "URL da API a usar para preenchimentos automáticos.\n\nPadrão: \"http://localhost:11434\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"https://codestral.mistral.ai\""
msgstr "URL da API a usar para preenchimentos automáticos.\n\nPadrão: \"https://codestral.mistral.ai\""

msgctxt "settings schema"
msgid "Apply profile settings on top of Zed's default settings, ignoring user customizations."
msgstr "Aplica as configurações do perfil sobre as configurações padrão do ForgeKairos, ignorando personalizações do usuário."

msgctxt "settings schema"
msgid "Apply profile settings on top of the user's current settings."
msgstr "Aplica as configurações do perfil sobre as configurações atuais do usuário."

msgctxt "settings schema"
msgid "Ask a separate, cheap language model whether the operation is dangerous,\nand auto-approve it only when that model answers that it is safe.\nEvery rule that outranks the default — the built-in security\nrules and the user's `always_deny`/`always_confirm`/`always_allow`\npatterns — is applied first, so this only replaces the \"ask every time\"\nstep."
msgstr "Pergunta a um modelo de linguagem separado e barato se a operação é perigosa e a aprova automaticamente somente quando esse modelo responde que ela é segura.\nToda regra que tem precedência sobre o padrão — as regras de segurança integradas e os padrões `always_deny`/`always_confirm`/`always_allow` do usuário — é aplicada primeiro, de modo que isto substitui apenas a etapa \"perguntar sempre\"."

msgctxt "settings schema"
msgid "Auto-approve without prompting."
msgstr "Aprova automaticamente sem solicitar confirmação."

msgctxt "settings schema"
msgid "Auto-reject with an error."
msgstr "Rejeita automaticamente com um erro."

msgctxt "settings schema"
msgid "Automatically detect the conda manager"
msgstr "Detectar automaticamente o gerenciador conda"

msgctxt "settings schema"
msgid "Autosave when focus changes."
msgstr "Salva automaticamente quando o foco muda."

msgctxt "settings schema"
msgid "Autosave when the active window changes."
msgstr "Salva automaticamente quando a janela ativa muda."

msgctxt "settings schema"
msgid "Background Color. Used for grounded surfaces like a panel or tab."
msgstr "Cor de fundo. Usada para superfícies de base, como um painel ou uma aba."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of a ghost element that should have the same background as the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Cor de fundo. Usada para o estado ativo de um elemento fantasma que deve ter o mesmo fundo da superfície em que está.\n\nOs estados ativos são acionados quando o botão do mouse é pressionado sobre um elemento ou quando a tecla Return ou outro ativador é pressionado."

msgctxt "settings schema"
msgid "Background Color. Used for the active state of an element that should have a different background than the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "Cor de fundo. Usada para o estado ativo de um elemento que deve ter um fundo diferente da superfície em que está.\n\nOs estados ativos são acionados quando o botão do mouse é pressionado sobre um elemento ou quando a tecla Return ou outro ativador é pressionado."

msgctxt "settings schema"
msgid "Background Color. Used for the app background and blank panels or windows."
msgstr "Cor de fundo. Usada para o fundo do aplicativo e painéis ou janelas em branco."

msgctxt "settings schema"
msgid "Background Color. Used for the area that shows where a dragged element will be dropped."
msgstr "Cor de fundo. Usada para a área que indica onde um elemento arrastado será solto."

msgctxt "settings schema"
msgid "Background Color. Used for the background of an element that should have a different background than the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have the same background as the surface it's on, use `ghost_element_background`."
msgstr "Cor de fundo. Usada para o fundo de um elemento que deve ter um fundo diferente da superfície em que está.\n\nOs elementos podem incluir: botões, campos de entrada, caixas de seleção, botões de opção...\n\nPara um elemento que deve ter o mesmo fundo da superfície em que está, use `ghost_element_background`."

msgctxt "settings schema"
msgid "Background Color. Used for the background of selections in a UI element."
msgstr "Cor de fundo. Usada para o fundo das seleções em um elemento de interface."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of a ghost element that should have the same background as the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Cor de fundo. Usada para o estado desabilitado de um elemento fantasma que deve ter o mesmo fundo da superfície em que está.\n\nOs estados desabilitados são mostrados quando o usuário não pode interagir com um elemento, como um botão ou campo de entrada desabilitado."

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of an element that should have a different background than the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "Cor de fundo. Usada para o estado desabilitado de um elemento que deve ter um fundo diferente da superfície em que está.\n\nOs estados desabilitados são mostrados quando o usuário não pode interagir com um elemento, como um botão ou campo de entrada desabilitado."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of a ghost element that should have the same background as the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Cor de fundo. Usada para o estado ao passar o cursor de um elemento fantasma que deve ter o mesmo fundo da superfície em que está.\n\nOs estados ao passar o cursor são acionados quando o mouse entra em um elemento ou quando um dedo toca um elemento em uma tela sensível ao toque."

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of an element that should have a different background than the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "Cor de fundo. Usada para o estado ao passar o cursor de um elemento que deve ter um fundo diferente da superfície em que está.\n\nOs estados ao passar o cursor são acionados quando o mouse entra em um elemento ou quando um dedo toca um elemento em uma tela sensível ao toque."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of a ghost element that should have the same background as the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Cor de fundo. Usada para o estado selecionado de um elemento fantasma que deve ter o mesmo fundo da superfície em que está.\n\nOs estados selecionados são acionados quando o elemento é selecionado (ou \"ativado\") pelo usuário.\n\nIsso pode incluir uma caixa de seleção marcada, um botão alternável que está ativado etc."

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of an element that should have a different background than the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "Cor de fundo. Usada para o estado selecionado de um elemento que deve ter um fundo diferente da superfície em que está.\n\nOs estados selecionados são acionados quando o elemento é selecionado (ou \"ativado\") pelo usuário.\n\nIsso pode incluir uma caixa de seleção marcada, um botão alternável que está ativado etc."

msgctxt "settings schema"
msgid "Background color for Vim Helix Normal mode indicator."
msgstr "Cor de fundo do indicador do modo Normal do Vim Helix."

msgctxt "settings schema"
msgid "Background color for Vim Helix Select mode indicator."
msgstr "Cor de fundo do indicador do modo Select do Vim Helix."

msgctxt "settings schema"
msgid "Background color for Vim Insert mode indicator."
msgstr "Cor de fundo do indicador do modo Insert do Vim."

msgctxt "settings schema"
msgid "Background color for Vim Normal mode indicator."
msgstr "Cor de fundo do indicador do modo Normal do Vim."

msgctxt "settings schema"
msgid "Background color for Vim Replace mode indicator."
msgstr "Cor de fundo do indicador do modo Replace do Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual Block mode indicator."
msgstr "Cor de fundo do indicador do modo Visual Block do Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual Line mode indicator."
msgstr "Cor de fundo do indicador do modo Visual Line do Vim."

msgctxt "settings schema"
msgid "Background color for Vim Visual mode indicator."
msgstr "Cor de fundo do indicador do modo Visual do Vim."

msgctxt "settings schema"
msgid "Background color for Vim yank highlight."
msgstr "Cor de fundo do destaque de yank do Vim."

msgctxt "settings schema"
msgid "Background color for row highlights of \"ours\" regions in merge conflicts."
msgstr "Cor de fundo para os destaques de linha das regiões \"ours\" em conflitos de merge."

msgctxt "settings schema"
msgid "Background color for row highlights of \"theirs\" regions in merge conflicts."
msgstr "Cor de fundo para os destaques de linha das regiões \"theirs\" em conflitos de merge."

msgctxt "settings schema"
msgid "Background color. Used for elevated surfaces, like a context menu, popup, or dialog."
msgstr "Cor de fundo. Usada para superfícies elevadas, como um menu de contexto, pop-up ou caixa de diálogo."

msgctxt "settings schema"
msgid "Background of active line of debugger"
msgstr "Fundo da linha ativa do depurador"

msgctxt "settings schema"
msgid "Base key bindings scheme. Base keymaps can be overridden with user keymaps.\n\nDefault: Zed"
msgstr "Esquema base de associações de teclas. Os mapas de teclas base podem ser substituídos pelos mapas de teclas do usuário.\n\nPadrão: Zed"

msgctxt "settings schema"
msgid "Be smart and search for ignored when called from a gitignored worktree"
msgstr "Pesquisa de forma inteligente por arquivos ignorados quando a busca é iniciada em uma árvore de trabalho ignorada pelo Git"

msgctxt "settings schema"
msgid "Behave as a regular buffer and select the whole word."
msgstr "Comporta-se como um buffer normal e seleciona a palavra inteira."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text after the cursor is a suffix of the completion, and like\n`\"insert\"` otherwise."
msgstr "Comporta-se como `\"replace\"` se o texto após o cursor for um sufixo do preenchimento automático e como `\"insert\"` caso contrário."

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text that would be replaced is a subsequence of the completion text,\nand like `\"insert\"` otherwise."
msgstr "Comporta-se como `\"replace\"` se o texto que seria substituído for uma subsequência do texto do preenchimento automático e como `\"insert\"` caso contrário."

msgctxt "settings schema"
msgid "Black ANSI terminal color."
msgstr "Cor preta ANSI do terminal."

msgctxt "settings schema"
msgid "Block cursor that surrounds the character."
msgstr "Cursor de bloco que envolve o caractere."

msgctxt "settings schema"
msgid "Blue ANSI terminal color."
msgstr "Cor azul do terminal ANSI."

msgctxt "settings schema"
msgid "Border Color. Used for the border that shows where a dragged element will be dropped."
msgstr "Cor da borda. Usada para a borda que mostra onde um elemento arrastado será solto."

msgctxt "settings schema"
msgid "Border color. Used for deemphasized borders, like a visual divider between two sections"
msgstr "Cor da borda. Usada para bordas menos destacadas, como um divisor visual entre duas seções."

msgctxt "settings schema"
msgid "Border color. Used for disabled elements, like a disabled input or button."
msgstr "Cor da borda. Usada para elementos desabilitados, como um campo de entrada ou botão desabilitado."

msgctxt "settings schema"
msgid "Border color. Used for focused elements, like keyboard focused list item."
msgstr "Cor da borda. Usada para elementos com foco, como um item de lista com foco pelo teclado."

msgctxt "settings schema"
msgid "Border color. Used for most borders, is usually a high contrast color."
msgstr "Cor da borda. Usada na maioria das bordas, geralmente é uma cor de alto contraste."

msgctxt "settings schema"
msgid "Border color. Used for selected elements, like an active search filter or selected checkbox."
msgstr "Cor da borda. Usada para elementos selecionados, como um filtro de pesquisa ativo ou caixa de seleção marcada."

msgctxt "settings schema"
msgid "Border color. Used for transparent borders. Used for placeholder borders when an element gains a border on state change."
msgstr "Cor da borda. Usada para bordas transparentes. Usada como borda de reserva quando um elemento ganha uma borda ao mudar de estado."

msgctxt "settings schema"
msgid "Bright black ANSI terminal color."
msgstr "Cor preta brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Bright blue ANSI terminal color."
msgstr "Cor azul brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Bright cyan ANSI terminal color."
msgstr "Cor ciano brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Bright green ANSI terminal color."
msgstr "Cor verde brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Bright magenta ANSI terminal color."
msgstr "Cor magenta brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Bright red ANSI terminal color."
msgstr "Cor vermelha brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Bright terminal foreground color."
msgstr "Cor de primeiro plano brilhante do terminal."

msgctxt "settings schema"
msgid "Bright white ANSI terminal color."
msgstr "Cor branca brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Bright yellow ANSI terminal color."
msgstr "Cor amarela brilhante do terminal ANSI."

msgctxt "settings schema"
msgid "Byte budget for a repository map prepended to the agent's system prompt,\nright after the list of project root directories. `0` disables it.\nValues above 32768 are clamped to 32768.\n\nDefault: 0"
msgstr "Orçamento em bytes para um mapa do repositório inserido no prompt do sistema do agente, logo após a lista de diretórios raiz do projeto. `0` o desabilita.\nValores acima de 32768 são limitados a 32768.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "Callees left out of the list of a function's callees, such as logging\nand assertion macros. A row at the end counts them and shows them on\nrequest.\n\nDefault: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"
msgstr "Chamados deixados fora da lista de chamados de uma função, como macros de log e de asserção. Uma linha no final mostra a contagem e os exibe quando solicitado.\n\nPadrão: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"

msgctxt "settings schema"
msgid "Case-insensitive natural sort with lowercase preferred in ties.\nNumbers in file names are compared by value (e.g., `file2` before `file10`)."
msgstr "Ordenação natural sem diferenciar maiúsculas e minúsculas, com preferência para minúsculas em empates.\nOs números nos nomes de arquivo são comparados pelo valor (ex.: `file2` antes de `file10`)."

msgctxt "settings schema"
msgid "Centered layout related setting (left/right)."
msgstr "Configuração relacionada ao layout centralizado (esquerda/direita)."

msgctxt "settings schema"
msgid "Centered layout related settings."
msgstr "Configurações relacionadas ao layout centralizado."

msgctxt "settings schema"
msgid "Character counts at which to show wrap guides in the editor.\n\nDefault: []"
msgstr "Contagens de caracteres nas quais mostrar guias de quebra de linha no editor.\n\nPadrão: []"

msgctxt "settings schema"
msgid "Close the window when there are no tabs"
msgstr "Fecha a janela quando não há abas"

msgctxt "settings schema"
msgid "Color for added words in word diffs."
msgstr "Cor para palavras adicionadas em diffs por palavra."

msgctxt "settings schema"
msgid "Color for deleted words in word diffs."
msgstr "Cor para palavras excluídas em diffs por palavra."

msgctxt "settings schema"
msgid "Color used to accent some of the debuggers elements\nOnly accent breakpoint & breakpoint related symbols right now"
msgstr "Cor usada para dar destaque a alguns elementos do depurador.\nNo momento, destaca apenas pontos de interrupção e símbolos relacionados a pontos de interrupção."

msgctxt "settings schema"
msgid "Comfortable spacing of entries."
msgstr "Espaçamento confortável das entradas."

msgctxt "settings schema"
msgid "Command to automatically run when Zed creates a Terminal Thread shell in the agent panel.\nThe command is sent to the shell as if typed, so it is interpreted by your\nconfigured shell (including on Windows and remote/WSL projects).\nAn empty string disables this behavior.\n\nDefault: \"\""
msgstr "Comando a executar automaticamente quando o ForgeKairos cria um shell de conversa de terminal no painel do agente.\nO comando é enviado ao shell como se tivesse sido digitado, portanto é interpretado pelo shell configurado (inclusive no Windows e em projetos remotos/WSL).\nUma string vazia desabilita esse comportamento.\n\nPadrão: \"\""

msgctxt "settings schema"
msgid "Common language server settings."
msgstr "Configurações comuns do servidor de linguagem."

msgctxt "settings schema"
msgid "Configuration for Debugger-related features"
msgstr "Configuração para recursos relacionados ao depurador"

msgctxt "settings schema"
msgid "Configuration for Diagnostics-related features."
msgstr "Configuração para recursos relacionados a diagnósticos."

msgctxt "settings schema"
msgid "Configuration for Git-related features"
msgstr "Configuração para recursos relacionados ao Git"

msgctxt "settings schema"
msgid "Configuration for Node-related features"
msgstr "Configuração para recursos relacionados ao Node"

msgctxt "settings schema"
msgid "Configuration for caching language model messages."
msgstr "Configuração para armazenamento em cache de mensagens do modelo de linguagem."

msgctxt "settings schema"
msgid "Configuration for developer-oriented instrumentation tools that collect\ndiagnostic data about a running Zed instance."
msgstr "Configuração das ferramentas de instrumentação voltadas a desenvolvedores que coletam dados de diagnóstico sobre uma instância do ForgeKairos em execução."

msgctxt "settings schema"
msgid "Configuration for how direnv configuration should be loaded"
msgstr "Define como a configuração do direnv deve ser carregada"

msgctxt "settings schema"
msgid "Configuration for language servers.\n\nThe following settings can be overridden for specific language servers:\n- initialization_options\n\nTo override settings for a language, add an entry for that language server's\nname to the lsp value.\nDefault: null"
msgstr "Configuração dos servidores de linguagem.\n\nAs seguintes configurações podem ser substituídas para servidores de linguagem específicos:\n- initialization_options\n\nPara substituir as configurações de uma linguagem, adicione ao valor lsp uma entrada com o nome do servidor de linguagem.\nPadrão: null"

msgctxt "settings schema"
msgid "Configuration for session-related features"
msgstr "Configuração para recursos relacionados à sessão"

msgctxt "settings schema"
msgid "Configuration for the collab panel visual settings."
msgstr "Configurações visuais do painel de colaboração."

msgctxt "settings schema"
msgid "Configuration for the performance profiler which collects timing data\nfor foreground and background executor tasks."
msgstr "Configuração do criador de perfil de desempenho, que coleta dados de tempo das tarefas dos executores em primeiro e segundo plano."

msgctxt "settings schema"
msgid "Configuration for the performance profiler, accessed via the\n`zed: open performance profiler` action."
msgstr "Configuração do criador de perfil de desempenho, acessado pela ação `zed: open performance profiler`."

msgctxt "settings schema"
msgid "Configuration of Anthropic's caching API."
msgstr "Configuração da API de cache da Anthropic."

msgctxt "settings schema"
msgid "Configuration of audio in Zed."
msgstr "Configuração de áudio no ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of the terminal in Zed."
msgstr "Configuração do terminal no ForgeKairos."

msgctxt "settings schema"
msgid "Configuration of voice calls in Zed."
msgstr "Configuração de chamadas de voz no ForgeKairos."

msgctxt "settings schema"
msgid "Configures what draws Zed's window decorations on Linux.\nThis setting has no effect on other platforms."
msgstr "Configura o que desenha as decorações da janela do ForgeKairos no Linux.\nEsta configuração não tem efeito em outras plataformas."

msgctxt "settings schema"
msgid "Conflict version control color."
msgstr "Cor de conflito do controle de versão."

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `Authorization` header is sent and the\nprovider counts as configured without a keychain entry.\n\nDefault: false"
msgstr "Conecta sem nenhuma credencial, para servidores que não exigem autenticação. Quando definido, nenhum cabeçalho `Authorization` é enviado e o provedor é considerado configurado sem uma entrada no chaveiro.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `x-api-key` header is sent and the provider\ncounts as configured without a keychain entry.\n\nDefault: false"
msgstr "Conecta sem nenhuma credencial, para servidores que não exigem autenticação. Quando definido, nenhum cabeçalho `x-api-key` é enviado e o provedor é considerado configurado sem uma entrada no chaveiro.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Contained between the left and right docks"
msgstr "Contido entre os docks esquerdo e direito"

msgctxt "settings schema"
msgid "Control what info is collected by Zed."
msgstr "Controla quais informações são coletadas pelo Zed."

msgctxt "settings schema"
msgid "Controls automatic indentation behavior when typing.\n\n- \"syntax_aware\": Adjusts indentation based on syntax context (default)\n- \"preserve_indent\": Preserves current line's indentation on new lines\n- \"none\": No automatic indentation\n\nDefault: syntax_aware"
msgstr "Controla o comportamento do recuo automático ao digitar.\n\n- \"syntax_aware\": ajusta o recuo com base no contexto da sintaxe (padrão)\n- \"preserve_indent\": preserva o recuo da linha atual nas novas linhas\n- \"none\": sem recuo automático\n\nPadrão: syntax_aware"

msgctxt "settings schema"
msgid "Controls how LSP completions are inserted.\n\nDefault: \"replace_suffix\""
msgstr "Controla como os preenchimentos automáticos do LSP são inseridos.\n\nPadrão: \"replace_suffix\""

msgctxt "settings schema"
msgid "Controls how completions are processed for this language."
msgstr "Controla como os preenchimentos automáticos são processados para esta linguagem."

msgctxt "settings schema"
msgid "Controls how document's words are completed."
msgstr "Controla como as palavras do documento são completadas."

msgctxt "settings schema"
msgid "Controls how line endings are normalized when a buffer is saved."
msgstr "Controla como as terminações de linha são normalizadas ao salvar um buffer."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting."
msgstr "Controla como os tokens semânticos dos servidores de linguagem são usados para o destaque de sintaxe."

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting.\n\nOptions:\n- \"off\": Do not request semantic tokens from language servers.\n- \"combined\": Use LSP semantic tokens together with tree-sitter highlighting.\n- \"full\": Use LSP semantic tokens exclusively, replacing tree-sitter highlighting.\n\nDefault: \"off\""
msgstr "Controla como os tokens semânticos dos servidores de linguagem são usados para o destaque de sintaxe.\n\nOpções:\n- \"off\": não solicita tokens semânticos aos servidores de linguagem.\n- \"combined\": usa os tokens semânticos do LSP junto com o destaque do Tree-sitter.\n- \"full\": usa exclusivamente os tokens semânticos do LSP, substituindo o destaque do Tree-sitter.\n\nPadrão: \"off\""

msgctxt "settings schema"
msgid "Controls how the editor handles the autoclosed characters.\nWhen set to `false`(default), skipping over and auto-removing of the closing characters\nhappen only for auto-inserted characters.\nOtherwise(when `true`), the closing characters are always skipped over and auto-removed\nno matter how they were inserted.\n\nDefault: false"
msgstr "Controla como o editor trata os caracteres de fechamento automático.\nQuando definido como `false` (padrão), pular e remover automaticamente os caracteres de fechamento acontece apenas para caracteres inseridos automaticamente.\nCaso contrário (quando `true`), os caracteres de fechamento são sempre pulados e removidos automaticamente, não importa como foram inseridos.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Controls how whitespace should be displayedin the editor."
msgstr "Controla como os espaços em branco devem ser exibidos no editor."

msgctxt "settings schema"
msgid "Controls how words are completed.\nFor large documents, not all words may be fetched for completion.\n\nDefault: `fallback`"
msgstr "Controla como as palavras são completadas.\nEm documentos grandes, nem todas as palavras podem ser obtidas para o preenchimento automático.\n\nPadrão: `fallback`"

msgctxt "settings schema"
msgid "Controls previous session restoration in freshly launched Zed instance.\nValues: empty_tab, last_workspace, last_session, launchpad\nDefault: last_session"
msgstr "Controla a restauração da sessão anterior em uma instância do ForgeKairos recém-iniciada.\nValores: empty_tab, last_workspace, last_session, launchpad\nPadrão: last_session"

msgctxt "settings schema"
msgid "Controls the soft-wrapping behavior in the editor."
msgstr "Controla o comportamento de quebra automática de linha no editor."

msgctxt "settings schema"
msgid "Controls the source of document symbols used for outlines and breadcrumbs.\n\nOptions:\n- \"off\": Use tree-sitter queries to compute document symbols (default).\n- \"on\": Use the language server's `textDocument/documentSymbol` LSP response. When enabled, tree-sitter is not used for document symbols.\n\nDefault: \"off\""
msgstr "Controla a origem dos símbolos do documento usados para a estrutura e as trilhas de navegação.\n\nOpções:\n- \"off\": usa consultas do Tree-sitter para calcular os símbolos do documento (padrão).\n- \"on\": usa a resposta LSP `textDocument/documentSymbol` do servidor de linguagem. Quando habilitado, o Tree-sitter não é usado para os símbolos do documento.\n\nPadrão: \"off\""

msgctxt "settings schema"
msgid "Controls the width of the git diff hunk indicators in the gutter."
msgstr "Controla a largura dos indicadores de blocos de diff do Git na medianiz."

msgctxt "settings schema"
msgid "Controls when to use system clipboard."
msgstr "Controla quando usar a área de transferência do sistema."

msgctxt "settings schema"
msgid "Controls where the `editor::Rewrap` action is allowed for this language.\n\nNote: This setting has no effect in Vim mode, as rewrap is already\nallowed everywhere.\n\nDefault: \"in_comments\""
msgstr "Controla onde a ação `editor::Rewrap` é permitida para esta linguagem.\n\nObservação: esta configuração não tem efeito no modo Vim, pois refazer a quebra já é permitido em todos os lugares.\n\nPadrão: \"in_comments\""

msgctxt "settings schema"
msgid "Controls whether Zed collects training data when using Zed's Edit Predictions."
msgstr "Controla se o Zed coleta dados de treinamento ao usar as previsões de edição do Zed."

msgctxt "settings schema"
msgid "Controls whether Zed may collect training data when using Zed's Edit Predictions.\nData is only ever captured for files in projects that are detected as open source.\n\n- `\"default\"`: use the preference previously set via the status-bar toggle,\n  or false if no preference has been stored.\n- `\"yes\"`: allow data collection for files in open-source projects.\n- `\"no\"`: never allow data collection."
msgstr "Controla se o Zed pode coletar dados de treinamento ao usar as previsões de edição do Zed.\nOs dados só são capturados para arquivos em projetos detectados como de código aberto.\n\n- `\"default\"`: usa a preferência definida anteriormente pela alternância da barra de status, ou false se nenhuma preferência tiver sido armazenada.\n- `\"yes\"`: permite a coleta de dados para arquivos em projetos de código aberto.\n- `\"no\"`: nunca permite a coleta de dados."

msgctxt "settings schema"
msgid "Controls whether Zed or the window manager or compositor draws window decorations on Linux.\n\nDefault: client"
msgstr "Controla se o ForgeKairos, o gerenciador de janelas ou o compositor desenha as decorações da janela no Linux.\n\nPadrão: client"

msgctxt "settings schema"
msgid "Controls whether edit predictions are shown immediately (true)\nor manually by triggering `editor::ShowEditPrediction` (false).\n\nDefault: true"
msgstr "Controla se as previsões de edição são mostradas imediatamente (true) ou manualmente, acionando `editor::ShowEditPrediction` (false).\n\nPadrão: true"

msgctxt "settings schema"
msgid "Controls whether folding ranges from language servers are used instead of\ntree-sitter and indent-based folding.\n\nOptions:\n- \"off\": Use tree-sitter and indent-based folding (default).\n- \"on\": Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server.\n\nDefault: \"off\""
msgstr "Controla se os intervalos de dobra dos servidores de linguagem são usados em vez da dobra baseada no Tree-sitter e no recuo.\n\nOpções:\n- \"off\": usa a dobra baseada no Tree-sitter e no recuo (padrão).\n- \"on\": usa a dobra do LSP sempre que possível, recorrendo à dobra baseada no Tree-sitter e no recuo quando o servidor não retorna resultados.\n\nPadrão: \"off\""

msgctxt "settings schema"
msgid "Controls which formatter should be used when formatting code. If there are multiple formatters, they are executed in the order of declaration."
msgstr "Controla qual formatador deve ser usado ao formatar código. Se houver vários formatadores, eles são executados na ordem de declaração."

msgctxt "settings schema"
msgid "Controls which formatters should be used when formatting code."
msgstr "Controla quais formatadores devem ser usados ao formatar código."

msgctxt "settings schema"
msgid "Cursor is a block like `█`."
msgstr "O cursor tem formato de bloco como `█`."

msgctxt "settings schema"
msgid "Cursor is a hollow box like `▯`."
msgstr "O cursor tem formato de caixa vazada como `▯`."

msgctxt "settings schema"
msgid "Cursor is a vertical bar like `⎸`."
msgstr "O cursor tem formato de barra vertical como `⎸`."

msgctxt "settings schema"
msgid "Cursor is an underscore like `_`."
msgstr "O cursor tem formato de sublinhado como `_`."

msgctxt "settings schema"
msgid "Cursor movement animation settings."
msgstr "Configurações de animação de movimento do cursor."

msgctxt "settings schema"
msgid "Cursor shape configuration for insert mode in Vim."
msgstr "Configuração da forma do cursor para o modo de inserção no Vim."

msgctxt "settings schema"
msgid "Cursor shape for the default editor.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: bar"
msgstr "Formato do cursor do editor padrão.\nPode ser \"bar\", \"block\", \"underline\" ou \"hollow\".\n\nPadrão: bar"

msgctxt "settings schema"
msgid "Cursor shape for the insert mode.\n\nThe default value follows the primary cursor_shape."
msgstr "Formato do cursor no modo de inserção.\n\nO valor padrão segue o cursor_shape principal."

msgctxt "settings schema"
msgid "Cursor shape for the normal mode.\n\nDefault: block"
msgstr "Formato do cursor no modo normal.\n\nPadrão: block"

msgctxt "settings schema"
msgid "Cursor shape for the replace mode.\n\nDefault: underline"
msgstr "Formato do cursor no modo de substituição.\n\nPadrão: underline"

msgctxt "settings schema"
msgid "Cursor shape for the visual mode.\n\nDefault: block"
msgstr "Formato do cursor no modo visual.\n\nPadrão: block"

msgctxt "settings schema"
msgid "Custom Model API URL to use for this model."
msgstr "URL da API do modelo personalizado a usar para este modelo."

msgctxt "settings schema"
msgid "Custom instructions to include in the prompt when generating git commit messages.\nApplied in addition to any project rules files (such as `.rules` or `AGENTS.md`)."
msgstr "Instruções personalizadas a incluir no prompt ao gerar mensagens de commit do Git.\nAplicadas além de quaisquer arquivos de regras do projeto (como `.rules` ou `AGENTS.md`)."

msgctxt "settings schema"
msgid "Custom models served through the `bedrock-mantle` endpoint's\nOpenAI-compatible APIs, in addition to the built-in Mantle models\n(GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."
msgstr "Modelos personalizados servidos pelas APIs compatíveis com OpenAI do endpoint `bedrock-mantle`, além dos modelos Mantle integrados (GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."

msgctxt "settings schema"
msgid "Custom rules for rendering LSP semantic tokens."
msgstr "Regras personalizadas para renderizar tokens semânticos do LSP."

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by outline panel\n\nDefault: 240"
msgstr "Personaliza a largura padrão (em pixels) ocupada pelo painel de estrutura\n\nPadrão: 240"

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by project panel\n\nDefault: 240"
msgstr "Personaliza a largura padrão (em pixels) ocupada pelo painel do projeto\n\nPadrão: 240"

msgctxt "settings schema"
msgid "Cyan ANSI terminal color."
msgstr "Cor ciano do terminal ANSI."

msgctxt "settings schema"
msgid "Default action when clicking a changed file in the Git panel.\n\nDefault: project_diff"
msgstr "Ação padrão ao clicar em um arquivo alterado no painel do Git.\n\nPadrão: project_diff"

msgctxt "settings schema"
msgid "Default cursor shape for the terminal.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: \"block\""
msgstr "Formato padrão do cursor do terminal.\nPode ser \"bar\", \"block\", \"underline\" ou \"hollow\".\n\nPadrão: \"block\""

msgctxt "settings schema"
msgid "Default depth to expand outline items in the current file.\nThe default depth to which outline entries are expanded on reveal.\n- Set to 0 to collapse all items that have children\n- Set to 1 or higher to collapse items at that depth or deeper\n\nDefault: 100"
msgstr "Profundidade padrão para expandir os itens da estrutura no arquivo atual.\nA profundidade padrão até a qual as entradas da estrutura são expandidas ao serem reveladas.\n- Defina como 0 para recolher todos os itens que têm filhos\n- Defina como 1 ou mais para recolher os itens nessa profundidade ou mais profundos\n\nPadrão: 100"

msgctxt "settings schema"
msgid "Default directories to search for virtual environments, relative\nto the current working directory. We recommend overriding this\nin your project's settings, rather than globally."
msgstr "Diretórios padrão onde procurar ambientes virtuais, relativos ao diretório de trabalho atual. Recomendamos substituir isto nas configurações do projeto, em vez de globalmente."

msgctxt "settings schema"
msgid "Default fixed width in pixels when the agent panel is docked to the left or right and\n`flexible` is false.\n\nDefault: 640"
msgstr "Largura fixa padrão em pixels quando o painel do agente está posicionado à esquerda ou à direita e `flexible` é false.\n\nPadrão: 640"

msgctxt "settings schema"
msgid "Default height in pixels when the AI browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Altura padrão em pixels quando o painel do navegador de IA está posicionado na parte inferior.\n\nPadrão: 320"

msgctxt "settings schema"
msgid "Default height in pixels when the agent panel is docked to the bottom.\n\nDefault: 320"
msgstr "Altura padrão em pixels quando o painel do agente está posicionado na parte inferior.\n\nPadrão: 320"

msgctxt "settings schema"
msgid "Default height in pixels when the browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "Altura padrão em pixels quando o painel do navegador está posicionado na parte inferior.\n\nPadrão: 320"

msgctxt "settings schema"
msgid "Default height when the terminal is docked to the bottom.\n\nDefault: 320"
msgstr "Altura padrão quando o terminal está posicionado na parte inferior.\n\nPadrão: 320"

msgctxt "settings schema"
msgid "Default is 1500ms."
msgstr "O padrão é 1500 ms."

msgctxt "settings schema"
msgid "Default kernels to select for each language.\n\nDefault: `{}`"
msgstr "Kernels padrão a selecionar para cada linguagem.\n\nPadrão: `{}`"

msgctxt "settings schema"
msgid "Default mode when no regex rules match.\nWhen unset, inherits from the global `tool_permissions.default`."
msgstr "Modo padrão quando nenhuma regra de regex corresponde.\nQuando não definido, herda do `tool_permissions.default` global."

msgctxt "settings schema"
msgid "Default options for buffer and project search items."
msgstr "Opções padrão para itens de pesquisa em buffer e projeto."

msgctxt "settings schema"
msgid "Default the cursor blink to off, but allow the terminal to\nset blinking."
msgstr "Desativa o piscar do cursor por padrão, mas permite que o terminal ative o piscar."

msgctxt "settings schema"
msgid "Default timeout in seconds for context server tool calls.\nCan be overridden per-server in context_servers configuration.\n\nDefault: 60"
msgstr "Tempo limite padrão, em segundos, para chamadas de ferramentas de servidores de contexto.\nPode ser substituído por servidor na configuração context_servers.\n\nPadrão: 60"

msgctxt "settings schema"
msgid "Default values for session config options.\n\nThis is a map from config option ID to the default value for that option.\n\nDefault: {}"
msgstr "Valores padrão para as opções de configuração da sessão.\n\nÉ um mapa do ID da opção de configuração para o valor padrão dessa opção.\n\nPadrão: {}"

msgctxt "settings schema"
msgid "Default width in pixels when the AI browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Largura padrão em pixels quando o painel do navegador de IA está posicionado à esquerda ou à direita.\n\nPadrão: 480"

msgctxt "settings schema"
msgid "Default width in pixels when the browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "Largura padrão em pixels quando o painel do navegador está posicionado à esquerda ou à direita.\n\nPadrão: 480"

msgctxt "settings schema"
msgid "Default width of the call graph panel in pixels.\n\nDefault: 320"
msgstr "Largura padrão do painel do grafo de chamadas em pixels.\n\nPadrão: 320"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 240"
msgstr "Largura padrão do painel em pixels.\n\nPadrão: 240"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 360"
msgstr "Largura padrão do painel em pixels.\n\nPadrão: 360"

msgctxt "settings schema"
msgid "Default width of the threads sidebar in pixels.\n\nValues range from 200 to 800, matching the widths the sidebar can be\ndragged to. Values outside that range are clamped into it.\n\nDefault: 300"
msgstr "Largura padrão da barra lateral de conversas em pixels.\n\nOs valores vão de 200 a 800, correspondendo às larguras para as quais a barra lateral pode ser arrastada. Valores fora desse intervalo são limitados a ele.\n\nPadrão: 300"

msgctxt "settings schema"
msgid "Default width when the terminal is docked to the left or right.\n\nDefault: 640"
msgstr "Largura padrão quando o terminal está posicionado à esquerda ou à direita.\n\nPadrão: 640"

msgctxt "settings schema"
msgid "Default: 0.2"
msgstr "Padrão: 0.2"

msgctxt "settings schema"
msgid "Default: {}"
msgstr "Padrão: {}"

msgctxt "settings schema"
msgid "Defaults to use when opening a new buffer and project search items.\n\nDefault: nothing is enabled"
msgstr "Padrões a usar ao abrir novos itens de pesquisa no buffer e no projeto.\n\nPadrão: nada habilitado"

msgctxt "settings schema"
msgid "Defines the border style for the minimap's scrollbar thumb.\n\nDefault: left_open"
msgstr "Define o estilo da borda do controle deslizante da barra de rolagem do minimapa.\n\nPadrão: left_open"

msgctxt "settings schema"
msgid "Delay in milliseconds before showing the which-key popup.\n\nDefault: 1000"
msgstr "Atraso em milissegundos antes de mostrar o pop-up which-key.\n\nPadrão: 1000"

msgctxt "settings schema"
msgid "Deleted version control color."
msgstr "Cor de controle de versão para itens excluídos."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_ours`."
msgstr "Obsoleto em favor de `version_control_conflict_marker_ours`."

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_theirs`."
msgstr "Obsoleto em favor de `version_control_conflict_marker_theirs`."

msgctxt "settings schema"
msgid "Deprecated: use None instead. Left to avoid breaking existing users' configs.\nPrefer a single line generally, unless an overly long line is encountered."
msgstr "Obsoleto: use None. Mantido para não quebrar as configurações de usuários existentes.\nPrefere uma única linha em geral, a menos que haja uma linha excessivamente longa."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored."
msgstr "Determina como os fundos das guias de recuo são coloridos."

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored.\n\nDefault: Disabled"
msgstr "Determina como os fundos das guias de recuo são coloridos.\n\nPadrão: Disabled"

msgctxt "settings schema"
msgid "Determines how indent guides are colored."
msgstr "Determina como as guias de recuo são coloridas."

msgctxt "settings schema"
msgid "Determines how indent guides are colored.\n\nDefault: Fixed"
msgstr "Determina como as guias de recuo são coloridas.\n\nPadrão: Fixed"

msgctxt "settings schema"
msgid "Determines how much space the call hierarchy picker can take up in relation to the available window width.\n\nDefault: medium"
msgstr "Determina quanto espaço o seletor da hierarquia de chamadas pode ocupar em relação à largura disponível da janela.\n\nPadrão: medium"

msgctxt "settings schema"
msgid "Determines how much space the file finder can take up in relation to the available window width.\n\nDefault: small"
msgstr "Determina quanto espaço o localizador de arquivos pode ocupar em relação à largura disponível da janela.\n\nPadrão: small"

msgctxt "settings schema"
msgid "Determines how snippets are sorted relative to other completion items.\n\nDefault: inline"
msgstr "Determina como os snippets são ordenados em relação aos outros itens de preenchimento automático.\n\nPadrão: inline"

msgctxt "settings schema"
msgid "Determines the modifier to be used to add multiple cursors with the mouse. The open hover link mouse gestures will adapt such that it do not conflict with the multicursor modifier.\n\nDefault: alt"
msgstr "Determina o modificador usado para adicionar vários cursores com o mouse. Os gestos do mouse para abrir links ao passar o cursor se adaptam para não conflitar com o modificador de vários cursores.\n\nPadrão: alt"

msgctxt "settings schema"
msgid "Determines the stepping granularity.\n\nDefault: line"
msgstr "Determina a granularidade da execução passo a passo.\n\nPadrão: line"

msgctxt "settings schema"
msgid "Determines what settings a profile starts from before applying its overrides."
msgstr "Determina de quais configurações um perfil parte antes de aplicar suas substituições."

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to\nkeyboard input. Applies globally across all input surfaces (editors,\nterminals, palettes, etc.).\n\nDefault: on_typing_and_action"
msgstr "Determina quando o cursor do mouse deve ser ocultado em resposta à entrada do teclado. Aplica-se globalmente a todas as superfícies de entrada (editores, terminais, paletas etc.).\n\nPadrão: on_typing_and_action"

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to keyboard\ninput.\n\nDefault: on_typing_and_action"
msgstr "Determina quando o cursor do mouse deve ser ocultado em resposta à entrada do teclado.\n\nPadrão: on_typing_and_action"

msgctxt "settings schema"
msgid "Determines whether the file finder should skip focus for the active file in search results.\n\nDefault: true"
msgstr "Determina se o localizador de arquivos deve deixar de focar o arquivo ativo nos resultados da pesquisa.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Determines whether to reduce non-essential motion in the UI, such as\nloading spinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Determina se o movimento não essencial na interface, como indicadores de carregamento giratórios e rótulos pulsantes, deve ser reduzido, renderizando-os em estado estático.\n\nPadrão: off"

msgctxt "settings schema"
msgid "Determines which edit prediction provider to use."
msgstr "Determina qual provedor de previsão de edição usar."

msgctxt "settings schema"
msgid "Diff against HEAD: show working (uncommitted) changes."
msgstr "Diff em relação ao HEAD: exibe alterações no diretório de trabalho (sem commit)."

msgctxt "settings schema"
msgid "Diff against the merge base between HEAD and the repository's\ndefault branch: show all changes on the branch.\n\nRepositories where no default branch can be resolved fall back\nto `head` behavior."
msgstr "Diff em relação à base de merge entre HEAD e o branch padrão do repositório: mostra todas as alterações no branch.\n\nRepositórios em que nenhum branch padrão pode ser resolvido recorrem ao comportamento `head`."

msgctxt "settings schema"
msgid "Dim black ANSI terminal color."
msgstr "Cor preta escurecida do terminal ANSI."

msgctxt "settings schema"
msgid "Dim blue ANSI terminal color."
msgstr "Cor azul escurecida do terminal ANSI."

msgctxt "settings schema"
msgid "Dim cyan ANSI terminal color."
msgstr "Cor ciano escurecida do terminal ANSI."

msgctxt "settings schema"
msgid "Dim green ANSI terminal color."
msgstr "Cor verde escurecida do terminal ANSI."

msgctxt "settings schema"
msgid "Dim magenta ANSI terminal color."
msgstr "Cor magenta escurecida do terminal ANSI."

msgctxt "settings schema"
msgid "Dim red ANSI terminal color."
msgstr "Cor vermelha escurecida do terminal ANSI."

msgctxt "settings schema"
msgid "Dim terminal foreground color."
msgstr "Cor de primeiro plano do terminal atenuada."

msgctxt "settings schema"
msgid "Dim white ANSI terminal color."
msgstr "Cor branca atenuada do terminal ANSI."

msgctxt "settings schema"
msgid "Dim yellow ANSI terminal color."
msgstr "Cor amarela atenuada do terminal ANSI."

msgctxt "settings schema"
msgid "Direction to split horizontally.\n\nDefault: \"up\""
msgstr "Direção da divisão horizontal.\n\nPadrão: \"up\""

msgctxt "settings schema"
msgid "Direction to split vertically.\n\nDefault: \"left\""
msgstr "Direção da divisão vertical.\n\nPadrão: \"left\""

msgctxt "settings schema"
msgid "Directory subtrees that sandboxed terminal commands may always write\nto without prompting. Each entry is either a bare path string or an\nobject `{requested, resolved}`; Zed writes objects (the canonical,\nsymlink-resolved target established at approval time), while\nhand-authored entries may be bare path strings. Paths written by Zed\nare absolute.\nDefault: []"
msgstr "Subárvores de diretório nas quais os comandos de terminal em sandbox sempre podem gravar sem perguntar. Cada entrada é uma string de caminho simples ou um objeto `{requested, resolved}`; o ForgeKairos grava objetos (o destino canônico, com links simbólicos resolvidos, estabelecido no momento da aprovação), enquanto as entradas escritas à mão podem ser strings de caminho simples. Os caminhos gravados pelo ForgeKairos são absolutos.\nPadrão: []"

msgctxt "settings schema"
msgid "Directory the log files are written to. `~` is expanded.\nWhen empty, logs go to Zed's log directory under `terminal-sessions`.\n\nDefault: \"\""
msgstr "Diretório onde os arquivos de log são gravados. `~` é expandido.\nQuando vazio, os logs vão para `terminal-sessions` no diretório de logs do ForgeKairos.\n\nPadrão: \"\""

msgctxt "settings schema"
msgid "Directory where git worktrees are created, relative to the repository\nworking directory.\n\nWhen the resolved directory is outside the project root, the\nproject's directory name is automatically appended so that\nsibling repos don't collide. For example, with the default\n`\"../worktrees\"` and a project at `~/code/zed`, worktrees are\ncreated under `~/code/worktrees/zed/`.\n\nWhen the resolved directory is inside the project root, no\nextra component is added (it's already project-scoped).\n\nExamples:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (default)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nTrailing slashes are ignored.\n\nDefault: ../worktrees"
msgstr "Diretório onde as árvores de trabalho do Git são criadas, relativo ao diretório de trabalho do repositório.\n\nQuando o diretório resolvido está fora da raiz do projeto, o nome do diretório do projeto é acrescentado automaticamente para que repositórios irmãos não colidam. Por exemplo, com o padrão `\"../worktrees\"` e um projeto em `~/code/zed`, as árvores de trabalho são criadas em `~/code/worktrees/zed/`.\n\nQuando o diretório resolvido está dentro da raiz do projeto, nenhum componente extra é adicionado (ele já tem o escopo do projeto).\n\nExemplos:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (padrão)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nBarras no final são ignoradas.\n\nPadrão: ../worktrees"

msgctxt "settings schema"
msgid "Disable autosave."
msgstr "Desabilita o salvamento automático."

msgctxt "settings schema"
msgid "Disable certificate verification for the proxy (not recommended).\n\nDefault: false"
msgstr "Desabilita a verificação de certificado do proxy (não recomendado).\n\nPadrão: false"

msgctxt "settings schema"
msgid "Disable edit predictions for files matching these glob patterns.\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged.\n\nRelative patterns are matched against paths relative to the worktree root.\nAbsolute patterns are matched against absolute paths. A leading `~` is\nexpanded to your home folder."
msgstr "Desabilita as previsões de edição para arquivos que correspondem a estes padrões glob.\n\nUse `\"...\"` para adicionar padrões sem repetir os padrões do ForgeKairos. Nas configurações do projeto, ele estende o valor da configuração do usuário ou da configuração pai. Omita `\"...\"` para substituir a lista herdada.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nOs padrões herdados são inseridos em `\"...\"`, e os duplicados mantêm a primeira ocorrência.\n\nDefina `[]` para limpar a lista herdada. Omita esta configuração para herdá-la sem alterações.\n\nOs padrões relativos são comparados com caminhos relativos à raiz da árvore de trabalho.\nOs padrões absolutos são comparados com caminhos absolutos. Um `~` inicial é expandido para a sua pasta pessoal."

msgctxt "settings schema"
msgid "Disable edit predictions in these language scopes, such as \"comment\" and\n\"string\".\n\nDefault:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` to add scopes without repeating the inherited list. In project\nsettings, it extends the user or parent configuration value. In\nlanguage-specific settings, it extends the scopes inherited by that\nlanguage. Omit `\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nInherited scopes are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged."
msgstr "Desabilita as previsões de edição nestes escopos de linguagem, como \"comment\" e \"string\".\n\nPadrão:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` para adicionar escopos sem repetir a lista herdada. Nas configurações do projeto, ele estende o valor da configuração do usuário ou da configuração pai. Nas configurações específicas de uma linguagem, ele estende os escopos herdados por essa linguagem. Omita `\"...\"` para substituir a lista herdada.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nOs escopos herdados são inseridos em `\"...\"`, e os duplicados mantêm a primeira ocorrência.\n\nDefina `[]` para limpar a lista herdada. Omita esta configuração para herdá-la sem alterações."

msgctxt "settings schema"
msgid "Disables the fallback."
msgstr "Desabilita o fallback."

msgctxt "settings schema"
msgid "Disables the tooltip"
msgstr "Desabilita a dica de ferramenta"

msgctxt "settings schema"
msgid "Discards the changes."
msgstr "Descarta as alterações."

msgctxt "settings schema"
msgid "Display code lenses from language servers above code elements."
msgstr "Exibe CodeLens dos servidores de linguagem acima dos elementos de código."

msgctxt "settings schema"
msgid "Display code lenses in the code action menu."
msgstr "Exibe CodeLens no menu de ações de código."

msgctxt "settings schema"
msgid "Display inline when there are no language server completions available."
msgstr "Exibe as previsões de forma embutida quando não há preenchimentos automáticos do servidor de linguagem disponíveis."

msgctxt "settings schema"
msgid "Displays a border on all sides except the left side of the thumb."
msgstr "Exibe uma borda em todos os lados, exceto no lado esquerdo do controle deslizante."

msgctxt "settings schema"
msgid "Displays a border on all sides except the right side of the thumb."
msgstr "Exibe uma borda em todos os lados, exceto no lado direito do controle deslizante."

msgctxt "settings schema"
msgid "Displays a border on all sides of the thumb."
msgstr "Exibe uma borda em todos os lados do controle deslizante."

msgctxt "settings schema"
msgid "Displays a border only on the left side of the thumb."
msgstr "Exibe uma borda somente no lado esquerdo do controle deslizante."

msgctxt "settings schema"
msgid "Displays file size in binary units (e.g., KiB, MiB)."
msgstr "Exibe o tamanho do arquivo em unidades binárias (ex.: KiB, MiB)."

msgctxt "settings schema"
msgid "Displays file size in decimal units (e.g., KB, MB)."
msgstr "Exibe o tamanho do arquivo em unidades decimais (ex.: KB, MB)."

msgctxt "settings schema"
msgid "Displays the thumb without any border."
msgstr "Exibe o controle deslizante sem nenhuma borda."

msgctxt "settings schema"
msgid "Do not draw any tabs or spaces."
msgstr "Não exibe tabulações nem espaços."

msgctxt "settings schema"
msgid "Do not format code."
msgstr "Não formata o código."

msgctxt "settings schema"
msgid "Do not load direnv configuration"
msgstr "Não carrega a configuração do direnv"

msgctxt "settings schema"
msgid "Do not play any sound."
msgstr "Não reproduz nenhum som."

msgctxt "settings schema"
msgid "Do not query and display code lenses."
msgstr "Não consulta nem exibe CodeLens."

msgctxt "settings schema"
msgid "Do not query and render document colors."
msgstr "Não consulta nem renderiza cores do documento."

msgctxt "settings schema"
msgid "Do not render any background for indent guides."
msgstr "Não renderiza nenhum plano de fundo para as guias de recuo."

msgctxt "settings schema"
msgid "Do not render any lines for indent guides."
msgstr "Não renderiza nenhuma linha para as guias de recuo."

msgctxt "settings schema"
msgid "Do not request folding ranges from language servers; use tree-sitter and indent-based folding."
msgstr "Não solicita intervalos de dobra dos servidores de linguagem; usa a dobra baseada no Tree-sitter e no recuo."

msgctxt "settings schema"
msgid "Do not request semantic tokens from language servers."
msgstr "Não solicita tokens semânticos dos servidores de linguagem."

msgctxt "settings schema"
msgid "Do not show diagnostics."
msgstr "Não exibe diagnósticos."

msgctxt "settings schema"
msgid "Do not show snippets in the completion list"
msgstr "Não exibe snippets na lista de preenchimento automático"

msgctxt "settings schema"
msgid "Don't list untracked files at all."
msgstr "Não lista nenhum arquivo não rastreado."

msgctxt "settings schema"
msgid "Don't use system clipboard."
msgstr "Não usa a área de transferência do sistema."

msgctxt "settings schema"
msgid "Drag and drop related settings"
msgstr "Configurações relacionadas a arrastar e soltar"

msgctxt "settings schema"
msgid "Draw a background behind the color text."
msgstr "Desenha um plano de fundo atrás do texto de cor."

msgctxt "settings schema"
msgid "Draw a border around the color text."
msgstr "Desenha uma borda ao redor do texto de cor."

msgctxt "settings schema"
msgid "Draw all invisible symbols."
msgstr "Desenha todos os símbolos invisíveis."

msgctxt "settings schema"
msgid "Draw whitespace only for the selected text."
msgstr "Desenha espaços em branco somente para o texto selecionado."

msgctxt "settings schema"
msgid "Draw whitespaces at boundaries only.\n\nFor a whitespace to be on a boundary, any of the following conditions need to be met:\n- It is a tab\n- It is adjacent to an edge (start or end)\n- It is adjacent to a whitespace (left or right)"
msgstr "Desenha espaços em branco somente nos limites.\n\nPara que um espaço em branco esteja em um limite, qualquer uma das seguintes condições precisa ser atendida:\n- É uma tabulação\n- É adjacente a uma borda (início ou fim)\n- É adjacente a um espaço em branco (à esquerda ou à direita)"

msgctxt "settings schema"
msgid "Draw whitespaces only after non-whitespace characters."
msgstr "Desenha espaços em branco somente após caracteres que não são espaços."

msgctxt "settings schema"
msgid "EXPERIMENTAL: Overrides for the current theme.\n\nThese values will override the ones on the current theme specified in `theme`."
msgstr "EXPERIMENTAL: substituições para o tema atual.\n\nEstes valores substituem os do tema atual especificado em `theme`."

msgctxt "settings schema"
msgid "Enables or disables auto-closing of JSX tags."
msgstr "Habilita ou desabilita o fechamento automático de tags JSX."

msgctxt "settings schema"
msgid "Enables or disables formatting with Prettier for a given language."
msgstr "Habilita ou desabilita a formatação com Prettier para uma linguagem específica."

msgctxt "settings schema"
msgid "Enterprise URI for Copilot.\n\nDefault: none"
msgstr "URI corporativo do Copilot.\n\nPadrão: none"

msgctxt "settings schema"
msgid "Exclude files matching these glob patterns from file scans, file searches,\nand the project file tree. Takes precedence over `file_scan_inclusions`.\n\nDefault:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Exclui os arquivos que correspondem a estes padrões glob das varreduras de arquivos, das pesquisas de arquivos e da árvore de arquivos do projeto. Tem precedência sobre `file_scan_inclusions`.\n\nPadrão:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUse `\"...\"` para adicionar padrões sem repetir os padrões do ForgeKairos. Nas configurações do projeto, ele estende o valor da configuração do usuário ou da configuração pai. Omita `\"...\"` para substituir a lista herdada.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nOs padrões herdados são inseridos em `\"...\"`, e os duplicados mantêm a primeira ocorrência."

msgctxt "settings schema"
msgid "Extends under the left dock while snapping to the right dock"
msgstr "Estende-se sob o dock esquerdo e se ajusta ao dock direito"

msgctxt "settings schema"
msgid "Extends under the right dock while snapping to the left dock"
msgstr "Estende-se sob o dock direito e se ajusta ao dock esquerdo"

msgctxt "settings schema"
msgid "Extra task variables to set for a particular language."
msgstr "Variáveis de tarefa extras a serem definidas para uma linguagem específica."

msgctxt "settings schema"
msgid "Favorite models to show at the top of the model selector."
msgstr "Modelos favoritos exibidos no topo do seletor de modelos."

msgctxt "settings schema"
msgid "Favorited values for session config options.\n\nThis is a map from config option ID to a list of favorited value IDs.\n\nDefault: {}"
msgstr "Valores favoritos para as opções de configuração da sessão.\n\nÉ um mapa do ID da opção de configuração para uma lista de IDs de valores favoritos.\n\nPadrão: {}"

msgctxt "settings schema"
msgid "File diff settings."
msgstr "Configurações de diff do arquivo."

msgctxt "settings schema"
msgid "File name for a new log. Supports the placeholders `{date}`, `{time}`,\n`{title}`, `{host}` and `{pid}`.\n\nDefault: \"{date}_{time}_{title}.log\""
msgstr "Nome do arquivo de um novo log. Aceita os marcadores de posição `{date}`, `{time}`, `{title}`, `{host}` e `{pid}`.\n\nPadrão: \"{date}_{time}_{title}.log\""

msgctxt "settings schema"
msgid "Files larger than this many bytes are attached as an outline (their\nsymbols with line numbers) instead of their full content.\n\nDefault: 16384"
msgstr "Arquivos maiores que este número de bytes são anexados como uma estrutura (seus símbolos com números de linha) em vez do conteúdo completo.\n\nPadrão: 16384"

msgctxt "settings schema"
msgid "Files should be formatted on save."
msgstr "Os arquivos devem ser formatados ao salvar."

msgctxt "settings schema"
msgid "Files should be formatted using a code action executed by language servers."
msgstr "Os arquivos devem ser formatados usando uma ação de código executada pelos servidores de linguagem."

msgctxt "settings schema"
msgid "Files should not be formatted on save."
msgstr "Os arquivos não devem ser formatados ao salvar."

msgctxt "settings schema"
msgid "Fill Color. Used for the accent fill color of an icon.\n\nThis might be used to show when a toggleable icon button is selected."
msgstr "Cor de preenchimento. Usada para a cor de preenchimento de destaque de um ícone.\n\nPode ser usada para mostrar quando um botão de ícone alternável está selecionado."

msgctxt "settings schema"
msgid "Fill Color. Used for the default fill color of an icon."
msgstr "Cor de preenchimento. Usada para a cor de preenchimento padrão de um ícone."

msgctxt "settings schema"
msgid "Fill Color. Used for the disabled fill color of an icon.\n\nDisabled states are shown when a user cannot interact with an element, like a icon button."
msgstr "Cor de preenchimento. Usada para a cor de preenchimento desabilitada de um ícone.\n\nOs estados desabilitados são mostrados quando o usuário não pode interagir com um elemento, como um botão de ícone."

msgctxt "settings schema"
msgid "Fill Color. Used for the muted or deemphasized fill color of an icon.\n\nThis might be used to show an icon in an inactive pane, or to deemphasize a series of icons to give them less visual weight."
msgstr "Cor de preenchimento. Usada para a cor de preenchimento atenuada ou menos enfatizada de um ícone.\n\nPode ser usada para mostrar um ícone em um subpainel inativo ou para atenuar uma série de ícones, dando-lhes menos peso visual."

msgctxt "settings schema"
msgid "Fill Color. Used for the placeholder fill color of an icon.\n\nThis might be used to show an icon in an input that disappears when the user enters text."
msgstr "Cor de preenchimento. Usada para a cor de preenchimento de texto de exemplo de um ícone.\n\nPode ser usada para mostrar um ícone em um campo de entrada que desaparece quando o usuário digita texto."

msgctxt "settings schema"
msgid "Filled background color for added diff hunk row highlights in the editor."
msgstr "Cor de fundo preenchida para destaques de linha de bloco de diff adicionado no editor."

msgctxt "settings schema"
msgid "Filled background color for deleted diff hunk row highlights in the editor."
msgstr "Cor de fundo preenchida para destaques de linha de bloco de diff excluído no editor."

msgctxt "settings schema"
msgid "Follow the visibility of the scrollbar."
msgstr "Segue a visibilidade da barra de rolagem."

msgctxt "settings schema"
msgid "Font family name."
msgstr "Nome da família de fontes."

msgctxt "settings schema"
msgid "Font weight value between 100 (thin) and 900 (black)"
msgstr "Valor da espessura da fonte entre 100 (fina) e 900 (preta)"

msgctxt "settings schema"
msgid "Forcefully enable or disable the scrollbar for each axis"
msgstr "Habilita ou desabilita forçosamente a barra de rolagem para cada eixo"

msgctxt "settings schema"
msgid "Forces Prettier integration to use a specific parser name when formatting files with the language."
msgstr "Força a integração com o Prettier a usar um nome de analisador específico ao formatar arquivos com a linguagem."

msgctxt "settings schema"
msgid "Forces Prettier integration to use specific plugins when formatting files with the language.\nThe default Prettier will be installed with these plugins."
msgstr "Força a integração do Prettier a usar plug-ins específicos ao formatar arquivos da linguagem.\nO Prettier padrão é instalado com esses plug-ins."

msgctxt "settings schema"
msgid "Foreground color for Helix jump labels."
msgstr "Cor de primeiro plano para os rótulos de salto do Helix."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Normal mode indicator."
msgstr "Cor de primeiro plano para o indicador do modo Normal do Vim Helix."

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Select mode indicator."
msgstr "Cor de primeiro plano para o indicador do modo Select do Vim Helix."

msgctxt "settings schema"
msgid "Foreground color for Vim Insert mode indicator."
msgstr "Cor de primeiro plano para o indicador do modo Insert do Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Replace mode indicator."
msgstr "Cor de primeiro plano para o indicador do modo Replace do Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Block mode indicator."
msgstr "Cor de primeiro plano para o indicador do modo Visual Block do Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Line mode indicator."
msgstr "Cor de primeiro plano para o indicador do modo Visual Line do Vim."

msgctxt "settings schema"
msgid "Foreground color for Vim Visual mode indicator."
msgstr "Cor de primeiro plano para o indicador do modo Visual do Vim."

msgctxt "settings schema"
msgid "Format code using Zed's Prettier integration."
msgstr "Formata o código usando a integração do ForgeKairos com o Prettier."

msgctxt "settings schema"
msgid "Format code using a language server."
msgstr "Formata o código usando um servidor de linguagem."

msgctxt "settings schema"
msgid "Format code using a specific language server."
msgstr "Formata o código usando um servidor de linguagem específico."

msgctxt "settings schema"
msgid "Format code using an external command."
msgstr "Formata o código usando um comando externo."

msgctxt "settings schema"
msgid "Format code using the current language server."
msgstr "Formata o código usando o servidor de linguagem atual."

msgctxt "settings schema"
msgid "Format files using Zed's Prettier integration (if applicable),\nor falling back to formatting via language server."
msgstr "Formata os arquivos usando a integração do Prettier do ForgeKairos (se aplicável) ou, caso contrário, recorre à formatação pelo servidor de linguagem."

msgctxt "settings schema"
msgid "Git accounts a repository can commit and push as. Which one a repository\nuses is picked in the git panel and kept in `project_accounts`. An\naccount's token is kept in the operating system's credential store, never\nin this file.\n\nDefault: []"
msgstr "Contas Git com as quais um repositório pode fazer commit e push. Qual delas um repositório usa é escolhido no painel do Git e mantido em `project_accounts`. O token de uma conta é mantido no armazenamento de credenciais do sistema operacional, nunca neste arquivo.\n\nPadrão: []"

msgctxt "settings schema"
msgid "Git blame settings."
msgstr "Configurações do Git blame."

msgctxt "settings schema"
msgid "Global default permission when no tool-specific rules match.\nIndividual tools can override this with their own default.\nDefault: confirm"
msgstr "Permissão padrão global quando nenhuma regra específica de ferramenta corresponde.\nCada ferramenta pode substituí-la com seu próprio padrão.\nPadrão: confirm"

msgctxt "settings schema"
msgid "Global switch to toggle hints on and off.\n\nDefault: false"
msgstr "Chave global para ativar e desativar as dicas.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Global switch to toggle inline values on and off when debugging.\n\nDefault: true"
msgstr "Chave global para ativar e desativar os valores embutidos durante a depuração.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Green ANSI terminal color."
msgstr "Cor verde do terminal ANSI."

msgctxt "settings schema"
msgid "Gutter related settings"
msgstr "Configurações relacionadas à medianiz"

msgctxt "settings schema"
msgid "HTTP/HTTPS proxy to use for Copilot.\n\nDefault: none"
msgstr "Proxy HTTP/HTTPS a usar para o Copilot.\n\nPadrão: none"

msgctxt "settings schema"
msgid "Hide git gutter"
msgstr "Ocultar medianiz do Git"

msgctxt "settings schema"
msgid "Hide on typing and on key bindings that resolve to an action"
msgstr "Ocultar ao digitar e ao usar associações de teclas que executam uma ação"

msgctxt "settings schema"
msgid "Hide only when typing"
msgstr "Ocultar apenas ao digitar"

msgctxt "settings schema"
msgid "Hide the tab bar while the in-panel thread history is showing and the\npanel holds a single pane: the history lists the open tabs too, so the\nhorizontal row would say the same thing twice. Split the panel or close\nthe history and the tab bar comes back."
msgstr "Oculta a barra de abas enquanto o histórico de conversas no painel está sendo mostrado e o painel contém um único subpainel: o histórico também lista as abas abertas, então a linha horizontal diria a mesma coisa duas vezes. Divida o painel ou feche o histórico e a barra de abas volta."

msgctxt "settings schema"
msgid "Hide the values of variables in `private` files, as defined by the\nprivate_files setting. This only changes the visual representation,\nthe values are still present in the file and can be selected / copied / pasted\n\nDefault: false"
msgstr "Oculta os valores das variáveis em arquivos `private`, conforme definido pela configuração private_files. Isso altera apenas a representação visual; os valores continuam presentes no arquivo e podem ser selecionados / copiados / colados\n\nPadrão: false"

msgctxt "settings schema"
msgid "Highlighted brackets background color.\n\nMatching brackets in the cursor scope are highlighted with this background color."
msgstr "Cor de fundo dos colchetes destacados.\n\nOs colchetes correspondentes no escopo do cursor são destacados com esta cor de fundo."

msgctxt "settings schema"
msgid "Hollow background color for added diff hunk row highlights in the editor."
msgstr "Cor de fundo vazada para destaques de linha de bloco de diff adicionado no editor."

msgctxt "settings schema"
msgid "Hollow background color for deleted diff hunk row highlights in the editor."
msgstr "Cor de fundo vazada para destaques de linha de bloco de diff excluído no editor."

msgctxt "settings schema"
msgid "Hollow border color for added diff hunk row highlights in the editor."
msgstr "Cor da borda vazada para destaques de linha de bloco de diff adicionado no editor."

msgctxt "settings schema"
msgid "Hollow border color for deleted diff hunk row highlights in the editor."
msgstr "Cor da borda vazada para destaques de linha de bloco de diff excluído no editor."

msgctxt "settings schema"
msgid "Hollow box cursor."
msgstr "Cursor de caixa vazia."

msgctxt "settings schema"
msgid "Hosts that sandboxed terminal commands may always reach over the\nnetwork without prompting. Each entry is an exact hostname\n(`github.com`) or a leading-`*.` subdomain wildcard (`*.npmjs.org`).\nDefault: []"
msgstr "Hosts que os comandos de terminal em sandbox sempre podem alcançar pela rede sem perguntar. Cada entrada é um nome de host exato (`github.com`) ou um curinga de subdomínio iniciado por `*.` (`*.npmjs.org`).\nPadrão: []"

msgctxt "settings schema"
msgid "How and when the scrollbar should be displayed.\n\nDefault: inherits editor scrollbar settings"
msgstr "Como e quando a barra de rolagem deve ser exibida.\n\nPadrão: herda as configurações da barra de rolagem do editor"

msgctxt "settings schema"
msgid "How entry statuses are displayed.\n\nDefault: icon"
msgstr "Como os status das entradas são exibidos.\n\nPadrão: icon"

msgctxt "settings schema"
msgid "How file paths are displayed in the git gutter.\n\nDefault: file_name_first"
msgstr "Como os caminhos de arquivo são exibidos na medianiz do Git.\n\nPadrão: file_name_first"

msgctxt "settings schema"
msgid "How hunks are displayed visually in the editor.\n\nDefault: staged_hollow"
msgstr "Como os blocos são exibidos visualmente no editor.\n\nPadrão: staged_hollow"

msgctxt "settings schema"
msgid "How line endings should be handled for new files and during format and\nsave operations.\n\n- `detect`: Detect existing line endings and otherwise use the platform\n  default (`lf` on Unix, `crlf` on Windows).\n- `prefer_lf`: Prefer LF for new files and files with no existing line\n  ending.\n- `prefer_crlf`: Prefer CRLF for new files and files with no existing\n  line ending.\n- `enforce_lf`: Enforce LF during format and save.\n- `enforce_crlf`: Enforce CRLF during format and save.\n\nThe EditorConfig `end_of_line` property overrides this setting and\nbehaves like `enforce_lf` or `enforce_crlf`.\n\nDefault: detect"
msgstr "Como as terminações de linha devem ser tratadas em novos arquivos e durante as operações de formatação e salvamento.\n\n- `detect`: detecta as terminações de linha existentes e, caso contrário, usa o padrão da plataforma (`lf` no Unix, `crlf` no Windows).\n- `prefer_lf`: prefere LF para novos arquivos e arquivos sem terminação de linha existente.\n- `prefer_crlf`: prefere CRLF para novos arquivos e arquivos sem terminação de linha existente.\n- `enforce_lf`: impõe LF durante a formatação e o salvamento.\n- `enforce_crlf`: impõe CRLF durante a formatação e o salvamento.\n\nA propriedade `end_of_line` do EditorConfig substitui esta configuração e se comporta como `enforce_lf` ou `enforce_crlf`.\n\nPadrão: detect"

msgctxt "settings schema"
msgid "How long \"go to definition\" waits for the language server before it\nalso offers the index's name matches, in milliseconds, from 100 to\n10000.\n\nDefault: 1500"
msgstr "Quanto tempo \"Ir para definição\" aguarda o servidor de linguagem antes de também oferecer as correspondências de nome do índice, em milissegundos, de 100 a 10000.\n\nPadrão: 1500"

msgctxt "settings schema"
msgid "How many callers or callees of one function to list before a\n\"Show more\" row.\n\nDefault: 200"
msgstr "Quantos chamadores ou chamados de uma função listar antes de uma linha \"Mostrar mais\".\n\nPadrão: 200"

msgctxt "settings schema"
msgid "How many characters has to be in the completions query to automatically show the words-based completions.\nBefore that value, it's still possible to trigger the words-based completion manually with the corresponding editor command.\n\nDefault: 3"
msgstr "Quantos caracteres a consulta de preenchimento automático precisa ter para mostrar automaticamente os preenchimentos baseados em palavras.\nAntes desse valor, ainda é possível acionar manualmente o preenchimento baseado em palavras com o comando correspondente do editor.\n\nPadrão: 3"

msgctxt "settings schema"
msgid "How many columns a tab should occupy.\n\nDefault: 4"
msgstr "Quantas colunas uma tabulação deve ocupar.\n\nPadrão: 4"

msgctxt "settings schema"
msgid "How many hours a session stays alive on the host with no terminal\nattached to it before its shell is ended. 0 keeps it forever.\n\nDefault: 24"
msgstr "Por quantas horas uma sessão permanece ativa no host sem nenhum terminal anexado antes que seu shell seja encerrado. 0 a mantém para sempre.\n\nPadrão: 24"

msgctxt "settings schema"
msgid "How many lines of context to provide in multibuffer excerpts by default\n\nDefault: 2"
msgstr "Quantas linhas de contexto fornecer por padrão nos trechos do multibuffer\n\nPadrão: 2"

msgctxt "settings schema"
msgid "How many lines to expand the multibuffer excerpts by default\n\nDefault: 3"
msgstr "Quantas linhas expandir por padrão nos trechos do multibuffer\n\nPadrão: 3"

msgctxt "settings schema"
msgid "How many minutes an external agent's connection is kept once no thread\nof that agent is open any more. The agent (and the sandbox it runs in)\nis stopped after that, and opening one of its threads again connects\nanew. `0` keeps every connection until the window closes.\n\nDefault: 5"
msgstr "Por quantos minutos a conexão de um agente externo é mantida depois que nenhuma conversa desse agente está mais aberta. Depois disso, o agente (e o sandbox em que ele é executado) é parado, e abrir novamente uma de suas conversas conecta de novo. `0` mantém todas as conexões até a janela ser fechada.\n\nPadrão: 5"

msgctxt "settings schema"
msgid "How many threads clangd uses to build and index files (`-j`). Unset\nleaves clangd's own default. Values over 256 are treated as 256.\nIgnored when `lsp.clangd.binary.arguments` already has `-j`. Read from\nthe user's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Quantas threads o clangd usa para compilar e indexar arquivos (`-j`). Quando não definido, mantém o padrão do próprio clangd. Valores acima de 256 são tratados como 256.\nIgnorado quando `lsp.clangd.binary.arguments` já tem `-j`. Lido somente das configurações do usuário, não do `.zed/settings.json` de um projeto.\n\nPadrão: null"

msgctxt "settings schema"
msgid "How much memory clangd, the C and C++ language server, may use."
msgstr "Quanta memória o clangd, o servidor de linguagem de C e C++, pode usar."

msgctxt "settings schema"
msgid "How much to fade out unused code."
msgstr "Define o quanto desvanecer o código não utilizado."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel."
msgstr "Define como os blocos de raciocínio devem ser exibidos por padrão no painel do agente."

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel.\n\nDefault: automatic"
msgstr "Como os blocos de raciocínio devem ser exibidos por padrão no painel do agente.\n\nPadrão: automatic"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: split"
msgstr "Como exibir os diffs no editor.\n\nPadrão: split"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: unified"
msgstr "Como exibir os diffs no editor.\n\nPadrão: unified"

msgctxt "settings schema"
msgid "How to display the LSP item kind (function, method, variable, etc.)\nof each entry in the completions menu.\n\n- \"off\": do not display item kinds (default).\n- \"symbol\": display a single-letter badge, colorized based on the\n  active syntax theme.\n\nDefault: off"
msgstr "Como exibir o tipo de item do LSP (função, método, variável etc.) de cada entrada no menu de preenchimento automático.\n\n- \"off\": não exibe os tipos de item (padrão).\n- \"symbol\": exibe um contador de uma única letra, colorido com base no tema de sintaxe ativo.\n\nPadrão: off"

msgctxt "settings schema"
msgid "How to group entries in the git panel.\n\nDefault: status"
msgstr "Como agrupar as entradas no painel do Git.\n\nPadrão: status"

msgctxt "settings schema"
msgid "How to highlight the current line in the editor.\n\nDefault: all"
msgstr "Como destacar a linha atual no editor.\n\nPadrão: all"

msgctxt "settings schema"
msgid "How to highlight the current line in the minimap.\n\nDefault: inherits editor line highlights setting"
msgstr "Como destacar a linha atual no minimapa.\n\nPadrão: herda a configuração de destaque de linha do editor"

msgctxt "settings schema"
msgid "How to order sibling entries in the project panel.\n\nDefault: directories_first"
msgstr "Como ordenar as entradas irmãs no painel do projeto.\n\nPadrão: directories_first"

msgctxt "settings schema"
msgid "How to perform a buffer format.\n\nDefault: auto"
msgstr "Como formatar um buffer.\n\nPadrão: auto"

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor."
msgstr "Define como renderizar as cores de `textDocument/documentColor` do LSP no editor."

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor.\n\nDefault: [`DocumentColorsRenderMode::Inlay`]"
msgstr "Como renderizar as cores de `textDocument/documentColor` do LSP no editor.\n\nPadrão: [`DocumentColorsRenderMode::Inlay`]"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference\n(e.g. Go to Definition, Go to Type Definition, Find All References).\n\nDefault: center"
msgstr "Como rolar o destino para a área visível ao navegar até uma definição ou referência (ex.: Ir para definição, Ir para definição de tipo, Localizar todas as referências).\n\nPadrão: center"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference.\n\nDefault: center"
msgstr "Como rolar o destino para a área visível ao navegar até uma definição ou referência.\n\nPadrão: center"

msgctxt "settings schema"
msgid "How to soft-wrap long lines of text.\n\nDefault: none"
msgstr "Como aplicar a quebra automática em linhas de texto longas.\n\nPadrão: none"

msgctxt "settings schema"
msgid "How to sort entries in the git panel.\n\nDefault: path"
msgstr "Como ordenar as entradas no painel do Git.\n\nPadrão: path"

msgctxt "settings schema"
msgid "IDs of the tools not to suggest (`clangd`, `clang-format`, `ruff` and so\non). \"Don't show again\" in the notification adds a tool here.\n\nDefault: []"
msgstr "IDs das ferramentas que não devem ser sugeridas (`clangd`, `clang-format`, `ruff` etc.). \"Não mostrar novamente\" na notificação adiciona uma ferramenta aqui.\n\nPadrão: []"

msgctxt "settings schema"
msgid "IMDSv2, PodIdentity, env vars, etc."
msgstr "IMDSv2, PodIdentity, variáveis de ambiente etc."

msgctxt "settings schema"
msgid "Icon Theme Name"
msgstr "Nome do tema de ícones"

msgctxt "settings schema"
msgid "If enabled, Zed will download its own copy of Node."
msgstr "Se habilitado, o ForgeKairos baixará sua própria cópia do Node."

msgctxt "settings schema"
msgid "If provider supports it, display inline when holding modifier key (e.g., alt).\nOtherwise, eager preview is used."
msgstr "Se o provedor oferecer suporte, exibe embutido enquanto a tecla modificadora (ex.: alt) é mantida pressionada.\nCaso contrário, é usada a visualização imediata."

msgctxt "settings schema"
msgid "If the server supports sending tasks over LSP extensions,\nthis setting can be used to enable or disable them in Zed.\nDefault: true"
msgstr "Se o servidor oferecer suporte ao envio de tarefas por extensões do LSP, esta configuração pode ser usada para habilitá-las ou desabilitá-las no ForgeKairos.\nPadrão: true"

msgctxt "settings schema"
msgid "Ignored version control color."
msgstr "Cor de controle de versão para itens ignorados."

msgctxt "settings schema"
msgid "Include files matching these glob patterns when scanning, even if ignored\nby Git. Note that broad patterns can slow file scanning.\n`file_scan_exclusions` takes precedence.\n\nDefault:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Inclui na varredura os arquivos que correspondem a estes padrões glob, mesmo que ignorados pelo Git. Observe que padrões amplos podem deixar a varredura de arquivos mais lenta.\n`file_scan_exclusions` tem precedência.\n\nPadrão:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUse `\"...\"` para adicionar padrões sem repetir os padrões do ForgeKairos. Nas configurações do projeto, ele estende o valor da configuração do usuário ou da configuração pai. Omita `\"...\"` para substituir a lista herdada.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nOs padrões herdados são inseridos em `\"...\"`, e os duplicados mantêm a primeira ocorrência."

msgctxt "settings schema"
msgid "Indent guide related settings."
msgstr "Configurações relacionadas às guias de recuo."

msgctxt "settings schema"
msgid "Index a worktree once it has C or C++ files."
msgstr "Indexa uma árvore de trabalho assim que ela tiver arquivos C ou C++."

msgctxt "settings schema"
msgid "Index only the open files."
msgstr "Indexa somente os arquivos abertos."

msgctxt "settings schema"
msgid "Index the whole project in the background (clangd's default)."
msgstr "Indexa o projeto inteiro em segundo plano (padrão do clangd)."

msgctxt "settings schema"
msgid "Indicates a changed or altered status, like a file that has been edited."
msgstr "Indica um status alterado, como um arquivo que foi editado."

msgctxt "settings schema"
msgid "Indicates a hint or some kind of additional information."
msgstr "Indica uma dica ou algum tipo de informação adicional."

msgctxt "settings schema"
msgid "Indicates a successful operation or task completion."
msgstr "Indica uma operação bem-sucedida ou conclusão de tarefa."

msgctxt "settings schema"
msgid "Indicates a system error, a failed operation or a diagnostic error."
msgstr "Indica um erro do sistema, uma operação com falha ou um erro de diagnóstico."

msgctxt "settings schema"
msgid "Indicates some kind of conflict, like a file changed on disk while it was open, or\nmerge conflicts in a Git repository."
msgstr "Indica algum tipo de conflito, como um arquivo alterado no disco enquanto estava aberto ou conflitos de merge em um repositório Git."

msgctxt "settings schema"
msgid "Indicates some kind of unreachable status, like a block of code that can never be reached."
msgstr "Indica um status inalcançável, como o de um bloco de código que nunca pode ser alcançado."

msgctxt "settings schema"
msgid "Indicates something new, like a new file added to a Git repository."
msgstr "Indica algo novo, como um arquivo adicionado a um repositório Git."

msgctxt "settings schema"
msgid "Indicates something that is predicted, like automatic code completion, or generated code."
msgstr "Indica algo previsto, como preenchimento automático de código ou código gerado."

msgctxt "settings schema"
msgid "Indicates that something is deliberately ignored, such as a file or operation ignored by Git."
msgstr "Indica que algo foi deliberadamente ignorado, como um arquivo ou operação ignorados pelo Git."

msgctxt "settings schema"
msgid "Indicates that something no longer exists, like a deleted file."
msgstr "Indica que algo não existe mais, como um arquivo excluído."

msgctxt "settings schema"
msgid "Indicates whether this custom model supports caching."
msgstr "Define se este modelo personalizado oferece suporte a cache."

msgctxt "settings schema"
msgid "Inherit cursor shape from the editor's base cursor_shape setting."
msgstr "Herda a forma do cursor da configuração base cursor_shape do editor."

msgctxt "settings schema"
msgid "Inlay hint related settings."
msgstr "Configurações relacionadas às dicas embutidas."

msgctxt "settings schema"
msgid "Jupyter REPL settings."
msgstr "Configurações do REPL do Jupyter."

msgctxt "settings schema"
msgid "Keep model alive for N seconds"
msgstr "Mantém o modelo ativo por N segundos"

msgctxt "settings schema"
msgid "Keep model alive for a fixed duration. Accepts durations like \"5m\", \"10m\", \"1h\", \"1d\", etc."
msgstr "Mantém o modelo ativo por uma duração fixa. Aceita durações como \"5m\", \"10m\", \"1h\", \"1d\" etc."

msgctxt "settings schema"
msgid "Keep the tab bar hidden, leaving the in-panel thread history as the way\nto the open tabs. A panel too narrow to show that list, or the strip\nthat brings it back, still gets the tab bar: otherwise nothing would\nreach the tabs that are not in front."
msgstr "Mantém a barra de abas oculta, deixando o histórico de conversas no painel como caminho para as abas abertas. Um painel estreito demais para mostrar essa lista, ou a faixa que a traz de volta, ainda recebe a barra de abas: caso contrário, nada alcançaria as abas que não estão à frente."

msgctxt "settings schema"
msgid "Keeps the changes in the working tree, unstaged."
msgstr "Mantém as alterações no diretório de trabalho, não preparadas."

msgctxt "settings schema"
msgid "Keeps the changes staged."
msgstr "Mantém as alterações preparadas."

msgctxt "settings schema"
msgid "Language server settings.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Configurações do servidor de linguagem.\n\nRef.: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsulte a documentação do servidor de linguagem específico para ver quais configurações são suportadas."

msgctxt "settings schema"
msgid "Language servers from extensions that keep running while their\nworktree's code is paused, by name (for example `\"gopls\"`). Other\nextensions' servers stop until the worktree is resumed. Read from the\nuser settings file only.\n\nDefault: []"
msgstr "Servidores de linguagem de extensões que continuam em execução enquanto o código da árvore de trabalho está pausado, por nome (por exemplo, `\"gopls\"`). Os servidores de outras extensões param até que a árvore de trabalho seja retomada. Lido somente do arquivo de configurações do usuário.\n\nPadrão: []"

msgctxt "settings schema"
msgid "Largest outline sent for one file, in bytes. Deeper symbols are\ndropped first when an outline does not fit.\n\nDefault: 8192"
msgstr "Maior estrutura enviada para um arquivo, em bytes. Os símbolos mais profundos são descartados primeiro quando uma estrutura não cabe.\n\nPadrão: 8192"

msgctxt "settings schema"
msgid "Largest part of a fetched web page that is attached, in bytes.\n\nDefault: 32768"
msgstr "Maior parte de uma página da Web obtida que é anexada, em bytes.\n\nPadrão: 32768"

msgctxt "settings schema"
msgid "Layout mode for the bottom dock\n\nDefault: contained"
msgstr "Modo de layout do dock inferior\n\nPadrão: contained"

msgctxt "settings schema"
msgid "Leave the slot empty: the dock shows a single panel, as upstream Zed\ndoes, or none at all."
msgstr "Deixa a posição vazia: o dock mostra um único painel, como faz o Zed upstream, ou nenhum."

msgctxt "settings schema"
msgid "Leave the window open when there are no tabs"
msgstr "Deixa a janela aberta quando não há abas"

msgctxt "settings schema"
msgid "Limits on how much of an attachment (a file, a directory, a selection,\na fetched page, diagnostics or a branch diff) is sent to the agent.\nAnything over these limits is sent as an outline or a reference the\nagent can follow up on instead of in full."
msgstr "Limites de quanto de um anexo (um arquivo, um diretório, uma seleção, uma página obtida, diagnósticos ou um diff de branch) é enviado ao agente.\nTudo o que ultrapassar esses limites é enviado como uma estrutura ou uma referência que o agente pode acompanhar, em vez de completo."

msgctxt "settings schema"
msgid "List every file inside untracked directories."
msgstr "Lista todos os arquivos dentro de diretórios não rastreados."

msgctxt "settings schema"
msgid "List untracked directories, but not the files inside them."
msgstr "Lista os diretórios não rastreados, mas não os arquivos dentro deles."

msgctxt "settings schema"
msgid "Load direnv configuration directly using `direnv export json`"
msgstr "Carrega a configuração do direnv diretamente usando `direnv export json`"

msgctxt "settings schema"
msgid "Load direnv configuration through a shell hook"
msgstr "Carrega a configuração do direnv por meio de um hook de shell"

msgctxt "settings schema"
msgid "Local overrides for feature flags, keyed by flag name."
msgstr "Substituições locais para sinalizadores de funcionalidades, indexadas pelo nome do sinalizador."

msgctxt "settings schema"
msgid "Looks up references of the same symbol instead."
msgstr "Pesquisa referências do mesmo símbolo em vez disso."

msgctxt "settings schema"
msgid "Lowercase names are grouped before uppercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Os nomes em minúsculas são agrupados antes dos nomes em maiúsculas, com ordenação natural sem diferenciar maiúsculas e minúsculas dentro de cada grupo. Os nomes iniciados por ponto vêm antes de ambos os grupos."

msgctxt "settings schema"
msgid "Magenta ANSI terminal color."
msgstr "Cor magenta do terminal ANSI."

msgctxt "settings schema"
msgid "Map from language name to file patterns."
msgstr "Mapa de nome de linguagem para padrões de arquivo."

msgctxt "settings schema"
msgid "Map from language name to settings."
msgstr "Mapa de nome de linguagem para configurações."

msgctxt "settings schema"
msgid "Match platform conventions by default, so \"on\" on macOS and \"off\" everywhere else"
msgstr "Segue as convenções da plataforma por padrão, com \"on\" no macOS e \"off\" nas demais plataformas"

msgctxt "settings schema"
msgid "Match platform conventions by default, so don't quit on macOS, and quit on other platforms"
msgstr "Segue as convenções da plataforma por padrão: não encerra no macOS e encerra nas demais plataformas"

msgctxt "settings schema"
msgid "Match the system's configured behavior."
msgstr "Segue o comportamento configurado do sistema."

msgctxt "settings schema"
msgid "Maximum content width in pixels for the agent panel. Content will be\ncentered when the panel is wider than this value.\n\nDefault: 850"
msgstr "Largura máxima do conteúdo do painel do agente em pixels. O conteúdo é centralizado quando o painel é mais largo que este valor.\n\nPadrão: 850"

msgctxt "settings schema"
msgid "Maximum directory depth to eagerly index outside of git repositories;\ncontents of directories at this depth or deeper are indexed on demand.\nRepositories rooted shallower than this depth are always indexed fully.\nIn projects that are not rooted at a git repository, repositories directly\ninside a root folder activate their git features immediately; deeper ones\nactivate on first use.\n`0` means no limit and activates all git repositories immediately.\n\nDefault: 5"
msgstr "Profundidade máxima de diretório a indexar antecipadamente fora de repositórios Git; o conteúdo dos diretórios nesta profundidade ou mais profundos é indexado sob demanda.\nRepositórios com raiz em profundidade menor que esta são sempre indexados por completo.\nEm projetos cuja raiz não é um repositório Git, os repositórios diretamente dentro de uma pasta raiz ativam seus recursos do Git imediatamente; os mais profundos são ativados no primeiro uso.\n`0` significa sem limite e ativa todos os repositórios Git imediatamente.\n\nPadrão: 5"

msgctxt "settings schema"
msgid "Maximum length of the commit message title before a warning is shown.\nSet to 0 to disable.\n\nDefault: 0"
msgstr "Comprimento máximo do título da mensagem de commit antes que um aviso seja mostrado.\nDefina como 0 para desabilitar.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "Maximum number of characters for an output to be shown inline.\nOnly applies when `inline_output` is true.\n\nDefault: 50"
msgstr "Número máximo de caracteres para que uma saída seja mostrada embutida.\nAplica-se somente quando `inline_output` é true.\n\nPadrão: 50"

msgctxt "settings schema"
msgid "Maximum number of columns to display in the minimap.\n\nDefault: 80"
msgstr "Número máximo de colunas a exibir no minimapa.\n\nPadrão: 80"

msgctxt "settings schema"
msgid "Maximum number of columns to keep in REPL's scrollback buffer.\nClamped with [20, 512] range.\n\nDefault: 128"
msgstr "Número máximo de colunas a manter no buffer de rolagem do REPL.\nLimitado ao intervalo [20, 512].\n\nPadrão: 128"

msgctxt "settings schema"
msgid "Maximum number of lines of output to display before scrolling.\nSet to 0 to disable output height limits.\n\nDefault: 0"
msgstr "Número máximo de linhas de saída a exibir antes de rolar.\nDefina como 0 para desabilitar os limites de altura da saída.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "Maximum number of lines to keep in REPL's scrollback buffer.\nClamped with [4, 256] range.\n\nDefault: 32"
msgstr "Número máximo de linhas a manter no buffer de rolagem do REPL.\nLimitado ao intervalo [4, 256].\n\nPadrão: 32"

msgctxt "settings schema"
msgid "Maximum open tabs in a pane. Will not close an unsaved\ntab. Set to `None` for unlimited tabs.\n\nDefault: none"
msgstr "Número máximo de abas abertas em um subpainel. Não fecha uma aba não salva. Defina como `None` para abas ilimitadas.\n\nPadrão: none"

msgctxt "settings schema"
msgid "Maximum tokens to generate for FIM models and self-hosted Sweep rewrite responses.\n\nDefault: 256"
msgstr "Máximo de tokens a gerar para modelos FIM e respostas de reescrita do Sweep auto-hospedado.\n\nPadrão: 256"

msgctxt "settings schema"
msgid "Maximum tokens to generate.\n\nDefault: 150"
msgstr "Máximo de tokens a gerar.\n\nPadrão: 150"

msgctxt "settings schema"
msgid "Minimap related settings"
msgstr "Configurações relacionadas ao minimapa"

msgctxt "settings schema"
msgid "Minimum APCA perceptual contrast for text over highlight backgrounds.\n\nValid range: 0.0 to 106.0\nDefault: 45.0"
msgstr "Contraste perceptual APCA mínimo para texto sobre fundos destacados.\n\nIntervalo válido: 0.0 a 106.0\nPadrão: 45.0"

msgctxt "settings schema"
msgid "Minimum number of characters to reserve space for in the gutter.\n\nDefault: 4"
msgstr "Número mínimo de caracteres para os quais reservar espaço na medianiz.\n\nPadrão: 4"

msgctxt "settings schema"
msgid "Minimum number of lines of height the agent message editor should have.\n\nDefault: 4"
msgstr "Número mínimo de linhas de altura que o editor de mensagens do agente deve ter.\n\nPadrão: 4"

msgctxt "settings schema"
msgid "Minimum time to wait before pulling diagnostics from the language server(s).\n0 turns the debounce off.\n\nDefault: 50"
msgstr "Tempo mínimo de espera antes de obter os diagnósticos do(s) servidor(es) de linguagem.\n0 desativa o debounce.\n\nPadrão: 50"

msgctxt "settings schema"
msgid "Mix directories and files together"
msgstr "Misturar diretórios e arquivos"

msgctxt "settings schema"
msgid "Model that judges whether a tool action is dangerous when the tool\npermission mode is `auto`. Defaults to the fast model, then to\ndefault_model, when not specified."
msgstr "Modelo que julga se uma ação de ferramenta é perigosa quando o modo de permissão de ferramentas é `auto`. Quando não especificado, usa o modelo rápido e, depois, o default_model."

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: \"codestral-latest\""
msgstr "Modelo a usar para preenchimentos automáticos.\n\nPadrão: \"codestral-latest\""

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: none"
msgstr "Modelo a usar para preenchimentos automáticos.\n\nPadrão: none"

msgctxt "settings schema"
msgid "Model to use for context compaction (`/compact` and auto-compaction).\nFalls back to the thread's currently selected model when not specified.\nIf the configured model is unavailable (provider not registered, model\nnot found), the thread's current model is used instead."
msgstr "Modelo a usar para a compactação de contexto (`/compact` e compactação automática).\nQuando não especificado, recorre ao modelo atualmente selecionado na conversa.\nSe o modelo configurado não estiver disponível (provedor não registrado, modelo não encontrado), o modelo atual da conversa é usado."

msgctxt "settings schema"
msgid "Model to use for generating git commit messages. Defaults to default_model when not specified."
msgstr "Modelo a usar para gerar mensagens de commit do Git. Usa default_model quando não especificado."

msgctxt "settings schema"
msgid "Model to use for generating thread summaries. Defaults to default_model when not specified."
msgstr "Modelo a usar para gerar resumos de conversa. Usa default_model quando não especificado."

msgctxt "settings schema"
msgid "Model to use for the inline assistant when streaming tools are enabled.\n\nDefault: true"
msgstr "Modelo a usar para o assistente embutido quando as ferramentas de streaming estão habilitadas.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Model to use for the inline assistant. Defaults to default_model when not specified."
msgstr "Modelo a usar para o assistente embutido. Usa default_model quando não especificado."

msgctxt "settings schema"
msgid "Modified version control color."
msgstr "Cor de controle de versão para itens modificados."

msgctxt "settings schema"
msgid "Most files whose diagnostics are attached with a diagnostics mention.\n\nDefault: 50"
msgstr "Número máximo de arquivos cujos diagnósticos são anexados com uma menção de diagnósticos.\n\nPadrão: 50"

msgctxt "settings schema"
msgid "Name to use for this server in UI."
msgstr "Nome a usar para este servidor na interface."

msgctxt "settings schema"
msgid "Never allow training data collection."
msgstr "Nunca permite a coleta de dados de treinamento."

msgctxt "settings schema"
msgid "Never blink the cursor, ignoring the terminal mode."
msgstr "Nunca pisca o cursor, ignorando o modo do terminal."

msgctxt "settings schema"
msgid "Never fetch or complete document's words for completions.\n(Word-based completions can still be queried via a separate action)"
msgstr "Nunca obtém nem completa palavras do documento para preenchimentos automáticos.\n(Os preenchimentos baseados em palavras ainda podem ser consultados por uma ação separada)"

msgctxt "settings schema"
msgid "Never hide the mouse cursor"
msgstr "Nunca ocultar o cursor do mouse"

msgctxt "settings schema"
msgid "Never index the worktree."
msgstr "Nunca indexa a árvore de trabalho."

msgctxt "settings schema"
msgid "Never populate the search query"
msgstr "Nunca preenche a consulta de pesquisa"

msgctxt "settings schema"
msgid "Never reduce motion"
msgstr "Nunca reduzir o movimento"

msgctxt "settings schema"
msgid "Never show the minimap."
msgstr "Nunca exibe o minimapa."

msgctxt "settings schema"
msgid "Never show the scrollbar."
msgstr "Nunca exibe a barra de rolagem."

msgctxt "settings schema"
msgid "No automatic indentation. New lines start at column 0."
msgstr "Sem recuo automático. Novas linhas começam na coluna 0."

msgctxt "settings schema"
msgid "Normalize line endings to CRLF (`\\r\\n`) during format and save."
msgstr "Normaliza as terminações de linha para CRLF (`\\r\\n`) durante a formatação e ao salvar."

msgctxt "settings schema"
msgid "Normalize line endings to LF (`\\n`) during format and save."
msgstr "Normaliza as terminações de linha para LF (`\\n`) durante a formatação e ao salvar."

msgctxt "settings schema"
msgid "Number of lines to search for modelines at the beginning and end of files.\nModelines contain editor directives (e.g., vim/emacs settings) that configure\nthe editor behavior for specific files.\n\nDefault: 5"
msgstr "Número de linhas no início e no fim dos arquivos em que procurar modelines.\nModelines contêm diretivas do editor (ex.: configurações do vim/emacs) que configuram o comportamento do editor para arquivos específicos.\n\nPadrão: 5"

msgctxt "settings schema"
msgid "Ollama model name for edit predictions."
msgstr "Nome do modelo Ollama para previsões de edição."

msgctxt "settings schema"
msgid "One of `sftp`, `scp`, `ftp` or `ftps`. Any other value means SFTP."
msgstr "Um de `sftp`, `scp`, `ftp` ou `ftps`. Qualquer outro valor significa SFTP."

msgctxt "settings schema"
msgid "Only if LSP response errors or times out,\nuse document's words to show completions."
msgstr "Somente se a resposta do LSP der erro ou exceder o tempo limite, usa as palavras do documento para mostrar preenchimentos automáticos."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nIf no git diff is available (e.g., when source control is\nunavailable) or if the LSP doesn't support range formatting,\nfalls back to formatting the whole file."
msgstr "Somente as linhas com alterações não preparadas são formatadas ao salvar.\nSe nenhum diff do Git estiver disponível (ex.: quando o controle de versão não está disponível) ou se o LSP não oferecer suporte à formatação de intervalos, recorre à formatação do arquivo inteiro."

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nRequires source control and LSP range formatting support.\nIf no git diff is available or if the LSP doesn't support\nrange formatting, formatting is skipped."
msgstr "Somente as linhas com alterações não preparadas são formatadas ao salvar.\nRequer controle de versão e suporte do LSP à formatação de intervalos.\nSe nenhum diff do Git estiver disponível ou se o LSP não oferecer suporte à formatação de intervalos, a formatação é ignorada."

msgctxt "settings schema"
msgid "Only populate the search query when there is text selected."
msgstr "Preenche a consulta de pesquisa apenas quando há texto selecionado."

msgctxt "settings schema"
msgid "Only rewrap within comments."
msgstr "Refaz a quebra apenas dentro de comentários."

msgctxt "settings schema"
msgid "Only rewrap within the current selection(s)."
msgstr "Refaz a quebra apenas dentro da(s) seleção(ões) atual(is)."

msgctxt "settings schema"
msgid "Only scan symlinked directories when they've been expanded in the workspace"
msgstr "Varrer diretórios com links simbólicos apenas quando expandidos no espaço de trabalho"

msgctxt "settings schema"
msgid "Only the language server."
msgstr "Somente o servidor de linguagem."

msgctxt "settings schema"
msgid "Only the symbol index's name matches."
msgstr "Somente as correspondências de nome do índice de símbolos."

msgctxt "settings schema"
msgid "Opacity of inactive panels.\nWhen set to 1.0, the inactive panes have the same opacity as the active one.\nIf set to 0, the inactive panes content will not be visible at all.\nValues are clamped to the [0.0, 1.0] range.\n\nDefault: `1.0`"
msgstr "Opacidade dos subpainéis inativos.\nQuando definida como 1.0, os subpainéis inativos têm a mesma opacidade do ativo.\nSe definida como 0, o conteúdo dos subpainéis inativos não fica visível.\nOs valores são limitados ao intervalo [0.0, 1.0].\n\nPadrão: `1.0`"

msgctxt "settings schema"
msgid "Opacity of the inactive panes. 0 means transparent, 1 means opaque.\n\nValid range: 0.0 to 1.0\nDefault: 1.0"
msgstr "Opacidade dos subpainéis inativos. 0 significa transparente, 1 significa opaco.\n\nIntervalo válido: 0.0 a 1.0\nPadrão: 1.0"

msgctxt "settings schema"
msgid "Open a single-file diff view."
msgstr "Abre uma exibição de diff de um único arquivo."

msgctxt "settings schema"
msgid "Open directories as a new workspace in the current Zed window's sidebar."
msgstr "Abre diretórios como um novo espaço de trabalho na barra lateral da janela atual do ForgeKairos."

msgctxt "settings schema"
msgid "Open paths in a new window unless they are subpaths of an existing project."
msgstr "Abre caminhos em uma nova janela, a menos que sejam subcaminhos de um projeto existente."

msgctxt "settings schema"
msgid "Open projects in a new window."
msgstr "Abre projetos em uma nova janela."

msgctxt "settings schema"
msgid "Open projects in the current Zed window."
msgstr "Abre projetos na janela atual do ForgeKairos."

msgctxt "settings schema"
msgid "Open the excerpt clicked as a new buffer in the new tab, if no `alt` modifier was pressed during double click.\nOtherwise, behave as a regular buffer and select the whole word."
msgstr "Abre o trecho clicado como um novo buffer em uma nova aba, se nenhum modificador `alt` foi pressionado durante o clique duplo.\nCaso contrário, comporta-se como um buffer comum e seleciona a palavra inteira."

msgctxt "settings schema"
msgid "Open the file in the editor without a diff view."
msgstr "Abre o arquivo no editor sem uma exibição de diff."

msgctxt "settings schema"
msgid "Open the project diff, showing all changed files."
msgstr "Abre o diff do projeto, mostrando todos os arquivos alterados."

msgctxt "settings schema"
msgid "Open the results in a filterable picker."
msgstr "Abre os resultados em um seletor filtrável."

msgctxt "settings schema"
msgid "Open the results in a multibuffer."
msgstr "Abre os resultados em um multibuffer."

msgctxt "settings schema"
msgid "Optional headers to send."
msgstr "Cabeçalhos opcionais a enviar."

msgctxt "settings schema"
msgid "Options passed to the language server at startup.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "Opções passadas ao servidor de linguagem na inicialização.\n\nRef.: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsulte a documentação do servidor de linguagem específico para ver quais configurações são suportadas."

msgctxt "settings schema"
msgid "Override this model with a different Anthropic model for tool calls."
msgstr "Substitui este modelo por um modelo Anthropic diferente para chamadas de ferramentas."

msgctxt "settings schema"
msgid "Overrides per theme\n\nThese values will override the ones on the specified theme"
msgstr "Substituições por tema\n\nEstes valores substituem os do tema especificado"

msgctxt "settings schema"
msgid "Overrides the context length reported for every llama.cpp model."
msgstr "Substitui o comprimento de contexto que cada modelo llama.cpp informa."

msgctxt "settings schema"
msgid "Panel stacked beside it, or `none` for a single panel as upstream Zed\nshows.\n\nDefault: browser"
msgstr "Painel empilhado ao lado dele, ou `none` para um único painel, como mostra o Zed upstream.\n\nPadrão: browser"

msgctxt "settings schema"
msgid "Panel that fills that dock, or `none` to leave the dock as it was.\n\nDefault: agent"
msgstr "Painel que preenche esse dock, ou `none` para deixar o dock como estava.\n\nPadrão: agent"

msgctxt "settings schema"
msgid "Per-tool permission rules for granular control over which tool actions\nrequire confirmation.\n\nThe global `default` applies when no tool-specific rules match.\nFor external agent servers (e.g. Claude Agent) that define their own\npermission modes, \"deny\" and \"confirm\" still take precedence — the\nexternal agent's permission system is only used when Zed would allow\nthe action. Per-tool regex patterns (`always_allow`, `always_deny`,\n`always_confirm`) match against the tool's text input (command, path,\nURL, etc.)."
msgstr "Regras de permissão por ferramenta para controle granular de quais ações de ferramentas exigem confirmação.\n\nO `default` global se aplica quando nenhuma regra específica de ferramenta corresponde.\nPara servidores de agentes externos (ex.: Claude Agent) que definem seus próprios modos de permissão, \"deny\" e \"confirm\" ainda têm precedência — o sistema de permissões do agente externo só é usado quando o ForgeKairos permitiria a ação. Os padrões de regex por ferramenta (`always_allow`, `always_deny`, `always_confirm`) são comparados com a entrada de texto da ferramenta (comando, caminho, URL etc.)."

msgctxt "settings schema"
msgid "Per-tool permission rules.\nKeys are tool names (e.g. terminal, edit_file, fetch) including MCP\ntools (e.g. mcp:server_name:tool_name). Any tool name is accepted;\neven tools without meaningful text input can have a `default` set."
msgstr "Regras de permissão por ferramenta.\nAs chaves são nomes de ferramentas (ex.: terminal, edit_file, fetch), incluindo ferramentas MCP (ex.: mcp:server_name:tool_name). Qualquer nome de ferramenta é aceito; até ferramentas sem entrada de texto significativa podem ter um `default` definido."

msgctxt "settings schema"
msgid "Persistent sandbox permission grants for agent-run terminal commands.\nThese are populated when choosing \"Allow always\" from a sandbox\nescalation prompt."
msgstr "Concessões persistentes de permissão do sandbox para comandos de terminal executados pelo agente.\nElas são preenchidas ao escolher \"Sempre permitir\" em um diálogo de elevação do sandbox."

msgctxt "settings schema"
msgid "Place snippets at the bottom of the completion list"
msgstr "Coloca snippets no final da lista de preenchimento automático"

msgctxt "settings schema"
msgid "Place snippets at the top of the completion list"
msgstr "Coloca snippets no topo da lista de preenchimento automático"

msgctxt "settings schema"
msgid "Play an OS-specific alert sound."
msgstr "Reproduz um som de alerta específico do sistema operacional."

msgctxt "settings schema"
msgid "Position of the close button in a tab.\n\nDefault: right"
msgstr "Posição do botão de fechar em uma aba.\n\nPadrão: right"

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for MCP servers that don't support\nDynamic Client Registration."
msgstr "Credenciais de cliente OAuth pré-registradas para servidores MCP que não oferecem suporte a Dynamic Client Registration."

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for authorization servers that\nrequire out-of-band client registration."
msgstr "Credenciais de cliente OAuth pré-registradas para servidores de autorização que exigem registro de cliente fora de banda."

msgctxt "settings schema"
msgid "Prefer a single line generally, unless an overly long line is encountered."
msgstr "Prefere uma única linha em geral, exceto quando uma linha muito longa é encontrada."

msgctxt "settings schema"
msgid "Preferred Conda manager to use when activating Conda environments.\n\nDefault: auto"
msgstr "Gerenciador do Conda preferido para ativar ambientes Conda.\n\nPadrão: auto"

msgctxt "settings schema"
msgid "Preferred debuggers for this language.\n\nDefault: []"
msgstr "Depuradores preferidos para esta linguagem.\n\nPadrão: []"

msgctxt "settings schema"
msgid "Preserve the cursor's vertical position within the viewport, falling\nback to centering when the cursor is offscreen."
msgstr "Preserva a posição vertical do cursor dentro da área visível, recorrendo à centralização quando o cursor está fora da tela."

msgctxt "settings schema"
msgid "Preserve the existing line endings of the file. New files use the\nplatform default line ending."
msgstr "Preserva as terminações de linha existentes do arquivo. Novos arquivos usam a terminação de linha padrão da plataforma."

msgctxt "settings schema"
msgid "Preserve the indentation of the current line when creating new lines,\nbut don't adjust based on syntax context."
msgstr "Preserva o recuo da linha atual ao criar novas linhas, mas não faz ajustes com base no contexto da sintaxe."

msgctxt "settings schema"
msgid "Pure Unicode codepoint comparison. No case folding, no natural number sorting.\nUppercase ASCII sorts before lowercase. Accented characters sort after ASCII."
msgstr "Comparação pura de pontos de código Unicode. Sem equivalência entre maiúsculas e minúsculas, sem ordenação natural de números.\nO ASCII em maiúsculas vem antes das minúsculas. Os caracteres acentuados vêm depois do ASCII."

msgctxt "settings schema"
msgid "Quit the application the last window is closed"
msgstr "Encerra o aplicativo quando a última janela é fechada"

msgctxt "settings schema"
msgid "Read-access of a symbol, like reading a variable.\n\nA document highlight is a range inside a text document which deserves\nspecial attention. Usually a document highlight is visualized by changing\nthe background color of its range."
msgstr "Acesso de leitura de um símbolo, como ler uma variável.\n\nUm destaque de documento é um intervalo dentro de um documento de texto que merece atenção especial. Normalmente, um destaque de documento é visualizado alterando a cor de fundo do seu intervalo."

msgctxt "settings schema"
msgid "Red ANSI terminal color."
msgstr "Cor vermelha do terminal ANSI."

msgctxt "settings schema"
msgid "Regexes for inputs that must always prompt.\nTakes precedence over always_allow but not always_deny.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Regexes para entradas que sempre devem pedir confirmação.\nTem precedência sobre always_allow, mas não sobre always_deny.\nPara `copy_path` e `move_path`, os padrões são comparados independentemente com cada caminho (origem e destino).\nOs padrões se acumulam entre as camadas de configuração (usuário, projeto, perfil) e não podem ser removidos por uma camada de prioridade mais alta — apenas novos padrões podem ser adicionados.\nPadrão: []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-approve.\nFor terminal: matches command. For file tools: matches path. For fetch: matches URL.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Regexes para entradas a aprovar automaticamente.\nPara o terminal: corresponde ao comando. Para ferramentas de arquivo: corresponde ao caminho. Para fetch: corresponde ao URL.\nPara `copy_path` e `move_path`, os padrões são comparados independentemente com cada caminho (origem e destino).\nOs padrões se acumulam entre as camadas de configuração (usuário, projeto, perfil) e não podem ser removidos por uma camada de prioridade mais alta — apenas novos padrões podem ser adicionados.\nPadrão: []"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-reject.\n**SECURITY**: These take precedence over ALL other rules, across ALL settings layers.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "Regexes para entradas a rejeitar automaticamente.\n**SEGURANÇA**: estas têm precedência sobre TODAS as outras regras, em TODAS as camadas de configuração.\nPara `copy_path` e `move_path`, os padrões são comparados independentemente com cada caminho (origem e destino).\nOs padrões se acumulam entre as camadas de configuração (usuário, projeto, perfil) e não podem ser removidos por uma camada de prioridade mais alta — apenas novos padrões podem ser adicionados.\nPadrão: []"

msgctxt "settings schema"
msgid "Regexes used to identify paths for hyperlink navigation.\n\nDefault:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUse `\"...\"` to add regexes without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list. Set `[]` to clear it. Omitting this\nsetting keeps the inherited list.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nInherited regexes are inserted at `\"...\"`, and duplicates keep their first\noccurrence. Regexes are duplicates when their text is identical after\njoining multiline entries with newlines.\n\nEach regex can be a single string or an array of strings joined with\nnewlines. The marker is recognized only as a top-level string. To use\n`...` as a regex matching three characters, write `[\"...\"]` as an entry.\nA `\"...\"` line inside a multiline entry is always regex text.\n\nThe optional named capture `path` selects the hyperlink target. Without\nit, the entire match is the target. With `path`, `line` and `column`\nspecify the position. Without a captured `line`, built-in suffix\nprocessing parses `line:column` and `(line,column)` variants. The optional\n`link` capture selects the clickable text, otherwise the entire match is\nclickable.\n\nProcessing stops at the first regex that matches the terminal line, even\nif the cursor is outside its clickable text. Put more specific regexes\nbefore broader ones. Regexes use Rust's `regex` syntax. Invalid regexes\nare logged and ignored. The `path_hyperlink_timeout_ms` setting controls\nthe discovery timeout. Setting it to `0` disables path hyperlinks."
msgstr "Regexes usadas para identificar caminhos para navegação por hiperlink.\n\nPadrão:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUse `\"...\"` para adicionar regexes sem repetir os padrões do ForgeKairos. Nas configurações do projeto, ele estende o valor da configuração do usuário ou da configuração pai. Omita `\"...\"` para substituir a lista herdada. Defina `[]` para limpá-la. Omitir esta configuração mantém a lista herdada.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nAs regexes herdadas são inseridas em `\"...\"`, e as duplicadas mantêm a primeira ocorrência. Regexes são duplicadas quando o texto delas é idêntico depois de unir as entradas de várias linhas com quebras de linha.\n\nCada regex pode ser uma única string ou um array de strings unidas com quebras de linha. O marcador só é reconhecido como uma string de nível superior. Para usar `...` como uma regex que corresponde a três caracteres, escreva `[\"...\"]` como entrada.\nUma linha `\"...\"` dentro de uma entrada de várias linhas é sempre texto de regex.\n\nA captura nomeada opcional `path` seleciona o destino do hiperlink. Sem ela, a correspondência inteira é o destino. Com `path`, `line` e `column` especificam a posição. Sem uma `line` capturada, o processamento integrado de sufixos analisa as variantes `line:column` e `(line,column)`. A captura opcional `link` seleciona o texto clicável; caso contrário, a correspondência inteira é clicável.\n\nO processamento para na primeira regex que corresponde à linha do terminal, mesmo que o cursor esteja fora do texto clicável dela. Coloque as regexes mais específicas antes das mais amplas. As regexes usam a sintaxe `regex` do Rust. Regexes inválidas são registradas em log e ignoradas. A configuração `path_hyperlink_timeout_ms` controla o tempo limite da detecção. Defini-la como `0` desabilita os hiperlinks de caminho."

msgctxt "settings schema"
msgid "Renamed version control color."
msgstr "Cor de controle de versão para itens renomeados."

msgctxt "settings schema"
msgid "Render document colors as inlay hints near the color text."
msgstr "Renderiza as cores do documento como dicas embutidas próximas ao texto de cor."

msgctxt "settings schema"
msgid "Replaces text before and after the cursor, using the `replace` range described in the LSP specification."
msgstr "Substitui o texto antes e depois do cursor, usando o intervalo `replace` descrito na especificação do LSP."

msgctxt "settings schema"
msgid "Replaces text before the cursor, using the `insert` range described in the LSP specification."
msgstr "Substitui o texto antes do cursor, usando o intervalo `insert` descrito na especificação do LSP."

msgctxt "settings schema"
msgid "Replaces the grid with the text in the same tab."
msgstr "Substitui a grade pelo texto na mesma aba."

msgctxt "settings schema"
msgid "Represents a hidden status, such as a file being hidden in a file tree."
msgstr "Representa um status oculto, como um arquivo oculto em uma árvore de arquivos."

msgctxt "settings schema"
msgid "Represents a renamed status, such as a file that has been renamed."
msgstr "Representa um status de renomeação, como um arquivo que foi renomeado."

msgctxt "settings schema"
msgid "Represents a warning status, like an operation that is about to fail."
msgstr "Representa um status de aviso, como uma operação prestes a falhar."

msgctxt "settings schema"
msgid "Represents informational status updates or messages."
msgstr "Representa atualizações de status informativas ou mensagens."

msgctxt "settings schema"
msgid "Represents the selection of a theme, which can be either static or dynamic."
msgstr "Representa a seleção de um tema, que pode ser estática ou dinâmica."

msgctxt "settings schema"
msgid "Represents the selection of an icon theme, which can be either static or dynamic."
msgstr "Representa a seleção de um tema de ícones, que pode ser estática ou dinâmica."

msgctxt "settings schema"
msgid "Resize the window to cover the entire screen, including the menu bar and,\non notched displays, the area around the notch."
msgstr "Redimensiona a janela para cobrir a tela inteira, incluindo a barra de menus e, em telas com entalhe, a área ao redor do entalhe."

msgctxt "settings schema"
msgid "Restart clangd when its resident memory, measured every 30 seconds,\ngoes over this many megabytes. At most one restart every 10 minutes;\nafter that, a notification only. Unset never restarts. Read from the\nuser's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "Reinicia o clangd quando sua memória residente, medida a cada 30 segundos, ultrapassa este número de megabytes. No máximo uma reinicialização a cada 10 minutos; depois disso, apenas uma notificação. Quando não definido, nunca reinicia. Lido somente das configurações do usuário, não do `.zed/settings.json` de um projeto.\n\nPadrão: null"

msgctxt "settings schema"
msgid "Restore all workspaces that were open when quitting Zed."
msgstr "Restaura todos os espaços de trabalho que estavam abertos ao encerrar o ForgeKairos."

msgctxt "settings schema"
msgid "Restore the workspace that was closed last."
msgstr "Restaura o espaço de trabalho fechado por último."

msgctxt "settings schema"
msgid "Rules for rendering LSP semantic tokens."
msgstr "Regras para renderizar tokens semânticos LSP."

msgctxt "settings schema"
msgid "Save after inactivity period of `milliseconds`."
msgstr "Salva após período de inatividade de `milliseconds`."

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier for fast scrolling. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling. Fast scrolling\nhappens when a user holds the alt or option key while scrolling.\n\nDefault: 4.0"
msgstr "Multiplicador de sensibilidade de rolagem para a rolagem rápida. Este multiplicador é aplicado aos valores delta horizontal e vertical durante a rolagem. A rolagem rápida acontece quando o usuário mantém a tecla alt ou option pressionada enquanto rola.\n\nPadrão: 4.0"

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling.\n\nDefault: 1.0"
msgstr "Multiplicador de sensibilidade de rolagem. Este multiplicador é aplicado aos valores delta horizontal e vertical durante a rolagem.\n\nPadrão: 1.0"

msgctxt "settings schema"
msgid "Scroll so the target appears near the top of the viewport."
msgstr "Rola para que o alvo apareça próximo ao topo da área visível."

msgctxt "settings schema"
msgid "Scroll the minimum amount needed to make the target visible."
msgstr "Rola o mínimo necessário para tornar o alvo visível."

msgctxt "settings schema"
msgid "Scrollbar related settings"
msgstr "Configurações relacionadas à barra de rolagem"

msgctxt "settings schema"
msgid "Scrollbar-related settings"
msgstr "Configurações relacionadas à barra de rolagem"

msgctxt "settings schema"
msgid "Select specific input audio device."
msgstr "Seleciona o dispositivo de entrada de áudio específico."

msgctxt "settings schema"
msgid "Select specific output audio device."
msgstr "Seleciona o dispositivo de saída de áudio específico."

msgctxt "settings schema"
msgid "Send anonymized usage data like what languages you're using Zed with.\n\nDefault: true"
msgstr "Envia dados de uso anonimizados, como as linguagens com as quais você usa o ForgeKairos.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Send debug info like crash reports.\n\nDefault: true"
msgstr "Envia informações de depuração, como relatórios de falha.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Session log (TeraTerm-style output recording) settings."
msgstr "Configurações do log da sessão (gravação da saída no estilo do TeraTerm)."

msgctxt "settings schema"
msgid "Sets the cursor blinking behavior in the terminal.\n\nDefault: terminal_controlled"
msgstr "Define o comportamento de piscar do cursor no terminal.\n\nPadrão: terminal_controlled"

msgctxt "settings schema"
msgid "Sets the debounce threshold (in milliseconds) after which changes are reflected in the git gutter.\n\nDefault: 0"
msgstr "Define o limite de debounce (em milissegundos) após o qual as alterações são refletidas na medianiz do Git.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "Sets the terminal's font fallbacks.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font fallbacks."
msgstr "Define as fontes alternativas do terminal.\n\nSe esta opção não for incluída, o terminal usará por padrão as fontes alternativas do buffer."

msgctxt "settings schema"
msgid "Sets the terminal's font family.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font family."
msgstr "Define a família da fonte do terminal.\n\nSe esta opção não for incluída, o terminal usará por padrão a família da fonte do buffer."

msgctxt "settings schema"
msgid "Sets the terminal's font size.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font size."
msgstr "Define o tamanho da fonte do terminal.\n\nSe esta opção não for incluída, o terminal usará por padrão o tamanho da fonte do buffer."

msgctxt "settings schema"
msgid "Sets the terminal's font weight in CSS weight units 0-900."
msgstr "Define o espessura da fonte do terminal em unidades CSS de 0 a 900."

msgctxt "settings schema"
msgid "Sets the terminal's line height.\n\nDefault: comfortable"
msgstr "Define a altura da linha do terminal.\n\nPadrão: comfortable"

msgctxt "settings schema"
msgid "Sets whether Alternate Scroll mode (code: ?1007) is active by default.\nAlternate Scroll mode converts mouse scroll events into up / down key\npresses when in the alternate screen (e.g. when running applications\nlike vim or  less). The terminal can still set and unset this mode.\n\nDefault: on"
msgstr "Define se o modo Alternate Scroll (código: ?1007) fica ativo por padrão.\nO modo Alternate Scroll converte eventos de rolagem do mouse em pressionamentos das teclas para cima / para baixo quando na tela alternativa (ex.: ao executar aplicativos como vim ou less). O terminal ainda pode ativar e desativar este modo.\n\nPadrão: on"

msgctxt "settings schema"
msgid "Sets whether the option key behaves as the meta key.\n\nDefault: false"
msgstr "Define se a tecla option se comporta como a tecla meta.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Settings for associating file extensions and filenames\nwith languages."
msgstr "Configurações para associar extensões e nomes de arquivo a linguagens."

msgctxt "settings schema"
msgid "Settings for automatic agent context compaction, which summarizes\nearlier messages to free up room in the model's context window once the\ncontext grows too large."
msgstr "Configurações da compactação automática do contexto do agente, que resume as mensagens anteriores para liberar espaço na janela de contexto do modelo quando o contexto fica grande demais."

msgctxt "settings schema"
msgid "Settings for automatically opening files."
msgstr "Configurações para abertura automática de arquivos."

msgctxt "settings schema"
msgid "Settings for configuring REPL display and behavior."
msgstr "Configurações para a exibição e o comportamento do REPL."

msgctxt "settings schema"
msgid "Settings for configuring the which-key popup behaviour."
msgstr "Configurações para o comportamento do pop-up which-key."

msgctxt "settings schema"
msgid "Settings for context servers used for AI-related features."
msgstr "Configurações para servidores de contexto usados em recursos de IA."

msgctxt "settings schema"
msgid "Settings for developer-oriented instrumentation tools (profilers,\ntracers, etc.) that can be toggled at runtime."
msgstr "Configurações das ferramentas de instrumentação voltadas a desenvolvedores (criadores de perfil, rastreadores etc.) que podem ser alternadas em tempo de execução."

msgctxt "settings schema"
msgid "Settings for language server notifications"
msgstr "Configurações para notificações do servidor de linguagem"

msgctxt "settings schema"
msgid "Settings for showing inline diagnostics."
msgstr "Configurações para exibição de diagnósticos embutidos."

msgctxt "settings schema"
msgid "Settings for sticking scopes to the top of the editor.\n\nDefault: sticky scroll is disabled"
msgstr "Configurações para fixar escopos no topo do editor.\n\nPadrão: a rolagem fixa está desabilitada"

msgctxt "settings schema"
msgid "Settings for tabular files such as CSV and TSV."
msgstr "Configurações de arquivos tabulares, como CSV e TSV."

msgctxt "settings schema"
msgid "Settings for the built-in IDE server.\n\nThe server binds a random port on `127.0.0.1` only and never talks to the\nnetwork, so it is outside the scope of the egress allowlist."
msgstr "Configurações do servidor IDE integrado.\n\nO servidor escuta em uma porta aleatória somente em `127.0.0.1` e nunca se comunica com a rede, por isso fica fora do escopo da lista de permissões de comunicação externa."

msgctxt "settings schema"
msgid "Settings for the built-in browser panel."
msgstr "Configurações do painel do navegador integrado."

msgctxt "settings schema"
msgid "Settings for the built-in loopback IDE server."
msgstr "Configurações do servidor IDE de loopback integrado."

msgctxt "settings schema"
msgid "Settings for the machine a remote project runs on, as opposed to the\nlists of connections next to them. Written under `\"remote\"` in\n`settings.json`, and carried to the remote host with the rest of the user\nsettings, which is where they take effect."
msgstr "Configurações da máquina em que um projeto remoto é executado, em oposição às listas de conexões ao lado delas. Escritas em `\"remote\"` no `settings.json` e levadas ao host remoto com o restante das configurações do usuário, que é onde elas têm efeito."

msgctxt "settings schema"
msgid "Settings for the threads sidebar."
msgstr "Configurações da barra lateral de conversas."

msgctxt "settings schema"
msgid "Settings for the which-key popup."
msgstr "Configurações para o pop-up which-key."

msgctxt "settings schema"
msgid "Settings for using LSP pull diagnostics mechanism in Zed."
msgstr "Configurações para o mecanismo de diagnósticos por pull do LSP no ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to Vim mode in Zed."
msgstr "Configurações relacionadas ao modo Vim no ForgeKairos."

msgctxt "settings schema"
msgid "Settings related to indent guides in the outline panel."
msgstr "Configurações relacionadas às guias de recuo no painel de estrutura."

msgctxt "settings schema"
msgid "Settings related to indent guides in the project panel."
msgstr "Configurações relacionadas às guias de recuo no painel do projeto."

msgctxt "settings schema"
msgid "Settings related to the command palette."
msgstr "Configurações relacionadas à paleta de comandos."

msgctxt "settings schema"
msgid "Settings related to the file finder."
msgstr "Configurações relacionadas ao localizador de arquivos."

msgctxt "settings schema"
msgid "Settings specific to Codestral."
msgstr "Configurações específicas do Codestral."

msgctxt "settings schema"
msgid "Settings specific to GitHub Copilot."
msgstr "Configurações específicas do GitHub Copilot."

msgctxt "settings schema"
msgid "Settings specific to Ollama."
msgstr "Configurações específicas do Ollama."

msgctxt "settings schema"
msgid "Settings specific to Zed's Edit Predictions provider."
msgstr "Configurações específicas do provedor de previsões de edição do Zed."

msgctxt "settings schema"
msgid "Settings specific to journaling"
msgstr "Configurações específicas do diário"

msgctxt "settings schema"
msgid "Settings specific to the Mercury Edit Predictions provider."
msgstr "Configurações específicas do provedor de previsões de edição do Mercury."

msgctxt "settings schema"
msgid "Settings specific to using custom OpenAI-compatible servers for edit prediction."
msgstr "Configurações específicas para usar servidores personalizados compatíveis com OpenAI para previsão de edição."

msgctxt "settings schema"
msgid "Settings that apply to the host a remote project runs on."
msgstr "Configurações que se aplicam ao host em que um projeto remoto é executado."

msgctxt "settings schema"
msgid "Settings-layer–free model mode enum.\n\nMirrors the shape of `settings_content::ModelMode` but lives here so that\ncrates below the settings layer can reference it."
msgstr "Enumeração de modo do modelo independente da camada de configurações.\n\nEspelha a forma de `settings_content::ModelMode`, mas fica aqui para que crates abaixo da camada de configurações possam referenciá-la."

msgctxt "settings schema"
msgid "Settings-layer–free reasoning-effort enum.\n\nMirrors the shape of `settings_content::OpenAiReasoningEffort` but lives\nhere so that crates below the settings layer can reference it."
msgstr "Enumeração de profundidade de raciocínio independente da camada de configurações.\n\nEspelha a forma de `settings_content::OpenAiReasoningEffort`, mas fica aqui para que crates abaixo da camada de configurações possam referenciá-la."

msgctxt "settings schema"
msgid "Shell configuration to open the terminal with."
msgstr "Configuração de shell para abrir o terminal."

msgctxt "settings schema"
msgid "Show a disclosure chevron followed by a folder icon."
msgstr "Mostra uma seta de expansão seguida por um ícone de pasta."

msgctxt "settings schema"
msgid "Show a disclosure chevron."
msgstr "Mostra uma seta de expansão."

msgctxt "settings schema"
msgid "Show a folder icon."
msgstr "Mostra um ícone de pasta."

msgctxt "settings schema"
msgid "Show all diagnostic levels: hint, information, warnings, error."
msgstr "Mostra todos os níveis de diagnóstico: dica, informação, avisos, erro."

msgctxt "settings schema"
msgid "Show an empty untitled buffer when opening a new window"
msgstr "Mostra um buffer vazio sem título ao abrir uma nova janela"

msgctxt "settings schema"
msgid "Show diffs in a single unified view."
msgstr "Mostra os diffs em uma única exibição unificada."

msgctxt "settings schema"
msgid "Show diffs in a split view."
msgstr "Mostra os diffs em uma exibição dividida."

msgctxt "settings schema"
msgid "Show directories first, then files"
msgstr "Mostrar diretórios primeiro, depois arquivos"

msgctxt "settings schema"
msgid "Show file name first, then path"
msgstr "Mostrar nome do arquivo primeiro, depois o caminho"

msgctxt "settings schema"
msgid "Show files first, then directories"
msgstr "Mostrar arquivos primeiro, depois diretórios"

msgctxt "settings schema"
msgid "Show full path first"
msgstr "Mostrar caminho completo primeiro"

msgctxt "settings schema"
msgid "Show git blame in the status bar at the bottom of the window."
msgstr "Mostra o Git blame na barra de status na parte inferior da janela."

msgctxt "settings schema"
msgid "Show git blame inline at the current line."
msgstr "Mostra o Git blame embutido na linha atual."

msgctxt "settings schema"
msgid "Show git gutter in tracked files."
msgstr "Mostrar medianiz do Git em arquivos rastreados."

msgctxt "settings schema"
msgid "Show on all open editors."
msgstr "Mostra o minimapa em todos os editores abertos."

msgctxt "settings schema"
msgid "Show only the following diagnostic level: error."
msgstr "Mostra apenas o seguinte nível de diagnóstico: erro."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: information, warning, error."
msgstr "Mostra apenas os seguintes níveis de diagnóstico: informação, aviso, erro."

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: warning, error."
msgstr "Mostra apenas os seguintes níveis de diagnóstico: aviso, erro."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects (no tabs)."
msgstr "Mostra o Launchpad com projetos recentes (sem abas)."

msgctxt "settings schema"
msgid "Show the launchpad with recent projects when opening a new window"
msgstr "Mostra o Launchpad com projetos recentes ao abrir uma nova janela"

msgctxt "settings schema"
msgid "Show the minimap on the active editor only."
msgstr "Mostra o minimapa somente no editor ativo."

msgctxt "settings schema"
msgid "Show the minimap thumb only when the mouse is hovering over the minimap."
msgstr "Mostra o controle deslizante do minimapa somente quando o mouse estiver sobre o minimapa."

msgctxt "settings schema"
msgid "Show the scrollbar if there's important information or\nfollow the system's configured behavior."
msgstr "Mostra a barra de rolagem se houver informações importantes ou segue o comportamento configurado no sistema."

msgctxt "settings schema"
msgid "Show unstaged hunks hollow and staged hunks with a filled background."
msgstr "Mostrar blocos não preparados vazados e blocos preparados com fundo preenchido."

msgctxt "settings schema"
msgid "Show unstaged hunks with a filled background and staged hunks hollow."
msgstr "Mostrar blocos não preparados com fundo preenchido e blocos preparados vazados."

msgctxt "settings schema"
msgid "Size of the border surrounding the active pane.\nWhen set to 0, the active pane doesn't have any border.\nThe border is drawn inset.\n\nDefault: `0.0`"
msgstr "Tamanho da borda ao redor do subpainel ativo.\nQuando definido como 0, o subpainel ativo não tem borda.\nA borda é desenhada para dentro.\n\nPadrão: `0.0`"

msgctxt "settings schema"
msgid "Soft wrap line at the preferred line length or the editor width (whichever is smaller)."
msgstr "Quebra a linha no comprimento de linha preferido ou na largura do editor (o que for menor)."

msgctxt "settings schema"
msgid "Soft wrap lines that exceed the editor width."
msgstr "Quebra automaticamente as linhas que excedem a largura do editor."

msgctxt "settings schema"
msgid "Sort snippets normally using the default comparison logic"
msgstr "Classifica os snippets normalmente usando a lógica de comparação padrão"

msgctxt "settings schema"
msgid "Spacing between worktree entries in the project panel.\n\nDefault: comfortable"
msgstr "Espaçamento entre as entradas da árvore de trabalho no painel do projeto.\n\nPadrão: comfortable"

msgctxt "settings schema"
msgid "Specifies the density of the UI.\nNote: This setting is still experimental. See [this tracking issue](https://github.com/zed-industries/zed/issues/18078)"
msgstr "Especifica a densidade da interface.\nObservação: esta configuração ainda é experimental. Veja [esta issue de acompanhamento](https://github.com/zed-industries/zed/issues/18078)"

msgctxt "settings schema"
msgid "Start searching as you type in project search, without pressing Enter."
msgstr "Inicia a pesquisa ao digitar na pesquisa do projeto, sem pressionar Enter."

msgctxt "settings schema"
msgid "Sticky scroll related settings"
msgstr "Configurações relacionadas à rolagem fixa"

msgctxt "settings schema"
msgid "String substituted for `${separator}` in the window title format.\nInclude any surrounding whitespace in the value.\n\nDefault: ` — `"
msgstr "String que substitui `${separator}` no formato do título da janela.\nInclua no valor qualquer espaço em branco ao redor.\n\nPadrão: ` — `"

msgctxt "settings schema"
msgid "Suggesting and installing missing development tools."
msgstr "Sugestão e instalação de ferramentas de desenvolvimento ausentes."

msgctxt "settings schema"
msgid "Suggestions of the development tools (language servers, formatters) that\nthe language of an opened file needs, when they are missing."
msgstr "Sugestões das ferramentas de desenvolvimento (servidores de linguagem, formatadores) de que a linguagem de um arquivo aberto precisa, quando estão ausentes."

msgctxt "settings schema"
msgid "Supported reasoning effort levels, for example `[\"low\", \"medium\", \"high\"]."
msgstr "Níveis de profundidade de raciocínio suportados, ex.: `[\"low\", \"medium\", \"high\"]."

msgctxt "settings schema"
msgid "TODO: this should just be a bool\nControls the behavior of formatting files when they are saved."
msgstr "TODO: this should just be a bool\nControla o comportamento da formatação dos arquivos quando são salvos."

msgctxt "settings schema"
msgid "Takes up the full width of the window"
msgstr "Ocupa a largura total da janela"

msgctxt "settings schema"
msgid "Task configuration for this language.\n\nDefault: {}"
msgstr "Configuração de tarefas para esta linguagem.\n\nPadrão: {}"

msgctxt "settings schema"
msgid "Terminal ANSI background color."
msgstr "Cor de fundo ANSI do terminal."

msgctxt "settings schema"
msgid "Terminal background color."
msgstr "Cor de fundo do terminal."

msgctxt "settings schema"
msgid "Terminal foreground color."
msgstr "Cor de primeiro plano do terminal."

msgctxt "settings schema"
msgid "Text Color. Color of muted or deemphasized text. It is a subdued version of the standard text color."
msgstr "Cor de texto. Cor do texto atenuado ou sem destaque. É uma versão mais suave da cor de texto padrão."

msgctxt "settings schema"
msgid "Text Color. Color of the placeholder text typically shown in input fields to guide the user to enter valid data."
msgstr "Cor de texto. Cor do texto de exemplo normalmente exibido em campos de entrada para orientar o usuário a inserir dados válidos."

msgctxt "settings schema"
msgid "Text Color. Color used for emphasis or highlighting certain text, like an active filter or a matched character in a search."
msgstr "Cor de texto. Cor usada para ênfase ou destaque de determinado texto, como um filtro ativo ou um caractere correspondente em uma pesquisa."

msgctxt "settings schema"
msgid "Text Color. Color used for text denoting disabled elements. Typically, the color is faded or grayed out to emphasize the disabled state."
msgstr "Cor de texto. Cor usada para texto que denota elementos desabilitados. Normalmente, a cor é desbotada ou acinzentada para enfatizar o estado desabilitado."

msgctxt "settings schema"
msgid "Text Color. Default text color used for most text."
msgstr "Cor de texto. Cor de texto padrão usada para a maior parte do texto."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is highlighted."
msgstr "Cor de texto. Usada para o texto do número de linha na medianiz do editor quando a linha está destacada."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is hovered over."
msgstr "Cor de texto. Usada para o texto do número de linha na medianiz do editor quando o cursor está sobre a linha."

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter."
msgstr "Cor de texto. Usada para o texto do número de linha na medianiz do editor."

msgctxt "settings schema"
msgid "Text Color. Used to mark invisible characters in the editor.\n\nExample: spaces, tabs, carriage returns, etc."
msgstr "Cor do texto. Usada para marcar caracteres invisíveis no editor.\n\nExemplo: espaços, tabulações, retornos de carro etc."

msgctxt "settings schema"
msgid "Text color used for CodeLens items in the editor."
msgstr "Cor do texto usada para os itens de CodeLens no editor."

msgctxt "settings schema"
msgid "The AI browser panel, which holds the AI tabs that AI agents drive."
msgstr "O painel do navegador de IA, que contém as abas de IA que os agentes de IA controlam."

msgctxt "settings schema"
msgid "The API protocol to use for this model: \"anthropic\", \"openai_responses\", \"openai_chat\", or \"google\". Defaults to \"openai_chat\"."
msgstr "O protocolo de API a ser usado para este modelo: \"anthropic\", \"openai_responses\", \"openai_chat\" ou \"google\". O padrão é \"openai_chat\"."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka n_ctx)."
msgstr "O parâmetro de comprimento de contexto do modelo (também conhecido como n_ctx)."

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka num_ctx or n_ctx)"
msgstr "O parâmetro de comprimento de contexto do modelo (também conhecido como num_ctx ou n_ctx)"

msgctxt "settings schema"
msgid "The HTTPS host the account's token signs in to, such as `github.com`.\nWithout one, pushing and pulling sign in as git is configured to."
msgstr "O host HTTPS no qual o token da conta faz login, como `github.com`.\nSem ele, o push e o pull fazem login conforme o Git estiver configurado."

msgctxt "settings schema"
msgid "The OAuth client ID obtained from out-of-band registration with the\nauthorization server."
msgstr "O ID do cliente OAuth obtido no registro fora de banda com o servidor de autorização."

msgctxt "settings schema"
msgid "The OAuth client secret, if this is a confidential client. For security,\nprefer providing this interactively; we will prompt and store it in\nthe system keychain."
msgstr "O segredo do cliente OAuth, se este for um cliente confidencial. Por segurança, prefira fornecê-lo de forma interativa; ele será solicitado e armazenado no chaveiro do sistema."

msgctxt "settings schema"
msgid "The OpenAI Chat Completions API (`/chat/completions`)."
msgstr "A API OpenAI Chat Completions (`/chat/completions`)."

msgctxt "settings schema"
msgid "The OpenAI Responses API (`/responses`)."
msgstr "A API OpenAI Responses (`/responses`)."

msgctxt "settings schema"
msgid "The OpenAI-compatible API this model must be called through."
msgstr "A API compatível com OpenAI por meio da qual este modelo deve ser chamado."

msgctxt "settings schema"
msgid "The OpenType features to enable for rendering in text buffers."
msgstr "Os recursos OpenType a habilitar para renderização em buffers de texto."

msgctxt "settings schema"
msgid "The OpenType features to enable for text in the UI."
msgstr "Os recursos OpenType a habilitar para o texto na interface."

msgctxt "settings schema"
msgid "The SHA of the commit to apply."
msgstr "O SHA do commit a aplicar."

msgctxt "settings schema"
msgid "The SHA of the commit to check out."
msgstr "O SHA do commit para fazer checkout."

msgctxt "settings schema"
msgid "The SHA of the commit to put the changes into."
msgstr "O SHA do commit no qual colocar as alterações."

msgctxt "settings schema"
msgid "The SHA of the commit to remove."
msgstr "O SHA do commit a remover."

msgctxt "settings schema"
msgid "The SHA of the commit to reset to."
msgstr "O SHA do commit para o qual redefinir."

msgctxt "settings schema"
msgid "The SHA of the commit to start the branch from."
msgstr "O SHA do commit a partir do qual iniciar o branch."

msgctxt "settings schema"
msgid "The SHA of the commit to tag."
msgstr "O SHA do commit a marcar com tag."

msgctxt "settings schema"
msgid "The SHA of the commit to undo."
msgstr "O SHA do commit a desfazer."

msgctxt "settings schema"
msgid "The SHA of the commit whose message to rewrite."
msgstr "O SHA do commit cuja mensagem será reescrita."

msgctxt "settings schema"
msgid "The SHA of the commit."
msgstr "O SHA do commit."

msgctxt "settings schema"
msgid "The URL of the Zed server to connect to."
msgstr "A URL do servidor Zed ao qual se conectar."

msgctxt "settings schema"
msgid "The URL of the remote context server."
msgstr "A URL do servidor de contexto remoto."

msgctxt "settings schema"
msgid "The URL template used by `browser_panel::AskCopilot`. `{query}` is\nreplaced with the percent-encoded query when present; without the\nplaceholder the page is opened as-is and the query is put on the\nclipboard instead.\n\nDefault: https://github.com/copilot"
msgstr "O modelo de URL usado por `browser_panel::AskCopilot`. `{query}` é substituído pela consulta codificada em porcentagem, quando presente; sem o marcador de posição, a página é aberta como está e a consulta é colocada na área de transferência.\n\nPadrão: https://github.com/copilot"

msgctxt "settings schema"
msgid "The URL template used when the address bar input is not a URL, and for\n`browser_panel::SearchSelection`. `{query}` is replaced with the\npercent-encoded query.\n\nDefault: https://www.google.com/search?q={query}"
msgstr "O modelo de URL usado quando a entrada da barra de endereço não é um URL e para `browser_panel::SearchSelection`. `{query}` é substituído pela consulta codificada em porcentagem.\n\nPadrão: https://www.google.com/search?q={query}"

msgctxt "settings schema"
msgid "The URL used as the key for credential storage.\n\nWhen set, credentials are stored under this URL instead of `server_url`.\nThis allows running multiple Zed instances side by side without them\noverwriting each other's keychain entries."
msgstr "O URL usado como chave para o armazenamento de credenciais.\n\nQuando definido, as credenciais são armazenadas sob este URL em vez de `server_url`.\nIsso permite executar várias instâncias do ForgeKairos lado a lado sem que uma sobrescreva as entradas do chaveiro da outra."

msgctxt "settings schema"
msgid "The account each repository commits and pushes as, by the absolute path of\nthe repository's working directory. A repository not listed here uses git's\nown configuration. Only read from the user settings file.\n\nDefault: {}"
msgstr "A conta com a qual cada repositório faz commit e push, pelo caminho absoluto do diretório de trabalho do repositório. Um repositório não listado aqui usa a própria configuração do Git. Lido somente do arquivo de configurações do usuário.\n\nPadrão: {}"

msgctxt "settings schema"
msgid "The alt key\nSometimes also known as the 'meta' key"
msgstr "A tecla alt\nÀs vezes também chamada de tecla 'meta'"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline blame in units of columns.\n\nDefault: 7"
msgstr "A quantidade de espaçamento entre o fim da linha de código e o início do blame embutido, em unidades de colunas.\n\nPadrão: 7"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline diagnostic in units of columns.\n\nDefault: 4"
msgstr "A quantidade de espaçamento entre o fim da linha de código e o início do diagnóstico embutido, em unidades de colunas.\n\nPadrão: 4"

msgctxt "settings schema"
msgid "The arguments to pass to the command. Use `*` for a single wildcard argument.\nIf the last element is `**`, then any trailing arguments are allowed."
msgstr "Os argumentos a passar para o comando. Use `*` para um único argumento curinga.\nSe o último elemento for `**`, quaisquer argumentos finais são permitidos."

msgctxt "settings schema"
msgid "The arguments to pass to the program."
msgstr "Os argumentos a serem passados ao programa."

msgctxt "settings schema"
msgid "The arguments to pass to the program.\n\nSupported placeholders:\n\n- `{buffer_path}`: the path of the buffer being formatted, or\n  `Untitled` when it has never been saved.\n- `{start_line}` and `{end_line}`: the first and last line of a\n  selected range, 1-based and inclusive. An argument naming either\n  of them is repeated once per selected range when formatting\n  selections (e.g. `\"--lines={start_line}:{end_line}\"` for\n  clang-format), and is dropped when formatting the whole buffer.\n  Naming them is also what marks the command as able to format\n  selections at all."
msgstr "Os argumentos a passar para o programa.\n\nMarcadores de posição suportados:\n\n- `{buffer_path}`: o caminho do buffer sendo formatado, ou `Untitled` quando ele nunca foi salvo.\n- `{start_line}` e `{end_line}`: a primeira e a última linha de um intervalo selecionado, contadas a partir de 1 e inclusivas. Um argumento que mencione qualquer um deles é repetido uma vez por intervalo selecionado ao formatar seleções (ex.: `\"--lines={start_line}:{end_line}\"` para o clang-format) e é descartado ao formatar o buffer inteiro.\n  Mencioná-los também é o que marca o comando como capaz de formatar seleções."

msgctxt "settings schema"
msgid "The author and committer email (`user.email`)."
msgstr "O e-mail do autor e do committer (`user.email`)."

msgctxt "settings schema"
msgid "The author and committer name (`user.name`)."
msgstr "O nome do autor e do committer (`user.name`)."

msgctxt "settings schema"
msgid "The available agent profiles."
msgstr "Os perfis de agente disponíveis."

msgctxt "settings schema"
msgid "The background appearance of the window."
msgstr "A aparência do plano de fundo da janela."

msgctxt "settings schema"
msgid "The background color of the scrollbar track."
msgstr "A cor de fundo da trilha da barra de rolagem."

msgctxt "settings schema"
msgid "The base URL for the provider (e.g., \"https://code.corp.big.com\")."
msgstr "A URL base do provedor (ex.: \"https://code.corp.big.com\")."

msgctxt "settings schema"
msgid "The behavior of `editor::Rewrap`."
msgstr "O comportamento de `editor::Rewrap`."

msgctxt "settings schema"
msgid "The border color of the minimap thumb."
msgstr "A cor da borda do controle deslizante do minimapa."

msgctxt "settings schema"
msgid "The border color of the scrollbar thumb."
msgstr "A cor da borda do controle deslizante da barra de rolagem."

msgctxt "settings schema"
msgid "The border color of the scrollbar track."
msgstr "A cor da borda da trilha da barra de rolagem."

msgctxt "settings schema"
msgid "The buffer's line height."
msgstr "A altura de linha do buffer."

msgctxt "settings schema"
msgid "The capabilities granted to extensions."
msgstr "As permissões concedidas às extensões."

msgctxt "settings schema"
msgid "The color of the minimap thumb when hovered over."
msgstr "A cor do controle deslizante do minimapa ao passar o cursor."

msgctxt "settings schema"
msgid "The color of the minimap thumb whilst being actively dragged."
msgstr "A cor do controle deslizante do minimapa enquanto está sendo arrastado."

msgctxt "settings schema"
msgid "The color of the minimap thumb."
msgstr "A cor do controle deslizante do minimapa."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb when hovered over."
msgstr "A cor do controle deslizante da barra de rolagem ao passar o cursor."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb whilst being actively dragged."
msgstr "A cor do controle deslizante da barra de rolagem enquanto está sendo arrastado."

msgctxt "settings schema"
msgid "The color of the scrollbar thumb."
msgstr "A cor do controle deslizante da barra de rolagem."

msgctxt "settings schema"
msgid "The column at which to soft-wrap lines, for buffers where soft-wrap\nis enabled.\n\nDefault: 80"
msgstr "A coluna na qual aplicar a quebra automática de linha, para buffers em que a quebra automática está habilitada.\n\nPadrão: 80"

msgctxt "settings schema"
msgid "The command key, on macos\nthe windows key, on windows\nthe super key, on linux"
msgstr "A tecla command, no macOS\na tecla Windows, no Windows\na tecla super, no Linux"

msgctxt "settings schema"
msgid "The command to execute."
msgstr "O comando a ser executado."

msgctxt "settings schema"
msgid "The content of a serialized theme."
msgstr "O conteúdo de um tema serializado."

msgctxt "settings schema"
msgid "The contents of the edit prediction settings."
msgstr "O conteúdo das configurações de previsão de edição."

msgctxt "settings schema"
msgid "The control key"
msgstr "A tecla Control"

msgctxt "settings schema"
msgid "The debounce delay before querying highlights from the language\nserver based on the current cursor location.\n\nDefault: 75"
msgstr "O atraso de debounce antes de consultar destaques no servidor de linguagem com base na posição atual do cursor.\n\nPadrão: 75"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 0"
msgstr "O atraso de debounce, em milissegundos, antes de solicitar automaticamente uma previsão depois que a digitação para. Defina como 0 para solicitar previsões imediatamente.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 150"
msgstr "O atraso de debounce, em milissegundos, antes de solicitar automaticamente uma previsão depois que a digitação para. Defina como 0 para solicitar previsões imediatamente.\n\nPadrão: 150"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 75"
msgstr "O atraso de debounce, em milissegundos, antes de solicitar automaticamente uma previsão depois que a digitação para. Defina como 0 para solicitar previsões imediatamente.\n\nPadrão: 75"

msgctxt "settings schema"
msgid "The default UI density."
msgstr "A densidade padrão da interface."

msgctxt "settings schema"
msgid "The default behavior when opening paths from the CLI without\nan explicit `-e` or `-n` flag.\n\nDefault: existing_window"
msgstr "O comportamento padrão ao abrir caminhos pela CLI sem uma flag `-e` ou `-n` explícita.\n\nPadrão: existing_window"

msgctxt "settings schema"
msgid "The default behavior when opening projects from the UI.\n\nDefault: existing_window"
msgstr "O comportamento padrão ao abrir projetos pela interface.\n\nPadrão: existing_window"

msgctxt "settings schema"
msgid "The default font size for rendering in text buffers."
msgstr "O tamanho de fonte padrão para renderização em buffers de texto."

msgctxt "settings schema"
msgid "The default font size for text in the UI."
msgstr "O tamanho de fonte padrão para o texto da interface."

msgctxt "settings schema"
msgid "The default language model selected when using this profile."
msgstr "O modelo de linguagem padrão selecionado ao usar este perfil."

msgctxt "settings schema"
msgid "The default line height."
msgstr "A altura de linha padrão."

msgctxt "settings schema"
msgid "The default mode to use for this agent.\n\nNote: Not only all agents support modes.\n\nDefault: None"
msgstr "O modo padrão a usar para este agente.\n\nObservação: nem todos os agentes oferecem suporte a modos.\n\nPadrão: None"

msgctxt "settings schema"
msgid "The default model to use when creating new chats and for other features when a specific model is not specified."
msgstr "O modelo padrão a ser usado ao criar novas conversas e para outros recursos quando nenhum modelo específico estiver definido."

msgctxt "settings schema"
msgid "The default profile to use in the Agent.\n\nDefault: write"
msgstr "O perfil padrão a usar no agente.\n\nPadrão: write"

msgctxt "settings schema"
msgid "The default temperature to use for this model."
msgstr "A temperatura padrão a ser usada para este modelo."

msgctxt "settings schema"
msgid "The delay in milliseconds that must elapse before drag and drop is allowed. Otherwise, a new text selection is created.\n\nDefault: 300"
msgstr "O atraso, em milissegundos, que precisa decorrer antes que arrastar e soltar seja permitido. Caso contrário, uma nova seleção de texto é criada.\n\nPadrão: 300"

msgctxt "settings schema"
msgid "The display name for the provider (e.g., \"BigCorp GitHub\")."
msgstr "O nome de exibição do provedor (ex.: \"BigCorp GitHub\")."

msgctxt "settings schema"
msgid "The dock position of the debug panel\n\nDefault: Bottom"
msgstr "A posição do dock do painel de depuração\n\nPadrão: Bottom"

msgctxt "settings schema"
msgid "The edit prediction settings."
msgstr "As configurações de previsão de edição."

msgctxt "settings schema"
msgid "The editor will not scroll beyond the last line."
msgstr "O editor não rolará além da última linha."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by one page."
msgstr "O editor rolará além da última linha em uma página."

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by the same number of lines as vertical_scroll_margin."
msgstr "O editor rolará além da última linha pelo número de linhas definido em vertical_scroll_margin."

msgctxt "settings schema"
msgid "The extensions that should be automatically installed by Zed.\n\nThis is used to make functionality provided by extensions (e.g., language support)\navailable out-of-the-box.\n\nDefault: {}"
msgstr "As extensões que devem ser instaladas automaticamente pelo ForgeKairos.\n\nIsso é usado para disponibilizar de imediato a funcionalidade fornecida por extensões (ex.: suporte a linguagens).\n\nPadrão: {}"

msgctxt "settings schema"
msgid "The external program to run."
msgstr "O programa externo a ser executado."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in text buffers."
msgstr "As fontes alternativas a serem usadas para renderização em buffers de texto."

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in the UI."
msgstr "As fontes alternativas a serem usadas para renderização na interface."

msgctxt "settings schema"
msgid "The font size for agent responses in the agent panel. Falls back to the UI font size if unset."
msgstr "O tamanho de fonte para respostas do agente no painel do agente. Usa o tamanho de fonte da interface se não definido."

msgctxt "settings schema"
msgid "The font size for user messages in the agent panel."
msgstr "O tamanho de fonte para mensagens do usuário no painel do agente."

msgctxt "settings schema"
msgid "The font size to use for rendering in the markdown preview.\nFalls back to the UI font size if unset."
msgstr "O tamanho da fonte a usar para a renderização na visualização do Markdown.\nQuando não definido, usa o tamanho da fonte da interface."

msgctxt "settings schema"
msgid "The function key"
msgstr "A tecla Fn"

msgctxt "settings schema"
msgid "The granularity of one 'step' in the stepping requests `next`, `stepIn`, `stepOut`, and `stepBack`."
msgstr "A granularidade de um 'passo' nas solicitações de passo `next`, `stepIn`, `stepOut` e `stepBack`."

msgctxt "settings schema"
msgid "The guardrail identifier (ARN or ID) to apply to Bedrock API requests."
msgstr "O identificador da barreira de proteção (ARN ou ID) a ser aplicado às solicitações da API Bedrock."

msgctxt "settings schema"
msgid "The guardrail version to use. Defaults to \"DRAFT\" if not specified."
msgstr "A versão da barreira de proteção a ser usada. Usa \"DRAFT\" por padrão se não especificada."

msgctxt "settings schema"
msgid "The icon theme to use for dark mode."
msgstr "O tema de ícones a ser usado no modo escuro."

msgctxt "settings schema"
msgid "The icon theme to use for light mode."
msgstr "O tema de ícones a ser usado no modo claro."

msgctxt "settings schema"
msgid "The key commits are signed with (`user.signingkey`), when signing is on."
msgstr "A chave com a qual os commits são assinados (`user.signingkey`), quando a assinatura está ativada."

msgctxt "settings schema"
msgid "The key to use for adding multiple cursors\n\nDefault: alt"
msgstr "A tecla a usar para adicionar vários cursores\n\nPadrão: alt"

msgctxt "settings schema"
msgid "The language of the UI: \"system\" to follow the operating system, or a BCP 47\ntag such as \"en\", \"ja\" or \"pt-BR\".\n\nDefault: \"system\""
msgstr "O idioma da interface: \"system\" para seguir o sistema operacional ou uma tag BCP 47 como \"en\", \"ja\" ou \"pt-BR\".\n\nPadrão: \"system\""

msgctxt "settings schema"
msgid "The language server and, in C and C++, the symbol index."
msgstr "O servidor de linguagem e, em C e C++, o índice de símbolos."

msgctxt "settings schema"
msgid "The layout of window control buttons as represented by user settings.\n\nCustom layout strings use the GNOME `button-layout` format (e.g.\n`\"close:minimize,maximize\"`)."
msgstr "O layout dos botões de controle da janela conforme representado nas configurações do usuário.\n\nAs strings de layout personalizadas usam o formato `button-layout` do GNOME (ex.: `\"close:minimize,maximize\"`)."

msgctxt "settings schema"
msgid "The layout of window control buttons in the title bar (Linux only).\n\nThis can be set to \"platform_default\" to follow the system configuration, or\n\"standard\" to use Zed's built-in layout. For custom layouts, use a\nGNOME-style layout string like \"close:minimize,maximize\".\n\nDefault: \"platform_default\""
msgstr "O layout dos botões de controle da janela na barra de título (somente Linux).\n\nPode ser definido como \"platform_default\" para seguir a configuração do sistema ou \"standard\" para usar o layout integrado do ForgeKairos. Para layouts personalizados, use uma string de layout no estilo GNOME, como \"close:minimize,maximize\".\n\nPadrão: \"platform_default\""

msgctxt "settings schema"
msgid "The list of custom Git hosting providers."
msgstr "A lista de provedores de hospedagem Git personalizados."

msgctxt "settings schema"
msgid "The list of language servers to use (or disable) for this language.\n\nThis array should consist of language server IDs, as well as the following\nspecial tokens:\n- `\"!<language_server_id>\"` - A language server ID prefixed with a `!` will be disabled.\n- `\"...\"` - A placeholder to refer to the **rest** of the registered language servers for this language.\n\nDefault: [\"...\"]"
msgstr "A lista de servidores de linguagem a usar (ou desabilitar) para esta linguagem.\n\nEste array deve consistir em IDs de servidores de linguagem, além dos seguintes tokens especiais:\n- `\"!<language_server_id>\"` - Um ID de servidor de linguagem prefixado com `!` será desabilitado.\n- `\"...\"` - Um marcador de posição que se refere ao **restante** dos servidores de linguagem registrados para esta linguagem.\n\nPadrão: [\"...\"]"

msgctxt "settings schema"
msgid "The maximum amount of time to wait for responses from language servers, in seconds.\nA value of `0` will result in no timeout being applied (causing all LSP responses to wait indefinitely until completed).\n\nDefault: `120`"
msgstr "O tempo máximo de espera pelas respostas dos servidores de linguagem, em segundos.\nUm valor `0` faz com que nenhum tempo limite seja aplicado (todas as respostas do LSP aguardam indefinidamente até serem concluídas).\n\nPadrão: `120`"

msgctxt "settings schema"
msgid "The maximum line length a buffer may contain before language server features are disabled for the entire buffer.\n\nDefault: `20000`"
msgstr "O comprimento máximo de linha que um buffer pode conter antes que os recursos do servidor de linguagem sejam desabilitados para o buffer inteiro.\n\nPadrão: `20000`"

msgctxt "settings schema"
msgid "The maximum number of completion tokens allowed by the model (o1-* only)"
msgstr "O número máximo de tokens de resposta permitidos pelo modelo (somente o1-*)"

msgctxt "settings schema"
msgid "The maximum number of lines to keep in the scrollback history.\nMaximum allowed value is 100_000, all values above that will be treated as 100_000.\n0 disables the scrolling.\nExisting terminals will not pick up this change until they are recreated.\nSee <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">Alacritty documentation</a> for more information.\n\nDefault: 10_000"
msgstr "O número máximo de linhas a manter no histórico de rolagem.\nO valor máximo permitido é 100_000; todos os valores acima disso são tratados como 100_000.\n0 desabilita a rolagem.\nOs terminais existentes só adotam esta alteração quando são recriados.\nVeja a <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">documentação do Alacritty</a> para mais informações.\n\nPadrão: 10_000"

msgctxt "settings schema"
msgid "The maximum number of output tokens allowed by the model."
msgstr "O número máximo de tokens de saída permitidos pelo modelo."

msgctxt "settings schema"
msgid "The maximum width, in pixels, of the rendered markdown content when\n`limit_content_width` is enabled.\n\nDefault: 800"
msgstr "A largura máxima, em pixels, do conteúdo Markdown renderizado quando `limit_content_width` está habilitado.\n\nPadrão: 800"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast between foreground and background colors.\n\nAPCA (Accessible Perceptual Contrast Algorithm) is more accurate than WCAG 2.x,\nespecially for dark mode. Values range from 0 to 106.\n\nBased on APCA Readability Criterion (ARC) Bronze Simple Mode:\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: No contrast adjustment\n- 45: Minimum for large fluent text (36px+)\n- 60: Minimum for other content text\n- 75: Minimum for body text\n- 90: Preferred for body text\n\nDefault: 45"
msgstr "O contraste perceptual APCA mínimo entre as cores de primeiro plano e de fundo.\n\nO APCA (Accessible Perceptual Contrast Algorithm) é mais preciso que o WCAG 2.x, especialmente no modo escuro. Os valores vão de 0 a 106.\n\nBaseado no APCA Readability Criterion (ARC) Bronze Simple Mode:\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: sem ajuste de contraste\n- 45: mínimo para texto corrido grande (36px+)\n- 60: mínimo para outros textos de conteúdo\n- 75: mínimo para o texto do corpo\n- 90: preferido para o texto do corpo\n\nPadrão: 45"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast to maintain when\nrendering text over highlight backgrounds in the editor.\n\nValues range from 0 to 106. Set to 0 to disable adjustments.\nDefault: 45"
msgstr "O contraste perceptual APCA mínimo a manter ao renderizar texto sobre fundos destacados no editor.\n\nOs valores vão de 0 a 106. Defina como 0 para desabilitar os ajustes.\nPadrão: 45"

msgctxt "settings schema"
msgid "The minimum column number to show the inline blame information at\n\nDefault: 0"
msgstr "O número mínimo de coluna em que mostrar as informações do blame embutido\n\nPadrão: 0"

msgctxt "settings schema"
msgid "The minimum column to display inline diagnostics. This setting can be\nused to horizontally align inline diagnostics at some position. Lines\nlonger than this value will still push diagnostics further to the right.\n\nDefault: 0"
msgstr "A coluna mínima para exibir diagnósticos embutidos. Esta configuração pode ser usada para alinhar horizontalmente os diagnósticos embutidos em uma determinada posição. Linhas mais longas que este valor ainda empurram os diagnósticos mais para a direita.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "The minimum width (in em-widths) at which the split diff view is used.\nWhen the editor is narrower than this, the diff view automatically\nswitches to unified mode and switches back when the editor is wide\nenough. Set to 0 to disable automatic switching.\n\nDefault: 100"
msgstr "A largura mínima (em larguras de em) na qual a exibição de diff lado a lado é usada.\nQuando o editor é mais estreito que isso, a exibição do diff muda automaticamente para o modo unificado e volta quando o editor fica largo o suficiente. Defina como 0 para desabilitar a troca automática.\n\nPadrão: 100"

msgctxt "settings schema"
msgid "The mode in which edit predictions should be displayed."
msgstr "O modo no qual as previsões de edição devem ser exibidas."

msgctxt "settings schema"
msgid "The mode use to select a theme.\n\n`Light` and `Dark` will select their respective themes.\n\n`System` will select the theme based on the system's appearance."
msgstr "O modo usado para selecionar um tema.\n\n`Light` e `Dark` selecionam os respectivos temas.\n\n`System` seleciona o tema com base na aparência do sistema."

msgctxt "settings schema"
msgid "The mode used to determine which theme to use."
msgstr "O modo usado para determinar qual tema usar."

msgctxt "settings schema"
msgid "The mode used to display edit predictions in the buffer.\nProvider support required."
msgstr "O modo usado para exibir as previsões de edição no buffer.\nRequer suporte do provedor."

msgctxt "settings schema"
msgid "The model id as expected in Bedrock Mantle request bodies, e.g. `openai.gpt-5.5`."
msgstr "O ID do modelo conforme esperado nos corpos de solicitação do Bedrock Mantle, ex.: `openai.gpt-5.5`."

msgctxt "settings schema"
msgid "The model id reported by the llama.cpp server (its `--alias` or the model file path)."
msgstr "O ID do modelo informado pelo servidor llama.cpp (seu `--alias` ou o caminho do arquivo do modelo)."

msgctxt "settings schema"
msgid "The model name in the Ollama API (e.g. \"llama3.2:latest\")"
msgstr "O nome do modelo na API do Ollama (ex.: \"llama3.2:latest\")"

msgctxt "settings schema"
msgid "The model to use for subagents spawned via the `spawn_agent` tool. Defaults to the parent agent's model when not specified."
msgstr "O modelo a ser usado para subagentes iniciados pela ferramenta `spawn_agent`. Usa o modelo do agente pai por padrão quando não especificado."

msgctxt "settings schema"
msgid "The model's context window size."
msgstr "O tamanho da janela de contexto do modelo."

msgctxt "settings schema"
msgid "The model's mode (e.g. thinking)"
msgstr "O modo do modelo (ex.: thinking)"

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the agent panel."
msgstr "O nome do modelo na interface do ForgeKairos, como no menu suspenso de seleção de modelo no painel do agente."

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the assistant panel."
msgstr "O nome do modelo na interface do ForgeKairos, como no menu suspenso do seletor de modelo no painel do assistente."

msgctxt "settings schema"
msgid "The model's name in the Anthropic API. e.g. claude-3-5-sonnet-latest, claude-3-opus-20240229, etc"
msgstr "O nome do modelo na API da Anthropic. Ex.: claude-3-5-sonnet-latest, claude-3-opus-20240229, etc."

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-20240620"
msgstr "O nome do modelo na API do provedor. Ex.: claude-3-5-sonnet-20240620"

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-latest"
msgstr "O nome do modelo na API do provedor, ex.: claude-3-5-sonnet-latest"

msgctxt "settings schema"
msgid "The multiplier for scrolling with the mouse wheel.\n\nDefault: 1.0"
msgstr "O multiplicador da rolagem com a roda do mouse.\n\nPadrão: 1.0"

msgctxt "settings schema"
msgid "The name displayed in the UI, such as in the agent panel model dropdown menu."
msgstr "O nome exibido na interface, como no menu suspenso de modelo do painel do agente."

msgctxt "settings schema"
msgid "The name of a font to use for agent responses in the agent panel. Falls back to the UI font if unset."
msgstr "O nome da fonte usada nas respostas do agente no painel do agente. Usa a fonte da interface como alternativa se não for definida."

msgctxt "settings schema"
msgid "The name of a font to use for code (code blocks and inline code) in the\nmarkdown preview. Falls back to the buffer font if unset."
msgstr "O nome de uma fonte a usar para o código (blocos de código e código embutido) na visualização do Markdown. Quando não definido, usa a fonte do buffer."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in text buffers."
msgstr "O nome da fonte a ser usada para renderização em buffers de texto."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the UI."
msgstr "O nome da fonte a ser usada para renderização na interface."

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the markdown preview.\nFalls back to the UI font if unset."
msgstr "O nome de uma fonte a usar para a renderização na visualização do Markdown.\nQuando não definido, usa a fonte da interface."

msgctxt "settings schema"
msgid "The name of a font to use for user messages in the agent panel. Falls back to the buffer font if unset."
msgstr "O nome da fonte usada nas mensagens do usuário no painel do agente. Usa a fonte do buffer como alternativa se não for definida."

msgctxt "settings schema"
msgid "The name of the Zed theme to use."
msgstr "O nome do tema do ForgeKairos a ser usado."

msgctxt "settings schema"
msgid "The name of the icon theme to use."
msgstr "O nome do tema de ícones a ser usado."

msgctxt "settings schema"
msgid "The name of the language server to format with"
msgstr "O nome do servidor de linguagem a ser usado para formatação"

msgctxt "settings schema"
msgid "The name of the model.\n\nDefault: \"\""
msgstr "O nome do modelo.\n\nPadrão: \"\""

msgctxt "settings schema"
msgid "The name the account is picked by, unique among the accounts."
msgstr "O nome pelo qual a conta é escolhida, único entre as contas."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files, which answers\nproject-wide symbol search, \"go to definition\" when the language server has\nno answer, and callers and callees, without compilation information."
msgstr "O índice de símbolos por nome de arquivos C e C++, que responde à pesquisa de símbolos em todo o projeto, a \"Ir para definição\" quando o servidor de linguagem não tem resposta e a chamadores e chamados, sem informações de compilação."

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files."
msgstr "O índice de símbolos por nome de arquivos C e C++."

msgctxt "settings schema"
msgid "The number of characters to keep on either side when scrolling with the mouse.\n\nDefault: 5."
msgstr "O número de caracteres a manter de cada lado ao rolar com o mouse.\n\nPadrão: 5."

msgctxt "settings schema"
msgid "The number of lines to keep above/below the cursor when auto-scrolling.\n\nDefault: 3."
msgstr "O número de linhas a manter acima/abaixo do cursor durante a rolagem automática.\n\nPadrão: 3."

msgctxt "settings schema"
msgid "The number of seconds to keep the connection open after the last request"
msgstr "O número de segundos para manter a conexão aberta após a última solicitação"

msgctxt "settings schema"
msgid "The page opened when a built-in browser panel or tab first loads.\n\nDefault: https://m365.cloud.microsoft/chat"
msgstr "A página aberta quando um painel ou aba do navegador integrado é carregado pela primeira vez.\n\nPadrão: https://m365.cloud.microsoft/chat"

msgctxt "settings schema"
msgid "The path of the directory where journal entries are stored.\n\nDefault: `~`"
msgstr "O caminho do diretório onde as entradas do diário são armazenadas.\n\nPadrão: `~`"

msgctxt "settings schema"
msgid "The path to the Node binary."
msgstr "O caminho para o binário do Node."

msgctxt "settings schema"
msgid "The path to the npm binary Zed should use (defaults to `.path/../npm`)."
msgstr "O caminho para o binário npm que o ForgeKairos deve usar (padrão: `.path/../npm`)."

msgctxt "settings schema"
msgid "The position of outline panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "A posição do painel de estrutura\n\nPadrão: right (layout Agentic), left (layout Classic)"

msgctxt "settings schema"
msgid "The position of project panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "A posição do painel do projeto\n\nPadrão: right (layout Agentic), left (layout Classic)"

msgctxt "settings schema"
msgid "The private key file (an absolute path, or one starting with `~`) that pushing, pulling\nand fetching reach SSH remotes with, offered alone (`IdentitiesOnly`). Local projects\nonly. Not used when `GIT_SSH_COMMAND`, `GIT_SSH` or `core.sshCommand` is set."
msgstr "O arquivo de chave privada (um caminho absoluto ou iniciado por `~`) com o qual o push, o pull e o fetch alcançam remotos SSH, oferecido sozinho (`IdentitiesOnly`). Somente projetos locais. Não é usado quando `GIT_SSH_COMMAND`, `GIT_SSH` ou `core.sshCommand` está definido."

msgctxt "settings schema"
msgid "The program to run."
msgstr "O programa a ser executado."

msgctxt "settings schema"
msgid "The prompt format to use for completions. Set to `\"\"` to have the format be derived from the model name.\n\nDefault: \"\""
msgstr "O formato de prompt a usar para preenchimentos automáticos. Defina como `\"\"` para que o formato seja derivado do nome do modelo.\n\nPadrão: \"\""

msgctxt "settings schema"
msgid "The provider of the language model."
msgstr "O provedor do modelo de linguagem."

msgctxt "settings schema"
msgid "The provider that supplies edit predictions."
msgstr "O provedor que fornece previsões de edição."

msgctxt "settings schema"
msgid "The regex pattern to match."
msgstr "O padrão de expressão regular usado para correspondência."

msgctxt "settings schema"
msgid "The relative width of the left padding of the central pane from the\nworkspace when the centered layout is used.\n\nDefault: 0.2"
msgstr "A largura relativa do espaçamento à esquerda do subpainel central em relação ao espaço de trabalho quando o layout centralizado é usado.\n\nPadrão: 0.2"

msgctxt "settings schema"
msgid "The settings for a particular language."
msgstr "As configurações para uma linguagem específica."

msgctxt "settings schema"
msgid "The settings for cursor shape."
msgstr "As configurações para a forma do cursor."

msgctxt "settings schema"
msgid "The settings for indent guides."
msgstr "As configurações para as guias de recuo."

msgctxt "settings schema"
msgid "The settings for individual languages."
msgstr "As configurações para linguagens individuais."

msgctxt "settings schema"
msgid "The settings for inlay hints."
msgstr "As configurações para as dicas embutidas."

msgctxt "settings schema"
msgid "The settings for the image viewer."
msgstr "As configurações para o visualizador de imagens."

msgctxt "settings schema"
msgid "The settings for the markdown preview."
msgstr "As configurações da visualização do Markdown."

msgctxt "settings schema"
msgid "The settings for this context server specified by the extension.\n\nConsult the documentation for the context server to see what settings\nare supported."
msgstr "As configurações deste servidor de contexto especificadas pela extensão.\n\nConsulte a documentação do servidor de contexto para ver quais configurações são suportadas."

msgctxt "settings schema"
msgid "The settings overrides for this profile."
msgstr "As substituições de configurações para este perfil."

msgctxt "settings schema"
msgid "The shape of a selection cursor."
msgstr "O formato do cursor de seleção."

msgctxt "settings schema"
msgid "The shift key"
msgstr "A tecla Shift"

msgctxt "settings schema"
msgid "The size of the context window, indicating the maximum number of tokens the model can process."
msgstr "O tamanho da janela de contexto, indicando o número máximo de tokens que o modelo pode processar."

msgctxt "settings schema"
msgid "The size of the workspace split drop targets on the outer edges.\nGiven as a fraction that will be multiplied by the smaller dimension of the workspace.\n\nDefault: `0.2` (20% of the smaller dimension of the workspace)"
msgstr "O tamanho das áreas de soltura para divisão nas bordas externas do espaço de trabalho.\nDado como uma fração que é multiplicada pela menor dimensão do espaço de trabalho.\n\nPadrão: `0.2` (20% da menor dimensão do espaço de trabalho)"

msgctxt "settings schema"
msgid "The smallest model context window (in tokens) for which auto-compaction\nstill runs. Models below this are left uncompacted and the UI warns\nabout the token limit instead. Lower this to make auto-compaction work\nwith local models that have a small context window. Values below 8000\nare clamped to 8000.\n\nDefault: 80000"
msgstr "A menor janela de contexto de modelo (em tokens) para a qual a compactação automática ainda é executada. Modelos abaixo disso ficam sem compactação e a interface avisa sobre o limite de tokens. Diminua este valor para que a compactação automática funcione com modelos locais que têm uma janela de contexto pequena. Valores abaixo de 8000 são limitados a 8000.\n\nPadrão: 80000"

msgctxt "settings schema"
msgid "The standard spacing of entries."
msgstr "O espaçamento padrão de entradas."

msgctxt "settings schema"
msgid "The state of the modifier keys at some point in time"
msgstr "O estado das teclas modificadoras em um determinado momento"

msgctxt "settings schema"
msgid "The step should allow one instruction to execute (e.g. one x86 instruction)."
msgstr "O passo deve permitir a execução de uma instrução (ex.: uma instrução x86)."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current source line has executed."
msgstr "O passo deve permitir que o programa execute até que a linha de código atual seja concluída."

msgctxt "settings schema"
msgid "The step should allow the program to run until the current statement has finished executing.\nThe meaning of a statement is determined by the adapter and it may be considered equivalent to a line.\nFor example 'for(int i = 0; i < 10; i++)' could be considered to have 3 statements 'int i = 0', 'i < 10', and 'i++'."
msgstr "O passo deve permitir que o programa seja executado até que a instrução atual termine de ser executada.\nO significado de uma instrução é determinado pelo adaptador e pode ser considerado equivalente a uma linha.\nPor exemplo, 'for(int i = 0; i < 10; i++)' pode ser considerado como tendo 3 instruções: 'int i = 0', 'i < 10' e 'i++'."

msgctxt "settings schema"
msgid "The styles for syntax nodes."
msgstr "Os estilos para nós de sintaxe."

msgctxt "settings schema"
msgid "The subscription for this model: \"zen\" or \"go\". Defaults to Zen."
msgstr "A assinatura para este modelo: \"zen\" ou \"go\". O padrão é Zen."

msgctxt "settings schema"
msgid "The task settings for a particular language."
msgstr "As configurações de tarefa para uma linguagem específica."

msgctxt "settings schema"
msgid "The text rendering mode to use.\n\nDefault: platform_default"
msgstr "O modo de renderização de texto a usar.\n\nPadrão: platform_default"

msgctxt "settings schema"
msgid "The theme to use for dark mode."
msgstr "O tema a usar no modo escuro."

msgctxt "settings schema"
msgid "The theme to use for light mode."
msgstr "O tema a usar no modo claro."

msgctxt "settings schema"
msgid "The theme to use for the markdown preview.\nFalls back to the main editor theme if unset."
msgstr "O tema a usar para a visualização do Markdown.\nQuando não definido, usa o tema principal do editor."

msgctxt "settings schema"
msgid "The threshold at which auto-compaction runs. This is one of:\n\n- A percentage string ending in `%`, e.g. `\"90%\"`, measured against the\n  model's context window. `\"90%\"` compacts once the context is 90% full.\n- A positive integer: compaction runs once that many tokens have been\n  used. For example, `100000` compacts after 100,000 tokens are used.\n- A negative integer: compaction runs once that many tokens remain in\n  the context window. For example, `-20000` compacts once there are\n  fewer than 20,000 tokens of headroom left in the context window.\n\n`0` is not a valid threshold.\n\nDefault: \"90%\""
msgstr "O limite em que a compactação automática é executada. Pode ser um dos seguintes:\n\n- Uma string de porcentagem terminada em `%`, ex.: `\"90%\"`, medida em relação à janela de contexto do modelo. `\"90%\"` compacta quando o contexto está 90% cheio.\n- Um inteiro positivo: a compactação é executada quando esse número de tokens tiver sido usado. Por exemplo, `100000` compacta depois que 100.000 tokens são usados.\n- Um inteiro negativo: a compactação é executada quando restar esse número de tokens na janela de contexto. Por exemplo, `-20000` compacta quando restam menos de 20.000 tokens de folga na janela de contexto.\n\n`0` não é um limite válido.\n\nPadrão: \"90%\""

msgctxt "settings schema"
msgid "The topic whose entries to show first, such as \"merge_request\". Without it, the usual order."
msgstr "O tópico cujas entradas devem ser mostradas primeiro, como \"merge_request\". Sem ele, a ordem habitual."

msgctxt "settings schema"
msgid "The type of the provider.\n\nMust be one of `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut`, or `tangled`."
msgstr "O tipo do provedor.\n\nDeve ser um de `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut` ou `tangled`."

msgctxt "settings schema"
msgid "The unit to use for displaying image file sizes.\n\nDefault: \"binary\""
msgstr "A unidade a usar para exibir os tamanhos de arquivos de imagem.\n\nPadrão: \"binary\""

msgctxt "settings schema"
msgid "The user name on `host` that goes with the token."
msgstr "O nome de usuário em `host` que acompanha o token."

msgctxt "settings schema"
msgid "The value to pass to the CLI's `--effort`, such as `low`, `medium` or `high`. Without it, the CLI uses its default."
msgstr "O valor a passar para o `--effort` da CLI, como `low`, `medium` ou `high`. Sem ele, a CLI usa o padrão dela."

msgctxt "settings schema"
msgid "The weight of the UI font in CSS units from 100 to 900."
msgstr "A espessura da fonte da interface em unidades CSS de 100 a 900."

msgctxt "settings schema"
msgid "The weight of the editor font in CSS units from 100 to 900."
msgstr "A espessura da fonte do editor em unidades CSS de 100 a 900."

msgctxt "settings schema"
msgid "The width of the active indent guide in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "A largura da guia de recuo ativa em pixels, entre 1 e 10.\n\nPadrão: 1"

msgctxt "settings schema"
msgid "The width of the git diff hunk indicators in the gutter.\nUse \"default\" to scale with the buffer font size, or {\"custom\": <pixels>} for a fixed width.\n\nDefault: \"default\""
msgstr "A largura dos indicadores de blocos do diff do Git na medianiz.\nUse \"default\" para acompanhar o tamanho da fonte do buffer ou {\"custom\": <pixels>} para uma largura fixa.\n\nPadrão: \"default\""

msgctxt "settings schema"
msgid "The width of the indent guides in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "A largura das guias de recuo em pixels, entre 1 e 10.\n\nPadrão: 1"

msgctxt "settings schema"
msgid "The window manager or compositor draws the server-side window\ndecorations (not supported by GNOME Wayland)."
msgstr "O gerenciador de janelas ou o compositor desenha as decorações da janela no lado do servidor (não suportado no GNOME Wayland)."

msgctxt "settings schema"
msgid "Theme name."
msgstr "Nome do tema."

msgctxt "settings schema"
msgid "Thinking blocks are always collapsed by default."
msgstr "Os blocos de raciocínio são sempre recolhidos por padrão."

msgctxt "settings schema"
msgid "Thinking blocks are always fully expanded by default (no height constraint)."
msgstr "Os blocos de raciocínio são sempre totalmente expandidos por padrão (sem restrição de altura)."

msgctxt "settings schema"
msgid "Thinking blocks auto-expand with a height constraint during streaming,\nthen remain in their constrained state when complete. Users can click\nto fully expand or collapse."
msgstr "Os blocos de raciocínio se expandem automaticamente com uma restrição de altura durante o streaming e permanecem nesse estado restrito quando concluídos. Os usuários podem clicar para expandir ou recolher totalmente."

msgctxt "settings schema"
msgid "Thinking blocks fully expand during streaming, then auto-collapse\nwhen the model finishes thinking. Users can re-expand after collapse."
msgstr "Os blocos de raciocínio se expandem totalmente durante o streaming e são recolhidos automaticamente quando o modelo termina de raciocinar. Os usuários podem expandi-los novamente depois de recolhidos."

msgctxt "settings schema"
msgid "Thinking effort levels this model accepts in Ollama's `think` parameter,\nfor example `[\"low\", \"medium\", \"high\"]`. Only some models (e.g. `gpt-oss`)\naccept a level instead of a plain on/off; leave unset for those that don't."
msgstr "Níveis de profundidade de raciocínio que este modelo aceita no parâmetro `think` do Ollama, por exemplo `[\"low\", \"medium\", \"high\"]`. Apenas alguns modelos (ex.: `gpt-oss`) aceitam um nível em vez de um simples ligado/desligado; deixe sem definir para os que não aceitam."

msgctxt "settings schema"
msgid "This base keymap settings adjusts the default keybindings in Zed to be similar\nto other common code editors. By default, Zed's keymap closely follows VSCode's\nkeymap, with minor adjustments, this corresponds to the \"VSCode\" setting.\n\nDefault: VSCode"
msgstr "Esta configuração de mapa de teclas base ajusta as associações de teclas padrão do ForgeKairos para serem semelhantes às de outros editores de código comuns. Por padrão, o mapa de teclas do ForgeKairos segue de perto o mapa de teclas do VSCode, com pequenos ajustes; isso corresponde à configuração \"VSCode\".\n\nPadrão: VSCode"

msgctxt "settings schema"
msgid "Time in milliseconds until timeout error when connecting to a TCP debug adapter\n\nDefault: 2000ms"
msgstr "Tempo em milissegundos até o erro de tempo limite ao conectar a um adaptador de depuração TCP\n\nPadrão: 2000 ms"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before hiding the hover popover\nafter the mouse moves away from the hover target.\nOnly applies when `hover_popover_sticky` is enabled.\n\nDefault: 300"
msgstr "Tempo de espera em milissegundos antes de ocultar o pop-up ao passar o cursor depois que o mouse se afasta do alvo.\nAplica-se somente quando `hover_popover_sticky` está habilitado.\n\nPadrão: 300"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before showing the informational hover box.\nThis delay also applies to auto signature help when `auto_signature_help` is enabled.\n\nDefault: 300"
msgstr "Tempo de espera em milissegundos antes de mostrar a caixa de informações ao passar o cursor.\nEste atraso também se aplica à ajuda de assinatura automática quando `auto_signature_help` está habilitado.\n\nPadrão: 300"

msgctxt "settings schema"
msgid "Timeout for hover and Cmd-click path hyperlink discovery in milliseconds.\n\nDefault: 1"
msgstr "Tempo limite, em milissegundos, para detectar hiperlinks de caminho ao passar o cursor e ao clicar com Cmd.\n\nPadrão: 1"

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to 60 if not specified."
msgstr "Tempo limite para chamadas de ferramentas em segundos. O padrão é 60 se não especificado."

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to global context_server_timeout if not specified."
msgstr "Tempo limite para chamadas de ferramentas em segundos. Se não for especificado, usa o valor global de context_server_timeout."

msgctxt "settings schema"
msgid "Timeout in milliseconds for automatically dismissing language server notifications.\nSet to 0 to disable auto-dismiss.\n\nDefault: 5000"
msgstr "Tempo limite, em milissegundos, para descartar automaticamente as notificações dos servidores de linguagem.\nDefina como 0 para desabilitar o descarte automático.\n\nPadrão: 5000"

msgctxt "settings schema"
msgid "Timeout in seconds for SSH connection and downloading the remote server binary.\nDefaults to 10 seconds if not specified."
msgstr "Tempo limite, em segundos, para a conexão SSH e o download do binário do servidor remoto.\nO padrão é 10 segundos se não for especificado."

msgctxt "settings schema"
msgid "Toggles inlay hints (hides or shows) when the user presses the modifiers specified.\nIf only a subset of the modifiers specified is pressed, hints are not toggled.\nIf no modifiers are specified, this is equivalent to `null`.\n\nDefault: null"
msgstr "Alterna as dicas embutidas (oculta ou mostra) quando o usuário pressiona os modificadores especificados.\nSe apenas parte dos modificadores especificados for pressionada, as dicas não são alternadas.\nSe nenhum modificador for especificado, isso equivale a `null`.\n\nPadrão: null"

msgctxt "settings schema"
msgid "Toolbar related settings"
msgstr "Configurações relacionadas à barra de ferramentas"

msgctxt "settings schema"
msgid "Treat files and folders matching these glob patterns as hidden, including\nfiles inside matching folders. To hide these entries, run\n`project panel: toggle hide hidden` from the command palette or set\n`project_panel.hide_hidden` to `true`.\n\nDefault:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Trata como ocultos os arquivos e pastas que correspondem a estes padrões glob, incluindo os arquivos dentro das pastas correspondentes. Para ocultar essas entradas, execute `project panel: toggle hide hidden` na paleta de comandos ou defina `project_panel.hide_hidden` como `true`.\n\nPadrão:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUse `\"...\"` para adicionar padrões sem repetir os padrões do ForgeKairos. Nas configurações do projeto, ele estende o valor da configuração do usuário ou da configuração pai. Omita `\"...\"` para substituir a lista herdada.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nOs padrões herdados são inseridos em `\"...\"`, e os duplicados mantêm a primeira ocorrência."

msgctxt "settings schema"
msgid "Treat files matching these glob patterns as read-only when opened. You can\nview but not edit them, which is useful for build outputs, external\ndependencies, or generated files.\n\nDefault:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "Trata como somente leitura, ao serem abertos, os arquivos que correspondem a estes padrões glob. Você pode visualizá-los, mas não editá-los, o que é útil para saídas de compilação, dependências externas ou arquivos gerados.\n\nPadrão:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUse `\"...\"` para adicionar padrões sem repetir os padrões do ForgeKairos. Nas configurações do projeto, ele estende o valor da configuração do usuário ou da configuração pai. Omita `\"...\"` para substituir a lista herdada.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nOs padrões herdados são inseridos em `\"...\"`, e os duplicados mantêm a primeira ocorrência."

msgctxt "settings schema"
msgid "Treat the files matching these globs as `.env` files.\nDefault: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"
msgstr "Trata os arquivos que correspondem a estes globs como arquivos `.env`.\nPadrão: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"

msgctxt "settings schema"
msgid "UNSTABLE: Expect many elements to be broken."
msgstr "INSTÁVEL: espere que muitos elementos estejam quebrados."

msgctxt "settings schema"
msgid "Underline cursor."
msgstr "Cursor de sublinhado."

msgctxt "settings schema"
msgid "Uppercase names are grouped before lowercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "Os nomes em maiúsculas são agrupados antes dos nomes em minúsculas, com ordenação natural sem diferenciar maiúsculas e minúsculas dentro de cada grupo. Os nomes iniciados por ponto vêm antes de ambos os grupos."

msgctxt "settings schema"
msgid "Use CRLF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "Usa CRLF para novos arquivos e arquivos sem convenção de terminação de linha existente, preservando os arquivos LF ou CRLF existentes."

msgctxt "settings schema"
msgid "Use LF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "Usa LF para novos arquivos e arquivos sem convenção de terminação de linha existente, preservando os arquivos LF ou CRLF existentes."

msgctxt "settings schema"
msgid "Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server."
msgstr "Usa a dobra do LSP sempre que possível, recorrendo à dobra baseada no Tree-sitter e no recuo quando o servidor não retorna resultados."

msgctxt "settings schema"
msgid "Use LSP semantic tokens exclusively, replacing tree-sitter highlighting."
msgstr "Usa os tokens semânticos LSP exclusivamente, substituindo o destaque do Tree-sitter."

msgctxt "settings schema"
msgid "Use LSP semantic tokens together with tree-sitter highlighting."
msgstr "Usa os tokens semânticos LSP em conjunto com o destaque do Tree-sitter."

msgctxt "settings schema"
msgid "Use LSP tasks over Zed language extension ones.\nIf no LSP tasks are returned due to error/timeout or regular execution,\nZed language extension tasks will be used instead.\n\nOther Zed tasks will still be shown:\n* Zed task from either of the task config file\n* Zed task from history (e.g. one-off task was spawned before)"
msgstr "Usa as tarefas do LSP em vez das tarefas das extensões de linguagem do ForgeKairos.\nSe nenhuma tarefa do LSP for retornada devido a erro/tempo limite ou à execução normal, as tarefas das extensões de linguagem do ForgeKairos serão usadas.\n\nAs outras tarefas do ForgeKairos continuam sendo mostradas:\n* tarefa do ForgeKairos de qualquer um dos arquivos de configuração de tarefas\n* tarefa do ForgeKairos do histórico (ex.: uma tarefa avulsa executada anteriormente)"

msgctxt "settings schema"
msgid "Use a custom line height."
msgstr "Usa uma altura de linha personalizada."

msgctxt "settings schema"
msgid "Use a different color for each indentation level."
msgstr "Usa uma cor diferente para cada nível de recuo."

msgctxt "settings schema"
msgid "Use a line height that's comfortable for reading, 1.618"
msgstr "Usa uma altura de linha confortável para leitura, 1.618"

msgctxt "settings schema"
msgid "Use a specific program with arguments."
msgstr "Usa um programa específico com argumentos."

msgctxt "settings schema"
msgid "Use a specific program with no arguments."
msgstr "Usa um programa específico sem argumentos."

msgctxt "settings schema"
msgid "Use a standard line height, 1.3. This option is useful for TUIs,\nparticularly if they use box characters"
msgstr "Usa uma altura de linha padrão, 1.3. Esta opção é útil para TUIs, principalmente se elas usam caracteres de caixa"

msgctxt "settings schema"
msgid "Use all gitignored files"
msgstr "Usa todos os arquivos ignorados pelo Git"

msgctxt "settings schema"
msgid "Use conda"
msgstr "Usar conda"

msgctxt "settings schema"
msgid "Use grayscale text rendering."
msgstr "Usa renderização de texto em escala de cinza."

msgctxt "settings schema"
msgid "Use macOS's native fullscreen, which moves the window into its own\nMission Control space."
msgstr "Usa a tela cheia nativa do macOS, que move a janela para o próprio espaço do Mission Control."

msgctxt "settings schema"
msgid "Use mamba"
msgstr "Usar mamba"

msgctxt "settings schema"
msgid "Use micromamba"
msgstr "Usar micromamba"

msgctxt "settings schema"
msgid "Use only the files Zed had indexed"
msgstr "Usa apenas os arquivos indexados pelo ForgeKairos"

msgctxt "settings schema"
msgid "Use platform default behavior."
msgstr "Usa o comportamento padrão da plataforma."

msgctxt "settings schema"
msgid "Use subpixel (ClearType-style) text rendering."
msgstr "Usa renderização de texto subpixel (estilo ClearType)."

msgctxt "settings schema"
msgid "Use system clipboard for yank operations."
msgstr "Usa a área de transferência do sistema para operações de yank."

msgctxt "settings schema"
msgid "Use system clipboard."
msgstr "Usa a área de transferência do sistema."

msgctxt "settings schema"
msgid "Use the current file's directory, falling back to the project directory,\nthen the first project in the workspace."
msgstr "Usa o diretório do arquivo atual, recorrendo ao diretório do projeto e, depois, ao primeiro projeto do espaço de trabalho."

msgctxt "settings schema"
msgid "Use the current file's project directory. Fallback to the\nfirst project directory strategy if unsuccessful."
msgstr "Usa o diretório do projeto do arquivo atual. Se não for possível, recorre à estratégia do primeiro diretório de projeto."

msgctxt "settings schema"
msgid "Use the first project in this workspace's directory. Fallback to using\nthis platform's home directory."
msgstr "Usa o diretório do primeiro projeto deste espaço de trabalho. Se não for possível, usa o diretório inicial desta plataforma."

msgctxt "settings schema"
msgid "Use the language server's `textDocument/documentSymbol` LSP response for outlines and\nbreadcrumbs. When enabled, tree-sitter is not used for document symbols."
msgstr "Usa a resposta LSP `textDocument/documentSymbol` do servidor de linguagem para a estrutura e as trilhas de navegação. Quando habilitado, o Tree-sitter não é usado para os símbolos do documento."

msgctxt "settings schema"
msgid "Use the preference previously set via the status-bar toggle, or false\nif no preference has been stored."
msgstr "Usa a preferência definida anteriormente pela alternância da barra de status, ou false se nenhuma preferência tiver sido armazenada."

msgctxt "settings schema"
msgid "Use the same color for all indentation levels."
msgstr "Usa a mesma cor para todos os níveis de recuo."

msgctxt "settings schema"
msgid "Use the specified `dark` theme."
msgstr "Usa o tema `dark` especificado."

msgctxt "settings schema"
msgid "Use the specified `light` theme."
msgstr "Usa o tema `light` especificado."

msgctxt "settings schema"
msgid "Use the system's default terminal configuration in /etc/passwd"
msgstr "Usa a configuração padrão de terminal do sistema em /etc/passwd"

msgctxt "settings schema"
msgid "Use the theme based on the system's appearance."
msgstr "Usa o tema com base na aparência do sistema."

msgctxt "settings schema"
msgid "Use tree-sitter queries to compute document symbols for outlines and breadcrumbs (default)."
msgstr "Usa consultas do Tree-sitter para calcular os símbolos do documento para a estrutura e as trilhas (padrão)."

msgctxt "settings schema"
msgid "Used for the background of a ghost element that should have the same background as the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have a different background than the surface it's on, use `element_background`."
msgstr "Usada para o fundo de um elemento fantasma que deve ter o mesmo fundo da superfície em que está.\n\nOs elementos podem incluir: botões, campos de entrada, caixas de seleção, botões de opção...\n\nPara um elemento que deve ter um fundo diferente da superfície em que está, use `element_background`."

msgctxt "settings schema"
msgid "Vertical bar cursor."
msgstr "Cursor em barra vertical."

msgctxt "settings schema"
msgid "Vertically center the target in the viewport."
msgstr "Centraliza verticalmente o alvo na área visível."

msgctxt "settings schema"
msgid "Visible characters used to render whitespace when show_whitespaces is enabled.\n\nDefault: \"•\" for spaces, \"→\" for tabs."
msgstr "Caracteres visíveis usados para renderizar espaços em branco quando show_whitespaces está habilitado.\n\nPadrão: \"•\" para espaços, \"→\" para tabulações."

msgctxt "settings schema"
msgid "What `git reset` keeps of the changes."
msgstr "O que o `git reset` mantém das alterações."

msgctxt "settings schema"
msgid "What base settings to start from before applying this profile's overrides.\n\n- `user`: Apply on top of user's settings (default)\n- `default`: Apply on top of Zed's default settings, ignoring user customizations"
msgstr "Quais configurações base usar como ponto de partida antes de aplicar as substituições deste perfil.\n\n- `user`: aplica sobre as configurações do usuário (padrão)\n- `default`: aplica sobre as configurações padrão do ForgeKairos, ignorando as personalizações do usuário"

msgctxt "settings schema"
msgid "What format to display the hours in.\n\nDefault: hour12"
msgstr "O formato em que as horas são exibidas.\n\nPadrão: hour12"

msgctxt "settings schema"
msgid "What shell to use when opening a terminal.\n\nDefault: system"
msgstr "Qual shell usar ao abrir um terminal.\n\nPadrão: system"

msgctxt "settings schema"
msgid "What the default branch name should be when\n`init.defaultBranch` is not set in git\n\nDefault: main"
msgstr "Qual deve ser o nome do branch padrão quando `init.defaultBranch` não está definido no Git\n\nPadrão: main"

msgctxt "settings schema"
msgid "What to do after closing the current tab.\n\nDefault: history"
msgstr "O que fazer depois de fechar a aba atual.\n\nPadrão: history"

msgctxt "settings schema"
msgid "What to do when go to definition yields no results."
msgstr "O que fazer quando ir para definição não retorna resultados."

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts\n(parts of singleton buffers).\n\nDefault: select"
msgstr "O que fazer quando se dá um clique duplo em algum dos trechos do multibuffer (partes de buffers únicos).\n\nPadrão: select"

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts (parts of singleton buffers)."
msgstr "O que fazer quando um multibuffer é clicado duas vezes em algum de seus trechos (partes de buffers individuais)."

msgctxt "settings schema"
msgid "What to do when the `BEL` character (`\\a`) is printed to terminal.\n\nDefault: \"system\""
msgstr "O que fazer quando o caractere `BEL` (`\\a`) é impresso no terminal.\n\nPadrão: \"system\""

msgctxt "settings schema"
msgid "What to do when the last window is closed\n\nDefault: auto (nothing on macOS, \"app quit\" otherwise)"
msgstr "O que fazer quando a última janela é fechada\n\nPadrão: auto (nada no macOS, \"app quit\" nos demais)"

msgctxt "settings schema"
msgid "What to show for directories in the git panel.\n\nDefault: icon"
msgstr "O que mostrar para os diretórios no painel do Git.\n\nPadrão: icon"

msgctxt "settings schema"
msgid "What to show for directories in the outline panel.\n\nDefault: icon"
msgstr "O que mostrar para os diretórios no painel de estrutura.\n\nPadrão: icon"

msgctxt "settings schema"
msgid "What to show for directories in the project panel.\n\nDefault: icon"
msgstr "O que mostrar para os diretórios no painel do projeto.\n\nPadrão: icon"

msgctxt "settings schema"
msgid "What to show when opening a new window.\nValues: empty_tab, launchpad\nDefault: launchpad"
msgstr "O que mostrar ao abrir uma nova janela.\nValores: empty_tab, launchpad\nPadrão: launchpad"

msgctxt "settings schema"
msgid "What working directory to use when launching the terminal\n\nDefault: current_project_directory"
msgstr "Qual diretório de trabalho usar ao iniciar o terminal\n\nPadrão: current_project_directory"

msgctxt "settings schema"
msgid "When enabled, edit predictions are shown in Vim normal mode.\nBy default, edit predictions are only shown in insert and replace modes."
msgstr "Quando habilitado, as previsões de edição são mostradas no modo normal do Vim.\nPor padrão, as previsões de edição são mostradas apenas nos modos de inserção e substituição."

msgctxt "settings schema"
msgid "When enabled, the `:substitute` command replaces all matches in a line\nby default. The 'g' flag then toggles this behavior.,"
msgstr "Quando habilitado, o comando `:substitute` substitui por padrão todas as correspondências em uma linha. A flag 'g' então alterna esse comportamento.,"

msgctxt "settings schema"
msgid "When false, forcefully disables the horizontal scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Quando false, desabilita à força a barra de rolagem horizontal. Caso contrário, obedece às outras configurações.\n\nPadrão: true"

msgctxt "settings schema"
msgid "When false, forcefully disables the vertical scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "Quando false, desabilita à força a barra de rolagem vertical. Caso contrário, obedece às outras configurações.\n\nPadrão: true"

msgctxt "settings schema"
msgid "When fetching LSP completions, determines how long to wait for a response of a particular server.\nWhen set to 0, waits indefinitely.\n\nDefault: 0"
msgstr "Ao obter preenchimentos automáticos do LSP, determina quanto tempo aguardar a resposta de um servidor específico.\nQuando definido como 0, aguarda indefinidamente.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane."
msgstr "Quando o painel do agente mostra a barra de abas do próprio subpainel."

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane.\n\nDefault: auto"
msgstr "Quando o painel do agente mostra a barra de abas do próprio subpainel.\n\nPadrão: auto"

msgctxt "settings schema"
msgid "When the attachments of one message add up to more than this many\nbytes, the largest ones are sent as an outline or a reference until the\nmessage fits. Attachments set to be sent in full are never reduced.\n\nDefault: 65536"
msgstr "Quando os anexos de uma mensagem somam mais do que este número de bytes, os maiores são enviados como uma estrutura ou uma referência até que a mensagem caiba. Anexos definidos para serem enviados completos nunca são reduzidos.\n\nPadrão: 65536"

msgctxt "settings schema"
msgid "When to automatically save edited buffers.\n\nDefault: off"
msgstr "Quando salvar automaticamente os buffers editados.\n\nPadrão: off"

msgctxt "settings schema"
msgid "When to index the worktree's C and C++ files.\n\nDefault: auto"
msgstr "Quando indexar os arquivos C e C++ da árvore de trabalho.\n\nPadrão: auto"

msgctxt "settings schema"
msgid "When to play a sound when the agent has either completed its response, or needs user input.\n\nDefault: never"
msgstr "Quando tocar um som quando o agente concluir a resposta ou precisar de entrada do usuário.\n\nPadrão: never"

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor."
msgstr "Quando preencher a consulta de uma nova pesquisa com base no texto sob o cursor."

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor.\n\nDefault: always"
msgstr "Quando preencher a consulta de uma nova pesquisa com base no texto sob o cursor.\n\nPadrão: always"

msgctxt "settings schema"
msgid "When to scan content of linked directories."
msgstr "Quando varrer o conteúdo de diretórios vinculados."

msgctxt "settings schema"
msgid "When to scan content of linked directories.\n\nDefault: expanded"
msgstr "Quando varrer o conteúdo dos diretórios vinculados.\n\nPadrão: expanded"

msgctxt "settings schema"
msgid "When to show the minimap in the editor.\n\nDefault: never"
msgstr "Quando mostrar o minimapa no editor.\n\nPadrão: never"

msgctxt "settings schema"
msgid "When to show the minimap thumb.\n\nDefault: always"
msgstr "Quando mostrar o controle deslizante do minimapa.\n\nPadrão: always"

msgctxt "settings schema"
msgid "When to show the scrollbar in the completion menu.\nThis setting can take four values:\n\n1. Show the scrollbar if there's important information or\n   follow the system's configured behavior\n  \"auto\"\n2. Match the system's configured behavior:\n   \"system\"\n3. Always show the scrollbar:\n   \"always\"\n4. Never show the scrollbar:\n   \"never\" (default)"
msgstr "Quando mostrar a barra de rolagem no menu de preenchimento automático.\nEsta configuração pode ter quatro valores:\n\n1. Mostrar a barra de rolagem se houver informações importantes ou seguir o comportamento configurado no sistema\n  \"auto\"\n2. Seguir o comportamento configurado no sistema:\n   \"system\"\n3. Sempre mostrar a barra de rolagem:\n   \"always\"\n4. Nunca mostrar a barra de rolagem:\n   \"never\" (padrão)"

msgctxt "settings schema"
msgid "When to show the scrollbar in the editor.\n\nDefault: auto"
msgstr "Quando mostrar a barra de rolagem no editor.\n\nPadrão: auto"

msgctxt "settings schema"
msgid "When to show the scrollbar in the outline panel."
msgstr "Quando mostrar a barra de rolagem no painel de estrutura."

msgctxt "settings schema"
msgid "When to show the scrollbar in the project panel.\n\nDefault: inherits editor scrollbar settings"
msgstr "Quando mostrar a barra de rolagem no painel do projeto.\n\nPadrão: herda as configurações da barra de rolagem do editor"

msgctxt "settings schema"
msgid "When to show the scrollbar in the terminal.\n\nDefault: inherits editor scrollbar settings"
msgstr "Quando mostrar a barra de rolagem no terminal.\n\nPadrão: herda as configurações da barra de rolagem do editor"

msgctxt "settings schema"
msgid "When to show the scrollbar.\n\nDefault: auto"
msgstr "Quando mostrar a barra de rolagem.\n\nPadrão: auto"

msgctxt "settings schema"
msgid "When true, enables drag and drop text selection in buffer.\n\nDefault: true"
msgstr "Quando true, habilita arrastar e soltar a seleção de texto no buffer.\n\nPadrão: true"

msgctxt "settings schema"
msgid "When using OpenAiChat protocol, whether thinking tokens are sent as a dedicated `reasoning_content` field or inline in message text."
msgstr "Ao usar o protocolo OpenAiChat, define se os tokens de raciocínio são enviados como um campo dedicado `reasoning_content` ou embutidos no texto da mensagem."

msgctxt "settings schema"
msgid "Where to dock the AI browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Onde posicionar o painel do navegador de IA. Pode ser 'left', 'right' ou 'bottom'.\n\nPadrão: right"

msgctxt "settings schema"
msgid "Where to dock the agent panel.\n\nDefault: left (Agentic layout), right (Classic layout)"
msgstr "Onde posicionar o painel do agente.\n\nPadrão: left (layout Agentic), right (layout Classic)"

msgctxt "settings schema"
msgid "Where to dock the browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "Onde posicionar o painel do navegador. Pode ser 'left', 'right' ou 'bottom'.\n\nPadrão: right"

msgctxt "settings schema"
msgid "Where to dock the call graph panel.\n\nDefault: right"
msgstr "Onde posicionar o painel do grafo de chamadas.\n\nPadrão: right"

msgctxt "settings schema"
msgid "Where to dock the panel.\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "Onde posicionar o painel.\n\nPadrão: right (layout Agentic), left (layout Classic)"

msgctxt "settings schema"
msgid "Where to keep the changes."
msgstr "Onde manter as alterações."

msgctxt "settings schema"
msgid "Where to position the threads sidebar."
msgstr "Onde posicionar a barra lateral de conversas."

msgctxt "settings schema"
msgid "Where to position the threads sidebar.\n\nDefault: left"
msgstr "Onde posicionar a barra lateral de conversas.\n\nPadrão: left"

msgctxt "settings schema"
msgid "Where to render the blame information when enabled.\n\nDefault: inline"
msgstr "Onde renderizar as informações do blame quando habilitado.\n\nPadrão: inline"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations\n(Go to Definition, Go to Implementation, Find All References). A single\nresult always opens directly. Individual actions can override this with\ntheir `open_results_in` argument.\n\nDefault: multi_buffer"
msgstr "Onde mostrar os resultados do LSP que podem conter vários locais (Ir para definição, Ir para implementação, Localizar todas as referências). Um único resultado sempre abre diretamente. Cada ação pode substituir isto com o argumento `open_results_in`.\n\nPadrão: multi_buffer"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations."
msgstr "Onde exibir os resultados do LSP que podem conter vários locais."

msgctxt "settings schema"
msgid "Where to show a popup notification when the agent is waiting for user input.\n\nDefault: \"primary_screen\""
msgstr "Onde mostrar uma notificação pop-up quando o agente estiver aguardando entrada do usuário.\n\nPadrão: \"primary_screen\""

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: [`DisplayIn::ActiveEditor`]"
msgstr "Onde mostrar o minimapa no editor.\n\nPadrão: [`DisplayIn::ActiveEditor`]"

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: all_editors"
msgstr "Onde mostrar o minimapa no editor.\n\nPadrão: all_editors"

msgctxt "settings schema"
msgid "Whether \"Launch Claude Code\" always launches outside the sandbox, without\nasking. Outside, writes are not restricted, and network restrictions only\napply to programs that read the proxy settings (and not at all on SSH\nhosts). Can only be set in the user settings, not in a project's settings.\n\nDefault: false"
msgstr "Define se \"Iniciar o Claude Code\" sempre inicia fora do sandbox, sem perguntar. Fora dele, as gravações não são restringidas, e as restrições de rede só se aplicam a programas que leem as configurações de proxy (e não se aplicam em hosts SSH). Só pode ser definido nas configurações do usuário, não nas configurações de um projeto.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether AI agents (the built-in agent and MCP clients) may drive the\nbuilt-in browser's AI tabs, for debugging web apps.\n\nAI tabs use their own browser profile and always go through the egress\nallowlist proxy, whatever `use_egress_proxy` says.\n\nDefault: false"
msgstr "Define se os agentes de IA (o agente integrado e os clientes MCP) podem controlar as abas de IA do navegador integrado, para depurar aplicativos web.\n\nAs abas de IA usam o próprio perfil de navegador e sempre passam pelo proxy da lista de permissões de comunicação externa, independentemente do que `use_egress_proxy` diga.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether Anthropic's fast mode is available for this model."
msgstr "Define se o modo rápido da Anthropic está disponível para este modelo."

msgctxt "settings schema"
msgid "Whether SSH terminals keep their shell running on the remote host\nacross disconnects, and for how long."
msgstr "Define se os terminais SSH mantêm o shell em execução no host remoto entre desconexões e por quanto tempo."

msgctxt "settings schema"
msgid "Whether a new agent thread starts with Git operations turned on: the\nagent gets the `git` tool, which runs git (with every hook turned off)\nafter each call is approved. The chat input's Git button turns it on\nor off for one thread.\n\nDefault: true"
msgstr "Define se uma nova conversa do agente começa com as operações do Git ativadas: o agente recebe a ferramenta `git`, que executa o git (com todos os hooks desativados) depois que cada chamada é aprovada. O botão Git da entrada do chat ativa ou desativa isso para uma conversa.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether a terminal opened over SSH runs its shell inside a session the\nremote server keeps alive, so that a dropped connection neither stops\nrunning commands nor loses the output: reconnecting shows everything\nagain and continues. Only for SSH hosts that are not Windows.\n\nDefault: true"
msgstr "Define se um terminal aberto via SSH executa o shell dentro de uma sessão que o servidor remoto mantém ativa, para que uma conexão perdida não pare os comandos em execução nem perca a saída: ao reconectar, tudo é mostrado novamente e continua. Somente para hosts SSH que não são Windows.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether a worktree an agent wrote into stops running its own code\n(project language server modes, formatters, the project's prettier)\nuntil the user reviews the changes and resumes it. Read from the user\nsettings file only: project and server settings cannot turn it off.\n\nDefault: true"
msgstr "Define se uma árvore de trabalho na qual um agente gravou deixa de executar o próprio código (modos de servidor de linguagem do projeto, formatadores, o prettier do projeto) até que o usuário revise as alterações e a retome. Lido somente do arquivo de configurações do usuário: as configurações do projeto e do servidor não podem desativá-lo.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether agents connected over the IDE server may read the output of the\nlast task that failed in this window (the `getLastTaskOutput` tool, at\nmost the last 4 KB of the task's terminal).\n\nDefault: true"
msgstr "Define se os agentes conectados pelo servidor IDE podem ler a saída da última tarefa que falhou nesta janela (a ferramenta `getLastTaskOutput`, no máximo os últimos 4 KB do terminal da tarefa).\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether all context servers are enabled by default."
msgstr "Define se todos os servidores de contexto estão habilitados por padrão."

msgctxt "settings schema"
msgid "Whether and how to display code lenses from language servers.\n\nDefault: \"off\""
msgstr "Define se e como exibir os CodeLens dos servidores de linguagem.\n\nPadrão: \"off\""

msgctxt "settings schema"
msgid "Whether anything the agent features start may run outside the sandbox\nat all. While this is off, every new way out is refused without asking:\nagent terminal commands that cannot run in the sandbox (and\n`allow_unsandboxed`, which is then ignored), external agents and Claude\nCode started outside it (the one-time starts and the \"always outside\"\nsettings, which are then ignored), and threads resumed outside it. A\nconnection already running outside the sandbox keeps running, and MCP\nservers (context servers) are not covered. While it is on, each of\nthose asks or follows its own setting as before. Only the user settings\nfile is read: neither a project's settings nor an agent can turn it on.\nDefault: false"
msgstr "Define se algo que os recursos do agente iniciam pode ser executado fora do sandbox. Enquanto isto estiver desativado, toda nova saída é recusada sem perguntar: comandos de terminal do agente que não podem ser executados no sandbox (e `allow_unsandboxed`, que é então ignorado), agentes externos e o Claude Code iniciados fora dele (os inícios únicos e as configurações \"sempre fora\", que são então ignoradas) e conversas retomadas fora dele. Uma conexão que já está em execução fora do sandbox continua em execução, e os servidores MCP (servidores de contexto) não são abrangidos. Enquanto estiver ativado, cada um deles pergunta ou segue a própria configuração como antes. Apenas o arquivo de configurações do usuário é lido: nem as configurações de um projeto nem um agente podem ativá-lo.\nPadrão: false"

msgctxt "settings schema"
msgid "Whether clangd indexes the whole project in the background. `light`\nskips that index (`--background-index=false`), which saves the most\nmemory: references, call hierarchy and renames then only cover the\nfiles that are open. Ignored when `lsp.clangd.binary.arguments`\nalready has `--background-index`.\n\nDefault: full"
msgstr "Define se o clangd indexa o projeto inteiro em segundo plano. `light` ignora esse índice (`--background-index=false`), o que economiza o máximo de memória: as referências, a hierarquia de chamadas e as renomeações passam a cobrir apenas os arquivos abertos. Ignorado quando `lsp.clangd.binary.arguments` já tem `--background-index`.\n\nPadrão: full"

msgctxt "settings schema"
msgid "Whether clicking the stop button on a running terminal tool should also cancel the agent's generation.\nNote that this only applies to the stop button, not to ctrl+c inside the terminal.\n\nDefault: true"
msgstr "Define se clicar no botão de parar de uma ferramenta de terminal em execução também cancela a geração do agente.\nObserve que isso se aplica apenas ao botão de parar, não a ctrl+c dentro do terminal.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether cmd-click (ctrl-click on Linux and Windows) opens hyperlinks even\nwhen the terminal application has enabled mouse reporting (e.g. vim with\nmouse=a, htop). When false, these clicks are forwarded to the application\ninstead, and hyperlinks can still be opened with shift-cmd-click\n(shift-ctrl-click).\n\nDefault: true"
msgstr "Define se cmd-click (ctrl-click no Linux e no Windows) abre hiperlinks mesmo quando o aplicativo do terminal habilitou o relatório do mouse (ex.: vim com mouse=a, htop). Quando false, esses cliques são encaminhados ao aplicativo, e os hiperlinks ainda podem ser abertos com shift-cmd-click (shift-ctrl-click).\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether cursor movement animation is enabled.\n\nDefault: false"
msgstr "Define se a animação de movimento do cursor está habilitada.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether every new terminal starts recording its output automatically.\n\nDefault: false"
msgstr "Define se todo novo terminal começa a gravar a saída automaticamente.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether hovering a name in C and C++ also shows what its type holds\n(members, enumerators, a macro's definition), found by name in the\nindex.\n\nDefault: true"
msgstr "Define se passar o cursor sobre um nome em C e C++ também mostra o que o tipo dele contém (membros, enumeradores, a definição de uma macro), encontrado pelo nome no índice.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether indentation of pasted content should be adjusted based on the context.\n\nDefault: true"
msgstr "Define se o recuo do conteúdo colado deve ser ajustado com base no contexto.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether invoking a panel's `ToggleFocus` action while the panel is\nalready focused closes the panel, instead of just moving focus back\nto the editor. This only applies to a panel's focus-toggle action, not\nto its regular visibility-toggle action.\n\nDefault: false"
msgstr "Define se invocar a ação `ToggleFocus` de um painel enquanto ele já está em foco fecha o painel, em vez de apenas devolver o foco ao editor. Isso se aplica apenas à ação de alternar o foco de um painel, não à ação normal de alternar a visibilidade.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether newly opened file diffs show the full file instead of changes only.\n\nDefault: true"
msgstr "Define se os diffs de arquivo recém-abertos mostram o arquivo inteiro em vez de apenas as alterações.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether opening a folder in an existing window automatically opens the\nThreads Sidebar. Applies when `default_open_behavior` or\n`cli_default_open_behavior` is set to `existing_window`.\n\nDefault: true"
msgstr "Define se abrir uma pasta em uma janela existente abre automaticamente a barra lateral de conversas. Aplica-se quando `default_open_behavior` ou `cli_default_open_behavior` está definido como `existing_window`.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not selecting text in the terminal will automatically\ncopy to the system clipboard.\n\nDefault: false"
msgstr "Define se selecionar texto no terminal o copia automaticamente para a área de transferência do sistema.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether or not to automatically check for updates.\n\nDefault: false"
msgstr "Define se as atualizações são verificadas automaticamente.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer edits.\n\nSet to 0 to disable debouncing.\n\nDefault: 700"
msgstr "Define se é aplicado debounce às atualizações das dicas embutidas após edições no buffer.\n\nDefina como 0 para desabilitar o debounce.\n\nPadrão: 700"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer scrolls.\n\nSet to 0 to disable debouncing.\n\nDefault: 50"
msgstr "Define se é aplicado debounce às atualizações das dicas embutidas após rolagens no buffer.\n\nDefina como 0 para desabilitar o debounce.\n\nPadrão: 50"

msgctxt "settings schema"
msgid "Whether or not to enable Helix mode.\n\nDefault: false"
msgstr "Define se o modo Helix é habilitado.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether or not to enable Vim mode.\n\nDefault: false"
msgstr "Define se o modo Vim é habilitado.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether or not to ensure there's a single newline at the end of a buffer\nwhen saving it.\n\nDefault: true"
msgstr "Define se é garantido que haja uma única quebra de linha no fim de um buffer ao salvá-lo.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to include warning diagnostics.\n\nDefault: true"
msgstr "Define se os diagnósticos de aviso são incluídos.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to keep the tab bar buttons on panes that are not active.\nWhen disabled, only the focused pane shows them, so a split leaves the\nother panes without a new / split / zoom button.\n\nDefault: true"
msgstr "Define se os botões da barra de abas são mantidos nos subpainéis que não estão ativos.\nQuando desabilitado, apenas o subpainel em foco os mostra, então uma divisão deixa os outros subpainéis sem os botões de novo / dividir / zoom.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to perform a buffer format before saving.\n\nDefault: on"
msgstr "Define se o buffer é formatado antes de salvar.\n\nPadrão: on"

msgctxt "settings schema"
msgid "Whether or not to prompt the user to confirm before closing the application.\n\nDefault: false"
msgstr "Define se o usuário deve confirmar antes de fechar o aplicativo.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether or not to remove any trailing whitespace from lines of a buffer\nbefore saving it.\n\nDefault: true"
msgstr "Define se os espaços em branco no fim das linhas de um buffer são removidos antes de salvá-lo.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to restore unsaved buffers on restart.\n\nIf this is true, user won't be prompted whether to save/discard\ndirty files when closing the application.\n\nDefault: true"
msgstr "Define se os buffers não salvos são restaurados ao reiniciar.\n\nSe for true, o usuário não será perguntado se deseja salvar/descartar os arquivos modificados ao fechar o aplicativo.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: on"
msgstr "Define se os dados do git blame são mostrados embutidos na linha atualmente em foco.\n\nPadrão: on"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: true"
msgstr "Define se os dados do git blame são mostrados embutidos na linha atualmente em foco.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to show inline diagnostics\n\nDefault: false"
msgstr "Define se os diagnósticos embutidos são mostrados\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether or not to show pinned tabs in a separate row.\nWhen enabled, pinned tabs appear in a top row and unpinned tabs in a bottom row.\n\nDefault: false"
msgstr "Define se as abas fixadas são mostradas em uma linha separada.\nQuando habilitado, as abas fixadas aparecem em uma linha superior e as não fixadas em uma linha inferior.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether or not to show the call status icon in the status bar.\n\nDefault: true"
msgstr "Define se o ícone de status da chamada é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to show the git gutter.\n\nDefault: tracked_files"
msgstr "Define se a medianiz do Git é mostrada.\n\nPadrão: tracked_files"

msgctxt "settings schema"
msgid "Whether or not to show the navigation history buttons in the tab bar.\n\nDefault: true"
msgstr "Define se os botões do histórico de navegação são mostrados na barra de abas.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar buttons.\n\nDefault: true"
msgstr "Define se os botões da barra de abas são mostrados.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar in the editor.\n\nDefault: true"
msgstr "Define se a barra de abas é mostrada no editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether or not to skip worktree trust checks.\nWhen trusted, project settings are synchronized automatically,\nlanguage and MCP servers are downloaded and started automatically.\n\nDefault: false"
msgstr "Define se as verificações de confiança da árvore de trabalho são ignoradas.\nQuando confiável, as configurações do projeto são sincronizadas automaticamente, e os servidores de linguagem e MCP são baixados e iniciados automaticamente.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether other hints should be shown.\n\nDefault: true"
msgstr "Define se as outras dicas devem ser mostradas.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether parameter hints should be shown.\n\nDefault: true"
msgstr "Define se as dicas de parâmetros devem ser mostradas.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether pressing enter should first append two spaces to the current line,\nwhich is how Markdown spells a hard line break. Lines where the break would\nbe dropped (headings, tables, list items, code fences, blank lines, and lines\nthat already end in a break) are left alone.\n\nDefault: false"
msgstr "Define se pressionar Enter deve primeiro acrescentar dois espaços à linha atual, que é como o Markdown escreve uma quebra de linha forçada. As linhas em que a quebra seria descartada (títulos, tabelas, itens de lista, delimitadores de código, linhas em branco e linhas que já terminam com uma quebra) não são alteradas.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may always reach any host over the\nnetwork without prompting.\nDefault: false"
msgstr "Define se os comandos de terminal em sandbox sempre podem alcançar qualquer host pela rede sem perguntar.\nPadrão: false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may write anywhere on the\nfilesystem except protected paths. That is nearly the same as running\noutside the sandbox, so while this is on terminal commands are never\nauto-approved: each one asks first.\nDefault: false"
msgstr "Define se os comandos de terminal em sandbox podem gravar em qualquer lugar do sistema de arquivos, exceto nos caminhos protegidos. Isso é quase o mesmo que executar fora do sandbox, então, enquanto estiver ativado, os comandos de terminal nunca são aprovados automaticamente: cada um pergunta primeiro.\nPadrão: false"

msgctxt "settings schema"
msgid "Whether sticky scroll is enabled.\n\nDefault: false"
msgstr "Define se a rolagem fixa está habilitada.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the Agent is enabled.\n\nDefault: true"
msgstr "Define se o agente está habilitado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the Copilot Next Edit Suggestions feature is enabled.\n\nDefault: true"
msgstr "Define se o recurso Copilot Next Edit Suggestions está habilitado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the Jupyter feature is enabled.\n\nDefault: true"
msgstr "Define se o recurso Jupyter está habilitado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the agent panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Define se o painel do agente deve ser aberto na inicialização, mesmo que o dock dele tenha sido fechado da última vez.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the agent panel should use flexible (proportional) sizing when docked to the\nleft or right.\n\nWhen enabled, `default_width` does not control the panel width, and resetting the panel\nrestores the default proportion.\n\nDefault: true"
msgstr "Define se o painel do agente deve usar dimensionamento flexível (proporcional) quando posicionado à esquerda ou à direita.\n\nQuando habilitado, `default_width` não controla a largura do painel, e redefinir o painel restaura a proporção padrão.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the breakpoints should be reused across Zed sessions.\n\nDefault: true"
msgstr "Define se os pontos de interrupção devem ser reutilizados entre sessões do ForgeKairos.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the browser panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "Define se o painel do navegador deve ser aberto na inicialização, mesmo que o dock dele tenha sido fechado da última vez.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the built-in browser goes through the egress allowlist proxy.\n\nThe browser is human-driven, so like the terminal it is outside egress\ncontrol by default.\n\nDefault: false"
msgstr "Define se o navegador integrado passa pelo proxy da lista de permissões de comunicação externa.\n\nO navegador é operado por uma pessoa, então, como o terminal, fica fora do controle de comunicação externa por padrão.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the context server is enabled."
msgstr "Define se o servidor de contexto está habilitado."

msgctxt "settings schema"
msgid "Whether the cursor blinks in the editor.\n\nDefault: true"
msgstr "Define se o cursor pisca no editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the editor search results will loop\n\nDefault: true"
msgstr "Define se os resultados da pesquisa no editor recomeçam do início ao chegar ao fim\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the editor will scroll beyond the last line.\n\nDefault: one_page"
msgstr "Define se o editor rola além da última linha.\n\nPadrão: one_page"

msgctxt "settings schema"
msgid "Whether the focused panel follows the mouse location\nDefault: false"
msgstr "Define se o painel em foco acompanha a posição do mouse\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the folders of the macro picker start collapsed when it opens.\n\nDefault: false"
msgstr "Define se as pastas do seletor de macros começam recolhidas quando ele é aberto.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the git panel should open on startup.\n\nDefault: false"
msgstr "Define se o painel do Git deve ser aberto na inicialização.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the hover popover sticks when the mouse moves toward it,\nallowing interaction with its contents before it disappears.\n\nDefault: true"
msgstr "Define se o pop-up ao passar o cursor permanece quando o mouse se move em direção a ele, permitindo interagir com o conteúdo antes que ele desapareça.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the line numbers on editors gutter are relative or not.\nWhen \"enabled\" shows relative number of buffer lines, when \"wrapped\" shows\nrelative number of display lines.\n\nDefault: \"disabled\""
msgstr "Define se os números de linha na medianiz dos editores são relativos ou não.\nQuando \"enabled\", mostra o número relativo de linhas do buffer; quando \"wrapped\", mostra o número relativo de linhas exibidas.\n\nPadrão: \"disabled\""

msgctxt "settings schema"
msgid "Whether the microphone should be muted when joining a channel or a call.\n\nDefault: false"
msgstr "Define se o microfone deve ser silenciado ao entrar em um canal ou em uma chamada.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the model emits reasoning/thinking content."
msgstr "Define se o modelo emite conteúdo de raciocínio/pensamento."

msgctxt "settings schema"
msgid "Whether the model emits thinking (reasoning) content."
msgstr "Define se o modelo emite conteúdo de raciocínio."

msgctxt "settings schema"
msgid "Whether the model supports tools"
msgstr "Define se o modelo oferece suporte a ferramentas"

msgctxt "settings schema"
msgid "Whether the model supports tools."
msgstr "Define se o modelo oferece suporte a ferramentas."

msgctxt "settings schema"
msgid "Whether the model supports vision"
msgstr "Define se o modelo oferece suporte a visão"

msgctxt "settings schema"
msgid "Whether the model supports vision."
msgstr "Define se o modelo oferece suporte a visão."

msgctxt "settings schema"
msgid "Whether the panel follows the cursor, making the function under it the\nroot whenever the cursor moves. When off, the root changes only when\nasked for.\n\nDefault: false"
msgstr "Define se o painel segue o cursor, tornando a função sob ele a raiz sempre que o cursor se move. Quando desativado, a raiz só muda quando solicitado.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether the project panel should open on startup.\n\nDefault: true"
msgstr "Define se o painel do projeto deve ser aberto na inicialização.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the regex is case-sensitive.\nDefault: false (case-insensitive)"
msgstr "Define se a regex diferencia maiúsculas de minúsculas.\nPadrão: false (sem diferenciar maiúsculas e minúsculas)"

msgctxt "settings schema"
msgid "Whether the remote host should make its outgoing HTTP(S) requests —\nlanguage server and node downloads, extension archives, agent binaries\n— through this machine instead of its own network.\n\nThis is what makes a remote host that has no internet access able to\ninstall language servers at all, and it puts those downloads under this\nmachine's network allowlist, consent prompts and proxy. Turn it off to\nhave the remote host connect out on its own.\n\nDefault: true"
msgstr "Define se o host remoto deve fazer suas solicitações HTTP(S) de saída — downloads de servidores de linguagem e do node, arquivos de extensões, binários de agentes — por meio desta máquina, em vez da própria rede.\n\nÉ isso que permite que um host remoto sem acesso à internet consiga instalar servidores de linguagem, e coloca esses downloads sob a lista de permissões de rede, os diálogos de consentimento e o proxy desta máquina. Desative para que o host remoto se conecte por conta própria.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the terminal panel should open on startup.\n\nDefault: true"
msgstr "Define se o painel do terminal deve ser aberto na inicialização.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the terminal panel should use flexible (proportional) sizing.\n\nDefault: true"
msgstr "Define se o painel do terminal deve usar dimensionamento flexível (proporcional).\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the text selection should have rounded corners.\n\nDefault: true"
msgstr "Define se a seleção de texto deve ter cantos arredondados.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether the window-wide threads sidebar is available at all.\n\nDefault: false"
msgstr "Define se a barra lateral de conversas de toda a janela está disponível.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether this agent always launches outside the sandbox, without asking.\n\nOutside, writes are not restricted, and network restrictions only apply\nto programs that read the proxy settings. Can only be set in the user\nsettings, not in a project's settings (`.zed/settings.json`).\n\nDefault: false"
msgstr "Define se este agente sempre é iniciado fora do sandbox, sem perguntar.\n\nFora dele, as gravações não são restringidas, e as restrições de rede só se aplicam a programas que leem as configurações de proxy. Só pode ser definido nas configurações do usuário, não nas configurações de um projeto (`.zed/settings.json`).\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether this agent may offer signing in with a subscription (an\nauthentication method such as `/login`).\n\nWhen `false`, the agent's sign-in disappears from the authentication card\nand is refused when it is requested another way. Using an API key works\nregardless of this setting.\n\nDefault: true"
msgstr "Define se este agente pode oferecer login com uma assinatura (um método de autenticação como `/login`).\n\nQuando `false`, o login do agente desaparece do cartão de autenticação e é recusado quando solicitado de outra forma. O uso de uma chave de API funciona independentemente desta configuração.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether this custom Mantle model supports OpenAI reasoning effort parameters."
msgstr "Define se este modelo Mantle personalizado oferece suporte a parâmetros de profundidade de raciocínio da OpenAI."

msgctxt "settings schema"
msgid "Whether to align detail text in code completions context menus left or right.\n\nDefault: left"
msgstr "Define se o texto de detalhes nos menus de contexto de preenchimento automático de código é alinhado à esquerda ou à direita.\n\nPadrão: left"

msgctxt "settings schema"
msgid "Whether to allow drag and drop text selection in buffer."
msgstr "Define se é permitida a seleção de texto por arrastar e soltar no buffer."

msgctxt "settings schema"
msgid "Whether to allow horizontal scrolling in the project panel.\nWhen false, the view is locked to the leftmost position and\nlong file names are clipped.\n\nDefault: true"
msgstr "Define se a rolagem horizontal é permitida no painel do projeto.\nQuando false, a exibição fica travada na posição mais à esquerda e os nomes de arquivo longos são cortados.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to allow windows to tab together based on the user's tabbing preference (macOS only).\n\nDefault: false"
msgstr "Define se as janelas podem ser agrupadas em abas com base na preferência de abas do usuário (somente macOS).\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to always show the close button on tabs.\n\nDefault: false"
msgstr "Define se o botão de fechar é sempre mostrado nas abas.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to always use cmd-enter (or ctrl-enter on Linux or Windows) to send messages in the agent panel.\n\nDefault: false"
msgstr "Define se cmd-enter (ou ctrl-enter no Linux ou no Windows) é sempre usado para enviar mensagens no painel do agente.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to attempt to restore previous file's state when opening it again.\nThe state is stored per pane.\nWhen disabled, defaults are applied instead of the state restoration.\n\nE.g. for editors, selections, folds and scroll positions are restored, if the same file is closed and, later, opened again in the same pane.\nWhen disabled, a single selection in the very beginning of the file, zero scroll position and no folds state is used as a default.\n\nDefault: true"
msgstr "Define se é feita uma tentativa de restaurar o estado anterior de um arquivo ao abri-lo novamente.\nO estado é armazenado por subpainel.\nQuando desabilitado, os padrões são aplicados em vez da restauração do estado.\n\nEx.: para editores, as seleções, as dobras e as posições de rolagem são restauradas se o mesmo arquivo for fechado e, depois, aberto novamente no mesmo subpainel.\nQuando desabilitado, uma única seleção no início do arquivo, posição de rolagem zero e nenhuma dobra são usadas como padrão.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to automatically attach the active editor to every message that\nis sent: the selected lines when there is a selection, otherwise the\nwhole file. A file that is already mentioned by hand is not attached\ntwice.\n\nDefault: false"
msgstr "Define se o editor ativo é anexado automaticamente a cada mensagem enviada: as linhas selecionadas quando há uma seleção; caso contrário, o arquivo inteiro. Um arquivo já mencionado manualmente não é anexado duas vezes.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to automatically close JSX tags."
msgstr "Define se as tags JSX devem ser fechadas automaticamente."

msgctxt "settings schema"
msgid "Whether to automatically close files that have been deleted on disk.\n\nDefault: false"
msgstr "Define se os arquivos excluídos do disco são fechados automaticamente.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to automatically compact the agent's context when it grows too\nlarge, summarizing earlier messages to free up room in the model's\ncontext window.\n\nDefault: true"
msgstr "Define se o contexto do agente é compactado automaticamente quando fica grande demais, resumindo as mensagens anteriores para liberar espaço na janela de contexto do modelo.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to automatically detect the language of an untitled buffer from its contents.\nLanguages explicitly selected from the language selector are not changed.\n\nDefault: true"
msgstr "Define se a linguagem de um buffer sem título é detectada automaticamente a partir do conteúdo.\nAs linguagens selecionadas explicitamente no seletor de linguagem não são alteradas.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to automatically discover models served by the llama.cpp server.\nDefaults to true."
msgstr "Define se os modelos servidos pelo servidor llama.cpp são descobertos automaticamente.\nO padrão é true."

msgctxt "settings schema"
msgid "Whether to automatically open Markdown files in the preview.\n\nDefault: false"
msgstr "Define se os arquivos Markdown são abertos automaticamente na visualização.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to automatically open files after pasting or duplicating them.\n\nDefault: true"
msgstr "Define se os arquivos são abertos automaticamente depois de colados ou duplicados.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to automatically open files dropped from external sources.\n\nDefault: true"
msgstr "Define se os arquivos soltos a partir de fontes externas são abertos automaticamente.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to automatically open newly created files in the editor.\n\nDefault: true"
msgstr "Define se os arquivos recém-criados são abertos automaticamente no editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to automatically show a signature help pop-up or not.\n\nDefault: false"
msgstr "Define se um pop-up de ajuda de assinatura é mostrado automaticamente.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to automatically surround text with characters for you. For example,\nwhen you select text and type '(', Zed will automatically surround text with ().\n\nDefault: true"
msgstr "Define se o texto é envolvido automaticamente com caracteres. Por exemplo, quando você seleciona um texto e digita '(', o ForgeKairos envolve automaticamente o texto com ().\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to automatically type closing characters for you. For example,\nwhen you type '(', Zed will automatically add a closing ')' at the correct position.\n\nDefault: true"
msgstr "Define se os caracteres de fechamento são digitados automaticamente. Por exemplo, quando você digita '(', o ForgeKairos adiciona automaticamente um ')' de fechamento na posição correta.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to build dev container images with BuildKit.\n\nWhen unset, Zed auto-detects BuildKit by probing for the `buildx` CLI\nplugin. Set to `false` to force the classic Docker builder, which is\nrequired for Docker-compatible engines that lack an integrated BuildKit\n(e.g. Apple Container via a Docker-API bridge), where BuildKit builds\ncannot resolve locally-built images.\n\nDefault: null (auto-detect)"
msgstr "Define se as imagens de Dev Container são compiladas com o BuildKit.\n\nQuando não definido, o ForgeKairos detecta automaticamente o BuildKit procurando o plug-in de CLI `buildx`. Defina como `false` para forçar o builder clássico do Docker, que é necessário para engines compatíveis com Docker sem BuildKit integrado (ex.: Apple Container por meio de uma ponte para a API do Docker), em que as compilações do BuildKit não conseguem resolver imagens compiladas localmente.\n\nPadrão: null (auto-detect)"

msgctxt "settings schema"
msgid "Whether to center the cursor on each search match when navigating."
msgstr "Define se o cursor deve ser centralizado em cada correspondência de pesquisa ao navegar."

msgctxt "settings schema"
msgid "Whether to close the window when using 'close active item' on a workspace with no tabs\n\nDefault: auto (\"on\" on macOS, \"off\" otherwise)"
msgstr "Define se a janela é fechada ao usar 'fechar item ativo' em um espaço de trabalho sem abas\n\nPadrão: auto (\"on\" no macOS, \"off\" nos demais)"

msgctxt "settings schema"
msgid "Whether to collapse untracked files in the diff panel.\n\nDefault: false"
msgstr "Define se os arquivos não rastreados são recolhidos no painel de diff.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to collect timing data for foreground and background executor\ntasks. Enabling this may lead to increased memory usage, hence it's\ndisabled by default for regular builds.\n\nDefault: false"
msgstr "Define se os dados de tempo das tarefas dos executores em primeiro e segundo plano são coletados. Habilitar isto pode aumentar o uso de memória; por isso, fica desabilitado por padrão nas compilações normais.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to continue markdown lists when pressing enter.\n\nDefault: true"
msgstr "Define se as listas Markdown continuam ao pressionar Enter.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to disable all AI features in Zed.\n\nDefault: false"
msgstr "Define se todos os recursos de IA do ForgeKairos são desabilitados.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to display Agent review buttons in the editor toolbar.\nOnly applicable while reviewing a file edited by the Agent.\n\nDefault: true"
msgstr "Define se os botões de revisão do agente são exibidos na barra de ferramentas do editor.\nAplica-se somente durante a revisão de um arquivo editado pelo agente.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to display agent edits in single-file editors in addition to the review multibuffer pane.\n\nDefault: false"
msgstr "Define se as edições do agente são exibidas em editores de arquivo único, além do subpainel de multibuffer de revisão.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to display breadcrumbs in the editor toolbar.\n\nDefault: true"
msgstr "Define se as trilhas de navegação são exibidas na barra de ferramentas do editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to display code action buttons in the editor toolbar.\n\nDefault: false"
msgstr "Define se os botões de ações de código são exibidos na barra de ferramentas do editor.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to display code lenses from language servers above code elements."
msgstr "Define se os CodeLens dos servidores de linguagem devem ser exibidas acima dos elementos de código."

msgctxt "settings schema"
msgid "Whether to display indent guides in the editor.\n\nDefault: true"
msgstr "Define se as guias de recuo são exibidas no editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to display inline and alongside documentation for items in the\ncompletions menu.\n\nDefault: true"
msgstr "Define se a documentação dos itens do menu de preenchimento automático é exibida embutida e ao lado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to display quick action buttons in the editor toolbar.\n\nDefault: true"
msgstr "Define se os botões de ações rápidas são exibidos na barra de ferramentas do editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to display the Markdown formatting row below the editor toolbar\nwhile a Markdown file is open.\n\nDefault: true"
msgstr "Define se a linha de formatação do Markdown é exibida abaixo da barra de ferramentas do editor enquanto um arquivo Markdown está aberto.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to display the active language button in the status bar.\n\nDefault: true"
msgstr "Define se o botão da linguagem ativa é exibido na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to display the terminal title in breadcrumbs inside the terminal pane.\nOnly shown if the terminal title is not empty.\n\nThe shell running in the terminal needs to be configured to emit the title.\nExample: `echo -e \"\\e]2;New Title\\007\";`\n\nDefault: true"
msgstr "Define se o título do terminal é exibido nas trilhas de navegação dentro do subpainel do terminal.\nSó é mostrado se o título do terminal não estiver vazio.\n\nO shell em execução no terminal precisa estar configurado para emitir o título.\nExemplo: `echo -e \"\\e]2;New Title\\007\";`\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to enable drag-and-drop operations in the project panel.\n\nDefault: true"
msgstr "Define se as operações de arrastar e soltar são habilitadas no painel do projeto.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to enable middle-click paste on Linux\n\nDefault: true"
msgstr "Define se colar com o clique do botão do meio é habilitado no Linux\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to enable think mode"
msgstr "Define se o modo de raciocínio deve ser habilitado"

msgctxt "settings schema"
msgid "Whether to enable word diff highlighting in the editor.\n\nWhen enabled, changed words within modified lines are highlighted\nto show exactly what changed.\n\nDefault: true"
msgstr "Define se o destaque de diff por palavra é habilitado no editor.\n\nQuando habilitado, as palavras alteradas dentro das linhas modificadas são destacadas para mostrar exatamente o que mudou.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to expose this window over the loopback IDE server, so that\nexternal agents such as the Claude Code CLI can read the open editors,\nthe selection and the diagnostics, and show diffs inside Zed.\n\nDefault: false"
msgstr "Define se esta janela é exposta pelo servidor IDE de loopback, para que agentes externos, como o Claude Code CLI, possam ler os editores abertos, a seleção e os diagnósticos e mostrar diffs dentro do ForgeKairos.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to fetch LSP completions or not.\n\nDefault: true"
msgstr "Define se os preenchimentos automáticos do LSP são obtidos.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to filter ANSI/VT escape sequences so the log reads as plain\ntext, the way TeraTerm's text log does.\n\nDefault: true"
msgstr "Define se as sequências de escape ANSI/VT são filtradas para que o log seja lido como texto simples, como faz o log de texto do TeraTerm.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to fold directories automatically\nwhen directory has only one directory inside.\n\nDefault: true"
msgstr "Define se os diretórios são agrupados automaticamente quando contêm apenas um diretório.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to follow-up empty go to definition responses from the language server or not.\n`FindAllReferences` allows to look up references of the same symbol instead.\n`None` disables the fallback.\n\nDefault: FindAllReferences"
msgstr "Define se as respostas vazias de \"Ir para definição\" do servidor de linguagem recebem tratamento adicional.\n`FindAllReferences` permite procurar as referências do mesmo símbolo.\n`None` desabilita a alternativa.\n\nPadrão: FindAllReferences"

msgctxt "settings schema"
msgid "Whether to format dap messages in when adding them to debug adapter logger\n\nDefault: true"
msgstr "Define se as mensagens DAP são formatadas ao serem adicionadas ao registrador do adaptador de depuração\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to give agents Zed's IDE tools (the `zed` MCP server: highlights,\nannotations, code tours, hover, definitions, references and symbol\nsearch), in the Claude Code CLI tabs and in external agents' sessions\nalike. Independent of `enabled`: the server starts for them on demand\nand writes no lock file unless `enabled` is on.\n\nDefault: true"
msgstr "Define se os agentes recebem as ferramentas de IDE do ForgeKairos (o servidor MCP `zed`: destaques, anotações, tours de código, informações ao passar o cursor, definições, referências e pesquisa de símbolos), tanto nas abas do Claude Code CLI quanto nas sessões de agentes externos. Independente de `enabled`: o servidor é iniciado para eles sob demanda e não grava arquivo de bloqueio, a menos que `enabled` esteja ativado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to have edit cards in the agent panel expanded, showing a preview of the full diff.\n\nDefault: true"
msgstr "Define se os cartões de edição no painel do agente ficam expandidos, mostrando uma visualização do diff completo.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to have terminal cards in the agent panel expanded, showing the whole command output.\n\nDefault: true"
msgstr "Define se os cartões de terminal no painel do agente ficam expandidos, mostrando toda a saída do comando.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to hide gitignore files in the project panel.\n\nDefault: false"
msgstr "Define se os arquivos ignorados pelo gitignore são ocultados no painel do projeto.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to hide symbols, excerpts and search matches in the outline panel\nwhen a multi-buffer view (e.g. a diff or search results) is active,\nshowing only files and directories.\nDoes not affect single-file views.\n\nDefault: false"
msgstr "Define se os símbolos, trechos e correspondências de pesquisa são ocultados no painel de estrutura quando uma exibição de multibuffer (ex.: um diff ou resultados de pesquisa) está ativa, mostrando somente arquivos e diretórios.\nNão afeta as exibições de arquivo único.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to hide the hidden entries in the project panel.\n\nDefault: false"
msgstr "Define se as entradas ocultas são ocultadas no painel do projeto.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to hide the root entry when only one folder is open in the window.\n\nDefault: false"
msgstr "Define se a entrada raiz é ocultada quando apenas uma pasta está aberta na janela.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to highlight all occurrences of the selected text in an editor.\n\nDefault: true"
msgstr "Define se todas as ocorrências do texto selecionado são destacadas em um editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to include gitignored files in search results."
msgstr "Define se os arquivos ignorados pelo gitignore devem ser incluídos nos resultados da pesquisa."

msgctxt "settings schema"
msgid "Whether to include project rules files (AGENTS.md, CLAUDE.md, .rules, etc.)\nin the prompt when generating git commit messages.\n\nDefault: true"
msgstr "Define se os arquivos de regras do projeto (AGENTS.md, CLAUDE.md, .rules etc.) são incluídos no prompt ao gerar mensagens de commit do Git.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to include text channels in file finder results.\n\nDefault: false"
msgstr "Define se os canais de texto são incluídos nos resultados do localizador de arquivos.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to indent lines using tab characters, as opposed to multiple\nspaces.\n\nDefault: false"
msgstr "Define se as linhas são recuadas com caracteres de tabulação em vez de vários espaços.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to indent list items when pressing tab after a list marker.\n\nDefault: true"
msgstr "Define se os itens de lista são recuados ao pressionar Tab depois de um marcador de lista.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to index files that `.gitignore` excludes (only the ones the\nproject panel has loaded: ignored folders are read when expanded).\n\nDefault: false"
msgstr "Define se os arquivos que o `.gitignore` exclui são indexados (somente os que o painel do projeto carregou: as pastas ignoradas são lidas quando expandidas).\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to interpret the search query as a regular expression."
msgstr "Define se a consulta de pesquisa deve ser interpretada como uma expressão regular."

msgctxt "settings schema"
msgid "Whether to keep tabs in preview mode when code navigation is used to navigate away from them.\nIf `enable_preview_file_from_code_navigation` or `enable_preview_multibuffer_from_code_navigation` is also true, the new tab may replace the existing one.\n\nDefault: false"
msgstr "Define se as abas permanecem no modo de visualização quando a navegação de código é usada para sair delas.\nSe `enable_preview_file_from_code_navigation` ou `enable_preview_multibuffer_from_code_navigation` também for true, a nova aba pode substituir a existente.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to keep the system awake while agent threads are running.\n\nDefault: true"
msgstr "Define se o sistema é mantido ativo enquanto as conversas do agente estão em execução.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to keep the text selection after copying it to the clipboard.\n\nDefault: true"
msgstr "Define se a seleção de texto é mantida depois de copiá-la para a área de transferência.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to limit the content width in the agent panel. When enabled,\ncontent will be constrained to `max_content_width` and centered when\nthe panel is wider than that value, for optimal readability.\n\nDefault: true"
msgstr "Define se a largura do conteúdo no painel do agente é limitada. Quando habilitado, o conteúdo é restringido a `max_content_width` e centralizado quando o painel é mais largo que esse valor, para melhor legibilidade.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to limit the width of the rendered markdown content. When\nenabled, content is constrained to `max_width` and centered\nhorizontally within the preview pane, for optimal readability.\n\nDefault: false"
msgstr "Define se a largura do conteúdo Markdown renderizado é limitada. Quando habilitado, o conteúdo é restringido a `max_width` e centralizado horizontalmente no subpainel de visualização, para melhor legibilidade.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to log messages between active debug adapters and Zed\n\nDefault: true"
msgstr "Define se as mensagens entre os adaptadores de depuração ativos e o ForgeKairos são registradas em log\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to match case sensitively."
msgstr "Define se a correspondência deve diferenciar maiúsculas de minúsculas."

msgctxt "settings schema"
msgid "Whether to only match on whole words."
msgstr "Define se a correspondência deve ocorrer apenas em palavras inteiras."

msgctxt "settings schema"
msgid "Whether to only show the inline blame information\nafter a delay once the cursor stops moving.\n\nDefault: 0"
msgstr "Define se as informações do blame embutido só são mostradas após um atraso depois que o cursor para de se mover.\n\nPadrão: 0"

msgctxt "settings schema"
msgid "Whether to only show the inline diagnostics after a delay after the\nlast editor event.\n\nDefault: 150"
msgstr "Define se os diagnósticos embutidos só são mostrados após um atraso depois do último evento do editor.\n\nPadrão: 150"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a multibuffer.\n\nDefault: false"
msgstr "Define se as abas são abertas no modo de visualização quando a navegação de código é usada para abrir um multibuffer.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a single file.\n\nDefault: true"
msgstr "Define se as abas são abertas no modo de visualização quando a navegação de código é usada para abrir um único arquivo.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from a multibuffer.\n\nDefault: true"
msgstr "Define se as abas são abertas no modo de visualização quando abertas a partir de um multibuffer.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from the project panel\nwith a single click or the `project_panel::Open` action.\n\nDefault: true"
msgstr "Define se as abas são abertas no modo de visualização quando abertas a partir do painel do projeto com um único clique ou com a ação `project_panel::Open`.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when selected from the file finder.\n\nDefault: false"
msgstr "Define se as abas são abertas no modo de visualização quando selecionadas no localizador de arquivos.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to open tabular files such as CSV and TSV as a table (grid). When\noff, they open in the text editor.\n\nDefault: true"
msgstr "Define se os arquivos tabulares, como CSV e TSV, são abertos como tabela (grade). Quando desativado, eles são abertos no editor de texto.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to optimize Zed's interface for assistive technology such as\nscreen readers.\n\nDefault: false"
msgstr "Define se a interface do ForgeKairos é otimizada para tecnologias assistivas, como leitores de tela.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to perform linked edits of associated ranges, if the language server supports it.\nFor example, when editing opening <html> tag, the contents of the closing </html> tag will be edited as well.\n\nDefault: true"
msgstr "Define se são feitas edições vinculadas de intervalos associados, se o servidor de linguagem oferecer suporte.\nPor exemplo, ao editar a tag de abertura <html>, o conteúdo da tag de fechamento </html> também é editado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to point out missing development tools in a notification and offer\nto install them from it. While connected to a remote host, the host is\nchecked and the tools are installed there.\n\nDefault: true"
msgstr "Define se as ferramentas de desenvolvimento ausentes são indicadas em uma notificação, com a opção de instalá-las a partir dela. Enquanto conectado a um host remoto, o host é verificado e as ferramentas são instaladas nele.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to pop the completions menu while typing in an editor without\nexplicitly requesting it.\n\nDefault: true"
msgstr "Define se o menu de preenchimentos automáticos é exibido durante a digitação no editor sem que seja solicitado explicitamente.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to prefix each logged line with `[YYYY-MM-DD HH:MM:SS] `.\n\nDefault: false"
msgstr "Define se cada linha registrada recebe o prefixo `[YYYY-MM-DD HH:MM:SS] `.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to prevent this project from being shared in public channels.\n\nDefault: false"
msgstr "Define se este projeto não pode ser compartilhado em canais públicos.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to pull for diagnostics or not.\n\nDefault: true"
msgstr "Define se os diagnósticos são obtidos por pull.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to query and display LSP `textDocument/documentLink` links in the editor.\n\nDefault: true"
msgstr "Define se os links `textDocument/documentLink` do LSP são consultados e exibidos no editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to reduce non-essential motion in the UI, such as loading\nspinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "Define se os movimentos não essenciais da interface, como indicadores giratórios de carregamento e rótulos pulsantes, são reduzidos, renderizando-os em estado estático.\n\nPadrão: off"

msgctxt "settings schema"
msgid "Whether to resize all the panels in a dock when resizing the dock.\n\nDefault: [\"left\"]"
msgstr "Define se todos os painéis de um dock são redimensionados ao redimensionar o dock.\n\nPadrão: [\"left\"]"

msgctxt "settings schema"
msgid "Whether to reveal an already open file in an existing pane instead of opening it in the active pane.\n\nDefault: false"
msgstr "Define se um arquivo já aberto é mostrado no subpainel existente em vez de ser aberto no subpainel ativo.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to reveal it in the outline panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Define se a entrada é mostrada automaticamente no painel de estrutura quando a entrada correspondente do projeto se torna ativa. Entradas ignoradas pelo Git nunca são mostradas automaticamente.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to reveal it in the project panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "Define se a entrada é mostrada automaticamente no painel do projeto quando a entrada correspondente do projeto se torna ativa. Entradas ignoradas pelo Git nunca são mostradas automaticamente.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to run agent terminal commands outside the OS sandbox, with\nZed's own permissions (the inverse of the settings UI's \"enable sandbox\"\nswitch). When true, the sandboxed terminal tool is not exposed and the\nsystem prompt omits the sandbox section, so the model uses the plain\n`terminal` tool; on Windows, WSL sandbox setup is skipped. Such commands\nare never auto-approved: each one asks first. Only the user sets this;\nthe agent has no way to ask for a command to run outside the sandbox.\nDefault: false"
msgstr "Define se os comandos de terminal do agente são executados fora do sandbox do sistema operacional, com as permissões do próprio ForgeKairos (o inverso da opção \"habilitar sandbox\" da interface de configurações). Quando true, a ferramenta de terminal em sandbox não é oferecida e o prompt do sistema omite a seção do sandbox, de modo que o modelo usa a ferramenta `terminal` comum; no Windows, a preparação do sandbox do WSL é ignorada. Esses comandos nunca são aprovados automaticamente: cada um pede confirmação antes. Somente o usuário define isto; o agente não tem como pedir que um comando seja executado fora do sandbox.\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to run the context server on the remote server when using remote development.\n\nIf this is false, the context server will always run on the local machine.\n\nDefault: false"
msgstr "Define se o servidor de contexto é executado no servidor remoto ao usar o desenvolvimento remoto.\n\nSe for false, o servidor de contexto sempre será executado na máquina local.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to scroll when clicking near the edge of the visible text area.\n\nDefault: false"
msgstr "Define se a rolagem ocorre ao clicar perto da borda da área de texto visível.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to send explicit `cache_control` breakpoints for prompt caching.\nLeave disabled if the provider rejects requests containing them."
msgstr "Define se pontos de interrupção `cache_control` explícitos são enviados para o cache de prompts. Deixe desabilitado se o provedor rejeitar solicitações que os contenham."

msgctxt "settings schema"
msgid "Whether to show OpenCode Go models. Defaults to true."
msgstr "Define se os modelos OpenCode Go devem ser exibidos. O padrão é true."

msgctxt "settings schema"
msgid "Whether to show OpenCode Zen models. Defaults to true."
msgstr "Define se os modelos OpenCode Zen devem ser exibidos. O padrão é true."

msgctxt "settings schema"
msgid "Whether to show a background for inlay hints.\n\nIf set to `true`, the background will use the `hint.background` color\nfrom the current theme.\n\nDefault: false"
msgstr "Define se um plano de fundo é mostrado nas dicas embutidas.\n\nSe definido como `true`, o plano de fundo usará a cor `hint.background` do tema atual.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show a badge on the git panel icon with the count of uncommitted changes.\n\nDefault: false"
msgstr "Define se um contador com o número de alterações sem commit é mostrado no ícone do painel do Git.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show a badge on the terminal panel icon with the count of open terminals.\n\nDefault: false"
msgstr "Define se um contador com o número de terminais abertos é mostrado no ícone do painel do terminal.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show a git status indicator next to file names in the project panel.\n\nDefault: false"
msgstr "Define se um indicador de status do Git é mostrado ao lado dos nomes de arquivo no painel do projeto.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show a single line break as a line break. When off, it is one\nspace as CommonMark specifies, and only two trailing spaces, `\\` or `<br>`\nbreak the line. Exporting to PDF follows the same setting.\n\nDefault: true"
msgstr "Define se uma única quebra de linha é exibida como quebra de linha. Quando desativado, ela vira um espaço, como especifica o CommonMark, e só dois espaços no fim da linha, `\\` ou `<br>` quebram a linha. A exportação para PDF segue a mesma configuração.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show active line endings button in the status bar.\n\nDefault: false"
msgstr "Define se o botão da terminação de linha ativa é mostrado na barra de status.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show an indicator while multi-stroke input is pending.\nIf the input has a timeout, a countdown is shown and hovering the indicator pauses it.\nIts binding preview popover is disabled when the which-key popup is enabled.\n\nDefault: true"
msgstr "Define se um indicador é mostrado enquanto uma entrada de várias teclas está pendente. Se a entrada tiver tempo limite, uma contagem regressiva é mostrada, e passar o cursor sobre o indicador a pausa. O pop-up de visualização das associações de teclas do indicador fica desabilitado quando o pop-up which-key está habilitado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show author name as part of the commit information.\n\nDefault: false"
msgstr "Define se o nome do autor é mostrado como parte das informações do commit.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show bookmarks in the gutter.\n\nDefault: true"
msgstr "Define se os marcadores são mostrados na medianiz.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show breakpoints in the gutter.\n\nDefault: true"
msgstr "Define se os pontos de interrupção são mostrados na medianiz.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show buffer search result indicators in the scrollbar.\n\nDefault: true"
msgstr "Define se os indicadores de resultados da pesquisa no buffer são mostrados na barra de rolagem.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show cells that contain line breaks in full, making the row\ntaller. When off, they are cut to one line.\n\nDefault: true"
msgstr "Define se as células que contêm quebras de linha são mostradas por inteiro, aumentando a altura da linha. Quando desativado, elas são cortadas em uma linha.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show code action button at start of buffer line.\n\nDefault: true"
msgstr "Define se o botão de ação de código é mostrado no início da linha do buffer.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show commit summary as part of the inline blame.\n\nDefault: false"
msgstr "Define se o resumo do commit é mostrado como parte do blame embutido.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show cursor positions in the scrollbar.\n\nDefault: true"
msgstr "Define se as posições do cursor são mostradas na barra de rolagem.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show entries with tree or flat view in the panel\n\nDefault: false"
msgstr "Define se as entradas são mostradas no painel em modo de árvore ou de lista plana\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show error and warning count badges next to file names in the project panel.\n\nDefault: false"
msgstr "Define se contadores de erros e avisos são mostrados ao lado dos nomes de arquivo no painel do projeto.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show file icons in the file finder.\n\nDefault: true"
msgstr "Define se os ícones de arquivo são mostrados no localizador de arquivos.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show file icons in the git panel.\n\nDefault: false"
msgstr "Define se os ícones de arquivo são mostrados no painel do Git.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show file icons in the outline panel.\n\nDefault: true"
msgstr "Define se os ícones de arquivo são mostrados no painel de estrutura.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show file icons in the project panel.\n\nDefault: true"
msgstr "Define se os ícones de arquivo são mostrados no painel do projeto.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show fold buttons in the gutter.\n\nDefault: true"
msgstr "Define se os botões de dobra são mostrados na medianiz.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show folder names with bold text in the project panel.\n\nDefault: false"
msgstr "Define se os nomes de pasta são mostrados em negrito no painel do projeto.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show git diff indicators in the scrollbar.\n\nDefault: true"
msgstr "Define se os indicadores de diff do Git são mostrados na barra de rolagem.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show git status indicators on the branch icon in the title bar.\nWhen enabled, the branch icon changes to reflect the current repository\nstatus (e.g. modified, added, deleted, or conflict).\n\nDefault: false"
msgstr "Define se indicadores de status do Git são mostrados no ícone do branch na barra de título. Quando habilitado, o ícone do branch muda para refletir o status atual do repositório (ex.: modificado, adicionado, excluído ou em conflito).\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show line numbers in the gutter.\n\nDefault: true"
msgstr "Define se os números de linha são mostrados na medianiz.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show onboarding banners in the title bar.\n\nDefault: true"
msgstr "Define se os banners de introdução são mostrados na barra de título.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show opened editors as preview tabs.\nPreview tabs do not stay open, are reused until explicitly set to be kept open opened (via double-click or editing) and show file names in italic.\n\nDefault: true"
msgstr "Define se os editores abertos são mostrados como abas de visualização. As abas de visualização não permanecem abertas, são reutilizadas até serem explicitamente mantidas abertas (com clique duplo ou edição) e mostram os nomes de arquivo em itálico.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show padding for zoomed panels.\nWhen enabled, zoomed bottom panels will have some top padding,\nwhile zoomed left/right panels will have padding to the right/left (respectively).\n\nDefault: true"
msgstr "Define se o espaçamento é mostrado nos painéis ampliados. Quando habilitado, os painéis inferiores ampliados terão algum espaçamento superior, enquanto os painéis esquerdo/direito ampliados terão espaçamento à direita/esquerda (respectivamente).\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show runnable buttons in the gutter.\n\nDefault: true"
msgstr "Define se os botões de execução são mostrados na medianiz.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show selected symbol occurrences in the scrollbar.\n\nDefault: true"
msgstr "Define se as ocorrências do símbolo selecionado são mostradas na barra de rolagem.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show selected text occurrences in the scrollbar.\n\nDefault: true"
msgstr "Define se as ocorrências do texto selecionado são mostradas na barra de rolagem.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show small single-line outputs inline instead of in a block.\n\nDefault: true"
msgstr "Define se saídas pequenas de uma única linha são mostradas embutidas em vez de em um bloco.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show tabs and spaces in the editor."
msgstr "Define se tabulações e espaços devem ser exibidos no editor."

msgctxt "settings schema"
msgid "Whether to show the AI browser panel button in the status bar while AI\ncontrol of the built-in browser is on.\n\nDefault: true"
msgstr "Define se o botão do painel do navegador de IA é mostrado na barra de status enquanto o controle do navegador integrado pela IA estiver ativado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the Git file status on a tab item.\n\nDefault: false"
msgstr "Define se o status do arquivo no Git é mostrado em uma aba.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show the LSP servers button in the status bar.\n\nDefault: `true`"
msgstr "Define se o botão dos servidores LSP é mostrado na barra de status.\n\nPadrão: `true`"

msgctxt "settings schema"
msgid "Whether to show the active encoding button in the status bar.\n\nDefault: non_utf8"
msgstr "Define se o botão da codificação ativa é mostrado na barra de status.\n\nPadrão: non_utf8"

msgctxt "settings schema"
msgid "Whether to show the addition/deletion change count next to each file in the Git panel.\n\nDefault: true"
msgstr "Define se o número de alterações de adição/exclusão é mostrado ao lado de cada arquivo no painel do Git.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the agent panel button in the status bar.\n\nDefault: true"
msgstr "Define se o botão do painel do agente é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the avatar of the author of the commit.\n\nDefault: true"
msgstr "Define se o avatar do autor do commit é mostrado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the branch name button in the titlebar.\n\nDefault: true"
msgstr "Define se o botão do nome do branch é mostrado na barra de título.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the browser panel button in the status bar.\n\nDefault: true"
msgstr "Define se o botão do painel do navegador é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the call graph panel button in the status bar.\n\nDefault: true"
msgstr "Define se o botão do painel do grafo de chamadas é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the cursor position button in the status bar.\n\nDefault: true"
msgstr "Define se o botão da posição do cursor é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the debug button in the status bar.\n\nDefault: true"
msgstr "Define se o botão de depuração é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the file icon for a tab.\n\nDefault: false"
msgstr "Define se o ícone de arquivo é mostrado em uma aba.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show the git status in the outline panel.\n\nDefault: true"
msgstr "Define se o status do Git é mostrado no painel de estrutura.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the git status in the project panel.\n\nDefault: true"
msgstr "Define se o status do Git é mostrado no painel do projeto.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the informational hover box when moving the mouse\nover symbols in the editor.\n\nDefault: true"
msgstr "Define se a caixa de informações ao passar o cursor é mostrada ao mover o mouse sobre símbolos no editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the menus in the title bar.\n\nDefault: false"
msgstr "Define se os menus são mostrados na barra de título.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show the merge conflict indicator in the status bar\nthat offers to resolve conflicts using the agent.\n\nDefault: true"
msgstr "Define se o indicador de conflito de merge é mostrado na barra de status, oferecendo resolver os conflitos com o agente.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the name of the active file in the status bar.\n\nDefault: false"
msgstr "Define se o nome do arquivo ativo é mostrado na barra de status.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show the outline panel button in the status bar.\n\nDefault: true"
msgstr "Define se o botão do painel de estrutura é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the panel button in the status bar.\n\nDefault: true"
msgstr "Define se o botão do painel é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the project diagnostics button in the status bar."
msgstr "Define se o botão de diagnósticos do projeto deve ser exibido na barra de status."

msgctxt "settings schema"
msgid "Whether to show the project host and name in the titlebar.\n\nDefault: true"
msgstr "Define se o host e o nome do projeto são mostrados na barra de título.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the project panel button in the status bar.\n\nDefault: true"
msgstr "Define se o botão do painel do projeto é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the project search button in the status bar."
msgstr "Define se o botão de pesquisa do projeto deve ser exibido na barra de status."

msgctxt "settings schema"
msgid "Whether to show the selections menu in the editor toolbar.\n\nDefault: true"
msgstr "Define se o menu de seleções é mostrado na barra de ferramentas do editor.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the sign in button in the title bar.\n\nDefault: true"
msgstr "Define se o botão de entrar é mostrado na barra de título.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the signature help pop-up after completions or bracket pairs inserted.\n\nDefault: false"
msgstr "Define se o pop-up de ajuda de assinatura é mostrado depois que preenchimentos automáticos ou pares de colchetes são inseridos.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show the stage and restore buttons on diff hunks.\n\nDefault: true"
msgstr "Define se os botões de preparar e restaurar são mostrados nos blocos do diff.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the status bar.\n\nDefault: true"
msgstr "Define se a barra de status é mostrada.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the terminal button in the status bar.\n\nDefault: true"
msgstr "Define se o botão do terminal é mostrado na barra de status.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the user menu button in the title bar.\n\nDefault: true"
msgstr "Define se o botão do menu do usuário é mostrado na barra de título.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show the which-key popup when holding down key combinations.\nWhen enabled, the pending keystrokes indicator remains visible, but its binding preview\npopover is disabled.\n\nDefault: false"
msgstr "Define se o pop-up which-key é mostrado ao manter pressionadas combinações de teclas. Quando habilitado, o indicador de sequências de teclas pendentes continua visível, mas o pop-up de visualização das associações de teclas fica desabilitado.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show the worktree name button in the titlebar.\n\nDefault: true"
msgstr "Define se o botão do nome da árvore de trabalho é mostrado na barra de título.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show thumb buttons for feedback in the agent panel.\n\nDefault: true"
msgstr "Define se os botões de polegar para cima/para baixo de feedback são mostrados no painel do agente.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show turn statistics (elapsed time during generation, final turn duration).\n\nDefault: false"
msgstr "Define se as estatísticas do turno são mostradas (tempo decorrido durante a geração, duração final do turno).\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to show user avatar in the title bar.\n\nDefault: true"
msgstr "Define se o avatar do usuário é mostrado na barra de título.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to show wrap guides in the editor. Setting this to true will\nshow a guide at the 'preferred_line_length' value if softwrap is set to\n'preferred_line_length', and will show any additional guides as specified\nby the 'wrap_guides' setting.\n\nDefault: true"
msgstr "Define se as guias de quebra de linha são mostradas no editor. Se definido como true, mostra uma guia no valor de 'preferred_line_length' quando softwrap estiver definido como 'preferred_line_length', e mostra as guias adicionais especificadas pela configuração 'wrap_guides'.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to sort file and folder names case-sensitively in the project panel.\nThis works in combination with `sort_mode`. `sort_mode` controls how files and\ndirectories are grouped, while this setting controls how names are compared.\n\nDefault: default"
msgstr "Define se os nomes de arquivos e pastas são ordenados diferenciando maiúsculas e minúsculas no painel do projeto. Funciona em conjunto com `sort_mode`: `sort_mode` controla como arquivos e diretórios são agrupados, enquanto esta configuração controla como os nomes são comparados.\n\nPadrão: default"

msgctxt "settings schema"
msgid "Whether to split the thread history into the agent panel itself,\nas a list to the left of the current thread.\n\nDefault: true"
msgstr "Define se o histórico de conversas é separado dentro do próprio painel do agente, como uma lista à esquerda da conversa atual.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to start a new line with a comment when a previous line is a comment as well.\n\nDefault: true"
msgstr "Define se uma nova linha começa com um comentário quando a linha anterior também é um comentário.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to stick parent directories at top of the project panel.\n\nDefault: true"
msgstr "Define se os diretórios pai ficam fixos no topo do painel do projeto.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to tell a connected Claude Code CLI which file is open when\nnothing is selected (the CLI shows it as \"In <file>\" and attaches the\nfile to the next message). When off, only a selection of one or more\nlines is sent.\n\nDefault: true"
msgstr "Define se a CLI do Claude Code conectada é informada sobre o arquivo aberto quando nada está selecionado (a CLI o mostra como \"In <file>\" e anexa o arquivo à próxima mensagem). Quando desativado, só é enviada uma seleção de uma ou mais linhas.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to use additional LSP queries to format (and amend) the code after\nevery \"trigger\" symbol input, defined by LSP server capabilities.\n\nDefault: true"
msgstr "Define se consultas adicionais ao LSP são usadas para formatar (e corrigir) o código após cada entrada de símbolo de \"gatilho\", definida pelos recursos do servidor LSP.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to use command history ranking for sorting in the command palette.\n\nDefault: true"
msgstr "Define se a classificação pelo histórico de comandos é usada para ordenar a paleta de comandos.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to use gitignored files when searching.\nOnly the file Zed had indexed will be used, not necessary all the gitignored files.\n\nDefault: Smart"
msgstr "Define se os arquivos ignorados pelo Git são usados na pesquisa. Só os arquivos que o ForgeKairos indexou serão usados, não necessariamente todos os arquivos ignorados pelo Git.\n\nPadrão: Smart"

msgctxt "settings schema"
msgid "Whether to use language servers to provide code intelligence.\n\nDefault: true"
msgstr "Define se os servidores de linguagem são usados para fornecer inteligência de código.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to use the system provided dialogs for Open and Save As.\nWhen set to false, Zed will use the built-in keyboard-first pickers.\n\nDefault: true"
msgstr "Define se as caixas de diálogo do sistema são usadas para Abrir e Salvar como. Quando false, o ForgeKairos usa os seletores integrados, voltados ao teclado.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to use the system provided prompts.\nWhen set to false, Zed will use the built-in prompts.\nNote that this setting has no effect on Linux, where Zed will always\nuse the built-in prompts.\n\nDefault: true"
msgstr "Define se os diálogos de confirmação do sistema são usados. Quando false, o ForgeKairos usa os diálogos integrados. Esta configuração não tem efeito no Linux, onde o ForgeKairos sempre usa os diálogos integrados.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to use tree-sitter bracket queries to detect and colorize the brackets in the editor.\n\nDefault: false"
msgstr "Define se as consultas de colchetes do Tree-sitter são usadas para detectar e colorir os colchetes no editor.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether to warn (Windows/WSL only) when a sandbox grant targets a file on\na Windows-hosted (DrvFs) filesystem. Such grants are enforced inside WSL\nvia a translated path, and their sandbox-integrity guarantees are weaker\nthan a distro-native filesystem. When enabled, such grants show a warning\nthat must be acknowledged before the command runs.\nDefault: true"
msgstr "Define se um aviso é exibido (somente Windows/WSL) quando uma concessão do sandbox se refere a um arquivo em um sistema de arquivos hospedado no Windows (DrvFs). Essas concessões são aplicadas dentro do WSL por meio de um caminho traduzido, e suas garantias de integridade do sandbox são mais fracas que as de um sistema de arquivos nativo da distribuição. Quando habilitado, essas concessões mostram um aviso que precisa ser confirmado antes de o comando ser executado.\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to warn when a sandbox escalation prompt requests a domain or\nwrite path that contains potentially confusable Unicode characters\n(homoglyphs, invisible characters, or bidirectional overrides). When\nenabled, such prompts show a warning that must be acknowledged before\nthe request can be allowed.\nDefault: true"
msgstr "Define se um aviso é exibido quando uma solicitação de elevação do sandbox pede um domínio ou caminho de escrita que contém caracteres Unicode possivelmente confundíveis (homóglifos, caracteres invisíveis ou substituições bidirecionais). Quando habilitado, essas solicitações mostram um aviso que precisa ser confirmado antes que o pedido possa ser permitido.\nPadrão: true"

msgctxt "settings schema"
msgid "Whether to zoom the editor font size with the mouse wheel\nwhile holding the primary modifier key (Cmd on macOS, Ctrl on other platforms).\n\nDefault: false"
msgstr "Define se o tamanho da fonte do editor é ajustado com a roda do mouse enquanto a tecla modificadora principal é mantida pressionada (Cmd no macOS, Ctrl nas outras plataformas).\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether type hints should be shown.\n\nDefault: true"
msgstr "Define se as dicas de tipo são mostradas.\n\nPadrão: true"

msgctxt "settings schema"
msgid "Whether update checks also consider pre-releases. By default only releases are considered.\n\nDefault: false"
msgstr "Define se a verificação de atualizações também considera as versões de pré-lançamento. Por padrão, só as versões finais são consideradas.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Whether your current project should be shared when joining an empty channel.\n\nDefault: false"
msgstr "Define se o projeto atual é compartilhado ao entrar em um canal vazio.\n\nPadrão: false"

msgctxt "settings schema"
msgid "Which base git features (gutter, file colors, git::Diff) diff against.\n\nDefault: head"
msgstr "Base com a qual os recursos do Git (medianiz, cores dos arquivos, git::Diff) calculam o diff.\n\nPadrão: head"

msgctxt "settings schema"
msgid "Which code actions to run on save before the formatter.\nThese are not run if formatting is off.\n\nDefault: {} (or {\"source.organizeImports\": true} for Go)."
msgstr "Ações de código a executar ao salvar, antes do formatador. Elas não são executadas se a formatação estiver desativada.\n\nPadrão: {} (ou {\"source.organizeImports\": true} para Go)."

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar.\n\nDefault: all"
msgstr "Indicadores de diagnóstico a mostrar na barra de rolagem.\n\nPadrão: all"

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar:\n\nDefault: all"
msgstr "Indicadores de diagnóstico a mostrar na barra de rolagem:\n\nPadrão: all"

msgctxt "settings schema"
msgid "Which dock gets a pair of panels arranged in it the first time a project\nis opened. The dock itself is not opened for it; each panel's\n`starts_open` decides that. Once a project has a saved dock layout, that\nlayout is restored instead and this setting no longer applies to it.\n\nDefault: right"
msgstr "Dock em que um par de painéis é organizado na primeira vez que um projeto é aberto. O dock em si não é aberto por isso; o `starts_open` de cada painel decide. Depois que um projeto tem um layout de docks salvo, esse layout é restaurado e esta configuração não se aplica mais a ele.\n\nPadrão: right"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the project panel.\n\nDefault: all"
msgstr "Arquivos com erros/avisos de diagnóstico a marcar no painel do projeto.\n\nPadrão: all"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the tabs.\nThis setting can take the following three values:\n\nDefault: off"
msgstr "Arquivos com erros/avisos de diagnóstico a marcar nas abas. Esta configuração aceita os três valores a seguir:\n\nPadrão: off"

msgctxt "settings schema"
msgid "Which fullscreen mode the `zed::ToggleFullScreen` action enters (macOS only).\n\nDefault: native"
msgstr "Modo de tela cheia em que a ação `zed::ToggleFullScreen` entra (somente macOS).\n\nPadrão: native"

msgctxt "settings schema"
msgid "Which information to show in the branch picker.\n\nDefault: on"
msgstr "Informações a mostrar no seletor de branches.\n\nPadrão: on"

msgctxt "settings schema"
msgid "Which level to use to filter out diagnostics displayed in the editor.\n\nAffects the editor rendering only, and does not interrupt\nthe functionality of diagnostics fetching and project diagnostics editor.\nWhich files containing diagnostic errors/warnings to mark in the tabs.\nDiagnostics are only shown when file icons are also active.\n\nShows all diagnostics if not specified.\n\nDefault: warning"
msgstr "Nível usado para filtrar os diagnósticos exibidos no editor.\n\nAfeta somente a renderização do editor e não interrompe a obtenção de diagnósticos nem o editor de diagnósticos do projeto. Arquivos com erros/avisos de diagnóstico a marcar nas abas. Os diagnósticos só são mostrados quando os ícones de arquivo também estão ativos.\n\nMostra todos os diagnósticos se não for especificado.\n\nPadrão: warning"

msgctxt "settings schema"
msgid "Which sources the panel lists calls from: the language server, which\nis exact, the symbol index of C and C++ files, which matches names, or\nboth.\n\nDefault: all"
msgstr "Fontes de onde o painel lista as chamadas: o servidor de linguagem, que é exato, o índice de símbolos dos arquivos C e C++, que compara nomes, ou ambos.\n\nPadrão: all"

msgctxt "settings schema"
msgid "Which untracked files `git status` reports.\n\n`all` lists every file inside an untracked directory, which is what\ncolours individual entries in the project panel. `normal` only lists the\nuntracked directory itself, and `no` skips untracked files entirely;\nboth make `git status` markedly cheaper on very large trees.\n\nDefault: all"
msgstr "Arquivos não rastreados que o `git status` informa.\n\n`all` lista todos os arquivos dentro de um diretório não rastreado, o que permite colorir cada entrada no painel do projeto. `normal` lista só o próprio diretório não rastreado, e `no` ignora totalmente os arquivos não rastreados; ambos deixam o `git status` bem mais leve em árvores muito grandes.\n\nPadrão: all"

msgctxt "settings schema"
msgid "White ANSI terminal color."
msgstr "Cor branca do terminal ANSI."

msgctxt "settings schema"
msgid "Width scales automatically with the buffer font size."
msgstr "A largura se ajusta automaticamente ao tamanho da fonte do buffer."

msgctxt "settings schema"
msgid "Window title template.\n\nAvailable variables are `${projectName}`, `${fileName}`,\n`${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`,\n`${remoteHost}`, `${appName}`, `${branch}`,\nand `${separator}`.\n`${separator}` is omitted when adjacent variables are empty,\nbut literal text is preserved.\nThe collaboration indicator, when present, is appended after the\nrendered template.\nIf the template renders to nothing, the default template is used instead.\n\nDefault: `${projectName}${separator}${fileName}`"
msgstr "Modelo do título da janela.\n\nAs variáveis disponíveis são `${projectName}`, `${fileName}`, `${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`, `${remoteHost}`, `${appName}`, `${branch}` e `${separator}`. `${separator}` é omitido quando as variáveis adjacentes estão vazias, mas o texto literal é preservado. O indicador de colaboração, quando presente, é acrescentado após o modelo renderizado. Se o modelo for renderizado como vazio, o modelo padrão é usado em seu lugar.\n\nPadrão: `${projectName}${separator}${fileName}`"

msgctxt "settings schema"
msgid "Yellow ANSI terminal color."
msgstr "Cor amarela do terminal ANSI."

msgctxt "settings schema"
msgid "Zed draws its own window decorations/titlebar (client-side decoration)."
msgstr "O ForgeKairos desenha suas próprias decorações de janela/barra de título (decoração do lado do cliente)."

msgctxt "settings schema"
msgid "Zed's Prettier integration settings.\nAllows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\n\nDefault: off"
msgstr "Configurações da integração do ForgeKairos com o Prettier. Permitem habilitar/desabilitar a formatação com o Prettier e configurar o Prettier padrão, usado quando nenhuma instalação do Prettier no nível do projeto é encontrada.\n\nPadrão: off"

msgctxt "settings schema"
msgid "clangd's memory use: its index mode, worker count and a limit at which it\nis restarted."
msgstr "Uso de memória do clangd: o modo de indexação, o número de workers e o limite em que ele é reiniciado."
