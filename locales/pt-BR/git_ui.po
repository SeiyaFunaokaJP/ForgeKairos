msgstr "O stash foi alterado; não será aplicado"

msgid "Stash has changed, pop aborted"
msgstr "O stash foi alterado; pop abortado"

msgid "Stashes"
msgstr "Stashes"

msgid "Still on the scratch branch \"{}\"."
msgstr "Ainda no branch temporário \"{}\"."

msgid "Stop Excluding and Mark as Unplaced"
msgstr "Deixar de excluir e marcar como sem destino"

msgid "Stop Excluding {count} Commit from MR"
msgid_plural "Stop Excluding {count} Commits from MR"
msgstr[0] "Deixar de excluir {count} commit do MR"
msgstr[1] "Deixar de excluir {count} commits do MR"

msgid "Stop and Go Back"
msgstr "Parar e voltar"

