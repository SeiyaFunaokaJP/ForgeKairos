msgstr "Preparar e ir para o próximo bloco"

msgid "Stage {count} Files"
msgstr "Preparar {count} arquivos"

msgid "Staged"
msgstr "Preparados"

msgid "Staged & Unstaged"
msgstr "Preparados e não preparados"

msgid "Staged Changes"
msgstr "Alterações preparadas"

msgid "Staged changes (git diff --cached)"
msgstr "Alterações preparadas (git diff --cached)"

msgid "Starts using Git in this folder (creates a .git folder). The existing files do not change"
msgstr "Começa a usar o Git nesta pasta (cria uma pasta .git). Os arquivos existentes não mudam"

