msgid_plural "Squash the {count} Selected Commits into One Commit on a New MR Branch…"
msgstr[0] "Combinar o {count} commit selecionado em um único commit em um novo branch do MR…"
msgstr[1] "Combinar os {count} commits selecionados em um único commit em um novo branch do MR…"

