msgstr "Mostra todos os arquivos deste commit como adicionados. Isso pode ser lento em repositórios grandes."

msgid "Show in Git Graph"
msgstr "Mostrar no grafo de commits"

msgid "Show this file's full contents at this commit as added."
msgstr "Mostra todo o conteúdo deste arquivo neste commit como adicionado."

msgid "Show {hidden_count} More"
msgstr "Mostrar mais {hidden_count}"

msgid "Show:"
msgstr "Mostrar:"

msgid "Shows a diff of only the changes not staged yet (which do not go into the next commit)"
msgstr "Mostra um diff somente das alterações ainda não preparadas (que não entram no próximo commit)"

msgid "Shows a diff of only the staged changes (which go into the next commit)"
msgstr "Mostra um diff somente das alterações preparadas (que entram no próximo commit)"

msgid "Shows both your branches (local) and the copies of the server's branches (remote)"
msgstr "Mostra tanto os seus branches (locais) quanto as cópias dos branches do servidor (remotos)"

msgid "Shows only the branches in your repository. These are the ones you can commit to"
msgstr "Mostra somente os branches do seu repositório. São neles que você pode fazer commit"

msgid "Shows only the copies of the server's branches that the last fetch brought in (origin/… and so on)"
msgstr "Mostra somente as cópias dos branches do servidor trazidas pelo último fetch (origin/… etc.)"

msgid "Shows the changed files in a single column, without splitting them by folder"
msgstr "Mostra os arquivos alterados em uma única coluna, sem dividi-los por pasta"

msgid "Shows the diff (before and after) of the uncommitted changes together in one tab"
msgstr "Mostra juntos em uma aba o diff (antes e depois) das alterações sem commit"

msgid "Shows what these changes put on the shelf (the stash) contain, as a diff. Does not pop them"
msgstr "Mostra como diff o conteúdo destas alterações guardadas na prateleira (o stash). Não faz pop delas"

msgid "Signoff"
msgstr "Sign-off"

msgid "Skip Hooks"
msgstr "Ignorar hooks"

msgid "Skipped a commit of the {}."
msgstr "Um commit de {} foi pulado."

msgid "Skips the commit it stopped at and moves on to the next commit"
msgstr "Pula o commit em que a operação parou e passa para o próximo commit"

msgid "Some branches could not be loaded"
msgstr "Não foi possível carregar alguns branches"

msgid "Some branches could not be loaded: {error}"
msgstr "Não foi possível carregar alguns branches: {error}"

msgid "Some files have conflicts. Resolve them first."
msgstr "Alguns arquivos têm conflitos. Resolva-os antes."

msgid "Sort By"
msgstr "Ordenar por"

msgid "Sorts by file name, regardless of the folder"
msgstr "Ordena pelo nome do arquivo, independentemente da pasta"

msgid "Sorts by location, folders included (the path). Files in the same folder end up next to each other"
msgstr "Ordena pelo local, incluindo as pastas (o caminho). Arquivos da mesma pasta ficam lado a lado"

msgid "Squash into One — {reason}"
msgstr "Combinar em um só — {reason}"

msgid "Squash the selected commits into one?"
msgstr "Combinar os commits selecionados em um só?"

msgid "Squash the {count} Selected Commit into One"
msgid_plural "Squash the {count} Selected Commits into One"
msgstr[0] "Combinar o {count} commit selecionado em um só"
msgstr[1] "Combinar os {count} commits selecionados em um só"

