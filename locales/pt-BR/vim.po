msgstr "Use ! para gravar parte do buffer"

msgid "Vim: Off"
msgstr "Vim: Desativado"

msgid "Vim: On"
msgstr "Vim: Ativado"

msgid "When disabled, you can type as soon as you open a file, just like in VSCode."
msgstr "Quando desabilitado, você pode digitar assim que abrir um arquivo, como no VSCode."

msgid "When enabled, you edit with Vim key bindings."
msgstr "Quando habilitado, você edita com as associações de teclas do Vim."

msgid "[No Name]"
msgstr "[Sem nome]"

msgid "{filename}{modified} {lines} lines --{percentage}%--"
msgstr "{filename}{modified} {lines} linhas --{percentage}%--"

msgid "{path} already exists. Do you want to replace it?"
msgstr "{path} já existe. Deseja substituí-lo?"

msgid "{} already exists. Do you want to replace it?"
msgstr "{} já existe. Deseja substituí-lo?"
