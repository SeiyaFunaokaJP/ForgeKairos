msgid " [modified]"
msgstr " [modificado]"

msgid "A file or folder with the same name already exists. Replacing it will overwrite its current contents."
msgstr "Já existe um arquivo ou pasta com o mesmo nome. Ao substituí-lo, o conteúdo atual será sobrescrito."

msgid "Argument required"
msgstr "Argumento necessário"

msgid "Cancel"
msgstr "Cancelar"

msgid "Cannot save buffer with absolute path"
msgstr "Não é possível salvar o buffer com caminho absoluto"

msgid "Default Vim Bindings"
msgstr "Associações de teclas padrão do Vim"

msgid "Disable Vim Mode"
msgstr "Desabilitar modo Vim"

msgid "Enable Vim Mode"
msgstr "Habilitar modo Vim"

msgid "Failed to :w"
msgstr "Falha ao executar :w"

msgid "Failed to save"
msgstr "Falha ao salvar"

msgid "Failed to write lines"
msgstr "Falha ao gravar as linhas"

msgid "Invalid argument: {}"
msgstr "Argumento inválido: {}"

msgid "No file name"
msgstr "Sem nome de arquivo"

msgid "Nothing in register {}"
msgstr "Nada no registrador {}"

