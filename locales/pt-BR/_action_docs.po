# The descriptions of actions (their doc comments), keyed by the action name.
# The #. comments of an entry are the English it translates, one per line.
#
# Entries that zed-i18n also translates started from its pt-BR translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: pt-BR\n"
"X-Language-Name: Português (Brasil)\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#. Runs a sequence of actions.
#.
#. NOTE: This does **not** wait for asynchronous actions to complete before running the next action.
msgctxt "action documentation"
msgid "action::Sequence"
msgstr "Executa uma sequência de ações.\n\nOBSERVAÇÃO: **não** aguarda a conclusão das ações assíncronas antes de executar a próxima ação."

#. Displays error messages from language servers in the status bar.
msgctxt "action documentation"
msgid "activity_indicator::ShowErrorMessage"
msgstr "Exibe mensagens de erro dos servidores de linguagem na barra de status."

#. Add the current selection as context for threads in the agent panel.
msgctxt "action documentation"
msgid "agent::AddSelectionToThread"
msgstr "Adiciona a seleção atual como contexto para conversas no painel do agente."

#. Allow this operation and remember the choice.
msgctxt "action documentation"
msgid "agent::AllowAlways"
msgstr "Permite esta operação e lembra a escolha."

#. Allow this operation only this time.
msgctxt "action documentation"
msgid "agent::AllowOnce"
msgstr "Permite esta operação somente desta vez."

#. Archives the currently selected thread.
msgctxt "action documentation"
msgid "agent::ArchiveSelectedThread"
msgstr "Arquiva a conversa selecionada atualmente."

#. Action to authorize a tool call with a specific permission option.
#. This is used by the permission granularity dropdown to authorize tool calls.
msgctxt "action documentation"
msgid "agent::AuthorizeToolCall"
msgstr "Ação para autorizar uma chamada de ferramenta com uma opção de permissão específica.\nEssa ação é usada pelo menu suspenso de granularidade de permissão para autorizar chamadas de ferramentas."

#. Starts a chat conversation with the agent.
msgctxt "action documentation"
msgid "agent::Chat"
msgstr "Inicia uma conversa de chat com o agente."

#. Starts a chat conversation with follow-up enabled.
msgctxt "action documentation"
msgid "agent::ChatWithFollow"
msgstr "Inicia uma conversa de chat com o acompanhamento habilitado."

#. Clears all messages from the queue.
msgctxt "action documentation"
msgid "agent::ClearMessageQueue"
msgstr "Limpa todas as mensagens da fila."

#. Copies the current thread to the clipboard as JSON for debugging.
msgctxt "action documentation"
msgid "agent::CopyThreadToClipboard"
msgstr "Copia a conversa atual para a área de transferência como JSON para fins de depuração."

#. Opens the skill creator window to import a skill from a GitHub URL.
msgctxt "action documentation"
msgid "agent::CreateSkillFromUrl"
msgstr "Abre a janela do criador de habilidades para importar uma habilidade de uma URL do GitHub."

#. Cycles through favorited models in the ACP model selector.
msgctxt "action documentation"
msgid "agent::CycleFavoriteModels"
msgstr "Alterna entre os modelos favoritos no seletor de modelos ACP."

#. Cycles through available session modes.
msgctxt "action documentation"
msgid "agent::CycleModeSelector"
msgstr "Alterna entre os modos de sessão disponíveis."

#. Cycles to the next inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CycleNextInlineAssist"
msgstr "Avança para a próxima sugestão de assistência embutida."

#. Cycles to the previous inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CyclePreviousInlineAssist"
msgstr "Volta para a sugestão anterior de assistência embutida."

#. Cycles through available thinking effort levels for the current model.
msgctxt "action documentation"
msgid "agent::CycleThinkingEffort"
msgstr "Alterna entre os níveis de profundidade de raciocínio disponíveis para o modelo atual."

#. Closes the thread search bar.
msgctxt "action documentation"
msgid "agent::DismissThreadSearch"
msgstr "Fecha a barra de pesquisa da conversa."

#. Edits the first message in the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::EditFirstQueuedMessage"
msgstr "Edita a primeira mensagem na fila (a próxima a ser enviada)."

#. Expands the message editor to full size.
msgctxt "action documentation"
msgid "agent::ExpandMessageEditor"
msgstr "Expande o editor de mensagens para tamanho total."

#. Moves focus down in the interface.
msgctxt "action documentation"
msgid "agent::FocusDown"
msgstr "Move o foco para baixo na interface."

#. Moves focus left in the interface.
msgctxt "action documentation"
msgid "agent::FocusLeft"
msgstr "Move o foco para a esquerda na interface."

#. Moves focus right in the interface.
msgctxt "action documentation"
msgid "agent::FocusRight"
msgstr "Move o foco para a direita na interface."

#. Moves focus up in the interface.
msgctxt "action documentation"
msgid "agent::FocusUp"
msgstr "Move o foco para cima na interface."

#. Follows the agent's suggestions.
msgctxt "action documentation"
msgid "agent::Follow"
msgstr "Segue as sugestões do agente."

#. Import agent threads from other Zed release channels (e.g. Preview, Nightly).
msgctxt "action documentation"
msgid "agent::ImportThreadsFromOtherChannels"
msgstr "Importa conversas de agentes de outros canais de lançamento do ForgeKairos (ex.: Preview, Nightly)."

#. Keeps the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Keep"
msgstr "Mantém a sugestão ou alteração atual."

#. Keeps all suggestions or changes.
msgctxt "action documentation"
msgid "agent::KeepAll"
msgstr "Mantém todas as sugestões ou alterações."

#. Loads a thread from the clipboard JSON for debugging.
msgctxt "action documentation"
msgid "agent::LoadThreadFromClipboard"
msgstr "Carrega uma conversa a partir do JSON da área de transferência para depuração."

#. Logs out of the current external agent
msgctxt "action documentation"
msgid "agent::LogoutAgent"
msgstr "Faz logout do agente externo atual"

#. Opens the profile management interface for configuring agent tools and settings.
msgctxt "action documentation"
msgid "agent::ManageProfiles"
msgstr "Abre a interface de gerenciamento de perfis para configurar ferramentas e configurações do agente."

#. Opens the skills manager in the settings window.
msgctxt "action documentation"
msgid "agent::ManageSkills"
msgstr "Abre o gerenciador de habilidades na janela de configurações."

#. Moves the thread open in a tab back to the agent panel.
msgctxt "action documentation"
msgid "agent::MoveThreadToPanel"
msgstr "Move a conversa aberta em uma aba de volta para o painel do agente."

#. Creates a new external agent conversation thread.
msgctxt "action documentation"
msgid "agent::NewExternalAgentThread"
msgstr "Cria uma nova conversa de agente externo."

#. Starts a new terminal thread.
msgctxt "action documentation"
msgid "agent::NewTerminalThread"
msgstr "Inicia uma nova conversa no terminal."

#. Creates a new conversation thread, optionally based on an existing thread.
msgctxt "action documentation"
msgid "agent::NewThread"
msgstr "Cria uma nova conversa, opcionalmente baseada em uma conversa existente."

#. Starts a new thread of the built-in agent on a model of the given
#. language model provider.
msgctxt "action documentation"
msgid "agent::NewThreadWithLanguageModelProvider"
msgstr "Inicia uma nova conversa do agente integrado em um modelo do provedor de modelos de linguagem informado."

#. Opens the active thread as a markdown file.
msgctxt "action documentation"
msgid "agent::OpenActiveThreadAsMarkdown"
msgstr "Abre a conversa ativa como um arquivo Markdown."

#. Opens the "Add Context" menu in the message editor.
msgctxt "action documentation"
msgid "agent::OpenAddContextMenu"
msgstr "Abre o menu \"Adicionar contexto\" no editor de mensagens."

#. Opens the agent diff view to review changes.
msgctxt "action documentation"
msgid "agent::OpenAgentDiff"
msgstr "Abre a exibição de diff do agente para revisar as alterações."

#. Opens the user-global AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenGlobalAGENTS.mdRules"
msgstr "Abre o arquivo de regras AGENTS.md global do usuário."

#. Opens the agent onboarding modal.
msgctxt "action documentation"
msgid "agent::OpenOnboardingModal"
msgstr "Abre o modal de introdução do agente."

#. Opens the permission granularity dropdown for the current tool call.
msgctxt "action documentation"
msgid "agent::OpenPermissionDropdown"
msgstr "Abre o menu suspenso de granularidade de permissão para a chamada de ferramenta atual."

#. Opens the project AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenProjectAGENTS.mdRules"
msgstr "Abre o arquivo de regras AGENTS.md do projeto."

#. Opens the agent settings UI.
msgctxt "action documentation"
msgid "agent::OpenSettings"
msgstr "Abre a interface de configurações do agente."

#. Opens the skill creator window for creating a new skill.
msgctxt "action documentation"
msgid "agent::OpenSkillCreator"
msgstr "Abre a janela do criador de habilidades para criar uma nova habilidade."

#. Opens the current thread as a tab in a pane split to the right.
msgctxt "action documentation"
msgid "agent::OpenThreadInSplit"
msgstr "Abre a conversa atual como uma aba em um subpainel dividido à direita."

#. Opens the current thread as a tab in the workspace. The panel goes back
#. to a new draft.
msgctxt "action documentation"
msgid "agent::OpenThreadInTab"
msgstr "Abre a conversa atual como uma aba no espaço de trabalho. O painel volta para um novo rascunho."

#. Pastes clipboard content without any formatting.
msgctxt "action documentation"
msgid "agent::PasteRaw"
msgstr "Cola o conteúdo da área de transferência sem formatação."

#. Triggers re-authentication on Gemini
msgctxt "action documentation"
msgid "agent::ReauthenticateAgent"
msgstr "Aciona a autenticação novamente no Gemini"

#. Reconnects to an agent that was stopped while unused, without sending anything.
msgctxt "action documentation"
msgid "agent::ReconnectParkedAgent"
msgstr "Reconecta a um agente que foi parado enquanto não estava em uso, sem enviar nada."

#. Rejects the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Reject"
msgstr "Rejeita a sugestão ou alteração atual."

#. Rejects all suggestions or changes.
msgctxt "action documentation"
msgid "agent::RejectAll"
msgstr "Rejeita todas as sugestões ou alterações."

#. Reject this operation only this time.
msgctxt "action documentation"
msgid "agent::RejectOnce"
msgstr "Rejeita esta operação apenas desta vez."

#. Removes the first message from the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::RemoveFirstQueuedMessage"
msgstr "Remove a primeira mensagem da fila (a próxima a ser enviada)."

#. Removes the currently selected thread.
msgctxt "action documentation"
msgid "agent::RemoveSelectedThread"
msgstr "Remove a conversa atualmente selecionada."

#. Renames the currently selected thread.
msgctxt "action documentation"
msgid "agent::RenameSelectedThread"
msgstr "Renomeia a conversa atualmente selecionada."

#. Reruns the rules-to-skills migration.
msgctxt "action documentation"
msgid "agent::RerunRulesToSkillsMigration"
msgstr "Reexecuta a migração de regras para habilidades."

#. Resets the agent panel zoom levels (agent UI and buffer font sizes).
msgctxt "action documentation"
msgid "agent::ResetAgentZoom"
msgstr "Redefine os níveis de zoom do painel do agente (tamanhos de fonte da interface do agente e do buffer)."

#. Re-enables the fast mode warning for every provider and model.
msgctxt "action documentation"
msgid "agent::ResetFastModeWarnings"
msgstr "Reabilita o aviso de modo rápido para todos os provedores e modelos."

#. Resets the agent onboarding state.
msgctxt "action documentation"
msgid "agent::ResetOnboarding"
msgstr "Redefine o estado de introdução do agente."

#. Resets the trial end upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialEndUpsell"
msgstr "Redefine a notificação de upsell de fim de avaliação."

#. Resets the trial upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialUpsell"
msgstr "Redefine a notificação de upsell de avaliação."

#. Opens a new agent thread to resolve merge conflicts in the given file paths.
msgctxt "action documentation"
msgid "agent::ResolveConflictedFilesWithAgent"
msgstr "Abre uma nova conversa do agente para resolver conflitos de merge nos caminhos de arquivo fornecidos."

#. Opens a new agent thread to resolve specific merge conflicts.
msgctxt "action documentation"
msgid "agent::ResolveConflictsWithAgent"
msgstr "Abre uma nova conversa do agente para resolver conflitos de merge específicos."

#. Opens a new agent thread with the provided branch diff for review.
msgctxt "action documentation"
msgid "agent::ReviewBranchDiff"
msgstr "Abre uma nova conversa do agente com o diff de branch fornecido para revisão."

#. Takes back every start of an agent outside its sandbox that was
#. confirmed for a thread, so that each thread asks again.
msgctxt "action documentation"
msgid "agent::RevokeOutsideSandboxConsents"
msgstr "Revoga toda inicialização de um agente fora do sandbox que foi confirmada para uma conversa, para que cada conversa pergunte novamente."

#. Scroll the output down by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineDown"
msgstr "Rola a saída três linhas para baixo."

#. Scroll the output up by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineUp"
msgstr "Rola a saída três linhas para cima."

#. Scroll the output by one page down.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageDown"
msgstr "Rola a saída uma página para baixo."

#. Scroll the output by one page up.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageUp"
msgstr "Rola a saída uma página para cima."

#. Scroll the output to the bottom.
msgctxt "action documentation"
msgid "agent::ScrollOutputToBottom"
msgstr "Rola a saída até o final."

#. Scroll the output to the next user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToNextMessage"
msgstr "Rola a saída até a próxima mensagem do usuário."

#. Scroll the output to the previous user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToPreviousMessage"
msgstr "Rola a saída até a mensagem anterior do usuário."

#. Scroll the output to the top.
msgctxt "action documentation"
msgid "agent::ScrollOutputToTop"
msgstr "Rola a saída até o início."

#. Selects the agent used for new threads in the agent panel, without
#. opening the panel. The selected agent is launched the next time the
#. panel is opened.
msgctxt "action documentation"
msgid "agent::SelectAgent"
msgstr "Seleciona o agente usado para novas conversas no painel do agente, sem\nabrir o painel. O agente selecionado é iniciado na próxima vez que o\npainel for aberto."

#. Selects the next thread search match.
msgctxt "action documentation"
msgid "agent::SelectNextThreadMatch"
msgstr "Seleciona a próxima correspondência da pesquisa na conversa."

#. Action to select a permission granularity option from the dropdown.
#. This updates the selected granularity without triggering authorization.
msgctxt "action documentation"
msgid "agent::SelectPermissionGranularity"
msgstr "Ação para selecionar uma opção de granularidade de permissão no menu suspenso.\nAtualiza a granularidade selecionada sem acionar a autorização."

#. Selects the previous thread search match.
msgctxt "action documentation"
msgid "agent::SelectPreviousThreadMatch"
msgstr "Seleciona a correspondência anterior da pesquisa na conversa."

#. Interrupts the current generation and sends the message immediately.
msgctxt "action documentation"
msgid "agent::SendImmediately"
msgstr "Interrompe a geração atual e envia a mensagem imediatamente."

#. Sends the next queued message immediately.
msgctxt "action documentation"
msgid "agent::SendNextQueuedMessage"
msgstr "Envia a próxima mensagem na fila imediatamente."

#. Opens a small window over the workspace that sets up a language model
#. provider in place (its consent, key or sign-in), and then starts a
#. thread on it.
msgctxt "action documentation"
msgid "agent::SetUpLanguageModelProvider"
msgstr "Abre uma pequena janela sobre o espaço de trabalho que configura ali mesmo um provedor de modelos de linguagem (seu consentimento, chave ou login) e depois inicia uma conversa nele."

#. Toggles the agent panel.
msgctxt "action documentation"
msgid "agent::Toggle"
msgstr "Alterna o painel do agente."

#. Switches `agent.tool_permissions.default` between "confirm" and
#. "allow", so every tool action can be auto-approved without a prompt.
#. From "auto" (the AI judge) it also switches back to "confirm", so
#. the shortcut always leads out of an unattended mode.
msgctxt "action documentation"
msgid "agent::ToggleAutoApproveToolActions"
msgstr "Alterna `agent.tool_permissions.default` entre \"confirm\" e \"allow\", para que toda ação de ferramenta possa ser aprovada automaticamente sem diálogo de confirmação. A partir de \"auto\" (o julgamento por IA) também volta para \"confirm\", de modo que o atalho sempre sai de um modo não supervisionado."

#. Action to toggle a command pattern checkbox in the permission dropdown.
msgctxt "action documentation"
msgid "agent::ToggleCommandPattern"
msgstr "Ação para alternar uma caixa de seleção de padrão de comando no menu suspenso de permissões."

#. Toggles fast mode for models that support it.
msgctxt "action documentation"
msgid "agent::ToggleFastMode"
msgstr "Alterna o modo rápido para modelos que oferecem suporte a ele."

#. Toggles the language model selector dropdown.
msgctxt "action documentation"
msgid "agent::ToggleModelSelector"
msgstr "Alterna o menu suspenso do seletor de modelo de linguagem."

#. Toggles the menu to create new agent threads.
msgctxt "action documentation"
msgid "agent::ToggleNewThreadMenu"
msgstr "Alterna o menu para criar novas conversas do agente."

#. Toggles the options menu for agent settings and preferences.
msgctxt "action documentation"
msgid "agent::ToggleOptionsMenu"
msgstr "Alterna o menu de opções de configurações e preferências do agente."

#. Toggles the tab bar of the agent panel's own pane.
msgctxt "action documentation"
msgid "agent::TogglePanelTabBar"
msgstr "Alterna a barra de abas do subpainel do próprio painel do agente."

#. Toggles the thread history list shown inside the agent panel.
msgctxt "action documentation"
msgid "agent::TogglePanelThreadHistory"
msgstr "Alterna a lista do histórico de conversas mostrada dentro do painel do agente."

#. Toggles the profile or mode selector for switching between agent profiles.
msgctxt "action documentation"
msgid "agent::ToggleProfileSelector"
msgstr "Alterna o seletor de perfil ou modo para alternar entre perfis do agente."

#. Toggles in-thread search over the current agent thread's contents.
msgctxt "action documentation"
msgid "agent::ToggleSearch"
msgstr "Alterna a pesquisa no conteúdo da conversa atual do agente."

#. Toggles steering for the first queued message: when on, it interrupts
#. the agent at its next step instead of waiting for it to finish.
msgctxt "action documentation"
msgid "agent::ToggleSteerFirstQueuedMessage"
msgstr "Alterna a orientação da primeira mensagem na fila: quando ativada, interrompe\no agente na próxima etapa, em vez de esperar que ele termine."

#. Toggles the thinking effort selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleThinkingEffortMenu"
msgstr "Alterna o menu do seletor de profundidade de raciocínio entre aberto e fechado."

#. Toggles thinking mode for models that support extended thinking.
msgctxt "action documentation"
msgid "agent::ToggleThinkingMode"
msgstr "Alterna o modo de raciocínio para modelos que suportam raciocínio estendido."

#. Toggles the tool permission mode selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleToolPermissionSelector"
msgstr "Abre ou fecha o menu seletor do modo de permissão de ferramentas."

#. Undoes the most recent reject operation, restoring the rejected changes.
msgctxt "action documentation"
msgid "agent::UndoLastReject"
msgstr "Desfaz a operação de rejeição mais recente, restaurando as alterações rejeitadas."

#. Moves focus to the sidebar's search/filter editor.
msgctxt "action documentation"
msgid "agents_sidebar::FocusSidebarFilter"
msgstr "Move o foco para o editor de pesquisa/filtro da barra lateral."

#. Creates a new thread in the currently selected or active project group.
msgctxt "action documentation"
msgid "agents_sidebar::NewThreadInGroup"
msgstr "Cria uma nova conversa no grupo de projeto selecionado ou ativo no momento."

#. Toggles between the thread list and the thread history.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadHistory"
msgstr "Alterna entre a lista de conversas e o histórico de conversas."

#. Toggles the thread switcher popup when the sidebar is focused.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadSwitcher"
msgstr "Alterna o pop-up do seletor de conversas quando a barra lateral está em foco."

#. Toggles the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::Toggle"
msgstr "Alterna o painel do navegador de IA, onde os agentes de IA abrem as abas do navegador que controlam."

#. Toggles focus on the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::ToggleFocus"
msgstr "Alterna o foco no painel do navegador de IA, onde os agentes de IA abrem as abas do navegador que controlam."

#. Activates the menu on the left in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuLeft"
msgstr "Ativa o menu à esquerda no menu de aplicativo do lado do cliente.\n\nNão se aplica às barras de menu da plataforma (ex.: no macOS)."

#. Activates the menu on the right in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuRight"
msgstr "Ativa o menu à direita no menu de aplicativo do lado do cliente.\n\nNão se aplica às barras de menu da plataforma (ex.: no macOS)."

#. Opens the named menu in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::OpenApplicationMenu"
msgstr "Abre o menu indicado no menu do aplicativo do lado do cliente.\n\nNão se aplica às barras de menu da plataforma (ex.: no macOS)."

#. Deploys the assistant interface with the specified configuration.
msgctxt "action documentation"
msgid "assistant::InlineAssist"
msgstr "Abre a interface do assistente com a configuração especificada."

#. Checks for available updates.
msgctxt "action documentation"
msgid "auto_update::Check"
msgstr "Verifica se há atualizações disponíveis."

#. Dismisses the update error message.
msgctxt "action documentation"
msgid "auto_update::DismissMessage"
msgstr "Fecha a mensagem de erro de atualização."

#. Opens the release notes for the current version in a browser.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotes"
msgstr "Abre as notas de versão da versão atual em um navegador."

#. Opens the release notes for the current version in a new tab.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotesLocally"
msgstr "Abre as notas de versão da versão atual em uma nova aba."

#. Cycle through branch filters.
msgctxt "action documentation"
msgid "branch_picker::CycleBranchFilter"
msgstr "Alterna entre os filtros de branch."

#. Deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::DeleteBranch"
msgstr "Exclui o branch local ou remoto selecionado."

#. Force deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::ForceDeleteBranch"
msgstr "Força a exclusão do branch local ou remoto selecionado."

#. Show all branches.
msgctxt "action documentation"
msgid "branch_picker::ShowAllBranches"
msgstr "Exibe todos os branches."

#. Show only local branches.
msgctxt "action documentation"
msgid "branch_picker::ShowLocalBranches"
msgstr "Exibe somente os branches locais."

#. Show only remote branches.
msgctxt "action documentation"
msgid "branch_picker::ShowRemoteBranches"
msgstr "Exibe somente os branches remotos."

#. Toggles the branch filter menu.
msgctxt "action documentation"
msgid "branch_picker::ToggleFilterMenu"
msgstr "Alterna o menu de filtros de branch."

#. Adds the current page to the bookmarks.
msgctxt "action documentation"
msgid "browser_panel::AddBookmark"
msgstr "Adiciona a página atual aos favoritos."

#. Asks Copilot about the selected text.
msgctxt "action documentation"
msgid "browser_panel::AskCopilot"
msgstr "Pergunta ao Copilot sobre o texto selecionado."

#. Closes the current tab of the browser panel.
msgctxt "action documentation"
msgid "browser_panel::ClosePanelTab"
msgstr "Fecha a aba atual do painel do navegador."

#. Moves focus to the address bar.
msgctxt "action documentation"
msgid "browser_panel::FocusAddressBar"
msgstr "Move o foco para a barra de endereço."

#. Moves focus to the next pane of the split browser panel.
msgctxt "action documentation"
msgid "browser_panel::FocusNextPaneGroup"
msgstr "Move o foco para o próximo subpainel do painel do navegador dividido."

#. Opens the URL set as the home page.
msgctxt "action documentation"
msgid "browser_panel::GoHome"
msgstr "Abre a URL definida como página inicial."

#. Goes back to the previous page.
msgctxt "action documentation"
msgid "browser_panel::NavigateBack"
msgstr "Volta para a página anterior."

#. Goes forward to the next page.
msgctxt "action documentation"
msgid "browser_panel::NavigateForward"
msgstr "Avança para a próxima página."

#. Opens a new AI tab in the AI browser panel: a tab with its own browser profile that AI agents can drive, with its traffic limited to the network allowlist.
msgctxt "action documentation"
msgid "browser_panel::NewAiTab"
msgstr "Abre uma nova aba de IA no painel do navegador de IA: uma aba com seu próprio perfil de navegador que os agentes de IA podem controlar, com o tráfego limitado à lista de permissões de rede."

#. Opens a new browser tab in the editor area.
msgctxt "action documentation"
msgid "browser_panel::NewBrowserTab"
msgstr "Abre uma nova aba do navegador na área do editor."

#. Opens a new tab in the browser panel.
msgctxt "action documentation"
msgid "browser_panel::NewPanelTab"
msgstr "Abre uma nova aba no painel do navegador."

#. Opens the developer tools of the current browser tab.
