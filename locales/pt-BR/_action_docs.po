#. Toggles fullscreen mode.
msgctxt "action documentation"
msgid "zed::ToggleFullScreen"
msgstr "Alterna o modo de tela cheia."

#. Action with special handling which unbinds later bindings for the same keystrokes when they
#. dispatch the named action, regardless of that action's context.
#.
#. In keymap JSON this is written as:
#.
#. `["zed::Unbind", "editor::NewLine"]`
msgctxt "action documentation"
msgid "zed::Unbind"
msgstr "Ação com tratamento especial que remove as associações de teclas posteriores para as mesmas sequências de teclas quando elas executam a ação indicada, independentemente do contexto dessa ação.\n\nNo JSON do mapa de teclas, isso é escrito assim:\n\n`[\"zed::Unbind\", \"editor::NewLine\"]`"

#. Zooms the window.
msgctxt "action documentation"
msgid "zed::Zoom"
msgstr "Aplica zoom na janela."

#. Opens the Zed Predict onboarding modal.
msgctxt "action documentation"
msgid "zed_predict_onboarding::OpenZedPredictOnboarding"
msgstr "Abre o modal de introdução do Zed Predict."

#. Focuses on the completions list.
msgctxt "action documentation"
msgid "zeta::FocusPredictions"
msgstr "Foca na lista de preenchimentos automáticos."

#. Navigates to the next edit in the completion history.
msgctxt "action documentation"
msgid "zeta::NextEdit"
msgstr "Navega para a próxima edição no histórico de preenchimentos automáticos."

#. Previews the selected completion.
msgctxt "action documentation"
msgid "zeta::PreviewPrediction"
msgstr "Visualiza o preenchimento automático selecionado."

#. Navigates to the previous edit in the completion history.
msgctxt "action documentation"
msgid "zeta::PreviousEdit"
msgstr "Navega para a edição anterior no histórico de preenchimentos automáticos."

#. Rates the active completion with a thumbs down.
msgctxt "action documentation"
msgid "zeta::ThumbsDownActivePrediction"
msgstr "Avalia o preenchimento automático ativo com um polegar para baixo."

#. Rates the active completion with a thumbs up.
msgctxt "action documentation"
msgid "zeta::ThumbsUpActivePrediction"
msgstr "Avalia o preenchimento automático ativo com um polegar para cima."
