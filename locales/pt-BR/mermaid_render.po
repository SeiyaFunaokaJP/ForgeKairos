msgstr "Realização (a direita é abstrata)"

msgid "Rectangle [process]"
msgstr "Retângulo [processo]"

msgid "Refines (refines)"
msgstr "Refina (refines)"

msgid "Rhombus {{condition}}"
msgstr "Losango {{condição}}"

msgid "Right to left (RL)"
msgstr "Da direita para a esquerda (RL)"

msgid "Risk: High"
msgstr "Risco: alto"

msgid "Risk: Low"
msgstr "Risco: baixo"

