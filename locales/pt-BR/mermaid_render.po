msgstr "A largura de {what} deve ser 1 ou mais."

msgid "The x axis has an empty category ({statement})."
msgstr "O eixo x tem uma categoria vazia ({statement})."

msgid "The x axis has no categories. Add a category, or set the x-axis “Scale” to “None (1, 2, 3…)”."
msgstr "O eixo x não tem categorias. Adicione uma categoria ou defina a “Escala” do eixo x como “Nenhum (1, 2, 3…)”."

msgid "The x-axis category `{}` cannot be written. {text_rule}"
msgstr "A categoria do eixo x `{}` não pode ser escrita. {text_rule}"

msgid "The x-axis name `{}` cannot be written. {text_rule}"
msgstr "O nome do eixo x `{}` não pode ser escrito. {text_rule}"

msgid "The y axis cannot have categories ({statement})."
msgstr "O eixo y não pode ter categorias ({statement})."

