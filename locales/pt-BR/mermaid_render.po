msgid ""
msgstr ""
"Language: pt-BR\n"
"X-Language-Name: Português (Brasil)\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "A Note has no target."
msgstr "Uma Note não tem alvo."

msgid "A `%%{{` directive is on the same line as a statement or a comment (Mermaid cuts out only the directive and reads the rest as a statement). Write the directive on a line of its own, or edit it as text."
msgstr "Uma diretiva `%%{{` está na mesma linha que uma instrução ou um comentário (o Mermaid recorta somente a diretiva e lê o restante como uma instrução). Escreva a diretiva em uma linha própria ou edite-a como texto."

msgid "A `%%{{` inside a comment runs on to the next line ({line}). Mermaid does not read the lines in between, so the structured editor cannot handle it."
msgstr "Um `%%{{` dentro de um comentário continua até a próxima linha ({line}). O Mermaid não lê as linhas intermediárias, então o editor estruturado não consegue tratá-lo."

msgid "A `block` group is not closed with `end`. Edit it as text."
msgstr "Um grupo `block` não está fechado com `end`. Edite-o como texto."

msgid "A `section` without a name is not supported by the structured editor ({statement}). Give it a name, or edit it as text."
msgstr "Uma `section` sem nome não é suportada pelo editor estruturado ({statement}). Dê um nome a ela ou edite-a como texto."

msgid "A `section` without a name is not supported by the structured editor ({trimmed}). Give it a name, or edit it as text."
msgstr "Uma `section` sem nome não é suportada pelo editor estruturado ({trimmed}). Dê um nome a ela ou edite-a como texto."

msgid "A comment (`%%`) on a line of data `{name}` is lost in the structured editor. Move the comment to a line of its own outside the block, then open it again."
msgstr "Um comentário (`%%`) em uma linha de dados `{name}` é perdido no editor estruturado. Mova o comentário para uma linha própria fora do bloco e abra-o novamente."

msgid "A comment at the end of a frame line is lost in the structured editor ({line}). Move the comment to a line of its own, then open it again."
msgstr "Um comentário no fim de uma linha de quadro é perdido no editor estruturado ({line}). Mova o comentário para uma linha própria e abra-o novamente."

msgid "A comment in the middle or at the end of a statement is lost in the structured editor ({trimmed}). Move the comment to a line of its own, or edit it as text."
msgstr "Um comentário no meio ou no fim de uma instrução é perdido no editor estruturado ({trimmed}). Mova o comentário para uma linha própria ou edite-o como texto."

msgid "A comment inside a `curve` that spans several lines is lost in the structured editor ({trimmed}). Move the comment outside, or edit it as text."
msgstr "Um comentário dentro de uma `curve` que ocupa várias linhas é perdido no editor estruturado ({trimmed}). Mova o comentário para fora ou edite-o como texto."

msgid "A comment inside a statement that spans several lines is lost in the structured editor ({trimmed}). Move the comment outside the statement, or edit it as text."
msgstr "Um comentário dentro de uma instrução que ocupa várias linhas é perdido no editor estruturado ({trimmed}). Mova o comentário para fora da instrução ou edite-o como texto."

msgid "A comment must be a single line that starts with `%%`."
msgstr "Um comentário deve ser uma única linha que começa com `%%`."

msgid "A date cannot be written into `{other}` of `dateFormat`"
msgstr "Não é possível escrever uma data em `{other}` de `dateFormat`"

msgid "A deactivate has no target."
msgstr "Um deactivate não tem alvo."

msgid "A field of 0 bits cannot be written ({statement})."
msgstr "Não é possível escrever um campo de 0 bits ({statement})."

msgid "A frame whose name contains %% cannot be handled by the structured editor ({line})."
msgstr "Um quadro cujo nome contém %% não pode ser tratado pelo editor estruturado ({line})."

msgid "A group without an ID cannot have a label or a width. Give it an ID."
msgstr "Um grupo sem ID não pode ter rótulo nem largura. Dê um ID a ele."

msgid "A line of the Sankey diagram has a fourth column ({}). Write only the three columns `source,target,value`."
msgstr "Uma linha do diagrama Sankey tem uma quarta coluna ({}). Escreva somente as três colunas `source,target,value`."

msgid "A line that contains `end note` cannot be written in the text of a note ({trimmed}). Edit it as text."
msgstr "Uma linha que contém `end note` não pode ser escrita no texto de uma nota ({trimmed}). Edite-a como texto."

msgid "A multi-line `@{{` is supported only when its first line ends with `@{{` and the lines after it are written as `key: value`."
msgstr "Um `@{{` de várias linhas só é suportado quando a primeira linha termina com `@{{` e as linhas seguintes são escritas como `key: value`."

msgid "A node label cannot contain line breaks."
msgstr "O rótulo de um nó não pode conter quebras de linha."

msgid "A node name cannot contain line breaks."
msgstr "O nome de um nó não pode conter quebras de linha."

msgid "A space is needed after `:` ({trimmed})."
msgstr "É necessário um espaço depois de `:` ({trimmed})."

msgid "A statement follows `%%{{…}}%%` on the same line (line {}). Put the directive on its own line, then open it."
msgstr "Uma instrução vem depois de `%%{{…}}%%` na mesma linha (linha {}). Coloque a diretiva em uma linha própria e abra-o."

msgid "A statement follows `%%{{…}}%%` on the same line ({}). Put the directive and the statement on separate lines, then open the editor."
msgstr "Uma instrução vem depois de `%%{{…}}%%` na mesma linha ({}). Coloque a diretiva e a instrução em linhas separadas e abra o editor."

msgid "A {what} has an empty ID."
msgstr "Um(a) {what} tem um ID vazio."

msgid "Aggregation (left is whole)"
msgstr "Agregação (a esquerda é o todo)"

msgid "Aggregation (right is whole)"
msgstr "Agregação (a direita é o todo)"

msgid "Alternative (alt)"
msgstr "Alternativa (alt)"

msgid "An `accTitle` after `title` becomes the diagram's title, so `title` is not used."
msgstr "Um `accTitle` depois de `title` se torna o título do diagrama, então `title` não é usado."

msgid "An activate has no target."
msgstr "Um activate não tem alvo."

msgid "An arrow has no receiver."
msgstr "Uma seta não tem destinatário."

msgid "An arrow has no sender."
msgstr "Uma seta não tem remetente."

msgid "An empty `\"\"` after `-->` is not supported by the structured editor. Remove it, or edit it as text."
msgstr "Um `\"\"` vazio depois de `-->` não é suportado pelo editor estruturado. Remova-o ou edite-o como texto."

msgid "An empty label `[\"\"]` is not supported by the structured editor ({line}). Write a label or remove `[\"\"]`, then open it again."
msgstr "Um rótulo vazio `[\"\"]` não é suportado pelo editor estruturado ({line}). Escreva um rótulo ou remova `[\"\"]` e abra-o novamente."

msgid "An item outside any group is indented. Use “Move into the Group Above” to put it into a group."
msgstr "Um item fora de qualquer grupo está recuado. Use “Mover para dentro do grupo acima” para colocá-lo em um grupo."

msgid "Arrow"
msgstr "Seta"

msgid "Association (line only)"
msgstr "Associação (somente linha)"

msgid "Association (pointing left)"
msgstr "Associação (apontando para a esquerda)"

msgid "Association (pointing right)"
msgstr "Associação (apontando para a direita)"

msgid "At the same time (and)"
msgstr "Ao mesmo tempo (and)"

msgid "Automation (pcr)"
msgstr "Automação (pcr)"

msgid "Background (rect)"
msgstr "Fundo (rect)"

msgid "Bang )) (("
msgstr "Explosão )) (("

msgid "Because of how `%%{{…}}%%` or similar is written, what the structured editor reads does not match the diagram Mermaid draws. Edit it as text."
msgstr "Por causa da forma como `%%{{…}}%%` ou algo semelhante está escrito, o que o editor estruturado lê não corresponde ao diagrama que o Mermaid desenha. Edite-o como texto."

msgid "Both inline data and a data reference are written ({line}). Keep only one, then open it again."
msgstr "Foram escritos tanto dados embutidos quanto uma referência de dados ({line}). Mantenha somente um e abra-o novamente."

msgid "Bottom to top (BT)"
msgstr "De baixo para cima (BT)"

msgid "Box (participant)"
msgstr "Caixa (participant)"

msgid "Branch `{name}` is referenced by operation {list}. Delete it first, or point it at another branch."
msgid_plural "Branch `{name}` is referenced by operations {list}. Delete them first, or point them at another branch."
msgstr[0] "O branch `{name}` é referenciado pela operação {list}. Exclua-a primeiro ou aponte-a para outro branch."
msgstr[1] "O branch `{name}` é referenciado pelas operações {list}. Exclua-as primeiro ou aponte-as para outro branch."

msgid "Break (break)"
msgstr "Interrupção (break)"

msgid "Cannot delete {what}, because the dates of the tasks that refer to it cannot be calculated."
msgstr "Não é possível excluir {what}, porque as datas das tarefas que se referem a isso não podem ser calculadas."

msgid "Cannot delete {what}, because the dates of the tasks that refer to it cannot be calculated. The diagram cannot be drawn with its current content ({error}). Fix the fields outlined in red first."
msgstr "Não é possível excluir {what}, porque as datas das tarefas que se referem a isso não podem ser calculadas. O diagrama não pode ser desenhado com o conteúdo atual ({error}). Corrija primeiro os campos contornados em vermelho."

msgid "Cannot delete {what}."
msgstr "Não é possível excluir {what}."

msgid "Cannot delete {what}: the end of task `{task}`, which refers to it, would change. First rewrite the `after` / `until` of `{task}` as a date."
msgstr "Não é possível excluir {what}: o fim da tarefa `{task}`, que se refere a isso, mudaria. Primeiro reescreva o `after` / `until` de `{task}` como uma data."

msgid "Cannot delete {what}: the end of task `{}` would have to be written as a date, which is not possible ({error})."
msgstr "Não é possível excluir {what}: o fim da tarefa `{}` teria de ser escrito como uma data, o que não é possível ({error})."

msgid "Cannot delete {what}: the start of task `{task}`, which refers to it, would change. First rewrite the `after` / `until` of `{task}` as a date."
msgstr "Não é possível excluir {what}: o início da tarefa `{task}`, que se refere a isso, mudaria. Primeiro reescreva o `after` / `until` de `{task}` como uma data."

msgid "Cannot delete {what}: the start of task `{}` would have to be written as a date, which is not possible ({error})."
msgstr "Não é possível excluir {what}: o início da tarefa `{}` teria de ser escrito como uma data, o que não é possível ({error})."

msgid "Central connections written with `()` are not supported by the structured editor. Edit it as text."
msgstr "Conexões centrais escritas com `()` não são suportadas pelo editor estruturado. Edite-o como texto."

msgid "Choice (option)"
msgstr "Opção (option)"

msgid "Choice <<choice>>"
msgstr "Escolha <<choice>>"

msgid "Choose the commit to cherry-pick."
msgstr "Escolha o commit para fazer cherry-pick."

msgid "Circle (( ))"
msgstr "Círculo (( ))"

msgid "Circle ((point))"
msgstr "Círculo ((ponto))"

msgid "Circle end"
msgstr "Extremidade em círculo"

msgid "Close a one-line `namespace` with `}}` on the same line ({statement}). Split it into several lines, or edit it as text."
msgstr "Feche um `namespace` de uma linha com `}}` na mesma linha ({statement}). Divida-o em várias linhas ou edite-o como texto."

msgid "Close the arrow block in `{line}` with `]>`."
msgstr "Feche o bloco de seta em `{line}` com `]>`."

msgid "Close the arrow direction in `{line}` with `)`."
msgstr "Feche a direção da seta em `{line}` com `)`."

msgid "Cloud"
msgstr "Nuvem"

msgid "Cloud ) ("
msgstr "Nuvem ) ("

msgid "Command (cmd)"
msgstr "Comando (cmd)"

msgid "Comments at the end of a statement (from `#` or `%%` onward) would be lost in the structured editor ({}). Move the comment to its own line, or enclose values that contain `#` in `\"`."
msgstr "Comentários no fim de uma instrução (a partir de `#` ou `%%`) seriam perdidos no editor estruturado ({}). Mova o comentário para uma linha própria ou coloque entre `\"` os valores que contêm `#`."

msgid "Comments inside an attribute block would be lost in the structured editor ({statement}). Move the comment out of the block, or edit it as text."
msgstr "Comentários dentro de um bloco de atributos seriam perdidos no editor estruturado ({statement}). Mova o comentário para fora do bloco ou edite-o como texto."

msgid "Commit `{id}` is referenced by the cherry-pick at operation {list}. Delete it first."
msgid_plural "Commit `{id}` is referenced by the cherry-picks at operations {list}. Delete them first."
msgstr[0] "O commit `{id}` é referenciado pelo cherry-pick na operação {list}. Exclua-o primeiro."
msgstr[1] "O commit `{id}` é referenciado pelos cherry-picks nas operações {list}. Exclua-os primeiro."

msgid "Component diagram"
msgstr "Diagrama de componentes"

msgid "Composite states are nested too deeply. Edit it as text."
msgstr "Os estados compostos estão aninhados profundamente demais. Edite-o como texto."

msgid "Composition (left is whole)"
msgstr "Composição (a esquerda é o todo)"

msgid "Composition (right is whole)"
msgstr "Composição (a direita é o todo)"

msgid "Container diagram"
msgstr "Diagrama de contêineres"

msgid "Contains (contains)"
msgstr "Contém (contains)"

msgid "Context diagram"
msgstr "Diagrama de contexto"

msgid "Copies (copies)"
msgstr "Copia (copies)"

msgid "Could not determine which item the end-of-line comment ({comment}) belongs to. Move the comment to its own line, or edit it as text."
msgstr "Não foi possível determinar a qual item pertence o comentário de fim de linha ({comment}). Mova o comentário para uma linha própria ou edite-o como texto."

msgid "Could not find the details of participant `{model_id}`."
msgstr "Não foi possível encontrar os detalhes do participante `{model_id}`."

msgid "Could not find the entity on the left side of a relationship."
msgstr "Não foi possível encontrar a entidade no lado esquerdo de um relacionamento."

msgid "Could not find the entity on the right side of a relationship."
msgstr "Não foi possível encontrar a entidade no lado direito de um relacionamento."

msgid "Could not read `{other}` as a requirement field."
msgstr "Não foi possível ler `{other}` como um campo de requisito."

msgid "Could not read `{other}` as an element field."
msgstr "Não foi possível ler `{other}` como um campo de elemento."

msgid "Could not read `{rest}` after the `)` of `{statement}`."
msgstr "Não foi possível ler `{rest}` depois do `)` de `{statement}`."

msgid "Could not read `{rest}` after the `class` statement ({statement})."
msgstr "Não foi possível ler `{rest}` depois da instrução `class` ({statement})."

msgid "Could not read `{rest}` after the relation ({statement})."
msgstr "Não foi possível ler `{rest}` depois da relação ({statement})."

msgid "Could not read `{statement}` as a C4 diagram statement. Edit it as text."
msgstr "Não foi possível ler `{statement}` como uma instrução de diagrama C4. Edite-o como texto."

msgid "Could not read `{statement}` as a class assignment."
msgstr "Não foi possível ler `{statement}` como uma atribuição de classe."

msgid "Could not read `{statement}` as a relationship."
msgstr "Não foi possível ler `{statement}` como um relacionamento."

msgid "Could not read `{statement}` as a requirement diagram statement. Edit it as text."
msgstr "Não foi possível ler `{statement}` como uma instrução de diagrama de requisitos. Edite-o como texto."

msgid "Could not read `{statement}` as an item of a block (`{opening}`)."
msgstr "Não foi possível ler `{statement}` como um item de um bloco (`{opening}`)."

msgid "Could not read `{statement}`. A class diagram statement is one of `class A`, `A : member`, `A --> B`, `<<annotation>> A` and `note for A \"…\"`."
msgstr "Não foi possível ler `{statement}`. Uma instrução de diagrama de classes é uma destas: `class A`, `A : member`, `A --> B`, `<<annotation>> A` e `note for A \"…\"`."

msgid "Could not read `{trailing}` after the `\"` of `{input}`."
msgstr "Não foi possível ler `{trailing}` depois do `\"` de `{input}`."

msgid "Could not read `{value}` of `{name}` ({line}). {number_rule}"
msgstr "Não foi possível ler `{value}` de `{name}` ({line}). {number_rule}"

msgid "Could not read `{}` after `<<annotation>> ClassName` ({statement})."
msgstr "Não foi possível ler `{}` depois de `<<annotation>> ClassName` ({statement})."

msgid "Could not read `{}` after `]` ({statement})."
msgstr "Não foi possível ler `{}` depois de `]` ({statement})."

msgid "Could not read `{}` after axis `{id}` ({line})."
msgstr "Não foi possível ler `{}` depois do eixo `{id}` ({line})."

msgid "Could not read `{}` after the note ({statement})."
msgstr "Não foi possível ler `{}` depois da nota ({statement})."

msgid "Could not read `{}` after the quotes ({statement})."
msgstr "Não foi possível ler `{}` depois das aspas ({statement})."

msgid "Could not read `{}` after the range ({statement})."
msgstr "Não foi possível ler `{}` depois do intervalo ({statement})."

msgid "Could not read `{}` as a risk."
msgstr "Não foi possível ler `{}` como um risco."

msgid "Could not read `{}` as a verification method."
msgstr "Não foi possível ler `{}` como um método de verificação."

msgid "Could not read `{}` in `{statement}`."
msgstr "Não foi possível ler `{}` em `{statement}`."

msgid "Could not read `{}` the way Mermaid does. Edit it as text."
msgstr "Não foi possível ler `{}` da mesma forma que o Mermaid. Edite-o como texto."

msgid "Could not read both ends of `{statement}`."
msgstr "Não foi possível ler as duas extremidades de `{statement}`."

msgid "Could not read both ends of `{}`."
msgstr "Não foi possível ler as duas extremidades de `{}`."

msgid "Could not read the ID of an edge end ({statement})."
msgstr "Não foi possível ler o ID de uma extremidade de aresta ({statement})."

msgid "Could not read the ID of the junction ({statement})."
msgstr "Não foi possível ler o ID da junção ({statement})."

msgid "Could not read the ID of the service ({statement})."
msgstr "Não foi possível ler o ID do serviço ({statement})."

msgid "Could not read the alias of `{text}` (write the alias as the first argument, without `$…=`)."
msgstr "Não foi possível ler o alias de `{text}` (escreva o alias como o primeiro argumento, sem `$…=`)."

msgid "Could not read the axis ID ({line})."
msgstr "Não foi possível ler o ID do eixo ({line})."

msgid "Could not read the class name ({statement})."
msgstr "Não foi possível ler o nome da classe ({statement})."

msgid "Could not read the class name `{keyword}` applies to ({statement}). Names enclosed in `` ` `` are not supported by the structured editor. Edit it as text."
msgstr "Não foi possível ler o nome da classe a que `{keyword}` se aplica ({statement}). Nomes entre `` ` `` não são suportados pelo editor estruturado. Edite-o como texto."

msgid "Could not read the curve ID ({line})."
msgstr "Não foi possível ler o ID da curva ({line})."

msgid "Could not read the date and time"
msgstr "Não foi possível ler a data e a hora"

msgid "Could not read the end `{end}` ({statement})."
msgstr "Não foi possível ler o fim `{end}` ({statement})."

msgid "Could not read the group ID ({statement})."
msgstr "Não foi possível ler o ID do grupo ({statement})."

msgid "Could not read the group ID after `in` ({statement})."
msgstr "Não foi possível ler o ID do grupo depois de `in` ({statement})."

msgid "Could not read the one-line `namespace` ({statement})."
msgstr "Não foi possível ler o `namespace` de uma linha ({statement})."

msgid "Could not read the position of a Note."
msgstr "Não foi possível ler a posição de uma Note."

msgid "Could not read the range `{min} --> {max}` as numbers ({statement})."
msgstr "Não foi possível ler o intervalo `{min} --> {max}` como números ({statement})."

msgid "Could not read the start `{text}` ({statement})."
msgstr "Não foi possível ler o início `{text}` ({statement})."

msgid "Could not read the target of the style assignment ({text})."
msgstr "Não foi possível ler o alvo da atribuição de estilo ({text})."

msgid "Could not read the targets `{}` of `{keyword}`. Write IDs made of ASCII letters, digits, `_` and `-`, separated by spaces."
msgstr "Não foi possível ler os alvos `{}` de `{keyword}`. Escreva IDs formados por letras ASCII, dígitos, `_` e `-`, separados por espaços."

msgid "Could not read the task fields `{}` ({statement}). Of `tags, ID, start, end`, write 1 to 3 fields, not counting the tags."
msgstr "Não foi possível ler os campos da tarefa `{}` ({statement}). De `tags, ID, start, end`, escreva de 1 a 3 campos, sem contar as tags."

msgid "Could not read the value `{entry}` of curve `{curve}` ({line}). {number_rule}"
msgstr "Não foi possível ler o valor `{entry}` da curva `{curve}` ({line}). {number_rule}"

msgid "Could not read the x-axis ticks ({statement})."
msgstr "Não foi possível ler as marcações do eixo x ({statement})."

msgid "Could not read the y-axis range ({statement}). Write it as `0 --> 100`."
msgstr "Não foi possível ler o intervalo do eixo y ({statement}). Escreva-o como `0 --> 100`."

msgid "Could not read this as a Gantt chart line ({statement}). Write it as `task name :start, end`."
msgstr "Não foi possível ler isto como uma linha de gráfico de Gantt ({statement}). Escreva-a como `task name :start, end`."

msgid "Could not read this as a kanban node ({node_part}). Edit it as text."
msgstr "Não foi possível ler isto como um nó de Kanban ({node_part}). Edite-o como texto."

msgid "Could not read this as a radar chart statement ({trimmed}). Edit it as text."
msgstr "Não foi possível ler isto como uma instrução de gráfico de radar ({trimmed}). Edite-o como texto."

msgid "Could not read this as a style assignment ({text})."
msgstr "Não foi possível ler isto como uma atribuição de estilo ({text})."

msgid "Could not read this as an XY chart statement ({statement}). Edit it as text."
msgstr "Não foi possível ler isto como uma instrução de gráfico XY ({statement}). Edite-o como texto."

msgid "Cross end"
msgstr "Extremidade em X"

msgid "Curve `{id}` mixes values with and without axis names ({line})."
msgstr "A curva `{id}` mistura valores com e sem nomes de eixo ({line})."

msgid "Curve `{}` has a value for `{axis}`, but there is no such axis ({line}). Mermaid does not draw this value, so remove it or add the axis, then open it again."
msgstr "A curva `{}` tem um valor para `{axis}`, mas esse eixo não existe ({line}). O Mermaid não desenha esse valor; remova-o ou adicione o eixo e abra-o novamente."

msgid "Curve `{}` has no value for axis `{}` ({line})."
msgstr "A curva `{}` não tem valor para o eixo `{}` ({line})."

msgid "Curve `{}` has no values. Write at least one value (Mermaid does not accept an empty curve)."
msgstr "A curva `{}` não tem valores. Escreva pelo menos um valor (o Mermaid não aceita uma curva vazia)."

msgid "Curve `{}` has two values for axis `{axis}` ({line}). Mermaid draws only the first one, so keep one, then open it again."
msgstr "A curva `{}` tem dois valores para o eixo `{axis}` ({line}). O Mermaid desenha somente o primeiro; mantenha um e abra-o novamente."

msgid "Curve `{}` writes its values with axis names, but there are no axes."
msgstr "A curva `{}` escreve os valores com nomes de eixo, mas não há eixos."

msgid "Curve `{}` writes its values with axis names, so every axis needs a value."
msgstr "A curva `{}` escreve os valores com nomes de eixo, então todo eixo precisa de um valor."

msgid "Curve `{}`: value {} is empty. Values in the middle cannot be empty (empty cells at the end count as no value)."
msgstr "Curva `{}`: o valor {} está vazio. Os valores do meio não podem estar vazios (células vazias no fim contam como sem valor)."

msgid "Cylinder [( )]"
msgstr "Cilindro [( )]"

msgid "Dashed (line only)"
msgstr "Tracejado (somente linha)"

msgid "Data `{name}` cannot be handled by the structured editor. Start it with the line `data {name} {{` and end it with a line that is only `}}` at the start (Mermaid does not accept a one-line block)."
msgstr "Os dados `{name}` não podem ser tratados pelo editor estruturado. Comece com a linha `data {name} {{` e termine com uma linha que contenha somente `}}` no início (o Mermaid não aceita um bloco de uma linha)."

msgid "Data `{name}` has no contents."
msgstr "Os dados `{name}` não têm conteúdo."

msgid "Database"
msgstr "Banco de dados"

msgid "Database [(store)]"
msgstr "Banco de dados [(armazenar)]"

msgid "Dependency (pointing left)"
msgstr "Dependência (apontando para a esquerda)"

msgid "Dependency (pointing right)"
msgstr "Dependência (apontando para a direita)"

msgid "Deployment diagram"
msgstr "Diagrama de implantação"

msgid "Derives (derives)"
msgstr "Deriva (derives)"

msgid "Diagrams that use edge IDs (`{target}@`) are not supported by the structured editor ({statement}). Edit it as text."
msgstr "Diagramas que usam IDs de aresta (`{target}@`) não são suportados pelo editor estruturado ({statement}). Edite-o como texto."

msgid "Diagrams where the edge ID `{id}` is the same as a node or group ID are not supported by the structured editor. Edit it as text."
msgstr "Diagramas em que o ID de aresta `{id}` é igual a um ID de nó ou grupo não são suportados pelo editor estruturado. Edite-o como texto."

msgid "Diagrams with a class on an edge ({edge}) are not supported by the structured editor. Edit it as text."
msgstr "Diagramas com uma classe em uma aresta ({edge}) não são suportados pelo editor estruturado. Edite-o como texto."

msgid "Diagrams with a duplicate edge ID `{id}` are not supported by the structured editor. Edit it as text."
msgstr "Diagramas com um ID de aresta duplicado `{id}` não são suportados pelo editor estruturado. Edite-o como texto."

