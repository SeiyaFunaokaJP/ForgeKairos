msgid "requirementDiagram\n    %% requirement declares a requirement; element declares what satisfies it. Connect them with - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Users can log in\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Screen\"\n    }}\n    login_page - satisfies -> login"
msgstr "requirementDiagram\n    %% requirement declara um requisito; element declara o que o satisfaz. Ligue-os com - satisfies ->\n    requirement login {{\n        id: 1\n        text: \"Os usuários podem fazer login\"\n        risk: high\n        verifymethod: test\n    }}\n    element login_page {{\n        type: \"Tela\"\n    }}\n    login_page - satisfies -> login"

msgid "sankey-beta\n    %% Each line is source,target,amount. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    Power,Home,30\n    Power,Factory,50\n    Gas,Home,20\n    Gas,Factory,10"
msgstr "sankey-beta\n    %% Cada linha é origem,destino,quantidade. Escreva os nomes com letras e dígitos ASCII (o Mermaid não consegue ler nomes não ASCII)\n    Eletricidade,Casa,30\n    Eletricidade,Industria,50\n    Gas,Casa,20\n    Gas,Industria,10"

msgid "sequenceDiagram\n    %% ->> is a call and -->> a reply\n    participant User as User\n    participant App as App\n    User->>App: Request\n    App-->>User: Response\n    Note over App: Note"
msgstr "sequenceDiagram\n    %% ->> é uma chamada e -->> uma resposta\n    participant User as Usuário\n    participant App as Aplicativo\n    User->>App: Solicitação\n    App-->>User: Resposta\n    Note over App: Observação"

msgid "stateDiagram-v2\n    %% [*] is the start and the end. The text after : on an arrow is the event name\n    [*] --> Idle\n    Idle --> Running: Start\n    Running --> Idle: Finish\n    Running --> [*]: Abort"
msgstr "stateDiagram-v2\n    %% [*] é o início e o fim. O texto após : em uma seta é o nome do evento\n    [*] --> Idle\n    Idle --> Running: Iniciar\n    Running --> Idle: Concluir\n    Running --> [*]: Abortar"

msgid "the latest version"
msgstr "a versão mais recente"

msgid "timeline\n    title History\n    2024 : Planning\n    2025 : Development : Release\n    2026 : Operation"
msgstr "timeline\n    title Histórico\n    2024 : Planejamento\n    2025 : Desenvolvimento : Lançamento\n    2026 : Operação"

msgid "treeView-beta\n    %% Indentation shows the hierarchy\n    \"Project\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""
msgstr "treeView-beta\n    %% O recuo mostra a hierarquia\n    \"Projeto\"\n        \"src\"\n            \"main.rs\"\n            \"lib.rs\"\n        \"docs\"\n            \"README.md\""

msgid "treemap-beta\n    %% Indentation nests items. Give each leaf a value after :\n    \"Development\"\n        \"Design\": 30\n        \"Implementation\": 50\n    \"Operations\"\n        \"Maintenance\": 15\n        \"Monitoring\": 5"
msgstr "treemap-beta\n    %% O recuo aninha os itens. Dê a cada folha um valor após :\n    \"Desenvolvimento\"\n        \"Design\": 30\n        \"Implementação\": 50\n    \"Operações\"\n        \"Manutenção\": 15\n        \"Monitoramento\": 5"

msgid "type named by the language server"
msgstr "tipo nomeado pelo servidor de linguagem"

msgid "venn-beta\n    %% set defines a set and union names an overlap\n    title Overlapping Responsibilities\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"
msgstr "venn-beta\n    %% set define um conjunto e union dá nome a uma sobreposição\n    title Responsabilidades sobrepostas\n    set Front[\"Frontend\"]\n    set Back[\"Backend\"]\n    union Front,Back[\"API\"]"

msgid "xychart-beta\n    %% bar draws bars and line a line. Give as many values as the x-axis has items\n    title \"Monthly Sales\"\n    x-axis [\"Jan\", \"Feb\", \"Mar\", \"Apr\"]\n    y-axis \"Sales (USD thousands)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"
msgstr "xychart-beta\n    %% bar desenha barras e line uma linha. Forneça tantos valores quantos forem os itens do eixo x\n    title \"Vendas mensais\"\n    x-axis [\"jan\", \"fev\", \"mar\", \"abr\"]\n    y-axis \"Vendas (milhares de USD)\" 0 --> 100\n    bar [30, 45, 60, 80]\n    line [30, 45, 60, 80]"

