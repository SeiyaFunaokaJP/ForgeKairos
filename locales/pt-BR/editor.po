msgid "eventmodeling\n    %% tf number type name. ui is a screen, cmd a command, evt an event and rmo a read model. Write names in ASCII letters and digits (Mermaid cannot read non-ASCII names)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"
msgstr "eventmodeling\n    %% tf número tipo nome. ui é uma tela, cmd um comando, evt um evento e rmo um modelo de leitura. Escreva os nomes com letras e dígitos ASCII (o Mermaid não consegue ler nomes não ASCII)\n    tf 01 ui CartScreen\n    tf 02 cmd AddItem\n    tf 03 evt ItemAdded\n    tf 04 rmo CartItems ->> 03"

msgid "flowchart TD\n    %% [] is a step and {{}} a decision. |label| annotates a branch\n    start[Start] --> condition{{Condition}}\n    condition -->|Yes| work[Process]\n    condition -->|No| finish[End]\n    work --> finish"
msgstr "flowchart TD\n    %% [] é uma etapa e {{}} uma decisão. |rótulo| anota uma ramificação\n    start[Início] --> condition{{Condição}}\n    condition -->|Sim| work[Processar]\n    condition -->|Não| finish[Fim]\n    work --> finish"

