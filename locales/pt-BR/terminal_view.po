msgid "claude was not found on the remote host. Install it by running this command in a terminal on the remote host:\ncurl -fsSL https://claude.ai/install.sh | bash\nIt is installed to `~/.local/bin/claude` and can be launched from then on."
msgstr "claude não foi encontrado no host remoto. Instale-o executando este comando em um terminal no host remoto:\ncurl -fsSL https://claude.ai/install.sh | bash\nEle é instalado em `~/.local/bin/claude` e pode ser iniciado a partir de então."

msgid "no count"
msgstr "sem número"

msgid "npm was not found on PATH. Installing Claude Code requires Node.js. Install Node.js from https://nodejs.org/ and try again."
msgstr "npm não foi encontrado no PATH. A instalação do Claude Code requer o Node.js. Instale o Node.js de https://nodejs.org/ e tente novamente."

msgid "npm was not found on the remote host. Install Node.js in a terminal on the remote host and try again."
msgstr "npm não foi encontrado no host remoto. Instale o Node.js em um terminal no host remoto e tente novamente."

