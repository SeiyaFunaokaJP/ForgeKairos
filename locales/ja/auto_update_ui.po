msgid "Built on DeltaDB, so your threads and code stay in sync across machines and teammates."
msgstr "DeltaDB の上に作られているので、スレッドとコードがマシンとチームメンバーの間で同期されます。"

msgid "Introducing Delta"
msgstr "Delta のご紹介"

msgid "Learn More"
msgstr "詳細"

msgid "Made by the Zed team, with the same quality and performance"
msgstr "Zed チームが、同じ品質と性能で開発"

msgid "Pick up your thread on the web or your phone, without committing or pushing"
msgstr "コミットやプッシュをしなくても、Web やスマートフォンでスレッドの続きができます"

msgid "Try Delta"
msgstr "Delta を試す"

msgid "Updated to {app_name} {}"
msgstr "{app_name} {} に更新しました"

msgid "View Release Notes"
msgstr "リリースノートを表示"

msgid "Work with teammates and agents in the same thread, live or later"
msgstr "チームメンバーやエージェントと同じスレッドで、リアルタイムでも後からでも作業できます"
