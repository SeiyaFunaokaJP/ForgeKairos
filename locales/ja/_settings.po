msgstr "垂直スクロールバー"

msgctxt "settings"
msgid "Vertical Split Direction"
msgstr "垂直分割の方向"

msgctxt "settings"
msgid "View and manage agent skills installed globally or in project worktrees."
msgstr "グローバル、またはプロジェクトのワークツリーにインストールされたエージェントのスキルを確認・管理します。"

msgctxt "settings"
msgid "View, add, and remove agents connected through the Agent Client Protocol."
msgstr "Agent Client Protocol で接続するエージェントの確認・追加・削除を行います。"

msgctxt "settings"
msgid "View, add, configure, and remove Model Context Protocol servers."
msgstr "Model Context Protocol サーバーの確認・追加・設定・削除を行います。"

msgctxt "settings"
msgid "Vim"
msgstr "Vim"

