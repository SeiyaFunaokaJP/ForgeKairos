msgid "Agent Setup"
msgstr "エージェントの設定"

msgid "Automatically mark all new projects as trusted to unlock all Zed's features"
msgstr "新しいプロジェクトを自動的に信頼済みにして Zed のすべての機能を有効にする"

msgid "Automatically pull your settings from other editors"
msgstr "他のエディターから設定を自動的に取り込みます"

msgid "Base Keymap"
msgstr "ベースキーマップ"

msgid "Cancel"
msgstr "キャンセル"

msgid "Coming from Neovim? Use our first-class implementation of Vim Mode"
msgstr "Neovim から移行しますか? Zed の本格的な Vim モード実装を利用できます"

msgid "Could not find or load a {source} settings file"
msgstr "{source} の設定ファイルが見つからないか、読み込めませんでした"

msgid "Dark"
msgstr "ダーク"

msgid "Dismiss Hint"
msgstr "ヒントを閉じる"

msgid "Edit and save files directly in the results multibuffer!"
msgstr "検索結果のマルチバッファーで直接ファイルを編集・保存できます"

msgid "Failed to import settings. See log for details"
msgstr "設定のインポートに失敗しました。詳細はログを確認してください"

msgid "Finish Setup"
msgstr "セットアップを完了"

msgid "Help fix Zed by sending crash reports so we can fix critical issues fast"
msgstr "クラッシュレポートを送信して重大な問題の早期修正に協力する"

msgid "Help improve Zed by sending anonymous usage data"
msgstr "使用状況の匿名データを送信して Zed の改善に協力する"

msgid "Import"
msgstr "インポート"

msgid "Import Settings"
msgstr "設定のインポート"

msgid "Importing {} settings may overwrite your existing settings. Will import settings from {}"
msgstr "{} の設定をインポートすると、既存の設定が上書きされる場合があります。{} から設定をインポートします"

msgid "Install"
msgstr "インストール"

msgid "Install your favorite agents and start your first thread."
msgstr "よく使うエージェントをインストールして最初のスレッドを開始しましょう。"

msgid "Learn More"
msgstr "詳細"

msgid "Light"
msgstr "ライト"

msgid "Onboarding"
msgstr "初期設定"

msgid "Open Log"
msgstr "ログを開く"

msgid "Select a base keymap..."
msgstr "ベースキーマップを選択..."

msgid "Sign In"
msgstr "サインイン"

msgid "Signing In…"
msgstr "サインイン中…"

msgid "Start Free Trial"
msgstr "無料トライアルを開始"

msgid "System"
msgstr "システム"

msgid "The editor for what's next"
msgstr "次の時代のエディター"

msgid "Theme"
msgstr "テーマ"

msgid "Trust All Projects By Default"
msgstr "すべてのプロジェクトを既定で信頼する"

msgid "Vim Mode"
msgstr "Vim モード"

msgid "Welcome to Zed"
msgstr "Zed へようこそ"

msgid "Your {} settings were successfully imported."
msgstr "{} の設定をインポートしました。"

msgid "Zed can only allow services like language servers, project settings, and MCP servers to run after you mark a new project as trusted."
msgstr "新しいプロジェクトを信頼済みにするまで、Zed は言語サーバー・プロジェクト設定・MCP サーバーなどのサービスを実行しません。"
