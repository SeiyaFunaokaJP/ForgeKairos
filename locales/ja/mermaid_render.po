msgstr "引用符が閉じていません"

msgid "the space"
msgstr "空き"

msgid "the type `{value}` is not one of NORMAL / REVERSE / HIGHLIGHT"
msgstr "種類 `{value}` は NORMAL / REVERSE / HIGHLIGHT のどれでもありません"

msgid "there is no `:` after `{key}`"
msgstr "`{key}` の後に `:` がありません"

