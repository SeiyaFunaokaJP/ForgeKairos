msgstr "エッジ ({edge}) にクラスを付けた図は構造化編集に対応していません。テキストのまま編集してください。"

msgid "Diagrams with a duplicate edge ID `{id}` are not supported by the structured editor. Edit it as text."
msgstr "エッジ ID「{id}」が重複している図は構造化編集に対応していません。テキストのまま編集してください。"

msgid "Diamond { }"
msgstr "ひし形 { }"

msgid "Disk"
msgstr "ディスク"

msgid "Dotted arrow"
msgstr "点線の矢印"

msgid "Dotted arrow (reply)"
msgstr "点線の矢印 (応答)"

msgid "Dotted async"
msgstr "点線の非同期"

msgid "Dotted bidirectional"
msgstr "点線の両向き"

msgid "Dotted cross"
msgstr "点線の×印"

msgid "Dotted line"
msgstr "点線の線"

msgid "Double Circle ((( )))"
msgstr "二重円 ((( )))"

