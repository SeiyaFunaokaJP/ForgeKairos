msgstr "{detail}、分岐: {}"

msgid "{display_path}\nClick to open it in the editor and follow its end."
msgstr "{display_path}\nクリックするとエディターで開き、末尾に追従します。"

msgid "{heading}: {count} step (edit deeper nesting in the JSON file)"
msgid_plural "{heading}: {count} steps (edit deeper nesting in the JSON file)"
msgstr[0] "{heading}: {count} ステップ (これより深い入れ子は JSON で編集してください)"

msgid "{later} gets its value only after this step. Here it stays as written."
msgstr "{later} に値が入るのはこのステップより後です。ここでは書いたままの文字になります。"

msgid "{problem}. Fix it in terminal_sessions.json. Saving here keeps it as it was, but a macro that contains it can't be run."
msgstr "{problem}。terminal_sessions.json で直してください。ここで保存しても元の内容のまま残りますが、このステップを含むマクロは実行できません。"

msgid "{program} was not found on PATH."
msgstr "{program} が PATH 上に見つかりません。"

msgid "{steps} / until stopped"
msgstr "{steps} / 中止まで"

msgid "{steps} / ×{times}"
msgstr "{steps} / {times} 回"

