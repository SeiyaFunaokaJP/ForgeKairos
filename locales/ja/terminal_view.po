msgid "Using variables: write ${{name}} in the text to send, the expected text, the text to match, or the value to set, and it is replaced by the value when the macro runs. To send ${{ as text, write $${{."
msgstr "変数を使う: 送信する文字列・期待文字・判定する文字列・入れる値に ${{名前}} と書くと、実行時にその値に置き換わります。${{ を文字として送るときは $${{ と書きます。"

msgid "Value"
msgstr "値"

msgid "Value to set (${{variable}} allowed too)"
msgstr "入れる値 (${{変数}} も使えます)"

msgid "Variable name"
msgstr "変数名"

msgid "Variable to Check"
msgstr "調べる変数名"

msgid "Variables: none yet (create them with “Set Variable” or “Capture Into”)"
msgstr "変数: まだありません (「変数に設定」か「取り込む変数名」で作れます)"

msgid "Variables: {listed}"
msgstr "変数: {listed}"

msgid "Waits for the given number of seconds"
msgstr "指定した秒数だけ待ちます"

msgid "Waits until the given text appears in the output"
msgstr "指定した文字が出力に出るまで待ちます"

msgid "Waits up to {seconds} s for {} to appear in new output.{}"
msgstr "{}が新しく出力されるまで、最大 {seconds} 秒待ちます。{}"

msgid "Waits {seconds} s"
msgstr "{seconds} 秒待ちます"

msgid "Your changes haven't been saved. Discard them and open a new macro?"
msgstr "編集中の内容は保存されていません。破棄して新規マクロを開きますか？"

msgid "Your changes haven't been saved. Discard them and open “{}”?"
msgstr "編集中の内容は保存されていません。破棄して『{}』を開きますか？"

msgid "an empty string"
msgstr "空の文字列"

msgid "claude was not found on PATH. Run “terminal: install claude code” from the command palette first."
msgstr "claude が PATH 上に見つかりません。先に「Claude Code をインストール (公式コマンド)」を実行してください。"

msgid "claude was not found on the remote host. Install it by running this command in a terminal on the remote host:\ncurl -fsSL https://claude.ai/install.sh | bash\nIt is installed to `~/.local/bin/claude` and can be launched from then on."
msgstr "接続先のホストに claude が見つかりません。接続先のターミナルで次のコマンドを実行してインストールしてください。\ncurl -fsSL https://claude.ai/install.sh | bash\nインストールすると `~/.local/bin/claude` に入り、この起動から使えるようになります。"

msgid "no count"
msgstr "回数が未入力"

msgid "npm was not found on PATH. Installing Claude Code requires Node.js. Install Node.js from https://nodejs.org/ and try again."
msgstr "npm が PATH 上に見つかりません。Claude Code のインストールには Node.js が必要です。https://nodejs.org/ から Node.js をインストールしてから、もう一度お試しください。"

msgid "npm was not found on the remote host. Install Node.js in a terminal on the remote host and try again."
msgstr "接続先のホストに npm が見つかりません。接続先のターミナルで Node.js をインストールしてから、もう一度お試しください。"

msgid "repeat {}, step"
msgstr "繰り返し {} 回目のステップ"

msgid "repeat {}/{count}, step"
msgstr "繰り返し {}/{count} のステップ"

msgid "run {}, step {step}"
msgstr "{} 回目、ステップ {step}"

msgid "run {}/{count}, step {step}"
msgstr "{}/{count} 回目、ステップ {step}"

msgid "telnet was not found. Add “Telnet Client” from Windows “Optional features”, or run `Enable-WindowsOptionalFeature -Online -FeatureName TelnetClient` in PowerShell as an administrator."
msgstr "telnet が見つかりません。Windows の「オプション機能」から「Telnet クライアント」を追加するか、管理者権限の PowerShell で `Enable-WindowsOptionalFeature -Online -FeatureName TelnetClient` を実行してください。"

msgid "the expected text"
msgstr "期待文字"

msgid "the output after the last send"
msgstr "直前の送信のあとの出力"

msgid "the text to match"
msgstr "判定する文字列"

msgid "the value of ${{{name}}}"
msgstr "変数 ${{{name}}} の値"

msgid "the variable's value"
msgstr "変数の値"

msgid "the whole screen"
msgstr "画面全体"

msgid "until stopped"
msgstr "中止まで"

