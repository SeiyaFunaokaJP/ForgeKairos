# The descriptions of the settings file's JSON schema, keyed by their English text.
#
# Entries that zed-i18n also translates started from its zh-TW translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: zh-Hant\n"
"X-Language-Name: 繁體中文\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgctxt "settings schema"
msgid "A block that surrounds the following character"
msgstr "環繞下一個字元的方塊"

msgctxt "settings schema"
msgid "A box drawn around the following character"
msgstr "繪製於下一個字元周圍的外框"

msgctxt "settings schema"
msgid "A capability for an extension."
msgstr "擴充功能的一項權限。"

msgctxt "settings schema"
msgid "A custom Git hosting provider."
msgstr "自訂 Git 代管提供者。"

msgctxt "settings schema"
msgid "A custom line height, where 1.0 is the font's height. Must be at least 1.0."
msgstr "自訂行高，其中 1.0 代表字型高度。必須至少為 1.0。"

msgctxt "settings schema"
msgid "A custom offset in milliseconds for the tooltip show delay."
msgstr "工具提示顯示前的自訂延遲時間（毫秒）。"

msgctxt "settings schema"
msgid "A denser UI with tighter spacing and smaller elements."
msgstr "間距更緊湊、元素更小的密集 UI。"

msgctxt "settings schema"
msgid "A dynamic icon theme selection, which can change based on the [`ThemeMode`]."
msgstr "動態圖示佈景主題選擇，可根據 [`ThemeMode`] 變更。"

msgctxt "settings schema"
msgid "A dynamic theme selection, which can change based the [ThemeMode]."
msgstr "動態佈景主題選擇，可根據 [ThemeMode] 變更。"

msgctxt "settings schema"
msgid "A fixed pixel width for the git diff indicators."
msgstr "Git 差異指示器的固定像素寬度。"

msgctxt "settings schema"
msgid "A font size value in pixels, wrapping around `f32` for custom settings UI rendering."
msgstr "以像素為單位的字型大小值，使用 `f32` 封裝以供自訂設定 UI 轉譯。"

msgctxt "settings schema"
msgid "A git account a repository can commit and push as."
msgstr "儲存庫可用於提交和推送的 Git 帳戶。"

msgctxt "settings schema"
msgid "A less dense line height."
msgstr "較寬鬆的行高。"

msgctxt "settings schema"
msgid "A looser UI with more spacing and larger elements."
msgstr "間距更寬鬆、元素更大的舒適 UI。"

msgctxt "settings schema"
msgid "A map of log scopes to the desired log level.\nUseful for filtering out noisy logs or enabling more verbose logging.\n\nExample: {\"log\": {\"client\": \"warn\"}}"
msgstr "記錄範圍與所需記錄層級的對應。\n可用於篩除雜訊較多的記錄，或啟用更詳細的記錄。\n\n範例：{\"log\": {\"client\": \"warn\"}}"

msgctxt "settings schema"
msgid "A model `name` to substitute when calling tools, in case the primary model doesn't support tool calling."
msgstr "在主要模型不支援工具呼叫時，用於替代的模型 `name`。"

msgctxt "settings schema"
msgid "A named settings profile that can temporarily override settings."
msgstr "可暫時覆寫設定的具名設定檔。"

msgctxt "settings schema"
msgid "A non-negative size in pixels.\n\nValid range: 0.0 and up"
msgstr "以像素為單位的非負大小。\n\n有效範圍：0.0 以上"

msgctxt "settings schema"
msgid "A panel the default dock layout can name."
msgstr "預設停駐區版面配置可指定的面板。"

msgctxt "settings schema"
msgid "A static icon theme selection, represented by a single icon theme name."
msgstr "靜態圖示佈景主題選擇，以單一圖示佈景主題名稱表示。"

msgctxt "settings schema"
msgid "A static theme selection, represented by a single theme name."
msgstr "靜態佈景主題選擇，以單一佈景主題名稱表示。"

msgctxt "settings schema"
msgid "A value of `ui_language`, its own type so the settings UI can offer the\nlanguages found at run time instead of a text field."
msgstr "`ui_language` 的值。使用獨立的型別，讓設定 UI 可以提供執行時找到的語言，而非文字欄位。"

msgctxt "settings schema"
msgid "A vertical bar"
msgstr "垂直線"

msgctxt "settings schema"
msgid "AI providers whose \"your input may be retained and used for training\"\nwarning the user has explicitly acknowledged. The settings UI refuses to\ntake an API key for, or sign in to, an external provider that is not\nlisted here.\n\nEntries are provider ids. Agent (LLM) providers use their own ids\n(`anthropic`, `openai`, `zed.dev`, ...);\nedit prediction providers are prefixed to keep the two surfaces\nindependent (`edit_prediction:copilot`, `edit_prediction:codestral`, ...).\n\nDefault: []"
msgstr "使用者已明確同意「您的輸入可能會被保留並用於模型訓練」警告的 AI 提供者。對於未列在此處的外部提供者，設定 UI 會拒絕接受其 API 金鑰或登入。\n\n項目為提供者 ID。代理 (LLM) 提供者使用各自的 ID（`anthropic`、`openai`、`zed.dev`……）；編輯預測提供者會加上前置詞，讓兩者保持獨立（`edit_prediction:copilot`、`edit_prediction:codestral`……）。\n\n預設值：[]"

msgctxt "settings schema"
msgid "Activates the python virtual environment, if one is found, in the\nterminal's working directory (as resolved by the working_directory\nsetting). Set this to \"off\" to disable this behavior.\n\nDefault: on"
msgstr "若在終端機的工作目錄（由 working_directory 設定解析）中找到 Python 虛擬環境，則加以啟用。設為 \"off\" 可停用此行為。\n\n預設值：on"

msgctxt "settings schema"
msgid "Active pane styling settings."
msgstr "作用中窗格樣式設定。"

msgctxt "settings schema"
msgid "Added version control color."
msgstr "版本控制中已新增項目的色彩。"

msgctxt "settings schema"
msgid "Additional environment variables to pass to the agent.\n\nDefault: {}"
msgstr "要傳遞給代理的其他環境變數。\n\n預設值：{}"

msgctxt "settings schema"
msgid "Additional models with which to generate alternatives when performing inline assists."
msgstr "執行內嵌輔助時，用來產生替代建議的額外模型。"

msgctxt "settings schema"
msgid "Additional parameters for language model requests. When making a request\nto a model, parameters will be taken from the last entry in this list\nthat matches the model's provider and name. In each entry, both provider\nand model are optional, so that you can specify parameters for either\none.\n\nDefault: []"
msgstr "語言模型要求的其他參數。向模型發出要求時，會從此清單中符合模型提供者與名稱的最後一個項目取得參數。每個項目中的 provider 與 model 皆為選用，因此可以只針對其中一個指定參數。\n\n預設值：[]"

msgctxt "settings schema"
msgid "Adjusts indentation based on syntax context when typing.\nUses tree-sitter to analyze code structure and indent accordingly."
msgstr "輸入時依據語法上下文調整縮排。\n使用 tree-sitter 分析程式碼結構並據此縮排。"

msgctxt "settings schema"
msgid "Aliases for the command palette. When you type a key in this map,\nit will be assumed to equal the value.\n\nDefault: {}"
msgstr "命令選擇區的別名。當您輸入此對應中的鍵時，會視為等同於其值。\n\n預設值：{}"

msgctxt "settings schema"
msgid "Allow Zed to collect training data from open-source projects."
msgstr "允許 Zed 從開放原始碼專案收集訓練資料。"

msgctxt "settings schema"
msgid "Allow rewrapping anywhere."
msgstr "允許在任何位置重新換行。"

msgctxt "settings schema"
msgid "Allow sending requests to Anthropic models that cannot be offered with\nZero Data Retention.\n\nDefault: false"
msgstr "允許向無法以 Zero Data Retention 提供的 Anthropic 模型傳送要求。\n\n預設值：false"

msgctxt "settings schema"
msgid "Allows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\nPrettier formatting is disabled by default."
msgstr "可啟用/停用 Prettier 格式化，並設定在找不到專案層級的 Prettier 安裝時所使用的預設 Prettier。\nPrettier 格式化預設為停用。"

msgctxt "settings schema"
msgid "Always blink the cursor, ignoring the terminal mode."
msgstr "一律閃爍游標，忽略終端機模式。"

msgctxt "settings schema"
msgid "Always fetch document's words for completions along with LSP completions."
msgstr "一律在 LSP 自動完成的同時取得文件中的字詞作為自動完成項目。"

msgctxt "settings schema"
msgid "Always index the worktree."
msgstr "一律為工作樹建立索引。"

msgctxt "settings schema"
msgid "Always populate the search query with the word under the cursor."
msgstr "一律以游標下的單字填入搜尋查詢。"

msgctxt "settings schema"
msgid "Always prompt for confirmation (default behavior)."
msgstr "一律提示確認（預設行為）。"

msgctxt "settings schema"
msgid "Always reduce motion"
msgstr "一律減少動態效果"

msgctxt "settings schema"
msgid "Always scan symlinked directories"
msgstr "一律掃描符號連結資料夾"

msgctxt "settings schema"
msgid "Always show the minimap thumb."
msgstr "一律顯示縮圖捲動滑塊。"

msgctxt "settings schema"
msgid "Always show the minimap."
msgstr "一律顯示縮圖。"

msgctxt "settings schema"
msgid "Always show the scrollbar."
msgstr "一律顯示捲軸。"

msgctxt "settings schema"
msgid "Always show the sidebar on the left side."
msgstr "一律在左側顯示側邊欄。"

msgctxt "settings schema"
msgid "Always show the sidebar on the right side."
msgstr "一律在右側顯示側邊欄。"

msgctxt "settings schema"
msgid "Always start with an empty editor tab"
msgstr "一律以空白編輯器分頁啟動"

msgctxt "settings schema"
msgid "Always use a specific directory. This value will be shell expanded.\nIf this path is not a valid directory the terminal will default to\nthis platform's home directory  (if it can be found)."
msgstr "一律使用特定資料夾。此值會經過 Shell 展開。\n若此路徑不是有效的資料夾，終端機會預設使用此平台的主目錄（若能找到）。"

msgctxt "settings schema"
msgid "Always use this platform's home directory (if it can be found)."
msgstr "一律使用此平台的主目錄（如果可以找到的話）。"

msgctxt "settings schema"
msgid "Amount of indentation (in pixels) for nested items.\n\nDefault: 20"
msgstr "巢狀項目的縮排量（像素）。\n\n預設值：20"

msgctxt "settings schema"
msgid "An optional string to override the title of the terminal tab"
msgstr "用於覆寫終端機分頁標題的選用字串"

msgctxt "settings schema"
msgid "An underline that runs along the following character"
msgstr "沿著後面字元延伸的底線"

msgctxt "settings schema"
msgid "Any extra beta headers to provide when using the model."
msgstr "使用此模型時提供的額外 beta 標頭。"

msgctxt "settings schema"
msgid "Any key-value pairs added to this list will be added to the terminal's\nenvironment. Use `:` to separate multiple values.\n\nDefault: {}"
msgstr "加入此清單的所有鍵值組都會加入終端機的環境中。使用 `:` 分隔多個值。\n\n預設值：{}"

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"\""
msgstr "用於完成項目的 API URL。\n\n預設值：\"\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"http://localhost:11434\""
msgstr "用於完成項目的 API URL。\n\n預設值：\"http://localhost:11434\""

msgctxt "settings schema"
msgid "Api URL to use for completions.\n\nDefault: \"https://codestral.mistral.ai\""
msgstr "用於完成項目的 API URL。\n\n預設值：\"https://codestral.mistral.ai\""

msgctxt "settings schema"
msgid "Apply profile settings on top of Zed's default settings, ignoring user customizations."
msgstr "在 ForgeKairos 的預設設定之上套用設定檔設定，忽略使用者自訂。"

msgctxt "settings schema"
msgid "Apply profile settings on top of the user's current settings."
msgstr "在使用者目前設定之上套用設定檔設定。"

msgctxt "settings schema"
msgid "Ask a separate, cheap language model whether the operation is dangerous,\nand auto-approve it only when that model answers that it is safe.\nEvery rule that outranks the default — the built-in security\nrules and the user's `always_deny`/`always_confirm`/`always_allow`\npatterns — is applied first, so this only replaces the \"ask every time\"\nstep."
msgstr "詢問另一個低成本的語言模型該操作是否危險，只有在該模型回答安全時才自動核准。所有優先於預設值的規則（內建安全性規則，以及使用者的 `always_deny`/`always_confirm`/`always_allow` 模式）都會先套用，因此這只會取代「每次都詢問」的步驟。"

msgctxt "settings schema"
msgid "Auto-approve without prompting."
msgstr "自動核准而不提示確認。"

msgctxt "settings schema"
msgid "Auto-reject with an error."
msgstr "自動拒絕並回傳錯誤。"

msgctxt "settings schema"
msgid "Automatically detect the conda manager"
msgstr "自動偵測 conda 管理工具"

msgctxt "settings schema"
msgid "Autosave when focus changes."
msgstr "焦點變更時自動儲存。"

msgctxt "settings schema"
msgid "Autosave when the active window changes."
msgstr "使用中視窗變更時自動儲存。"

msgctxt "settings schema"
msgid "Background Color. Used for grounded surfaces like a panel or tab."
msgstr "背景顏色，用於面板或分頁等固定表面。"

msgctxt "settings schema"
msgid "Background Color. Used for the active state of a ghost element that should have the same background as the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "背景色彩。用於幽靈元素的作用中狀態，該元素應與其所在表面具有相同的背景。\n\n作用中狀態是在元素上按下滑鼠按鈕，或按下 Return 鍵或其他啟動鍵時觸發。"

msgctxt "settings schema"
msgid "Background Color. Used for the active state of an element that should have a different background than the surface it's on.\n\nActive states are triggered by the mouse button being pressed down on an element, or the Return button or other activator being pressed."
msgstr "背景色彩。用於元素的作用中狀態，該元素應與其所在表面具有不同的背景。\n\n作用中狀態是在元素上按下滑鼠按鈕，或按下 Return 鍵或其他啟動鍵時觸發。"

msgctxt "settings schema"
msgid "Background Color. Used for the app background and blank panels or windows."
msgstr "背景顏色，用於應用程式背景及空白面板或視窗。"

msgctxt "settings schema"
msgid "Background Color. Used for the area that shows where a dragged element will be dropped."
msgstr "背景顏色，用於顯示拖曳元素放置位置的區域。"

msgctxt "settings schema"
msgid "Background Color. Used for the background of an element that should have a different background than the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have the same background as the surface it's on, use `ghost_element_background`."
msgstr "背景色彩。用於應與其所在表面具有不同背景之元素的背景。\n\n元素可能包括：按鈕、輸入欄位、核取方塊、選項按鈕……\n\n若元素應與其所在表面具有相同的背景，請使用 `ghost_element_background`。"

msgctxt "settings schema"
msgid "Background Color. Used for the background of selections in a UI element."
msgstr "背景顏色，用於 UI 元素中已選取項目的背景。"

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of a ghost element that should have the same background as the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "背景色彩。用於幽靈元素的停用狀態，該元素應與其所在表面具有相同的背景。\n\n當使用者無法與元素互動時（例如停用的按鈕或輸入欄位），會顯示停用狀態。"

msgctxt "settings schema"
msgid "Background Color. Used for the disabled state of an element that should have a different background than the surface it's on.\n\nDisabled states are shown when a user cannot interact with an element, like a disabled button or input."
msgstr "背景色彩。用於元素的停用狀態，該元素應與其所在表面具有不同的背景。\n\n當使用者無法與元素互動時（例如停用的按鈕或輸入欄位），會顯示停用狀態。"

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of a ghost element that should have the same background as the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "背景色彩。用於幽靈元素的暫留狀態，該元素應與其所在表面具有相同的背景。\n\n暫留狀態是在滑鼠進入元素，或在觸控螢幕上手指觸碰元素時觸發。"

msgctxt "settings schema"
msgid "Background Color. Used for the hover state of an element that should have a different background than the surface it's on.\n\nHover states are triggered by the mouse entering an element, or a finger touching an element on a touch screen."
msgstr "背景色彩。用於元素的暫留狀態，該元素應與其所在表面具有不同的背景。\n\n暫留狀態是在滑鼠進入元素，或在觸控螢幕上手指觸碰元素時觸發。"

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of a ghost element that should have the same background as the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "背景色彩。用於幽靈元素的選取狀態，該元素應與其所在表面具有相同的背景。\n\n選取狀態是在使用者選取（或「啟動」）元素時觸發。\n\n例如已勾選的核取方塊、已切換為開啟的切換按鈕等。"

msgctxt "settings schema"
msgid "Background Color. Used for the selected state of an element that should have a different background than the surface it's on.\n\nSelected states are triggered by the element being selected (or \"activated\") by the user.\n\nThis could include a selected checkbox, a toggleable button that is toggled on, etc."
msgstr "背景色彩。用於元素的選取狀態，該元素應與其所在表面具有不同的背景。\n\n選取狀態是在使用者選取（或「啟動」）元素時觸發。\n\n例如已勾選的核取方塊、已切換為開啟的切換按鈕等。"

msgctxt "settings schema"
msgid "Background color for Vim Helix Normal mode indicator."
msgstr "Vim Helix Normal 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim Helix Select mode indicator."
msgstr "Vim Helix Select 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim Insert mode indicator."
msgstr "Vim Insert 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim Normal mode indicator."
msgstr "Vim Normal 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim Replace mode indicator."
msgstr "Vim Replace 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim Visual Block mode indicator."
msgstr "Vim Visual Block 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim Visual Line mode indicator."
msgstr "Vim Visual Line 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim Visual mode indicator."
msgstr "Vim Visual 模式指示器的背景顏色。"

msgctxt "settings schema"
msgid "Background color for Vim yank highlight."
msgstr "Vim 複製醒目提示的背景顏色。"

msgctxt "settings schema"
msgid "Background color for row highlights of \"ours\" regions in merge conflicts."
msgstr "合併衝突中「ours」區域的列醒目提示背景顏色。"

msgctxt "settings schema"
msgid "Background color for row highlights of \"theirs\" regions in merge conflicts."
msgstr "合併衝突中「theirs」區域的列醒目提示背景顏色。"

msgctxt "settings schema"
msgid "Background color. Used for elevated surfaces, like a context menu, popup, or dialog."
msgstr "背景顏色，用於內容功能表、彈出視窗或對話方塊等浮出表面。"

msgctxt "settings schema"
msgid "Background of active line of debugger"
msgstr "偵錯工具使用中行的背景"

msgctxt "settings schema"
msgid "Base key bindings scheme. Base keymaps can be overridden with user keymaps.\n\nDefault: Zed"
msgstr "基礎按鍵繫結配置。基礎按鍵對應可由使用者按鍵對應覆寫。\n\n預設值：Zed"

msgctxt "settings schema"
msgid "Be smart and search for ignored when called from a gitignored worktree"
msgstr "從被 Git 忽略的工作樹呼叫時，自動搜尋被忽略的檔案"

msgctxt "settings schema"
msgid "Behave as a regular buffer and select the whole word."
msgstr "如同一般緩衝區，選取整個字詞。"

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text after the cursor is a suffix of the completion, and like\n`\"insert\"` otherwise."
msgstr "若游標後的文字是完成項目的後綴，則行為如同 `\"replace\"`，否則行為如同 `\"insert\"`。"

msgctxt "settings schema"
msgid "Behaves like `\"replace\"` if the text that would be replaced is a subsequence of the completion text,\nand like `\"insert\"` otherwise."
msgstr "若要被取代的文字是完成項目文字的子序列，則行為如同 `\"replace\"`，否則行為如同 `\"insert\"`。"

msgctxt "settings schema"
msgid "Black ANSI terminal color."
msgstr "終端機黑色 ANSI 顏色。"

msgctxt "settings schema"
msgid "Block cursor that surrounds the character."
msgstr "包圍字元的方塊游標。"

msgctxt "settings schema"
msgid "Blue ANSI terminal color."
msgstr "藍色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Border Color. Used for the border that shows where a dragged element will be dropped."
msgstr "框線色彩，用於顯示拖曳元素放置位置的框線。"

msgctxt "settings schema"
msgid "Border color. Used for deemphasized borders, like a visual divider between two sections"
msgstr "框線色彩，用於不強調的框線，例如兩個區段之間的視覺分隔線"

msgctxt "settings schema"
msgid "Border color. Used for disabled elements, like a disabled input or button."
msgstr "框線色彩，用於已停用的元素，例如已停用的輸入欄或按鈕。"

msgctxt "settings schema"
msgid "Border color. Used for focused elements, like keyboard focused list item."
msgstr "框線色彩，用於聚焦的元素，例如鍵盤聚焦的清單項目。"

msgctxt "settings schema"
msgid "Border color. Used for most borders, is usually a high contrast color."
msgstr "框線色彩，用於大多數框線，通常為高對比色彩。"

msgctxt "settings schema"
msgid "Border color. Used for selected elements, like an active search filter or selected checkbox."
msgstr "框線色彩，用於已選取的元素，例如啟用中的搜尋篩選器或已選取的核取方塊。"

msgctxt "settings schema"
msgid "Border color. Used for transparent borders. Used for placeholder borders when an element gains a border on state change."
msgstr "框線色彩，用於透明框線。在元素因狀態變更而獲得框線時，用作預留位置框線。"

msgctxt "settings schema"
msgid "Bright black ANSI terminal color."
msgstr "亮黑色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Bright blue ANSI terminal color."
msgstr "亮藍色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Bright cyan ANSI terminal color."
msgstr "亮青色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Bright green ANSI terminal color."
msgstr "亮綠色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Bright magenta ANSI terminal color."
msgstr "亮洋紅色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Bright red ANSI terminal color."
msgstr "亮紅色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Bright terminal foreground color."
msgstr "終端機亮色前景色。"

msgctxt "settings schema"
msgid "Bright white ANSI terminal color."
msgstr "亮白色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Bright yellow ANSI terminal color."
msgstr "亮黃色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Byte budget for a repository map prepended to the agent's system prompt,\nright after the list of project root directories. `0` disables it.\nValues above 32768 are clamped to 32768.\n\nDefault: 0"
msgstr "在代理系統提示中，緊接在專案根資料夾清單之後加入之儲存庫地圖的位元組 budget。`0` 表示停用。大於 32768 的值會限制為 32768。\n\n預設值：0"

msgctxt "settings schema"
msgid "Callees left out of the list of a function's callees, such as logging\nand assertion macros. A row at the end counts them and shows them on\nrequest.\n\nDefault: [\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"
msgstr "要從函式的被呼叫端清單中排除的被呼叫端，例如記錄與判斷提示巨集。最後一列會顯示其數量，並可依要求顯示。\n\n預設值：[\"printk\", \"pr_info\", \"pr_err\", \"pr_debug\", \"printf\", \"fprintf\", \"assert\", \"BUG_ON\", \"WARN_ON\", \"likely\", \"unlikely\"]"

msgctxt "settings schema"
msgid "Case-insensitive natural sort with lowercase preferred in ties.\nNumbers in file names are compared by value (e.g., `file2` before `file10`)."
msgstr "不區分大小寫的自然排序，同序時小寫優先。\n檔案名稱中的數字依數值比較（例如 `file2` 排在 `file10` 之前）。"

msgctxt "settings schema"
msgid "Centered layout related setting (left/right)."
msgstr "置中版面配置相關設定（左/右）。"

msgctxt "settings schema"
msgid "Centered layout related settings."
msgstr "置中版面配置相關設定。"

msgctxt "settings schema"
msgid "Character counts at which to show wrap guides in the editor.\n\nDefault: []"
msgstr "在編輯器中顯示換行輔助線的字元數。\n\n預設值：[]"

msgctxt "settings schema"
msgid "Close the window when there are no tabs"
msgstr "沒有分頁時關閉視窗"

msgctxt "settings schema"
msgid "Color for added words in word diffs."
msgstr "單字差異中新增單字的顏色。"

msgctxt "settings schema"
msgid "Color for deleted words in word diffs."
msgstr "單字差異中刪除單字的顏色。"

msgctxt "settings schema"
msgid "Color used to accent some of the debuggers elements\nOnly accent breakpoint & breakpoint related symbols right now"
msgstr "用於強調部分偵錯工具元素的色彩。\n目前只強調中斷點與中斷點相關的符號。"

msgctxt "settings schema"
msgid "Comfortable spacing of entries."
msgstr "項目的寬鬆間距。"

msgctxt "settings schema"
msgid "Command to automatically run when Zed creates a Terminal Thread shell in the agent panel.\nThe command is sent to the shell as if typed, so it is interpreted by your\nconfigured shell (including on Windows and remote/WSL projects).\nAn empty string disables this behavior.\n\nDefault: \"\""
msgstr "ForgeKairos 在代理面板中建立終端機會話 Shell 時自動執行的命令。\n命令會如同手動輸入般傳送至 Shell，因此由您設定的 Shell 解譯（包括 Windows 以及遠端/WSL 專案）。\n空字串會停用此行為。\n\n預設值：\"\""

msgctxt "settings schema"
msgid "Common language server settings."
msgstr "通用語言伺服器設定。"

msgctxt "settings schema"
msgid "Configuration for Debugger-related features"
msgstr "偵錯工具相關功能的設定"

msgctxt "settings schema"
msgid "Configuration for Diagnostics-related features."
msgstr "診斷相關功能的設定。"

msgctxt "settings schema"
msgid "Configuration for Git-related features"
msgstr "Git 相關功能的設定"

msgctxt "settings schema"
msgid "Configuration for Node-related features"
msgstr "Node 相關功能的設定"

msgctxt "settings schema"
msgid "Configuration for caching language model messages."
msgstr "語言模型訊息快取的設定。"

msgctxt "settings schema"
msgid "Configuration for developer-oriented instrumentation tools that collect\ndiagnostic data about a running Zed instance."
msgstr "開發人員導向之檢測工具的設定，這些工具會收集執行中 ForgeKairos 執行個體的診斷資料。"

msgctxt "settings schema"
msgid "Configuration for how direnv configuration should be loaded"
msgstr "direnv 設定的載入方式"

msgctxt "settings schema"
msgid "Configuration for language servers.\n\nThe following settings can be overridden for specific language servers:\n- initialization_options\n\nTo override settings for a language, add an entry for that language server's\nname to the lsp value.\nDefault: null"
msgstr "語言伺服器的設定。\n\n以下設定可針對特定語言伺服器覆寫：\n- initialization_options\n\n若要覆寫某語言的設定，請在 lsp 值中為該語言伺服器的名稱新增一個項目。\n預設值：null"

msgctxt "settings schema"
msgid "Configuration for session-related features"
msgstr "工作階段相關功能的設定"

msgctxt "settings schema"
msgid "Configuration for the collab panel visual settings."
msgstr "協作面板視覺設定的設定。"

msgctxt "settings schema"
msgid "Configuration for the performance profiler which collects timing data\nfor foreground and background executor tasks."
msgstr "效能分析工具的設定，此工具會收集前景與背景 executor 工作的計時資料。"

msgctxt "settings schema"
msgid "Configuration for the performance profiler, accessed via the\n`zed: open performance profiler` action."
msgstr "效能分析工具的設定，可透過 `zed: open performance profiler` 動作存取。"

msgctxt "settings schema"
msgid "Configuration of Anthropic's caching API."
msgstr "Anthropic 快取 API 的設定。"

msgctxt "settings schema"
msgid "Configuration of audio in Zed."
msgstr "ForgeKairos 中音訊的設定。"

msgctxt "settings schema"
msgid "Configuration of the terminal in Zed."
msgstr "ForgeKairos 中終端機的設定。"

msgctxt "settings schema"
msgid "Configuration of voice calls in Zed."
msgstr "ForgeKairos 中語音通話的設定。"

msgctxt "settings schema"
msgid "Configures what draws Zed's window decorations on Linux.\nThis setting has no effect on other platforms."
msgstr "設定在 Linux 上由誰繪製 ForgeKairos 的視窗裝飾。\n此設定在其他平台上沒有作用。"

msgctxt "settings schema"
msgid "Conflict version control color."
msgstr "版本控制中衝突項目的色彩。"

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `Authorization` header is sent and the\nprovider counts as configured without a keychain entry.\n\nDefault: false"
msgstr "針對不需要驗證的伺服器，不使用任何認證資訊連線。設定後，不會傳送 `Authorization` 標頭，且即使沒有金鑰鏈項目，提供者也會視為已設定。\n\n預設值：false"

msgctxt "settings schema"
msgid "Connect without any credential, for servers that require no\nauthentication. When set, no `x-api-key` header is sent and the provider\ncounts as configured without a keychain entry.\n\nDefault: false"
msgstr "針對不需要驗證的伺服器，不使用任何認證資訊連線。設定後，不會傳送 `x-api-key` 標頭，且即使沒有金鑰鏈項目，提供者也會視為已設定。\n\n預設值：false"

msgctxt "settings schema"
msgid "Contained between the left and right docks"
msgstr "包含在左右停駐區之間"

msgctxt "settings schema"
msgid "Continuation lines get 1 extra indent level beyond the original."
msgstr "後續行比原始行多縮排 1 層。"

msgctxt "settings schema"
msgid "Continuation lines get 2 extra indent levels beyond the original."
msgstr "後續行比原始行多縮排 2 層。"

msgctxt "settings schema"
msgid "Continuation lines match the original line's indentation."
msgstr "後續行與原始行的縮排相同。"

msgctxt "settings schema"
msgid "Continuation lines start at column 0."
msgstr "後續行從第 0 欄開始。"

msgctxt "settings schema"
msgid "Control what info is collected by Zed."
msgstr "控制 Zed 收集哪些資訊。"

msgctxt "settings schema"
msgid "Controls automatic indentation behavior when typing.\n\n- \"syntax_aware\": Adjusts indentation based on syntax context (default)\n- \"preserve_indent\": Preserves current line's indentation on new lines\n- \"none\": No automatic indentation\n\nDefault: syntax_aware"
msgstr "控制輸入時的自動縮排行為。\n\n- \"syntax_aware\"：依據語法上下文調整縮排（預設）\n- \"preserve_indent\"：在新行保留目前行的縮排\n- \"none\"：不自動縮排\n\n預設值：syntax_aware"

msgctxt "settings schema"
msgid "Controls how LSP completions are inserted.\n\nDefault: \"replace_suffix\""
msgstr "控制 LSP 完成項目的插入方式。\n\n預設值：\"replace_suffix\""

msgctxt "settings schema"
msgid "Controls how completions are processed for this language."
msgstr "控制此語言的自動完成處理方式。"

msgctxt "settings schema"
msgid "Controls how document's words are completed."
msgstr "控制文件中字詞的自動完成方式。"

msgctxt "settings schema"
msgid "Controls how line endings are normalized when a buffer is saved."
msgstr "控制緩衝區儲存時行尾序列的正規化方式。"

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting."
msgstr "控制語言伺服器的語意標記用於語法醒目提示的方式。"

msgctxt "settings schema"
msgid "Controls how semantic tokens from language servers are used for syntax highlighting.\n\nOptions:\n- \"off\": Do not request semantic tokens from language servers.\n- \"combined\": Use LSP semantic tokens together with tree-sitter highlighting.\n- \"full\": Use LSP semantic tokens exclusively, replacing tree-sitter highlighting.\n\nDefault: \"off\""
msgstr "控制如何將語言伺服器的語意標記用於語法醒目提示。\n\n選項：\n- \"off\"：不向語言伺服器要求語意標記。\n- \"combined\"：將 LSP 語意標記與 tree-sitter 醒目提示一起使用。\n- \"full\"：僅使用 LSP 語意標記，取代 tree-sitter 醒目提示。\n\n預設值：\"off\""

msgctxt "settings schema"
msgid "Controls how the editor handles the autoclosed characters.\nWhen set to `false`(default), skipping over and auto-removing of the closing characters\nhappen only for auto-inserted characters.\nOtherwise(when `true`), the closing characters are always skipped over and auto-removed\nno matter how they were inserted.\n\nDefault: false"
msgstr "控制編輯器如何處理自動關閉的字元。\n設為 `false`（預設）時，只有自動插入的結尾字元才會被略過與自動移除。\n否則（設為 `true` 時），無論結尾字元是如何插入的，一律會被略過與自動移除。\n\n預設值：false"

msgctxt "settings schema"
msgid "Controls how whitespace should be displayedin the editor."
msgstr "控制空白字元在編輯器中的顯示方式。"

msgctxt "settings schema"
msgid "Controls how words are completed.\nFor large documents, not all words may be fetched for completion.\n\nDefault: `fallback`"
msgstr "控制字組的完成方式。\n在大型文件中，可能不會擷取所有字組來完成。\n\n預設值：`fallback`"

msgctxt "settings schema"
msgid "Controls previous session restoration in freshly launched Zed instance.\nValues: empty_tab, last_workspace, last_session, launchpad\nDefault: last_session"
msgstr "控制新啟動的 ForgeKairos 執行個體如何還原前一個工作階段。\n值：empty_tab、last_workspace、last_session、launchpad\n預設值：last_session"

msgctxt "settings schema"
msgid "Controls the soft-wrapping behavior in the editor."
msgstr "控制編輯器的自動換行行為。"

msgctxt "settings schema"
msgid "Controls the source of document symbols used for outlines and breadcrumbs.\n\nOptions:\n- \"off\": Use tree-sitter queries to compute document symbols (default).\n- \"on\": Use the language server's `textDocument/documentSymbol` LSP response. When enabled, tree-sitter is not used for document symbols.\n\nDefault: \"off\""
msgstr "控制用於大綱與階層連結之文件符號的來源。\n\n選項：\n- \"off\"：使用 tree-sitter 查詢計算文件符號（預設）。\n- \"on\"：使用語言伺服器的 `textDocument/documentSymbol` LSP 回應。啟用時，不會使用 tree-sitter 計算文件符號。\n\n預設值：\"off\""

msgctxt "settings schema"
msgid "Controls the width of the git diff hunk indicators in the gutter."
msgstr "控制裝訂邊中 Git 差異區塊指示器的寬度。"

msgctxt "settings schema"
msgid "Controls when to use system clipboard."
msgstr "控制何時使用系統剪貼簿。"

msgctxt "settings schema"
msgid "Controls where the `editor::Rewrap` action is allowed for this language.\n\nNote: This setting has no effect in Vim mode, as rewrap is already\nallowed everywhere.\n\nDefault: \"in_comments\""
msgstr "控制此語言中允許使用 `editor::Rewrap` 動作的位置。\n\n注意：此設定在 Vim 模式中沒有作用，因為重新換行在任何位置都已允許。\n\n預設值：\"in_comments\""

msgctxt "settings schema"
msgid "Controls whether Zed collects training data when using Zed's Edit Predictions."
msgstr "控制使用 Zed 編輯預測功能時是否收集訓練資料。"

msgctxt "settings schema"
msgid "Controls whether Zed may collect training data when using Zed's Edit Predictions.\nData is only ever captured for files in projects that are detected as open source.\n\n- `\"default\"`: use the preference previously set via the status-bar toggle,\n  or false if no preference has been stored.\n- `\"yes\"`: allow data collection for files in open-source projects.\n- `\"no\"`: never allow data collection."
msgstr "控制使用 Zed 的編輯預測時，Zed 是否可以收集訓練資料。\n只會針對偵測為開放原始碼之專案中的檔案擷取資料。\n\n- `\"default\"`：使用先前透過狀態列切換設定的喜好設定，若未儲存任何喜好設定則為 false。\n- `\"yes\"`：允許收集開放原始碼專案中檔案的資料。\n- `\"no\"`：一律不允許收集資料。"

msgctxt "settings schema"
msgid "Controls whether Zed or the window manager or compositor draws window decorations on Linux.\n\nDefault: client"
msgstr "控制在 Linux 上由 ForgeKairos 還是由視窗管理員或合成器繪製視窗裝飾。\n\n預設值：client"

msgctxt "settings schema"
msgid "Controls whether edit predictions are shown immediately (true)\nor manually by triggering `editor::ShowEditPrediction` (false).\n\nDefault: true"
msgstr "控制編輯預測是立即顯示 (true)，還是透過觸發 `editor::ShowEditPrediction` 手動顯示 (false)。\n\n預設值：true"

msgctxt "settings schema"
msgid "Controls whether folding ranges from language servers are used instead of\ntree-sitter and indent-based folding.\n\nOptions:\n- \"off\": Use tree-sitter and indent-based folding (default).\n- \"on\": Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server.\n\nDefault: \"off\""
msgstr "控制是否使用語言伺服器的摺疊範圍，取代 tree-sitter 與以縮排為基礎的摺疊。\n\n選項：\n- \"off\"：使用 tree-sitter 與以縮排為基礎的摺疊（預設）。\n- \"on\"：盡可能使用 LSP 摺疊，伺服器未傳回結果時則改用 tree-sitter 與以縮排為基礎的摺疊。\n\n預設值：\"off\""

msgctxt "settings schema"
msgid "Controls which formatter should be used when formatting code. If there are multiple formatters, they are executed in the order of declaration."
msgstr "控制格式化程式碼時應使用哪種格式器。若有多個格式器，則依宣告順序執行。"

msgctxt "settings schema"
msgid "Controls which formatters should be used when formatting code."
msgstr "控制格式化程式碼時應使用哪些格式器。"

msgctxt "settings schema"
msgid "Cursor is a block like `█`."
msgstr "游標為方塊形，如 `█`。"

msgctxt "settings schema"
msgid "Cursor is a hollow box like `▯`."
msgstr "游標為空心方塊形，如 `▯`。"

msgctxt "settings schema"
msgid "Cursor is a vertical bar like `⎸`."
msgstr "游標為垂直線形，如 `⎸`。"

msgctxt "settings schema"
msgid "Cursor is an underscore like `_`."
msgstr "游標為底線形，如 `_`。"

msgctxt "settings schema"
msgid "Cursor movement animation settings."
msgstr "游標移動動畫設定。"

msgctxt "settings schema"
msgid "Cursor shape configuration for insert mode in Vim."
msgstr "Vim 插入模式的游標形狀設定。"

msgctxt "settings schema"
msgid "Cursor shape for the default editor.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: bar"
msgstr "預設編輯器的游標形狀。\n可為 \"bar\"、\"block\"、\"underline\" 或 \"hollow\"。\n\n預設值：bar"

msgctxt "settings schema"
msgid "Cursor shape for the insert mode.\n\nThe default value follows the primary cursor_shape."
msgstr "插入模式的游標形狀。\n\n預設值依循主要的 cursor_shape。"

msgctxt "settings schema"
msgid "Cursor shape for the normal mode.\n\nDefault: block"
msgstr "一般模式的游標形狀。\n\n預設值：block"

msgctxt "settings schema"
msgid "Cursor shape for the replace mode.\n\nDefault: underline"
msgstr "取代模式的游標形狀。\n\n預設值：underline"

msgctxt "settings schema"
msgid "Cursor shape for the visual mode.\n\nDefault: block"
msgstr "視覺模式的游標形狀。\n\n預設值：block"

msgctxt "settings schema"
msgid "Custom Model API URL to use for this model."
msgstr "此模型使用的自訂模型 API URL。"

msgctxt "settings schema"
msgid "Custom instructions to include in the prompt when generating git commit messages.\nApplied in addition to any project rules files (such as `.rules` or `AGENTS.md`)."
msgstr "產生 git 提交訊息時要包含在提示中的自訂指示。\n除了任何專案規則檔案（例如 `.rules` 或 `AGENTS.md`）之外也會套用。"

msgctxt "settings schema"
msgid "Custom models served through the `bedrock-mantle` endpoint's\nOpenAI-compatible APIs, in addition to the built-in Mantle models\n(GPT-5.6 Sol, GPT-5.6 Terra, GPT-5.6 Luna, GPT-5.5, GPT-5.4, Grok 4.3)."
msgstr "除了內建的 Mantle 模型（GPT-5.6 Sol、GPT-5.6 Terra、GPT-5.6 Luna、GPT-5.5、GPT-5.4、Grok 4.3）之外，透過 `bedrock-mantle` 端點之 OpenAI 相容 API 提供的自訂模型。"

msgctxt "settings schema"
msgid "Custom rules for rendering LSP semantic tokens."
msgstr "用於轉譯 LSP 語意標記的自訂規則。"

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by outline panel\n\nDefault: 240"
msgstr "自訂大綱面板的預設寬度（像素）\n\n預設值：240"

msgctxt "settings schema"
msgid "Customize default width (in pixels) taken by project panel\n\nDefault: 240"
msgstr "自訂專案面板的預設寬度（像素）\n\n預設值：240"

msgctxt "settings schema"
msgid "Cyan ANSI terminal color."
msgstr "終端機的 ANSI 青色。"

msgctxt "settings schema"
msgid "Default action when clicking a changed file in the Git panel.\n\nDefault: project_diff"
msgstr "在 Git 面板中按一下已變更檔案時的預設動作。\n\n預設值：project_diff"

msgctxt "settings schema"
msgid "Default cursor shape for the terminal.\nCan be \"bar\", \"block\", \"underline\", or \"hollow\".\n\nDefault: \"block\""
msgstr "終端機的預設游標形狀。\n可為 \"bar\"、\"block\"、\"underline\" 或 \"hollow\"。\n\n預設值：\"block\""

msgctxt "settings schema"
msgid "Default depth to expand outline items in the current file.\nThe default depth to which outline entries are expanded on reveal.\n- Set to 0 to collapse all items that have children\n- Set to 1 or higher to collapse items at that depth or deeper\n\nDefault: 100"
msgstr "目前檔案中大綱項目的預設展開深度。\n顯示時大綱項目展開到的預設深度。\n- 設為 0 會摺疊所有具有子項目的項目\n- 設為 1 或更高會摺疊該深度或更深的項目\n\n預設值：100"

msgctxt "settings schema"
msgid "Default directories to search for virtual environments, relative\nto the current working directory. We recommend overriding this\nin your project's settings, rather than globally."
msgstr "搜尋虛擬環境的預設資料夾，相對於目前的工作目錄。建議在專案的設定中覆寫此值，而非全域覆寫。"

msgctxt "settings schema"
msgid "Default fixed width in pixels when the agent panel is docked to the left or right and\n`flexible` is false.\n\nDefault: 640"
msgstr "代理面板停駐於左側或右側且 `flexible` 為 false 時的預設固定寬度（像素）。\n\n預設值：640"

msgctxt "settings schema"
msgid "Default height in pixels when the AI browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "AI 瀏覽器面板停駐於底部時的預設高度（像素）。\n\n預設值：320"

msgctxt "settings schema"
msgid "Default height in pixels when the agent panel is docked to the bottom.\n\nDefault: 320"
msgstr "代理面板停駐於底部時的預設高度（像素）。\n\n預設值：320"

msgctxt "settings schema"
msgid "Default height in pixels when the browser panel is docked to the bottom.\n\nDefault: 320"
msgstr "瀏覽器面板停駐於底部時的預設高度（像素）。\n\n預設值：320"

msgctxt "settings schema"
msgid "Default height when the terminal is docked to the bottom.\n\nDefault: 320"
msgstr "終端機停駐於底部時的預設高度。\n\n預設值：320"

msgctxt "settings schema"
msgid "Default is 1500ms."
msgstr "預設為 1500 ms。"

msgctxt "settings schema"
msgid "Default kernels to select for each language.\n\nDefault: `{}`"
msgstr "每種語言預設選取的核心。\n\n預設值：`{}`"

msgctxt "settings schema"
msgid "Default mode when no regex rules match.\nWhen unset, inherits from the global `tool_permissions.default`."
msgstr "沒有符合的規則運算式規則時的預設模式。\n未設定時，會繼承全域的 `tool_permissions.default`。"

msgctxt "settings schema"
msgid "Default options for buffer and project search items."
msgstr "緩衝區和專案搜尋項目的預設選項。"

msgctxt "settings schema"
msgid "Default the cursor blink to off, but allow the terminal to\nset blinking."
msgstr "預設關閉游標閃爍，但允許終端機設定閃爍。"

msgctxt "settings schema"
msgid "Default timeout in seconds for context server tool calls.\nCan be overridden per-server in context_servers configuration.\n\nDefault: 60"
msgstr "MCP 伺服器工具呼叫的預設逾時（秒）。\n可在 context_servers 設定中針對各伺服器覆寫。\n\n預設值：60"

msgctxt "settings schema"
msgid "Default values for session config options.\n\nThis is a map from config option ID to the default value for that option.\n\nDefault: {}"
msgstr "工作階段設定選項的預設值。\n\n這是從設定選項 ID 對應到該選項預設值的對應表。\n\n預設值：{}"

msgctxt "settings schema"
msgid "Default width in pixels when the AI browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "AI 瀏覽器面板停駐於左側或右側時的預設寬度（像素）。\n\n預設值：480"

msgctxt "settings schema"
msgid "Default width in pixels when the browser panel is docked to the left or right.\n\nDefault: 480"
msgstr "瀏覽器面板停駐於左側或右側時的預設寬度（像素）。\n\n預設值：480"

msgctxt "settings schema"
msgid "Default width of the call graph panel in pixels.\n\nDefault: 320"
msgstr "呼叫圖面板的預設寬度（像素）。\n\n預設值：320"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 240"
msgstr "面板的預設寬度（像素）。\n\n預設值：240"

msgctxt "settings schema"
msgid "Default width of the panel in pixels.\n\nDefault: 360"
msgstr "面板的預設寬度（像素）。\n\n預設值：360"

msgctxt "settings schema"
msgid "Default width of the threads sidebar in pixels.\n\nValues range from 200 to 800, matching the widths the sidebar can be\ndragged to. Values outside that range are clamped into it.\n\nDefault: 300"
msgstr "會話側邊欄的預設寬度（像素）。\n\n值的範圍為 200 到 800，與側邊欄可拖曳調整的寬度一致。超出此範圍的值會被限制在範圍內。\n\n預設值：300"

msgctxt "settings schema"
msgid "Default width when the terminal is docked to the left or right.\n\nDefault: 640"
msgstr "終端機停駐於左側或右側時的預設寬度。\n\n預設值：640"

msgctxt "settings schema"
msgid "Default: 0.2"
msgstr "預設值：0.2"

msgctxt "settings schema"
msgid "Default: {}"
msgstr "預設值：{}"

msgctxt "settings schema"
msgid "Defaults to use when opening a new buffer and project search items.\n\nDefault: nothing is enabled"
msgstr "開啟新的緩衝區搜尋與專案搜尋項目時使用的預設值。\n\n預設值：不啟用任何項目"

msgctxt "settings schema"
msgid "Defines the border style for the minimap's scrollbar thumb.\n\nDefault: left_open"
msgstr "定義縮圖捲軸滑桿的框線樣式。\n\n預設值：left_open"

msgctxt "settings schema"
msgid "Delay in milliseconds before showing the which-key popup.\n\nDefault: 1000"
msgstr "顯示 which-key 快顯視窗前的延遲（毫秒）。\n\n預設值：1000"

msgctxt "settings schema"
msgid "Deleted version control color."
msgstr "版本控制中已刪除項目的色彩。"

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_ours`."
msgstr "已棄用，請改用 `version_control_conflict_marker_ours`。"

msgctxt "settings schema"
msgid "Deprecated in favor of `version_control_conflict_marker_theirs`."
msgstr "已棄用，請改用 `version_control_conflict_marker_theirs`。"

msgctxt "settings schema"
msgid "Deprecated: use None instead. Left to avoid breaking existing users' configs.\nPrefer a single line generally, unless an overly long line is encountered."
msgstr "已棄用：請改用 None。保留此值是為了避免破壞現有使用者的設定。\n一般偏好單行，除非遇到過長的行。"

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored."
msgstr "決定縮排輔助線的背景上色方式。"

msgctxt "settings schema"
msgid "Determines how indent guide backgrounds are colored.\n\nDefault: Disabled"
msgstr "決定縮排輔助線背景的著色方式。\n\n預設值：Disabled"

msgctxt "settings schema"
msgid "Determines how indent guides are colored."
msgstr "決定縮排輔助線的上色方式。"

msgctxt "settings schema"
msgid "Determines how indent guides are colored.\n\nDefault: Fixed"
msgstr "決定縮排輔助線的著色方式。\n\n預設值：Fixed"

msgctxt "settings schema"
msgid "Determines how much space the call hierarchy picker can take up in relation to the available window width.\n\nDefault: medium"
msgstr "決定呼叫階層選擇器相對於可用視窗寬度可占用的空間。\n\n預設值：medium"

msgctxt "settings schema"
msgid "Determines how much space the file finder can take up in relation to the available window width.\n\nDefault: small"
msgstr "決定檔案搜尋工具相對於可用視窗寬度可占用的空間。\n\n預設值：small"

msgctxt "settings schema"
msgid "Determines how snippets are sorted relative to other completion items.\n\nDefault: inline"
msgstr "決定程式碼片段相對於其他完成項目的排序方式。\n\n預設值：inline"

msgctxt "settings schema"
msgid "Determines the modifier to be used to add multiple cursors with the mouse. The open hover link mouse gestures will adapt such that it do not conflict with the multicursor modifier.\n\nDefault: alt"
msgstr "決定以滑鼠新增多重游標時使用的輔助按鍵。開啟暫留連結的滑鼠手勢會隨之調整，以免與多重游標輔助按鍵衝突。\n\n預設值：alt"

msgctxt "settings schema"
msgid "Determines the stepping granularity.\n\nDefault: line"
msgstr "決定逐步執行的精細度。\n\n預設值：line"

msgctxt "settings schema"
msgid "Determines what settings a profile starts from before applying its overrides."
msgstr "決定設定檔在套用覆寫前的基礎設定來源。"

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to\nkeyboard input. Applies globally across all input surfaces (editors,\nterminals, palettes, etc.).\n\nDefault: on_typing_and_action"
msgstr "決定何時因應鍵盤輸入隱藏滑鼠游標。全域套用於所有輸入介面（編輯器、終端機、選擇區等）。\n\n預設值：on_typing_and_action"

msgctxt "settings schema"
msgid "Determines when the mouse cursor should be hidden in response to keyboard\ninput.\n\nDefault: on_typing_and_action"
msgstr "決定何時因應鍵盤輸入隱藏滑鼠游標。\n\n預設值：on_typing_and_action"

msgctxt "settings schema"
msgid "Determines whether the file finder should skip focus for the active file in search results.\n\nDefault: true"
msgstr "決定檔案搜尋工具是否應在搜尋結果中略過對使用中檔案的焦點。\n\n預設值：true"

msgctxt "settings schema"
msgid "Determines whether to reduce non-essential motion in the UI, such as\nloading spinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "決定是否將 UI 中非必要的動態效果（例如載入中的旋轉圖示與閃爍的標籤）以靜態方式轉譯，以減少動態效果。\n\n預設值：off"

msgctxt "settings schema"
msgid "Determines which edit prediction provider to use."
msgstr "決定要使用哪個編輯預測提供者。"

msgctxt "settings schema"
msgid "Diff against HEAD: show working (uncommitted) changes."
msgstr "與 HEAD 比較差異：顯示工作區（未提交）變更。"

msgctxt "settings schema"
msgid "Diff against the merge base between HEAD and the repository's\ndefault branch: show all changes on the branch.\n\nRepositories where no default branch can be resolved fall back\nto `head` behavior."
msgstr "與 HEAD 和儲存庫預設分支之間的合併基底比較差異：顯示分支上的所有變更。\n\n無法解析預設分支的儲存庫會改用 `head` 的行為。"

msgctxt "settings schema"
msgid "Dim black ANSI terminal color."
msgstr "暗黑色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Dim blue ANSI terminal color."
msgstr "暗藍色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Dim cyan ANSI terminal color."
msgstr "暗青色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Dim green ANSI terminal color."
msgstr "暗綠色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Dim magenta ANSI terminal color."
msgstr "暗洋紅色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Dim red ANSI terminal color."
msgstr "暗紅色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Dim terminal foreground color."
msgstr "終端機暗色前景色。"

msgctxt "settings schema"
msgid "Dim white ANSI terminal color."
msgstr "暗白色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Dim yellow ANSI terminal color."
msgstr "暗黃色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Direction to split horizontally.\n\nDefault: \"up\""
msgstr "水平分割的方向。\n\n預設值：\"up\""

msgctxt "settings schema"
msgid "Direction to split vertically.\n\nDefault: \"left\""
msgstr "垂直分割的方向。\n\n預設值：\"left\""

msgctxt "settings schema"
msgid "Directory subtrees that sandboxed terminal commands may always write\nto without prompting. Each entry is either a bare path string or an\nobject `{requested, resolved}`; Zed writes objects (the canonical,\nsymlink-resolved target established at approval time), while\nhand-authored entries may be bare path strings. Paths written by Zed\nare absolute.\nDefault: []"
msgstr "沙箱化的終端機命令一律可不經提示即寫入的資料夾子樹。每個項目可以是單純的路徑字串，或物件 `{requested, resolved}`；ForgeKairos 會寫入物件（核准時確定的標準化、已解析符號連結的目標），而手動撰寫的項目可以是單純的路徑字串。ForgeKairos 寫入的路徑為絕對路徑。\n預設值：[]"

msgctxt "settings schema"
msgid "Directory the log files are written to. `~` is expanded.\nWhen empty, logs go to Zed's log directory under `terminal-sessions`.\n\nDefault: \"\""
msgstr "寫入記錄檔的資料夾。會展開 `~`。\n留空時，記錄會寫入 ForgeKairos 記錄資料夾下的 `terminal-sessions`。\n\n預設值：\"\""

msgctxt "settings schema"
msgid "Directory where git worktrees are created, relative to the repository\nworking directory.\n\nWhen the resolved directory is outside the project root, the\nproject's directory name is automatically appended so that\nsibling repos don't collide. For example, with the default\n`\"../worktrees\"` and a project at `~/code/zed`, worktrees are\ncreated under `~/code/worktrees/zed/`.\n\nWhen the resolved directory is inside the project root, no\nextra component is added (it's already project-scoped).\n\nExamples:\n- `\"../worktrees\"` — `~/code/worktrees/<project>/` (default)\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\nTrailing slashes are ignored.\n\nDefault: ../worktrees"
msgstr "建立 git 工作樹的資料夾，相對於儲存庫的工作目錄。\n\n若解析後的資料夾位於專案根目錄之外，會自動附加專案的資料夾名稱，以免相鄰的儲存庫互相衝突。例如，使用預設的 `\"../worktrees\"` 且專案位於 `~/code/zed` 時，工作樹會建立在 `~/code/worktrees/zed/` 之下。\n\n若解析後的資料夾位於專案根目錄之內，則不會附加額外的部分（它已經是專案專屬的位置）。\n\n範例：\n- `\"../worktrees\"` — `~/code/worktrees/<project>/`（預設）\n- `\".git/zed-worktrees\"` — `<project>/.git/zed-worktrees/`\n- `\"my-worktrees\"` — `<project>/my-worktrees/`\n\n結尾的斜線會被忽略。\n\n預設值：../worktrees"

msgctxt "settings schema"
msgid "Disable autosave."
msgstr "停用自動儲存。"

msgctxt "settings schema"
msgid "Disable certificate verification for the proxy (not recommended).\n\nDefault: false"
msgstr "停用 Proxy 的憑證驗證（不建議）。\n\n預設值：false"

msgctxt "settings schema"
msgid "Disable edit predictions for files matching these glob patterns.\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged.\n\nRelative patterns are matched against paths relative to the worktree root.\nAbsolute patterns are matched against absolute paths. A leading `~` is\nexpanded to your home folder."
msgstr "對符合這些 glob 模式的檔案停用編輯預測。\n\n使用 `\"...\"` 可新增模式而不必重複 ForgeKairos 的預設值。在專案設定中，它會延伸使用者或上層設定的值。省略 `\"...\"` 則會取代繼承的清單。\n\n```json\n{\n  \"edit_predictions\": {\n    \"disabled_globs\": [\"**/build/**\", \"...\"]\n  }\n}\n```\n\n繼承的模式會插入在 `\"...\"` 的位置，重複的項目會保留第一次出現者。\n\n設為 `[]` 可清除繼承的清單。省略此設定則會原樣繼承。\n\n相對模式會與相對於工作樹根目錄的路徑比對。\n絕對模式會與絕對路徑比對。開頭的 `~` 會展開為您的主資料夾。"

msgctxt "settings schema"
msgid "Disable edit predictions in these language scopes, such as \"comment\" and\n\"string\".\n\nDefault:\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\nUse `\"...\"` to add scopes without repeating the inherited list. In project\nsettings, it extends the user or parent configuration value. In\nlanguage-specific settings, it extends the scopes inherited by that\nlanguage. Omit `\"...\"` to replace the inherited list.\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\nInherited scopes are inserted at `\"...\"`, and duplicates keep their first\noccurrence.\n\nSet `[]` to clear the inherited list. Omit this setting to inherit it unchanged."
msgstr "在這些語言範圍（例如 \"comment\" 與 \"string\"）中停用編輯預測。\n\n預設值：\n\n```json\n{\n  \"edit_predictions_disabled_in\": []\n}\n```\n\n使用 `\"...\"` 可新增範圍而不必重複繼承的清單。在專案設定中，它會延伸使用者或上層設定的值。在特定語言的設定中，它會延伸該語言繼承的範圍。省略 `\"...\"` 則會取代繼承的清單。\n\n```json\n{\n  \"edit_predictions_disabled_in\": [\"comment\"],\n  \"languages\": {\n    \"Go\": {\n      \"edit_predictions_disabled_in\": [\"string\", \"...\"]\n    }\n  }\n}\n```\n\n繼承的範圍會插入在 `\"...\"` 的位置，重複的項目會保留第一次出現者。\n\n設為 `[]` 可清除繼承的清單。省略此設定則會原樣繼承。"

msgctxt "settings schema"
msgid "Disables the fallback."
msgstr "停用備用選項。"

msgctxt "settings schema"
msgid "Disables the tooltip"
msgstr "停用工具提示"

msgctxt "settings schema"
msgid "Discards the changes."
msgstr "捨棄變更。"

msgctxt "settings schema"
msgid "Display code lenses from language servers above code elements."
msgstr "在程式碼元素上方顯示來自語言伺服器的 CodeLens。"

msgctxt "settings schema"
msgid "Display code lenses in the code action menu."
msgstr "在程式碼動作選單中顯示 CodeLens。"

msgctxt "settings schema"
msgid "Display inline when there are no language server completions available."
msgstr "當沒有可用的語言伺服器自動完成時，以內嵌方式顯示。"

msgctxt "settings schema"
msgid "Displays a border on all sides except the left side of the thumb."
msgstr "在捲動滑塊的所有側面（除左側外）顯示邊框。"

msgctxt "settings schema"
msgid "Displays a border on all sides except the right side of the thumb."
msgstr "在捲動滑塊的所有側面（除右側外）顯示邊框。"

msgctxt "settings schema"
msgid "Displays a border on all sides of the thumb."
msgstr "在捲動滑塊的所有側面顯示邊框。"

msgctxt "settings schema"
msgid "Displays a border only on the left side of the thumb."
msgstr "僅在捲動滑塊的左側顯示邊框。"

msgctxt "settings schema"
msgid "Displays file size in binary units (e.g., KiB, MiB)."
msgstr "以二進位單位顯示檔案大小（例如：KiB、MiB）。"

msgctxt "settings schema"
msgid "Displays file size in decimal units (e.g., KB, MB)."
msgstr "以十進位單位顯示檔案大小（例如：KB、MB）。"

msgctxt "settings schema"
msgid "Displays the thumb without any border."
msgstr "顯示無邊框的捲動滑塊。"

msgctxt "settings schema"
msgid "Do not draw any tabs or spaces."
msgstr "不繪製任何 Tab 或空格。"

msgctxt "settings schema"
msgid "Do not format code."
msgstr "不格式化程式碼。"

msgctxt "settings schema"
msgid "Do not load direnv configuration"
msgstr "不載入 direnv 設定"

msgctxt "settings schema"
msgid "Do not play any sound."
msgstr "不播放任何聲音。"

msgctxt "settings schema"
msgid "Do not query and display code lenses."
msgstr "不查詢或顯示 CodeLens。"

msgctxt "settings schema"
msgid "Do not query and render document colors."
msgstr "不查詢或轉譯文件顏色。"

msgctxt "settings schema"
msgid "Do not render any background for indent guides."
msgstr "不為縮排輔助線轉譯任何背景。"

msgctxt "settings schema"
msgid "Do not render any lines for indent guides."
msgstr "不為縮排輔助線轉譯任何線條。"

msgctxt "settings schema"
msgid "Do not request folding ranges from language servers; use tree-sitter and indent-based folding."
msgstr "不向語言伺服器要求摺疊範圍；改用 tree-sitter 和縮排式摺疊。"

msgctxt "settings schema"
msgid "Do not request semantic tokens from language servers."
msgstr "不向語言伺服器要求語意標記。"

msgctxt "settings schema"
msgid "Do not show diagnostics."
msgstr "不顯示診斷資訊。"

msgctxt "settings schema"
msgid "Do not show snippets in the completion list"
msgstr "不在自動完成清單中顯示程式碼片段"

msgctxt "settings schema"
msgid "Don't list untracked files at all."
msgstr "完全不列出未追蹤的檔案。"

msgctxt "settings schema"
msgid "Don't use system clipboard."
msgstr "不使用系統剪貼簿。"

msgctxt "settings schema"
msgid "Drag and drop related settings"
msgstr "拖放相關設定"

msgctxt "settings schema"
msgid "Draw a background behind the color text."
msgstr "在色彩文字後方繪製背景。"

msgctxt "settings schema"
msgid "Draw a border around the color text."
msgstr "在色彩文字周圍繪製框線。"

msgctxt "settings schema"
msgid "Draw all invisible symbols."
msgstr "繪製所有不可見符號。"

msgctxt "settings schema"
msgid "Draw whitespace only for the selected text."
msgstr "僅為已選取的文字繪製空白符號。"

msgctxt "settings schema"
msgid "Draw whitespaces at boundaries only.\n\nFor a whitespace to be on a boundary, any of the following conditions need to be met:\n- It is a tab\n- It is adjacent to an edge (start or end)\n- It is adjacent to a whitespace (left or right)"
msgstr "只在邊界處繪製空白字元。\n\n空白字元要位於邊界，須符合下列任一條件：\n- 它是定位字元\n- 它與邊緣相鄰（開頭或結尾）\n- 它與空白字元相鄰（左側或右側）"

msgctxt "settings schema"
msgid "Draw whitespaces only after non-whitespace characters."
msgstr "僅在非空白字元之後繪製空白符號。"

msgctxt "settings schema"
msgid "EXPERIMENTAL: Overrides for the current theme.\n\nThese values will override the ones on the current theme specified in `theme`."
msgstr "實驗性：目前佈景主題的覆寫。\n\n這些值會覆寫 `theme` 中指定之目前佈景主題的值。"

msgctxt "settings schema"
msgid "Enables or disables auto-closing of JSX tags."
msgstr "啟用或停用 JSX 標籤的自動關閉。"

msgctxt "settings schema"
msgid "Enables or disables formatting with Prettier for a given language."
msgstr "啟用或停用特定語言的 Prettier 格式化。"

msgctxt "settings schema"
msgid "Enterprise URI for Copilot.\n\nDefault: none"
msgstr "Copilot 的 Enterprise URI。\n\n預設值：none"

msgctxt "settings schema"
msgid "Exclude files matching these glob patterns from file scans, file searches,\nand the project file tree. Takes precedence over `file_scan_inclusions`.\n\nDefault:\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "從檔案掃描、檔案搜尋與專案檔案樹中排除符合這些 glob 模式的檔案。優先於 `file_scan_inclusions`。\n\n預設值：\n\n```json\n{\n  \"file_scan_exclusions\": [\n    \"**/.git\",\n    \"**/.svn\",\n    \"**/.hg\",\n    \"**/.jj\",\n    \"**/.sl\",\n    \"**/.repo\",\n    \"**/CVS\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n    \"**/.classpath\",\n    \"**/.settings\"\n  ]\n}\n```\n\n使用 `\"...\"` 可新增模式而不必重複 ForgeKairos 的預設值。在專案設定中，它會延伸使用者或上層設定的值。省略 `\"...\"` 則會取代繼承的清單。\n\n```json\n{\n  \"file_scan_exclusions\": [\"**/node_modules\", \"...\"]\n}\n```\n\n繼承的模式會插入在 `\"...\"` 的位置，重複的項目會保留第一次出現者。"

msgctxt "settings schema"
msgid "Extends under the left dock while snapping to the right dock"
msgstr "延伸至左側停駐區下方，並貼齊右側停駐區"

msgctxt "settings schema"
msgid "Extends under the right dock while snapping to the left dock"
msgstr "延伸至右側停駐區下方，並貼齊左側停駐區"

msgctxt "settings schema"
msgid "Extra task variables to set for a particular language."
msgstr "為特定語言設定額外的工作變數。"

msgctxt "settings schema"
msgid "Favorite models to show at the top of the model selector."
msgstr "在模型選擇器頂端顯示的最愛模型。"

msgctxt "settings schema"
msgid "Favorited values for session config options.\n\nThis is a map from config option ID to a list of favorited value IDs.\n\nDefault: {}"
msgstr "工作階段設定選項的最愛值。\n\n這是從設定選項 ID 對應到最愛值 ID 清單的對應表。\n\n預設值：{}"

msgctxt "settings schema"
msgid "File diff settings."
msgstr "檔案差異設定。"

msgctxt "settings schema"
msgid "File name for a new log. Supports the placeholders `{date}`, `{time}`,\n`{title}`, `{host}` and `{pid}`.\n\nDefault: \"{date}_{time}_{title}.log\""
msgstr "新記錄的檔案名稱。支援預留位置 `{date}`、`{time}`、`{title}`、`{host}` 與 `{pid}`。\n\n預設值：\"{date}_{time}_{title}.log\""

msgctxt "settings schema"
msgid "Files larger than this many bytes are attached as an outline (their\nsymbols with line numbers) instead of their full content.\n\nDefault: 16384"
msgstr "大於此位元組數的檔案會以大綱（含行號的符號）附加，而非完整內容。\n\n預設值：16384"

msgctxt "settings schema"
msgid "Files should be formatted on save."
msgstr "檔案應在儲存時格式化。"

msgctxt "settings schema"
msgid "Files should be formatted using a code action executed by language servers."
msgstr "檔案應使用語言伺服器執行的程式碼動作進行格式化。"

msgctxt "settings schema"
msgid "Files should not be formatted on save."
msgstr "檔案不應在儲存時格式化。"

msgctxt "settings schema"
msgid "Fill Color. Used for the accent fill color of an icon.\n\nThis might be used to show when a toggleable icon button is selected."
msgstr "填滿色彩。用於圖示的強調填滿色彩。\n\n可用於表示可切換的圖示按鈕已被選取。"

msgctxt "settings schema"
msgid "Fill Color. Used for the default fill color of an icon."
msgstr "填滿色彩。用於圖示的預設填滿色彩。"

msgctxt "settings schema"
msgid "Fill Color. Used for the disabled fill color of an icon.\n\nDisabled states are shown when a user cannot interact with an element, like a icon button."
msgstr "填滿色彩。用於圖示的停用填滿色彩。\n\n當使用者無法與元素（例如圖示按鈕）互動時，會顯示停用狀態。"

msgctxt "settings schema"
msgid "Fill Color. Used for the muted or deemphasized fill color of an icon.\n\nThis might be used to show an icon in an inactive pane, or to deemphasize a series of icons to give them less visual weight."
msgstr "填滿色彩。用於圖示的柔和或淡化填滿色彩。\n\n可用於在非使用中的窗格中顯示圖示，或淡化一系列圖示以降低其視覺比重。"

msgctxt "settings schema"
msgid "Fill Color. Used for the placeholder fill color of an icon.\n\nThis might be used to show an icon in an input that disappears when the user enters text."
msgstr "填滿色彩。用於圖示的預留位置填滿色彩。\n\n可用於在輸入欄位中顯示圖示，該圖示會在使用者輸入文字時消失。"

msgctxt "settings schema"
msgid "Filled background color for added diff hunk row highlights in the editor."
msgstr "編輯器中新增差異區塊列醒目提示的實心背景色。"

msgctxt "settings schema"
msgid "Filled background color for deleted diff hunk row highlights in the editor."
msgstr "編輯器中刪除差異區塊列醒目提示的實心背景色。"

msgctxt "settings schema"
msgid "Follow the visibility of the scrollbar."
msgstr "遵循捲軸的顯示狀態。"

msgctxt "settings schema"
msgid "Font family name."
msgstr "字型家族名稱。"

msgctxt "settings schema"
msgid "Font weight value between 100 (thin) and 900 (black)"
msgstr "字型粗細值，介於 100（細）到 900（極粗）之間"

msgctxt "settings schema"
msgid "Forcefully enable or disable the scrollbar for each axis"
msgstr "強制啟用或停用每個軸的捲軸"

msgctxt "settings schema"
msgid "Forces Prettier integration to use a specific parser name when formatting files with the language."
msgstr "強制 Prettier 整合在使用該語言格式化檔案時使用特定的解析器名稱。"

msgctxt "settings schema"
msgid "Forces Prettier integration to use specific plugins when formatting files with the language.\nThe default Prettier will be installed with these plugins."
msgstr "以 Prettier 格式化該語言的檔案時，強制 Prettier 整合使用特定外掛程式。\n預設的 Prettier 會與這些外掛程式一起安裝。"

msgctxt "settings schema"
msgid "Foreground color for Helix jump labels."
msgstr "Helix 跳躍標籤的前景色。"

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Normal mode indicator."
msgstr "Vim Helix Normal 模式指示器的前景色。"

msgctxt "settings schema"
msgid "Foreground color for Vim Helix Select mode indicator."
msgstr "Vim Helix Select 模式指示器的前景色。"

msgctxt "settings schema"
msgid "Foreground color for Vim Insert mode indicator."
msgstr "Vim Insert 模式指示器的前景色。"

msgctxt "settings schema"
msgid "Foreground color for Vim Replace mode indicator."
msgstr "Vim Replace 模式指示器的前景色。"

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Block mode indicator."
msgstr "Vim Visual Block 模式指示器的前景色。"

msgctxt "settings schema"
msgid "Foreground color for Vim Visual Line mode indicator."
msgstr "Vim Visual Line 模式指示器的前景色。"

msgctxt "settings schema"
msgid "Foreground color for Vim Visual mode indicator."
msgstr "Vim Visual 模式指示器的前景色。"

msgctxt "settings schema"
msgid "Format code using Zed's Prettier integration."
msgstr "使用 ForgeKairos 的 Prettier 整合格式化程式碼。"

msgctxt "settings schema"
msgid "Format code using a language server."
msgstr "使用語言伺服器格式化程式碼。"

msgctxt "settings schema"
msgid "Format code using a specific language server."
msgstr "使用指定的語言伺服器格式化程式碼。"

msgctxt "settings schema"
msgid "Format code using an external command."
msgstr "使用外部指令格式化程式碼。"

msgctxt "settings schema"
msgid "Format code using the current language server."
msgstr "使用目前的語言伺服器格式化程式碼。"

msgctxt "settings schema"
msgid "Format files using Zed's Prettier integration (if applicable),\nor falling back to formatting via language server."
msgstr "使用 ForgeKairos 的 Prettier 整合格式化檔案（若適用），否則改用語言伺服器格式化。"

msgctxt "settings schema"
msgid "Git accounts a repository can commit and push as. Which one a repository\nuses is picked in the git panel and kept in `project_accounts`. An\naccount's token is kept in the operating system's credential store, never\nin this file.\n\nDefault: []"
msgstr "儲存庫可用於提交和推送的 Git 帳戶。儲存庫使用哪一個帳戶是在 Git 面板中選擇，並保存在 `project_accounts` 中。帳戶的權杖保存在作業系統的認證資訊存放區中，絕不會寫入此檔案。\n\n預設值：[]"

msgctxt "settings schema"
msgid "Git blame settings."
msgstr "Git Blame 設定。"

msgctxt "settings schema"
msgid "Global default permission when no tool-specific rules match.\nIndividual tools can override this with their own default.\nDefault: confirm"
msgstr "沒有符合的工具專屬規則時的全域預設權限。\n個別工具可以用自己的預設值覆寫此值。\n預設值：confirm"

msgctxt "settings schema"
msgid "Global switch to toggle hints on and off.\n\nDefault: false"
msgstr "開啟或關閉提示的全域開關。\n\n預設值：false"

msgctxt "settings schema"
msgid "Global switch to toggle inline values on and off when debugging.\n\nDefault: true"
msgstr "偵錯時開啟或關閉內嵌值的全域開關。\n\n預設值：true"

msgctxt "settings schema"
msgid "Green ANSI terminal color."
msgstr "綠色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Gutter related settings"
msgstr "裝訂邊相關設定"

msgctxt "settings schema"
msgid "HTTP/HTTPS proxy to use for Copilot.\n\nDefault: none"
msgstr "Copilot 使用的 HTTP/HTTPS Proxy。\n\n預設值：none"

msgctxt "settings schema"
msgid "Hide git gutter"
msgstr "隱藏 Git 裝訂邊"

msgctxt "settings schema"
msgid "Hide on typing and on key bindings that resolve to an action"
msgstr "在輸入及解析為動作的按鍵繫結時隱藏"

msgctxt "settings schema"
msgid "Hide only when typing"
msgstr "僅在輸入時隱藏"

msgctxt "settings schema"
msgid "Hide the tab bar while the in-panel thread history is showing and the\npanel holds a single pane: the history lists the open tabs too, so the\nhorizontal row would say the same thing twice. Split the panel or close\nthe history and the tab bar comes back."
msgstr "當面板內的會話歷程顯示中且面板只有單一窗格時，隱藏分頁列：歷程中也會列出開啟的分頁，因此橫向的分頁列會重複相同的內容。分割面板或關閉歷程後，分頁列就會重新出現。"

msgctxt "settings schema"
msgid "Hide the values of variables in `private` files, as defined by the\nprivate_files setting. This only changes the visual representation,\nthe values are still present in the file and can be selected / copied / pasted\n\nDefault: false"
msgstr "隱藏 `private` 檔案（由 private_files 設定定義）中變數的值。這只會改變視覺呈現，值仍存在於檔案中，且可以選取 / 複製 / 貼上\n\n預設值：false"

msgctxt "settings schema"
msgid "Highlighted brackets background color.\n\nMatching brackets in the cursor scope are highlighted with this background color."
msgstr "醒目提示括號的背景色彩。\n\n游標範圍內相符的括號會以此背景色彩醒目提示。"

msgctxt "settings schema"
msgid "Hollow background color for added diff hunk row highlights in the editor."
msgstr "編輯器中新增差異區塊列醒目提示的空心背景色。"

msgctxt "settings schema"
msgid "Hollow background color for deleted diff hunk row highlights in the editor."
msgstr "編輯器中刪除差異區塊列醒目提示的空心背景色。"

msgctxt "settings schema"
msgid "Hollow border color for added diff hunk row highlights in the editor."
msgstr "編輯器中新增差異區塊列醒目提示的空心框線色。"

msgctxt "settings schema"
msgid "Hollow border color for deleted diff hunk row highlights in the editor."
msgstr "編輯器中刪除差異區塊列醒目提示的空心框線色。"

msgctxt "settings schema"
msgid "Hollow box cursor."
msgstr "空心方框游標。"

msgctxt "settings schema"
msgid "Hosts that sandboxed terminal commands may always reach over the\nnetwork without prompting. Each entry is an exact hostname\n(`github.com`) or a leading-`*.` subdomain wildcard (`*.npmjs.org`).\nDefault: []"
msgstr "沙箱化的終端機命令一律可不經提示即透過網路連線的主機。每個項目可以是完全相符的主機名稱（`github.com`），或以 `*.` 開頭的子網域萬用字元（`*.npmjs.org`）。\n預設值：[]"

msgctxt "settings schema"
msgid "How and when the scrollbar should be displayed.\n\nDefault: inherits editor scrollbar settings"
msgstr "捲軸的顯示方式與時機。\n\n預設值：繼承編輯器的捲軸設定"

msgctxt "settings schema"
msgid "How entry statuses are displayed.\n\nDefault: icon"
msgstr "項目狀態的顯示方式。\n\n預設值：icon"

msgctxt "settings schema"
msgid "How file paths are displayed in the git gutter.\n\nDefault: file_name_first"
msgstr "檔案路徑在 Git 裝訂邊中的顯示方式。\n\n預設值：file_name_first"

msgctxt "settings schema"
msgid "How hunks are displayed visually in the editor.\n\nDefault: staged_hollow"
msgstr "差異區塊在編輯器中的視覺顯示方式。\n\n預設值：staged_hollow"

msgctxt "settings schema"
msgid "How line endings should be handled for new files and during format and\nsave operations.\n\n- `detect`: Detect existing line endings and otherwise use the platform\n  default (`lf` on Unix, `crlf` on Windows).\n- `prefer_lf`: Prefer LF for new files and files with no existing line\n  ending.\n- `prefer_crlf`: Prefer CRLF for new files and files with no existing\n  line ending.\n- `enforce_lf`: Enforce LF during format and save.\n- `enforce_crlf`: Enforce CRLF during format and save.\n\nThe EditorConfig `end_of_line` property overrides this setting and\nbehaves like `enforce_lf` or `enforce_crlf`.\n\nDefault: detect"
msgstr "新檔案以及格式化與儲存作業中如何處理行尾序列。\n\n- `detect`：偵測現有的行尾序列，否則使用平台預設值（Unix 上為 `lf`，Windows 上為 `crlf`）。\n- `prefer_lf`：新檔案以及沒有現有行尾序列的檔案偏好使用 LF。\n- `prefer_crlf`：新檔案以及沒有現有行尾序列的檔案偏好使用 CRLF。\n- `enforce_lf`：格式化與儲存時強制使用 LF。\n- `enforce_crlf`：格式化與儲存時強制使用 CRLF。\n\nEditorConfig 的 `end_of_line` 屬性會覆寫此設定，其行為如同 `enforce_lf` 或 `enforce_crlf`。\n\n預設值：detect"

msgctxt "settings schema"
msgid "How long \"go to definition\" waits for the language server before it\nalso offers the index's name matches, in milliseconds, from 100 to\n10000.\n\nDefault: 1500"
msgstr "「前往定義」等待語言伺服器多久後也提供索引的名稱比對結果，以毫秒為單位，範圍 100 到 10000。\n\n預設值：1500"

msgctxt "settings schema"
msgid "How many callers or callees of one function to list before a\n\"Show more\" row.\n\nDefault: 200"
msgstr "在「顯示更多」列之前，要列出單一函式的多少個呼叫端或被呼叫端。\n\n預設值：200"

msgctxt "settings schema"
msgid "How many characters has to be in the completions query to automatically show the words-based completions.\nBefore that value, it's still possible to trigger the words-based completion manually with the corresponding editor command.\n\nDefault: 3"
msgstr "完成項目查詢中需要多少個字元，才會自動顯示以字組為基礎的完成項目。\n在達到該值之前，仍可使用對應的編輯器命令手動觸發以字組為基礎的完成項目。\n\n預設值：3"

msgctxt "settings schema"
msgid "How many columns a tab should occupy.\n\nDefault: 4"
msgstr "一個定位字元應占用的欄數。\n\n預設值：4"

msgctxt "settings schema"
msgid "How many hours a session stays alive on the host with no terminal\nattached to it before its shell is ended. 0 keeps it forever.\n\nDefault: 24"
msgstr "沒有附加任何終端機的工作階段在主機上保留多少小時後結束其 Shell。0 表示永久保留。\n\n預設值：24"

msgctxt "settings schema"
msgid "How many lines of context to provide in multibuffer excerpts by default\n\nDefault: 2"
msgstr "多重緩衝區摘錄中預設提供多少行上下文\n\n預設值：2"

msgctxt "settings schema"
msgid "How many lines to expand the multibuffer excerpts by default\n\nDefault: 3"
msgstr "多重緩衝區摘錄預設展開多少行\n\n預設值：3"

msgctxt "settings schema"
msgid "How many minutes an external agent's connection is kept once no thread\nof that agent is open any more. The agent (and the sandbox it runs in)\nis stopped after that, and opening one of its threads again connects\nanew. `0` keeps every connection until the window closes.\n\nDefault: 5"
msgstr "外部代理的會話全部關閉後，其連線保留多少分鐘。之後會停止該代理（及其執行所在的沙箱），再次開啟其會話時會重新連線。`0` 表示保留所有連線直到視窗關閉。\n\n預設值：5"

msgctxt "settings schema"
msgid "How many threads clangd uses to build and index files (`-j`). Unset\nleaves clangd's own default. Values over 256 are treated as 256.\nIgnored when `lsp.clangd.binary.arguments` already has `-j`. Read from\nthe user's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "clangd 建置與索引檔案時使用的執行緒數（`-j`）。未設定時使用 clangd 本身的預設值。大於 256 的值會視為 256。若 `lsp.clangd.binary.arguments` 已包含 `-j` 則會忽略。只從使用者的設定讀取，不會從專案的 `.zed/settings.json` 讀取。\n\n預設值：null"

msgctxt "settings schema"
msgid "How much memory clangd, the C and C++ language server, may use."
msgstr "C 與 C++ 語言伺服器 clangd 可使用的記憶體量。"

msgctxt "settings schema"
msgid "How much to fade out unused code."
msgstr "未使用程式碼的淡出程度。"

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel."
msgstr "思考區塊在代理面板中的預設顯示方式。"

msgctxt "settings schema"
msgid "How thinking blocks should be displayed by default in the agent panel.\n\nDefault: automatic"
msgstr "代理面板中思考區塊的預設顯示方式。\n\n預設值：automatic"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: split"
msgstr "差異在編輯器中的顯示方式。\n\n預設值：split"

msgctxt "settings schema"
msgid "How to display diffs in the editor.\n\nDefault: unified"
msgstr "差異在編輯器中的顯示方式。\n\n預設值：unified"

msgctxt "settings schema"
msgid "How to display the LSP item kind (function, method, variable, etc.)\nof each entry in the completions menu.\n\n- \"off\": do not display item kinds (default).\n- \"symbol\": display a single-letter badge, colorized based on the\n  active syntax theme.\n\nDefault: off"
msgstr "如何在完成項目選單中顯示每個項目的 LSP 項目種類（函式、方法、變數等）。\n\n- \"off\"：不顯示項目種類（預設）。\n- \"symbol\"：顯示單一字母的徽章，並依使用中的語法佈景主題著色。\n\n預設值：off"

msgctxt "settings schema"
msgid "How to group entries in the git panel.\n\nDefault: status"
msgstr "Git 面板中項目的分組方式。\n\n預設值：status"

msgctxt "settings schema"
msgid "How to highlight the current line in the editor.\n\nDefault: all"
msgstr "在編輯器中醒目提示目前行的方式。\n\n預設值：all"

msgctxt "settings schema"
msgid "How to highlight the current line in the minimap.\n\nDefault: inherits editor line highlights setting"
msgstr "在縮圖中醒目提示目前行的方式。\n\n預設值：繼承編輯器的行醒目提示設定"

msgctxt "settings schema"
msgid "How to indent soft-wrapped continuation lines.\n\nDefault: same"
msgstr "自動換行後續行的縮排方式。\n\n預設值：same"

msgctxt "settings schema"
msgid "How to order sibling entries in the project panel.\n\nDefault: directories_first"
msgstr "專案面板中同層項目的排序方式。\n\n預設值：directories_first"

msgctxt "settings schema"
msgid "How to perform a buffer format.\n\nDefault: auto"
msgstr "執行緩衝區格式化的方式。\n\n預設值：auto"

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor."
msgstr "在編輯器中轉譯 LSP `textDocument/documentColor` 色彩的方式。"

msgctxt "settings schema"
msgid "How to render LSP `textDocument/documentColor` colors in the editor.\n\nDefault: [`DocumentColorsRenderMode::Inlay`]"
msgstr "在編輯器中轉譯 LSP `textDocument/documentColor` 色彩的方式。\n\n預設值：[`DocumentColorsRenderMode::Inlay`]"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference\n(e.g. Go to Definition, Go to Type Definition, Find All References).\n\nDefault: center"
msgstr "前往定義或參考時（例如前往定義、前往型別定義、尋找所有參考），如何將目標捲動到檢視中。\n\n預設值：center"

msgctxt "settings schema"
msgid "How to scroll the target into view when navigating to a definition or reference.\n\nDefault: center"
msgstr "前往定義或參考時，如何將目標捲動到檢視中。\n\n預設值：center"

msgctxt "settings schema"
msgid "How to soft-wrap long lines of text.\n\nDefault: none"
msgstr "長文字行的自動換行方式。\n\n預設值：none"

msgctxt "settings schema"
msgid "How to sort entries in the git panel.\n\nDefault: path"
msgstr "Git 面板中項目的排序方式。\n\n預設值：path"

msgctxt "settings schema"
msgid "IDs of the tools not to suggest (`clangd`, `clang-format`, `ruff` and so\non). \"Don't show again\" in the notification adds a tool here.\n\nDefault: []"
msgstr "不建議安裝之工具的 ID（`clangd`、`clang-format`、`ruff` 等）。通知中的「不要再顯示」會將工具加入此處。\n\n預設值：[]"

msgctxt "settings schema"
msgid "IMDSv2, PodIdentity, env vars, etc."
msgstr "IMDSv2、PodIdentity、環境變數等。"

msgctxt "settings schema"
msgid "Icon Theme Name"
msgstr "圖示佈景主題名稱"

msgctxt "settings schema"
msgid "If enabled, Zed will download its own copy of Node."
msgstr "若啟用，ForgeKairos 將下載自己的 Node 副本。"

msgctxt "settings schema"
msgid "If provider supports it, display inline when holding modifier key (e.g., alt).\nOtherwise, eager preview is used."
msgstr "若提供者支援，按住輔助按鍵（例如 alt）時以內嵌方式顯示。\n否則使用 eager 預覽。"

msgctxt "settings schema"
msgid "If the server supports sending tasks over LSP extensions,\nthis setting can be used to enable or disable them in Zed.\nDefault: true"
msgstr "若伺服器支援透過 LSP 擴充傳送工作，可使用此設定在 ForgeKairos 中啟用或停用這些工作。\n預設值：true"

msgctxt "settings schema"
msgid "Ignored version control color."
msgstr "版本控制中已忽略項目的色彩。"

msgctxt "settings schema"
msgid "Include files matching these glob patterns when scanning, even if ignored\nby Git. Note that broad patterns can slow file scanning.\n`file_scan_exclusions` takes precedence.\n\nDefault:\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "掃描時包含符合這些 glob 模式的檔案，即使它們被 Git 忽略。請注意，範圍過廣的模式可能會拖慢檔案掃描。\n`file_scan_exclusions` 優先。\n\n預設值：\n\n```json\n{\n  \"file_scan_inclusions\": [\".env*\"]\n}\n```\n\n使用 `\"...\"` 可新增模式而不必重複 ForgeKairos 的預設值。在專案設定中，它會延伸使用者或上層設定的值。省略 `\"...\"` 則會取代繼承的清單。\n\n```json\n{\n  \"file_scan_inclusions\": [\"**/build/**\", \"...\"]\n}\n```\n\n繼承的模式會插入在 `\"...\"` 的位置，重複的項目會保留第一次出現者。"

msgctxt "settings schema"
msgid "Indent guide related settings."
msgstr "縮排輔助線相關設定。"

msgctxt "settings schema"
msgid "Index a worktree once it has C or C++ files."
msgstr "在工作樹含有 C 或 C++ 檔案時為其建立索引。"

msgctxt "settings schema"
msgid "Index only the open files."
msgstr "只為已開啟的檔案建立索引。"

msgctxt "settings schema"
msgid "Index the whole project in the background (clangd's default)."
msgstr "在背景為整個專案建立索引（clangd 的預設值）。"

msgctxt "settings schema"
msgid "Indicates a changed or altered status, like a file that has been edited."
msgstr "表示已變更或修改的狀態，例如已編輯的檔案。"

msgctxt "settings schema"
msgid "Indicates a hint or some kind of additional information."
msgstr "表示提示或某種附加資訊。"

msgctxt "settings schema"
msgid "Indicates a successful operation or task completion."
msgstr "表示操作成功或任務完成。"

msgctxt "settings schema"
msgid "Indicates a system error, a failed operation or a diagnostic error."
msgstr "表示系統錯誤、操作失敗或診斷錯誤。"

msgctxt "settings schema"
msgid "Indicates some kind of conflict, like a file changed on disk while it was open, or\nmerge conflicts in a Git repository."
msgstr "表示某種衝突，例如檔案在開啟期間於磁碟上被變更，或 Git 儲存庫中的合併衝突。"

msgctxt "settings schema"
msgid "Indicates some kind of unreachable status, like a block of code that can never be reached."
msgstr "表示某種無法到達的狀態，例如永遠無法執行到的程式碼區塊。"

msgctxt "settings schema"
msgid "Indicates something new, like a new file added to a Git repository."
msgstr "表示新增的項目，例如加入 Git 儲存庫的新檔案。"

msgctxt "settings schema"
msgid "Indicates something that is predicted, like automatic code completion, or generated code."
msgstr "表示預測的內容，例如程式碼自動完成或產生的程式碼。"

msgctxt "settings schema"
msgid "Indicates that something is deliberately ignored, such as a file or operation ignored by Git."
msgstr "表示某項目是被刻意忽略的，例如被 Git 忽略的檔案或操作。"

msgctxt "settings schema"
msgid "Indicates that something no longer exists, like a deleted file."
msgstr "表示某項目已不存在，例如已刪除的檔案。"

msgctxt "settings schema"
msgid "Indicates whether this custom model supports caching."
msgstr "表示此自訂模型是否支援快取。"

msgctxt "settings schema"
msgid "Inherit cursor shape from the editor's base cursor_shape setting."
msgstr "繼承編輯器基礎 cursor_shape 設定的游標形狀。"

msgctxt "settings schema"
msgid "Inlay hint related settings."
msgstr "內嵌提示相關設定。"

msgctxt "settings schema"
msgid "Jupyter REPL settings."
msgstr "Jupyter REPL 設定。"

msgctxt "settings schema"
msgid "Keep model alive for N seconds"
msgstr "讓模型保持作用中 N 秒"

msgctxt "settings schema"
msgid "Keep model alive for a fixed duration. Accepts durations like \"5m\", \"10m\", \"1h\", \"1d\", etc."
msgstr "讓模型在固定期間內保持作用中。接受像 \"5m\"、\"10m\"、\"1h\"、\"1d\" 等期間。"

msgctxt "settings schema"
msgid "Keep the tab bar hidden, leaving the in-panel thread history as the way\nto the open tabs. A panel too narrow to show that list, or the strip\nthat brings it back, still gets the tab bar: otherwise nothing would\nreach the tabs that are not in front."
msgstr "保持隱藏分頁列，透過面板內的會話歷程前往開啟的分頁。若面板太窄而無法顯示該清單或將其叫回的窄條，仍會顯示分頁列：否則將無法前往不在最前面的分頁。"

msgctxt "settings schema"
msgid "Keeps the changes in the working tree, unstaged."
msgstr "將變更保留在工作樹中，不暫存。"

msgctxt "settings schema"
msgid "Keeps the changes staged."
msgstr "保持變更為已暫存。"

msgctxt "settings schema"
msgid "Language server settings.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "語言伺服器設定。\n\n參考：https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#workspace_configuration\n\n請參閱特定語言伺服器的文件，以了解支援哪些設定。"

msgctxt "settings schema"
msgid "Language servers from extensions that keep running while their\nworktree's code is paused, by name (for example `\"gopls\"`). Other\nextensions' servers stop until the worktree is resumed. Read from the\nuser settings file only.\n\nDefault: []"
msgstr "在工作樹的程式碼暫停期間仍持續執行之擴充功能語言伺服器，以名稱指定（例如 `\"gopls\"`）。其他擴充功能的伺服器會停止，直到工作樹繼續執行。只從使用者設定檔案讀取。\n\n預設值：[]"

msgctxt "settings schema"
msgid "Largest outline sent for one file, in bytes. Deeper symbols are\ndropped first when an outline does not fit.\n\nDefault: 8192"
msgstr "單一檔案傳送之大綱的大小上限（位元組）。大綱放不下時，會先捨棄較深層的符號。\n\n預設值：8192"

msgctxt "settings schema"
msgid "Largest part of a fetched web page that is attached, in bytes.\n\nDefault: 32768"
msgstr "擷取之網頁中附加部分的大小上限（位元組）。\n\n預設值：32768"

msgctxt "settings schema"
msgid "Layout mode for the bottom dock\n\nDefault: contained"
msgstr "底部停駐區的版面配置模式\n\n預設值：contained"

msgctxt "settings schema"
msgid "Leave the slot empty: the dock shows a single panel, as upstream Zed\ndoes, or none at all."
msgstr "保留空位：停駐區如上游 Zed 一樣只顯示單一面板，或完全不顯示。"

msgctxt "settings schema"
msgid "Leave the window open when there are no tabs"
msgstr "沒有分頁時保持視窗開啟"

msgctxt "settings schema"
msgid "Limits on how much of an attachment (a file, a directory, a selection,\na fetched page, diagnostics or a branch diff) is sent to the agent.\nAnything over these limits is sent as an outline or a reference the\nagent can follow up on instead of in full."
msgstr "附件（檔案、資料夾、選取範圍、擷取的頁面、診斷或分支差異）傳送給代理之內容量的上限。超過這些上限的部分會以大綱或代理可後續追查的參考傳送，而非完整內容。"

msgctxt "settings schema"
msgid "List every file inside untracked directories."
msgstr "列出未追蹤資料夾中的每個檔案。"

msgctxt "settings schema"
msgid "List untracked directories, but not the files inside them."
msgstr "列出未追蹤的資料夾，但不列出其中的檔案。"

msgctxt "settings schema"
msgid "Load direnv configuration directly using `direnv export json`"
msgstr "使用 `direnv export json` 直接載入 direnv 設定"

msgctxt "settings schema"
msgid "Load direnv configuration through a shell hook"
msgstr "透過 shell hook 載入 direnv 設定"

msgctxt "settings schema"
msgid "Local overrides for feature flags, keyed by flag name."
msgstr "按旗標名稱設定的功能旗標本機覆寫值。"

msgctxt "settings schema"
msgid "Looks up references of the same symbol instead."
msgstr "改為查詢相同符號的參考。"

msgctxt "settings schema"
msgid "Lowercase names are grouped before uppercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "小寫名稱會分組排在大寫名稱之前，各組內以不區分大小寫的自然排序排列。以點開頭的名稱排在兩組之前。"

msgctxt "settings schema"
msgid "Magenta ANSI terminal color."
msgstr "洋紅色 ANSI 終端機色彩。"

msgctxt "settings schema"
msgid "Map from language name to file patterns."
msgstr "從語言名稱對應至檔案模式。"

msgctxt "settings schema"
msgid "Map from language name to settings."
msgstr "從語言名稱對應至設定。"

msgctxt "settings schema"
msgid "Match platform conventions by default, so \"on\" on macOS and \"off\" everywhere else"
msgstr "預設符合平台慣例，在 macOS 上為「開啟」，其他平台為「關閉」"

msgctxt "settings schema"
msgid "Match platform conventions by default, so don't quit on macOS, and quit on other platforms"
msgstr "預設符合平台慣例，在 macOS 上不結束，在其他平台上結束"

msgctxt "settings schema"
msgid "Match the system's configured behavior."
msgstr "符合系統設定的行為。"

msgctxt "settings schema"
msgid "Maximum content width in pixels for the agent panel. Content will be\ncentered when the panel is wider than this value.\n\nDefault: 850"
msgstr "代理面板的內容寬度上限（像素）。面板寬於此值時，內容會置中。\n\n預設值：850"

msgctxt "settings schema"
msgid "Maximum directory depth to eagerly index outside of git repositories;\ncontents of directories at this depth or deeper are indexed on demand.\nRepositories rooted shallower than this depth are always indexed fully.\nIn projects that are not rooted at a git repository, repositories directly\ninside a root folder activate their git features immediately; deeper ones\nactivate on first use.\n`0` means no limit and activates all git repositories immediately.\n\nDefault: 5"
msgstr "在 git 儲存庫之外預先建立索引的資料夾深度上限；位於此深度或更深之資料夾的內容會在需要時建立索引。\n根目錄淺於此深度的儲存庫一律會完整建立索引。\n在根目錄不是 git 儲存庫的專案中，直接位於根資料夾內的儲存庫會立即啟用其 git 功能；更深層的儲存庫則在第一次使用時啟用。\n`0` 表示沒有上限，並立即啟用所有 git 儲存庫。\n\n預設值：5"

msgctxt "settings schema"
msgid "Maximum length of the commit message title before a warning is shown.\nSet to 0 to disable.\n\nDefault: 0"
msgstr "顯示警告前提交訊息標題的長度上限。\n設為 0 可停用。\n\n預設值：0"

msgctxt "settings schema"
msgid "Maximum number of characters for an output to be shown inline.\nOnly applies when `inline_output` is true.\n\nDefault: 50"
msgstr "以內嵌方式顯示之輸出的字元數上限。\n只在 `inline_output` 為 true 時套用。\n\n預設值：50"

msgctxt "settings schema"
msgid "Maximum number of columns to display in the minimap.\n\nDefault: 80"
msgstr "縮圖中顯示的欄數上限。\n\n預設值：80"

msgctxt "settings schema"
msgid "Maximum number of columns to keep in REPL's scrollback buffer.\nClamped with [20, 512] range.\n\nDefault: 128"
msgstr "REPL 捲動緩衝區中保留的欄數上限。\n限制在 [20, 512] 範圍內。\n\n預設值：128"

msgctxt "settings schema"
msgid "Maximum number of idle threads with loadable sessions to retain in the\nagent panel. Set to 0 to unload every eligible idle thread when it is\nno longer active.\n\nDefault: 5"
msgstr "在代理面板中保留的閒置會話（具有可重新載入的工作階段）的最大數量。設為 0 時，所有符合條件的閒置會話一旦不再使用中就會卸載。\n\n預設值：5"

msgctxt "settings schema"
msgid "Maximum number of lines of output to display before scrolling.\nSet to 0 to disable output height limits.\n\nDefault: 0"
msgstr "開始捲動前顯示之輸出的行數上限。\n設為 0 可停用輸出高度限制。\n\n預設值：0"

msgctxt "settings schema"
msgid "Maximum number of lines to keep in REPL's scrollback buffer.\nClamped with [4, 256] range.\n\nDefault: 32"
msgstr "REPL 捲動緩衝區中保留的行數上限。\n限制在 [4, 256] 範圍內。\n\n預設值：32"

msgctxt "settings schema"
msgid "Maximum open tabs in a pane. Will not close an unsaved\ntab. Set to `None` for unlimited tabs.\n\nDefault: none"
msgstr "窗格中開啟的分頁數上限。不會關閉未儲存的分頁。設為 `None` 表示不限分頁數。\n\n預設值：none"

msgctxt "settings schema"
msgid "Maximum tokens to generate for FIM models and self-hosted Sweep rewrite responses.\n\nDefault: 256"
msgstr "FIM 模型以及自行託管之 Sweep 重寫回應要產生的 Token 數上限。\n\n預設值：256"

msgctxt "settings schema"
msgid "Maximum tokens to generate.\n\nDefault: 150"
msgstr "要產生的 Token 數上限。\n\n預設值：150"

msgctxt "settings schema"
msgid "Minimap related settings"
msgstr "縮圖相關設定"

msgctxt "settings schema"
msgid "Minimum APCA perceptual contrast for text over highlight backgrounds.\n\nValid range: 0.0 to 106.0\nDefault: 45.0"
msgstr "醒目提示背景上文字的最小 APCA 感知對比度。\n\n有效範圍：0.0 到 106.0\n預設值：45.0"

msgctxt "settings schema"
msgid "Minimum number of characters to reserve space for in the gutter.\n\nDefault: 4"
msgstr "在裝訂邊中保留空間的最小字元數。\n\n預設值：4"

msgctxt "settings schema"
msgid "Minimum number of lines of height the agent message editor should have.\n\nDefault: 4"
msgstr "代理訊息編輯器應有的最小高度（行數）。\n\n預設值：4"

msgctxt "settings schema"
msgid "Minimum time to wait before pulling diagnostics from the language server(s).\n0 turns the debounce off.\n\nDefault: 50"
msgstr "從語言伺服器提取診斷前等待的最短時間。\n0 會關閉防彈跳。\n\n預設值：50"

msgctxt "settings schema"
msgid "Mix directories and files together"
msgstr "資料夾與檔案混合顯示"

msgctxt "settings schema"
msgid "Model that judges whether a tool action is dangerous when the tool\npermission mode is `auto`. Defaults to the fast model, then to\ndefault_model, when not specified."
msgstr "工具權限模式為 `auto` 時，判斷工具動作是否危險的模型。未指定時，預設使用快速模型，其次為 default_model。"

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: \"codestral-latest\""
msgstr "用於完成項目的模型。\n\n預設值：\"codestral-latest\""

msgctxt "settings schema"
msgid "Model to use for completions.\n\nDefault: none"
msgstr "用於完成項目的模型。\n\n預設值：none"

msgctxt "settings schema"
msgid "Model to use for context compaction (`/compact` and auto-compaction).\nFalls back to the thread's currently selected model when not specified.\nIf the configured model is unavailable (provider not registered, model\nnot found), the thread's current model is used instead."
msgstr "用於上下文壓縮（`/compact` 與自動壓縮）的模型。\n未指定時，改用會話目前選取的模型。\n若設定的模型無法使用（提供者未註冊、找不到模型），則改用會話目前的模型。"

msgctxt "settings schema"
msgid "Model to use for generating git commit messages. Defaults to default_model when not specified."
msgstr "用於產生 git 提交訊息的模型。未指定時預設為 default_model。"

msgctxt "settings schema"
msgid "Model to use for generating thread summaries. Defaults to default_model when not specified."
msgstr "用於產生會話摘要的模型。未指定時預設為 default_model。"

msgctxt "settings schema"
msgid "Model to use for the inline assistant when streaming tools are enabled.\n\nDefault: true"
msgstr "啟用串流工具時，內嵌輔助使用的模型。\n\n預設值：true"

msgctxt "settings schema"
msgid "Model to use for the inline assistant. Defaults to default_model when not specified."
msgstr "內嵌輔助要使用的模型。未指定時預設為 default_model。"

msgctxt "settings schema"
msgid "Modified version control color."
msgstr "版本控制中已修改項目的色彩。"

msgctxt "settings schema"
msgid "Most files whose diagnostics are attached with a diagnostics mention.\n\nDefault: 50"
msgstr "以診斷提及附加診斷時，檔案數的上限。\n\n預設值：50"

msgctxt "settings schema"
msgid "Name to use for this server in UI."
msgstr "此伺服器在 UI 中顯示的名稱。"

msgctxt "settings schema"
msgid "Never allow training data collection."
msgstr "永不允許收集訓練資料。"

msgctxt "settings schema"
msgid "Never blink the cursor, ignoring the terminal mode."
msgstr "永不閃爍游標，忽略終端機模式。"

msgctxt "settings schema"
msgid "Never fetch or complete document's words for completions.\n(Word-based completions can still be queried via a separate action)"
msgstr "一律不擷取或完成文件中的字組作為完成項目。\n（仍可透過另一個動作查詢以字組為基礎的完成項目）"

msgctxt "settings schema"
msgid "Never hide the mouse cursor"
msgstr "永不隱藏滑鼠游標"

msgctxt "settings schema"
msgid "Never index the worktree."
msgstr "一律不為工作樹建立索引。"

msgctxt "settings schema"
msgid "Never populate the search query"
msgstr "永不填入搜尋查詢"

msgctxt "settings schema"
msgid "Never reduce motion"
msgstr "永不減少動態效果"

msgctxt "settings schema"
msgid "Never show the minimap."
msgstr "永不顯示縮圖。"

msgctxt "settings schema"
msgid "Never show the scrollbar."
msgstr "永不顯示捲軸。"

msgctxt "settings schema"
msgid "No automatic indentation. New lines start at column 0."
msgstr "不使用自動縮排。新行從第 0 欄開始。"

msgctxt "settings schema"
msgid "Normalize line endings to CRLF (`\\r\\n`) during format and save."
msgstr "格式化與儲存時，將行尾序列正規化為 CRLF (`\\r\\n`)。"

msgctxt "settings schema"
msgid "Normalize line endings to LF (`\\n`) during format and save."
msgstr "格式化與儲存時，將行尾序列正規化為 LF (`\\n`)。"

msgctxt "settings schema"
msgid "Number of lines to search for modelines at the beginning and end of files.\nModelines contain editor directives (e.g., vim/emacs settings) that configure\nthe editor behavior for specific files.\n\nDefault: 5"
msgstr "在檔案開頭與結尾搜尋模式行的行數。\n模式行包含編輯器指示詞（例如 vim/emacs 設定），用於為特定檔案設定編輯器行為。\n\n預設值：5"

msgctxt "settings schema"
msgid "Ollama model name for edit predictions."
msgstr "用於編輯預測的 Ollama 模型名稱。"

msgctxt "settings schema"
msgid "One of `sftp`, `scp`, `ftp` or `ftps`. Any other value means SFTP."
msgstr "`sftp`、`scp`、`ftp` 或 `ftps` 之一。其他任何值都表示 SFTP。"

msgctxt "settings schema"
msgid "Only if LSP response errors or times out,\nuse document's words to show completions."
msgstr "只有在 LSP 回應發生錯誤或逾時時，才使用文件中的字組顯示完成項目。"

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nIf no git diff is available (e.g., when source control is\nunavailable) or if the LSP doesn't support range formatting,\nfalls back to formatting the whole file."
msgstr "儲存時只格式化含有未暫存變更的行。\n若沒有可用的 git 差異（例如無法使用原始檔控制時），或 LSP 不支援範圍格式化，則改為格式化整個檔案。"

msgctxt "settings schema"
msgid "Only lines with unstaged changes are formatted on save.\nRequires source control and LSP range formatting support.\nIf no git diff is available or if the LSP doesn't support\nrange formatting, formatting is skipped."
msgstr "儲存時只格式化含有未暫存變更的行。\n需要原始檔控制及 LSP 範圍格式化支援。\n若沒有可用的 git 差異，或 LSP 不支援範圍格式化，則略過格式化。"

msgctxt "settings schema"
msgid "Only populate the search query when there is text selected."
msgstr "僅在有文字被選取時填入搜尋查詢。"

msgctxt "settings schema"
msgid "Only rewrap within comments."
msgstr "僅在註解內重新換行。"

msgctxt "settings schema"
msgid "Only rewrap within the current selection(s)."
msgstr "僅在目前選取範圍內重新換行。"

msgctxt "settings schema"
msgid "Only scan symlinked directories when they've been expanded in the workspace"
msgstr "僅在工作區中展開符號連結資料夾時掃描"

msgctxt "settings schema"
msgid "Only the language server."
msgstr "僅語言伺服器。"

msgctxt "settings schema"
msgid "Only the symbol index's name matches."
msgstr "僅符號索引的名稱比對結果。"

msgctxt "settings schema"
msgid "Opacity of inactive panels.\nWhen set to 1.0, the inactive panes have the same opacity as the active one.\nIf set to 0, the inactive panes content will not be visible at all.\nValues are clamped to the [0.0, 1.0] range.\n\nDefault: `1.0`"
msgstr "非使用中面板的不透明度。\n設為 1.0 時，非使用中的窗格與使用中的窗格具有相同的不透明度。\n設為 0 時，完全看不到非使用中窗格的內容。\n值會限制在 [0.0, 1.0] 範圍內。\n\n預設值：`1.0`"

msgctxt "settings schema"
msgid "Opacity of the inactive panes. 0 means transparent, 1 means opaque.\n\nValid range: 0.0 to 1.0\nDefault: 1.0"
msgstr "非使用中窗格的不透明度。0 表示透明，1 表示不透明。\n\n有效範圍：0.0 到 1.0\n預設值：1.0"

msgctxt "settings schema"
msgid "Open a single-file diff view."
msgstr "開啟單一檔案差異檢視。"

msgctxt "settings schema"
msgid "Open directories as a new workspace in the current Zed window's sidebar."
msgstr "在目前 ForgeKairos 視窗的側邊欄中，以新工作區開啟資料夾。"

msgctxt "settings schema"
msgid "Open paths in a new window unless they are subpaths of an existing project."
msgstr "除非路徑屬於現有專案的子路徑，否則會在新視窗中開啟。"

msgctxt "settings schema"
msgid "Open projects in a new window."
msgstr "在新視窗中開啟專案。"

msgctxt "settings schema"
msgid "Open projects in the current Zed window."
msgstr "在目前 ForgeKairos 視窗中開啟專案。"

msgctxt "settings schema"
msgid "Open the excerpt clicked as a new buffer in the new tab, if no `alt` modifier was pressed during double click.\nOtherwise, behave as a regular buffer and select the whole word."
msgstr "若按兩下時未按住 `alt` 輔助按鍵，則在新分頁中將按下的摘錄開啟為新緩衝區。\n否則，行為如同一般緩衝區並選取整個字組。"

msgctxt "settings schema"
msgid "Open the file in the editor without a diff view."
msgstr "在編輯器中開啟檔案，不顯示差異檢視。"

msgctxt "settings schema"
msgid "Open the project diff, showing all changed files."
msgstr "開啟專案差異，顯示所有已變更的檔案。"

msgctxt "settings schema"
msgid "Open the results in a filterable picker."
msgstr "在可篩選的選擇器中開啟結果。"

msgctxt "settings schema"
msgid "Open the results in a multibuffer."
msgstr "在多重緩衝區中開啟結果。"

msgctxt "settings schema"
msgid "Optional headers to send."
msgstr "要傳送的選用標頭。"

msgctxt "settings schema"
msgid "Options passed to the language server at startup.\n\nRef: https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\nConsult the documentation for the specific language server to see which settings are supported."
msgstr "啟動時傳遞給語言伺服器的選項。\n\n參考：https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#initialize\n\n請參閱特定語言伺服器的文件，以了解支援哪些設定。"

msgctxt "settings schema"
msgid "Override this model with a different Anthropic model for tool calls."
msgstr "為工具呼叫使用不同的 Anthropic 模型覆寫此模型。"

msgctxt "settings schema"
msgid "Overrides per theme\n\nThese values will override the ones on the specified theme"
msgstr "各佈景主題的覆寫\n\n這些值會覆寫指定佈景主題的值"

msgctxt "settings schema"
msgid "Overrides the context length reported for every llama.cpp model."
msgstr "覆寫每個 llama.cpp 模型回報的上下文長度。"

msgctxt "settings schema"
msgid "Panel stacked beside it, or `none` for a single panel as upstream Zed\nshows.\n\nDefault: browser"
msgstr "並列於其旁的面板，或設為 `none` 以如上游 Zed 一樣只顯示單一面板。\n\n預設值：browser"

msgctxt "settings schema"
msgid "Panel that fills that dock, or `none` to leave the dock as it was.\n\nDefault: agent"
msgstr "填滿該停駐區的面板，或設為 `none` 以保留停駐區原狀。\n\n預設值：agent"

msgctxt "settings schema"
msgid "Per-tool permission rules for granular control over which tool actions\nrequire confirmation.\n\nThe global `default` applies when no tool-specific rules match.\nFor external agent servers (e.g. Claude Agent) that define their own\npermission modes, \"deny\" and \"confirm\" still take precedence — the\nexternal agent's permission system is only used when Zed would allow\nthe action. Per-tool regex patterns (`always_allow`, `always_deny`,\n`always_confirm`) match against the tool's text input (command, path,\nURL, etc.)."
msgstr "各工具的權限規則，可精細控制哪些工具動作需要確認。\n\n沒有符合的工具專屬規則時，套用全域的 `default`。\n對於定義了自己權限模式的外部代理伺服器（例如 Claude Agent），\"deny\" 與 \"confirm\" 仍然優先 — 只有在 ForgeKairos 會允許該動作時，才會使用外部代理的權限系統。各工具的規則運算式模式（`always_allow`、`always_deny`、`always_confirm`）會與工具的文字輸入（命令、路徑、URL 等）比對。"

msgctxt "settings schema"
msgid "Per-tool permission rules.\nKeys are tool names (e.g. terminal, edit_file, fetch) including MCP\ntools (e.g. mcp:server_name:tool_name). Any tool name is accepted;\neven tools without meaningful text input can have a `default` set."
msgstr "各工具的權限規則。\n鍵為工具名稱（例如 terminal、edit_file、fetch），包括 MCP 工具（例如 mcp:server_name:tool_name）。接受任何工具名稱；即使是沒有有意義之文字輸入的工具，也可以設定 `default`。"

msgctxt "settings schema"
msgid "Persistent sandbox permission grants for agent-run terminal commands.\nThese are populated when choosing \"Allow always\" from a sandbox\nescalation prompt."
msgstr "代理執行之終端機命令的永久沙箱權限授與。\n從沙箱權限提升確認中選擇「一律允許」時會填入這些項目。"

msgctxt "settings schema"
msgid "Place snippets at the bottom of the completion list"
msgstr "將程式碼片段置於自動完成清單底部"

msgctxt "settings schema"
msgid "Place snippets at the top of the completion list"
msgstr "將程式碼片段置於自動完成清單頂部"

msgctxt "settings schema"
msgid "Play an OS-specific alert sound."
msgstr "播放作業系統特定的提示音。"

msgctxt "settings schema"
msgid "Position of the close button in a tab.\n\nDefault: right"
msgstr "分頁中關閉按鈕的位置。\n\n預設值：right"

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for MCP servers that don't support\nDynamic Client Registration."
msgstr "供不支援 Dynamic Client Registration 之 MCP 伺服器使用的預先註冊 OAuth 用戶端認證資訊。"

msgctxt "settings schema"
msgid "Pre-registered OAuth client credentials for authorization servers that\nrequire out-of-band client registration."
msgstr "供需要頻外用戶端註冊之授權伺服器使用的預先註冊 OAuth 用戶端認證資訊。"

msgctxt "settings schema"
msgid "Prefer a single line generally, unless an overly long line is encountered."
msgstr "通常偏好單行，除非遇到過長的行。"

msgctxt "settings schema"
msgid "Preferred Conda manager to use when activating Conda environments.\n\nDefault: auto"
msgstr "啟用 Conda 環境時偏好使用的 Conda 管理員。\n\n預設值：auto"

msgctxt "settings schema"
msgid "Preferred debuggers for this language.\n\nDefault: []"
msgstr "此語言偏好使用的偵錯工具。\n\n預設值：[]"

msgctxt "settings schema"
msgid "Preserve the cursor's vertical position within the viewport, falling\nback to centering when the cursor is offscreen."
msgstr "保持游標在檢視區中的垂直位置，游標在畫面外時則改為置中。"

msgctxt "settings schema"
msgid "Preserve the existing line endings of the file. New files use the\nplatform default line ending."
msgstr "保留檔案現有的行尾序列。新檔案使用平台預設的行尾序列。"

msgctxt "settings schema"
msgid "Preserve the indentation of the current line when creating new lines,\nbut don't adjust based on syntax context."
msgstr "建立新行時保留目前行的縮排，但不依據語法上下文調整。"

msgctxt "settings schema"
msgid "Pure Unicode codepoint comparison. No case folding, no natural number sorting.\nUppercase ASCII sorts before lowercase. Accented characters sort after ASCII."
msgstr "純 Unicode 字碼指標比較。不做大小寫摺疊，也不做自然數字排序。\n大寫 ASCII 排在小寫之前。含重音符號的字元排在 ASCII 之後。"

msgctxt "settings schema"
msgid "Quit the application the last window is closed"
msgstr "關閉最後一個視窗時結束應用程式"

msgctxt "settings schema"
msgid "Read-access of a symbol, like reading a variable.\n\nA document highlight is a range inside a text document which deserves\nspecial attention. Usually a document highlight is visualized by changing\nthe background color of its range."
msgstr "符號的讀取存取，例如讀取變數。\n\n文件醒目提示是文字文件中值得特別注意的範圍。通常會透過變更其範圍的背景色彩來呈現文件醒目提示。"

msgctxt "settings schema"
msgid "Red ANSI terminal color."
msgstr "紅色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Regexes for inputs that must always prompt.\nTakes precedence over always_allow but not always_deny.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "一律必須提示之輸入的規則運算式。\n優先於 always_allow，但不優先於 always_deny。\n對於 `copy_path` 與 `move_path`，模式會分別與每個路徑（來源與目的地）比對。\n模式會在各設定層（使用者、專案、設定檔）之間累積，且無法由優先順序較高的層移除 — 只能新增模式。\n預設值：[]"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-approve.\nFor terminal: matches command. For file tools: matches path. For fetch: matches URL.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "要自動核准之輸入的規則運算式。\n終端機：比對命令。檔案工具：比對路徑。fetch：比對 URL。\n對於 `copy_path` 與 `move_path`，模式會分別與每個路徑（來源與目的地）比對。\n模式會在各設定層（使用者、專案、設定檔）之間累積，且無法由優先順序較高的層移除 — 只能新增模式。\n預設值：[]"

msgctxt "settings schema"
msgid "Regexes for inputs to auto-reject.\n**SECURITY**: These take precedence over ALL other rules, across ALL settings layers.\nFor `copy_path` and `move_path`, patterns are matched independently against each\npath (source and destination).\nPatterns accumulate across settings layers (user, project, profile) and cannot be\nremoved by a higher-priority layer—only new patterns can be added.\nDefault: []"
msgstr "要自動拒絕之輸入的規則運算式。\n**安全性**：這些規則在所有設定層中都優先於所有其他規則。\n對於 `copy_path` 與 `move_path`，模式會分別與每個路徑（來源與目的地）比對。\n模式會在各設定層（使用者、專案、設定檔）之間累積，且無法由優先順序較高的層移除 — 只能新增模式。\n預設值：[]"

msgctxt "settings schema"
msgid "Regexes used to identify paths for hyperlink navigation.\n\nDefault:\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\nUse `\"...\"` to add regexes without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list. Set `[]` to clear it. Omitting this\nsetting keeps the inherited list.\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\nInherited regexes are inserted at `\"...\"`, and duplicates keep their first\noccurrence. Regexes are duplicates when their text is identical after\njoining multiline entries with newlines.\n\nEach regex can be a single string or an array of strings joined with\nnewlines. The marker is recognized only as a top-level string. To use\n`...` as a regex matching three characters, write `[\"...\"]` as an entry.\nA `\"...\"` line inside a multiline entry is always regex text.\n\nThe optional named capture `path` selects the hyperlink target. Without\nit, the entire match is the target. With `path`, `line` and `column`\nspecify the position. Without a captured `line`, built-in suffix\nprocessing parses `line:column` and `(line,column)` variants. The optional\n`link` capture selects the clickable text, otherwise the entire match is\nclickable.\n\nProcessing stops at the first regex that matches the terminal line, even\nif the cursor is outside its clickable text. Put more specific regexes\nbefore broader ones. Regexes use Rust's `regex` syntax. Invalid regexes\nare logged and ignored. The `path_hyperlink_timeout_ms` setting controls\nthe discovery timeout. Setting it to `0` disables path hyperlinks."
msgstr "用於識別超連結導覽路徑的規則運算式。\n\n預設值：\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      // Python-style diagnostics\n      \"File \\\"(?<path>[^\\\"]+)\\\", line (?<line>[0-9]+)\",\n      // Common path syntax with optional line, column, description, trailing punctuation, or\n      // surrounding symbols or quotes\n      [\n        \"(?x)\",\n        \"(?<path>\",\n        \"    (\",\n        \"        # multi-char path: first char (not opening delimiter, space, or box drawing char)\",\n        \"        [^({\\\\[<\\\"'`\\\\ \\\\u2500-\\\\u257F]\",\n        \"        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space\",\n        \"        ([^\\\\ :(]|[:(][^0-9()\\\\ ])*\",\n        \"        # last char: not closing delimiter or colon\",\n        \"        [^()}\\\\]>\\\"'`.,;:\\\\ ]\",\n        \"    |\",\n        \"        # single-char path: not delimiter, punctuation, space, or box drawing char\",\n        \"        [^(){}\\\\[\\\\]<>\\\"'`.,;:\\\\ \\\\u2500-\\\\u257F]\",\n        \"    )\",\n        \"    # optional line/column suffix (included in path for PathWithPosition::parse_str)\",\n        \"    (:+[0-9]+(:[0-9]+)?|:?\\\\([0-9]+([,:]?[0-9]+)?\\\\))?\",\n        \")\"\n      ]\n    ]\n  }\n}\n```\n\n使用 `\"...\"` 可新增規則運算式而不必重複 ForgeKairos 的預設值。在專案設定中，它會延伸使用者或上層設定的值。省略 `\"...\"` 則會取代繼承的清單。設為 `[]` 可清除清單。省略此設定則會保留繼承的清單。\n\n```json\n{\n  \"terminal\": {\n    \"path_hyperlink_regexes\": [\n      \"\\\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)\",\n      \"\\\\s+(Compiling|Checking|Documenting) [^(]+\\\\((?<link>(?<path>.+))\\\\)\",\n      \"...\"\n    ]\n  }\n}\n```\n\n繼承的規則運算式會插入在 `\"...\"` 的位置，重複的項目會保留第一次出現者。將多行項目以換行連接後文字相同的規則運算式，即視為重複。\n\n每個規則運算式可以是單一字串，或以換行連接的字串陣列。此標記只有在作為最上層字串時才會被識別。若要將 `...` 作為比對三個字元的規則運算式使用，請將 `[\"...\"]` 寫成一個項目。多行項目中的 `\"...\"` 行一律視為規則運算式文字。\n\n選用的具名擷取 `path` 會選取超連結目標。若沒有它，整個符合內容即為目標。有 `path` 時，`line` 與 `column` 會指定位置。未擷取 `line` 時，內建的後綴處理會剖析 `line:column` 與 `(line,column)` 的變體。選用的 `link` 擷取會選取可點按的文字，否則整個符合內容皆可點按。\n\n處理會在第一個符合終端機行的規則運算式停止，即使游標位於其可點按文字之外也一樣。請將較具體的規則運算式放在較廣泛的之前。規則運算式使用 Rust 的 `regex` 語法。無效的規則運算式會被記錄並忽略。`path_hyperlink_timeout_ms` 設定控制偵測的逾時。將其設為 `0` 會停用路徑超連結。"

msgctxt "settings schema"
msgid "Renamed version control color."
msgstr "版本控制中已重新命名項目的色彩。"

msgctxt "settings schema"
msgid "Render document colors as inlay hints near the color text."
msgstr "以內嵌提示的方式在色彩文字旁顯示文件色彩。"

msgctxt "settings schema"
msgid "Replaces text before and after the cursor, using the `replace` range described in the LSP specification."
msgstr "依照 LSP 規格描述的 `replace` 範圍，取代游標前後的文字。"

msgctxt "settings schema"
msgid "Replaces text before the cursor, using the `insert` range described in the LSP specification."
msgstr "依照 LSP 規格描述的 `insert` 範圍，取代游標前的文字。"

msgctxt "settings schema"
msgid "Replaces the grid with the text in the same tab."
msgstr "在同一個分頁中以文字取代格狀檢視。"

msgctxt "settings schema"
msgid "Represents a hidden status, such as a file being hidden in a file tree."
msgstr "表示隱藏狀態，例如檔案在檔案樹中被隱藏。"

msgctxt "settings schema"
msgid "Represents a renamed status, such as a file that has been renamed."
msgstr "表示已重新命名的狀態，例如已重新命名的檔案。"

msgctxt "settings schema"
msgid "Represents a warning status, like an operation that is about to fail."
msgstr "表示警告狀態，例如即將失敗的操作。"

msgctxt "settings schema"
msgid "Represents informational status updates or messages."
msgstr "表示資訊性的狀態更新或訊息。"

msgctxt "settings schema"
msgid "Represents the selection of a theme, which can be either static or dynamic."
msgstr "表示佈景主題的選擇，可以是靜態或動態。"

msgctxt "settings schema"
msgid "Represents the selection of an icon theme, which can be either static or dynamic."
msgstr "表示圖示佈景主題的選擇，可以是靜態或動態。"

msgctxt "settings schema"
msgid "Resize the window to cover the entire screen, including the menu bar and,\non notched displays, the area around the notch."
msgstr "調整視窗大小以覆蓋整個螢幕，包括選單列，以及在有瀏海的顯示器上瀏海周圍的區域。"

msgctxt "settings schema"
msgid "Restart clangd when its resident memory, measured every 30 seconds,\ngoes over this many megabytes. At most one restart every 10 minutes;\nafter that, a notification only. Unset never restarts. Read from the\nuser's settings only, not from a project's `.zed/settings.json`.\n\nDefault: null"
msgstr "當 clangd 的常駐記憶體（每 30 秒測量一次）超過這麼多 MB 時，重新啟動 clangd。最多每 10 分鐘重新啟動一次；之後只會顯示通知。未設定時永不重新啟動。只從使用者的設定讀取，不會從專案的 `.zed/settings.json` 讀取。\n\n預設值：null"

msgctxt "settings schema"
msgid "Restore all workspaces that were open when quitting Zed."
msgstr "還原結束 ForgeKairos 時所有已開啟的工作區。"

msgctxt "settings schema"
msgid "Restore the workspace that was closed last."
msgstr "還原上次關閉的工作區。"

msgctxt "settings schema"
msgid "Rules for rendering LSP semantic tokens."
msgstr "LSP 語意標記的轉譯規則。"

msgctxt "settings schema"
msgid "Save after inactivity period of `milliseconds`."
msgstr "在 `milliseconds` 毫秒的閒置期後自動儲存。"

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier for fast scrolling. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling. Fast scrolling\nhappens when a user holds the alt or option key while scrolling.\n\nDefault: 4.0"
msgstr "快速捲動的捲動靈敏度倍數。捲動時，此倍數會同時套用於水平與垂直的位移值。使用者在捲動時按住 alt 或 option 鍵即為快速捲動。\n\n預設值：4.0"

msgctxt "settings schema"
msgid "Scroll sensitivity multiplier. This multiplier is applied\nto both the horizontal and vertical delta values while scrolling.\n\nDefault: 1.0"
msgstr "捲動靈敏度倍數。捲動時，此倍數會同時套用於水平與垂直的位移值。\n\n預設值：1.0"

msgctxt "settings schema"
msgid "Scroll so the target appears near the top of the viewport."
msgstr "捲動使目標出現在檢視區頂部附近。"

msgctxt "settings schema"
msgid "Scroll the minimum amount needed to make the target visible."
msgstr "以最小捲動量使目標可見。"

msgctxt "settings schema"
msgid "Scrollbar related settings"
msgstr "捲軸相關設定"

msgctxt "settings schema"
msgid "Scrollbar-related settings"
msgstr "捲軸相關設定"

msgctxt "settings schema"
msgid "Select specific input audio device."
msgstr "選取特定的輸入音訊裝置。"

msgctxt "settings schema"
msgid "Select specific output audio device."
msgstr "選取特定的輸出音訊裝置。"

msgctxt "settings schema"
msgid "Send anonymized usage data like what languages you're using Zed with.\n\nDefault: true"
msgstr "傳送匿名的使用情況資料，例如您在 ForgeKairos 中使用的語言。\n\n預設值：true"

msgctxt "settings schema"
msgid "Send debug info like crash reports.\n\nDefault: true"
msgstr "傳送偵錯資訊，例如當機報告。\n\n預設值：true"

msgctxt "settings schema"
msgid "Session log (TeraTerm-style output recording) settings."
msgstr "工作階段記錄（TeraTerm 樣式的輸出記錄）設定。"

msgctxt "settings schema"
msgid "Sets the cursor blinking behavior in the terminal.\n\nDefault: terminal_controlled"
msgstr "設定終端機中的游標閃爍行為。\n\n預設值：terminal_controlled"

msgctxt "settings schema"
msgid "Sets the debounce threshold (in milliseconds) after which changes are reflected in the git gutter.\n\nDefault: 0"
msgstr "設定變更反映至 git 裝訂邊前的防彈跳閾值（毫秒）。\n\n預設值：0"

msgctxt "settings schema"
msgid "Sets the terminal's font fallbacks.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font fallbacks."
msgstr "設定終端機的後援字型。\n\n若未包含此選項，終端機預設會與緩衝區的後援字型一致。"

msgctxt "settings schema"
msgid "Sets the terminal's font family.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font family."
msgstr "設定終端機的字型家族。\n\n若未包含此選項，終端機預設會與緩衝區的字型家族一致。"

msgctxt "settings schema"
msgid "Sets the terminal's font size.\n\nIf this option is not included,\nthe terminal will default to matching the buffer's font size."
msgstr "設定終端機的字型大小。\n\n若未包含此選項，終端機預設會與緩衝區的字型大小一致。"

msgctxt "settings schema"
msgid "Sets the terminal's font weight in CSS weight units 0-900."
msgstr "以 CSS 字重單位 0-900 設定終端機的字型粗細。"

msgctxt "settings schema"
msgid "Sets the terminal's line height.\n\nDefault: comfortable"
msgstr "設定終端機的行高。\n\n預設值：comfortable"

msgctxt "settings schema"
msgid "Sets whether Alternate Scroll mode (code: ?1007) is active by default.\nAlternate Scroll mode converts mouse scroll events into up / down key\npresses when in the alternate screen (e.g. when running applications\nlike vim or  less). The terminal can still set and unset this mode.\n\nDefault: on"
msgstr "設定 Alternate Scroll 模式（代碼：?1007）是否預設為作用中。\nAlternate Scroll 模式會在替代畫面中（例如執行 vim 或 less 等應用程式時）將滑鼠捲動事件轉換為向上 / 向下按鍵。終端機仍可設定和取消此模式。\n\n預設值：on"

msgctxt "settings schema"
msgid "Sets whether the option key behaves as the meta key.\n\nDefault: false"
msgstr "設定 option 鍵是否作為 meta 鍵使用。\n\n預設值：false"

msgctxt "settings schema"
msgid "Settings for associating file extensions and filenames\nwith languages."
msgstr "將副檔名與檔案名稱關聯至語言的設定。"

msgctxt "settings schema"
msgid "Settings for automatic agent context compaction, which summarizes\nearlier messages to free up room in the model's context window once the\ncontext grows too large."
msgstr "自動壓縮代理上下文的設定，當上下文變得太大時，會摘要較早的訊息以釋出模型上下文視窗中的空間。"

msgctxt "settings schema"
msgid "Settings for automatically opening files."
msgstr "自動開啟檔案的設定。"

msgctxt "settings schema"
msgid "Settings for configuring REPL display and behavior."
msgstr "設定 REPL 顯示和行為的設定。"

msgctxt "settings schema"
msgid "Settings for configuring the which-key popup behaviour."
msgstr "which-key 快顯視窗行為的設定。"

msgctxt "settings schema"
msgid "Settings for context servers used for AI-related features."
msgstr "AI 相關功能所使用的 MCP 伺服器設定。"

msgctxt "settings schema"
msgid "Settings for developer-oriented instrumentation tools (profilers,\ntracers, etc.) that can be toggled at runtime."
msgstr "可在執行時切換之開發人員導向檢測工具（分析工具、追蹤工具等）的設定。"

msgctxt "settings schema"
msgid "Settings for language server notifications"
msgstr "語言伺服器通知的設定"

msgctxt "settings schema"
msgid "Settings for showing inline diagnostics."
msgstr "顯示內嵌診斷的設定。"

msgctxt "settings schema"
msgid "Settings for sticking scopes to the top of the editor.\n\nDefault: sticky scroll is disabled"
msgstr "將範圍固定在編輯器頂端的設定。\n\n預設值：停用固定捲動"

msgctxt "settings schema"
msgid "Settings for tabular files such as CSV and TSV."
msgstr "CSV 與 TSV 等表格式檔案的設定。"

msgctxt "settings schema"
msgid "Settings for the built-in IDE server.\n\nThe server binds a random port on `127.0.0.1` only and never talks to the\nnetwork, so it is outside the scope of the egress allowlist."
msgstr "內建 IDE 伺服器的設定。\n\n伺服器只繫結 `127.0.0.1` 上的隨機連接埠，且永不與網路通訊，因此不在對外連線允許清單的範圍內。"

msgctxt "settings schema"
msgid "Settings for the built-in browser panel."
msgstr "內建瀏覽器面板的設定。"

msgctxt "settings schema"
msgid "Settings for the built-in loopback IDE server."
msgstr "內建回送 IDE 伺服器的設定。"

msgctxt "settings schema"
msgid "Settings for the machine a remote project runs on, as opposed to the\nlists of connections next to them. Written under `\"remote\"` in\n`settings.json`, and carried to the remote host with the rest of the user\nsettings, which is where they take effect."
msgstr "遠端專案執行所在機器的設定，有別於其旁的連線清單。寫在 `settings.json` 的 `\"remote\"` 之下，並隨其餘使用者設定一起帶到遠端主機，在該處生效。"

msgctxt "settings schema"
msgid "Settings for the threads sidebar."
msgstr "會話側邊欄的設定。"

msgctxt "settings schema"
msgid "Settings for the which-key popup."
msgstr "which-key 快顯視窗的設定。"

msgctxt "settings schema"
msgid "Settings for using LSP pull diagnostics mechanism in Zed."
msgstr "在 ForgeKairos 中使用 LSP 拉取診斷機制的設定。"

msgctxt "settings schema"
msgid "Settings related to Vim mode in Zed."
msgstr "ForgeKairos 中 Vim 模式的相關設定。"

msgctxt "settings schema"
msgid "Settings related to indent guides in the outline panel."
msgstr "大綱面板中縮排輔助線的相關設定。"

msgctxt "settings schema"
msgid "Settings related to indent guides in the project panel."
msgstr "專案面板中縮排輔助線的相關設定。"

msgctxt "settings schema"
msgid "Settings related to the command palette."
msgstr "命令選擇區的相關設定。"

msgctxt "settings schema"
msgid "Settings related to the file finder."
msgstr "檔案搜尋器的相關設定。"

msgctxt "settings schema"
msgid "Settings specific to Codestral."
msgstr "Codestral 的專屬設定。"

msgctxt "settings schema"
msgid "Settings specific to GitHub Copilot."
msgstr "GitHub Copilot 的專屬設定。"

msgctxt "settings schema"
msgid "Settings specific to Ollama."
msgstr "Ollama 的專屬設定。"

msgctxt "settings schema"
msgid "Settings specific to Zed's Edit Predictions provider."
msgstr "Zed 編輯預測提供者的專屬設定。"

msgctxt "settings schema"
msgid "Settings specific to journaling"
msgstr "日記功能的專屬設定"

msgctxt "settings schema"
msgid "Settings specific to the Mercury Edit Predictions provider."
msgstr "Mercury 編輯預測提供者的專屬設定。"

msgctxt "settings schema"
msgid "Settings specific to using custom OpenAI-compatible servers for edit prediction."
msgstr "使用自訂 OpenAI 相容伺服器進行編輯預測的專屬設定。"

msgctxt "settings schema"
msgid "Settings that apply to the host a remote project runs on."
msgstr "套用於遠端專案執行所在主機的設定。"

msgctxt "settings schema"
msgid "Settings-layer–free model mode enum.\n\nMirrors the shape of `settings_content::ModelMode` but lives here so that\ncrates below the settings layer can reference it."
msgstr "不依賴設定層的模型模式列舉。\n\n與 `settings_content::ModelMode` 形狀相同，但放在此處，讓設定層以下的 crate 可以參考它。"

msgctxt "settings schema"
msgid "Settings-layer–free reasoning-effort enum.\n\nMirrors the shape of `settings_content::OpenAiReasoningEffort` but lives\nhere so that crates below the settings layer can reference it."
msgstr "不依賴設定層的思考深度列舉。\n\n與 `settings_content::OpenAiReasoningEffort` 形狀相同，但放在此處，讓設定層以下的 crate 可以參考它。"

msgctxt "settings schema"
msgid "Shell configuration to open the terminal with."
msgstr "開啟終端機時使用的 Shell 設定。"

msgctxt "settings schema"
msgid "Show a disclosure chevron followed by a folder icon."
msgstr "顯示展開箭頭，後接資料夾圖示。"

msgctxt "settings schema"
msgid "Show a disclosure chevron."
msgstr "顯示展開箭頭。"

msgctxt "settings schema"
msgid "Show a folder icon."
msgstr "顯示資料夾圖示。"

msgctxt "settings schema"
msgid "Show all diagnostic levels: hint, information, warnings, error."
msgstr "顯示所有診斷層級：提示、資訊、警告、錯誤。"

msgctxt "settings schema"
msgid "Show an empty untitled buffer when opening a new window"
msgstr "開啟新視窗時顯示空白的未命名緩衝區"

msgctxt "settings schema"
msgid "Show diffs in a single unified view."
msgstr "在單一內嵌檢視中顯示差異。"

msgctxt "settings schema"
msgid "Show diffs in a split view."
msgstr "在分割檢視中顯示差異。"

msgctxt "settings schema"
msgid "Show directories first, then files"
msgstr "先顯示資料夾，再顯示檔案"

msgctxt "settings schema"
msgid "Show file name first, then path"
msgstr "先顯示檔名，再顯示路徑"

msgctxt "settings schema"
msgid "Show files first, then directories"
msgstr "先顯示檔案，再顯示資料夾"

msgctxt "settings schema"
msgid "Show full path first"
msgstr "先顯示完整路徑"

msgctxt "settings schema"
msgid "Show git blame in the status bar at the bottom of the window."
msgstr "在視窗底部的狀態列顯示 Git Blame。"

msgctxt "settings schema"
msgid "Show git blame inline at the current line."
msgstr "在目前行內嵌顯示 Git Blame。"

msgctxt "settings schema"
msgid "Show git gutter in tracked files."
msgstr "在追蹤的檔案中顯示 Git 裝訂邊。"

msgctxt "settings schema"
msgid "Show on all open editors."
msgstr "在所有開啟的編輯器中顯示。"

msgctxt "settings schema"
msgid "Show only the following diagnostic level: error."
msgstr "僅顯示以下診斷層級：錯誤。"

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: information, warning, error."
msgstr "僅顯示以下診斷層級：資訊、警告、錯誤。"

msgctxt "settings schema"
msgid "Show only the following diagnostic levels: warning, error."
msgstr "僅顯示以下診斷層級：警告、錯誤。"

msgctxt "settings schema"
msgid "Show the launchpad with recent projects (no tabs)."
msgstr "顯示含有最近專案的啟動台（無分頁）。"

msgctxt "settings schema"
msgid "Show the launchpad with recent projects when opening a new window"
msgstr "開啟新視窗時顯示含有最近專案的啟動台"

msgctxt "settings schema"
msgid "Show the minimap on the active editor only."
msgstr "僅在目前使用的編輯器上顯示縮圖。"

msgctxt "settings schema"
msgid "Show the minimap thumb only when the mouse is hovering over the minimap."
msgstr "僅在滑鼠暫留於縮圖上時顯示縮圖捲動滑塊。"

msgctxt "settings schema"
msgid "Show the scrollbar if there's important information or\nfollow the system's configured behavior."
msgstr "有重要資訊時顯示捲軸，或依循系統設定的行為。"

msgctxt "settings schema"
msgid "Show unstaged hunks hollow and staged hunks with a filled background."
msgstr "將未暫存的區塊顯示為空心，已暫存的區塊顯示為實心背景。"

msgctxt "settings schema"
msgid "Show unstaged hunks with a filled background and staged hunks hollow."
msgstr "將未暫存的區塊顯示為實心背景，已暫存的區塊顯示為空心。"

msgctxt "settings schema"
msgid "Size of the border surrounding the active pane.\nWhen set to 0, the active pane doesn't have any border.\nThe border is drawn inset.\n\nDefault: `0.0`"
msgstr "使用中窗格周圍框線的大小。\n設為 0 時，使用中的窗格沒有任何框線。\n框線會向內繪製。\n\n預設值：`0.0`"

msgctxt "settings schema"
msgid "Soft wrap line at the preferred line length or the editor width (whichever is smaller)."
msgstr "在偏好行長度或編輯器寬度（取較小值）處自動換行。"

msgctxt "settings schema"
msgid "Soft wrap lines that exceed the editor width."
msgstr "對超過編輯器寬度的行自動換行。"

msgctxt "settings schema"
msgid "Sort snippets normally using the default comparison logic"
msgstr "使用預設比較邏輯正常排序程式碼片段"

msgctxt "settings schema"
msgid "Spacing between worktree entries in the project panel.\n\nDefault: comfortable"
msgstr "專案面板中工作樹項目之間的間距。\n\n預設值：comfortable"

msgctxt "settings schema"
msgid "Specifies the density of the UI.\nNote: This setting is still experimental. See [this tracking issue](https://github.com/zed-industries/zed/issues/18078)"
msgstr "指定 UI 的密度。\n注意：此設定仍為實驗性。請參閱[此追蹤問題](https://github.com/zed-industries/zed/issues/18078)"

msgctxt "settings schema"
msgid "Start searching as you type in project search, without pressing Enter."
msgstr "在專案搜尋中，輸入時立即開始搜尋，不需按 Enter。"

msgctxt "settings schema"
msgid "Sticky scroll related settings"
msgstr "固定捲動相關設定"

msgctxt "settings schema"
msgid "String substituted for `${separator}` in the window title format.\nInclude any surrounding whitespace in the value.\n\nDefault: ` — `"
msgstr "視窗標題格式中取代 `${separator}` 的字串。\n值中請包含前後的空白字元。\n\n預設值：` — `"

msgctxt "settings schema"
msgid "Suggesting and installing missing development tools."
msgstr "建議並安裝缺少的開發工具。"

msgctxt "settings schema"
msgid "Suggestions of the development tools (language servers, formatters) that\nthe language of an opened file needs, when they are missing."
msgstr "當已開啟檔案之語言所需的開發工具（語言伺服器、格式器）缺少時的建議。"

msgctxt "settings schema"
msgid "Supported reasoning effort levels, for example `[\"low\", \"medium\", \"high\"]."
msgstr "支援的思考深度層級，例如 `[\"low\", \"medium\", \"high\"]。"

msgctxt "settings schema"
msgid "TODO: this should just be a bool\nControls the behavior of formatting files when they are saved."
msgstr "TODO: this should just be a bool\n控制儲存檔案時的格式化行為。"

msgctxt "settings schema"
msgid "Takes up the full width of the window"
msgstr "佔用視窗的完整寬度"

msgctxt "settings schema"
msgid "Task configuration for this language.\n\nDefault: {}"
msgstr "此語言的工作設定。\n\n預設值：{}"

msgctxt "settings schema"
msgid "Terminal ANSI background color."
msgstr "終端機 ANSI 背景色。"

msgctxt "settings schema"
msgid "Terminal background color."
msgstr "終端機背景色。"

msgctxt "settings schema"
msgid "Terminal foreground color."
msgstr "終端機前景色。"

msgctxt "settings schema"
msgid "Text Color. Color of muted or deemphasized text. It is a subdued version of the standard text color."
msgstr "文字顏色。柔和或弱化文字的顏色。這是標準文字顏色較不醒目的版本。"

msgctxt "settings schema"
msgid "Text Color. Color of the placeholder text typically shown in input fields to guide the user to enter valid data."
msgstr "文字顏色。通常顯示在輸入欄位中，用來引導使用者輸入有效資料的預留位置文字顏色。"

msgctxt "settings schema"
msgid "Text Color. Color used for emphasis or highlighting certain text, like an active filter or a matched character in a search."
msgstr "文字顏色。用於強調或醒目提示特定文字的顏色，例如作用中的篩選器或搜尋中相符的字元。"

msgctxt "settings schema"
msgid "Text Color. Color used for text denoting disabled elements. Typically, the color is faded or grayed out to emphasize the disabled state."
msgstr "文字顏色。用於表示停用元素的文字顏色。通常會淡化或變灰，以強調停用狀態。"

msgctxt "settings schema"
msgid "Text Color. Default text color used for most text."
msgstr "文字顏色。大多數文字使用的預設文字顏色。"

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is highlighted."
msgstr "文字顏色。用於行被醒目提示時，編輯器裝訂邊中行號的文字。"

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter when the line is hovered over."
msgstr "文字顏色。用於滑鼠暫留在行上時，編輯器裝訂邊中行號的文字。"

msgctxt "settings schema"
msgid "Text Color. Used for the text of the line number in the editor gutter."
msgstr "文字顏色。用於編輯器裝訂邊中行號的文字。"

msgctxt "settings schema"
msgid "Text Color. Used to mark invisible characters in the editor.\n\nExample: spaces, tabs, carriage returns, etc."
msgstr "文字色彩。用於在編輯器中標示不可見字元。\n\n範例：空格、定位字元、歸位字元等。"

msgctxt "settings schema"
msgid "Text color used for CodeLens items in the editor."
msgstr "編輯器中用於 CodeLens 項目的文字顏色。"

msgctxt "settings schema"
msgid "The AI browser panel, which holds the AI tabs that AI agents drive."
msgstr "AI 瀏覽器面板，容納 AI 代理所操控的 AI 分頁。"

msgctxt "settings schema"
msgid "The API protocol to use for this model: \"anthropic\", \"openai_responses\", \"openai_chat\", or \"google\". Defaults to \"openai_chat\"."
msgstr "此模型使用的 API 協定：\"anthropic\"、\"openai_responses\"、\"openai_chat\" 或 \"google\"。預設為 \"openai_chat\"。"

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka n_ctx)."
msgstr "模型的上下文長度參數（又稱 n_ctx）。"

msgctxt "settings schema"
msgid "The Context Length parameter to the model (aka num_ctx or n_ctx)"
msgstr "模型的上下文長度參數（又稱 num_ctx 或 n_ctx）"

msgctxt "settings schema"
msgid "The HTTPS host the account's token signs in to, such as `github.com`.\nWithout one, pushing and pulling sign in as git is configured to."
msgstr "帳戶權杖登入的 HTTPS 主機，例如 `github.com`。\n若未設定，推送與拉取會依照 git 的設定登入。"

msgctxt "settings schema"
msgid "The OAuth client ID obtained from out-of-band registration with the\nauthorization server."
msgstr "透過向授權伺服器進行頻外註冊取得的 OAuth 用戶端 ID。"

msgctxt "settings schema"
msgid "The OAuth client secret, if this is a confidential client. For security,\nprefer providing this interactively; we will prompt and store it in\nthe system keychain."
msgstr "OAuth 用戶端密碼（若為機密用戶端）。基於安全性，建議以互動方式提供；系統會提示您輸入並將其儲存在系統金鑰鏈中。"

msgctxt "settings schema"
msgid "The OpenAI Chat Completions API (`/chat/completions`)."
msgstr "OpenAI Chat Completions API（`/chat/completions`）。"

msgctxt "settings schema"
msgid "The OpenAI Responses API (`/responses`)."
msgstr "OpenAI Responses API（`/responses`）。"

msgctxt "settings schema"
msgid "The OpenAI-compatible API this model must be called through."
msgstr "呼叫此模型時必須使用的 OpenAI 相容 API。"

msgctxt "settings schema"
msgid "The OpenType features to enable for rendering in text buffers."
msgstr "在文字緩衝區中轉譯時要啟用的 OpenType 功能。"

msgctxt "settings schema"
msgid "The OpenType features to enable for text in the UI."
msgstr "在 UI 中顯示文字時要啟用的 OpenType 功能。"

msgctxt "settings schema"
msgid "The SHA of the commit to apply."
msgstr "要套用之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit to check out."
msgstr "要簽出之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit to put the changes into."
msgstr "要放入變更之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit to remove."
msgstr "要移除之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit to reset to."
msgstr "要重設至之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit to start the branch from."
msgstr "作為分支起點之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit to tag."
msgstr "要加上標籤之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit to undo."
msgstr "要復原之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit whose message to rewrite."
msgstr "要重寫訊息之提交的 SHA。"

msgctxt "settings schema"
msgid "The SHA of the commit."
msgstr "提交的 SHA。"

msgctxt "settings schema"
msgid "The URL of the Zed server to connect to."
msgstr "要連線的 Zed 伺服器 URL。"

msgctxt "settings schema"
msgid "The URL of the remote context server."
msgstr "遠端 MCP 伺服器的 URL。"

msgctxt "settings schema"
msgid "The URL template used by `browser_panel::AskCopilot`. `{query}` is\nreplaced with the percent-encoded query when present; without the\nplaceholder the page is opened as-is and the query is put on the\nclipboard instead.\n\nDefault: https://github.com/copilot"
msgstr "`browser_panel::AskCopilot` 使用的 URL 範本。若有 `{query}`，會以百分比編碼的查詢取代；若沒有此預留位置，則直接開啟頁面，並改為將查詢放到剪貼簿。\n\n預設值：https://github.com/copilot"

msgctxt "settings schema"
msgid "The URL template used when the address bar input is not a URL, and for\n`browser_panel::SearchSelection`. `{query}` is replaced with the\npercent-encoded query.\n\nDefault: https://www.google.com/search?q={query}"
msgstr "網址列輸入不是 URL 時，以及 `browser_panel::SearchSelection` 使用的 URL 範本。`{query}` 會以百分比編碼的查詢取代。\n\n預設值：https://www.google.com/search?q={query}"

msgctxt "settings schema"
msgid "The URL used as the key for credential storage.\n\nWhen set, credentials are stored under this URL instead of `server_url`.\nThis allows running multiple Zed instances side by side without them\noverwriting each other's keychain entries."
msgstr "作為認證資訊存放鍵的 URL。\n\n設定後，認證資訊會儲存在此 URL 之下，而非 `server_url`。\n這可讓多個 ForgeKairos 執行個體並行執行，而不會互相覆寫彼此的金鑰鏈項目。"

msgctxt "settings schema"
msgid "The account each repository commits and pushes as, by the absolute path of\nthe repository's working directory. A repository not listed here uses git's\nown configuration. Only read from the user settings file.\n\nDefault: {}"
msgstr "各儲存庫用於提交與推送的帳戶，以儲存庫工作目錄的絕對路徑指定。未列在此處的儲存庫使用 git 本身的設定。只從使用者設定檔案讀取。\n\n預設值：{}"

msgctxt "settings schema"
msgid "The alt key\nSometimes also known as the 'meta' key"
msgstr "alt 鍵\n有時也稱為「meta」鍵"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline blame in units of columns.\n\nDefault: 7"
msgstr "原始碼行結尾與內嵌 Blame 開頭之間的邊框間距（以欄為單位）。\n\n預設值：7"

msgctxt "settings schema"
msgid "The amount of padding between the end of the source line and the start\nof the inline diagnostic in units of columns.\n\nDefault: 4"
msgstr "原始碼行結尾與內嵌診斷開頭之間的邊框間距（以欄為單位）。\n\n預設值：4"

msgctxt "settings schema"
msgid "The arguments to pass to the command. Use `*` for a single wildcard argument.\nIf the last element is `**`, then any trailing arguments are allowed."
msgstr "要傳遞給命令的引數。使用 `*` 代表單一萬用字元引數。\n若最後一個元素是 `**`，則允許任何後續引數。"

msgctxt "settings schema"
msgid "The arguments to pass to the program."
msgstr "要傳遞給程式的引數。"

msgctxt "settings schema"
msgid "The arguments to pass to the program.\n\nSupported placeholders:\n\n- `{buffer_path}`: the path of the buffer being formatted, or\n  `Untitled` when it has never been saved.\n- `{start_line}` and `{end_line}`: the first and last line of a\n  selected range, 1-based and inclusive. An argument naming either\n  of them is repeated once per selected range when formatting\n  selections (e.g. `\"--lines={start_line}:{end_line}\"` for\n  clang-format), and is dropped when formatting the whole buffer.\n  Naming them is also what marks the command as able to format\n  selections at all."
msgstr "要傳遞給程式的引數。\n\n支援的預留位置：\n\n- `{buffer_path}`：要格式化之緩衝區的路徑，若從未儲存則為 `Untitled`。\n- `{start_line}` 與 `{end_line}`：選取範圍的第一行與最後一行，從 1 起算且包含兩端。格式化選取範圍時，含有其中任一者的引數會針對每個選取範圍重複一次（例如 clang-format 的 `\"--lines={start_line}:{end_line}\"`），格式化整個緩衝區時則會捨棄。含有這些預留位置也表示該命令能夠格式化選取範圍。"

msgctxt "settings schema"
msgid "The author and committer email (`user.email`)."
msgstr "作者與提交者的電子郵件（`user.email`）。"

msgctxt "settings schema"
msgid "The author and committer name (`user.name`)."
msgstr "作者與提交者的名稱（`user.name`）。"

msgctxt "settings schema"
msgid "The available agent profiles."
msgstr "可用的代理設定檔。"

msgctxt "settings schema"
msgid "The background appearance of the window."
msgstr "視窗的背景外觀。"

msgctxt "settings schema"
msgid "The background color of the scrollbar track."
msgstr "捲軸軌道的背景顏色。"

msgctxt "settings schema"
msgid "The base URL for the provider (e.g., \"https://code.corp.big.com\")."
msgstr "提供者的基礎 URL（例如 \"https://code.corp.big.com\"）。"

msgctxt "settings schema"
msgid "The behavior of `editor::Rewrap`."
msgstr "`editor::Rewrap` 的行為。"

msgctxt "settings schema"
msgid "The border color of the minimap thumb."
msgstr "縮圖捲動滑桿的框線顏色。"

msgctxt "settings schema"
msgid "The border color of the scrollbar thumb."
msgstr "捲軸滑桿的框線顏色。"

msgctxt "settings schema"
msgid "The border color of the scrollbar track."
msgstr "捲軸軌道的框線顏色。"

msgctxt "settings schema"
msgid "The buffer's line height."
msgstr "緩衝區的行高。"

msgctxt "settings schema"
msgid "The capabilities granted to extensions."
msgstr "授予擴充功能的權限。"

msgctxt "settings schema"
msgid "The color of the minimap thumb when hovered over."
msgstr "游標暫留於縮圖捲動滑桿時的顏色。"

msgctxt "settings schema"
msgid "The color of the minimap thumb whilst being actively dragged."
msgstr "拖曳縮圖捲動滑桿時的顏色。"

msgctxt "settings schema"
msgid "The color of the minimap thumb."
msgstr "縮圖捲動滑桿的顏色。"

msgctxt "settings schema"
msgid "The color of the scrollbar thumb when hovered over."
msgstr "游標暫留於捲軸滑桿時的顏色。"

msgctxt "settings schema"
msgid "The color of the scrollbar thumb whilst being actively dragged."
msgstr "拖曳捲軸滑桿時的顏色。"

msgctxt "settings schema"
msgid "The color of the scrollbar thumb."
msgstr "捲軸滑桿的顏色。"

msgctxt "settings schema"
msgid "The column at which to soft-wrap lines, for buffers where soft-wrap\nis enabled.\n\nDefault: 80"
msgstr "在啟用自動換行的緩衝區中，自動換行的欄位置。\n\n預設值：80"

msgctxt "settings schema"
msgid "The command key, on macos\nthe windows key, on windows\nthe super key, on linux"
msgstr "macOS 上的 command 鍵\nWindows 上的 Windows 鍵\nLinux 上的 super 鍵"

msgctxt "settings schema"
msgid "The command to execute."
msgstr "要執行的命令。"

msgctxt "settings schema"
msgid "The content of a serialized theme."
msgstr "序列化佈景主題的內容。"

msgctxt "settings schema"
msgid "The contents of the edit prediction settings."
msgstr "編輯預測設定的內容。"

msgctxt "settings schema"
msgid "The control key"
msgstr "Ctrl 鍵"

msgctxt "settings schema"
msgid "The debounce delay before querying highlights from the language\nserver based on the current cursor location.\n\nDefault: 75"
msgstr "依據目前游標位置向語言伺服器查詢醒目提示前的防彈跳延遲。\n\n預設值：75"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 0"
msgstr "停止輸入後自動要求預測前的防彈跳延遲（毫秒）。設為 0 可立即要求預測。\n\n預設值：0"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 150"
msgstr "停止輸入後自動要求預測前的防彈跳延遲（毫秒）。設為 0 可立即要求預測。\n\n預設值：150"

msgctxt "settings schema"
msgid "The debounce delay in milliseconds before automatically requesting a prediction\nafter typing stops. Set to 0 to request predictions immediately.\n\nDefault: 75"
msgstr "停止輸入後自動要求預測前的防彈跳延遲（毫秒）。設為 0 可立即要求預測。\n\n預設值：75"

msgctxt "settings schema"
msgid "The default UI density."
msgstr "預設的 UI 密度。"

msgctxt "settings schema"
msgid "The default behavior when opening paths from the CLI without\nan explicit `-e` or `-n` flag.\n\nDefault: existing_window"
msgstr "從 CLI 開啟路徑且未明確指定 `-e` 或 `-n` 旗標時的預設行為。\n\n預設值：existing_window"

msgctxt "settings schema"
msgid "The default behavior when opening projects from the UI.\n\nDefault: existing_window"
msgstr "從 UI 開啟專案時的預設行為。\n\n預設值：existing_window"

msgctxt "settings schema"
msgid "The default font size for rendering in text buffers."
msgstr "在文字緩衝區中轉譯的預設字型大小。"

msgctxt "settings schema"
msgid "The default font size for text in the UI."
msgstr "UI 文字的預設字型大小。"

msgctxt "settings schema"
msgid "The default language model selected when using this profile."
msgstr "使用此設定檔時選用的預設語言模型。"

msgctxt "settings schema"
msgid "The default line height."
msgstr "預設的行高。"

msgctxt "settings schema"
msgid "The default mode to use for this agent.\n\nNote: Not only all agents support modes.\n\nDefault: None"
msgstr "此代理使用的預設模式。\n\n注意：並非所有代理都支援模式。\n\n預設值：None"

msgctxt "settings schema"
msgid "The default model to use when creating new chats and for other features when a specific model is not specified."
msgstr "建立新聊天及未指定特定模型時其他功能所使用的預設模型。"

msgctxt "settings schema"
msgid "The default profile to use in the Agent.\n\nDefault: write"
msgstr "代理中使用的預設設定檔。\n\n預設值：write"

msgctxt "settings schema"
msgid "The default temperature to use for this model."
msgstr "此模型使用的預設溫度。"

msgctxt "settings schema"
msgid "The delay in milliseconds that must elapse before drag and drop is allowed. Otherwise, a new text selection is created.\n\nDefault: 300"
msgstr "允許拖放前必須經過的延遲（毫秒）。否則會建立新的文字選取範圍。\n\n預設值：300"

msgctxt "settings schema"
msgid "The display name for the provider (e.g., \"BigCorp GitHub\")."
msgstr "提供者的顯示名稱（例如 \"BigCorp GitHub\"）。"

msgctxt "settings schema"
msgid "The dock position of the debug panel\n\nDefault: Bottom"
msgstr "偵錯面板的停駐位置\n\n預設值：Bottom"

msgctxt "settings schema"
msgid "The edit prediction settings."
msgstr "編輯預測設定。"

msgctxt "settings schema"
msgid "The editor will not scroll beyond the last line."
msgstr "編輯器不會捲動超過最後一行。"

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by one page."
msgstr "編輯器將捲動超過最後一行一頁。"

msgctxt "settings schema"
msgid "The editor will scroll beyond the last line by the same number of lines as vertical_scroll_margin."
msgstr "編輯器將捲動超過最後一行與 vertical_scroll_margin 相同的行數。"

msgctxt "settings schema"
msgid "The extensions that should be automatically installed by Zed.\n\nThis is used to make functionality provided by extensions (e.g., language support)\navailable out-of-the-box.\n\nDefault: {}"
msgstr "ForgeKairos 應自動安裝的擴充功能。\n\n用於讓擴充功能提供的功能（例如語言支援）可立即使用。\n\n預設值：{}"

msgctxt "settings schema"
msgid "The external program to run."
msgstr "要執行的外部程式。"

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in text buffers."
msgstr "在文字緩衝區中轉譯時使用的後援字型。"

msgctxt "settings schema"
msgid "The font fallbacks to use for rendering in the UI."
msgstr "在 UI 中轉譯時使用的後援字型。"

msgctxt "settings schema"
msgid "The font size for agent responses in the agent panel. Falls back to the UI font size if unset."
msgstr "代理面板中代理回應的字型大小。若未設定，則退回使用 UI 字型大小。"

msgctxt "settings schema"
msgid "The font size for user messages in the agent panel."
msgstr "代理面板中使用者訊息的字型大小。"

msgctxt "settings schema"
msgid "The font size to use for rendering in the markdown preview.\nFalls back to the UI font size if unset."
msgstr "Markdown 預覽中轉譯使用的字型大小。\n未設定時改用 UI 字型大小。"

msgctxt "settings schema"
msgid "The function key"
msgstr "Fn 鍵"

msgctxt "settings schema"
msgid "The granularity of one 'step' in the stepping requests `next`, `stepIn`, `stepOut`, and `stepBack`."
msgstr "步進要求 `next`、`stepIn`、`stepOut` 與 `stepBack` 中一次「步進」的粒度。"

msgctxt "settings schema"
msgid "The guardrail identifier (ARN or ID) to apply to Bedrock API requests."
msgstr "要套用至 Bedrock API 要求的防護機制識別碼（ARN 或 ID）。"

msgctxt "settings schema"
msgid "The guardrail version to use. Defaults to \"DRAFT\" if not specified."
msgstr "要使用的防護機制版本。未指定時預設為 \"DRAFT\"。"

msgctxt "settings schema"
msgid "The icon theme to use for dark mode."
msgstr "深色模式使用的圖示佈景主題。"

msgctxt "settings schema"
msgid "The icon theme to use for light mode."
msgstr "淺色模式使用的圖示佈景主題。"

msgctxt "settings schema"
msgid "The key commits are signed with (`user.signingkey`), when signing is on."
msgstr "啟用簽署時用於簽署提交的金鑰（`user.signingkey`）。"

msgctxt "settings schema"
msgid "The key to use for adding multiple cursors\n\nDefault: alt"
msgstr "用於新增多重游標的按鍵\n\n預設值：alt"

msgctxt "settings schema"
msgid "The language of the UI: \"system\" to follow the operating system, or a BCP 47\ntag such as \"en\", \"ja\" or \"pt-BR\".\n\nDefault: \"system\""
msgstr "UI 的語言：\"system\" 表示依循作業系統，或使用 BCP 47 標籤，例如 \"en\"、\"ja\" 或 \"pt-BR\"。\n\n預設值：\"system\""

msgctxt "settings schema"
msgid "The language server and, in C and C++, the symbol index."
msgstr "語言伺服器，以及 C 與 C++ 中的符號索引。"

msgctxt "settings schema"
msgid "The layout of window control buttons as represented by user settings.\n\nCustom layout strings use the GNOME `button-layout` format (e.g.\n`\"close:minimize,maximize\"`)."
msgstr "使用者設定中表示的視窗控制按鈕版面配置。\n\n自訂版面配置字串使用 GNOME 的 `button-layout` 格式（例如 `\"close:minimize,maximize\"`）。"

msgctxt "settings schema"
msgid "The layout of window control buttons in the title bar (Linux only).\n\nThis can be set to \"platform_default\" to follow the system configuration, or\n\"standard\" to use Zed's built-in layout. For custom layouts, use a\nGNOME-style layout string like \"close:minimize,maximize\".\n\nDefault: \"platform_default\""
msgstr "標題列中視窗控制按鈕的版面配置（僅限 Linux）。\n\n可設為 \"platform_default\" 以依循系統設定，或設為 \"standard\" 以使用 ForgeKairos 的內建版面配置。若要自訂版面配置，請使用 GNOME 樣式的版面配置字串，例如 \"close:minimize,maximize\"。\n\n預設值：\"platform_default\""

msgctxt "settings schema"
msgid "The list of custom Git hosting providers."
msgstr "自訂 Git 代管提供者的清單。"

msgctxt "settings schema"
msgid "The list of language servers to use (or disable) for this language.\n\nThis array should consist of language server IDs, as well as the following\nspecial tokens:\n- `\"!<language_server_id>\"` - A language server ID prefixed with a `!` will be disabled.\n- `\"...\"` - A placeholder to refer to the **rest** of the registered language servers for this language.\n\nDefault: [\"...\"]"
msgstr "此語言要使用（或停用）的語言伺服器清單。\n\n此陣列應由語言伺服器 ID 以及下列特殊標記組成：\n- `\"!<language_server_id>\"` - 以 `!` 為前置詞的語言伺服器 ID 會被停用。\n- `\"...\"` - 代表此語言其**餘**已註冊之語言伺服器的預留位置。\n\n預設值：[\"...\"]"

msgctxt "settings schema"
msgid "The maximum amount of time to wait for responses from language servers, in seconds.\nA value of `0` will result in no timeout being applied (causing all LSP responses to wait indefinitely until completed).\n\nDefault: `120`"
msgstr "等待語言伺服器回應的時間上限（秒）。\n值為 `0` 表示不套用逾時（所有 LSP 回應都會無限期等待直到完成）。\n\n預設值：`120`"

msgctxt "settings schema"
msgid "The maximum line length a buffer may contain before language server features are disabled for the entire buffer.\n\nDefault: `20000`"
msgstr "緩衝區可包含的行長度上限，超過時會對整個緩衝區停用語言伺服器功能。\n\n預設值：`20000`"

msgctxt "settings schema"
msgid "The maximum number of completion tokens allowed by the model (o1-* only)"
msgstr "模型允許的最大生成 Token 數（僅限 o1-*）"

msgctxt "settings schema"
msgid "The maximum number of lines to keep in the scrollback history.\nMaximum allowed value is 100_000, all values above that will be treated as 100_000.\n0 disables the scrolling.\nExisting terminals will not pick up this change until they are recreated.\nSee <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">Alacritty documentation</a> for more information.\n\nDefault: 10_000"
msgstr "捲動緩衝區歷程記錄中保留的行數上限。\n允許的最大值為 100_000，大於此值的所有值都會視為 100_000。\n0 會停用捲動。\n現有的終端機要重新建立後才會套用此變更。\n如需詳細資訊，請參閱 <a href=\"https://github.com/alacritty/alacritty/blob/cb3a79dbf6472740daca8440d5166c1d4af5029e/extra/man/alacritty.5.scd?plain=1#L207-L213\">Alacritty 文件</a>。\n\n預設值：10_000"

msgctxt "settings schema"
msgid "The maximum number of output tokens allowed by the model."
msgstr "模型允許的最大輸出 Token 數。"

msgctxt "settings schema"
msgid "The maximum width, in pixels, of the rendered markdown content when\n`limit_content_width` is enabled.\n\nDefault: 800"
msgstr "啟用 `limit_content_width` 時，轉譯之 Markdown 內容的寬度上限（像素）。\n\n預設值：800"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast between foreground and background colors.\n\nAPCA (Accessible Perceptual Contrast Algorithm) is more accurate than WCAG 2.x,\nespecially for dark mode. Values range from 0 to 106.\n\nBased on APCA Readability Criterion (ARC) Bronze Simple Mode:\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0: No contrast adjustment\n- 45: Minimum for large fluent text (36px+)\n- 60: Minimum for other content text\n- 75: Minimum for body text\n- 90: Preferred for body text\n\nDefault: 45"
msgstr "前景與背景色彩之間的最小 APCA 感知對比度。\n\nAPCA（Accessible Perceptual Contrast Algorithm）比 WCAG 2.x 更精確，尤其是在深色模式下。值的範圍為 0 到 106。\n\n依據 APCA Readability Criterion (ARC) Bronze Simple Mode：\nhttps://readtech.org/ARC/tests/bronze-simple-mode/\n- 0：不調整對比度\n- 45：大型流暢文字（36px 以上）的最小值\n- 60：其他內容文字的最小值\n- 75：本文的最小值\n- 90：本文的建議值\n\n預設值：45"

msgctxt "settings schema"
msgid "The minimum APCA perceptual contrast to maintain when\nrendering text over highlight backgrounds in the editor.\n\nValues range from 0 to 106. Set to 0 to disable adjustments.\nDefault: 45"
msgstr "在編輯器中於醒目提示背景上轉譯文字時要維持的最小 APCA 感知對比度。\n\n值的範圍為 0 到 106。設為 0 可停用調整。\n預設值：45"

msgctxt "settings schema"
msgid "The minimum column number to show the inline blame information at\n\nDefault: 0"
msgstr "顯示內嵌 Blame 資訊的最小欄號\n\n預設值：0"

msgctxt "settings schema"
msgid "The minimum column to display inline diagnostics. This setting can be\nused to horizontally align inline diagnostics at some position. Lines\nlonger than this value will still push diagnostics further to the right.\n\nDefault: 0"
msgstr "顯示內嵌診斷的最小欄。此設定可用於將內嵌診斷水平對齊在某個位置。比此值更長的行仍會將診斷推得更右邊。\n\n預設值：0"

msgctxt "settings schema"
msgid "The minimum width (in em-widths) at which the split diff view is used.\nWhen the editor is narrower than this, the diff view automatically\nswitches to unified mode and switches back when the editor is wide\nenough. Set to 0 to disable automatic switching.\n\nDefault: 100"
msgstr "使用並排差異檢視的最小寬度（以 em 寬度為單位）。\n編輯器窄於此值時，差異檢視會自動切換為內嵌模式，編輯器夠寬時再切換回來。設為 0 可停用自動切換。\n\n預設值：100"

msgctxt "settings schema"
msgid "The mode in which edit predictions should be displayed."
msgstr "顯示編輯預測的模式。"

msgctxt "settings schema"
msgid "The mode use to select a theme.\n\n`Light` and `Dark` will select their respective themes.\n\n`System` will select the theme based on the system's appearance."
msgstr "用於選取佈景主題的模式。\n\n`Light` 與 `Dark` 會選取各自的佈景主題。\n\n`System` 會依據系統的外觀選取佈景主題。"

msgctxt "settings schema"
msgid "The mode used to determine which theme to use."
msgstr "決定要使用哪個佈景主題的模式。"

msgctxt "settings schema"
msgid "The mode used to display edit predictions in the buffer.\nProvider support required."
msgstr "在緩衝區中顯示編輯預測所使用的模式。\n需要提供者支援。"

msgctxt "settings schema"
msgid "The model id as expected in Bedrock Mantle request bodies, e.g. `openai.gpt-5.5`."
msgstr "Bedrock Mantle 要求內文中預期的模型 ID，例如 `openai.gpt-5.5`。"

msgctxt "settings schema"
msgid "The model id reported by the llama.cpp server (its `--alias` or the model file path)."
msgstr "llama.cpp 伺服器回報的模型 ID（其 `--alias` 或模型檔案路徑）。"

msgctxt "settings schema"
msgid "The model name in the Ollama API (e.g. \"llama3.2:latest\")"
msgstr "Ollama API 中的模型名稱（例如 \"llama3.2:latest\"）"

msgctxt "settings schema"
msgid "The model to use for subagents spawned via the `spawn_agent` tool. Defaults to the parent agent's model when not specified."
msgstr "透過 `spawn_agent` 工具產生子代理時要使用的模型。未指定時預設使用父代理的模型。"

msgctxt "settings schema"
msgid "The model's context window size."
msgstr "模型的上下文視窗大小。"

msgctxt "settings schema"
msgid "The model's mode (e.g. thinking)"
msgstr "模型的模式（例如 thinking）"

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the agent panel."
msgstr "模型在 ForgeKairos 介面中的名稱，例如代理面板中的模型選擇器下拉選單。"

msgctxt "settings schema"
msgid "The model's name in Zed's UI, such as in the model selector dropdown menu in the assistant panel."
msgstr "模型在 ForgeKairos UI 中的名稱，例如助理面板中的模型選擇器下拉式選單。"

msgctxt "settings schema"
msgid "The model's name in the Anthropic API. e.g. claude-3-5-sonnet-latest, claude-3-opus-20240229, etc"
msgstr "模型在 Anthropic API 中的名稱，例如 claude-3-5-sonnet-latest、claude-3-opus-20240229 等"

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-20240620"
msgstr "模型在提供者 API 中的名稱，例如 claude-3-5-sonnet-20240620"

msgctxt "settings schema"
msgid "The model's name in the provider's API. e.g. claude-3-5-sonnet-latest"
msgstr "模型在提供者 API 中的名稱，例如 claude-3-5-sonnet-latest"

msgctxt "settings schema"
msgid "The multiplier for scrolling with the mouse wheel.\n\nDefault: 1.0"
msgstr "使用滑鼠滾輪捲動的倍數。\n\n預設值：1.0"

msgctxt "settings schema"
msgid "The name displayed in the UI, such as in the agent panel model dropdown menu."
msgstr "在介面中顯示的名稱，例如代理面板的模型下拉選單。"

msgctxt "settings schema"
msgid "The name of a font to use for agent responses in the agent panel. Falls back to the UI font if unset."
msgstr "代理面板中代理回應要使用的字型名稱。若未設定，則退回使用 UI 字型。"

msgctxt "settings schema"
msgid "The name of a font to use for code (code blocks and inline code) in the\nmarkdown preview. Falls back to the buffer font if unset."
msgstr "Markdown 預覽中程式碼（程式碼區塊與內嵌程式碼）使用的字型名稱。未設定時改用緩衝區字型。"

msgctxt "settings schema"
msgid "The name of a font to use for rendering in text buffers."
msgstr "用於文字緩衝區顯示的字型名稱。"

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the UI."
msgstr "用於介面顯示的字型名稱。"

msgctxt "settings schema"
msgid "The name of a font to use for rendering in the markdown preview.\nFalls back to the UI font if unset."
msgstr "Markdown 預覽中轉譯使用的字型名稱。\n未設定時改用 UI 字型。"

msgctxt "settings schema"
msgid "The name of a font to use for user messages in the agent panel. Falls back to the buffer font if unset."
msgstr "代理面板中使用者訊息要使用的字型名稱。若未設定，則退回使用緩衝區字型。"

msgctxt "settings schema"
msgid "The name of the Zed theme to use."
msgstr "要使用的 ForgeKairos 佈景主題名稱。"

msgctxt "settings schema"
msgid "The name of the icon theme to use."
msgstr "要使用的圖示佈景主題名稱。"

msgctxt "settings schema"
msgid "The name of the language server to format with"
msgstr "用於格式化的語言伺服器名稱"

msgctxt "settings schema"
msgid "The name of the model.\n\nDefault: \"\""
msgstr "模型的名稱。\n\n預設值：\"\""

msgctxt "settings schema"
msgid "The name the account is picked by, unique among the accounts."
msgstr "用於選擇帳戶的名稱，在所有帳戶中不可重複。"

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files, which answers\nproject-wide symbol search, \"go to definition\" when the language server has\nno answer, and callers and callees, without compilation information."
msgstr "C 與 C++ 檔案以名稱為基礎的符號索引，不需要編譯資訊，即可回答專案範圍的符號搜尋、語言伺服器沒有答案時的「前往定義」，以及呼叫端與被呼叫端。"

msgctxt "settings schema"
msgid "The name-based symbol index of C and C++ files."
msgstr "C 與 C++ 檔案以名稱為基礎的符號索引。"

msgctxt "settings schema"
msgid "The number of characters to keep on either side when scrolling with the mouse.\n\nDefault: 5."
msgstr "使用滑鼠捲動時，兩側要保留的字元數。\n\n預設值：5。"

msgctxt "settings schema"
msgid "The number of lines to keep above/below the cursor when auto-scrolling.\n\nDefault: 3."
msgstr "自動捲動時，游標上方/下方要保留的行數。\n\n預設值：3。"

msgctxt "settings schema"
msgid "The number of seconds to keep the connection open after the last request"
msgstr "最後一次要求後保持連線開啟的秒數"

msgctxt "settings schema"
msgid "The page opened when a built-in browser panel or tab first loads.\n\nDefault: https://m365.cloud.microsoft/chat"
msgstr "內建瀏覽器面板或分頁第一次載入時開啟的頁面。\n\n預設值：https://m365.cloud.microsoft/chat"

msgctxt "settings schema"
msgid "The path of the directory where journal entries are stored.\n\nDefault: `~`"
msgstr "儲存日記項目之資料夾的路徑。\n\n預設值：`~`"

msgctxt "settings schema"
msgid "The path to the Node binary."
msgstr "Node 執行檔的路徑。"

msgctxt "settings schema"
msgid "The path to the npm binary Zed should use (defaults to `.path/../npm`)."
msgstr "ForgeKairos 應使用的 npm 執行檔路徑（預設為 `.path/../npm`）。"

msgctxt "settings schema"
msgid "The position of outline panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "大綱面板的位置\n\n預設值：right（Agentic 版面配置）、left（Classic 版面配置）"

msgctxt "settings schema"
msgid "The position of project panel\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "專案面板的位置\n\n預設值：right（Agentic 版面配置）、left（Classic 版面配置）"

msgctxt "settings schema"
msgid "The private key file (an absolute path, or one starting with `~`) that pushing, pulling\nand fetching reach SSH remotes with, offered alone (`IdentitiesOnly`). Local projects\nonly. Not used when `GIT_SSH_COMMAND`, `GIT_SSH` or `core.sshCommand` is set."
msgstr "推送、拉取與擷取連線至 SSH 遠端時單獨提供（`IdentitiesOnly`）的私密金鑰檔案（絕對路徑，或以 `~` 開頭的路徑）。僅限本機專案。設定了 `GIT_SSH_COMMAND`、`GIT_SSH` 或 `core.sshCommand` 時不會使用。"

msgctxt "settings schema"
msgid "The program to run."
msgstr "要執行的程式。"

msgctxt "settings schema"
msgid "The prompt format to use for completions. Set to `\"\"` to have the format be derived from the model name.\n\nDefault: \"\""
msgstr "用於完成項目的提示格式。設為 `\"\"` 可讓格式從模型名稱推導。\n\n預設值：\"\""

msgctxt "settings schema"
msgid "The provider of the language model."
msgstr "語言模型的提供者。"

msgctxt "settings schema"
msgid "The provider that supplies edit predictions."
msgstr "提供編輯預測的提供者。"

msgctxt "settings schema"
msgid "The regex pattern to match."
msgstr "要比對的規則運算式模式。"

msgctxt "settings schema"
msgid "The relative width of the left padding of the central pane from the\nworkspace when the centered layout is used.\n\nDefault: 0.2"
msgstr "使用置中版面配置時，中央窗格相對於工作區的左側邊框間距相對寬度。\n\n預設值：0.2"

msgctxt "settings schema"
msgid "The settings for a particular language."
msgstr "特定語言的設定。"

msgctxt "settings schema"
msgid "The settings for cursor shape."
msgstr "游標形狀的設定。"

msgctxt "settings schema"
msgid "The settings for indent guides."
msgstr "縮排輔助線的設定。"

msgctxt "settings schema"
msgid "The settings for individual languages."
msgstr "個別語言的設定。"

msgctxt "settings schema"
msgid "The settings for inlay hints."
msgstr "內嵌提示的設定。"

msgctxt "settings schema"
msgid "The settings for the image viewer."
msgstr "影像檢視器的設定。"

msgctxt "settings schema"
msgid "The settings for the markdown preview."
msgstr "Markdown 預覽的設定。"

msgctxt "settings schema"
msgid "The settings for this context server specified by the extension.\n\nConsult the documentation for the context server to see what settings\nare supported."
msgstr "由擴充功能指定之此 MCP 伺服器的設定。\n\n請參閱該 MCP 伺服器的文件，以了解支援哪些設定。"

msgctxt "settings schema"
msgid "The settings overrides for this profile."
msgstr "此設定檔的設定覆寫。"

msgctxt "settings schema"
msgid "The shape of a selection cursor."
msgstr "選取游標的形狀。"

msgctxt "settings schema"
msgid "The shift key"
msgstr "Shift 鍵"

msgctxt "settings schema"
msgid "The size of the context window, indicating the maximum number of tokens the model can process."
msgstr "上下文視窗的大小，表示模型可處理的最大 Token 數量。"

msgctxt "settings schema"
msgid "The size of the workspace split drop targets on the outer edges.\nGiven as a fraction that will be multiplied by the smaller dimension of the workspace.\n\nDefault: `0.2` (20% of the smaller dimension of the workspace)"
msgstr "外側邊緣上工作區分割放置目標的大小。\n以比例表示，會乘以工作區較短的那一邊。\n\n預設值：`0.2`（工作區較短邊的 20%）"

msgctxt "settings schema"
msgid "The smallest model context window (in tokens) for which auto-compaction\nstill runs. Models below this are left uncompacted and the UI warns\nabout the token limit instead. Lower this to make auto-compaction work\nwith local models that have a small context window. Values below 8000\nare clamped to 8000.\n\nDefault: 80000"
msgstr "仍會執行自動壓縮之模型的最小上下文視窗（Token 數）。低於此值的模型不會被壓縮，UI 會改為警告 Token 上限。若要讓自動壓縮在上下文視窗較小的本機模型上運作，請調低此值。小於 8000 的值會限制為 8000。\n\n預設值：80000"

msgctxt "settings schema"
msgid "The standard spacing of entries."
msgstr "項目的標準間距。"

msgctxt "settings schema"
msgid "The state of the modifier keys at some point in time"
msgstr "某時間點修飾鍵的狀態"

msgctxt "settings schema"
msgid "The step should allow one instruction to execute (e.g. one x86 instruction)."
msgstr "此步驟應允許執行一條指令（例如一條 x86 指令）。"

msgctxt "settings schema"
msgid "The step should allow the program to run until the current source line has executed."
msgstr "此步驟應允許程式執行，直到目前的原始碼行執行完畢。"

msgctxt "settings schema"
msgid "The step should allow the program to run until the current statement has finished executing.\nThe meaning of a statement is determined by the adapter and it may be considered equivalent to a line.\nFor example 'for(int i = 0; i < 10; i++)' could be considered to have 3 statements 'int i = 0', 'i < 10', and 'i++'."
msgstr "此步驟應讓程式執行，直到目前的陳述式執行完畢。\n陳述式的意義由介面卡決定，可能視為等同於一行。\n例如 'for(int i = 0; i < 10; i++)' 可能被視為有 3 個陳述式：'int i = 0'、'i < 10' 與 'i++'。"

msgctxt "settings schema"
msgid "The styles for syntax nodes."
msgstr "語法節點的樣式。"

msgctxt "settings schema"
msgid "The subscription for this model: \"zen\" or \"go\". Defaults to Zen."
msgstr "此模型的訂閱：\"zen\" 或 \"go\"。預設為 Zen。"

msgctxt "settings schema"
msgid "The task settings for a particular language."
msgstr "特定語言的工作設定。"

msgctxt "settings schema"
msgid "The text rendering mode to use.\n\nDefault: platform_default"
msgstr "要使用的文字轉譯模式。\n\n預設值：platform_default"

msgctxt "settings schema"
msgid "The theme to use for dark mode."
msgstr "深色模式使用的佈景主題。"

msgctxt "settings schema"
msgid "The theme to use for light mode."
msgstr "淺色模式使用的佈景主題。"

msgctxt "settings schema"
msgid "The theme to use for the markdown preview.\nFalls back to the main editor theme if unset."
msgstr "Markdown 預覽使用的佈景主題。\n未設定時改用主要編輯器的佈景主題。"

msgctxt "settings schema"
msgid "The threshold at which auto-compaction runs. This is one of:\n\n- A percentage string ending in `%`, e.g. `\"90%\"`, measured against the\n  model's context window. `\"90%\"` compacts once the context is 90% full.\n- A positive integer: compaction runs once that many tokens have been\n  used. For example, `100000` compacts after 100,000 tokens are used.\n- A negative integer: compaction runs once that many tokens remain in\n  the context window. For example, `-20000` compacts once there are\n  fewer than 20,000 tokens of headroom left in the context window.\n\n`0` is not a valid threshold.\n\nDefault: \"90%\""
msgstr "執行自動壓縮的閾值。可為下列其中之一：\n\n- 以 `%` 結尾的百分比字串，例如 `\"90%\"`，以模型的上下文視窗為基準測量。`\"90%\"` 會在上下文填滿 90% 時壓縮。\n- 正整數：使用了這麼多 Token 時執行壓縮。例如 `100000` 會在使用 100,000 個 Token 後壓縮。\n- 負整數：上下文視窗中剩餘這麼多 Token 時執行壓縮。例如 `-20000` 會在上下文視窗剩餘空間少於 20,000 個 Token 時壓縮。\n\n`0` 不是有效的閾值。\n\n預設值：\"90%\""

msgctxt "settings schema"
msgid "The topic whose entries to show first, such as \"merge_request\". Without it, the usual order."
msgstr "要優先顯示其項目的主題，例如 \"merge_request\"。若未設定，則使用一般順序。"

msgctxt "settings schema"
msgid "The type of the provider.\n\nMust be one of `github`, `gitlab`, `bitbucket`, `gitea`, `forgejo`, `sourcehut`, or `tangled`."
msgstr "提供者的類型。\n\n必須是 `github`、`gitlab`、`bitbucket`、`gitea`、`forgejo`、`sourcehut` 或 `tangled` 之一。"

msgctxt "settings schema"
msgid "The unit to use for displaying image file sizes.\n\nDefault: \"binary\""
msgstr "顯示影像檔案大小時使用的單位。\n\n預設值：\"binary\""

msgctxt "settings schema"
msgid "The user name on `host` that goes with the token."
msgstr "`host` 上與權杖對應的使用者名稱。"

msgctxt "settings schema"
msgid "The value to pass to the CLI's `--effort`, such as `low`, `medium` or `high`. Without it, the CLI uses its default."
msgstr "要傳遞給 CLI 之 `--effort` 的值，例如 `low`、`medium` 或 `high`。若未設定，CLI 會使用其預設值。"

msgctxt "settings schema"
msgid "The weight of the UI font in CSS units from 100 to 900."
msgstr "UI 字型的粗細，以 CSS 單位表示，範圍為 100 到 900。"

msgctxt "settings schema"
msgid "The weight of the editor font in CSS units from 100 to 900."
msgstr "編輯器字型的粗細，以 CSS 單位表示，範圍為 100 到 900。"

msgctxt "settings schema"
msgid "The width of the active indent guide in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "使用中縮排輔助線的寬度（像素），介於 1 到 10 之間。\n\n預設值：1"

msgctxt "settings schema"
msgid "The width of the git diff hunk indicators in the gutter.\nUse \"default\" to scale with the buffer font size, or {\"custom\": <pixels>} for a fixed width.\n\nDefault: \"default\""
msgstr "裝訂邊中 git 差異區塊指示器的寬度。\n使用 \"default\" 會隨緩衝區字型大小縮放，或使用 {\"custom\": <pixels>} 指定固定寬度。\n\n預設值：\"default\""

msgctxt "settings schema"
msgid "The width of the indent guides in pixels, between 1 and 10.\n\nDefault: 1"
msgstr "縮排輔助線的寬度（像素），介於 1 到 10 之間。\n\n預設值：1"

msgctxt "settings schema"
msgid "The window manager or compositor draws the server-side window\ndecorations (not supported by GNOME Wayland)."
msgstr "由視窗管理員或合成器繪製伺服器端的視窗裝飾（GNOME Wayland 不支援）。"

msgctxt "settings schema"
msgid "Theme name."
msgstr "佈景主題名稱。"

msgctxt "settings schema"
msgid "Thinking blocks are always collapsed by default."
msgstr "思考區塊預設一律摺疊。"

msgctxt "settings schema"
msgid "Thinking blocks are always fully expanded by default (no height constraint)."
msgstr "思考區塊預設一律完整展開（無高度限制）。"

msgctxt "settings schema"
msgid "Thinking blocks auto-expand with a height constraint during streaming,\nthen remain in their constrained state when complete. Users can click\nto fully expand or collapse."
msgstr "思考區塊在串流期間會以高度限制自動展開，完成後維持受限狀態。使用者可以按一下以完全展開或摺疊。"

msgctxt "settings schema"
msgid "Thinking blocks fully expand during streaming, then auto-collapse\nwhen the model finishes thinking. Users can re-expand after collapse."
msgstr "思考區塊在串流期間會完全展開，模型思考完成後自動摺疊。摺疊後使用者可以再次展開。"

msgctxt "settings schema"
msgid "Thinking effort levels this model accepts in Ollama's `think` parameter,\nfor example `[\"low\", \"medium\", \"high\"]`. Only some models (e.g. `gpt-oss`)\naccept a level instead of a plain on/off; leave unset for those that don't."
msgstr "此模型在 Ollama 的 `think` 參數中接受的思考深度層級，例如 `[\"low\", \"medium\", \"high\"]`。只有部分模型（例如 `gpt-oss`）接受層級而非單純的開/關；不接受的模型請勿設定。"

msgctxt "settings schema"
msgid "This base keymap settings adjusts the default keybindings in Zed to be similar\nto other common code editors. By default, Zed's keymap closely follows VSCode's\nkeymap, with minor adjustments, this corresponds to the \"VSCode\" setting.\n\nDefault: VSCode"
msgstr "此基礎按鍵對應設定會調整 ForgeKairos 的預設按鍵繫結，使其與其他常見程式碼編輯器相似。預設情況下，ForgeKairos 的按鍵對應與 VSCode 的按鍵對應非常接近，只做了少許調整，對應於 \"VSCode\" 設定。\n\n預設值：VSCode"

msgctxt "settings schema"
msgid "Time in milliseconds until timeout error when connecting to a TCP debug adapter\n\nDefault: 2000ms"
msgstr "連線至 TCP 偵錯介面卡時發生逾時錯誤前的時間（毫秒）\n\n預設值：2000ms"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before hiding the hover popover\nafter the mouse moves away from the hover target.\nOnly applies when `hover_popover_sticky` is enabled.\n\nDefault: 300"
msgstr "滑鼠離開暫留目標後，隱藏暫留快顯視窗前等待的時間（毫秒）。\n只在啟用 `hover_popover_sticky` 時套用。\n\n預設值：300"

msgctxt "settings schema"
msgid "Time to wait in milliseconds before showing the informational hover box.\nThis delay also applies to auto signature help when `auto_signature_help` is enabled.\n\nDefault: 300"
msgstr "顯示資訊暫留方塊前等待的時間（毫秒）。\n啟用 `auto_signature_help` 時，此延遲也套用於自動簽章說明。\n\n預設值：300"

msgctxt "settings schema"
msgid "Timeout for hover and Cmd-click path hyperlink discovery in milliseconds.\n\nDefault: 1"
msgstr "暫留與 Cmd+按一下時偵測路徑超連結的逾時（毫秒）。\n\n預設值：1"

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to 60 if not specified."
msgstr "工具呼叫的逾時時間（秒）。未指定時預設為 60。"

msgctxt "settings schema"
msgid "Timeout for tool calls in seconds. Defaults to global context_server_timeout if not specified."
msgstr "工具呼叫的逾時時間（秒）。未指定時預設為全域 context_server_timeout。"

msgctxt "settings schema"
msgid "Timeout in milliseconds for automatically dismissing language server notifications.\nSet to 0 to disable auto-dismiss.\n\nDefault: 5000"
msgstr "自動關閉語言伺服器通知的逾時（毫秒）。\n設為 0 可停用自動關閉。\n\n預設值：5000"

msgctxt "settings schema"
msgid "Timeout in seconds for SSH connection and downloading the remote server binary.\nDefaults to 10 seconds if not specified."
msgstr "SSH 連線與下載遠端伺服器二進位檔的逾時（秒）。\n未指定時預設為 10 秒。"

msgctxt "settings schema"
msgid "Toggles inlay hints (hides or shows) when the user presses the modifiers specified.\nIf only a subset of the modifiers specified is pressed, hints are not toggled.\nIf no modifiers are specified, this is equivalent to `null`.\n\nDefault: null"
msgstr "使用者按下指定的輔助按鍵時切換內嵌提示（隱藏或顯示）。\n若只按下部分指定的輔助按鍵，則不會切換提示。\n若未指定輔助按鍵，則等同於 `null`。\n\n預設值：null"

msgctxt "settings schema"
msgid "Toolbar related settings"
msgstr "工具列相關設定"

msgctxt "settings schema"
msgid "Treat files and folders matching these glob patterns as hidden, including\nfiles inside matching folders. To hide these entries, run\n`project panel: toggle hide hidden` from the command palette or set\n`project_panel.hide_hidden` to `true`.\n\nDefault:\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "將符合這些 glob 模式的檔案與資料夾（包括符合之資料夾中的檔案）視為隱藏。若要隱藏這些項目，請從命令選擇區執行 `project panel: toggle hide hidden`，或將 `project_panel.hide_hidden` 設為 `true`。\n\n預設值：\n\n```json\n{\n  \"hidden_files\": [\"**/.*\"]\n}\n```\n\n使用 `\"...\"` 可新增模式而不必重複 ForgeKairos 的預設值。在專案設定中，它會延伸使用者或上層設定的值。省略 `\"...\"` 則會取代繼承的清單。\n\n```json\n{\n  \"hidden_files\": [\"**/*.log\", \"...\"],\n  \"project_panel\": {\n    \"hide_hidden\": true\n  }\n}\n```\n\n繼承的模式會插入在 `\"...\"` 的位置，重複的項目會保留第一次出現者。"

msgctxt "settings schema"
msgid "Treat files matching these glob patterns as read-only when opened. You can\nview but not edit them, which is useful for build outputs, external\ndependencies, or generated files.\n\nDefault:\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\nUse `\"...\"` to add patterns without repeating Zed's defaults. In project\nsettings, it extends the user or parent configuration value. Omit\n`\"...\"` to replace the inherited list.\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\nInherited patterns are inserted at `\"...\"`, and duplicates keep their first\noccurrence."
msgstr "開啟符合這些 glob 模式的檔案時將其視為唯讀。您可以檢視但無法編輯，適用於建置輸出、外部相依性或產生的檔案。\n\n預設值：\n\n```json\n{\n  \"read_only_files\": []\n}\n```\n\n使用 `\"...\"` 可新增模式而不必重複 ForgeKairos 的預設值。在專案設定中，它會延伸使用者或上層設定的值。省略 `\"...\"` 則會取代繼承的清單。\n\n```json\n{\n  \"read_only_files\": [\"**/build/**\", \"...\"]\n}\n```\n\n繼承的模式會插入在 `\"...\"` 的位置，重複的項目會保留第一次出現者。"

msgctxt "settings schema"
msgid "Treat the files matching these globs as `.env` files.\nDefault: [\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"
msgstr "將符合這些 glob 的檔案視為 `.env` 檔案。\n預設值：[\"**/.env*\", \"**/*.pem\", \"**/*.key\", \"**/*.cert\", \"**/*.crt\", \"**/secrets.yml\"]"

msgctxt "settings schema"
msgid "UNSTABLE: Expect many elements to be broken."
msgstr "不穩定：許多元素可能無法正常運作。"

msgctxt "settings schema"
msgid "Underline cursor."
msgstr "底線游標。"

msgctxt "settings schema"
msgid "Uppercase names are grouped before lowercase names, with case-insensitive\nnatural sort within each group. Dot-prefixed names sort before both groups."
msgstr "大寫名稱會分組排在小寫名稱之前，各組內以不區分大小寫的自然排序排列。以點開頭的名稱排在兩組之前。"

msgctxt "settings schema"
msgid "Use CRLF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "新檔案以及沒有現有行尾慣例的檔案使用 CRLF，同時保留現有的 LF 或 CRLF 檔案。"

msgctxt "settings schema"
msgid "Use LF for new files and files with no existing line-ending\nconvention, while preserving existing LF or CRLF files."
msgstr "新檔案以及沒有現有行尾慣例的檔案使用 LF，同時保留現有的 LF 或 CRLF 檔案。"

msgctxt "settings schema"
msgid "Use LSP folding wherever possible, falling back to tree-sitter and indent-based folding when no results were returned by the server."
msgstr "盡可能使用 LSP 摺疊，當伺服器未回傳結果時，退而使用 tree-sitter 及縮排式摺疊。"

msgctxt "settings schema"
msgid "Use LSP semantic tokens exclusively, replacing tree-sitter highlighting."
msgstr "僅使用 LSP 語意標記，取代 tree-sitter 語法醒目提示。"

msgctxt "settings schema"
msgid "Use LSP semantic tokens together with tree-sitter highlighting."
msgstr "結合 LSP 語意標記與 tree-sitter 語法醒目提示。"

msgctxt "settings schema"
msgid "Use LSP tasks over Zed language extension ones.\nIf no LSP tasks are returned due to error/timeout or regular execution,\nZed language extension tasks will be used instead.\n\nOther Zed tasks will still be shown:\n* Zed task from either of the task config file\n* Zed task from history (e.g. one-off task was spawned before)"
msgstr "優先使用 LSP 工作，而非 ForgeKairos 語言擴充功能的工作。\n若因錯誤/逾時或正常執行而未傳回任何 LSP 工作，則改用 ForgeKairos 語言擴充功能的工作。\n\n其他 ForgeKairos 工作仍會顯示：\n* 來自任一工作設定檔案的 ForgeKairos 工作\n* 來自歷程記錄的 ForgeKairos 工作（例如先前執行過的一次性工作）"

msgctxt "settings schema"
msgid "Use a custom line height."
msgstr "使用自訂行高。"

msgctxt "settings schema"
msgid "Use a different color for each indentation level."
msgstr "為每個縮排層級使用不同顏色。"

msgctxt "settings schema"
msgid "Use a line height that's comfortable for reading, 1.618"
msgstr "使用舒適的閱讀行高 1.618"

msgctxt "settings schema"
msgid "Use a specific program with arguments."
msgstr "使用帶有引數的特定程式。"

msgctxt "settings schema"
msgid "Use a specific program with no arguments."
msgstr "使用無引數的特定程式。"

msgctxt "settings schema"
msgid "Use a standard line height, 1.3. This option is useful for TUIs,\nparticularly if they use box characters"
msgstr "使用標準行高 1.3。此選項適用於 TUI，特別是使用框線字元的 TUI"

msgctxt "settings schema"
msgid "Use all gitignored files"
msgstr "使用所有被 Git 忽略的檔案"

msgctxt "settings schema"
msgid "Use conda"
msgstr "使用 conda"

msgctxt "settings schema"
msgid "Use grayscale text rendering."
msgstr "使用灰階文字轉譯。"

msgctxt "settings schema"
msgid "Use macOS's native fullscreen, which moves the window into its own\nMission Control space."
msgstr "使用 macOS 的原生全螢幕，將視窗移至其專屬的 Mission Control 空間。"

msgctxt "settings schema"
msgid "Use mamba"
msgstr "使用 mamba"

msgctxt "settings schema"
msgid "Use micromamba"
msgstr "使用 micromamba"

msgctxt "settings schema"
msgid "Use only the files Zed had indexed"
msgstr "僅使用 ForgeKairos 已建立索引的檔案"

msgctxt "settings schema"
msgid "Use platform default behavior."
msgstr "使用平台預設行為。"

msgctxt "settings schema"
msgid "Use subpixel (ClearType-style) text rendering."
msgstr "使用次像素（ClearType 風格）文字轉譯。"

msgctxt "settings schema"
msgid "Use system clipboard for yank operations."
msgstr "在 yank 操作時使用系統剪貼簿。"

msgctxt "settings schema"
msgid "Use system clipboard."
msgstr "使用系統剪貼簿。"

msgctxt "settings schema"
msgid "Use the current file's directory, falling back to the project directory,\nthen the first project in the workspace."
msgstr "使用目前檔案的資料夾，若無法使用則改用專案資料夾，再其次為工作區中的第一個專案。"

msgctxt "settings schema"
msgid "Use the current file's project directory. Fallback to the\nfirst project directory strategy if unsuccessful."
msgstr "使用目前檔案的專案資料夾。若失敗，則改用第一個專案資料夾的策略。"

msgctxt "settings schema"
msgid "Use the first project in this workspace's directory. Fallback to using\nthis platform's home directory."
msgstr "使用此工作區中第一個專案的資料夾。若失敗，則改用此平台的主目錄。"

msgctxt "settings schema"
msgid "Use the language server's `textDocument/documentSymbol` LSP response for outlines and\nbreadcrumbs. When enabled, tree-sitter is not used for document symbols."
msgstr "大綱與階層連結使用語言伺服器的 `textDocument/documentSymbol` LSP 回應。啟用時，不會使用 tree-sitter 計算文件符號。"

msgctxt "settings schema"
msgid "Use the preference previously set via the status-bar toggle, or false\nif no preference has been stored."
msgstr "使用先前透過狀態列切換設定的喜好設定，若未儲存任何喜好設定則為 false。"

msgctxt "settings schema"
msgid "Use the same color for all indentation levels."
msgstr "為所有縮排層級使用相同顏色。"

msgctxt "settings schema"
msgid "Use the specified `dark` theme."
msgstr "使用指定的 `dark` 佈景主題。"

msgctxt "settings schema"
msgid "Use the specified `light` theme."
msgstr "使用指定的 `light` 佈景主題。"

msgctxt "settings schema"
msgid "Use the system's default terminal configuration in /etc/passwd"
msgstr "使用系統在 /etc/passwd 中的預設終端機設定"

msgctxt "settings schema"
msgid "Use the theme based on the system's appearance."
msgstr "根據系統外觀使用對應佈景主題。"

msgctxt "settings schema"
msgid "Use tree-sitter queries to compute document symbols for outlines and breadcrumbs (default)."
msgstr "使用 tree-sitter 查詢計算文件符號，用於大綱與階層連結（預設）。"

msgctxt "settings schema"
msgid "Used for the background of a ghost element that should have the same background as the surface it's on.\n\nElements might include: Buttons, Inputs, Checkboxes, Radio Buttons...\n\nFor an element that should have a different background than the surface it's on, use `element_background`."
msgstr "用於應與其所在表面具有相同背景之幽靈元素的背景。\n\n元素可能包括：按鈕、輸入欄位、核取方塊、選項按鈕……\n\n若元素應與其所在表面具有不同的背景，請使用 `element_background`。"

msgctxt "settings schema"
msgid "Vertical bar cursor."
msgstr "垂直線游標。"

msgctxt "settings schema"
msgid "Vertically center the target in the viewport."
msgstr "將目標垂直置中於檢視區。"

msgctxt "settings schema"
msgid "Visible characters used to render whitespace when show_whitespaces is enabled.\n\nDefault: \"•\" for spaces, \"→\" for tabs."
msgstr "啟用 show_whitespaces 時，用於轉譯空白字元的可見字元。\n\n預設值：空格為 \"•\"，定位字元為 \"→\"。"

msgctxt "settings schema"
msgid "What `git reset` keeps of the changes."
msgstr "`git reset` 對變更的保留方式。"

msgctxt "settings schema"
msgid "What a new agent thread starts with in a project, keyed by the absolute\npath of the project's folder (for a project on a remote host, the\nhost's connection, `#`, then the path there). The chat input's buttons\ncan still change it for one thread; that change is not saved. Only read\nfrom the user settings file.\n\nDefault: {}"
msgstr "新的代理會話在各專案中如何開始，以專案資料夾的絕對路徑為鍵（遠端主機上的專案為主機的連線、`#`，再接該主機上的路徑）。聊天輸入欄的按鈕仍可為單一會話變更它；該變更不會儲存。只從使用者設定檔讀取。\n\n預設值：{}"

msgctxt "settings schema"
msgid "What base settings to start from before applying this profile's overrides.\n\n- `user`: Apply on top of user's settings (default)\n- `default`: Apply on top of Zed's default settings, ignoring user customizations"
msgstr "套用此設定檔的覆寫之前，要從哪一組基礎設定開始。\n\n- `user`：套用在使用者設定之上（預設）\n- `default`：套用在 ForgeKairos 的預設設定之上，忽略使用者的自訂"

msgctxt "settings schema"
msgid "What format to display the hours in.\n\nDefault: hour12"
msgstr "顯示小時的格式。\n\n預設值：hour12"

msgctxt "settings schema"
msgid "What shell to use when opening a terminal.\n\nDefault: system"
msgstr "開啟終端機時使用的 Shell。\n\n預設值：system"

msgctxt "settings schema"
msgid "What the default branch name should be when\n`init.defaultBranch` is not set in git\n\nDefault: main"
msgstr "git 中未設定 `init.defaultBranch` 時的預設分支名稱\n\n預設值：main"

msgctxt "settings schema"
msgid "What to do after closing the current tab.\n\nDefault: history"
msgstr "關閉目前分頁後的動作。\n\n預設值：history"

msgctxt "settings schema"
msgid "What to do when go to definition yields no results."
msgstr "前往定義沒有結果時要執行的動作。"

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts\n(parts of singleton buffers).\n\nDefault: select"
msgstr "在多重緩衝區的某些摘錄（單一緩衝區的部分）上按兩下時的動作。\n\n預設值：select"

msgctxt "settings schema"
msgid "What to do when multibuffer is double clicked in some of its excerpts (parts of singleton buffers)."
msgstr "在多重緩衝區的部分摘錄（單一緩衝區的一部分）中按兩下時要執行的動作。"

msgctxt "settings schema"
msgid "What to do when the `BEL` character (`\\a`) is printed to terminal.\n\nDefault: \"system\""
msgstr "終端機輸出 `BEL` 字元（`\\a`）時的動作。\n\n預設值：\"system\""

msgctxt "settings schema"
msgid "What to do when the last window is closed\n\nDefault: auto (nothing on macOS, \"app quit\" otherwise)"
msgstr "關閉最後一個視窗時的動作\n\n預設值：auto（macOS 上不執行任何動作，其他平台為 \"app quit\"）"

msgctxt "settings schema"
msgid "What to show for directories in the git panel.\n\nDefault: icon"
msgstr "Git 面板中資料夾要顯示的內容。\n\n預設值：icon"

msgctxt "settings schema"
msgid "What to show for directories in the outline panel.\n\nDefault: icon"
msgstr "大綱面板中資料夾要顯示的內容。\n\n預設值：icon"

msgctxt "settings schema"
msgid "What to show for directories in the project panel.\n\nDefault: icon"
msgstr "專案面板中資料夾要顯示的內容。\n\n預設值：icon"

msgctxt "settings schema"
msgid "What to show when opening a new window.\nValues: empty_tab, launchpad\nDefault: launchpad"
msgstr "開啟新視窗時要顯示的內容。\n值：empty_tab、launchpad\n預設值：launchpad"

msgctxt "settings schema"
msgid "What working directory to use when launching the terminal\n\nDefault: current_project_directory"
msgstr "啟動終端機時使用的工作目錄\n\n預設值：current_project_directory"

msgctxt "settings schema"
msgid "When enabled, edit predictions are shown in Vim normal mode.\nBy default, edit predictions are only shown in insert and replace modes."
msgstr "啟用時，會在 Vim 一般模式中顯示編輯預測。\n預設只會在插入與取代模式中顯示編輯預測。"

msgctxt "settings schema"
msgid "When enabled, the `:substitute` command replaces all matches in a line\nby default. The 'g' flag then toggles this behavior.,"
msgstr "啟用時，`:substitute` 命令預設會取代一行中的所有符合項目。\n此時 'g' 旗標會切換此行為。"

msgctxt "settings schema"
msgid "When false, forcefully disables the horizontal scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "設為 false 時，強制停用水平捲軸。否則依循其他設定。\n\n預設值：true"

msgctxt "settings schema"
msgid "When false, forcefully disables the vertical scrollbar. Otherwise, obey other settings.\n\nDefault: true"
msgstr "設為 false 時，強制停用垂直捲軸。否則依循其他設定。\n\n預設值：true"

msgctxt "settings schema"
msgid "When fetching LSP completions, determines how long to wait for a response of a particular server.\nWhen set to 0, waits indefinitely.\n\nDefault: 0"
msgstr "擷取 LSP 完成項目時，決定等待特定伺服器回應的時間。\n設為 0 時，會無限期等待。\n\n預設值：0"

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane."
msgstr "代理面板何時顯示其自身窗格的分頁列。"

msgctxt "settings schema"
msgid "When the agent panel shows the tab bar of its own pane.\n\nDefault: auto"
msgstr "代理面板何時顯示其自身窗格的分頁列。\n\n預設值：auto"

msgctxt "settings schema"
msgid "When the attachments of one message add up to more than this many\nbytes, the largest ones are sent as an outline or a reference until the\nmessage fits. Attachments set to be sent in full are never reduced.\n\nDefault: 65536"
msgstr "當單一訊息的附件總量超過這麼多位元組時，會將最大的附件以大綱或參考傳送，直到訊息放得下為止。設為完整傳送的附件永遠不會被縮減。\n\n預設值：65536"

msgctxt "settings schema"
msgid "When to automatically save edited buffers.\n\nDefault: off"
msgstr "何時自動儲存已編輯的緩衝區。\n\n預設值：off"

msgctxt "settings schema"
msgid "When to index the worktree's C and C++ files.\n\nDefault: auto"
msgstr "何時為工作樹的 C 與 C++ 檔案建立索引。\n\n預設值：auto"

msgctxt "settings schema"
msgid "When to play a sound when the agent has either completed its response, or needs user input.\n\nDefault: never"
msgstr "代理完成回應或需要使用者輸入時，何時播放音效。\n\n預設值：never"

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor."
msgstr "根據游標下的文字填入新搜尋查詢的時機。"

msgctxt "settings schema"
msgid "When to populate a new search's query based on the text under the cursor.\n\nDefault: always"
msgstr "何時依據游標下的文字填入新搜尋的查詢。\n\n預設值：always"

msgctxt "settings schema"
msgid "When to scan content of linked directories."
msgstr "何時掃描連結之資料夾的內容。"

msgctxt "settings schema"
msgid "When to scan content of linked directories.\n\nDefault: expanded"
msgstr "何時掃描連結之資料夾的內容。\n\n預設值：expanded"

msgctxt "settings schema"
msgid "When to show the minimap in the editor.\n\nDefault: never"
msgstr "何時在編輯器中顯示縮圖。\n\n預設值：never"

msgctxt "settings schema"
msgid "When to show the minimap thumb.\n\nDefault: always"
msgstr "何時顯示縮圖滑桿。\n\n預設值：always"

msgctxt "settings schema"
msgid "When to show the scrollbar in the completion menu.\nThis setting can take four values:\n\n1. Show the scrollbar if there's important information or\n   follow the system's configured behavior\n  \"auto\"\n2. Match the system's configured behavior:\n   \"system\"\n3. Always show the scrollbar:\n   \"always\"\n4. Never show the scrollbar:\n   \"never\" (default)"
msgstr "何時在完成項目選單中顯示捲軸。\n此設定可設為以下四種值：\n\n1. 有重要資訊時顯示捲軸，或依循系統設定的行為\n  \"auto\"\n2. 符合系統設定的行為：\n   \"system\"\n3. 一律顯示捲軸：\n   \"always\"\n4. 一律不顯示捲軸：\n   \"never\"（預設）"

msgctxt "settings schema"
msgid "When to show the scrollbar in the editor.\n\nDefault: auto"
msgstr "何時在編輯器中顯示捲軸。\n\n預設值：auto"

msgctxt "settings schema"
msgid "When to show the scrollbar in the outline panel."
msgstr "在大綱面板中顯示捲軸的時機。"

msgctxt "settings schema"
msgid "When to show the scrollbar in the project panel.\n\nDefault: inherits editor scrollbar settings"
msgstr "何時在專案面板中顯示捲軸。\n\n預設值：繼承編輯器的捲軸設定"

msgctxt "settings schema"
msgid "When to show the scrollbar in the terminal.\n\nDefault: inherits editor scrollbar settings"
msgstr "何時在終端機中顯示捲軸。\n\n預設值：繼承編輯器的捲軸設定"

msgctxt "settings schema"
msgid "When to show the scrollbar.\n\nDefault: auto"
msgstr "何時顯示捲軸。\n\n預設值：auto"

msgctxt "settings schema"
msgid "When true, enables drag and drop text selection in buffer.\n\nDefault: true"
msgstr "設為 true 時，啟用在緩衝區中拖放選取的文字。\n\n預設值：true"

msgctxt "settings schema"
msgid "When using OpenAiChat protocol, whether thinking tokens are sent as a dedicated `reasoning_content` field or inline in message text."
msgstr "使用 OpenAiChat 通訊協定時，思考 Token 是以專用的 `reasoning_content` 欄位傳送，還是內嵌在訊息文字中。"

msgctxt "settings schema"
msgid "Where to dock the AI browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "AI 瀏覽器面板的停駐位置。可為 'left'、'right' 或 'bottom'。\n\n預設值：right"

msgctxt "settings schema"
msgid "Where to dock the agent panel.\n\nDefault: left (Agentic layout), right (Classic layout)"
msgstr "代理面板的停駐位置。\n\n預設值：left（Agentic 版面配置）、right（Classic 版面配置）"

msgctxt "settings schema"
msgid "Where to dock the browser panel. Can be 'left', 'right' or 'bottom'.\n\nDefault: right"
msgstr "瀏覽器面板的停駐位置。可為 'left'、'right' 或 'bottom'。\n\n預設值：right"

msgctxt "settings schema"
msgid "Where to dock the call graph panel.\n\nDefault: right"
msgstr "呼叫圖面板的停駐位置。\n\n預設值：right"

msgctxt "settings schema"
msgid "Where to dock the panel.\n\nDefault: right (Agentic layout), left (Classic layout)"
msgstr "面板的停駐位置。\n\n預設值：right（Agentic 版面配置）、left（Classic 版面配置）"

msgctxt "settings schema"
msgid "Where to keep the changes."
msgstr "變更要保留在何處。"

msgctxt "settings schema"
msgid "Where to position the threads sidebar."
msgstr "會話側邊欄要放置的位置。"

msgctxt "settings schema"
msgid "Where to position the threads sidebar.\n\nDefault: left"
msgstr "會話側邊欄的位置。\n\n預設值：left"

msgctxt "settings schema"
msgid "Where to render the blame information when enabled.\n\nDefault: inline"
msgstr "啟用時轉譯 Blame 資訊的位置。\n\n預設值：inline"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations\n(Go to Definition, Go to Implementation, Find All References). A single\nresult always opens directly. Individual actions can override this with\ntheir `open_results_in` argument.\n\nDefault: multi_buffer"
msgstr "可能包含多個位置的 LSP 結果（前往定義、前往實作、尋找所有參考）要顯示在何處。只有單一結果時一律直接開啟。個別動作可以使用其 `open_results_in` 引數覆寫此設定。\n\n預設值：multi_buffer"

msgctxt "settings schema"
msgid "Where to show LSP results that can contain multiple locations."
msgstr "可能包含多個位置的 LSP 結果的顯示位置。"

msgctxt "settings schema"
msgid "Where to show a popup notification when the agent is waiting for user input.\n\nDefault: \"primary_screen\""
msgstr "代理等待使用者輸入時，要在何處顯示快顯通知。\n\n預設值：\"primary_screen\""

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: [`DisplayIn::ActiveEditor`]"
msgstr "在編輯器中的何處顯示縮圖。\n\n預設值：[`DisplayIn::ActiveEditor`]"

msgctxt "settings schema"
msgid "Where to show the minimap in the editor.\n\nDefault: all_editors"
msgstr "在編輯器中的何處顯示縮圖。\n\n預設值：all_editors"

msgctxt "settings schema"
msgid "Whether \"Launch Claude Code\" always launches outside the sandbox, without\nasking. Outside, writes are not restricted, and network restrictions only\napply to programs that read the proxy settings (and not at all on SSH\nhosts). Can only be set in the user settings, not in a project's settings.\n\nDefault: false"
msgstr "「啟動 Claude Code」是否一律不經詢問即在沙箱外啟動。在沙箱外，寫入不受限制，網路限制只套用於會讀取 Proxy 設定的程式（在 SSH 主機上則完全不套用）。只能在使用者設定中設定，無法在專案設定中設定。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether AI agents (the built-in agent and MCP clients) may drive the\nbuilt-in browser's AI tabs, for debugging web apps.\n\nAI tabs use their own browser profile and always go through the egress\nallowlist proxy, whatever `use_egress_proxy` says.\n\nDefault: false"
msgstr "AI 代理（內建代理與 MCP 用戶端）是否可以操控內建瀏覽器的 AI 分頁，以偵錯 Web 應用程式。\n\nAI 分頁使用自己的瀏覽器設定檔，且無論 `use_egress_proxy` 為何，一律會經過對外連線允許清單的 Proxy。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether Anthropic's fast mode is available for this model."
msgstr "此模型是否支援 Anthropic 的快速模式。"

msgctxt "settings schema"
msgid "Whether SSH terminals keep their shell running on the remote host\nacross disconnects, and for how long."
msgstr "SSH 終端機在中斷連線期間是否讓其 Shell 在遠端主機上持續執行，以及持續多久。"

msgctxt "settings schema"
msgid "Whether a new agent thread starts with Git operations turned on: the\nagent gets the `git` tool, which runs git (with every hook turned off)\nafter each call is approved. The chat input's Git button turns it on\nor off for one thread.\n\nDefault: true"
msgstr "新的代理會話是否以開啟 Git 操作的狀態開始：代理會取得 `git` 工具，該工具在每次呼叫獲得核准後執行 git（停用所有 Hook）。聊天輸入欄的 Git 按鈕可針對單一會話開啟或關閉此功能。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether a terminal opened over SSH runs its shell inside a session the\nremote server keeps alive, so that a dropped connection neither stops\nrunning commands nor loses the output: reconnecting shows everything\nagain and continues. Only for SSH hosts that are not Windows.\n\nDefault: true"
msgstr "透過 SSH 開啟的終端機是否在遠端伺服器保持運作的工作階段中執行其 Shell，讓連線中斷時既不會停止執行中的命令，也不會遺失輸出：重新連線後會再次顯示所有內容並繼續。僅適用於非 Windows 的 SSH 主機。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether a worktree an agent wrote into stops running its own code\n(project language server modes, formatters, the project's prettier)\nuntil the user reviews the changes and resumes it. Read from the user\nsettings file only: project and server settings cannot turn it off.\n\nDefault: true"
msgstr "代理寫入過的工作樹是否停止執行其自身的程式碼（專案語言伺服器模式、格式器、專案的 prettier），直到使用者檢閱變更並繼續執行。只從使用者設定檔案讀取：專案與伺服器設定無法將其關閉。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether agents connected over the IDE server may read the output of the\nlast task that failed in this window (the `getLastTaskOutput` tool, at\nmost the last 4 KB of the task's terminal).\n\nDefault: true"
msgstr "透過 IDE 伺服器連線的代理是否可以讀取此視窗中最後一個失敗工作的輸出（`getLastTaskOutput` 工具，最多為該工作終端機的最後 4 KB）。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether all context servers are enabled by default."
msgstr "是否預設啟用所有 MCP 伺服器。"

msgctxt "settings schema"
msgid "Whether and how to display code lenses from language servers.\n\nDefault: \"off\""
msgstr "是否以及如何顯示來自語言伺服器的 CodeLens。\n\n預設值：\"off\""

msgctxt "settings schema"
msgid "Whether anything the agent features start may run outside the sandbox\nat all. While this is off, every new way out is refused without asking:\nagent terminal commands that cannot run in the sandbox (and\n`allow_unsandboxed`, which is then ignored), external agents and Claude\nCode started outside it (the one-time starts and the \"always outside\"\nsettings, which are then ignored), and threads resumed outside it. A\nconnection already running outside the sandbox keeps running, and MCP\nservers (context servers) are not covered. While it is on, each of\nthose asks or follows its own setting as before. Only the user settings\nfile is read: neither a project's settings nor an agent can turn it on.\nDefault: false"
msgstr "代理功能所啟動的任何項目是否可以在沙箱外執行。此設定關閉時，所有新的對外途徑都會不經詢問即被拒絕：無法在沙箱中執行的代理終端機命令（此時會忽略 `allow_unsandboxed`）、在沙箱外啟動的外部代理與 Claude Code（一次性啟動以及「一律在沙箱外」設定，此時這些設定會被忽略），以及在沙箱外繼續的會話。已在沙箱外執行的連線會繼續執行，且不涵蓋 MCP 伺服器。此設定開啟時，上述各項會如同以往詢問或依循各自的設定。只會讀取使用者設定檔案：專案設定與代理都無法將其開啟。\n預設值：false"

msgctxt "settings schema"
msgid "Whether clangd indexes the whole project in the background. `light`\nskips that index (`--background-index=false`), which saves the most\nmemory: references, call hierarchy and renames then only cover the\nfiles that are open. Ignored when `lsp.clangd.binary.arguments`\nalready has `--background-index`.\n\nDefault: full"
msgstr "clangd 是否在背景為整個專案建立索引。`light` 會略過該索引（`--background-index=false`），最節省記憶體：此時參考、呼叫階層與重新命名只涵蓋已開啟的檔案。若 `lsp.clangd.binary.arguments` 已包含 `--background-index`，則會忽略此設定。\n\n預設值：full"

msgctxt "settings schema"
msgid "Whether clicking the stop button on a running terminal tool should also cancel the agent's generation.\nNote that this only applies to the stop button, not to ctrl+c inside the terminal.\n\nDefault: true"
msgstr "按一下執行中終端機工具的停止按鈕時，是否也取消代理的產生作業。\n請注意，這只適用於停止按鈕，不適用於終端機內的 ctrl+c。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether cmd-click (ctrl-click on Linux and Windows) opens hyperlinks even\nwhen the terminal application has enabled mouse reporting (e.g. vim with\nmouse=a, htop). When false, these clicks are forwarded to the application\ninstead, and hyperlinks can still be opened with shift-cmd-click\n(shift-ctrl-click).\n\nDefault: true"
msgstr "即使終端機應用程式已啟用滑鼠回報（例如設定 mouse=a 的 vim、htop），cmd+按一下（Linux 與 Windows 上為 ctrl+按一下）是否仍會開啟超連結。設為 false 時，這些按一下動作會改為轉送給應用程式，此時仍可使用 shift+cmd+按一下（shift+ctrl+按一下）開啟超連結。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether cursor movement animation is enabled.\n\nDefault: false"
msgstr "是否啟用游標移動動畫。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether every new terminal starts recording its output automatically.\n\nDefault: false"
msgstr "每個新的終端機是否自動開始記錄其輸出。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether hovering a name in C and C++ also shows what its type holds\n(members, enumerators, a macro's definition), found by name in the\nindex.\n\nDefault: true"
msgstr "在 C 與 C++ 中暫留於名稱上時，是否也顯示其型別包含的內容（成員、列舉值、巨集的定義），這些內容是從索引中依名稱找出的。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether indentation of pasted content should be adjusted based on the context.\n\nDefault: true"
msgstr "是否依據上下文調整貼上內容的縮排。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether invoking a panel's `ToggleFocus` action while the panel is\nalready focused closes the panel, instead of just moving focus back\nto the editor. This only applies to a panel's focus-toggle action, not\nto its regular visibility-toggle action.\n\nDefault: false"
msgstr "在面板已取得焦點時叫用其 `ToggleFocus` 動作，是否會關閉面板，而非只是將焦點移回編輯器。這只適用於面板的焦點切換動作，不適用於其一般的顯示切換動作。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether newly opened file diffs show the full file instead of changes only.\n\nDefault: true"
msgstr "新開啟的檔案差異是否顯示完整檔案，而非只顯示變更。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether opening a folder in an existing window automatically opens the\nThreads Sidebar. Applies when `default_open_behavior` or\n`cli_default_open_behavior` is set to `existing_window`.\n\nDefault: true"
msgstr "在現有視窗中開啟資料夾時，是否自動開啟會話側邊欄。在 `default_open_behavior` 或 `cli_default_open_behavior` 設為 `existing_window` 時套用。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not selecting text in the terminal will automatically\ncopy to the system clipboard.\n\nDefault: false"
msgstr "在終端機中選取文字時，是否自動複製到系統剪貼簿。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether or not to automatically check for updates.\n\nDefault: false"
msgstr "是否自動檢查更新。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer edits.\n\nSet to 0 to disable debouncing.\n\nDefault: 700"
msgstr "是否在編輯緩衝區後對內嵌提示的更新進行防彈跳。\n\n設為 0 可停用防彈跳。\n\n預設值：700"

msgctxt "settings schema"
msgid "Whether or not to debounce inlay hints updates after buffer scrolls.\n\nSet to 0 to disable debouncing.\n\nDefault: 50"
msgstr "是否在捲動緩衝區後對內嵌提示的更新進行防彈跳。\n\n設為 0 可停用防彈跳。\n\n預設值：50"

msgctxt "settings schema"
msgid "Whether or not to enable Helix mode.\n\nDefault: false"
msgstr "是否啟用 Helix 模式。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether or not to enable Vim mode.\n\nDefault: false"
msgstr "是否啟用 Vim 模式。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether or not to ensure there's a single newline at the end of a buffer\nwhen saving it.\n\nDefault: true"
msgstr "儲存緩衝區時，是否確保其結尾只有一個換行字元。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to include warning diagnostics.\n\nDefault: true"
msgstr "是否包含警告診斷。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to keep the tab bar buttons on panes that are not active.\nWhen disabled, only the focused pane shows them, so a split leaves the\nother panes without a new / split / zoom button.\n\nDefault: true"
msgstr "是否在非使用中的窗格上保留分頁列按鈕。\n停用時，只有取得焦點的窗格會顯示這些按鈕，因此分割後其他窗格將沒有新增 / 分割 / 縮放按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to perform a buffer format before saving.\n\nDefault: on"
msgstr "是否在儲存前格式化緩衝區。\n\n預設值：on"

msgctxt "settings schema"
msgid "Whether or not to prompt the user to confirm before closing the application.\n\nDefault: false"
msgstr "關閉應用程式前是否提示使用者確認。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether or not to remove any trailing whitespace from lines of a buffer\nbefore saving it.\n\nDefault: true"
msgstr "儲存緩衝區前，是否移除其各行結尾的空白字元。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to restore unsaved buffers on restart.\n\nIf this is true, user won't be prompted whether to save/discard\ndirty files when closing the application.\n\nDefault: true"
msgstr "重新啟動時是否還原未儲存的緩衝區。\n\n若為 true，關閉應用程式時不會詢問使用者是否要儲存/捨棄已修改的檔案。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: on"
msgstr "是否在目前取得焦點的行中以內嵌方式顯示 git Blame 資料。\n\n預設值：on"

msgctxt "settings schema"
msgid "Whether or not to show git blame data inline in\nthe currently focused line.\n\nDefault: true"
msgstr "是否在目前取得焦點的行中以內嵌方式顯示 git Blame 資料。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to show inline diagnostics\n\nDefault: false"
msgstr "是否顯示內嵌診斷\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether or not to show pinned tabs in a separate row.\nWhen enabled, pinned tabs appear in a top row and unpinned tabs in a bottom row.\n\nDefault: false"
msgstr "是否將已釘選的分頁顯示在另一列。\n啟用時，已釘選的分頁顯示在上列，未釘選的分頁顯示在下列。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether or not to show the call status icon in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示通話狀態圖示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to show the git gutter.\n\nDefault: tracked_files"
msgstr "是否顯示 git 裝訂邊。\n\n預設值：tracked_files"

msgctxt "settings schema"
msgid "Whether or not to show the navigation history buttons in the tab bar.\n\nDefault: true"
msgstr "是否在分頁列中顯示瀏覽歷程記錄按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar buttons.\n\nDefault: true"
msgstr "是否顯示分頁列按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to show the tab bar in the editor.\n\nDefault: true"
msgstr "是否在編輯器中顯示分頁列。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether or not to skip worktree trust checks.\nWhen trusted, project settings are synchronized automatically,\nlanguage and MCP servers are downloaded and started automatically.\n\nDefault: false"
msgstr "是否略過工作樹的信任檢查。\n受信任時，專案設定會自動同步，語言伺服器與 MCP 伺服器會自動下載並啟動。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether other hints should be shown.\n\nDefault: true"
msgstr "是否顯示其他提示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether parameter hints should be shown.\n\nDefault: true"
msgstr "是否顯示參數提示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether pressing enter should first append two spaces to the current line,\nwhich is how Markdown spells a hard line break. Lines where the break would\nbe dropped (headings, tables, list items, code fences, blank lines, and lines\nthat already end in a break) are left alone.\n\nDefault: false"
msgstr "按下 Enter 時，是否先在目前行的結尾加上兩個空格，這是 Markdown 表示強制換行的寫法。換行會被捨棄的行（標題、表格、清單項目、程式碼區塊圍欄、空白行，以及已以換行結尾的行）則保持不變。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may always reach any host over the\nnetwork without prompting.\nDefault: false"
msgstr "沙箱化的終端機命令是否一律可不經提示即透過網路連線至任何主機。\n預設值：false"

msgctxt "settings schema"
msgid "Whether sandboxed terminal commands may write anywhere on the\nfilesystem except protected paths. That is nearly the same as running\noutside the sandbox, so while this is on terminal commands are never\nauto-approved: each one asks first.\nDefault: false"
msgstr "沙箱化的終端機命令是否可以寫入檔案系統中受保護路徑以外的任何位置。這幾乎等同於在沙箱外執行，因此此設定開啟時，終端機命令永遠不會自動核准：每個命令都會先詢問。\n預設值：false"

msgctxt "settings schema"
msgid "Whether sticky scroll is enabled.\n\nDefault: false"
msgstr "是否啟用固定捲動。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the Agent is enabled.\n\nDefault: true"
msgstr "是否啟用代理。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the Copilot Next Edit Suggestions feature is enabled.\n\nDefault: true"
msgstr "是否啟用 Copilot Next Edit Suggestions 功能。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the Jupyter feature is enabled.\n\nDefault: true"
msgstr "是否啟用 Jupyter 功能。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the agent panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "即使上次關閉了其停駐區，是否仍在啟動時開啟代理面板。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the agent panel should use flexible (proportional) sizing when docked to the\nleft or right.\n\nWhen enabled, `default_width` does not control the panel width, and resetting the panel\nrestores the default proportion.\n\nDefault: true"
msgstr "代理面板停駐於左側或右側時，是否使用彈性（依比例）大小。\n\n啟用時，`default_width` 不會控制面板寬度，重設面板會還原預設比例。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the agent's terminal commands run in the sandbox. `false` runs\nthem outside it, which needs `sandbox_permissions.allow_outside_sandbox`;\nexternal agents then start outside it without asking."
msgstr "代理的終端機命令是否在沙箱內執行。設為 `false` 會在沙箱外執行，這需要 `sandbox_permissions.allow_outside_sandbox`；外部代理隨後會不經詢問就在沙箱外啟動。"

msgctxt "settings schema"
msgid "Whether the breakpoints should be reused across Zed sessions.\n\nDefault: true"
msgstr "是否在 ForgeKairos 工作階段之間重複使用中斷點。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the browser panel should open on startup, even if its dock was\nclosed last time.\n\nDefault: false"
msgstr "即使上次關閉了其停駐區，是否仍在啟動時開啟瀏覽器面板。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the built-in browser goes through the egress allowlist proxy.\n\nThe browser is human-driven, so like the terminal it is outside egress\ncontrol by default.\n\nDefault: false"
msgstr "內建瀏覽器是否經過對外連線允許清單的 Proxy。\n\n瀏覽器由人操作，因此與終端機一樣，預設不在對外連線管控的範圍內。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the context server is enabled."
msgstr "是否啟用 MCP 伺服器。"

msgctxt "settings schema"
msgid "Whether the cursor blinks in the editor.\n\nDefault: true"
msgstr "編輯器中的游標是否閃爍。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the editor search results will loop\n\nDefault: true"
msgstr "編輯器的搜尋結果是否循環\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the editor will scroll beyond the last line.\n\nDefault: one_page"
msgstr "編輯器是否會捲動超過最後一行。\n\n預設值：one_page"

msgctxt "settings schema"
msgid "Whether the focused panel follows the mouse location\nDefault: false"
msgstr "取得焦點的面板是否跟隨滑鼠位置\n預設值：false"

msgctxt "settings schema"
msgid "Whether the folders of the macro picker start collapsed when it opens.\n\nDefault: false"
msgstr "巨集選擇器開啟時，其資料夾是否以摺疊狀態開始。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the git panel should open on startup.\n\nDefault: false"
msgstr "是否在啟動時開啟 Git 面板。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the hover popover sticks when the mouse moves toward it,\nallowing interaction with its contents before it disappears.\n\nDefault: true"
msgstr "滑鼠移向暫留快顯視窗時，是否將其固定，以便在消失前與其內容互動。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the line numbers on editors gutter are relative or not.\nWhen \"enabled\" shows relative number of buffer lines, when \"wrapped\" shows\nrelative number of display lines.\n\nDefault: \"disabled\""
msgstr "編輯器裝訂邊上的行號是否為相對行號。\n設為 \"enabled\" 時顯示緩衝區行的相對行號，設為 \"wrapped\" 時顯示顯示行的相對行號。\n\n預設值：\"disabled\""

msgctxt "settings schema"
msgid "Whether the microphone should be muted when joining a channel or a call.\n\nDefault: false"
msgstr "加入頻道或通話時是否將麥克風靜音。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the model emits reasoning/thinking content."
msgstr "模型是否會產生推理/思考內容。"

msgctxt "settings schema"
msgid "Whether the model emits thinking (reasoning) content."
msgstr "模型是否輸出思考（推理）內容。"

msgctxt "settings schema"
msgid "Whether the model supports tools"
msgstr "模型是否支援工具"

msgctxt "settings schema"
msgid "Whether the model supports tools."
msgstr "模型是否支援工具。"

msgctxt "settings schema"
msgid "Whether the model supports vision"
msgstr "模型是否支援視覺"

msgctxt "settings schema"
msgid "Whether the model supports vision."
msgstr "模型是否支援視覺。"

msgctxt "settings schema"
msgid "Whether the panel follows the cursor, making the function under it the\nroot whenever the cursor moves. When off, the root changes only when\nasked for.\n\nDefault: false"
msgstr "面板是否跟隨游標，每當游標移動時將游標所在的函式設為根節點。關閉時，根節點只會在要求時變更。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether the project panel should open on startup.\n\nDefault: true"
msgstr "是否在啟動時開啟專案面板。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the regex is case-sensitive.\nDefault: false (case-insensitive)"
msgstr "規則運算式是否區分大小寫。\n預設值：false（不區分大小寫）"

msgctxt "settings schema"
msgid "Whether the remote host should make its outgoing HTTP(S) requests —\nlanguage server and node downloads, extension archives, agent binaries\n— through this machine instead of its own network.\n\nThis is what makes a remote host that has no internet access able to\ninstall language servers at all, and it puts those downloads under this\nmachine's network allowlist, consent prompts and proxy. Turn it off to\nhave the remote host connect out on its own.\n\nDefault: true"
msgstr "遠端主機是否透過這台電腦，而非其自身的網路，發出其對外 HTTP(S) 要求 — 語言伺服器與 node 的下載、擴充功能封存檔、代理二進位檔。\n\n這讓無法連上網際網路的遠端主機也能安裝語言伺服器，並讓這些下載受到這台電腦的網路允許清單、同意提示與 Proxy 的約束。關閉此設定可讓遠端主機自行對外連線。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the terminal panel should open on startup.\n\nDefault: true"
msgstr "是否在啟動時開啟終端機面板。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the terminal panel should use flexible (proportional) sizing.\n\nDefault: true"
msgstr "終端機面板是否使用彈性（依比例）大小。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the text selection should have rounded corners.\n\nDefault: true"
msgstr "文字選取範圍是否使用圓角。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether the window-wide threads sidebar is available at all.\n\nDefault: false"
msgstr "是否提供視窗範圍的會話側邊欄。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether this agent always launches outside the sandbox, without asking.\n\nOutside, writes are not restricted, and network restrictions only apply\nto programs that read the proxy settings. Can only be set in the user\nsettings, not in a project's settings (`.zed/settings.json`).\n\nDefault: false"
msgstr "此代理是否一律不經詢問即在沙箱外啟動。\n\n在沙箱外，寫入不受限制，網路限制只套用於會讀取 Proxy 設定的程式。只能在使用者設定中設定，無法在專案設定（`.zed/settings.json`）中設定。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether this agent may offer signing in with a subscription (an\nauthentication method such as `/login`).\n\nWhen `false`, the agent's sign-in disappears from the authentication card\nand is refused when it is requested another way. Using an API key works\nregardless of this setting.\n\nDefault: true"
msgstr "此代理是否可以提供以訂閱登入（例如 `/login` 等驗證方式）。\n\n設為 `false` 時，該代理的登入會從驗證卡片中消失，且以其他方式要求時也會被拒絕。無論此設定為何，都可以使用 API 金鑰。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether this custom Mantle model supports OpenAI reasoning effort parameters."
msgstr "此自訂 Mantle 模型是否支援 OpenAI 思考深度參數。"

msgctxt "settings schema"
msgid "Whether to align detail text in code completions context menus left or right.\n\nDefault: left"
msgstr "程式碼完成項目內容功能表中的詳細資料文字要靠左還是靠右對齊。\n\n預設值：left"

msgctxt "settings schema"
msgid "Whether to allow drag and drop text selection in buffer."
msgstr "是否允許在緩衝區中拖放文字選取範圍。"

msgctxt "settings schema"
msgid "Whether to allow horizontal scrolling in the project panel.\nWhen false, the view is locked to the leftmost position and\nlong file names are clipped.\n\nDefault: true"
msgstr "是否允許在專案面板中水平捲動。\n設為 false 時，檢視會鎖定在最左側的位置，過長的檔案名稱會被截斷。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to allow windows to tab together based on the user's tabbing preference (macOS only).\n\nDefault: false"
msgstr "是否依據使用者的分頁喜好設定允許視窗合併為分頁（僅限 macOS）。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to always show the close button on tabs.\n\nDefault: false"
msgstr "是否一律在分頁上顯示關閉按鈕。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to always use cmd-enter (or ctrl-enter on Linux or Windows) to send messages in the agent panel.\n\nDefault: false"
msgstr "在代理面板中是否一律使用 cmd-enter（Linux 或 Windows 上為 ctrl-enter）傳送訊息。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to attempt to restore previous file's state when opening it again.\nThe state is stored per pane.\nWhen disabled, defaults are applied instead of the state restoration.\n\nE.g. for editors, selections, folds and scroll positions are restored, if the same file is closed and, later, opened again in the same pane.\nWhen disabled, a single selection in the very beginning of the file, zero scroll position and no folds state is used as a default.\n\nDefault: true"
msgstr "再次開啟檔案時，是否嘗試還原檔案先前的狀態。\n狀態依窗格儲存。\n停用時，會套用預設值，而非還原狀態。\n\n例如，對於編輯器，若關閉同一個檔案後，稍後在同一個窗格中再次開啟，會還原選取範圍、摺疊與捲動位置。\n停用時，預設使用位於檔案最開頭的單一選取範圍、捲動位置為零且沒有摺疊的狀態。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to automatically attach the active editor to every message that\nis sent: the selected lines when there is a selection, otherwise the\nwhole file. A file that is already mentioned by hand is not attached\ntwice.\n\nDefault: false"
msgstr "是否自動將使用中的編輯器附加到每則傳送的訊息：有選取範圍時附加選取的行，否則附加整個檔案。已手動提及的檔案不會重複附加。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to automatically close JSX tags."
msgstr "是否自動關閉 JSX 標籤。"

msgctxt "settings schema"
msgid "Whether to automatically close files that have been deleted on disk.\n\nDefault: false"
msgstr "是否自動關閉已在磁碟上刪除的檔案。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to automatically compact the agent's context when it grows too\nlarge, summarizing earlier messages to free up room in the model's\ncontext window.\n\nDefault: true"
msgstr "代理的上下文變得太大時，是否自動壓縮，摘要較早的訊息以釋出模型上下文視窗中的空間。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to automatically detect the language of an untitled buffer from its contents.\nLanguages explicitly selected from the language selector are not changed.\n\nDefault: true"
msgstr "是否依據未命名緩衝區的內容自動偵測其語言。\n從語言選擇器中明確選取的語言不會變更。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to automatically discover models served by the llama.cpp server.\nDefaults to true."
msgstr "是否自動探索 llama.cpp 伺服器提供的模型。\n預設為 true。"

msgctxt "settings schema"
msgid "Whether to automatically open Markdown files in the preview.\n\nDefault: false"
msgstr "是否自動在預覽中開啟 Markdown 檔案。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to automatically open files after pasting or duplicating them.\n\nDefault: true"
msgstr "貼上或複製檔案後是否自動開啟。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to automatically open files dropped from external sources.\n\nDefault: true"
msgstr "是否自動開啟從外部來源拖放的檔案。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to automatically open newly created files in the editor.\n\nDefault: true"
msgstr "是否自動在編輯器中開啟新建立的檔案。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to automatically open the menus in the title bar on hover.\n\nDefault: false"
msgstr "是否在滑鼠暫留時自動開啟標題列中的選單。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to automatically show a signature help pop-up or not.\n\nDefault: false"
msgstr "是否自動顯示簽章說明快顯視窗。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to automatically surround text with characters for you. For example,\nwhen you select text and type '(', Zed will automatically surround text with ().\n\nDefault: true"
msgstr "是否自動以字元括住文字。例如，當您選取文字並輸入 '(' 時，ForgeKairos 會自動以 () 括住文字。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to automatically type closing characters for you. For example,\nwhen you type '(', Zed will automatically add a closing ')' at the correct position.\n\nDefault: true"
msgstr "是否自動輸入結尾字元。例如，當您輸入 '(' 時，ForgeKairos 會自動在正確的位置加上結尾的 ')'。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to build dev container images with BuildKit.\n\nWhen unset, Zed auto-detects BuildKit by probing for the `buildx` CLI\nplugin. Set to `false` to force the classic Docker builder, which is\nrequired for Docker-compatible engines that lack an integrated BuildKit\n(e.g. Apple Container via a Docker-API bridge), where BuildKit builds\ncannot resolve locally-built images.\n\nDefault: null (auto-detect)"
msgstr "是否使用 BuildKit 建置 Dev Container 映像。\n\n未設定時，ForgeKairos 會探查 `buildx` CLI 外掛程式以自動偵測 BuildKit。設為 `false` 可強制使用傳統的 Docker 建置器；對於缺少整合式 BuildKit 的 Docker 相容引擎（例如透過 Docker API 橋接器使用的 Apple Container），由於 BuildKit 建置無法解析本機建置的映像，因此必須如此設定。\n\n預設值：null（自動偵測）"

msgctxt "settings schema"
msgid "Whether to center the cursor on each search match when navigating."
msgstr "是否在導覽時將游標置中於每個搜尋比對結果。"

msgctxt "settings schema"
msgid "Whether to close the window when using 'close active item' on a workspace with no tabs\n\nDefault: auto (\"on\" on macOS, \"off\" otherwise)"
msgstr "在沒有分頁的工作區中使用「關閉使用中的項目」時，是否關閉視窗\n\n預設值：auto（macOS 上為 \"on\"，其他平台為 \"off\"）"

msgctxt "settings schema"
msgid "Whether to collapse untracked files in the diff panel.\n\nDefault: false"
msgstr "是否在差異面板中摺疊未追蹤的檔案。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to collect timing data for foreground and background executor\ntasks. Enabling this may lead to increased memory usage, hence it's\ndisabled by default for regular builds.\n\nDefault: false"
msgstr "是否收集前景與背景 executor 工作的計時資料。啟用此功能可能會增加記憶體使用量，因此一般組建預設為停用。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to continue markdown lists when pressing enter.\n\nDefault: true"
msgstr "按下 Enter 時是否接續 Markdown 清單。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to disable all AI features in Zed.\n\nDefault: false"
msgstr "是否停用 ForgeKairos 中的所有 AI 功能。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to display Agent review buttons in the editor toolbar.\nOnly applicable while reviewing a file edited by the Agent.\n\nDefault: true"
msgstr "是否在編輯器工具列中顯示代理的檢閱按鈕。\n只在檢閱由代理編輯的檔案時適用。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to display agent edits in single-file editors in addition to the review multibuffer pane.\n\nDefault: false"
msgstr "除了檢閱用的多重緩衝區窗格之外，是否也在單一檔案編輯器中顯示代理的編輯。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to display breadcrumbs in the editor toolbar.\n\nDefault: true"
msgstr "是否在編輯器工具列中顯示階層連結。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to display code action buttons in the editor toolbar.\n\nDefault: false"
msgstr "是否在編輯器工具列中顯示程式碼動作按鈕。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to display code lenses from language servers above code elements."
msgstr "是否在程式碼元素上方顯示來自語言伺服器的 CodeLens。"

msgctxt "settings schema"
msgid "Whether to display indent guides in the editor.\n\nDefault: true"
msgstr "是否在編輯器中顯示縮排輔助線。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to display inline and alongside documentation for items in the\ncompletions menu.\n\nDefault: true"
msgstr "是否以內嵌方式及並排方式顯示完成項目選單中項目的文件。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to display quick action buttons in the editor toolbar.\n\nDefault: true"
msgstr "是否在編輯器工具列中顯示快速動作按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to display the Markdown formatting row below the editor toolbar\nwhile a Markdown file is open.\n\nDefault: true"
msgstr "開啟 Markdown 檔案時，是否在編輯器工具列下方顯示 Markdown 格式列。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to display the active language button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示使用中的語言按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to display the terminal title in breadcrumbs inside the terminal pane.\nOnly shown if the terminal title is not empty.\n\nThe shell running in the terminal needs to be configured to emit the title.\nExample: `echo -e \"\\e]2;New Title\\007\";`\n\nDefault: true"
msgstr "是否在終端機窗格內的階層連結中顯示終端機標題。\n只有在終端機標題不為空時才會顯示。\n\n終端機中執行的 Shell 需要設定為輸出標題。\n範例：`echo -e \"\\e]2;New Title\\007\";`\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to enable drag-and-drop operations in the project panel.\n\nDefault: true"
msgstr "是否在專案面板中啟用拖放操作。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to enable middle-click paste on Linux\n\nDefault: true"
msgstr "是否在 Linux 上啟用按滑鼠中鍵貼上\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to enable think mode"
msgstr "是否啟用思考模式"

msgctxt "settings schema"
msgid "Whether to enable word diff highlighting in the editor.\n\nWhen enabled, changed words within modified lines are highlighted\nto show exactly what changed.\n\nDefault: true"
msgstr "是否在編輯器中啟用字組差異醒目提示。\n\n啟用時，會醒目提示已修改行中變更的字組，以精確顯示變更內容。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to expose this window over the loopback IDE server, so that\nexternal agents such as the Claude Code CLI can read the open editors,\nthe selection and the diagnostics, and show diffs inside Zed.\n\nDefault: false"
msgstr "是否透過回送 IDE 伺服器公開此視窗，讓 Claude Code CLI 等外部代理可以讀取已開啟的編輯器、選取範圍與診斷，並在 ForgeKairos 中顯示差異。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to fetch LSP completions or not.\n\nDefault: true"
msgstr "是否擷取 LSP 完成項目。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to filter ANSI/VT escape sequences so the log reads as plain\ntext, the way TeraTerm's text log does.\n\nDefault: true"
msgstr "是否篩除 ANSI/VT 逸出序列，讓記錄如同 TeraTerm 的文字記錄一樣以純文字呈現。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to fold directories automatically\nwhen directory has only one directory inside.\n\nDefault: true"
msgstr "資料夾內只有一個資料夾時，是否自動摺疊資料夾。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to follow-up empty go to definition responses from the language server or not.\n`FindAllReferences` allows to look up references of the same symbol instead.\n`None` disables the fallback.\n\nDefault: FindAllReferences"
msgstr "語言伺服器傳回空的前往定義回應時，是否進行後續處理。\n`FindAllReferences` 可改為查詢相同符號的參考。\n`None` 會停用後援。\n\n預設值：FindAllReferences"

msgctxt "settings schema"
msgid "Whether to format dap messages in when adding them to debug adapter logger\n\nDefault: true"
msgstr "將 DAP 訊息加入偵錯介面卡記錄器時，是否加以格式化\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to give agents Zed's IDE tools (the `zed` MCP server: highlights,\nannotations, code tours, hover, definitions, references and symbol\nsearch), in the Claude Code CLI tabs and in external agents' sessions\nalike. Independent of `enabled`: the server starts for them on demand\nand writes no lock file unless `enabled` is on.\n\nDefault: true"
msgstr "是否在 Claude Code CLI 分頁與外部代理的工作階段中，一律提供 ForgeKairos 的 IDE 工具（`zed` MCP 伺服器：醒目提示、註記、程式碼導覽、暫留、定義、參考與符號搜尋）給代理。與 `enabled` 無關：伺服器會視需要為代理啟動，且除非 `enabled` 已開啟，否則不會寫入鎖定檔。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to have edit cards in the agent panel expanded, showing a preview of the full diff.\n\nDefault: true"
msgstr "是否展開代理面板中的編輯卡片，以顯示完整差異的預覽。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to have terminal cards in the agent panel expanded, showing the whole command output.\n\nDefault: true"
msgstr "是否展開代理面板中的終端機卡片，以顯示完整的命令輸出。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to hide gitignore files in the project panel.\n\nDefault: false"
msgstr "是否在專案面板中隱藏 gitignore 的檔案。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to hide symbols, excerpts and search matches in the outline panel\nwhen a multi-buffer view (e.g. a diff or search results) is active,\nshowing only files and directories.\nDoes not affect single-file views.\n\nDefault: false"
msgstr "在多重緩衝區檢視（例如差異或搜尋結果）為使用中時，是否在大綱面板中隱藏符號、摘錄與搜尋符合項目，只顯示檔案與資料夾。\n不影響單一檔案檢視。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to hide the hidden entries in the project panel.\n\nDefault: false"
msgstr "是否在專案面板中隱藏隱藏的項目。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to hide the root entry when only one folder is open in the window.\n\nDefault: false"
msgstr "視窗中只開啟一個資料夾時，是否隱藏根項目。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to highlight all occurrences of the selected text in an editor.\n\nDefault: true"
msgstr "是否在編輯器中醒目提示選取文字的所有出現位置。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to include gitignored files in search results."
msgstr "是否在搜尋結果中包含被 Git 忽略的檔案。"

msgctxt "settings schema"
msgid "Whether to include project rules files (AGENTS.md, CLAUDE.md, .rules, etc.)\nin the prompt when generating git commit messages.\n\nDefault: true"
msgstr "產生 git 提交訊息時，是否在提示中包含專案規則檔案（AGENTS.md、CLAUDE.md、.rules 等）。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to include text channels in file finder results.\n\nDefault: false"
msgstr "是否在檔案搜尋工具的結果中包含文字頻道。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to indent lines using tab characters, as opposed to multiple\nspaces.\n\nDefault: false"
msgstr "是否使用定位字元而非多個空格來縮排行。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to indent list items when pressing tab after a list marker.\n\nDefault: true"
msgstr "在清單標記後按下 Tab 時，是否縮排清單項目。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to index files that `.gitignore` excludes (only the ones the\nproject panel has loaded: ignored folders are read when expanded).\n\nDefault: false"
msgstr "是否為 `.gitignore` 排除的檔案建立索引（只限專案面板已載入者：已忽略的資料夾會在展開時讀取）。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to interpret the search query as a regular expression."
msgstr "是否將搜尋查詢解讀為規則運算式。"

msgctxt "settings schema"
msgid "Whether to keep tabs in preview mode when code navigation is used to navigate away from them.\nIf `enable_preview_file_from_code_navigation` or `enable_preview_multibuffer_from_code_navigation` is also true, the new tab may replace the existing one.\n\nDefault: false"
msgstr "使用程式碼導覽離開分頁時，是否讓分頁保持預覽模式。\n若 `enable_preview_file_from_code_navigation` 或 `enable_preview_multibuffer_from_code_navigation` 也為 true，新分頁可能會取代現有分頁。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to keep the system awake while agent threads are running.\n\nDefault: true"
msgstr "代理會話執行期間是否讓系統保持喚醒。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to keep the text selection after copying it to the clipboard.\n\nDefault: true"
msgstr "將選取的文字複製到剪貼簿後，是否保留選取範圍。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to limit the content width in the agent panel. When enabled,\ncontent will be constrained to `max_content_width` and centered when\nthe panel is wider than that value, for optimal readability.\n\nDefault: false"
msgstr "是否限制代理面板中的內容寬度。啟用時，內容會限制在 `max_content_width` 以內，且面板寬於該值時會置中，以獲得最佳的可讀性。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to limit the width of the rendered markdown content. When\nenabled, content is constrained to `max_width` and centered\nhorizontally within the preview pane, for optimal readability.\n\nDefault: false"
msgstr "是否限制轉譯之 Markdown 內容的寬度。啟用時，內容會限制在 `max_width` 以內，並在預覽窗格中水平置中，以獲得最佳的可讀性。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to log messages between active debug adapters and Zed\n\nDefault: true"
msgstr "是否記錄使用中的偵錯介面卡與 ForgeKairos 之間的訊息\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to match case sensitively."
msgstr "是否區分大小寫比對。"

msgctxt "settings schema"
msgid "Whether to only match on whole words."
msgstr "是否只比對完整的字詞。"

msgctxt "settings schema"
msgid "Whether to only show the inline blame information\nafter a delay once the cursor stops moving.\n\nDefault: 0"
msgstr "是否只在游標停止移動並經過一段延遲後，才顯示內嵌 Blame 資訊。\n\n預設值：0"

msgctxt "settings schema"
msgid "Whether to only show the inline diagnostics after a delay after the\nlast editor event.\n\nDefault: 150"
msgstr "是否只在最後一個編輯器事件後經過一段延遲，才顯示內嵌診斷。\n\n預設值：150"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a multibuffer.\n\nDefault: false"
msgstr "使用程式碼導覽開啟多重緩衝區時，是否以預覽模式開啟分頁。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when code navigation is used to open a single file.\n\nDefault: true"
msgstr "使用程式碼導覽開啟單一檔案時，是否以預覽模式開啟分頁。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from a multibuffer.\n\nDefault: true"
msgstr "從多重緩衝區開啟時，是否以預覽模式開啟分頁。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when opened from the project panel\nwith a single click or the `project_panel::Open` action.\n\nDefault: true"
msgstr "從專案面板按一下或使用 `project_panel::Open` 動作開啟時，是否以預覽模式開啟分頁。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to open tabs in preview mode when selected from the file finder.\n\nDefault: false"
msgstr "從檔案搜尋工具選取時，是否以預覽模式開啟分頁。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to open tabular files such as CSV and TSV as a table (grid). When\noff, they open in the text editor.\n\nDefault: true"
msgstr "是否以表格（格狀檢視）開啟 CSV 與 TSV 等表格式檔案。關閉時，會在文字編輯器中開啟。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to optimize Zed's interface for assistive technology such as\nscreen readers.\n\nDefault: false"
msgstr "是否針對螢幕閱讀程式等輔助技術最佳化 ForgeKairos 的介面。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to perform linked edits of associated ranges, if the language server supports it.\nFor example, when editing opening <html> tag, the contents of the closing </html> tag will be edited as well.\n\nDefault: true"
msgstr "若語言伺服器支援，是否對相關聯的範圍執行連結編輯。\n例如，編輯開頭的 <html> 標記時，結尾 </html> 標記的內容也會一併編輯。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to point out missing development tools in a notification and offer\nto install them from it. While connected to a remote host, the host is\nchecked and the tools are installed there.\n\nDefault: true"
msgstr "是否以通知指出缺少的開發工具，並提供從通知中安裝。連線至遠端主機時，會檢查該主機並在其上安裝工具。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to pop the completions menu while typing in an editor without\nexplicitly requesting it.\n\nDefault: true"
msgstr "在編輯器中輸入時，是否不經明確要求即自動顯示完成項目選單。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to prefix each logged line with `[YYYY-MM-DD HH:MM:SS] `.\n\nDefault: false"
msgstr "是否在每一記錄行前面加上 `[YYYY-MM-DD HH:MM:SS] `。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to prevent this project from being shared in public channels.\n\nDefault: false"
msgstr "是否防止此專案在公開頻道中分享。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to pull for diagnostics or not.\n\nDefault: true"
msgstr "是否提取診斷。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to query and display LSP `textDocument/documentLink` links in the editor.\n\nDefault: true"
msgstr "是否在編輯器中查詢並顯示 LSP `textDocument/documentLink` 連結。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to reduce non-essential motion in the UI, such as loading\nspinners and pulsating labels, by rendering them in a static state.\n\nDefault: off"
msgstr "是否以靜態方式呈現載入中的旋轉圖示、閃爍的標籤等，以減少 UI 中非必要的動態效果。\n\n預設值：off"

msgctxt "settings schema"
msgid "Whether to resize all the panels in a dock when resizing the dock.\n\nDefault: [\"left\"]"
msgstr "調整停駐區大小時，是否一併調整停駐區中所有面板的大小。\n\n預設值：[\"left\"]"

msgctxt "settings schema"
msgid "Whether to reveal an already open file in an existing pane instead of opening it in the active pane.\n\nDefault: false"
msgstr "是否在既有的窗格中顯示已開啟的檔案，而不是在使用中的窗格內開啟。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to reveal it in the outline panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "當對應的專案項目變成使用中時，\n是否自動在大綱面板中顯示該項目。\n被 Git 忽略的項目一律不會自動顯示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to reveal it in the project panel automatically,\nwhen a corresponding project entry becomes active.\nGitignored entries are never auto revealed.\n\nDefault: true"
msgstr "當對應的專案項目變成使用中時，\n是否自動在專案面板中顯示該項目。\n被 Git 忽略的項目一律不會自動顯示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to run agent terminal commands outside the OS sandbox, with\nZed's own permissions (the inverse of the settings UI's \"enable sandbox\"\nswitch). When true, the sandboxed terminal tool is not exposed and the\nsystem prompt omits the sandbox section, so the model uses the plain\n`terminal` tool; on Windows, WSL sandbox setup is skipped. Such commands\nare never auto-approved: each one asks first. Only the user sets this;\nthe agent has no way to ask for a command to run outside the sandbox.\nDefault: false"
msgstr "是否在作業系統沙箱外，以 ForgeKairos 本身的權限執行代理的終端機命令\n（與設定介面中「啟用沙箱」開關相反）。為 true 時，不提供沙箱化的終端機工具，\n系統提示也會省略沙箱一節，因此模型會使用一般的 `terminal` 工具；\n在 Windows 上會略過 WSL 沙箱的準備。這類命令一律不會自動核准，\n每次都會先詢問。只有使用者能設定此項；代理無法要求在沙箱外執行命令。\n預設值：false"

msgctxt "settings schema"
msgid "Whether to run the context server on the remote server when using remote development.\n\nIf this is false, the context server will always run on the local machine.\n\nDefault: false"
msgstr "使用遠端開發時，是否在遠端伺服器上執行 MCP 伺服器。\n\n若為 false，MCP 伺服器一律在本機上執行。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to scroll when clicking near the edge of the visible text area.\n\nDefault: false"
msgstr "按一下可見文字區域的邊緣附近時，是否捲動。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to send explicit `cache_control` breakpoints for prompt caching.\nLeave disabled if the provider rejects requests containing them."
msgstr "是否為提示快取傳送明確的 `cache_control` 中斷點。\n若提供者會拒絕含有這些中斷點的要求，請保持停用。"

msgctxt "settings schema"
msgid "Whether to show OpenCode Go models. Defaults to true."
msgstr "是否顯示 OpenCode Go 模型。預設為 true。"

msgctxt "settings schema"
msgid "Whether to show OpenCode Zen models. Defaults to true."
msgstr "是否顯示 OpenCode Zen 模型。預設為 true。"

msgctxt "settings schema"
msgid "Whether to show a background for inlay hints.\n\nIf set to `true`, the background will use the `hint.background` color\nfrom the current theme.\n\nDefault: false"
msgstr "是否為內嵌提示顯示背景。\n\n若設為 `true`，背景會使用目前佈景主題中的\n`hint.background` 色彩。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show a badge on the git panel icon with the count of uncommitted changes.\n\nDefault: false"
msgstr "是否在 Git 面板圖示上顯示徽章，標示未提交的變更數。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show a badge on the terminal panel icon with the count of open terminals.\n\nDefault: false"
msgstr "是否在終端機面板圖示上顯示徽章，標示已開啟的終端機數。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show a git status indicator next to file names in the project panel.\n\nDefault: false"
msgstr "是否在專案面板的檔案名稱旁顯示 Git 狀態指示器。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show a single line break as a line break. When off, it is one\nspace as CommonMark specifies, and only two trailing spaces, `\\` or `<br>`\nbreak the line. Exporting to PDF follows the same setting.\n\nDefault: true"
msgstr "是否將單一換行顯示為換行。關閉時，依 CommonMark 規範視為一個空格，\n只有行尾的兩個空格、`\\` 或 `<br>` 才會換行。\n匯出為 PDF 時也依循此設定。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show active line endings button in the status bar.\n\nDefault: false"
msgstr "是否在狀態列中顯示目前的行尾序列按鈕。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show an indicator while multi-stroke input is pending.\nIf the input has a timeout, a countdown is shown and hovering the indicator pauses it.\nIts binding preview popover is disabled when the which-key popup is enabled.\n\nDefault: true"
msgstr "是否在多鍵輸入等待中時顯示指示器。\n若輸入有逾時，會顯示倒數計時，將滑鼠暫留在指示器上可暫停倒數。\n啟用 which-key 快顯視窗時，會停用其按鍵繫結預覽快顯視窗。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show author name as part of the commit information.\n\nDefault: false"
msgstr "是否在提交資訊中顯示作者名稱。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show bookmarks in the gutter.\n\nDefault: true"
msgstr "是否在裝訂邊中顯示書籤。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show breakpoints in the gutter.\n\nDefault: true"
msgstr "是否在裝訂邊中顯示中斷點。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show buffer search result indicators in the scrollbar.\n\nDefault: true"
msgstr "是否在捲軸中顯示緩衝區搜尋結果的指示器。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show cells that contain line breaks in full, making the row\ntaller. When off, they are cut to one line.\n\nDefault: true"
msgstr "是否完整顯示含有換行的儲存格，並增加該列的高度。\n關閉時，會截斷為一行。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show code action button at start of buffer line.\n\nDefault: true"
msgstr "是否在緩衝區行首顯示程式碼動作按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show commit summary as part of the inline blame.\n\nDefault: false"
msgstr "是否在內嵌 Blame 中顯示提交摘要。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show cursor positions in the scrollbar.\n\nDefault: true"
msgstr "是否在捲軸中顯示游標位置。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show entries with tree or flat view in the panel\n\nDefault: false"
msgstr "是否在面板中以樹狀或平面檢視顯示項目\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show error and warning count badges next to file names in the project panel.\n\nDefault: false"
msgstr "是否在專案面板的檔案名稱旁顯示錯誤與警告數量的徽章。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show file icons in the file finder.\n\nDefault: true"
msgstr "是否在檔案搜尋器中顯示檔案圖示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show file icons in the git panel.\n\nDefault: false"
msgstr "是否在 Git 面板中顯示檔案圖示。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show file icons in the outline panel.\n\nDefault: true"
msgstr "是否在大綱面板中顯示檔案圖示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show file icons in the project panel.\n\nDefault: true"
msgstr "是否在專案面板中顯示檔案圖示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show fold buttons in the gutter.\n\nDefault: true"
msgstr "是否在裝訂邊中顯示摺疊按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show folder names with bold text in the project panel.\n\nDefault: false"
msgstr "是否在專案面板中以粗體顯示資料夾名稱。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show git diff indicators in the scrollbar.\n\nDefault: true"
msgstr "是否在捲軸中顯示 Git 差異指示器。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show git status indicators on the branch icon in the title bar.\nWhen enabled, the branch icon changes to reflect the current repository\nstatus (e.g. modified, added, deleted, or conflict).\n\nDefault: false"
msgstr "是否在標題列的分支圖示上顯示 Git 狀態指示器。\n啟用時，分支圖示會隨目前儲存庫的狀態而變化\n（例如：已修改、已新增、已刪除或衝突）。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show line numbers in the gutter.\n\nDefault: true"
msgstr "是否在裝訂邊中顯示行號。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show onboarding banners in the title bar.\n\nDefault: true"
msgstr "是否在標題列中顯示新手導覽橫幅。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show opened editors as preview tabs.\nPreview tabs do not stay open, are reused until explicitly set to be kept open opened (via double-click or editing) and show file names in italic.\n\nDefault: true"
msgstr "是否將開啟的編輯器顯示為預覽分頁。\n預覽分頁不會保持開啟，在明確設為保持開啟（按兩下或編輯）之前會被重複使用，且檔案名稱會以斜體顯示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show padding for zoomed panels.\nWhen enabled, zoomed bottom panels will have some top padding,\nwhile zoomed left/right panels will have padding to the right/left (respectively).\n\nDefault: true"
msgstr "是否為放大的面板顯示邊框間距。\n啟用時，放大的底部面板上方會有一些邊框間距，\n而放大的左側/右側面板則分別在右側/左側有邊框間距。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show runnable buttons in the gutter.\n\nDefault: true"
msgstr "是否在裝訂邊中顯示可執行項目按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show selected symbol occurrences in the scrollbar.\n\nDefault: true"
msgstr "是否在捲軸中顯示所選符號出現的位置。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show selected text occurrences in the scrollbar.\n\nDefault: true"
msgstr "是否在捲軸中顯示所選文字出現的位置。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show small single-line outputs inline instead of in a block.\n\nDefault: true"
msgstr "是否以內嵌方式顯示簡短的單行輸出，而不是以區塊顯示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show tabs and spaces in the editor."
msgstr "是否在編輯器中顯示 Tab 與空格。"

msgctxt "settings schema"
msgid "Whether to show the AI browser panel button in the status bar while AI\ncontrol of the built-in browser is on.\n\nDefault: true"
msgstr "內建瀏覽器的 AI 控制開啟時，是否在狀態列中顯示\nAI 瀏覽器面板按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the Git file status on a tab item.\n\nDefault: false"
msgstr "是否在分頁項目上顯示 Git 檔案狀態。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show the LSP servers button in the status bar.\n\nDefault: `true`"
msgstr "是否在狀態列中顯示 LSP 伺服器按鈕。\n\n預設值：`true`"

msgctxt "settings schema"
msgid "Whether to show the active encoding button in the status bar.\n\nDefault: non_utf8"
msgstr "是否在狀態列中顯示目前的編碼按鈕。\n\n預設值：non_utf8"

msgctxt "settings schema"
msgid "Whether to show the addition/deletion change count next to each file in the Git panel.\n\nDefault: true"
msgstr "是否在 Git 面板的每個檔案旁顯示新增/刪除的變更數。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the agent panel button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示代理面板按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the avatar of the author of the commit.\n\nDefault: true"
msgstr "是否顯示提交作者的大頭貼。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the branch name button in the titlebar.\n\nDefault: true"
msgstr "是否在標題列中顯示分支名稱按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the browser panel button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示瀏覽器面板按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the call graph panel button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示呼叫圖面板按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the cursor position button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示游標位置按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the debug button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示偵錯按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the file icon for a tab.\n\nDefault: false"
msgstr "是否顯示分頁的檔案圖示。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show the git status in the outline panel.\n\nDefault: true"
msgstr "是否在大綱面板中顯示 Git 狀態。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the git status in the project panel.\n\nDefault: true"
msgstr "是否在專案面板中顯示 Git 狀態。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the informational hover box when moving the mouse\nover symbols in the editor.\n\nDefault: true"
msgstr "將滑鼠移到編輯器中的符號上時，\n是否顯示資訊暫留方塊。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the menus in the title bar.\n\nDefault: false"
msgstr "是否在標題列中顯示選單。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show the merge conflict indicator in the status bar\nthat offers to resolve conflicts using the agent.\n\nDefault: true"
msgstr "是否在狀態列中顯示合併衝突指示器，\n該指示器可讓您使用代理解決衝突。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the name of the active file in the status bar.\n\nDefault: false"
msgstr "是否在狀態列中顯示使用中檔案的名稱。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show the outline panel button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示大綱面板按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the panel button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示面板按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the project diagnostics button in the status bar."
msgstr "是否在狀態列中顯示專案診斷按鈕。"

msgctxt "settings schema"
msgid "Whether to show the project host and name in the titlebar.\n\nDefault: true"
msgstr "是否在標題列中顯示專案的主機與名稱。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the project panel button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示專案面板按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the project search button in the status bar."
msgstr "是否在狀態列中顯示專案搜尋按鈕。"

msgctxt "settings schema"
msgid "Whether to show the selections menu in the editor toolbar.\n\nDefault: true"
msgstr "是否在編輯器工具列中顯示選取項目選單。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the sign in button in the title bar.\n\nDefault: true"
msgstr "是否在標題列中顯示登入按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the signature help pop-up after completions or bracket pairs inserted.\n\nDefault: false"
msgstr "插入完成項目或成對括號後，是否顯示簽章說明快顯視窗。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show the stage and restore buttons on diff hunks.\n\nDefault: true"
msgstr "是否在差異區塊上顯示暫存與還原按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the status bar.\n\nDefault: true"
msgstr "是否顯示狀態列。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the terminal button in the status bar.\n\nDefault: true"
msgstr "是否在狀態列中顯示終端機按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the user menu button in the title bar.\n\nDefault: true"
msgstr "是否在標題列中顯示使用者選單按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show the which-key popup when holding down key combinations.\nWhen enabled, the pending keystrokes indicator remains visible, but its binding preview\npopover is disabled.\n\nDefault: false"
msgstr "按住按鍵組合時，是否顯示 which-key 快顯視窗。\n啟用時，等待中的按鍵輸入指示器仍會顯示，但其按鍵繫結預覽\n快顯視窗會停用。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show the worktree name button in the titlebar.\n\nDefault: true"
msgstr "是否在標題列中顯示工作樹名稱按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show thumb buttons for feedback in the agent panel.\n\nDefault: true"
msgstr "是否在代理面板中顯示用於意見回饋的讚/倒讚按鈕。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show turn statistics (elapsed time during generation, final turn duration).\n\nDefault: false"
msgstr "是否顯示回合統計資料（產生期間的經過時間、最終回合所花時間）。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to show user avatar in the title bar.\n\nDefault: true"
msgstr "是否在標題列中顯示使用者大頭貼。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to show wrap guides in the editor. Setting this to true will\nshow a guide at the 'preferred_line_length' value if softwrap is set to\n'preferred_line_length', and will show any additional guides as specified\nby the 'wrap_guides' setting.\n\nDefault: true"
msgstr "是否在編輯器中顯示換行輔助線。設為 true 時，若 softwrap 設為\n'preferred_line_length'，會在 'preferred_line_length' 的值處顯示輔助線，\n並顯示 'wrap_guides' 設定所指定的其他輔助線。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to sort file and folder names case-sensitively in the project panel.\nThis works in combination with `sort_mode`. `sort_mode` controls how files and\ndirectories are grouped, while this setting controls how names are compared.\n\nDefault: default"
msgstr "是否在專案面板中以區分大小寫的方式排序檔案與資料夾名稱。\n此設定與 `sort_mode` 搭配運作。`sort_mode` 控制檔案與\n資料夾的分組方式，而此設定控制名稱的比較方式。\n\n預設值：default"

msgctxt "settings schema"
msgid "Whether to split the thread history into the agent panel itself,\nas a list to the left of the current thread.\n\nDefault: true"
msgstr "是否將會話歷程分割到代理面板內，\n以清單形式顯示在目前會話的左側。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to start a new line with a comment when a previous line is a comment as well.\n\nDefault: true"
msgstr "前一行為註解時，是否以註解開始新的一行。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to stick parent directories at top of the project panel.\n\nDefault: true"
msgstr "是否將上層資料夾固定在專案面板頂端。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to tell a connected Claude Code CLI which file is open when\nnothing is selected (the CLI shows it as \"In <file>\" and attaches the\nfile to the next message). When off, only a selection of one or more\nlines is sent.\n\nDefault: true"
msgstr "未選取任何內容時，是否告知已連線的 Claude Code CLI 目前開啟的檔案\n（CLI 會將其顯示為 \"In <file>\"，並將該檔案附加至下一則訊息）。\n關閉時，只會傳送一行以上的選取範圍。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to use additional LSP queries to format (and amend) the code after\nevery \"trigger\" symbol input, defined by LSP server capabilities.\n\nDefault: true"
msgstr "每次輸入由 LSP 伺服器功能定義的「觸發」符號後，\n是否使用額外的 LSP 查詢來格式化（並修正）程式碼。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to use command history ranking for sorting in the command palette.\n\nDefault: true"
msgstr "是否在命令選擇區中依命令歷程記錄的排名排序。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to use gitignored files when searching.\nOnly the file Zed had indexed will be used, not necessary all the gitignored files.\n\nDefault: Smart"
msgstr "搜尋時是否使用被 Git 忽略的檔案。\n只會使用 ForgeKairos 已建立索引的檔案，不一定是所有被 Git 忽略的檔案。\n\n預設值：Smart"

msgctxt "settings schema"
msgid "Whether to use language servers to provide code intelligence.\n\nDefault: true"
msgstr "是否使用語言伺服器提供程式碼智慧功能。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to use the system provided dialogs for Open and Save As.\nWhen set to false, Zed will use the built-in keyboard-first pickers.\n\nDefault: true"
msgstr "「開啟」與「另存新檔」是否使用系統提供的對話方塊。\n設為 false 時，ForgeKairos 會使用內建、以鍵盤操作為主的選擇器。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to use the system provided prompts.\nWhen set to false, Zed will use the built-in prompts.\nNote that this setting has no effect on Linux, where Zed will always\nuse the built-in prompts.\n\nDefault: true"
msgstr "是否使用系統提供的對話方塊。\n設為 false 時，ForgeKairos 會使用內建的對話方塊。\n請注意，此設定在 Linux 上沒有作用，ForgeKairos 在 Linux 上\n一律使用內建的對話方塊。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether to use tree-sitter bracket queries to detect and colorize the brackets in the editor.\n\nDefault: false"
msgstr "是否使用 Tree-sitter 括號查詢來偵測編輯器中的括號並為其上色。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether to warn (Windows/WSL only) when a sandbox grant targets a file on\na Windows-hosted (DrvFs) filesystem. Such grants are enforced inside WSL\nvia a translated path, and their sandbox-integrity guarantees are weaker\nthan a distro-native filesystem. When enabled, such grants show a warning\nthat must be acknowledged before the command runs.\nDefault: true"
msgstr "沙箱授權的對象是 Windows 主機上（DrvFs）檔案系統中的檔案時，\n是否發出警告（僅限 Windows/WSL）。這類授權會在 WSL 內透過轉換後的\n路徑強制執行，其沙箱完整性的保證比發行版原生的檔案系統弱。\n啟用時，這類授權會顯示警告，必須先同意才會執行命令。\n預設值：true"

msgctxt "settings schema"
msgid "Whether to warn when a sandbox escalation prompt requests a domain or\nwrite path that contains potentially confusable Unicode characters\n(homoglyphs, invisible characters, or bidirectional overrides). When\nenabled, such prompts show a warning that must be acknowledged before\nthe request can be allowed.\nDefault: true"
msgstr "沙箱權限提升確認所要求的網域或寫入路徑中，含有可能造成混淆的\nUnicode 字元（同形異義字、不可見字元或雙向覆寫字元）時，是否發出警告。\n啟用時，這類確認會顯示警告，必須先同意才能允許該要求。\n預設值：true"

msgctxt "settings schema"
msgid "Whether to zoom the editor font size with the mouse wheel\nwhile holding the primary modifier key (Cmd on macOS, Ctrl on other platforms).\n\nDefault: false"
msgstr "按住主要輔助按鍵（macOS 上為 Cmd，其他平台為 Ctrl）時，\n是否可用滑鼠滾輪縮放編輯器的字型大小。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether type hints should be shown.\n\nDefault: true"
msgstr "是否顯示型別提示。\n\n預設值：true"

msgctxt "settings schema"
msgid "Whether update checks also consider pre-releases. By default only releases are considered.\n\nDefault: false"
msgstr "檢查更新時是否也包含發行前版本。預設只考慮正式發行版本。\n\n預設值：false"

msgctxt "settings schema"
msgid "Whether your current project should be shared when joining an empty channel.\n\nDefault: false"
msgstr "加入空白頻道時，是否分享目前的專案。\n\n預設值：false"

msgctxt "settings schema"
msgid "Which base git features (gutter, file colors, git::Diff) diff against.\n\nDefault: head"
msgstr "Git 功能（裝訂邊、檔案色彩、git::Diff）用來比較差異的基準。\n\n預設值：head"

msgctxt "settings schema"
msgid "Which code actions to run on save before the formatter.\nThese are not run if formatting is off.\n\nDefault: {} (or {\"source.organizeImports\": true} for Go)."
msgstr "儲存時要在格式器之前執行的程式碼動作。\n若已關閉格式化，則不會執行這些動作。\n\n預設值：{}（Go 為 {\"source.organizeImports\": true}）。"

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar.\n\nDefault: all"
msgstr "要在捲軸中顯示哪些診斷指示器。\n\n預設值：all"

msgctxt "settings schema"
msgid "Which diagnostic indicators to show in the scrollbar:\n\nDefault: all"
msgstr "要在捲軸中顯示哪些診斷指示器：\n\n預設值：all"

msgctxt "settings schema"
msgid "Which dock gets a pair of panels arranged in it the first time a project\nis opened. The dock itself is not opened for it; each panel's\n`starts_open` decides that. Once a project has a saved dock layout, that\nlayout is restored instead and this setting no longer applies to it.\n\nDefault: right"
msgstr "第一次開啟專案時，要在哪一個停駐區中並列放置兩個面板。\n不會因此而開啟停駐區本身；是否開啟由各面板的\n`starts_open` 決定。專案儲存了停駐區版面配置之後，會改為還原該\n版面配置，此設定也不再對其生效。\n\n預設值：right"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the project panel.\n\nDefault: all"
msgstr "要在專案面板中標示哪些含有診斷錯誤/警告的檔案。\n\n預設值：all"

msgctxt "settings schema"
msgid "Which files containing diagnostic errors/warnings to mark in the tabs.\nThis setting can take the following three values:\n\nDefault: off"
msgstr "要在分頁中標示哪些含有診斷錯誤/警告的檔案。\n此設定可使用下列三個值：\n\n預設值：off"

msgctxt "settings schema"
msgid "Which fullscreen mode the `zed::ToggleFullScreen` action enters (macOS only).\n\nDefault: native"
msgstr "`zed::ToggleFullScreen` 動作要進入哪一種全螢幕模式（僅限 macOS）。\n\n預設值：native"

msgctxt "settings schema"
msgid "Which information to show in the branch picker.\n\nDefault: on"
msgstr "要在分支選擇器中顯示哪些資訊。\n\n預設值：on"

msgctxt "settings schema"
msgid "Which level to use to filter out diagnostics displayed in the editor.\n\nAffects the editor rendering only, and does not interrupt\nthe functionality of diagnostics fetching and project diagnostics editor.\nWhich files containing diagnostic errors/warnings to mark in the tabs.\nDiagnostics are only shown when file icons are also active.\n\nShows all diagnostics if not specified.\n\nDefault: warning"
msgstr "用來篩選編輯器中所顯示之診斷的層級。\n\n只會影響編輯器的轉譯，不會中斷\n診斷的擷取功能與專案診斷編輯器。\n要在分頁中標示哪些含有診斷錯誤/警告的檔案。\n只有在檔案圖示也啟用時才會顯示診斷。\n\n若未指定，則顯示所有診斷。\n\n預設值：warning"

msgctxt "settings schema"
msgid "Which sources the panel lists calls from: the language server, which\nis exact, the symbol index of C and C++ files, which matches names, or\nboth.\n\nDefault: all"
msgstr "面板列出呼叫的來源：精確的語言伺服器、依名稱比對的\nC 與 C++ 檔案符號索引，或是兩者\n皆是。\n\n預設值：all"

msgctxt "settings schema"
msgid "Which untracked files `git status` reports.\n\n`all` lists every file inside an untracked directory, which is what\ncolours individual entries in the project panel. `normal` only lists the\nuntracked directory itself, and `no` skips untracked files entirely;\nboth make `git status` markedly cheaper on very large trees.\n\nDefault: all"
msgstr "`git status` 會回報哪些未追蹤的檔案。\n\n`all` 會列出未追蹤資料夾中的每個檔案，專案面板中的個別項目\n也因此能上色。`normal` 只列出未追蹤的資料夾本身，\n`no` 則完全略過未追蹤的檔案；\n兩者都能讓 `git status` 在非常大的樹狀結構中明顯更輕量。\n\n預設值：all"

msgctxt "settings schema"
msgid "White ANSI terminal color."
msgstr "白色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Width scales automatically with the buffer font size."
msgstr "寬度會隨緩衝區字型大小自動縮放。"

msgctxt "settings schema"
msgid "Window title template.\n\nAvailable variables are `${projectName}`, `${fileName}`,\n`${filePath}`, `${relativePath}`, `${fileStem}`, `${remoteName}`,\n`${remoteHost}`, `${appName}`, `${branch}`,\nand `${separator}`.\n`${separator}` is omitted when adjacent variables are empty,\nbut literal text is preserved.\nThe collaboration indicator, when present, is appended after the\nrendered template.\nIf the template renders to nothing, the default template is used instead.\n\nDefault: `${projectName}${separator}${fileName}`"
msgstr "視窗標題範本。\n\n可用的變數有 `${projectName}`、`${fileName}`、\n`${filePath}`、`${relativePath}`、`${fileStem}`、`${remoteName}`、\n`${remoteHost}`、`${appName}`、`${branch}`\n以及 `${separator}`。\n相鄰的變數為空時會省略 `${separator}`，\n但會保留字面文字。\n若有共同作業指示器，會附加在\n轉譯後的範本之後。\n若範本轉譯結果為空，則改用預設範本。\n\n預設值：`${projectName}${separator}${fileName}`"

msgctxt "settings schema"
msgid "Yellow ANSI terminal color."
msgstr "黃色 ANSI 終端機顏色。"

msgctxt "settings schema"
msgid "Zed draws its own window decorations/titlebar (client-side decoration)."
msgstr "ForgeKairos 會自行繪製視窗裝飾/標題列（用戶端裝飾）。"

msgctxt "settings schema"
msgid "Zed's Prettier integration settings.\nAllows to enable/disable formatting with Prettier\nand configure default Prettier, used when no project-level Prettier installation is found.\n\nDefault: off"
msgstr "ForgeKairos 的 Prettier 整合設定。\n可啟用/停用以 Prettier 進行格式化，\n並設定找不到專案層級的 Prettier 安裝時所使用的預設 Prettier。\n\n預設值：off"

msgctxt "settings schema"
msgid "clangd's memory use: its index mode, worker count and a limit at which it\nis restarted."
msgstr "clangd 的記憶體使用方式：其索引模式、工作者數量，以及\n觸發重新啟動的上限。"
