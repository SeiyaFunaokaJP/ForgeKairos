#. Creates a new file.
msgctxt "action documentation"
msgid "workspace::NewFile"
msgstr "建立新檔案。"

#. Creates a new file in a split of the desired direction.
msgctxt "action documentation"
msgid "workspace::NewFileSplit"
msgstr "在指定方向的分割窗格中建立新檔案。"

#. Creates a new file in a horizontal split.
