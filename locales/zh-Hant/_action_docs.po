msgid "project_panel::FoldDirectory"
msgstr "摺疊所選資料夾。"

#. Creates a new directory.
msgctxt "action documentation"
msgid "project_panel::NewDirectory"
msgstr "建立新資料夾。"

#. Creates a new file.
msgctxt "action documentation"
msgid "project_panel::NewFile"
msgstr "建立新檔案。"

#. Starts a new search in the selected directory.
