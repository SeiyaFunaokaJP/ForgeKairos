msgid "project_panel::NewSearchInDirectory"
msgstr "在選取的資料夾中開始新的搜尋。"

#. Opens the selected file in the editor.
msgctxt "action documentation"
msgid "project_panel::Open"
msgstr "在編輯器中開啟所選檔案。"

#. Opens the context menu for the selected entry.
msgctxt "action documentation"
msgid "project_panel::OpenContextMenu"
msgstr "開啟所選項目的內容功能表。"

#. Opens a markdown preview for the selected file.
msgctxt "action documentation"
msgid "project_panel::OpenMarkdownPreview"
msgstr "開啟所選檔案的 Markdown 預覽。"

#. Opens the selected file in a permanent tab.
msgctxt "action documentation"
msgid "project_panel::OpenPermanent"
msgstr "在固定分頁中開啟所選檔案。"

#. Opens the selected file in a horizontal split.
msgctxt "action documentation"
msgid "project_panel::OpenSplitHorizontal"
msgstr "在水平分割窗格中開啟所選檔案。"

#. Opens the selected file in a vertical split.
msgctxt "action documentation"
msgid "project_panel::OpenSplitVertical"
msgstr "在垂直分割窗格中開啟所選檔案。"

#. Pastes the previously cut or copied item.
msgctxt "action documentation"
msgid "project_panel::Paste"
msgstr "貼上先前剪下或複製的項目。"

#. Redoes the last undone file operation.
msgctxt "action documentation"
msgid "project_panel::Redo"
msgstr "重新套用上一個復原的檔案操作。"

#. Re-reads the project's folders from disk to pick up changes made outside of Zed.
msgctxt "action documentation"
msgid "project_panel::Refresh"
msgstr "從磁碟重新讀取專案的資料夾，以取得在 ForgeKairos 以外所做的變更。"

#. Removes the selected folder from the project.
msgctxt "action documentation"
msgid "project_panel::RemoveFromProject"
msgstr "從專案移除選取的資料夾。"

#. Renames the selected file or directory.
msgctxt "action documentation"
msgid "project_panel::Rename"
msgstr "重新命名選取的檔案或資料夾。"

#. Reveals the selected item in the system file manager.
msgctxt "action documentation"
msgid "project_panel::RevealInFileManager"
msgstr "在系統檔案管理員中顯示所選項目。"

#. Scroll until the cursor displays at the bottom
msgctxt "action documentation"
msgid "project_panel::ScrollCursorBottom"
msgstr "捲動直到游標顯示在底部"

#. Scroll until the cursor displays at the center
msgctxt "action documentation"
msgid "project_panel::ScrollCursorCenter"
msgstr "捲動直到游標顯示在中央"

#. Scroll until the cursor displays at the top
msgctxt "action documentation"
msgid "project_panel::ScrollCursorTop"
msgstr "捲動直到游標顯示在頂部"

#. Scroll half a page downwards
msgctxt "action documentation"
msgid "project_panel::ScrollDown"
msgstr "向下捲動半頁"

#. Scroll half a page upwards
msgctxt "action documentation"
msgid "project_panel::ScrollUp"
msgstr "向上捲動半頁"

#. Selects the next entry with diagnostics.
msgctxt "action documentation"
msgid "project_panel::SelectNextDiagnostic"
msgstr "選取下一個含診斷資訊的項目。"

#. Selects the next directory.
msgctxt "action documentation"
msgid "project_panel::SelectNextDirectory"
msgstr "選取下一個資料夾。"

#. Selects the next entry with git changes.
msgctxt "action documentation"
msgid "project_panel::SelectNextGitEntry"
msgstr "選取下一個含 Git 變更的項目。"

#. Selects the parent directory.
msgctxt "action documentation"
msgid "project_panel::SelectParent"
msgstr "選取上層資料夾。"

#. Selects the previous entry with diagnostics.
msgctxt "action documentation"
msgid "project_panel::SelectPrevDiagnostic"
msgstr "選取上一個含診斷資訊的項目。"

#. Selects the previous directory.
msgctxt "action documentation"
msgid "project_panel::SelectPrevDirectory"
msgstr "選取上一個資料夾。"

#. Selects the previous entry with git changes.
msgctxt "action documentation"
msgid "project_panel::SelectPrevGitEntry"
msgstr "選取上一個含 Git 變更的項目。"

#. Toggles the project panel.
msgctxt "action documentation"
msgid "project_panel::Toggle"
msgstr "切換專案面板。"

#. Toggles focus on the project panel.
msgctxt "action documentation"
msgid "project_panel::ToggleFocus"
msgstr "切換專案面板的焦點。"

#. Toggles visibility of git-ignored files.
msgctxt "action documentation"
msgid "project_panel::ToggleHideGitIgnore"
msgstr "切換被 Git 忽略的檔案是否顯示。"

#. Toggles visibility of hidden files.
msgctxt "action documentation"
msgid "project_panel::ToggleHideHidden"
msgstr "切換隱藏檔案的顯示狀態。"

#. Moves the selected file or directory to the system trash.
msgctxt "action documentation"
msgid "project_panel::Trash"
msgstr "將所選的檔案或資料夾移至系統垃圾桶。"

#. Undoes the last file operation.
msgctxt "action documentation"
msgid "project_panel::Undo"
msgstr "復原上一個檔案操作。"

#. Unfolds the selected directory.
msgctxt "action documentation"
msgid "project_panel::UnfoldDirectory"
msgstr "展開選取的資料夾。"

#. Moves to the next input field.
msgctxt "action documentation"
msgid "project_search::NextField"
msgstr "移至下一個輸入欄位。"

#. Open a text picker showing the current result in a modal.
msgctxt "action documentation"
msgid "project_search::OpenTextFinder"
msgstr "在對話方塊中開啟顯示目前結果的文字選擇器。"

#. Searches in a new project search tab.
msgctxt "action documentation"
msgid "project_search::SearchInNew"
msgstr "在新的專案搜尋分頁中搜尋。"

#. Toggles collapse/expand state of all search result excerpts.
msgctxt "action documentation"
msgid "project_search::ToggleAllSearchResults"
msgstr "切換所有搜尋結果摘錄的摺疊/展開狀態。"

#. Toggles the search filters panel.
msgctxt "action documentation"
msgid "project_search::ToggleFilters"
msgstr "切換搜尋篩選面板。"

#. Toggles focus between the search bar and the search results.
msgctxt "action documentation"
msgid "project_search::ToggleFocus"
msgstr "在搜尋列與搜尋結果之間切換焦點。"

#. Toggles the project symbols search.
msgctxt "action documentation"
msgid "project_symbols::Toggle"
msgstr "切換專案符號搜尋。"

#. Opens the dev container connection modal.
msgctxt "action documentation"
msgid "projects::OpenDevContainer"
msgstr "開啟 Dev Container 連線對話方塊。"

#. Opens a folder inside Wsl.
msgctxt "action documentation"
msgid "projects::OpenFolderInWsl"
msgstr "在 WSL 內開啟資料夾。"

#. Opens the recent projects interface.
msgctxt "action documentation"
msgid "projects::OpenRecent"
msgstr "開啟最近的專案介面。"

#. Creates a project from a selected template.
msgctxt "action documentation"
msgid "projects::OpenRemote"
msgstr "從選取的範本建立專案。"

#. Open a wsl distro.
msgctxt "action documentation"
msgid "projects::OpenWsl"
msgstr "開啟 WSL 發行版。"

#. Simulates a disconnection from the remote server for testing purposes.
#. This will trigger the reconnection logic.
msgctxt "action documentation"
msgid "remote_debug::SimulateDisconnect"
msgstr "模擬與遠端伺服器中斷連線，以供測試。\n這會觸發重新連線邏輯。"

#. Simulates a timeout/slow connection to the remote server for testing purposes.
#. This will cause heartbeat failures and trigger reconnection.
msgctxt "action documentation"
msgid "remote_debug::SimulateTimeout"
msgstr "模擬與遠端伺服器的連線逾時或速度緩慢，以供測試。\n這會造成心跳失敗並觸發重新連線。"

#. Simulates a timeout/slow connection to the remote server for testing purposes.
#. This will cause heartbeat failures and attempting a reconnection while having exhausted all attempts.
msgctxt "action documentation"
msgid "remote_debug::SimulateTimeoutExhausted"
msgstr "模擬與遠端伺服器的連線逾時或速度緩慢，以供測試。\n這會造成心跳失敗，並在所有嘗試次數耗盡後嘗試重新連線。"

#. Clears the output of the cell at the current cursor position.
msgctxt "action documentation"
msgid "repl::ClearCurrentOutput"
msgstr "清除游標所在儲存格的輸出。"

#. Clears all outputs in the REPL.
msgctxt "action documentation"
msgid "repl::ClearOutputs"
msgstr "清除 REPL 中的所有輸出。"

#. Interrupts the currently running kernel.
msgctxt "action documentation"
msgid "repl::Interrupt"
msgstr "中斷目前正在執行的核心。"

#. Refreshes the list of available kernelspecs.
msgctxt "action documentation"
msgid "repl::RefreshKernelspecs"
msgstr "重新整理可用的 kernelspec 清單。"

#. Restarts the current kernel.
msgctxt "action documentation"
msgid "repl::Restart"
msgstr "重新啟動目前的核心。"

#. Runs the current cell and advances to the next one.
msgctxt "action documentation"
msgid "repl::Run"
msgstr "執行目前儲存格並前進至下一個。"

#. Runs the current cell without advancing.
msgctxt "action documentation"
msgid "repl::RunInPlace"
msgstr "執行目前儲存格而不前進。"

#. Opens the REPL sessions panel.
msgctxt "action documentation"
msgid "repl::Sessions"
msgstr "開啟 REPL 工作階段面板。"

#. Shuts down the current kernel.
msgctxt "action documentation"
msgid "repl::Shutdown"
msgstr "關閉目前的核心。"

#. Cycles through search modes.
msgctxt "action documentation"
msgid "search::CycleMode"
msgstr "循環切換搜尋模式。"

#. Focuses on the search input field.
msgctxt "action documentation"
msgid "search::FocusSearch"
msgstr "將焦點移至搜尋輸入欄位。"

#. Navigates to the next query in search history.
msgctxt "action documentation"
msgid "search::NextHistoryQuery"
msgstr "在搜尋歷程記錄中移至下一個查詢。"

#. Navigates to the previous query in search history.
msgctxt "action documentation"
msgid "search::PreviousHistoryQuery"
msgstr "在搜尋歷程記錄中移至上一個查詢。"

#. Replaces all matches.
msgctxt "action documentation"
msgid "search::ReplaceAll"
msgstr "取代所有符合項目。"

#. Replaces the next match.
msgctxt "action documentation"
msgid "search::ReplaceNext"
msgstr "取代下一個符合項目。"

#. Selects all search matches.
msgctxt "action documentation"
msgid "search::SelectAllMatches"
msgstr "選取所有搜尋符合項目。"

#. Selects the next search match.
msgctxt "action documentation"
msgid "search::SelectNextMatch"
msgstr "選取下一個搜尋符合項目。"

#. Selects the previous search match.
msgctxt "action documentation"
msgid "search::SelectPreviousMatch"
msgstr "選取上一個搜尋符合項目。"

#. Toggles case-sensitive search.
msgctxt "action documentation"
msgid "search::ToggleCaseSensitive"
msgstr "切換區分大小寫搜尋。"

#. Toggles searching in ignored files.
msgctxt "action documentation"
msgid "search::ToggleIncludeIgnored"
msgstr "切換在忽略的檔案中搜尋。"

#. Toggles regular expression mode.
msgctxt "action documentation"
msgid "search::ToggleRegex"
msgstr "切換規則運算式模式。"

#. Toggles the replace interface.
msgctxt "action documentation"
msgid "search::ToggleReplace"
msgstr "切換取代介面。"

#. Toggles searching within selection only.
msgctxt "action documentation"
msgid "search::ToggleSelection"
msgstr "切換僅在選取範圍內搜尋。"

#. Toggles whole word matching.
msgctxt "action documentation"
msgid "search::ToggleWholeWord"
msgstr "切換全字比對。"

#. Collapses the navigation entry.
