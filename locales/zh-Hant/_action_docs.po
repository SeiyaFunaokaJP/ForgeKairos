# The descriptions of actions (their doc comments), keyed by the action name.
# The #. comments of an entry are the English it translates, one per line.
#
# Entries that zed-i18n also translates started from its zh-TW translations
# (https://github.com/LI-NA/zed-i18n, GPL-3.0, commit 955f1f7, for Zed v1.23.3)
# and were changed to the terms and style of the other files. See THIRD_PARTY_NOTICES.md.
msgid ""
msgstr ""
"Language: zh-Hant\n"
"X-Language-Name: 繁體中文\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. Runs a sequence of actions.
#.
#. NOTE: This does **not** wait for asynchronous actions to complete before running the next action.
msgctxt "action documentation"
msgid "action::Sequence"
msgstr "依序執行一連串動作。\n\n注意：此動作**不會**等待非同步動作完成，就會執行下一個動作。"

#. Displays error messages from language servers in the status bar.
msgctxt "action documentation"
msgid "activity_indicator::ShowErrorMessage"
msgstr "在狀態列中顯示來自語言伺服器的錯誤訊息。"

#. Add the current selection as context for threads in the agent panel.
msgctxt "action documentation"
msgid "agent::AddSelectionToThread"
msgstr "將目前選取範圍新增為代理面板中會話的上下文。"

#. Allow this operation and remember the choice.
msgctxt "action documentation"
msgid "agent::AllowAlways"
msgstr "允許此操作並記住選擇。"

#. Allow this operation only this time.
msgctxt "action documentation"
msgid "agent::AllowOnce"
msgstr "僅此次允許此操作。"

#. Archives the currently selected thread.
msgctxt "action documentation"
msgid "agent::ArchiveSelectedThread"
msgstr "封存目前選取的會話。"

#. Action to authorize a tool call with a specific permission option.
#. This is used by the permission granularity dropdown to authorize tool calls.
msgctxt "action documentation"
msgid "agent::AuthorizeToolCall"
msgstr "使用特定權限選項授權工具呼叫的動作。\n權限粒度下拉選單會使用此動作來授權工具呼叫。"

#. Starts a chat conversation with the agent.
msgctxt "action documentation"
msgid "agent::Chat"
msgstr "開始與代理的聊天對話。"

#. Starts a chat conversation with follow-up enabled.
msgctxt "action documentation"
msgid "agent::ChatWithFollow"
msgstr "開始聊天並跟隨代理。"

#. Clears all messages from the queue.
msgctxt "action documentation"
msgid "agent::ClearMessageQueue"
msgstr "清除佇列中的所有訊息。"

#. Copies the current thread to the clipboard as JSON for debugging.
msgctxt "action documentation"
msgid "agent::CopyThreadToClipboard"
msgstr "將目前會話以 JSON 複製到剪貼簿以供偵錯。"

#. Opens the skill creator window to import a skill from a GitHub URL.
msgctxt "action documentation"
msgid "agent::CreateSkillFromUrl"
msgstr "開啟技能建立器視窗，以從 GitHub URL 匯入技能。"

#. Cycles through favorited models in the ACP model selector.
msgctxt "action documentation"
msgid "agent::CycleFavoriteModels"
msgstr "在 ACP 模型選擇器中循環切換已收藏的模型。"

#. Cycles through available session modes.
msgctxt "action documentation"
msgid "agent::CycleModeSelector"
msgstr "循環切換可用的工作階段模式。"

#. Cycles to the next inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CycleNextInlineAssist"
msgstr "切換至下一個內嵌輔助建議。"

#. Cycles to the previous inline assist suggestion.
msgctxt "action documentation"
msgid "agent::CyclePreviousInlineAssist"
msgstr "切換至上一個內嵌輔助建議。"

#. Cycles through available thinking effort levels for the current model.
msgctxt "action documentation"
msgid "agent::CycleThinkingEffort"
msgstr "循環切換目前模型可用的思考深度等級。"

#. Closes the thread search bar.
msgctxt "action documentation"
msgid "agent::DismissThreadSearch"
msgstr "關閉會話搜尋列。"

#. Edits the first message in the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::EditFirstQueuedMessage"
msgstr "編輯佇列中的第一則訊息（下一則即將傳送的訊息）。"

#. Expands the message editor to full size.
msgctxt "action documentation"
msgid "agent::ExpandMessageEditor"
msgstr "將訊息編輯器展開至完整大小。"

#. Moves focus down in the interface.
msgctxt "action documentation"
msgid "agent::FocusDown"
msgstr "將焦點在介面中向下移動。"

#. Moves focus left in the interface.
msgctxt "action documentation"
msgid "agent::FocusLeft"
msgstr "將焦點在介面中向左移動。"

#. Moves focus right in the interface.
msgctxt "action documentation"
msgid "agent::FocusRight"
msgstr "將焦點在介面中向右移動。"

#. Moves focus up in the interface.
msgctxt "action documentation"
msgid "agent::FocusUp"
msgstr "將焦點在介面中向上移動。"

#. Follows the agent's suggestions.
msgctxt "action documentation"
msgid "agent::Follow"
msgstr "跟隨代理的建議。"

#. Import agent threads from other Zed release channels (e.g. Preview, Nightly).
msgctxt "action documentation"
msgid "agent::ImportThreadsFromOtherChannels"
msgstr "從其他 ForgeKairos 發行頻道匯入代理會話（例如 Preview、Nightly）。"

#. Keeps the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Keep"
msgstr "保留目前的建議或變更。"

#. Keeps all suggestions or changes.
msgctxt "action documentation"
msgid "agent::KeepAll"
msgstr "保留所有建議或變更。"

#. Loads a thread from the clipboard JSON for debugging.
msgctxt "action documentation"
msgid "agent::LoadThreadFromClipboard"
msgstr "從剪貼簿 JSON 載入會話以進行偵錯。"

#. Logs out of the current external agent
msgctxt "action documentation"
msgid "agent::LogoutAgent"
msgstr "登出目前的外部代理"

#. Opens the profile management interface for configuring agent tools and settings.
msgctxt "action documentation"
msgid "agent::ManageProfiles"
msgstr "開啟設定檔管理介面以設定代理工具與設定。"

#. Opens the skills manager in the settings window.
msgctxt "action documentation"
msgid "agent::ManageSkills"
msgstr "在設定視窗中開啟技能管理員。"

#. Moves the thread open in a tab back to the agent panel.
msgctxt "action documentation"
msgid "agent::MoveThreadToPanel"
msgstr "將在分頁中開啟的會話移回代理面板。"

#. Creates a new external agent conversation thread.
msgctxt "action documentation"
msgid "agent::NewExternalAgentThread"
msgstr "建立新的外部代理會話。"

#. Starts a new terminal thread.
msgctxt "action documentation"
msgid "agent::NewTerminalThread"
msgstr "啟動新的終端機會話。"

#. Creates a new conversation thread, optionally based on an existing thread.
msgctxt "action documentation"
msgid "agent::NewThread"
msgstr "建立新的會話，可選擇以現有會話為基礎。"

#. Starts a new thread of the built-in agent on a model of the given
#. language model provider.
msgctxt "action documentation"
msgid "agent::NewThreadWithLanguageModelProvider"
msgstr "以指定語言模型提供者的模型，啟動內建代理的新會話。"

#. Opens the active thread as a markdown file.
msgctxt "action documentation"
msgid "agent::OpenActiveThreadAsMarkdown"
msgstr "將作用中會話開啟為 Markdown 檔案。"

#. Opens the "Add Context" menu in the message editor.
msgctxt "action documentation"
msgid "agent::OpenAddContextMenu"
msgstr "在訊息編輯器中開啟「新增上下文」選單。"

#. Opens the agent diff view to review changes.
msgctxt "action documentation"
msgid "agent::OpenAgentDiff"
msgstr "開啟代理差異檢視以檢閱變更。"

#. Opens the user-global AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenGlobalAGENTS.mdRules"
msgstr "開啟使用者全域 AGENTS.md 規則檔案。"

#. Opens the agent onboarding modal.
msgctxt "action documentation"
msgid "agent::OpenOnboardingModal"
msgstr "開啟代理新手導覽對話方塊。"

#. Opens the permission granularity dropdown for the current tool call.
msgctxt "action documentation"
msgid "agent::OpenPermissionDropdown"
msgstr "開啟目前工具呼叫的權限粒度下拉選單。"

#. Opens the project AGENTS.md rules file.
msgctxt "action documentation"
msgid "agent::OpenProjectAGENTS.mdRules"
msgstr "開啟專案 AGENTS.md 規則檔案。"

#. Opens the agent settings UI.
msgctxt "action documentation"
msgid "agent::OpenSettings"
msgstr "開啟代理設定介面。"

#. Opens the skill creator window for creating a new skill.
msgctxt "action documentation"
msgid "agent::OpenSkillCreator"
msgstr "開啟技能建立器視窗以建立新的技能。"

#. Opens the current thread as a tab in a pane split to the right.
msgctxt "action documentation"
msgid "agent::OpenThreadInSplit"
msgstr "將目前的會話以分頁形式開啟在向右分割的窗格中。"

#. Opens the current thread as a tab in the workspace. The panel goes back
#. to a new draft.
msgctxt "action documentation"
msgid "agent::OpenThreadInTab"
msgstr "將目前的會話以分頁形式開啟在工作區中。面板會回到新的草稿。"

#. Pastes clipboard content without any formatting.
msgctxt "action documentation"
msgid "agent::PasteRaw"
msgstr "貼上剪貼簿內容，不套用任何格式。"

#. Triggers re-authentication on Gemini
msgctxt "action documentation"
msgid "agent::ReauthenticateAgent"
msgstr "觸發 Gemini 重新驗證"

#. Reconnects to an agent that was stopped while unused, without sending anything.
msgctxt "action documentation"
msgid "agent::ReconnectParkedAgent"
msgstr "重新連線至因未使用而停止的代理，不傳送任何內容。"

#. Rejects the current suggestion or change.
msgctxt "action documentation"
msgid "agent::Reject"
msgstr "拒絕目前的建議或變更。"

#. Rejects all suggestions or changes.
msgctxt "action documentation"
msgid "agent::RejectAll"
msgstr "拒絕所有建議或變更。"

#. Reject this operation only this time.
msgctxt "action documentation"
msgid "agent::RejectOnce"
msgstr "僅此次拒絕此操作。"

#. Removes the first message from the queue (the next one to be sent).
msgctxt "action documentation"
msgid "agent::RemoveFirstQueuedMessage"
msgstr "從佇列移除第一則訊息（即下一則待傳送的訊息）。"

#. Removes the currently selected thread.
msgctxt "action documentation"
msgid "agent::RemoveSelectedThread"
msgstr "移除目前選取的會話。"

#. Renames the currently selected thread.
msgctxt "action documentation"
msgid "agent::RenameSelectedThread"
msgstr "重新命名目前選取的會話。"

#. Reruns the rules-to-skills migration.
msgctxt "action documentation"
msgid "agent::RerunRulesToSkillsMigration"
msgstr "重新執行規則轉技能的移轉。"

#. Resets the agent panel zoom levels (agent UI and buffer font sizes).
msgctxt "action documentation"
msgid "agent::ResetAgentZoom"
msgstr "重設代理面板的縮放等級（代理 UI 與緩衝區字型大小）。"

#. Re-enables the fast mode warning for every provider and model.
msgctxt "action documentation"
msgid "agent::ResetFastModeWarnings"
msgstr "為每個提供者和模型重新啟用快速模式警告。"

#. Resets the agent onboarding state.
msgctxt "action documentation"
msgid "agent::ResetOnboarding"
msgstr "重設代理新手導覽狀態。"

#. Resets the trial end upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialEndUpsell"
msgstr "重設試用結束升級通知。"

#. Resets the trial upsell notification.
msgctxt "action documentation"
msgid "agent::ResetTrialUpsell"
msgstr "重設試用升級通知。"

#. Opens a new agent thread to resolve merge conflicts in the given file paths.
msgctxt "action documentation"
msgid "agent::ResolveConflictedFilesWithAgent"
msgstr "開啟新的代理會話，以解決指定檔案路徑中的合併衝突。"

#. Opens a new agent thread to resolve specific merge conflicts.
msgctxt "action documentation"
msgid "agent::ResolveConflictsWithAgent"
msgstr "開啟新的代理會話，以解決特定合併衝突。"

#. Opens a new agent thread with the provided branch diff for review.
msgctxt "action documentation"
msgid "agent::ReviewBranchDiff"
msgstr "開啟新的代理會話，並附上提供的分支差異以供檢閱。"

#. Takes back every start of an agent outside its sandbox that was
#. confirmed for a thread, so that each thread asks again.
msgctxt "action documentation"
msgid "agent::RevokeOutsideSandboxConsents"
msgstr "撤回所有針對各會話確認過的「在沙箱外啟動代理」同意，讓每個會話重新詢問。"

#. Scroll the output down by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineDown"
msgstr "將輸出向下捲動三行。"

#. Scroll the output up by three lines.
msgctxt "action documentation"
msgid "agent::ScrollOutputLineUp"
msgstr "將輸出向上捲動三行。"

#. Scroll the output by one page down.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageDown"
msgstr "將輸出向下捲動一頁。"

#. Scroll the output by one page up.
msgctxt "action documentation"
msgid "agent::ScrollOutputPageUp"
msgstr "將輸出向上捲動一頁。"

#. Scroll the output to the bottom.
msgctxt "action documentation"
msgid "agent::ScrollOutputToBottom"
msgstr "將輸出捲動至底部。"

#. Scroll the output to the next user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToNextMessage"
msgstr "將輸出捲動至下一則使用者訊息。"

#. Scroll the output to the previous user message.
msgctxt "action documentation"
msgid "agent::ScrollOutputToPreviousMessage"
msgstr "將輸出捲動至上一則使用者訊息。"

#. Scroll the output to the top.
msgctxt "action documentation"
msgid "agent::ScrollOutputToTop"
msgstr "將輸出捲動至頂部。"

#. Selects the agent used for new threads in the agent panel, without
#. opening the panel. The selected agent is launched the next time the
#. panel is opened.
msgctxt "action documentation"
msgid "agent::SelectAgent"
msgstr "選取代理面板中新會話所使用的代理，但不\n開啟面板。所選代理會在下次\n開啟面板時啟動。"

#. Selects the next thread search match.
msgctxt "action documentation"
msgid "agent::SelectNextThreadMatch"
msgstr "選取下一個會話搜尋相符項目。"

#. Action to select a permission granularity option from the dropdown.
#. This updates the selected granularity without triggering authorization.
msgctxt "action documentation"
msgid "agent::SelectPermissionGranularity"
msgstr "從下拉選單中選取權限粒度選項的動作。\n這會更新選取的粒度，而不觸發授權。"

#. Selects the previous thread search match.
msgctxt "action documentation"
msgid "agent::SelectPreviousThreadMatch"
msgstr "選取上一個會話搜尋相符項目。"

#. Interrupts the current generation and sends the message immediately.
msgctxt "action documentation"
msgid "agent::SendImmediately"
msgstr "中斷目前的生成並立即傳送訊息。"

#. Sends the next queued message immediately.
msgctxt "action documentation"
msgid "agent::SendNextQueuedMessage"
msgstr "立即傳送下一則佇列中的訊息。"

#. Opens a small window over the workspace that sets up a language model
#. provider in place (its consent, key or sign-in), and then starts a
#. thread on it.
msgctxt "action documentation"
msgid "agent::SetUpLanguageModelProvider"
msgstr "在工作區上方開啟小視窗，就地設定語言模型提供者（同意、金鑰或登入），然後以該提供者啟動會話。"

#. Toggles the agent panel.
msgctxt "action documentation"
msgid "agent::Toggle"
msgstr "切換代理面板。"

#. Switches `agent.tool_permissions.default` between "confirm" and
#. "allow", so every tool action can be auto-approved without a prompt.
#. From "auto" (the AI judge) it also switches back to "confirm", so
#. the shortcut always leads out of an unattended mode.
msgctxt "action documentation"
msgid "agent::ToggleAutoApproveToolActions"
msgstr "在 \"confirm\" 與 \"allow\" 之間切換 `agent.tool_permissions.default`，讓所有工具動作都能不經確認自動核准。若目前為 \"auto\"（由 AI 判斷），也會切換回 \"confirm\"，因此此快速鍵一律會離開無人值守模式。"

#. Action to toggle a command pattern checkbox in the permission dropdown.
msgctxt "action documentation"
msgid "agent::ToggleCommandPattern"
msgstr "在權限下拉選單中切換命令模式核取方塊的動作。"

#. Toggles fast mode for models that support it.
msgctxt "action documentation"
msgid "agent::ToggleFastMode"
msgstr "為支援的模型切換快速模式。"

#. Toggles the language model selector dropdown.
msgctxt "action documentation"
msgid "agent::ToggleModelSelector"
msgstr "切換語言模型選擇器下拉選單。"

#. Toggles the menu to create new agent threads.
msgctxt "action documentation"
msgid "agent::ToggleNewThreadMenu"
msgstr "切換建立新代理會話的選單。"

#. Toggles the options menu for agent settings and preferences.
msgctxt "action documentation"
msgid "agent::ToggleOptionsMenu"
msgstr "切換代理設定與偏好選項選單。"

#. Toggles the tab bar of the agent panel's own pane.
msgctxt "action documentation"
msgid "agent::TogglePanelTabBar"
msgstr "切換代理面板本身窗格的分頁列。"

#. Toggles the thread history list shown inside the agent panel.
msgctxt "action documentation"
msgid "agent::TogglePanelThreadHistory"
msgstr "切換代理面板內顯示的會話歷程清單。"

#. Toggles the profile or mode selector for switching between agent profiles.
msgctxt "action documentation"
msgid "agent::ToggleProfileSelector"
msgstr "切換設定檔或模式選擇器，以在代理設定檔之間切換。"

#. Toggles in-thread search over the current agent thread's contents.
msgctxt "action documentation"
msgid "agent::ToggleSearch"
msgstr "切換在目前代理會話內容中搜尋。"

#. Toggles steering for the first queued message: when on, it interrupts
#. the agent at its next step instead of waiting for it to finish.
msgctxt "action documentation"
msgid "agent::ToggleSteerFirstQueuedMessage"
msgstr "切換第一則佇列訊息的引導：啟用時，\n會在代理進入下一步時中斷它，而不是等待其完成。"

#. Toggles the thinking effort selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleThinkingEffortMenu"
msgstr "切換思考深度選擇器選單的開關。"

#. Toggles thinking mode for models that support extended thinking.
msgctxt "action documentation"
msgid "agent::ToggleThinkingMode"
msgstr "為支援延伸思考的模型切換思考模式。"

#. Toggles the tool permission mode selector menu open or closed.
msgctxt "action documentation"
msgid "agent::ToggleToolPermissionSelector"
msgstr "開啟或關閉工具權限模式選擇器選單。"

#. Undoes the most recent reject operation, restoring the rejected changes.
msgctxt "action documentation"
msgid "agent::UndoLastReject"
msgstr "復原最近一次拒絕操作，還原被拒絕的變更。"

#. Moves focus to the sidebar's search/filter editor.
msgctxt "action documentation"
msgid "agents_sidebar::FocusSidebarFilter"
msgstr "將焦點移至側邊欄的搜尋／篩選編輯器。"

#. Creates a new thread in the currently selected or active project group.
msgctxt "action documentation"
msgid "agents_sidebar::NewThreadInGroup"
msgstr "在目前選取或使用中的專案群組建立新會話。"

#. Toggles between the thread list and the thread history.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadHistory"
msgstr "在會話清單與會話歷程之間切換。"

#. Toggles the thread switcher popup when the sidebar is focused.
msgctxt "action documentation"
msgid "agents_sidebar::ToggleThreadSwitcher"
msgstr "當側邊欄取得焦點時，切換會話切換器彈出視窗。"

#. Toggles the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::Toggle"
msgstr "切換 AI 瀏覽器面板（AI 代理開啟其所操作之瀏覽器分頁的位置）。"

#. Toggles focus on the AI browser panel, where AI agents open the browser tabs they drive.
msgctxt "action documentation"
msgid "ai_browser_panel::ToggleFocus"
msgstr "切換 AI 瀏覽器面板（AI 代理開啟其所操作之瀏覽器分頁的位置）的焦點。"

#. Activates the menu on the left in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuLeft"
msgstr "啟用用戶端應用程式選單左側的選單。\n\n不適用於平台選單列（例如 macOS 上）。"

#. Activates the menu on the right in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::ActivateMenuRight"
msgstr "啟用用戶端應用程式選單右側的選單。\n\n不適用於平台選單列（例如 macOS 上）。"

#. Opens the named menu in the client-side application menu.
#.
#. Does not apply to platform menu bars (e.g. on macOS).
msgctxt "action documentation"
msgid "app_menu::OpenApplicationMenu"
msgstr "在用戶端應用程式選單中開啟指定名稱的選單。\n\n不適用於平台的選單列（例如 macOS）。"

#. Deploys the assistant interface with the specified configuration.
msgctxt "action documentation"
msgid "assistant::InlineAssist"
msgstr "以指定設定啟動助理介面。"

#. Checks for available updates.
msgctxt "action documentation"
msgid "auto_update::Check"
msgstr "檢查可用的更新。"

#. Dismisses the update error message.
msgctxt "action documentation"
msgid "auto_update::DismissMessage"
msgstr "關閉更新錯誤訊息。"

#. Opens the release notes for the current version in a browser.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotes"
msgstr "在瀏覽器中開啟目前版本的版本資訊。"

#. Opens the release notes for the current version in a new tab.
msgctxt "action documentation"
msgid "auto_update::ViewReleaseNotesLocally"
msgstr "在新分頁中開啟目前版本的版本資訊。"

#. Cycle through branch filters.
msgctxt "action documentation"
msgid "branch_picker::CycleBranchFilter"
msgstr "循環切換分支篩選器。"

#. Deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::DeleteBranch"
msgstr "刪除選取的本機或遠端 Git 分支。"

#. Force deletes the selected git branch or remote.
msgctxt "action documentation"
msgid "branch_picker::ForceDeleteBranch"
msgstr "強制刪除所選本機或遠端 Git 分支。"

#. Show all branches.
msgctxt "action documentation"
msgid "branch_picker::ShowAllBranches"
msgstr "顯示所有分支。"

#. Show only local branches.
msgctxt "action documentation"
msgid "branch_picker::ShowLocalBranches"
msgstr "僅顯示本機分支。"

#. Show only remote branches.
msgctxt "action documentation"
msgid "branch_picker::ShowRemoteBranches"
msgstr "僅顯示遠端分支。"

#. Toggles the branch filter menu.
msgctxt "action documentation"
msgid "branch_picker::ToggleFilterMenu"
msgstr "切換分支篩選選單。"

